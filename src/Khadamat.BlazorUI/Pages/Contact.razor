@page "/contact"
@inject Khadamat.BlazorUI.State.AppState State
@inject IJSRuntime JS

<div class="container py-5" style="max-width:840px;">
    <div class="mb-5 text-center animate-up">
        <div class="d-inline-flex align-items-center justify-content-center bg-success bg-opacity-10 text-success rounded-4 mb-3"
             style="width:70px;height:70px;font-size:1.8rem;">
            <i class="fa-solid fa-headset"></i>
        </div>
        <h1 class="fw-bold mb-2">تواصل معنا</h1>
        <p class="text-muted">نحن هنا لمساعدتك. أرسل لنا رسالتك وسنرد عليك في أقرب وقت.</p>
    </div>

    <div class="row g-4">
        <!-- Contact Info -->
        <div class="col-md-5">
            <div class="glass-card p-4 h-100 animate-up" style="--delay:0.05s">
                <h5 class="fw-bold mb-4">معلومات التواصل</h5>

                <div class="contact-info-item mb-4">
                    <div class="contact-icon bg-primary-soft text-primary">
                        <i class="fa-solid fa-envelope"></i>
                    </div>
                    <div>
                        <div class="fw-bold small mb-1">البريد الإلكتروني</div>
                        <a href="mailto:support@khadamat.app" class="text-muted small text-decoration-none">
                            support@khadamat.app
                        </a>
                    </div>
                </div>

                <div class="contact-info-item mb-4">
                    <div class="contact-icon bg-success-soft text-success">
                        <i class="fa-brands fa-whatsapp"></i>
                    </div>
                    <div>
                        <div class="fw-bold small mb-1">واتساب</div>
                        <a href="https://wa.me/20100000000" target="_blank" class="text-muted small text-decoration-none">
                            20100000000+
                        </a>
                    </div>
                </div>

                <div class="contact-info-item mb-4">
                    <div class="contact-icon bg-warning-soft text-warning">
                        <i class="fa-solid fa-clock"></i>
                    </div>
                    <div>
                        <div class="fw-bold small mb-1">ساعات الدعم</div>
                        <span class="text-muted small">السبت – الخميس: 9ص – 9م</span>
                    </div>
                </div>

                <hr class="my-4" />

                <h6 class="fw-bold mb-3">تابعنا على</h6>
                <div class="d-flex gap-3">
                    <a href="#" class="social-circle bg-primary-soft text-primary">
                        <i class="fa-brands fa-facebook-f"></i>
                    </a>
                    <a href="#" class="social-circle bg-danger-soft text-danger">
                        <i class="fa-brands fa-instagram"></i>
                    </a>
                    <a href="#" class="social-circle" style="background:rgba(29,161,242,0.1);color:#1da1f2;">
                        <i class="fa-brands fa-x-twitter"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Contact Form -->
        <div class="col-md-7">
            <div class="glass-card p-4 animate-up" style="--delay:0.1s">
                <h5 class="fw-bold mb-4">أرسل رسالتك</h5>

                @if (submitted)
                {
                    <div class="text-center py-4 animate-pop">
                        <div class="success-circle mx-auto mb-4">
                            <i class="fa-solid fa-check fs-2 text-white"></i>
                        </div>
                        <h5 class="fw-bold">تم الإرسال بنجاح!</h5>
                        <p class="text-muted">شكراً لتواصلك معنا، سنرد عليك في غضون 24 ساعة.</p>
                        <button class="btn btn-outline-primary rounded-pill mt-2"
                                @onclick="() => submitted = false">
                            إرسال رسالة أخرى
                        </button>
                    </div>
                }
                else
                {
                    <div class="mb-3">
                        <label class="form-label small fw-bold">الاسم الكامل</label>
                        <input type="text" class="form-control premium-input" @bind="form.Name"
                               placeholder="أدخل اسمك بالكامل" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">البريد الإلكتروني</label>
                        <input type="email" class="form-control premium-input" @bind="form.Email"
                               placeholder="example@email.com" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">الموضوع</label>
                        <select class="form-select premium-input" @bind="form.Subject">
                            <option value="">-- اختر موضوع الرسالة --</option>
                            <option value="technical">مشكلة تقنية</option>
                            <option value="account">مشكلة في الحساب</option>
                            <option value="provider">الانضمام كمزود</option>
                            <option value="complaint">شكوى</option>
                            <option value="suggestion">اقتراح</option>
                            <option value="other">أخرى</option>
                        </select>
                    </div>
                    <div class="mb-4">
                        <label class="form-label small fw-bold">الرسالة</label>
                        <textarea class="form-control premium-input" @bind="form.Message" rows="4"
                                  placeholder="اكتب تفاصيل رسالتك هنا..."></textarea>
                    </div>

                    @if (!string.IsNullOrEmpty(errorMsg))
                    {
                        <div class="alert alert-danger rounded-4 small py-2 mb-3">
                            <i class="fa-solid fa-circle-exclamation me-2"></i>@errorMsg
                        </div>
                    }

                    <button class="btn btn-primary-premium w-100 py-3 rounded-pill fw-bold shadow-sm"
                            @onclick="HandleSubmit" disabled="@isSending">
                        @if (isSending)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>جاري الإرسال...</span>
                        }
                        else
                        {
                            <i class="fa-solid fa-paper-plane me-2"></i>
                            <span>إرسال الرسالة</span>
                        }
                    </button>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .contact-info-item {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
    }

    .contact-icon {
        width: 44px;
        height: 44px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        flex-shrink: 0;
    }

    .social-circle {
        width: 40px;
        height: 40px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        transition: transform 0.2s;
    }

    .social-circle:hover { transform: translateY(-3px) scale(1.1); }

    .premium-input {
        border: 2px solid #f1f5f9;
        background: #f8fafc;
        border-radius: 12px;
        padding: 10px 14px;
        transition: all 0.2s;
    }

    .premium-input:focus {
        background: white;
        border-color: var(--theme-primary);
        box-shadow: 0 0 0 4px rgba(var(--theme-primary-rgb), 0.1);
        outline: none;
    }

    .success-circle {
        width: 80px;
        height: 80px;
        background: linear-gradient(135deg, #10b981, #059669);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 10px 30px rgba(16, 185, 129, 0.3);
    }

    .bg-primary-soft { background: rgba(99, 102, 241, 0.1); }
    .bg-success-soft { background: rgba(16, 185, 129, 0.1); }
    .bg-warning-soft { background: rgba(245, 158, 11, 0.1); }
    .bg-danger-soft  { background: rgba(239, 68, 68, 0.1); }

    .animate-up { animation: fadeInUp 0.5s var(--delay, 0s) both; }
    @@keyframes fadeInUp {
        from { opacity: 0; transform: translateY(20px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    .animate-pop { animation: popIn 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275); }
    @@keyframes popIn {
        from { transform: scale(0.8); opacity: 0; }
        to   { transform: scale(1); opacity: 1; }
    }
</style>

@code {
    private ContactForm form = new();
    private bool isSending = false;
    private bool submitted = false;
    private string? errorMsg;

    private async Task HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(form.Name) ||
            string.IsNullOrWhiteSpace(form.Email) ||
            string.IsNullOrWhiteSpace(form.Message))
        {
            errorMsg = "يرجى ملء جميع الحقول المطلوبة";
            return;
        }

        isSending = true;
        errorMsg = null;

        // Simulate network delay
        await Task.Delay(1200);

        submitted = true;
        isSending = false;
        form = new();
    }

    private class ContactForm
    {
        public string Name { get; set; } = "";
        public string Email { get; set; } = "";
        public string Subject { get; set; } = "";
        public string Message { get; set; } = "";
    }
}
