@code {
    private string activeTab = "general"; // "general" or "service"

    private string WhatsAppNumber => !string.IsNullOrWhiteSpace(State.ContactWhatsApp)
        ? State.ContactWhatsApp.TrimStart('+').Replace(" ", "")
        : "201065016032";

    private string WhatsAppDisplay => $"+{WhatsAppNumber}";
    private string WhatsAppUrl => $"https://wa.me/{WhatsAppNumber}";

    private string SupportEmail => !string.IsNullOrWhiteSpace(State.ContactEmail)
        ? State.ContactEmail
        : "khadamawy@gmail.com";

    private const string FacebookUrl = "https://www.facebook.com/share/1bpy2Jh2NF/";
    private const string SupportHours = "السبت – الخميس: 9ص – 9م";

    // General Form Fields
    private ContactForm form = new();

    // Service Template Fields
    private string svcApplicantName = "";
    private string svcApplicantPhone = "";
    private string svcApplicantWhatsApp = "";
    private string svcApplicantEmail = "";
    private string svcTitle = "";
    private string svcCategory = "";
    private string svcGovCity = "";
    private string svcAddress = "";
    private string svcWorkHours = "";
    private string svcPrice = "";
    private string svcLinks = "";
    private string svcDescription = "";

    private bool showTemplatePreview = false;
    private bool isSending = false;
    private bool submitted = false;
    private bool submittedWasService = false;
    private string? errorMsg;

    [Inject] private Khadamat.BlazorUI.Services.ApiClient Api { get; set; } = default!;

    private void SetTab(string tab)
    {
        activeTab = tab;
        errorMsg = null;
    }

    private void OnGeneralSubjectChanged()
    {
        if (form.Subject == "provider")
        {
            // Auto switch or alert user
        }
    }

    private void ResetForm()
    {
        submitted = false;
        form = new();
        svcApplicantName = "";
        svcApplicantPhone = "";
        svcApplicantWhatsApp = "";
        svcApplicantEmail = "";
        svcTitle = "";
        svcCategory = "";
        svcGovCity = "";
        svcAddress = "";
        svcWorkHours = "";
        svcPrice = "";
        svcLinks = "";
        svcDescription = "";
        errorMsg = null;
    }

    /// <summary>
    /// صياغة القالب المنظم بصيغة قياسية موحدة لقراءتها من المدير ومساعد الذكاء الاصطناعي
    /// </summary>
    private string BuildServiceTemplateText()
    {
        var wa = !string.IsNullOrWhiteSpace(svcApplicantWhatsApp) ? svcApplicantWhatsApp : svcApplicantPhone;
        var em = !string.IsNullOrWhiteSpace(svcApplicantEmail) ? svcApplicantEmail : "غير محدد";
        var hrs = !string.IsNullOrWhiteSpace(svcWorkHours) ? svcWorkHours : "متاح يومياً";
        var prc = !string.IsNullOrWhiteSpace(svcPrice) ? svcPrice : "حسب المعاينة / بالتواصل";
        var lnk = !string.IsNullOrWhiteSpace(svcLinks) ? svcLinks : "غير متوفر";

        return
            "=== [طلب انضمام وإضافة خدمة جديدة] ===\n" +
            $"👤 مقدم الطلب: {svcApplicantName.Trim()}\n" +
            $"📞 رقم الهاتف: {svcApplicantPhone.Trim()}\n" +
            $"💬 رقم الواتساب: {wa.Trim()}\n" +
            $"📧 البريد الإلكتروني: {em.Trim()}\n" +
            "\n" +
            "--- بيانات الخدمة والنشاط ---\n" +
            $"📌 اسم الخدمة: {svcTitle.Trim()}\n" +
            $"📁 المجال المقترح: {svcCategory.Trim()}\n" +
            $"📍 المحافظة والمدينة: {svcGovCity.Trim()}\n" +
            $"🏢 العنوان بالتفصيل: {svcAddress.Trim()}\n" +
            $"⏰ مواعيد العمل: {hrs.Trim()}\n" +
            $"💰 السعر / نظام العمل: {prc.Trim()}\n" +
            $"🌐 صفحة فيسبوك / رابط: {lnk.Trim()}\n" +
            "\n" +
            "--- وصف وتفاصيل الخدمة ---\n" +
            $"{svcDescription.Trim()}\n" +
            "======================================";
    }

    private string BuildWhatsAppDirectUrl()
    {
        if (activeTab == "service" && (!string.IsNullOrWhiteSpace(svcTitle) || !string.IsNullOrWhiteSpace(svcApplicantName)))
        {
            return BuildServiceWhatsAppUrl();
        }
        return $"https://wa.me/{WhatsAppNumber}?text={Uri.EscapeDataString("مرحباً، أحتاج مساعدة أو استفسار بخصوص منصة وتطبيق خدماوي.")}";
    }

    private string BuildGeneralWhatsAppUrl()
    {
        var msg = $"مرحباً، أنا {form.Name}.\n" +
                  (!string.IsNullOrWhiteSpace(form.Subject) ? $"الموضوع: {SubjectLabel(form.Subject)}\n" : "") +
                  (!string.IsNullOrWhiteSpace(form.Message) ? $"\n{form.Message}" : "\nأحتاج مساعدة.");
        return $"https://wa.me/{WhatsAppNumber}?text={Uri.EscapeDataString(msg)}";
    }

    private string BuildServiceWhatsAppUrl()
    {
        var text = BuildServiceTemplateText();
        return $"https://wa.me/{WhatsAppNumber}?text={Uri.EscapeDataString(text)}";
    }

    private async Task HandleSubmitGeneral()
    {
        if (string.IsNullOrWhiteSpace(form.Name) ||
            string.IsNullOrWhiteSpace(form.Email) ||
            string.IsNullOrWhiteSpace(form.Message))
        {
            errorMsg = "يرجى ملء جميع الحقول المطلوبة (الاسم، رقم التواصل، الرسالة)";
            return;
        }

        isSending = true;
        errorMsg = null;

        try
        {
            var payload = new
            {
                Name = form.Name.Trim(),
                Email = form.Email.Trim(),
                Subject = !string.IsNullOrWhiteSpace(form.Subject) ? SubjectLabel(form.Subject) : "استفسار عام",
                SubjectType = !string.IsNullOrWhiteSpace(form.Subject) ? form.Subject : "other",
                Message = form.Message.Trim()
            };

            var result = await Api.PostAsync<ContactResult>("v1/contact", payload);
            if (result?.Success == true)
            {
                submitted = true;
                submittedWasService = false;
                form = new();
            }
            else
            {
                errorMsg = result?.Message ?? "حدث خطأ أثناء الإرسال، يرجى المحاولة مرة أخرى";
            }
        }
        catch (Exception ex)
        {
            errorMsg = "حدث خطأ غير متوقع: " + ex.Message;
        }
        finally
        {
            isSending = false;
        }
    }

    private async Task HandleSubmitServiceTemplate()
    {
        if (string.IsNullOrWhiteSpace(svcApplicantName) ||
            string.IsNullOrWhiteSpace(svcApplicantPhone) ||
            string.IsNullOrWhiteSpace(svcTitle) ||
            string.IsNullOrWhiteSpace(svcCategory) ||
            string.IsNullOrWhiteSpace(svcGovCity) ||
            string.IsNullOrWhiteSpace(svcAddress) ||
            string.IsNullOrWhiteSpace(svcDescription))
        {
            errorMsg = "يرجى ملء كافة الحقول الأساسية المطلوبة المؤشر عليها بـ (*)";
            return;
        }

        isSending = true;
        errorMsg = null;

        try
        {
            var structuredText = BuildServiceTemplateText();

            var payload = new
            {
                Name = svcApplicantName.Trim(),
                Email = !string.IsNullOrWhiteSpace(svcApplicantEmail) ? svcApplicantEmail.Trim() : svcApplicantPhone.Trim(),
                Subject = $"طلب انضمام خدمة: {svcTitle.Trim()}",
                SubjectType = "provider",
                Message = structuredText
            };

            var result = await Api.PostAsync<ContactResult>("v1/contact", payload);
            if (result?.Success == true)
            {
                submitted = true;
                submittedWasService = true;
            }
            else
            {
                errorMsg = result?.Message ?? "حدث خطأ أثناء إرسال القالب، يمكنك إرساله مباشرة عبر واتساب";
            }
        }
        catch (Exception ex)
        {
            errorMsg = "حدث خطأ أثناء الإرسال: " + ex.Message;
        }
        finally
        {
            isSending = false;
        }
    }

    private static string SubjectLabel(string? type) => type switch
    {
        "technical"  => "مشكلة تقنية",
        "account"    => "مشكلة في الحساب",
        "provider"   => "الانضمام كمزود خدمة",
        "complaint"  => "شكوى",
        "suggestion" => "اقتراح",
        _            => "استفسار عام"
    };

    private class ContactForm
    {
        public string Name { get; set; } = "";
        public string Email { get; set; } = "";
        public string Subject { get; set; } = "";
        public string Message { get; set; } = "";
    }

    private class ContactResult
    {
        public bool Success { get; set; }
        public string? Message { get; set; }
    }
}
