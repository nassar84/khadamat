@page "/contact"
@inject Khadamat.BlazorUI.State.AppState State
@inject IJSRuntime JS

<div class="contact-page container py-4" style="max-width:920px;">

    <!-- ── رأس الصفحة ── -->
    <div class="mb-4 text-center animate-up">
        <div class="page-icon-wrap mx-auto mb-3">
            <i class="fa-solid fa-headset"></i>
        </div>
        <h1 class="fw-bold mb-1">تواصل مع إدارة المنصة</h1>
        <p class="text-muted">نحن هنا لمساعدتك والإجابة على استفساراتك واستقبال طلبات الانضمام للخدمات.</p>
    </div>

    <!-- ── زر واتساب البارز ── -->
    <a href="@BuildWhatsAppDirectUrl()"
       target="_blank"
       rel="noopener noreferrer"
       class="whatsapp-hero d-flex align-items-center justify-content-between animate-up"
       style="--delay:0.05s">
        <div class="d-flex align-items-center gap-3">
            <div class="wa-icon-wrap">
                <i class="fa-brands fa-whatsapp"></i>
            </div>
            <div class="text-start">
                <div class="fw-bold fs-5">تواصل عبر واتساب مباشرة</div>
                <div class="wa-sub">اضغط هنا للتحدث مع فريق الدعم والإدارة فوراً</div>
                <div class="wa-number" dir="ltr" style="direction: ltr !important; unicode-bidi: isolate !important; text-align: right;">@WhatsAppDisplay</div>
            </div>
        </div>
        <div class="wa-arrow">
            <i class="fa-solid fa-arrow-left fs-4"></i>
        </div>
    </a>

    <!-- ── معلومات + النموذج ── -->
    <div class="row g-4 mt-1">

        <!-- معلومات التواصل الجانبية -->
        <div class="col-lg-4 col-md-5">
            <div class="glass-card p-4 h-100 animate-up" style="--delay:0.1s">
                <h5 class="fw-bold mb-4">طرق التواصل</h5>

                <!-- واتساب -->
                <a href="@WhatsAppUrl" target="_blank" rel="noopener noreferrer" class="contact-method-link mb-3">
                    <div class="contact-method wa-method">
                        <div class="cm-icon">
                            <i class="fa-brands fa-whatsapp"></i>
                        </div>
                        <div class="cm-body">
                            <div class="cm-label">واتساب</div>
                            <div class="cm-value" dir="ltr" style="direction: ltr !important; unicode-bidi: isolate !important; text-align: right;">@WhatsAppDisplay</div>
                        </div>
                        <i class="fa-solid fa-arrow-up-right-from-square cm-ext text-success"></i>
                    </div>
                </a>

                <!-- البريد الإلكتروني -->
                <a href="mailto:@SupportEmail" class="contact-method-link mb-3">
                    <div class="contact-method email-method">
                        <div class="cm-icon">
                            <i class="fa-solid fa-envelope"></i>
                        </div>
                        <div class="cm-body">
                            <div class="cm-label">البريد الإلكتروني</div>
                            <div class="cm-value" dir="ltr" style="direction: ltr !important; unicode-bidi: isolate !important; text-align: right;">@SupportEmail</div>
                        </div>
                        <i class="fa-solid fa-arrow-up-right-from-square cm-ext"></i>
                    </div>
                </a>

                <!-- ساعات الدعم -->
                <div class="contact-method clock-method mb-3">
                    <div class="cm-icon">
                        <i class="fa-solid fa-clock"></i>
                    </div>
                    <div class="cm-body">
                        <div class="cm-label">ساعات العمل</div>
                        <div class="cm-value">@SupportHours</div>
                    </div>
                </div>

                <div class="feature-box p-3 rounded-4 bg-light border mt-4 text-center">
                    <div class="fw-bold small text-primary mb-1">
                        <i class="fa-solid fa-sparkles me-1 text-warning"></i> انضم كمقدم خدمة
                    </div>
                    <p class="text-muted xx-small mb-2" style="font-size: 0.76rem;">
                        هل تقدم خدمات أو أعمال مهنية؟ املأ قالب الخدمة وسيقوم فريقنا بمراجعته ونشره للعملاء.
                    </p>
                    <button class="btn btn-sm btn-outline-primary rounded-pill w-100 fw-bold"
                            @onclick='() => SetTab("service")'>
                        تعبئة قالب الخدمة 🚀
                    </button>
                </div>

                <hr class="my-4" />

                <h6 class="fw-bold mb-3">تابعنا على</h6>
                <div class="d-flex gap-2 flex-wrap">
                    <a href="@FacebookUrl" target="_blank" rel="noopener noreferrer" class="social-pill facebook">
                        <i class="fa-brands fa-facebook-f me-1"></i> فيسبوك
                    </a>
                    <a href="@WhatsAppUrl" target="_blank" rel="noopener noreferrer" class="social-pill whatsapp">
                        <i class="fa-brands fa-whatsapp me-1"></i> واتساب
                    </a>
                </div>
            </div>
        </div>

        <!-- قسم النماذج والتبويبات -->
        <div class="col-lg-8 col-md-7">
            <div class="glass-card p-4 animate-up" style="--delay:0.15s">

                <!-- ── تبويبات الاختيار ── -->
                <div class="contact-tabs d-flex p-1 bg-light rounded-pill mb-4 border shadow-sm">
                    <button type="button" 
                            class="tab-btn flex-fill py-2 px-3 rounded-pill border-0 fw-bold @(activeTab == "general" ? "active bg-white text-primary shadow-sm" : "text-muted")"
                            @onclick='() => SetTab("general")'>
                        <i class="fa-solid fa-envelope me-1"></i>
                        <span>استفسار أو رسالة عامة</span>
                    </button>
                    <button type="button" 
                            class="tab-btn flex-fill py-2 px-3 rounded-pill border-0 fw-bold @(activeTab == "service" ? "active bg-primary text-white shadow-sm" : "text-muted")"
                            @onclick='() => SetTab("service")'>
                        <i class="fa-solid fa-briefcase me-1"></i>
                        <span>طلب انضمام / إضافة خدمة 🚀</span>
                    </button>
                </div>

                @if (submitted)
                {
                    <div class="text-center py-5 animate-pop">
                        <div class="success-circle mx-auto mb-4">
                            <i class="fa-solid fa-check fs-2 text-white"></i>
                        </div>
                        <h4 class="fw-bold">تم إرسال طلبك بنجاح! 🎉</h4>
                        <p class="text-muted px-md-5">
                            @(submittedWasService 
                                ? "شكراً لرغبتك بالانضمام لمنصتنا! تم حفظ بيانات الخدمة وسيتم مراجعتها من قِبل الإدارة والتواصل معك قريباً." 
                                : "شكراً لتواصلك معنا، سنرد عليك في أقرب وقت ممكن.")
                        </p>
                        <div class="d-flex gap-2 justify-content-center flex-wrap mt-4">
                            <button class="btn btn-outline-primary rounded-pill px-4"
                                    @onclick="ResetForm">
                                إرسال طلب آخر
                            </button>
                            <a href="@BuildWhatsAppDirectUrl()" target="_blank" rel="noopener noreferrer"
                               class="btn btn-whatsapp-send rounded-pill px-4">
                                <i class="fa-brands fa-whatsapp me-2"></i>متابعة عبر واتساب
                            </a>
                        </div>
                    </div>
                }
                else if (activeTab == "general")
                {
                    <!-- ── 1. نموذج الاستفسار العام ── -->
                    <div class="animate-fade-in">
                        <h5 class="fw-bold mb-1">أرسل استفسارك للإدارة</h5>
                        <p class="text-muted small mb-4">
                            يمكنك كتابة رسالتك هنا أو مراسلتنا مباشرة عبر واتساب.
                        </p>

                        <div class="mb-3">
                            <label class="form-label small fw-bold">الاسم الكامل <span class="text-danger">*</span></label>
                            <input id="contact-name" type="text" class="form-control premium-input" @bind="form.Name"
                                   placeholder="أدخل اسمك بالكامل" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold">رقم الهاتف أو البريد الإلكتروني <span class="text-danger">*</span></label>
                            <input id="contact-email" type="text" class="form-control premium-input" @bind="form.Email"
                                   placeholder="01xxxxxxxxx أو example@email.com" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold">الموضوع</label>
                            <select id="contact-subject" class="form-select premium-input" @bind="form.Subject" @bind:after="OnGeneralSubjectChanged">
                                <option value="">-- اختر موضوع الرسالة --</option>
                                <option value="technical">مشكلة تقنية</option>
                                <option value="account">مشكلة في الحساب</option>
                                <option value="provider">الانضمام كمزود خدمة (قالب مخصص)</option>
                                <option value="complaint">شكوى</option>
                                <option value="suggestion">اقتراح</option>
                                <option value="other">أخرى</option>
                            </select>
                        </div>

                        @if (form.Subject == "provider")
                        {
                            <div class="alert alert-info rounded-4 small py-2 mb-3 d-flex align-items-center justify-content-between flex-wrap gap-2">
                                <div>
                                    <i class="fa-solid fa-lightbulb text-warning me-1"></i>
                                    <strong>هل ترغب في إضافة بيانات خدمتك بالتفصيل؟</strong> نوفر قالباً منظماً يسهل مراجعته بسرعة.
                                </div>
                                <button type="button" class="btn btn-sm btn-primary rounded-pill px-3" @onclick='() => SetTab("service")'>
                                    الانتقال لقالب الخدمة 🚀
                                </button>
                            </div>
                        }

                        <div class="mb-4">
                            <label class="form-label small fw-bold">الرسالة <span class="text-danger">*</span></label>
                            <textarea id="contact-message" class="form-control premium-input" @bind="form.Message" rows="4"
                                      placeholder="اكتب تفاصيل رسالتك هنا..."></textarea>
                        </div>

                        @if (!string.IsNullOrEmpty(errorMsg))
                        {
                            <div class="alert alert-danger rounded-4 small py-2 mb-3">
                                <i class="fa-solid fa-circle-exclamation me-2"></i>@errorMsg
                            </div>
                        }

                        <!-- أزرار الإرسال -->
                        <div class="d-flex gap-2 flex-wrap">
                            <button id="contact-submit-btn"
                                    class="btn btn-contact-submit flex-fill py-3 rounded-pill fw-bold"
                                    @onclick="HandleSubmitGeneral" disabled="@isSending">
                                @if (isSending)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                    <span>جاري الإرسال...</span>
                                }
                                else
                                {
                                    <i class="fa-solid fa-paper-plane me-2"></i>
                                    <span>إرسال الرسالة</span>
                                }
                            </button>

                            <a href="@BuildGeneralWhatsAppUrl()" target="_blank" rel="noopener noreferrer"
                               class="btn btn-whatsapp-send flex-fill py-3 rounded-pill fw-bold">
                                <i class="fa-brands fa-whatsapp me-2 fs-5"></i>
                                إرسال عبر واتساب
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    <!-- ── 2. قالب طلب انضمام وإضافة خدمة جديدة (Structured Service Template) ── -->
                    <div class="animate-fade-in">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <h5 class="fw-bold mb-0 text-primary">
                                <i class="fa-solid fa-clipboard-list me-2"></i>قالب بيانات الخدمة / النشاط التجاري
                            </h5>
                            <span class="badge bg-primary-subtle text-primary border rounded-pill px-3 py-1 small">
                                منظم للإدارة ومساعد الذكاء الاصطناعي
                            </span>
                        </div>
                        <p class="text-muted small mb-4">
                            يرجى ملء بيانات نشاطك بدقة لتتمكن الإدارة من مراجعتها ونشرها على المنصة بأسرع وقت.
                        </p>

                        <!-- القسم 1: بيانات مقدم الطلب -->
                        <div class="p-3 bg-light rounded-4 mb-3 border">
                            <div class="fw-bold small text-dark mb-3">
                                <i class="fa-solid fa-user-tie text-primary me-1"></i> 1. بيانات المسؤول ومقدم الطلب
                            </div>
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <label class="form-label xx-small fw-bold text-muted mb-1">اسم مقدم الطلب / المسؤول <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control form-control-sm premium-input" @bind="svcApplicantName" placeholder="مثال: م. أحمد محمد" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label xx-small fw-bold text-muted mb-1">رقم الهاتف الأساسي <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control form-control-sm premium-input" @bind="svcApplicantPhone" placeholder="01xxxxxxxxx" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label xx-small fw-bold text-muted mb-1">رقم الواتساب للتواصل (إن اختلف)</label>
                                    <input type="text" class="form-control form-control-sm premium-input" @bind="svcApplicantWhatsApp" placeholder="01xxxxxxxxx" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label xx-small fw-bold text-muted mb-1">البريد الإلكتروني (اختياري)</label>
                                    <input type="email" class="form-control form-control-sm premium-input" @bind="svcApplicantEmail" placeholder="example@email.com" />
                                </div>
                            </div>
                        </div>

                        <!-- القسم 2: تفاصيل الخدمة والنشاط -->
                        <div class="p-3 bg-light rounded-4 mb-3 border">
                            <div class="fw-bold small text-dark mb-3">
                                <i class="fa-solid fa-store text-primary me-1"></i> 2. بيانات الخدمة والنشاط التجاري
                            </div>
                            <div class="row g-2">
                                <div class="col-md-7">
                                    <label class="form-label xx-small fw-bold text-muted mb-1">اسم الخدمة أو النشاط التجاري <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control form-control-sm premium-input" @bind="svcTitle" placeholder="مثال: ورشة الأمانة لصيانة السيارات الحديثة" />
                                </div>
                                <div class="col-md-5">
                                    <label class="form-label xx-small fw-bold text-muted mb-1">القسم أو المجال المقترح <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control form-control-sm premium-input" @bind="svcCategory" placeholder="مثال: صيانة سيارات، تشطيبات، صحة..." />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label xx-small fw-bold text-muted mb-1">المحافظة والمدينة <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control form-control-sm premium-input" @bind="svcGovCity" placeholder="مثال: القاهرة - مدينة نصر" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label xx-small fw-bold text-muted mb-1">العنوان بالتفصيل أو نطاق التغطية <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control form-control-sm premium-input" @bind="svcAddress" placeholder="مثال: شارع الطيران بجوار مسجد رابعة / خدمة منزلية" />
                                </div>
                            </div>
                        </div>

                        <!-- القسم 3: مواعيد العمل والتسعير والوصف -->
                        <div class="p-3 bg-light rounded-4 mb-3 border">
                            <div class="fw-bold small text-dark mb-3">
                                <i class="fa-solid fa-clock-rotate-left text-primary me-1"></i> 3. مواعيد العمل، الأسعار وتفاصيل الخدمة
                            </div>
                            <div class="row g-2 mb-2">
                                <div class="col-md-6">
                                    <label class="form-label xx-small fw-bold text-muted mb-1">مواعيد وساعات العمل</label>
                                    <input type="text" class="form-control form-control-sm premium-input" @bind="svcWorkHours" placeholder="مثال: يومياً من 9 صباحاً إلى 10 مساءً" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label xx-small fw-bold text-muted mb-1">السعر أو طريقة التعامل</label>
                                    <input type="text" class="form-control form-control-sm premium-input" @bind="svcPrice" placeholder="مثال: يبدأ من 100 ج.م / كشف مجاني / بالمعاينة" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label xx-small fw-bold text-muted mb-1">صفحة فيسبوك أو رابط إضافي (اختياري)</label>
                                    <input type="text" class="form-control form-control-sm premium-input" @bind="svcLinks" placeholder="https://facebook.com/yourpage" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label xx-small fw-bold text-muted mb-1">وصف تفصيلي للخدمة والمميزات <span class="text-danger">*</span></label>
                                    <textarea class="form-control premium-input" rows="4" @bind="svcDescription"
                                              placeholder="اكتب شرحاً وافياً عن الخدمات التي تقدمها، الخبرات، الضمانات، وأي عروض خاصة للعملاء..."></textarea>
                                </div>
                            </div>
                        </div>

                        <!-- زر معاينة القالب المنظم -->
                        <div class="mb-3">
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3"
                                    @onclick="() => showTemplatePreview = !showTemplatePreview">
                                <i class="fa-solid @(showTemplatePreview ? "fa-eye-slash" : "fa-eye") me-1"></i>
                                @(showTemplatePreview ? "إخفاء معاينة القالب" : "معاينة القالب المنظم كما سيصل للإدارة والذكاء الاصطناعي")
                            </button>

                            @if (showTemplatePreview)
                            {
                                <div class="p-3 bg-dark text-light rounded-4 mt-2 font-monospace small" style="direction: rtl; text-align: right; white-space: pre-wrap; font-size: 0.82rem; line-height: 1.5; border: 1px solid #334155;">
@BuildServiceTemplateText()
                                </div>
                            }
                        </div>

                        @if (!string.IsNullOrEmpty(errorMsg))
                        {
                            <div class="alert alert-danger rounded-4 small py-2 mb-3">
                                <i class="fa-solid fa-circle-exclamation me-2"></i>@errorMsg
                            </div>
                        }

                        <!-- أزرار الإرسال -->
                        <div class="d-flex gap-2 flex-wrap">
                            <button class="btn btn-contact-submit flex-fill py-3 rounded-pill fw-bold"
                                    @onclick="HandleSubmitServiceTemplate" disabled="@isSending">
                                @if (isSending)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                    <span>جاري الإرسال...</span>
                                }
                                else
                                {
                                    <i class="fa-solid fa-paper-plane me-2"></i>
                                    <span>إرسال طلب الانضمام للإدارة</span>
                                }
                            </button>

                            <a href="@BuildServiceWhatsAppUrl()" target="_blank" rel="noopener noreferrer"
                               class="btn btn-whatsapp-send flex-fill py-3 rounded-pill fw-bold">
                                <i class="fa-brands fa-whatsapp me-2 fs-5"></i>
                                إرسال القالب عبر واتساب
                            </a>
                        </div>
                    </div>
                }

                <p class="text-muted small text-center mt-3 mb-0">
                    <i class="fa-solid fa-shield-halved text-success me-1"></i>
                    بياناتك في أمان ويتم مراجعتها من قِبل إدارة منصة وتطبيق خدماوي.
                </p>

            </div>
        </div>
    </div>
</div>

<style>
    /* ── صفحة التواصل ── */
    .contact-page { padding-bottom: 80px; }

    /* أيقونة العنوان */
    .page-icon-wrap {
        width: 72px; height: 72px;
        border-radius: 20px;
        background: linear-gradient(135deg, #10b981, #059669);
        display: flex; align-items: center; justify-content: center;
        font-size: 1.8rem; color: white;
        box-shadow: 0 8px 24px rgba(16,185,129,.3);
    }

    /* ── زر واتساب البارز ── */
    .whatsapp-hero {
        display: flex;
        background: linear-gradient(135deg, #25d366 0%, #128c7e 100%) !important;
        border-radius: 20px;
        padding: 20px 24px;
        color: white !important;
        text-decoration: none !important;
        box-shadow: 0 8px 32px rgba(37,211,102,.35);
        transition: transform .25s, box-shadow .25s;
        margin-bottom: 8px;
    }
    .whatsapp-hero:hover {
        transform: translateY(-4px);
        box-shadow: 0 14px 40px rgba(37,211,102,.45);
    }
    .wa-icon-wrap {
        width: 60px; height: 60px;
        background: rgba(255,255,255,.2);
        border-radius: 18px;
        display: flex; align-items: center; justify-content: center;
        font-size: 2rem;
        flex-shrink: 0;
    }
    .wa-sub  { font-size: .85rem; opacity: .85; margin-top: 2px; }
    .wa-number {
        font-size: .95rem; font-weight: 700;
        letter-spacing: 1px;
        margin-top: 4px;
        opacity: .95;
    }
    .wa-arrow {
        background: rgba(255,255,255,.15);
        width: 44px; height: 44px;
        border-radius: 14px;
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
        transform: rotate(180deg);
    }

    /* ── بطاقة طريقة التواصل ── */
    .contact-method-link { text-decoration: none !important; display: block; }
    .contact-method {
        display: flex; align-items: center; gap: 12px;
        padding: 12px 14px;
        border-radius: 14px;
        border: 2px solid #f1f5f9;
        background: #f8fafc;
        transition: all .2s;
        cursor: pointer;
    }
    .contact-method-link:hover .contact-method {
        border-color: currentColor;
        transform: translateX(-4px);
    }
    .wa-method    { border-color: rgba(37,211,102,.25); color: #25d366; }
    .wa-method:hover { background: rgba(37,211,102,.06); }
    .email-method { color: var(--theme-primary, #2A7F8F); }
