@page "/provider/settings"
@using Khadamat.BlazorUI.Services
@using Khadamat.BlazorUI.Services.Auth
@using Khadamat.BlazorUI.State
@using Khadamat.Application.DTOs
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Provider")]
@inject IAuthService AuthService
@inject ApiClient Api
@inject NavigationManager Navigation
@inject AppState AppState
@inject IJSRuntime JS

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-9">
            <div class="d-flex align-items-center mb-4">
                <button class="btn btn-icon-glass me-3" @onclick='() => Navigation.NavigateTo("/provider/dashboard")'>
                    <i class="fa-solid fa-arrow-right"></i>
                </button>
                <h3 class="fw-bold mb-0">إعدادات حساب المزود</h3>
            </div>

            @if (isLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-3 text-muted">جاري تحميل الإعدادات...</p>
                </div>
            }
            else
            {
                <EditForm Model="model" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />

                    @if (!string.IsNullOrEmpty(feedbackMessage))
                    {
                        <div class="alert @(isSuccess ? "alert-success" : "alert-danger") rounded-4 shadow-sm mb-4 animate-pop">
                            <i class="fa-solid @(isSuccess ? "fa-circle-check" : "fa-circle-exclamation") me-2"></i>
                            @feedbackMessage
                        </div>
                    }

                    <!-- Business Identity Section -->
                    <div class="glass-card p-4 mb-4 shadow-sm">
                        <h5 class="fw-bold mb-4 border-bottom pb-2 text-primary">الهوية المهنية</h5>
                        <div class="row g-3">
                            <div class="col-12 mb-3 text-center">
                                <div class="position-relative d-inline-block">
                                    <img src="@(string.IsNullOrEmpty(model.Photo) ? AppState.UserImageUrl : model.Photo)" class="provider-avatar shadow-sm" />
                                    <div class="avatar-edit-btn">
                                        <InputFile id="photoInput" OnChange="HandleFileSelected" style="display:none" accept="image/*" />
                                        <label for="photoInput" class="cursor-pointer mb-0">
                                            <i class="fa-solid fa-camera"></i>
                                        </label>
                                    </div>
                                </div>
                                <p class="x-small text-muted mt-2">صورة العلامة التجارية أو الصورة الشخصية</p>
                            </div>
                            
                            <div class="col-md-12">
                                <label class="form-label small fw-bold">اسم النشاط التجاري / الاسم المهني</label>
                                <InputText @bind-Value="model.BusinessName" class="form-control premium-input" placeholder="مثال: ورشتي للصيانة، فني تكييف محترف..." />
                                <ValidationMessage For="@(() => model.BusinessName)" class="text-danger x-small" />
                            </div>

                            <div class="col-12">
                                <label class="form-label small fw-bold">النبذة التعريفية (Expertise & Bio)</label>
                                <InputTextArea @bind-Value="model.Bio" class="form-control premium-input" rows="4" placeholder="تحدث عن خبراتك، سنوات العمل، وما يميز خدماتك..." />
                                <ValidationMessage For="@(() => model.Bio)" class="text-danger x-small" />
                            </div>
                        </div>
                    </div>

                    <!-- Contact & Web Section -->
                    <div class="glass-card p-4 mb-4 shadow-sm">
                        <h5 class="fw-bold mb-4 border-bottom pb-2 text-primary">معلومات التواصل والربط</h5>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">رقم التواصل المباشر</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0"><i class="fa-solid fa-phone text-accent"></i></span>
                                    <InputText @bind-Value="model.ContactNumber" class="form-control premium-input border-start-0" placeholder="01xxxxxxxxx" />
                                </div>
                                <ValidationMessage For="@(() => model.ContactNumber)" class="text-danger x-small" />
                            </div>
                            
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">الموقع الإلكتروني</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0"><i class="fa-solid fa-globe text-primary"></i></span>
                                    <InputText @bind-Value="model.WebsiteUrl" class="form-control premium-input border-start-0" placeholder="https://example.com" />
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-bold">رابط انستجرام</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0"><i class="fa-brands fa-instagram text-danger"></i></span>
                                    <InputText @bind-Value="model.InstagramUrl" class="form-control premium-input border-start-0" placeholder="رابط الملف الشخصي" />
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-bold">رابط تويتر / X</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0"><i class="fa-brands fa-x-twitter text-dark"></i></span>
                                    <InputText @bind-Value="model.TwitterUrl" class="form-control premium-input border-start-0" placeholder="رابط الملف الشخصي" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-3 mb-5">
                        <button type="button" class="btn btn-light rounded-pill px-4" @onclick='() => Navigation.NavigateTo("/provider/dashboard")'>إلغاء</button>
                        <button type="submit" class="btn btn-primary-premium px-5 rounded-pill shadow-lg" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                <span>جاري الحفظ...</span>
                            }
                            else
                            {
                                <i class="fa-solid fa-save me-2"></i><span>حفظ الإعدادات بالكامل</span>
                            }
                        </button>
                    </div>
                </EditForm>
            }
        </div>
    </div>
</div>

<style>
    .premium-input {
        border: 2px solid #f1f5f9;
        background: #f8fafc;
        border-radius: 12px;
        padding: 10px 15px;
        transition: all 0.2s;
    }

    .premium-input:focus {
        background: white;
        border-color: var(--theme-primary);
        box-shadow: 0 0 0 4px rgba(var(--theme-primary-rgb), 0.1);
        outline: none;
    }

    .provider-avatar {
        width: 120px;
        height: 120px;
        border-radius: 30px;
        object-fit: cover;
        border: 4px solid white;
    }

    .avatar-edit-btn {
        position: absolute;
        bottom: -5px;
        right: -5px;
        background: var(--theme-primary);
        color: white;
        width: 32px;
        height: 32px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 10px rgba(0,0,0,0.2);
    }

    .btn-icon-glass {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        background: rgba(255,255,255,0.1);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(0,0,0,0.05);
        color: #64748b;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
    }

    .btn-icon-glass:hover {
        background: white;
        color: var(--theme-primary);
        transform: translateY(-2px);
    }

    .animate-pop { animation: popIn 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); }
    @@keyframes popIn {
        from { transform: scale(0.9); opacity: 0; }
        to { transform: scale(1); opacity: 1; }
    }
</style>

@code {
    private UpdateProviderProfileRequest model = new();
    private bool isLoading = true;
    private bool isSaving = false;
    private string? feedbackMessage;
    private bool isSuccess = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            var profileResult = await AuthService.GetProfileAsync();
            if (profileResult?.Success == true && profileResult.Data != null)
            {
                var profile = profileResult.Data;
                
                // Prefill model from profile
                model.BusinessName = profile.FullName; // Default business name to full name
                model.Bio = profile.Bio ?? "";
                model.ContactNumber = profile.PhoneNumber ?? "";
                model.TwitterUrl = profile.TwitterUrl;
                model.InstagramUrl = profile.InstagramUrl;
                model.WebsiteUrl = profile.WebsiteUrl;
                model.Photo = profile.ImageUrl;
                
                // If there's extra provider data, we could fetch it here
                // var providerExtra = await Api.GetProviderProfileAsync(profile.Id);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            feedbackMessage = "فشل تحميل البيانات";
            isSuccess = false;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.GetMultipleFiles(1).FirstOrDefault();
        if (file != null)
        {
            var format = "image/jpeg";
            var resizedImage = await file.RequestImageFileAsync(format, 400, 400);
            var buffer = new byte[resizedImage.Size];
            await resizedImage.OpenReadStream().ReadAsync(buffer);
            model.Photo = $"data:{format};base64,{Convert.ToBase64String(buffer)}";
        }
    }

    private async Task HandleSubmit()
    {
        isSaving = true;
        feedbackMessage = null;
        try
        {
            var success = await Api.UpdateProviderProfileAsync(model);
            if (success)
            {
                isSuccess = true;
                feedbackMessage = "تم تحديث إعدادات المزود بنجاح";
                
                // Sync State
                if (!string.IsNullOrEmpty(model.Photo)) AppState.UserImageUrl = model.Photo;
                
                StateHasChanged();
            }
            else
            {
                isSuccess = false;
                feedbackMessage = "حدث خطأ أثناء حفظ الإعدادات";
            }
        }
        catch (Exception ex)
        {
            isSuccess = false;
            feedbackMessage = "خطأ تقني: " + ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }
}
