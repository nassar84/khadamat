@page "/provider/subscription"
@using Khadamat.Application.DTOs
@using Khadamat.BlazorUI.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Provider")]
@inject ApiClient Api
@inject NavigationManager Navigation

<div class="px-3 pt-3 pb-5">

    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h3 class="fw-bold mb-0">اشتراكي الحالي</h3>
            <p class="text-muted small mb-0">تفاصيل باقتك وحدودها</p>
        </div>
        <button class="btn btn-primary-premium rounded-pill px-4"
                @onclick='() => Navigation.NavigateTo("/provider/plans")'>
            <i class="fa-solid fa-gem me-2"></i> ترقية الباقة
        </button>
    </div>

    @if (isLoading)
    {
        <div class="py-5 text-center">
            <div class="spinner-border text-primary"></div>
            <p class="mt-3 text-muted small">جاري تحميل بيانات الاشتراك...</p>
        </div>
    }
    else if (subscription == null)
    {
        <!-- No Active Subscription -->
        <div class="glass-card p-5 text-center animate-up">
            <div class="mb-4">
                <i class="fa-solid fa-box-open text-muted display-1 opacity-25"></i>
            </div>
            <h4 class="fw-bold mb-2">لا يوجد اشتراك نشط</h4>
            <p class="text-muted mb-4">اشترك في إحدى باقاتنا للحصول على مزايا إضافية وتعزيز ظهور خدماتك</p>
            <button class="btn btn-primary-premium rounded-pill px-5 py-3 shadow-lg"
                    @onclick='() => Navigation.NavigateTo("/provider/plans")'>
                <i class="fa-solid fa-gem me-2"></i> استعرض الباقات
            </button>
        </div>
    }
    else
    {
        <!-- Active Subscription Card -->
        <div class="sub-hero glass-card p-5 mb-4 position-relative overflow-hidden animate-up">
            <div class="sub-bg-glow"></div>
            <div class="row align-items-center">
                <div class="col-md-8 z-1">
                    <div class="badge bg-white text-primary fw-bold px-3 py-2 rounded-pill mb-3 shadow-sm">
                        <i class="fa-solid fa-circle text-success me-1 small"></i>
                        @(subscription.IsActive ? "اشتراك نشط" : "اشتراك منتهي")
                    </div>
                    <h2 class="fw-bold text-white mb-2">@subscription.PlanName</h2>
                    <p class="text-white opacity-75 mb-0">
                        ينتهي في: @subscription.EndDate.ToString("yyyy/MM/dd")
                    </p>
                </div>
                <div class="col-md-4 text-center mt-4 mt-md-0 z-1">
                    <div class="days-ring">
                        <div class="days-number">@Math.Max(0, subscription.DaysRemainingCount)</div>
                        <div class="days-label">يوم متبقي</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Timeline -->
        <div class="glass-card p-4 mb-4 animate-up" style="--delay:0.1s">
            <h5 class="fw-bold mb-4"><i class="fa-solid fa-calendar-days me-2 text-primary"></i>جدول الاشتراك</h5>
            <div class="d-flex gap-4 flex-wrap">
                <div class="timeline-block text-center">
                    <div class="timeline-icon bg-success-soft text-success">
                        <i class="fa-solid fa-play"></i>
                    </div>
                    <div class="small fw-bold mt-2">تاريخ البداية</div>
                    <div class="x-small text-muted">@subscription.StartDate.ToString("yyyy/MM/dd")</div>
                </div>
                <div class="timeline-line flex-grow-1 align-self-start mt-4 pt-2">
                    <div class="progress" style="height:6px; border-radius:10px;">
                        <div class="progress-bar bg-primary" 
                             style="width: @GetProgressPercent()%"></div>
                    </div>
                </div>
                <div class="timeline-block text-center">
                    <div class="timeline-icon bg-danger-soft text-danger">
                        <i class="fa-solid fa-flag-checkered"></i>
                    </div>
                    <div class="small fw-bold mt-2">تاريخ الانتهاء</div>
                    <div class="x-small text-muted">@subscription.EndDate.ToString("yyyy/MM/dd")</div>
                </div>
            </div>
        </div>

        <!-- Plan Features -->
        <div class="glass-card p-4 mb-4 animate-up" style="--delay:0.15s">
            <h5 class="fw-bold mb-4"><i class="fa-solid fa-list-check me-2 text-primary"></i>مزايا باقتك</h5>
            <div class="row g-3">
                <div class="col-6 col-md-4">
                    <div class="feature-chip p-3 rounded-4 bg-light d-flex align-items-center gap-3">
                        <div class="feature-icon bg-primary-soft text-primary">
                            <i class="fa-solid fa-briefcase"></i>
                        </div>
                        <div>
                            <div class="fw-bold small">الخدمات</div>
                            <div class="x-small text-muted">نشر غير محدود</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4">
                    <div class="feature-chip p-3 rounded-4 bg-light d-flex align-items-center gap-3">
                        <div class="feature-icon bg-success-soft text-success">
                            <i class="fa-solid fa-comments"></i>
                        </div>
                        <div>
                            <div class="fw-bold small">التواصل</div>
                            <div class="x-small text-muted">مباشر مع العملاء</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4">
                    <div class="feature-chip p-3 rounded-4 bg-light d-flex align-items-center gap-3">
                        <div class="feature-icon bg-warning-soft text-warning">
                            <i class="fa-solid fa-chart-line"></i>
                        </div>
                        <div>
                            <div class="fw-bold small">الإحصائيات</div>
                            <div class="x-small text-muted">تحليلات متقدمة</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4">
                    <div class="feature-chip p-3 rounded-4 bg-light d-flex align-items-center gap-3">
                        <div class="feature-icon bg-info-soft text-info">
                            <i class="fa-solid fa-newspaper"></i>
                        </div>
                        <div>
                            <div class="fw-bold small">المنشورات</div>
                            <div class="x-small text-muted">نشر تحديثاتك</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4">
                    <div class="feature-chip p-3 rounded-4 bg-light d-flex align-items-center gap-3">
                        <div class="feature-icon bg-danger-soft text-danger">
                            <i class="fa-solid fa-shield-halved"></i>
                        </div>
                        <div>
                            <div class="fw-bold small">الدعم</div>
                            <div class="x-small text-muted">دعم فني أولوية</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (subscription.DaysRemainingCount <= 7 && subscription.IsActive)
        {
            <div class="alert alert-warning rounded-4 border-0 shadow-sm animate-up" style="--delay:0.2s">
                <i class="fa-solid fa-triangle-exclamation me-2"></i>
                <strong>تنبيه:</strong> باقتك ستنتهي خلال @subscription.DaysRemainingCount أيام.
                <button class="btn btn-sm btn-warning rounded-pill ms-2 fw-bold"
                        @onclick='() => Navigation.NavigateTo("/provider/plans")'>
                    جدد الآن
                </button>
            </div>
        }
    }
</div>

<style>
    .sub-hero {
        background: linear-gradient(135deg, var(--theme-primary), var(--theme-secondary));
        border-radius: 24px;
    }

    .sub-bg-glow {
        position: absolute;
        width: 300px;
        height: 300px;
        border-radius: 50%;
        background: rgba(255,255,255,0.07);
        top: -100px;
        left: -80px;
        z-index: 0;
    }

    .z-1 { position: relative; z-index: 1; }

    .days-ring {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        border: 6px solid rgba(255,255,255,0.35);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        margin: 0 auto;
        background: rgba(255,255,255,0.1);
        backdrop-filter: blur(10px);
    }

    .days-number {
        font-size: 2rem;
        font-weight: 900;
        color: white;
        line-height: 1;
    }

    .days-label {
        font-size: 0.7rem;
        color: rgba(255,255,255,0.75);
        font-weight: 600;
    }

    .timeline-block { min-width: 100px; }

    .timeline-icon {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        margin: 0 auto;
    }

    .feature-chip { transition: all 0.2s; cursor: default; }
    .feature-chip:hover { transform: translateY(-4px); box-shadow: 0 8px 20px rgba(0,0,0,0.07); }

    .feature-icon {
        width: 40px;
        height: 40px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .bg-primary-soft { background: rgba(99, 102, 241, 0.1); }
    .bg-success-soft { background: rgba(16, 185, 129, 0.1); }
    .bg-warning-soft { background: rgba(245, 158, 11, 0.1); }
    .bg-danger-soft  { background: rgba(239, 68, 68, 0.1); }
    .bg-info-soft    { background: rgba(6, 182, 212, 0.1); }

    .animate-up {
        animation: fadeInUp 0.5s var(--delay, 0s) both;
    }

    @@keyframes fadeInUp {
        from { opacity: 0; transform: translateY(20px); }
        to   { opacity: 1; transform: translateY(0); }
    }
</style>

@code {
    private ProviderSubscriptionDto? subscription;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            subscription = await Api.GetMySubscriptionAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine("Subscription load error: " + ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private double GetProgressPercent()
    {
        if (subscription == null) return 0;
        var total = (subscription.EndDate - subscription.StartDate).TotalDays;
        var elapsed = (DateTime.UtcNow - subscription.StartDate).TotalDays;
        if (total <= 0) return 100;
        return Math.Min(100, Math.Max(0, (elapsed / total) * 100));
    }
}
