
@page "/provider/dashboard"
@using Khadamat.Application.DTOs
@using Khadamat.BlazorUI.Components.Provider
@using Khadamat.BlazorUI.Services
@using Khadamat.BlazorUI.State
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation
@inject ApiClient Api
@inject AppState AppState
@inject AuthenticationStateProvider AuthStateProvider

<div class="px-3 pt-3 pb-5">
    @if (isError)
    {
        <div class="text-center py-5">
            <i class="fa-solid fa-lock text-warning fs-1 mb-3"></i>
            <h4 class="fw-bold">يجب عليك تسجيل الدخول أولاً</h4>
            <p class="text-muted">هذه الصفحة مخصصة لمزودي الخدمات. يرجى تسجيل الدخول للوصول إلى لوحة التحكم.</p>
            <button class="btn btn-primary rounded-pill px-4 mt-3" @onclick='() => Navigation.NavigateTo("/login")'>تسجيل الدخول</button>
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-bold mb-0 gradient-text">لوحة المزود</h3>
                <p class="text-muted x-small mb-0">مرحباً @AppState.UserName</p>
            </div>
            <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2">
                <i class="fa-solid fa-circle me-1" style="font-size:8px;"></i>نشط
            </span>
        </div>

        <!-- Stats Grid -->
        <div class="row g-3 mb-4">
            <div class="col-6">
                <StatsWidget Icon="fa-solid fa-eye" Label="المشاهدات" Value="@totalViews" Color="primary" />
            </div>
            <div class="col-6">
                <StatsWidget Icon="fa-solid fa-star" Label="التقييم" Value="@avgRating" Color="warning" />
            </div>
            <div class="col-6">
                <StatsWidget Icon="fa-solid fa-clipboard-check" Label="الطلبات" Value="@totalRequests" Color="success" />
            </div>
            <div class="col-6">
                <StatsWidget Icon="fa-solid fa-briefcase" Label="الخدمات" Value="@totalServices" Color="info" />
            </div>
        </div>

        <!-- Subscription Status -->
        @if (subscription != null)
        {
            <SubscriptionStatus PlanName="@subscription.PlanName"
                                DaysRemaining="@subscription.DaysRemainingCount"
                                IsActive="@subscription.IsActive" />
        }
        else
        {
            <div class="glass-card p-3 mb-4 d-flex align-items-center justify-content-between border border-dashed">
                <div class="d-flex align-items-center gap-2 text-muted">
                    <i class="fa-solid fa-gem text-primary"></i>
                    <span class="small">لا يوجد اشتراك نشط</span>
                </div>
                <button class="btn btn-sm btn-primary-premium rounded-pill px-3"
                        @onclick='() => Navigation.NavigateTo("/provider/plans")'>
                    اشترك الآن
                </button>
            </div>
        }

        <!-- Quick Actions -->
        <h6 class="fw-bold mb-3 mt-4">إجراءات سريعة</h6>
        <div class="row g-3 mb-4">
            <div class="col-4 text-center" @onclick='() => Navigation.NavigateTo("/provider/create-service")'>
                <div class="action-btn bg-primary bg-opacity-10 text-primary mb-2 mx-auto">
                    <i class="fa-solid fa-plus fs-4"></i>
                </div>
                <div class="small fw-bold">خدمة جديدة</div>
            </div>
            <div class="col-4 text-center" @onclick='() => Navigation.NavigateTo("/provider/create-post")'>
                <div class="action-btn bg-success bg-opacity-10 text-success mb-2 mx-auto">
                    <i class="fa-solid fa-pen-to-square fs-4"></i>
                </div>
                <div class="small fw-bold">نشر تحديث</div>
            </div>
            <div class="col-4 text-center" @onclick='() => Navigation.NavigateTo("/provider/my-services")'>
                <div class="action-btn bg-info bg-opacity-10 text-info mb-2 mx-auto">
                    <i class="fa-solid fa-list-check fs-4"></i>
                </div>
                <div class="small fw-bold">إدارة الخدمات</div>
            </div>
            <div class="col-4 text-center" @onclick='() => Navigation.NavigateTo("/provider/statistics")'>
                <div class="action-btn bg-warning bg-opacity-10 text-warning mb-2 mx-auto">
                    <i class="fa-solid fa-chart-line fs-4"></i>
                </div>
                <div class="small fw-bold">الإحصائيات</div>
            </div>
            <div class="col-4 text-center" @onclick='() => Navigation.NavigateTo("/provider/subscription")'>
                <div class="action-btn bg-danger bg-opacity-10 text-danger mb-2 mx-auto">
                    <i class="fa-solid fa-gem fs-4"></i>
                </div>
                <div class="small fw-bold">اشتراكي</div>
            </div>
            <div class="col-4 text-center" @onclick='() => Navigation.NavigateTo("/provider/settings")'>
                <div class="action-btn bg-secondary bg-opacity-10 text-secondary mb-2 mx-auto">
                    <i class="fa-solid fa-gear fs-4"></i>
                </div>
                <div class="small fw-bold">الإعدادات</div>
            </div>
        </div>

        <!-- Recent Messages -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="fw-bold mb-0">رسائل حديثة</h6>
            <button class="btn btn-link text-primary p-0 small text-decoration-none" @onclick='() => Navigation.NavigateTo("/user/messages")'>عرض الكل</button>
        </div>
        
        <div class="glass-container rounded-4 overflow-hidden border">
            @for (int i = 0; i < 3; i++)
            {
                var idx = i;
                <div class="p-3 border-bottom d-flex gap-3 align-items-center list-item-hover"
                     @onclick='() => Navigation.NavigateTo("/user/messages")'>
                    <img src="https://i.pravatar.cc/150?u=@idx" class="rounded-circle" width="45" height="45" />
                    <div class="flex-grow1">
                        <div class="d-flex justify-content-between">
                            <h6 class="fw-bold mb-0 small">عميل @(idx+1)</h6>
                            <span class="text-muted x-small">10:30 ص</span>
                        </div>
                        <p class="text-muted mb-0 small text-truncate" style="max-width: 200px;">أريد الاستفسار عن تفاصيل الخدمة...</p>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .action-btn {
        width: 60px;
        height: 60px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: transform 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    }
    .action-btn:hover { transform: scale(1.15) translateY(-2px); }
    .list-item-hover { cursor: pointer; transition: background 0.2s; }
    .list-item-hover:hover { background: rgba(0,0,0,0.02); }
</style>

@code {
    private ProviderSubscriptionDto? subscription;
    private bool isError = false;
    private string totalViews    = "0";
    private string avgRating     = "0.0";
    private string totalRequests = "0";
    private string totalServices = "0";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState?.User?.Identity?.IsAuthenticated != true)
        {
            isError = true;
            return;
        }

        try
        {
            var servicesTask     = Api.GetMyServicesAsync();
            var subscriptionTask = Api.GetMySubscriptionAsync();
            var requestsTask     = Api.GetProviderRequestsAsync();

            await Task.WhenAll(servicesTask, subscriptionTask, requestsTask);

            var services = servicesTask.Result?.Items ?? new();
            subscription = subscriptionTask.Result;
            var requests = requestsTask.Result ?? new();

            totalServices = services.Count.ToString();
            totalRequests = requests.Count.ToString();
            totalViews    = services.Sum(s => s.ViewsCount).ToString("N0");
            
            var rated = services.Where(s => s.Rating > 0).ToList();
            avgRating = rated.Any() ? rated.Average(s => s.Rating).ToString("F1") : "0.0";
        }
        catch (Exception ex)
        {
            Console.WriteLine("Dashboard load error: " + ex.Message);
        }
    }
}

