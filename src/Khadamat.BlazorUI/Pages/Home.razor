    private void OnServiceSelected(ServiceDto service) => Navigation.NavigateTo($"/service/{service.Id}");

    private void OnCategorySelected(MainCategoryDto cat) => Navigation.NavigateTo($"/explore/main/{cat.Id}/{Uri.EscapeDataString(cat.Name)}");

    private void GoToRegisterProvider()
    {
