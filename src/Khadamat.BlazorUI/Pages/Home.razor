@page "/"
@using Khadamat.Application.DTOs
@using Khadamat.BlazorUI.Services
@using Khadamat.BlazorUI.Components.ServiceRelated
@inject ApiClient Api
@inject NavigationManager Navigation
@inject Khadamat.BlazorUI.State.AppState AppState
@inject Khadamat.Application.Interfaces.IOfflineDataService OfflineData
@inject IJSRuntime JS
@inject HttpClient Http
@implements IDisposable

<!-- Category Marquee Bar (Horizontal Scrolling) -->
<div class="sticky-categories-bar" style="min-height: 110px; display: block !important;">
    <Khadamat.BlazorUI.Shared.CategoryMarquee Categories="mainCategories" />
</div>

<div class="px-3">
    <!-- Ads Slider (Dynamic System) -->
    <Khadamat.BlazorUI.Components.Ads.AdsSlider />

    <!-- Sell on Marketplace Promo Banner -->
    <div class="sell-promo-banner mb-4" @onclick='() => Navigation.NavigateTo("/marketplace/create")'>
        <div class="sell-promo-bg">
            <div class="sell-promo-glow"></div>
            <div class="sell-promo-content">
                <div class="sell-promo-left">
                    <span class="sell-badge">🛍️ جديد</span>
                    <h4 class="sell-title">بيع سلعك على المتجر</h4>
                    <p class="sell-sub">أضف منتجك الآن وصل لآلاف المشترين</p>
                    <span class="sell-cta-btn">ابدأ البيع <i class="fa-solid fa-arrow-left ms-1"></i></span>
                </div>
                <div class="sell-promo-right">
                    <div class="sell-icon-ring">
                        <i class="fa-solid fa-store"></i>
                    </div>
                    <div class="sell-floating-tag"><i class="fa-solid fa-tag"></i> عرض مميز</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Featured Services (Horizontal Scroll) -->
    <div class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0">⭐ خدمات مميزة</h5>
            <a href="services" class="text-primary text-decoration-none fw-bold small">عرض الكل</a>
        </div>
        
        <div class="featured-scroll-container">
            @if (featuredServices != null)
            {
                @if (!featuredServices.Any())
                {
                    <div class="text-center p-4 opacity-50 bg-light rounded-4 w-100">
                        <i class="fa-solid fa-cloud-moon fs-1 mb-2"></i>
                        <p>لا توجد خدمات متاحة حالياً</p>
                    </div>
                }
                else
                {
                    <div class="d-flex gap-3 overflow-auto pb-2" style="scrollbar-width: none; -ms-overflow-style: none;">
                        @foreach (var service in featuredServices)
                        {
                            <div style="min-width: 280px;">
                                <ServiceCard Service="service" OnClick="OnServiceSelected" />
                            </div>
                        }
                    </div>
                }
            }
            else
            {
                <div class="d-flex gap-3 overflow-hidden">
                    <SkeletonLoader Type="card" Count="3" />
                </div>
            }
        </div>
    </div>

    <!-- Marketplace Announcement (Premium Ad Style) -->
    <div class="mb-5">
        <div class="marketplace-announcement-banner p-4 rounded-5 position-relative overflow-hidden mb-4 shadow-lg" @onclick='() => Navigation.NavigateTo("/marketplace")'>
            <div class="announcement-glass-overlay"></div>
            <div class="row align-items-center position-relative z-1">
                <div class="col-8">
                    <span class="badge bg-danger rounded-pill mb-2 px-3 animate-pulse">جديد 🔥</span>
                    <h3 class="fw-bold text-white mb-1">متجر @AppState.AppName (Marketplace)</h3>
                    <p class="text-white-50 mb-3">بيع، اشترِ، وتصفح أفضل العروض في منطقتك بكل سهولة وأمان.</p>
                    <button class="btn btn-outline-light rounded-pill px-4 fw-bold" @onclick='() => Navigation.NavigateTo("/marketplace")'>تصفح المتجر الآن <i class="fa-solid fa-arrow-left ms-2"></i></button>
                </div>
                <div class="col-4 text-center">
                    <div class="announcement-icon-wrapper">
                        <span class="store-icon-wrap">
                            <i class="fa-solid fa-store fa-5x text-white opacity-50 store-anim"></i>
                        </span>
                        <div class="floating-price-tag">
                            <i class="fa-solid fa-tag"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (latestMarketItems != null && latestMarketItems.Any())
        {
            <div class="d-flex gap-3 overflow-auto pb-2 scroll-hide">
                @foreach (var item in latestMarketItems)
                {
                    <div class="market-item-mini" @onclick='() => Navigation.NavigateTo($"/marketplace/item/{item.Id}")'>
                        <div class="mini-img-wrapper">
                            <img src="@Api.GetAbsoluteUrl(item.Images.FirstOrDefault()?.ImageUrl ?? "images/defaults/default-product.png")" />
                            <span class="mini-price">@item.Price.ToString("N0") ج.م</span>
                        </div>
                        <div class="p-2">
                             <div class="text-truncate small fw-bold">@item.Title</div>
                             <div class="text-muted extra-small"><i class="fa-solid fa-location-dot me-1"></i> @item.CityName</div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Nearby Services Section -->
    <div class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0">📍 قريبة منك</h5>
            <a href="services" class="text-primary text-decoration-none fw-bold small">عرض الكل</a>
        </div>

        <div class="nearby-list">
            @if (nearbyServices != null)
            {
                @foreach (var service in nearbyServices)
                {
                    <NearbyServiceCard Service="service" OnClick="OnServiceSelected" />
                }
            }
            else
            {
                <SkeletonLoader Type="list" Count="3" />
            }
        </div>
    </div>

    <!-- Mobile App Promo Section - Hidden when running inside MAUI App -->
    @if (!isMauiApp)
    {
    <div class="app-download-inline-card mb-5 premium-glass-card position-relative overflow-hidden">
        <!-- Glow Background Layer -->
        <div class="widget-aurora-glow-inline glow-1"></div>
        <div class="widget-aurora-glow-inline glow-2"></div>
        
        <div class="row align-items-center position-relative z-1 p-4 p-md-5">
            <div class="col-lg-7 mb-4 mb-lg-0 text-center text-lg-start">
                <div class="d-flex flex-column flex-lg-row align-items-center gap-3 mb-4">
                    <div class="logo-orb shadow-lg">
                        <i class="fa-solid fa-bolt-lightning text-white fs-3"></i>
                    </div>
                    <div>
                        <h2 class="fw-bold premium-text-glow mb-1 text-white">تطبيق خدمات موبايل</h2>
                        <p class="text-white-50 mb-0">كل ما تحتاجه في متناول يدك</p>
                    </div>
                </div>

                <div class="row g-3">
                    <!-- 1. Direct Download -->
                    <div class="col-sm-6">
                        <a href="/downloads/khadamat.apk" download="khadamat.apk" class="store-link-card play-store-glow d-flex align-items-center p-3 rounded-4 text-decoration-none h-100 w-100">
                            <div class="store-icon bg-white text-dark rounded-circle d-flex align-items-center justify-content-center me-3" style="width:45px;height:45px;min-width:45px;">
                                <i class="fa-brands fa-android fs-4 text-success"></i>
                            </div>
                            <div class="store-info text-white text-start">
                                <span class="d-block xx-small opacity-75">تحميل مباشر</span>
                                <span class="fw-bold fs-6">تنزيل (APK)</span>
                            </div>
                        </a>
                    </div>
                    


                    <!-- 3. Share App -->
                    <div class="col-sm-6">
                        <button type="button" @onclick="ShareApp" class="store-link-card share-app-glow border-0 d-flex align-items-center p-3 rounded-4 text-decoration-none w-100 h-100 text-start bg-transparent">
                            <div class="store-icon bg-white text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width:45px;height:45px;min-width:45px;">
                                <i class="fa-solid fa-share-nodes fs-4"></i>
                            </div>
                            <div class="store-info text-white text-start">
                                <span class="d-block xx-small opacity-75">أخبر أصدقائك</span>
                                <span class="fw-bold fs-6">مشاركة التطبيق</span>
                            </div>
                        </button>
                    </div>

                    <!-- 4. Scan QR -->
                    <div class="col-sm-6">
                        <div class="store-link-card qr-code-glow d-flex align-items-center p-3 rounded-4 h-100 w-100">
                            <div class="qr-code-mini-frame bg-white p-1 rounded-3 me-3 d-flex align-items-center justify-content-center" style="width:45px;height:45px;min-width:45px;">
                                <i class="fa-solid fa-qrcode fs-3 text-dark"></i>
                            </div>
                            <div class="store-info text-white text-start">
                                <span class="d-block fw-bold fs-6">امسح الكود ضوئياً</span>
                                <span class="d-block xx-small opacity-75">للتنزيل مباشرة</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-5 text-center mt-5 mt-lg-0 d-none d-md-block">
                <div class="qr-scan-section-large mx-auto">
                    <div class="qr-frame-large mx-auto mb-3">
                        <div class="qr-corner-lg top-left"></div>
                        <div class="qr-corner-lg top-right"></div>
                        <div class="qr-corner-lg bottom-left"></div>
                        <div class="qr-corner-lg bottom-right"></div>
                        <div class="qr-scanner-line-large"></div>
                        <i class="fa-solid fa-qrcode fa-6x text-white opacity-25"></i>
                    </div>
                    <span class="text-white opacity-75 small fw-bold mt-2 d-block">افتح الكاميرا وامسح الكود ضوئياً</span>
                </div>
            </div>
        </div>
    </div>
    }

    <!-- Join as Provider Banner -->
    <div class="provider-banner-card mb-5" @onclick="GoToRegisterProvider">
        <div class="banner-content">
            <div class="status-badge">فرصة عمل</div>
            <h3>كن مقدم خدمة</h3>
            <p>سجل مهاراتك ووصّل خدماتك لآلاف العملاء في منطقتك</p>
            <button class="btn-banner">سجل الآن مجاناً <i class="fa-solid fa-arrow-left ms-2"></i></button>
        </div>
        <div class="banner-icon">
            <i class="fa-solid fa-briefcase"></i>
        </div>
    </div>

    <!-- Bottom Page Ads -->
    <Khadamat.BlazorUI.Components.Ads.AdLocation Placement="Bottom" />
</div>

<style>
    .featured-scroll-container::-webkit-scrollbar {
        display: none;
    }

    /* === Sell Promo Banner === */
    .sell-promo-banner {
        border-radius: 20px;
        overflow: hidden;
        cursor: pointer;
        box-shadow: 0 8px 30px rgba(99, 60, 209, 0.2);
        transition: transform 0.4s ease, box-shadow 0.4s ease;
        position: relative;
    }

    .sell-promo-banner:hover {
        transform: translateY(-5px);
        box-shadow: 0 16px 40px rgba(99, 60, 209, 0.4);
    }

    .sell-promo-bg {
        background: linear-gradient(135deg, #4f46e5 0%, #ec4899 100%);
        padding: 30px;
        position: relative;
        overflow: hidden;
    }

    .sell-promo-glow {
        position: absolute;
        top: -50px;
        right: -30px;
        width: 150px;
        height: 150px;
        background: radial-gradient(circle, rgba(255,255,255,0.3) 0%, transparent 60%);
        animation: pulse-glow 4s infinite alternate;
    }

    .sell-promo-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: relative;
        z-index: 2;
    }

    .sell-promo-left {
        color: white;
    }

    .sell-badge {
        background: rgba(255, 255, 255, 0.2);
        backdrop-filter: blur(5px);
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: bold;
        display: inline-block;
        margin-bottom: 10px;
        animation: float 3s infinite ease-in-out;
    }

    .sell-title {
        font-weight: 800;
        font-size: 1.6rem;
        margin-bottom: 5px;
    }

    .sell-sub {
        opacity: 0.9;
        font-size: 0.9rem;
        margin-bottom: 15px;
    }

    .sell-cta-btn {
        background: white;
        color: #ec4899;
        font-weight: bold;
        padding: 8px 20px;
        border-radius: 30px;
        display: inline-block;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        transition: background 0.3s;
    }

    .sell-promo-banner:hover .sell-cta-btn {
        background: #f8fafc;
    }

    .sell-promo-right {
        position: relative;
    }

    .sell-icon-ring {
        width: 80px;
        height: 80px;
        background: rgba(255,255,255,0.15);
        border: 2px solid rgba(255,255,255,0.3);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.2rem;
        color: white;
        box-shadow: 0 0 20px rgba(255,255,255,0.2);
        transform: rotate(-10deg);
        transition: transform 0.5s ease;
    }

    .sell-promo-banner:hover .sell-icon-ring {
        transform: rotate(10deg) scale(1.1);
    }

    .sell-floating-tag {
        position: absolute;
        bottom: -10px;
        right: -15px;
        background: #f59e0b;
        color: white;
        font-size: 0.7rem;
        font-weight: bold;
        padding: 3px 8px;
        border-radius: 12px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.2);
        animation: float 3s ease-in-out infinite;
    }

    @@keyframes pulse-glow {
        0% { transform: scale(1); opacity: 0.8; }
        100% { transform: scale(1.3); opacity: 0.4; }
    }

    .provider-banner-card {
        background: linear-gradient(135deg, var(--theme-primary, #0f172a) 0%, var(--theme-secondary, #334155) 100%);
        border-radius: 20px;
        padding: 40px; /* Increased padding */
        color: white;
        display: flex;
        justify-content: space-between;
        align-items: center;
        cursor: pointer;
        position: relative;
        overflow: hidden;
        box-shadow: 0 20px 40px -10px rgba(0,0,0,0.3); /* Stronger shadow */
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        margin-top: 40px;
        margin-bottom: 20px;
        border: 1px solid rgba(255,255,255,0.1);
    }

    .provider-banner-card:hover {
        transform: translateY(-5px) scale(1.01);
        box-shadow: 0 30px 60px -12px rgba(0,0,0,0.35);
    }

    .banner-content {
        z-index: 2;
        max-width: 65%;
    }

    .status-badge {
        background: rgba(255, 255, 255, 0.2);
        backdrop-filter: blur(10px);
        padding: 4px 12px;
        border-radius: 50px;
        font-size: 0.75rem;
        font-weight: 700;
        display: inline-block;
        margin-bottom: 12px;
        border: 1px solid rgba(255, 255, 255, 0.3);
    }

    .banner-content h3 {
        font-weight: 800;
        margin-bottom: 8px;
    }

    .banner-content p {
        font-size: 0.9rem;
        opacity: 0.9;
        margin-bottom: 20px;
    }

    .btn-banner {
        background: white;
        color: var(--theme-primary);
        border: none;
        padding: 8px 20px;
        border-radius: 12px;
        font-weight: 700;
        font-size: 0.9rem;
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    }

    .banner-icon {
        font-size: 5rem;
        opacity: 0.15;
        position: absolute;
        left: -10px;
        bottom: -20px;
        transform: rotate(-15deg);
    }

    .skeleton {
        background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
        background-size: 200% 100%;
        animation: loading 1.5s infinite;
    }

    @@keyframes loading {
        0% { background-position: 200% 0; }
        100% { background-position: -200% 0; }
    }

    .market-section-card {
        background: #fff;
        border: 1px solid rgba(0,0,0,0.05);
    }
    .market-bg-glow {
        position: absolute;
        width: 150px;
        height: 150px;
        background: radial-gradient(circle, rgba(59, 130, 246, 0.15) 0%, transparent 70%);
        top: -50px;
        right: -30px;
        z-index: 0;
    }
    .market-item-mini {
        min-width: 140px;
        background: white;
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid #f1f5f9;
        cursor: pointer;
        transition: transform 0.2s;
    }
    .market-item-mini:hover { transform: scale(1.05); }
    .mini-img-wrapper {
        aspect-ratio: 1/1;
        position: relative;
        overflow: hidden;
    }
    .mini-img-wrapper img { width: 100%; height: 100%; object-fit: cover; }
    .mini-price {
        position: absolute;
        bottom: 5px;
        left: 5px;
        background: rgba(15, 23, 42, 0.8);
        color: white;
        font-size: 0.65rem;
        padding: 2px 6px;
        border-radius: 8px;
    }
    .extra-small { font-size: 0.7rem; }
    .scroll-hide::-webkit-scrollbar { display: none; }
    .scroll-hide { scrollbar-width: none; }

    /* App Promo Inline Design */
    .premium-glass-card {
        background: rgba(15, 23, 42, 0.85);
        backdrop-filter: blur(25px);
        -webkit-backdrop-filter: blur(25px);
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 30px;
        color: white;
        box-shadow: 0 30px 60px rgba(0, 0, 0, 0.4);
    }

    .widget-aurora-glow-inline {
        position: absolute;
        width: 300px;
        height: 300px;
        border-radius: 50%;
        filter: blur(60px);
        opacity: 0.5;
        z-index: 0;
        pointer-events: none;
    }

    .widget-aurora-glow-inline.glow-1 {
        top: -100px;
        left: -100px;
        background: var(--theme-primary, #6366f1);
        animation: orbPulse 6s infinite alternate;
    }

    .widget-aurora-glow-inline.glow-2 {
        bottom: -100px;
        right: -100px;
        background: var(--theme-secondary, #a855f7);
        animation: orbPulse 8s infinite alternate-reverse;
    }

    .logo-orb {
        width: 70px;
        height: 70px;
        background: linear-gradient(135deg, var(--theme-primary, #6366f1), var(--theme-secondary, #a855f7));
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto;
        box-shadow: 0 10px 20px rgba(99, 102, 241, 0.4);
        animation: orbPulse 4s infinite ease-in-out;
    }

    .premium-text-glow {
        text-shadow: 0 0 10px rgba(99, 102, 241, 0.5);
    }

    .store-link-card {
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        border: 1px solid rgba(255,255,255,0.08);
        background: rgba(255, 255, 255, 0.03);
    }

    .store-link-card:not(.opacity-50):hover {
        transform: scale(1.03) translateX(-5px);
        border-color: rgba(255,255,255,0.3);
    }

    .play-store-glow { background: rgba(60, 186, 84, 0.1); }
    .play-store-glow:hover { background: rgba(60, 186, 84, 0.2); }
    
    .app-store-glow { background: rgba(255, 255, 255, 0.05); }
    
    .share-app-glow { background: rgba(99, 102, 241, 0.1); cursor: pointer; }
    .share-app-glow:hover { background: rgba(99, 102, 241, 0.2); }

    .qr-code-glow { background: rgba(168, 85, 247, 0.1); }

    .qr-frame-large {
        width: 180px;
        height: 180px;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255,255,255,0.03);
        border-radius: 20px;
    }

    .qr-corner-lg {
        position: absolute;
        width: 25px;
        height: 25px;
        border: 3px solid var(--theme-primary, #6366f1);
    }
    
    .top-left { top: 0; left: 0; border-right: none; border-bottom: none; border-radius: 8px 0 0 0; }
    .top-right { top: 0; right: 0; border-left: none; border-bottom: none; border-radius: 0 8px 0 0; }
    .bottom-left { bottom: 0; left: 0; border-right: none; border-top: none; border-radius: 0 0 0 8px; }
    .bottom-right { bottom: 0; right: 0; border-left: none; border-top: none; border-radius: 0 0 8px 0; }

    .qr-scanner-line-large {
        position: absolute;
        top: 0;
        left: 5%;
        width: 90%;
        height: 3px;
        background: linear-gradient(90deg, transparent, var(--theme-primary, #6366f1), transparent);
        box-shadow: 0 0 15px var(--theme-primary, #6366f1);
        animation: scannerMove 3s infinite ease-in-out;
        z-index: 5;
    }

    @@keyframes orbPulse {
        0%, 100% { transform: scale(1); filter: brightness(1); }
        50% { transform: scale(1.05); filter: brightness(1.2); }
    }

    @@keyframes scannerMove {
        0%, 100% { top: 5%; }
        50% { top: 92%; }
    }
    .marketplace-announcement-banner {
        background: linear-gradient(135deg, #1e293b 0%, #334155 100%);
        cursor: pointer;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        border: 1px solid rgba(255, 255, 255, 0.1);
        min-height: 200px;
    }

    .marketplace-announcement-banner:hover {
        transform: translateY(-8px) scale(1.02);
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5) !important;
    }

    .announcement-glass-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: radial-gradient(circle at top right, rgba(59, 130, 246, 0.3), transparent 70%);
        z-index: 0;
    }

    .announcement-icon-wrapper {
        position: relative;
        display: inline-block;
    }

    .floating-price-tag {
        position: absolute;
        top: -10px;
        right: -10px;
        background: var(--theme-primary);
        color: white;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        box-shadow: 0 4px 15px var(--theme-glow);
        animation: float 3s ease-in-out infinite;
    }

    .animate-pulse {
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {
        0% { transform: scale(1); opacity: 1; }
        50% { transform: scale(1.1); opacity: 0.8; }
        100% { transform: scale(1); opacity: 1; }
    }

    @@keyframes float {
        0% { transform: translateY(0); }
        50% { transform: translateY(-10px); }
        100% { transform: translateY(0); }
    }
</style>

@code {
    private List<ServiceDto>? featuredServices;
    private List<ServiceDto>? nearbyServices;
    private List<MainCategoryDto>? mainCategories;
    private List<MarketplaceItemDto>? latestMarketItems;
    private bool isMauiApp = false;
    private CancellationTokenSource _cts = new();
    private bool _disposed = false;

    protected override void OnInitialized()
    {
        AppState.OnChange += OnAppStateChange;

        isMauiApp = AppState.IsMobileApp;
        
        Console.WriteLine($"ANTIGRAVITY_LOG: Home Page Initialized. IsMobileApp={isMauiApp}");
        if (mainCategories == null) Console.WriteLine("ANTIGRAVITY_LOG: mainCategories is null on init");
        _ = LoadDataAsync(_cts.Token);
    }

    private async void OnAppStateChange()
    {
        if (_disposed) return;
        try { await InvokeAsync(StateHasChanged); }
        catch (ObjectDisposedException) { }
        catch (InvalidOperationException) { }
    }

    public void Dispose()
    {
        _disposed = true;
        AppState.OnChange -= OnAppStateChange;
        _cts.Cancel();
        _cts.Dispose();
    }

    private async Task LoadDataAsync(CancellationToken ct = default)
    {
        try 
        {
            // 1. Instant Load from Cache (Offline-First) - Parallelized
            var cacheServicesTask = OfflineData.GetServicesAsync();
            var cacheCatsTask = OfflineData.GetMainCategoriesAsync();
            
            await Task.WhenAll(cacheServicesTask, cacheCatsTask);
            
            var cachedServices = cacheServicesTask.Result;
            var cachedCats = cacheCatsTask.Result;
            
            if (cachedServices != null && cachedServices.Any())
            {
                featuredServices = cachedServices.Take(6).ToList();
                nearbyServices = cachedServices.Skip(1).Take(4).ToList();
            }
            if (cachedCats != null && cachedCats.Any())
            {
                mainCategories = cachedCats;
            }
            
            // Show cached data immediately if we have it
            if (featuredServices != null || mainCategories != null)
            {
                await InvokeAsync(StateHasChanged);
            }

            if (ct.IsCancellationRequested) return;

            // 2. Parallel loading of fresh data from API
            var servicesTask = Api.GetServicesAsync();
            var categoriesTask = Api.GetMainCategoriesAsync();
            var marketTask = Api.GetLatestMarketplaceItemsAsync(6);

            await Task.WhenAll(servicesTask, categoriesTask, marketTask);

            if (ct.IsCancellationRequested) return;

            var servicesResult = servicesTask.Result;
            latestMarketItems = marketTask.Result;
            mainCategories = categoriesTask.Result ?? mainCategories;
            
            if (servicesResult?.Items != null && servicesResult.Items.Any())
            {
                featuredServices = servicesResult.Items.Take(6).ToList();
                nearbyServices = servicesResult.Items.Skip(1).Take(4).ToList();
                
                // Update Cache for next launch (Offline-First)
                await OfflineData.SaveServicesAsync(servicesResult.Items);
            }
            
            if (mainCategories != null)
            {
                await OfflineData.SaveMainCategoriesAsync(mainCategories);
            }

            if (featuredServices == null)
            {
                featuredServices = new List<ServiceDto>();
                nearbyServices = new List<ServiceDto>();
            }
        }
        catch (OperationCanceledException)
        {
            // Navigation happened before data loaded — safe to ignore
        }
        catch (Exception ex)
        {
            Console.WriteLine($"API Error: {ex.Message}");
            featuredServices ??= new List<ServiceDto>();
            nearbyServices ??= new List<ServiceDto>();
            mainCategories ??= new List<MainCategoryDto>();
        }
        finally
        {
            if (!ct.IsCancellationRequested && !_disposed)
            {
                try { await InvokeAsync(StateHasChanged); }
                catch (ObjectDisposedException) { }
                catch (InvalidOperationException) { }
            }
        }
    }

    private void OnServiceSelected(ServiceDto service) => Navigation.NavigateTo($"/service/{service.Id}");

    private void OnCategorySelected(MainCategoryDto cat) => Navigation.NavigateTo($"/explore/main/{cat.Id}/{Uri.EscapeDataString(cat.Name)}");

    private void GoToRegisterProvider()
    {
        if (AppState.IsAuthenticated)
            Navigation.NavigateTo("/provider/apply");
        else
            Navigation.NavigateTo("/register");
    }

    private async Task ShareApp()
    {
        var shareUrl = Navigation.BaseUri;
        var shareTitle = "تطبيق خدمات موبايل";
        var shareText = "حمل أفضل تطبيق للخدمات في مصر! كل ما تحتاجه في تطبيق واحد 🚀";
        await JS.InvokeVoidAsync("shareApp", shareTitle, shareText, shareUrl);
    }
}
