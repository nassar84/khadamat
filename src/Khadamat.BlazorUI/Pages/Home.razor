@page "/"
@using Khadamat.Application.DTOs
@using Khadamat.BlazorUI.Services
@using Khadamat.BlazorUI.Components.ServiceRelated
@inject ApiClient Api
@inject NavigationManager Navigation
@inject Khadamat.BlazorUI.State.AppState AppState
@inject Khadamat.Application.Interfaces.IOfflineDataService OfflineData

<div class="px-3">
    <!-- Ads Slider (Dynamic System) -->
    <Khadamat.BlazorUI.Components.Ads.AdsSlider />

    <!-- Category Marquee (The Scroller) -->
    <CategoryMarquee />

    <!-- Featured Services (Horizontal Scroll) -->
    <div class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0">⭐ خدمات مميزة</h5>
            <a href="services" class="text-primary text-decoration-none fw-bold small">عرض الكل</a>
        </div>
        
        <div class="featured-scroll-container">
            @if (featuredServices != null)
            {
                @if (!featuredServices.Any())
                {
                    <div class="text-center p-4 opacity-50 bg-light rounded-4 w-100">
                        <i class="fa-solid fa-cloud-moon fs-1 mb-2"></i>
                        <p>لا توجد خدمات متاحة حالياً</p>
                    </div>
                }
                else
                {
                    <div class="d-flex gap-3 overflow-auto pb-2" style="scrollbar-width: none; -ms-overflow-style: none;">
                        @foreach (var service in featuredServices)
                        {
                            <div style="min-width: 280px;">
                                <ServiceCard Service="service" OnClick="OnServiceSelected" />
                            </div>
                        }
                    </div>
                }
            }
            else
            {
                <div class="d-flex gap-3 overflow-hidden">
                    @for (int i = 0; i < 3; i++)
                    {
                        <div class="skeleton rounded-4" style="min-width: 280px; height: 180px;"></div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Marketplace Announcement (Premium Ad Style) -->
    <div class="mb-5">
        <div class="marketplace-announcement-banner p-4 rounded-5 position-relative overflow-hidden mb-4 shadow-lg" @onclick='() => Navigation.NavigateTo("/marketplace")'>
            <div class="announcement-glass-overlay"></div>
            <div class="row align-items-center position-relative z-1">
                <div class="col-8">
                    <span class="badge bg-danger rounded-pill mb-2 px-3 animate-pulse">جديد 🔥</span>
                    <h3 class="fw-bold text-white mb-1">متجر خدمات (Marketplace)</h3>
                    <p class="text-white-50 mb-3">بيع، اشترِ، وتصفح أفضل العروض في منطقتك بكل سهولة وأمان.</p>
                    <button class="btn btn-outline-light rounded-pill px-4 fw-bold">تصفح المتجر الآن <i class="fa-solid fa-arrow-left ms-2"></i></button>
                </div>
                <div class="col-4 text-center">
                    <div class="announcement-icon-wrapper">
                        <span class="store-icon-wrap">
                            <i class="fa-solid fa-store fa-5x text-white opacity-50 store-anim"></i>
                        </span>
                        <div class="floating-price-tag">
                            <i class="fa-solid fa-tag"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (latestMarketItems != null && latestMarketItems.Any())
        {
            <div class="d-flex gap-3 overflow-auto pb-2 scroll-hide">
                @foreach (var item in latestMarketItems)
                {
                    <div class="market-item-mini" @onclick='() => Navigation.NavigateTo($"/marketplace/item/{item.Id}")'>
                        <div class="mini-img-wrapper">
                            <img src="@(item.Images.FirstOrDefault()?.ImageUrl ?? "images/defaults/default-product.png")" />
                            <span class="mini-price">@item.Price.ToString("N0") ج.م</span>
                        </div>
                        <div class="p-2">
                             <div class="text-truncate small fw-bold">@item.Title</div>
                             <div class="text-muted extra-small"><i class="fa-solid fa-location-dot me-1"></i> @item.CityName</div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Nearby Services Section -->
    <div class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0">📍 قريبة منك</h5>
            <a href="services" class="text-primary text-decoration-none fw-bold small">عرض الكل</a>
        </div>

        <div class="nearby-list">
            @if (nearbyServices != null)
            {
                @foreach (var service in nearbyServices)
                {
                    <NearbyServiceCard Service="service" OnClick="OnServiceSelected" />
                }
            }
            else
            {
                @for (int i = 0; i < 3; i++)
                {
                    <div class="skeleton rounded-4 mb-3" style="height: 90px;"></div>
                }
            }
        </div>
    </div>

    <!-- Join as Provider Banner -->
    <div class="provider-banner-card mb-5" @onclick="GoToRegisterProvider">
        <div class="banner-content">
            <div class="status-badge">فرصة عمل</div>
            <h3>كن مقدم خدمة</h3>
            <p>سجل مهاراتك ووصّل خدماتك لآلاف العملاء في منطقتك</p>
            <button class="btn-banner">سجل الآن مجاناً <i class="fa-solid fa-arrow-left ms-2"></i></button>
        </div>
        <div class="banner-icon">
            <i class="fa-solid fa-briefcase"></i>
        </div>
    </div>
</div>

<style>
    .featured-scroll-container::-webkit-scrollbar {
        display: none;
    }

    .provider-banner-card {
        background: linear-gradient(135deg, var(--theme-primary, #0f172a) 0%, var(--theme-secondary, #334155) 100%);
        border-radius: 20px;
        padding: 40px; /* Increased padding */
        color: white;
        display: flex;
        justify-content: space-between;
        align-items: center;
        cursor: pointer;
        position: relative;
        overflow: hidden;
        box-shadow: 0 20px 40px -10px rgba(0,0,0,0.3); /* Stronger shadow */
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        margin-top: 40px;
        margin-bottom: 20px;
        border: 1px solid rgba(255,255,255,0.1);
    }

    .provider-banner-card:hover {
        transform: translateY(-5px) scale(1.01);
        box-shadow: 0 30px 60px -12px rgba(0,0,0,0.35);
    }

    .banner-content {
        z-index: 2;
        max-width: 65%;
    }

    .status-badge {
        background: rgba(255, 255, 255, 0.2);
        backdrop-filter: blur(10px);
        padding: 4px 12px;
        border-radius: 50px;
        font-size: 0.75rem;
        font-weight: 700;
        display: inline-block;
        margin-bottom: 12px;
        border: 1px solid rgba(255, 255, 255, 0.3);
    }

    .banner-content h3 {
        font-weight: 800;
        margin-bottom: 8px;
    }

    .banner-content p {
        font-size: 0.9rem;
        opacity: 0.9;
        margin-bottom: 20px;
    }

    .btn-banner {
        background: white;
        color: var(--theme-primary);
        border: none;
        padding: 8px 20px;
        border-radius: 12px;
        font-weight: 700;
        font-size: 0.9rem;
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    }

    .banner-icon {
        font-size: 5rem;
        opacity: 0.15;
        position: absolute;
        left: -10px;
        bottom: -20px;
        transform: rotate(-15deg);
    }

    .skeleton {
        background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
        background-size: 200% 100%;
        animation: loading 1.5s infinite;
    }

    @@keyframes loading {
        0% { background-position: 200% 0; }
        100% { background-position: -200% 0; }
    }

    .market-section-card {
        background: #fff;
        border: 1px solid rgba(0,0,0,0.05);
    }
    .market-bg-glow {
        position: absolute;
        width: 150px;
        height: 150px;
        background: radial-gradient(circle, rgba(59, 130, 246, 0.15) 0%, transparent 70%);
        top: -50px;
        right: -30px;
        z-index: 0;
    }
    .market-item-mini {
        min-width: 140px;
        background: white;
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid #f1f5f9;
        cursor: pointer;
        transition: transform 0.2s;
    }
    .market-item-mini:hover { transform: scale(1.05); }
    .mini-img-wrapper {
        aspect-ratio: 1/1;
        position: relative;
        overflow: hidden;
    }
    .mini-img-wrapper img { width: 100%; height: 100%; object-fit: cover; }
    .mini-price {
        position: absolute;
        bottom: 5px;
        left: 5px;
        background: rgba(15, 23, 42, 0.8);
        color: white;
        font-size: 0.65rem;
        padding: 2px 6px;
        border-radius: 8px;
    }
    .extra-small { font-size: 0.7rem; }
    .scroll-hide::-webkit-scrollbar { display: none; }
    .scroll-hide { scrollbar-width: none; }

    /* Premium Marketplace Announcement */
    .marketplace-announcement-banner {
        background: linear-gradient(135deg, #1e293b 0%, #334155 100%);
        cursor: pointer;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        border: 1px solid rgba(255, 255, 255, 0.1);
        min-height: 200px;
    }

    .marketplace-announcement-banner:hover {
        transform: translateY(-8px) scale(1.02);
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5) !important;
    }

    .announcement-glass-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: radial-gradient(circle at top right, rgba(59, 130, 246, 0.3), transparent 70%);
        z-index: 0;
    }

    .announcement-icon-wrapper {
        position: relative;
        display: inline-block;
    }

    .floating-price-tag {
        position: absolute;
        top: -10px;
        right: -10px;
        background: var(--theme-primary);
        color: white;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        box-shadow: 0 4px 15px var(--theme-glow);
        animation: float 3s ease-in-out infinite;
    }

    .animate-pulse {
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {
        0% { transform: scale(1); opacity: 1; }
        50% { transform: scale(1.1); opacity: 0.8; }
        100% { transform: scale(1); opacity: 1; }
    }

    @@keyframes float {
        0% { transform: translateY(0); }
        50% { transform: translateY(-10px); }
        100% { transform: translateY(0); }
    }
</style>

@code {
    private List<ServiceDto>? featuredServices;
    private List<ServiceDto>? nearbyServices;
    private List<MainCategoryDto>? mainCategories;
    private List<MarketplaceItemDto>? latestMarketItems;

    protected override void OnInitialized()
    {
        Console.WriteLine("ANTIGRAVITY_LOG: Home Page Initialized. Starting background data load...");
        _ = LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        try 
        {
            // Parallel loading for maximum speed
            var servicesTask = Api.GetServicesAsync();
            var categoriesTask = Api.GetMainCategoriesAsync();
            var marketTask = Api.GetLatestMarketplaceItemsAsync(6);

            await Task.WhenAll(servicesTask, categoriesTask, marketTask);

            var servicesResult = servicesTask.Result;
            latestMarketItems = marketTask.Result;
            
            if (servicesResult?.Items != null && servicesResult.Items.Any())
            {
                featuredServices = servicesResult.Items.Take(6).ToList();
                nearbyServices = servicesResult.Items.Skip(1).Take(4).ToList();
                
                // Save to offline storage
                _ = OfflineData.SaveServicesAsync(servicesResult.Items);
            }
            else
            {
                // FALLBACK: Generate Mock Data if API is empty
                GenerateMockServices();
            }
            
            mainCategories = (await categoriesTask) ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"API Error: {ex.Message}. Using Mock Data...");
            GenerateMockServices();
            mainCategories = new List<MainCategoryDto>();
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

