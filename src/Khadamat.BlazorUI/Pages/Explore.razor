@page "/explore"
@page "/explore/{Level}/{Id:int}/{Name}"
@using Khadamat.Application.DTOs
@using Khadamat.BlazorUI.Services
@using Khadamat.BlazorUI.Helpers
@using static Khadamat.BlazorUI.Components.Category.BreadcrumbNav

@inject ApiClient Api
@inject NavigationManager Navigation

<div>

    <div class="explore-content-inner px-3">
        <!-- Ads Slider (Dynamic System) -->
        <Khadamat.BlazorUI.Components.Ads.AdsSlider />
        <!-- Error Message -->
        @if (errorMessage != null)
        {
            <div class="alert alert-warning rounded-4 mb-3">
                <i class="fa-solid fa-triangle-exclamation me-2"></i>
                @errorMessage
            </div>
        }

        <!-- Breadcrumbs -->
        <BreadcrumbNav Items="breadcrumbItems" OnItemClick="HandleBreadcrumbClick" />

        <div class="mb-4">
            <h3 class="fw-bold mb-4 gradient-text">
                @if (Level == "main" || Level == "main_all") { <span>التصنيفات في @(string.IsNullOrEmpty(Name) ? "كل الفئات" : Name)</span> }
                else if (Level == "category") { <span>الأنواع في @Name</span> }
                else { <span>الخدمات في @Name</span> }
            </h3>

            @if (Level == "main" || Level == "main_all")
            {
                <div class="row g-3 row-cols-2 row-cols-md-3 row-cols-lg-4">
                    @if (categories != null)
                    {
                        @if (categories.Any())
                        {
                            @foreach (var cat in categories)
                            {
                                <div class="col">
                                    <div class="category-card p-3 rounded-4 shadow-sm border text-center h-100 animate-up" @onclick="() => ExploreCategory(cat)">
                                        <div class="mb-3 mx-auto">
                                            @{
                                                var catImgSrc = (Level == "main_all" || string.IsNullOrEmpty(Level))
                                                    ? Api.GetAbsoluteUrl(CategoryIconResolver.GetIconUrl(cat.Name, cat.ImageUrl, "images/maincategories"))
                                                    : Api.GetAbsoluteUrl(CategoryIconResolver.GetIconUrl(cat.Name, cat.ImageUrl, "images/categories", cat.MainCategoryName, cat.MainCategoryImageUrl, "images/maincategories"));
                                            }
                                            <img src="@catImgSrc"
                                                 onerror="this.onerror=null;this.src='/images/categories/other_services.png';"
                                                 class="rounded-3 shadow-sm object-fit-cover" width="80" height="60" loading="lazy" />
                                        </div>
                                        <div class="fw-bold">@cat.Name</div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="col-12 text-center py-5">
                                <i class="fa-solid fa-folder-open fs-1 text-muted mb-3 opacity-50"></i>
                                <p class="text-muted fw-bold">لا توجد تصنيفات تحت هذا القسم حالياً</p>
                            </div>
                        }
                    }
                    else 
                    { 
                        @for (int i = 0; i < 8; i++)
                        {
                            <div class="col">
                                <Khadamat.BlazorUI.Shared.SkeletonLoader Type="card" Count="1" />
                            </div>
                        }
                    }
                </div>
            }
            else if (Level == "category")
            {
                @if (subCategories != null)
                {
                    @if (subCategories.Any())
                    {
                        <div class="row g-3 row-cols-2 row-cols-md-3 row-cols-lg-4 mb-4">
                            @foreach (var sub in subCategories)
                            {
                                <div class="col">
                                    <div class="category-card p-3 rounded-4 shadow-sm border text-center h-100 animate-up" @onclick="() => ExploreSubCategory(sub)">
                                        <div class="mb-3 mx-auto">
                                            <img src="@Api.GetAbsoluteUrl(CategoryIconResolver.GetIconUrl(sub.Name, sub.ImageUrl, "images/subcategories", sub.CategoryName, sub.CategoryImageUrl, "images/categories", sub.MainCategoryImageUrl, "images/maincategories"))" 
                                                 onerror="this.onerror=null;this.src='/images/categories/other_services.png';"
                                                 class="rounded-3 shadow-sm object-fit-cover" width="80" height="60" loading="lazy" />
                                        </div>
                                        <div class="fw-bold">@sub.Name</div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }
                else 
                { 
                    <div class="row g-3 row-cols-2 row-cols-md-3 row-cols-lg-4 mb-4">
                        @for (int i = 0; i < 8; i++)
                        {
                            <div class="col">
                                <Khadamat.BlazorUI.Shared.SkeletonLoader Type="card" Count="1" />
                            </div>
                        }
                    </div>
                }

                @* عرض الخدمات المباشرة في هذا التصنيف *@
                @if (services != null && services.Any())
                {
                    <div class="mt-4">
                        <h6 class="fw-bold text-muted mb-3 border-bottom pb-2">
                            <i class="fa-solid fa-briefcase me-2 text-primary"></i>خدمات متوفرة
                        </h6>
                        <div class="row g-3">
                            @for (int i = 0; i < services.Count; i++)
                            {
                                var service = services[i];
                                <div class="col-12 col-md-6 col-lg-4">
                                    <ServiceCard Service="service" OnClick='(s) => Navigation.NavigateTo($"/service/{s.Id}")' />
                                </div>
                                @if ((i + 1) % 3 == 0 && categoryAds != null && categoryAds.Any())
                                {
                                    var adIndex = ((i + 1) / 3 - 1) % categoryAds.Count;
                                    var ad = categoryAds[adIndex];
                                    <div class="col-12 col-md-6 col-lg-4">
                                        <NativeAdCard Ad="ad" />
                                    </div>
                                }
                            }
                        </div>
                    </div>
                }
                else if (subCategories != null && !subCategories.Any() && services != null && !services.Any())
                {
                    <div class="text-center py-5">
                        <i class="fa-solid fa-layer-group fs-1 text-muted mb-3 opacity-50"></i>
                        <p class="text-muted fw-bold">لا توجد خدمات مسجلة في هذا التصنيف حالياً</p>
                    </div>
                }
            }
            else if (Level == "subcategory")
            {
                @if (services != null)
                {
                    var displayedServices = string.IsNullOrEmpty(selectedSpecialization) 
                        ? services 
                        : services.Where(s => s.Specialization != null && s.Specialization.Contains(selectedSpecialization, StringComparison.OrdinalIgnoreCase)).ToList();

                    @if (availableSpecializations.Any())
                    {
                        <!-- Professional Specialization Filter Bar -->
                        <div class="pro-filter-container p-3 p-md-4 mb-4 animate-fade-in">
                            <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="filter-header-icon shadow-sm">
                                        <i class="fa-solid fa-graduation-cap"></i>
                                    </div>
                                    <div>
                                        <h6 class="fw-bold mb-0 text-dark" style="font-size: 1.05rem;">
                                            تصفية حسب التخصص / المادة الدراسية
                                        </h6>
                                        <small class="text-muted">اختر المادة لتصفية مقدمي الخدمات بسرعة</small>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    @if (!string.IsNullOrEmpty(selectedSpecialization))
                                    {
                                        <button class="btn btn-sm btn-outline-danger rounded-pill px-3 py-1 fw-bold" @onclick='() => FilterBySpecialization(null)'>
                                            <i class="fa-solid fa-xmark me-1"></i>إلغاء التصفية
                                        </button>
                                    }
                                    <span class="badge bg-light text-muted border rounded-pill px-3 py-2 fw-semibold">
                                        إجمالي: @services.Count خدمة
                                    </span>
                                </div>
                            </div>

                            <!-- Specialization Chips -->
                            <div class="d-flex gap-2 overflow-auto py-1 pro-chips-scroll">
                                <button type="button" 
                                        class="pro-filter-chip @(string.IsNullOrEmpty(selectedSpecialization) ? "active" : "")" 
                                        @onclick='() => FilterBySpecialization(null)'>
                                    <i class="fa-solid fa-layer-group me-1.5 opacity-75"></i>
                                    <span>كل المواد</span>
                                    <span class="chip-count ms-2">@services.Count</span>
                                </button>
                                @foreach (var spec in availableSpecializations)
                                {
                                    var count = services.Count(s => s.Specialization != null && s.Specialization.Contains(spec, StringComparison.OrdinalIgnoreCase));
                                    var isActive = selectedSpecialization == spec;
                                    var chipIcon = GetSpecializationIcon(spec);
                                    <button type="button" 
                                            class="pro-filter-chip @(isActive ? "active" : "")" 
                                            @onclick='() => FilterBySpecialization(spec)'>
                                        <i class="@chipIcon me-1.5 opacity-75"></i>
                                        <span>@spec</span>
                                        <span class="chip-count ms-2">@count</span>
                                    </button>
                                }
                            </div>
                        </div>
                    }

                    @if (displayedServices.Any())
                    {
                        var groupedServices = displayedServices
                            .GroupBy(s => string.IsNullOrWhiteSpace(s.Specialization) ? "خدمات متنوعة" : s.Specialization.Trim())
                            .OrderBy(g => g.Key == "خدمات متنوعة" ? 1 : 0)
                            .ToList();

                        for (int gIdx = 0; gIdx < groupedServices.Count; gIdx++)
                        {
                            var group = groupedServices[gIdx];
                            var theme = GetThemeForSpecialization(group.Key, gIdx);
                            var specIcon = GetSpecializationIcon(group.Key);
                            var groupList = group.ToList();

                            <div class="specialization-row-container rounded-4 p-3 p-md-4 mb-4 shadow-sm animate-up"
                                 style="background: @theme.BgGradient; border: 1.5px solid @theme.BorderColor;">
                                
                                <!-- Specialization Row Header -->
                                <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom flex-wrap gap-2"
                                     style="border-color: @theme.BorderColor !important;">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="spec-icon-box shadow-sm" style="background: @theme.AccentColor; color: white;">
                                            <i class="@specIcon"></i>
                                        </div>
                                        <div>
                                            <h5 class="fw-bold mb-0 text-dark" style="font-size: 1.15rem;">
                                                @group.Key
                                            </h5>
                                            <span class="text-muted small">مدرسون وخدمات متوفرة في @group.Key</span>
                                        </div>
                                    </div>

                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge @theme.BadgeClass rounded-pill px-3 py-2 fw-bold" style="font-size: 0.82rem;">
                                            <i class="fa-solid fa-user-tie me-1"></i>
                                            @groupList.Count @(groupList.Count == 1 ? "خدمة متاحة" : "خدمات متاحة")
                                        </span>
                                    </div>
                                </div>

                                <!-- Cards Grid for this Specialization -->
                                <div class="row g-3">
                                    @for (int sIdx = 0; sIdx < groupList.Count; sIdx++)
                                    {
                                        var service = groupList[sIdx];
                                        <div class="col-12 col-md-6 col-lg-4">
                                            <ServiceCard Service="service" OnClick='(s) => Navigation.NavigateTo($"/service/{s.Id}")' />
                                        </div>
                                    }
                                </div>
                            </div>

                            @* فاصلة خفيفة بين التخصصات *@
                            @if (gIdx < groupedServices.Count - 1)
                            {
                                <div class="spec-divider-wrap my-4 d-flex align-items-center justify-content-center">
                                    <div class="spec-divider-line flex-grow-1"></div>
                                    <div class="spec-divider-icon px-3 text-muted">
                                        <i class="fa-solid fa-graduation-cap opacity-25"></i>
                                    </div>
                                    <div class="spec-divider-line flex-grow-1"></div>
                                </div>
                            }
                        }

                        @if (categoryAds != null && categoryAds.Any())
                        {
                            <div class="mt-4">
                                <NativeAdCard Ad="categoryAds[0]" />
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-5 bg-white rounded-4 shadow-sm border p-4">
                            <div class="mb-3">
                                <i class="fa-solid fa-magnifying-glass fs-1 text-primary opacity-50"></i>
                            </div>
                            <h6 class="fw-bold text-dark mb-2">
                                @(string.IsNullOrEmpty(selectedSpecialization) ? "لا توجد خدمات متاحة حالياً في هذا القسم" : $"لا توجد خدمات متاحة لمادة '{selectedSpecialization}' حالياً")
                            </h6>
                            @if (!string.IsNullOrEmpty(selectedSpecialization))
                            {
                                <button class="btn btn-outline-primary rounded-pill px-4 py-2 mt-2" @onclick='() => FilterBySpecialization(null)'>
                                    <i class="fa-solid fa-arrow-rotate-right me-1"></i>عرض كل المواد
                                </button>
                            }
                        </div>
                    }
                }
                else 
                { 
                    <div class="row g-3">
                        @for (int i = 0; i < 6; i++)
                        {
                            <div class="col-12 col-md-6 col-lg-4">
                                <Khadamat.BlazorUI.Shared.SkeletonLoader Type="card" Count="1" />
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </div>
</div>

<style>
    .icon-box-small {
        width: 45px;
        height: 45px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(99, 102, 241, 0.05);
        border-radius: 12px;
    }
    .category-card {
        cursor: pointer;
        transition: all 0.3s ease;
        background: white;
    }
    .category-card:hover {
        border-color: var(--primary) !important;
        background: rgba(99, 102, 241, 0.02);
        transform: translateY(-3px);
    }

    /* Professional Filter Styles */
    .pro-filter-container {
        background: #ffffff;
        border-radius: 1.25rem;
        box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.04);
        border: 1px solid rgba(226, 232, 240, 0.9);
    }
    .filter-header-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.15rem;
    }
    .pro-chips-scroll {
        scrollbar-width: thin;
        scrollbar-color: #cbd5e1 transparent;
    }
    .pro-chips-scroll::-webkit-scrollbar {
        height: 5px;
    }
    .pro-chips-scroll::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 10px;
    }
    .pro-filter-chip {
        display: inline-flex;
        align-items: center;
        padding: 0.5rem 1.15rem;
        border-radius: 9999px;
        background: #f8fafc;
        border: 1.5px solid #e2e8f0;
        color: #475569;
        font-weight: 600;
        font-size: 0.86rem;
        white-space: nowrap;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        cursor: pointer;
    }
    .pro-filter-chip:hover {
        background: #f1f5f9;
        color: #1e293b;
        border-color: #cbd5e1;
        transform: translateY(-2px);
    }
    .pro-filter-chip.active {
        background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%) !important;
        color: #ffffff !important;
        border-color: transparent !important;
        box-shadow: 0 4px 14px rgba(79, 70, 229, 0.35) !important;
