    /* Subtle Divider between specialization rows */
    .spec-divider-wrap {
        position: relative;
    }
    .spec-divider-line {
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(148, 163, 184, 0.45), transparent);
    }
    .spec-divider-icon {
        background: transparent;
        font-size: 0.95rem;
    }
</style>

@code {
    [Parameter] public string Level { get; set; } = "";
    [Parameter] public int Id { get; set; }
    [Parameter] public string Name { get; set; } = "";

    private List<CategoryDto>? categories;
    private List<SubCategoryDto>? subCategories;
    private List<ServiceDto>? services;
    private List<EnhancedAdDto>? categoryAds;
    private List<BreadcrumbItem> breadcrumbItems = new();
    private string? errorMessage;
    private string? selectedSpecialization;
    private List<string> availableSpecializations = new();

    protected override void OnParametersSet()
    {
        Console.WriteLine($"Explore.OnParametersSet: Level={Level}, Id={Id}, Name={Name}");
        // Execute fetch without awaiting to allow immediate render of Skeletons
        _ = FetchDataAsync();
    }

    private async Task FetchDataAsync()
    {
        Console.WriteLine($"Explore.FetchDataAsync started: Level={Level}, Id={Id}");
        categories = null;
        subCategories = null;
        services = null;
        errorMessage = null;
        breadcrumbItems.Clear();

        try
        {
            if (string.IsNullOrEmpty(Level))
            {
                Level = "main_all";
                breadcrumbItems.Add(new BreadcrumbItem { Label = "استكشف الفئات", IsActive = true });
                var mainCategories = await Api.GetMainCategoriesAsync();
                categories = mainCategories?.Select(mc => new CategoryDto { Id = mc.Id, Name = mc.Name, ImageUrl = mc.ImageUrl }).ToList();
            }
            else if (Level == "main")
            {
                breadcrumbItems.Add(new BreadcrumbItem { Label = Name, IsActive = true });
                Console.WriteLine($"Explore: Loading categories for MainCategoryId={Id}");
                categories = await Api.GetCategoriesByMainIdAsync(Id);
                Console.WriteLine($"Explore: Got {categories?.Count ?? 0} categories");
                if (categories != null && !categories.Any())
                {
                    errorMessage = $"لا توجد تصنيفات فرعية تحت \u201c{Name}\u201d حالياً";
                }
            }
            else if (Level == "category")
            {
                var catInfo = await Api.GetCategoryByIdAsync(Id);
                if (catInfo != null)
                {
                    breadcrumbItems.Add(new BreadcrumbItem { 
                        Label = catInfo.MainCategoryName ?? "التصنيف الرئيسي", 
                        Url = $"/explore/main/{catInfo.MainCategoryId}/{Uri.EscapeDataString(catInfo.MainCategoryName ?? "")}",
                        Data = new { Level = "main", Id = catInfo.MainCategoryId, Name = catInfo.MainCategoryName }
                    });
                    breadcrumbItems.Add(new BreadcrumbItem { Label = Name, IsActive = true });
                }
                Console.WriteLine($"Explore: Loading subcategories and services for CategoryId={Id}");
                // تحميل التصنيفات الفرعية والخدمات معاً بالتوازي
                var subCatsTask = Api.GetSubCategoriesByCategoryIdAsync(Id);
                var servicesTask = Api.GetServicesAsync(categoryId: Id);
                var categoryAdsTask = Api.GetCategoryAdsAsync(Id);
                await Task.WhenAll(subCatsTask, servicesTask, categoryAdsTask);
                subCategories = subCatsTask.Result;
                services = servicesTask.Result.Items;
                categoryAds = categoryAdsTask.Result;
                Console.WriteLine($"Explore: Got {subCategories?.Count ?? 0} subcategories, {services?.Count ?? 0} services");
            }
            else if (Level == "subcategory")
            {
                var subInfo = await Api.GetSubCategoryByIdAsync(Id);
                if (subInfo != null)
                {
                    breadcrumbItems.Add(new BreadcrumbItem { 
                        Label = subInfo.MainCategoryName ?? "التصنيف الرئيسي", 
                        Url = $"/explore/main/{subInfo.MainCategoryId}/{Uri.EscapeDataString(subInfo.MainCategoryName ?? "")}",
                        Data = new { Level = "main", Id = subInfo.MainCategoryId, Name = subInfo.MainCategoryName }
                    });
                    breadcrumbItems.Add(new BreadcrumbItem { 
                        Label = subInfo.CategoryName ?? "التصنيف", 
                        Url = $"/explore/category/{subInfo.CategoryId}/{Uri.EscapeDataString(subInfo.CategoryName ?? "")}",
                        Data = new { Level = "category", Id = subInfo.CategoryId, Name = subInfo.CategoryName }
                    });
                    breadcrumbItems.Add(new BreadcrumbItem { Label = Name, IsActive = true });
                }
                
                var servicesTask = Api.GetServicesAsync(subCategoryId: Id);
                var categoryAdsTask = Api.GetCategoryAdsAsync(Id);
                
                await Task.WhenAll(servicesTask, categoryAdsTask);
                
                services = servicesTask.Result.Items;
                categoryAds = categoryAdsTask.Result;
                UpdateAvailableSpecializations();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Explore.FetchDataAsync ERROR: {ex.Message}");
            errorMessage = $"حدث خطأ أثناء تحميل البيانات. يرجى المحاولة مرة أخرى.";
        }
        finally
        {
            StateHasChanged();
        }
    }

    private void HandleBreadcrumbClick(BreadcrumbItem item)
    {
        if (!string.IsNullOrEmpty(item.Url))
        {
            Navigation.NavigateTo(item.Url);
        }
    }

    private void ExploreCategory(CategoryDto cat)
    {
        if (Level == "main_all" || string.IsNullOrEmpty(Level))
        {
            Navigation.NavigateTo($"/explore/main/{cat.Id}/{Uri.EscapeDataString(cat.Name ?? "")}");
        }
        else
        {
            Navigation.NavigateTo($"/explore/category/{cat.Id}/{Uri.EscapeDataString(cat.Name ?? "")}");
        }
    }

    private void ExploreSubCategory(SubCategoryDto sub)
    {
        Navigation.NavigateTo($"/explore/subcategory/{sub.Id}/{Uri.EscapeDataString(sub.Name)}");
    }

    private void FilterBySpecialization(string? spec)
    {
        selectedSpecialization = spec;
        StateHasChanged();
    }

    private void UpdateAvailableSpecializations()
    {
        selectedSpecialization = null;
        if (services != null)
        {
            var specs = services
                .Where(s => !string.IsNullOrWhiteSpace(s.Specialization))
                .Select(s => s.Specialization!.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();

            if (!specs.Any() && !string.IsNullOrEmpty(Name) && 
                (Name.Contains("مدرس") || Name.Contains("تعليم") || Name.Contains("دروس") || Name.Contains("ابتدائي") || Name.Contains("اعدادي") || Name.Contains("ثانوي")))
            {
                specs = new List<string> { "لغة عربية", "رياضيات", "لغة إنجليزية", "علوم", "فيزياء", "كيمياء", "أحياء", "فرنساوي", "تاريخ", "جغرافيا" };
            }

            availableSpecializations = specs;
        }
    }

    public class SpecializationTheme
    {
        public string BgGradient { get; set; } = "";
        public string BorderColor { get; set; } = "";
        public string AccentColor { get; set; } = "";
        public string BadgeClass { get; set; } = "";
    }

    private SpecializationTheme GetThemeForSpecialization(string name, int index)
    {
        var lower = name.ToLowerInvariant();
        if (lower.Contains("عرب") || lower.Contains("شعر") || lower.Contains("لغة عربية"))
        {
            return new SpecializationTheme {
                BgGradient = "linear-gradient(135deg, rgba(79, 70, 229, 0.05) 0%, rgba(99, 102, 241, 0.02) 100%)",
                BorderColor = "rgba(99, 102, 241, 0.22)",
                AccentColor = "#4f46e5",
                BadgeClass = "bg-primary-subtle text-primary border border-primary-subtle"
            };
        }
        if (lower.Contains("علوم") || lower.Contains("كيمياء") || lower.Contains("فيزياء") || lower.Contains("أحياء") || lower.Contains("science"))
        {
            return new SpecializationTheme {
                BgGradient = "linear-gradient(135deg, rgba(16, 185, 129, 0.05) 0%, rgba(5, 150, 105, 0.02) 100%)",
                BorderColor = "rgba(16, 185, 129, 0.22)",
                AccentColor = "#059669",
                BadgeClass = "bg-success-subtle text-success border border-success-subtle"
            };
        }
        if (lower.Contains("رياض") || lower.Contains("حساب") || lower.Contains("هندسة") || lower.Contains("جبر") || lower.Contains("math"))
        {
            return new SpecializationTheme {
                BgGradient = "linear-gradient(135deg, rgba(234, 88, 12, 0.05) 0%, rgba(249, 115, 22, 0.02) 100%)",
                BorderColor = "rgba(234, 88, 12, 0.22)",
                AccentColor = "#ea580c",
                BadgeClass = "bg-warning-subtle text-warning-emphasis border border-warning-subtle"
            };
        }
        if (lower.Contains("إنجليز") || lower.Contains("انجليز") || lower.Contains("english") || lower.Contains("لغات") || lower.Contains("فرنس") || lower.Contains("ألمان"))
        {
            return new SpecializationTheme {
                BgGradient = "linear-gradient(135deg, rgba(14, 165, 233, 0.05) 0%, rgba(2, 132, 199, 0.02) 100%)",
                BorderColor = "rgba(14, 165, 233, 0.22)",
                AccentColor = "#0284c7",
                BadgeClass = "bg-info-subtle text-info-emphasis border border-info-subtle"
            };
        }
        if (lower.Contains("دراسات") || lower.Contains("تاريخ") || lower.Contains("جغراف"))
        {
            return new SpecializationTheme {
                BgGradient = "linear-gradient(135deg, rgba(225, 29, 72, 0.05) 0%, rgba(244, 63, 94, 0.02) 100%)",
                BorderColor = "rgba(225, 29, 72, 0.22)",
                AccentColor = "#e11d48",
                BadgeClass = "bg-danger-subtle text-danger border border-danger-subtle"
            };
        }

        // Distinct themes palette based on index
        var palette = new[]
        {
            new SpecializationTheme {
                BgGradient = "linear-gradient(135deg, rgba(147, 51, 234, 0.05) 0%, rgba(168, 85, 247, 0.02) 100%)",
                BorderColor = "rgba(147, 51, 234, 0.22)",
                AccentColor = "#9333ea",
                BadgeClass = "bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle"
            },
            new SpecializationTheme {
                BgGradient = "linear-gradient(135deg, rgba(13, 148, 136, 0.05) 0%, rgba(20, 184, 166, 0.02) 100%)",
                BorderColor = "rgba(13, 148, 136, 0.22)",
                AccentColor = "#0d9488",
                BadgeClass = "bg-success-subtle text-success border border-success-subtle"
            },
            new SpecializationTheme {
                BgGradient = "linear-gradient(135deg, rgba(245, 158, 11, 0.05) 0%, rgba(251, 146, 60, 0.02) 100%)",
                BorderColor = "rgba(245, 158, 11, 0.22)",
                AccentColor = "#d97706",
                BadgeClass = "bg-warning-subtle text-warning-emphasis border border-warning-subtle"
            },
            new SpecializationTheme {
                BgGradient = "linear-gradient(135deg, rgba(71, 85, 105, 0.05) 0%, rgba(100, 116, 139, 0.02) 100%)",
                BorderColor = "rgba(100, 116, 139, 0.22)",
                AccentColor = "#475569",
                BadgeClass = "bg-light text-dark border border-secondary-subtle"
            }
        };

        return palette[index % palette.Length];
    }

    private string GetSpecializationIcon(string name)
    {
        var lower = name.ToLowerInvariant();
        if (lower.Contains("عرب") || lower.Contains("لغة عربية") || lower.Contains("شعر")) return "fa-solid fa-feather-pointed";
        if (lower.Contains("علوم") || lower.Contains("كيمياء") || lower.Contains("فيزياء") || lower.Contains("أحياء") || lower.Contains("science")) return "fa-solid fa-atom";
        if (lower.Contains("رياض") || lower.Contains("حساب") || lower.Contains("هندسة") || lower.Contains("جبر") || lower.Contains("math")) return "fa-solid fa-square-root-variable";
        if (lower.Contains("إنجليز") || lower.Contains("انجليز") || lower.Contains("english") || lower.Contains("لغات") || lower.Contains("فرنس")) return "fa-solid fa-globe";
        if (lower.Contains("تاريخ") || lower.Contains("دراسات") || lower.Contains("جغراف")) return "fa-solid fa-earth-africa";
        if (lower.Contains("حاسب") || lower.Contains("تكنولوج") || lower.Contains("كمبيوتر") || lower.Contains("برمج")) return "fa-solid fa-laptop-code";
        if (lower.Contains("دين") || lower.Contains("قرآن") || lower.Contains("إسلام")) return "fa-solid fa-book-quran";
        if (lower.Contains("رسم") || lower.Contains("فنون") || lower.Contains("موسيقى")) return "fa-solid fa-palette";
        return "fa-solid fa-graduation-cap";
    }
}
