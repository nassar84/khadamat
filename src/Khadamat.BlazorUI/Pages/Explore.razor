@page "/explore"
@page "/explore/{Level}/{Id:int}/{Name}"
@using Khadamat.Application.DTOs
@using Khadamat.BlazorUI.Services
@using static Khadamat.BlazorUI.Components.Category.BreadcrumbNav
@using Khadamat.BlazorUI.Components.Ads
@inject ApiClient Api
@inject NavigationManager Navigation

<div>

    <div class="explore-content-inner px-3">
        <!-- Ads Slider (Dynamic System) -->
        <Khadamat.BlazorUI.Components.Ads.AdsSlider />

        <!-- Breadcrumbs -->
        <BreadcrumbNav Items="breadcrumbItems" OnItemClick="HandleBreadcrumbClick" />

        <div class="mb-4">
            <h3 class="fw-bold mb-4 gradient-text">
                @if (Level == "main" || Level == "main_all") { <span>التصنيفات في @(string.IsNullOrEmpty(Name) ? "كل الفئات" : Name)</span> }
                else if (Level == "category") { <span>الأنواع في @Name</span> }
                else { <span>الخدمات في @Name</span> }
            </h3>

            <div class="row g-3 row-cols-2 row-cols-md-3 row-cols-lg-4">
                @if (Level == "main" || Level == "main_all")
                {
                    @if (categories != null)
                    {
                        @if (categories.Any())
                        {
                            @foreach (var cat in categories)
                            {
                                <div class="col-6 col-md-4 col-lg-3">
                                    <div class="category-card p-3 rounded-4 shadow-sm border text-center h-100 animate-up" @onclick="() => ExploreCategory(cat)">
                                        <div class="mb-3 mx-auto">
                                            <img src="@Api.GetAbsoluteUrl(cat.ImageUrl ?? "images/categories/default.jpg")" 
                                                 onerror="this.onerror=null;this.src='/images/categories/default.jpg';"
                                                 class="rounded-3 shadow-sm object-fit-cover" width="80" height="60" loading="lazy" />
                                        </div>
                                        <div class="fw-bold">@cat.Name</div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="col-12 text-center py-5">
                                <i class="fa-solid fa-folder-open fs-1 text-muted mb-3 opacity-50"></i>
                                <p class="text-muted fw-bold">لا توجد تصنيفات تحت هذا القسم حالياً</p>
                            </div>
                        }
                    }
                    else 
                    { 
                        @for (int i = 0; i < 8; i++)
                        {
                            <div class="col-6 col-md-4 col-lg-3">
                                <Khadamat.BlazorUI.Shared.SkeletonLoader Type="card" Count="1" />
                            </div>
                        }
                    }
                }
                else if (Level == "category")
                {
                    @if (subCategories != null)
                    {
                        @if (subCategories.Any())
                        {
                            @foreach (var sub in subCategories)
                            {
                                <div class="col-6 col-md-4 col-lg-3">
                                            <div class="category-card p-3 rounded-4 shadow-sm border text-center h-100 animate-up" @onclick="() => ExploreSubCategory(sub)">
                                        <div class="mb-3 mx-auto">
                                            <img src="@Api.GetAbsoluteUrl(sub.ImageUrl ?? "images/categories/default.jpg")" 
                                                 onerror="this.onerror=null;this.src='/images/categories/default.jpg';"
                                                 class="rounded-3 shadow-sm object-fit-cover" width="80" height="60" loading="lazy" />
                                        </div>
                                        <div class="fw-bold">@sub.Name</div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="col-12 text-center py-5">
                                <i class="fa-solid fa-layer-group fs-1 text-muted mb-3 opacity-50"></i>
                                <p class="text-muted fw-bold">لا توجد أنواع في هذا التصنيف حالياً</p>
                            </div>
                        }
                    }
                    else 
                    { 
                        @for (int i = 0; i < 8; i++)
                        {
                            <div class="col-6 col-md-4 col-lg-3">
                                <Khadamat.BlazorUI.Shared.SkeletonLoader Type="card" Count="1" />
                            </div>
                        }
                    }
                }
                else if (Level == "subcategory")
                {
                    @if (services != null)
                    {
                        @if (services.Any())
                        {
                            for (int i = 0; i < services.Count; i++)
                            {
                                var service = services[i];
                                <div class="col-12 col-md-6 mb-3">
                                    <ServiceCard Service="service" OnClick='(s) => Navigation.NavigateTo($"/service/{s.Id}")' />
                                </div>
                                
                                @if ((i + 1) % 3 == 0 && categoryAds != null && categoryAds.Any())
                                {
                                    var adIndex = ((i + 1) / 3 - 1) % categoryAds.Count;
                                    var ad = categoryAds[adIndex];
                                    <div class="col-12 col-md-6 mb-3">
                                        <NativeAdCard Ad="ad" />
                                    </div>
                                }
                            }
                        }
                        else
                        {
                            <div class="col-12 text-center py-5 opacity-50">
                                <i class="fa-solid fa-magnifying-glass fs-1 mb-3"></i>
                                <p>لا يوجد خدمات متاحة حالياً في هذا التصنيف</p>
                            </div>
                        }
                    }
                    else 
                    { 
                        @for (int i = 0; i < 6; i++)
                        {
                            <div class="col-12 col-md-6 mb-3">
                                <Khadamat.BlazorUI.Shared.SkeletonLoader Type="card" Count="1" />
                            </div>
                        }
                    }
                }
            </div>
        </div>
    </div>
</div>

<style>
    .icon-box-small {
        width: 45px;
        height: 45px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(99, 102, 241, 0.05);
        border-radius: 12px;
    }
    .category-card {
        cursor: pointer;
        transition: all 0.3s ease;
        background: white;
    }
    .category-card:hover {
        border-color: var(--primary) !important;
        background: rgba(99, 102, 241, 0.02);
    }
</style>

@code {
    [Parameter] public string Level { get; set; } = "";
    [Parameter] public int Id { get; set; }
    [Parameter] public string Name { get; set; } = "";

    private List<CategoryDto>? categories;
    private List<SubCategoryDto>? subCategories;
    private List<ServiceDto>? services;
    private List<EnhancedAdDto>? categoryAds;
    private List<BreadcrumbItem> breadcrumbItems = new();
    private string? errorMessage;

    protected override void OnParametersSet()
    {
        Console.WriteLine($"Explore.OnParametersSet: Level={Level}, Id={Id}, Name={Name}");
        // Execute fetch without awaiting to allow immediate render of Skeletons
        _ = FetchDataAsync();
    }

    private async Task FetchDataAsync()
    {
        Console.WriteLine($"Explore.FetchDataAsync started: Level={Level}, Id={Id}");
        categories = null;
        subCategories = null;
        services = null;
        errorMessage = null;
        breadcrumbItems.Clear();

        try
        {
            if (string.IsNullOrEmpty(Level))
            {
                Level = "main_all";
                breadcrumbItems.Add(new BreadcrumbItem { Label = "استكشف الفئات", IsActive = true });
                var mainCategories = await Api.GetMainCategoriesAsync();
                categories = mainCategories?.Select(mc => new CategoryDto { Id = mc.Id, Name = mc.Name, ImageUrl = mc.ImageUrl }).ToList();
            }
            else if (Level == "main")
            {
                breadcrumbItems.Add(new BreadcrumbItem { Label = Name, IsActive = true });
                categories = await Api.GetCategoriesByMainIdAsync(Id);
            }
            else if (Level == "category")
            {
                var catInfo = await Api.GetCategoryByIdAsync(Id);
                if (catInfo != null)
                {
                    breadcrumbItems.Add(new BreadcrumbItem { 
                        Label = catInfo.MainCategoryName ?? "التصنيف الرئيسي", 
                        Url = $"/explore/main/{catInfo.MainCategoryId}/{Uri.EscapeDataString(catInfo.MainCategoryName ?? "")}",
                        Data = new { Level = "main", Id = catInfo.MainCategoryId, Name = catInfo.MainCategoryName }
                    });
                    breadcrumbItems.Add(new BreadcrumbItem { Label = Name, IsActive = true });
                }
                subCategories = await Api.GetSubCategoriesByCategoryIdAsync(Id);
            }
            else if (Level == "subcategory")
            {
                var subInfo = await Api.GetSubCategoryByIdAsync(Id);
                if (subInfo != null)
                {
                    breadcrumbItems.Add(new BreadcrumbItem { 
                        Label = subInfo.MainCategoryName ?? "التصنيف الرئيسي", 
                        Url = $"/explore/main/{subInfo.MainCategoryId}/{Uri.EscapeDataString(subInfo.MainCategoryName ?? "")}",
                        Data = new { Level = "main", Id = subInfo.MainCategoryId, Name = subInfo.MainCategoryName }
                    });
                    breadcrumbItems.Add(new BreadcrumbItem { 
                        Label = subInfo.CategoryName ?? "التصنيف", 
                        Url = $"/explore/category/{subInfo.CategoryId}/{Uri.EscapeDataString(subInfo.CategoryName ?? "")}",
                        Data = new { Level = "category", Id = subInfo.CategoryId, Name = subInfo.CategoryName }
                    });
                    breadcrumbItems.Add(new BreadcrumbItem { Label = Name, IsActive = true });
                }
                
                var servicesTask = Api.GetServicesAsync(subCategoryId: Id);
                var categoryAdsTask = Api.GetCategoryAdsAsync(Id);
                
                await Task.WhenAll(servicesTask, categoryAdsTask);
                
                services = servicesTask.Result.Items;
                categoryAds = categoryAdsTask.Result;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Explore.FetchDataAsync ERROR: {ex.Message}");
            errorMessage = $"حدث خطأ أثناء تحميل البيانات: {ex.Message}";
        }
        finally
        {
            StateHasChanged();
        }
    }

    private void HandleBreadcrumbClick(BreadcrumbItem item)
    {
        if (item.Data != null)
        {
            dynamic data = item.Data;
            Navigation.NavigateTo($"/explore/{data.Level}/{data.Id}/{Uri.EscapeDataString(data.Name)}");
        }
    }

    private void ExploreCategory(CategoryDto cat)
    {
        Navigation.NavigateTo($"/explore/category/{cat.Id}/{Uri.EscapeDataString(cat.Name)}");
    }

    private void ExploreSubCategory(SubCategoryDto sub)
    {
        Navigation.NavigateTo($"/explore/subcategory/{sub.Id}/{Uri.EscapeDataString(sub.Name)}");
    }
}
