        border-radius: 1.25rem;
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }
    .spec-icon-box {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
