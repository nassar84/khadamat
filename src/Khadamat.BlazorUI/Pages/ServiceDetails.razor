    /// <summary>Only fills missing/empty fields — never overwrites real API data.</summary>
    private void EnsureRequiredFields()
    {
        if (service == null) return;

        // Lists must never be null
        service.Images  ??= new List<string>();
        service.Reviews ??= new List<ReviewDto>();
        service.Posts   ??= new List<PostDto>();

