    private string GetCardFacebookDisplay(string? fb)
    {
        if (string.IsNullOrWhiteSpace(fb)) return "";
        var clean = fb.Trim().TrimEnd('/');
        if (clean.Contains("facebook.com/"))
        {
            var segments = clean.Split(new[] { "facebook.com/" }, StringSplitOptions.None);
            if (segments.Length > 1 && !string.IsNullOrWhiteSpace(segments[1]))
            {
                var pageName = segments[1].Split('?')[0].TrimEnd('/');
                return string.IsNullOrWhiteSpace(pageName) ? "فيسبوك" : pageName;
            }
        }
        return clean;
    }

