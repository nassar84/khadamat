    private async Task ToggleFavorite()
    {
        if (service == null) return;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated != true)
        {
            Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(Navigation.Uri)}");
            return;
        }

        // Optimistic update
        bool wasAlreadyFavorite = service.IsFavorite;
        service.IsFavorite = !wasAlreadyFavorite;
        if (wasAlreadyFavorite && service.LikesCount > 0) service.LikesCount--;
        else if (!wasAlreadyFavorite) service.LikesCount++;
        State.SetServiceFavorite(service.Id, service.IsFavorite);
        StateHasChanged();

        try
        {
            var res = await Api.ToggleFavoriteAsync(service.Id);
            if (res.Success && res.Data != null)
            {
                service.IsFavorite  = res.Data.IsFavorite;
                service.LikesCount  = res.Data.FavoritesCount;
                State.SetServiceFavorite(service.Id, res.Data.IsFavorite);
                StateHasChanged();
            }
            else
            {
                // Revert on failure
                service.IsFavorite = wasAlreadyFavorite;
                service.LikesCount = wasAlreadyFavorite ? service.LikesCount + 1 : Math.Max(0, service.LikesCount - 1);
                State.SetServiceFavorite(service.Id, wasAlreadyFavorite);
                StateHasChanged();
            }
        }
        catch
        {
            // Revert on exception
            service.IsFavorite = wasAlreadyFavorite;
            State.SetServiceFavorite(service.Id, wasAlreadyFavorite);
            StateHasChanged();
        }
    }

