@page "/service/{Id:int}"
@using Khadamat.Application.DTOs
@using Khadamat.BlazorUI.Services
@using Khadamat.BlazorUI.Services.Auth
@using Microsoft.AspNetCore.Components.Authorization
@inject ApiClient Api
@inject Khadamat.BlazorUI.State.AppState State
@inject IAuthService AuthService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject Khadamat.BlazorUI.Services.SoundService SoundService
@inject Khadamat.Shared.Interfaces.IShareService DeviceShareService
@inject Khadamat.Shared.Interfaces.IPhoneService PhoneService
@inject Khadamat.Shared.Interfaces.ILocationService LocationService

<div class="service-v3-container">
    @if (!isLoaded)
    {
        <div class="container py-4">
            <Khadamat.BlazorUI.Shared.SkeletonLoader Type="service-details" Count="1" />
        </div>
    }
    else if (!service.IsProviderSubscriptionActive && !CanEdit)
    {
        <div class="container py-5 text-center">
            <div class="glass-card p-5 mx-auto rounded-4 shadow-sm animate-pop" style="max-width: 550px;">
                <i class="fa-solid fa-triangle-exclamation fa-4x text-warning mb-3 opacity-75"></i>
                <h3 class="fw-bold mb-3 text-dark">هذه الخدمة غير متاحة حالياً</h3>
                <p class="text-muted mb-4 lead fs-6">
                    عذراً، لا يمكن استعراض تفاصيل هذه الخدمة أو التواصل مع مقدمها نظراً لانتهاء فترة اشتراكه على المنصة.
                </p>
                <button class="btn btn-primary-premium rounded-pill px-4" @onclick="GoBack">
                    <i class="fa-solid fa-arrow-right me-2"></i> العودة للخدمات
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="container py-4">
            @if (!service.IsProviderSubscriptionActive)
            {
                <div class="alert alert-warning rounded-4 mb-4 d-flex align-items-center gap-3 animate-pop" style="border-right: 5px solid #f59e0b;">
                    <i class="fa-solid fa-circle-exclamation fs-3 text-warning flex-shrink-0"></i>
                    <div>
                        <div class="fw-bold mb-1">الخدمة غير متاحة حالياً</div>
                        <div class="small text-muted">@(service.ProviderSubscriptionMessage ?? "لانتهاء فترة اشتراك مقدم الخدمة على المنصة.")</div>
                    </div>
                </div>
            }
            <!-- Top Actions -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <button class="btn btn-glass-dark" @onclick="GoBack">
                    <i class="fa-solid fa-arrow-right"></i>
                </button>
                <div class="d-flex gap-2">
                    @if (CanEdit)
                    {
                        <button class="btn btn-glass-dark text-warning" @onclick='() => OpenEdit("main")'>
                            <i class="fa-solid fa-pen"></i>
                        </button>
                    }
                    else if (IsAuthenticated)
                    {
                        <button class="btn btn-glass-dark text-info" title="اقتراح تعديل بيانات الخدمة" @onclick="OpenRequestEditModal">
                            <i class="fa-solid fa-pen-to-square"></i>
                        </button>
                    }
                    <button class="btn btn-glass-dark @(service.IsFavorite ? "text-danger" : "")" @onclick="ToggleFavorite">
                        <i class="@(service.IsFavorite ? "fa-solid" : "fa-regular") fa-heart"></i>
                    </button>
                </div>
            </div>

            <div class="mb-4">
                <nav aria-label="breadcrumb" class="mb-2">
                    <ol class="breadcrumb-v3 d-flex flex-wrap align-items-center gap-1 mb-0 p-0 list-unstyled">
                        <li>
                            <a class="category-tag breadcrumb-link"
                               href="/explore/main/@service.MainCategoryId/@Uri.EscapeDataString(service.MainCategoryName ?? "")">
                                <i class="fa-solid fa-house-chimney me-1 opacity-75" style="font-size:0.7rem"></i>
                                @service.MainCategoryName
                            </a>
                        </li>
                        @if (!string.IsNullOrEmpty(service.CategoryName) && service.CategoryId.HasValue)
                        {
                            <li class="breadcrumb-sep"><i class="fa-solid fa-chevron-left"></i></li>
                            <li>
                                <a class="category-tag bg-indigo-light text-indigo breadcrumb-link"
                                   href="/explore/category/@service.CategoryId/@Uri.EscapeDataString(service.CategoryName ?? "")">
                                    @service.CategoryName
                                </a>
                            </li>
                        }
                        @if (!string.IsNullOrEmpty(service.SubCategoryName) && service.SubCategoryId.HasValue)
                        {
                            <li class="breadcrumb-sep"><i class="fa-solid fa-chevron-left"></i></li>
                            <li>
                                <a class="category-tag bg-purple-light text-purple breadcrumb-link"
                                   href="/explore/subcategory/@service.SubCategoryId/@Uri.EscapeDataString(service.SubCategoryName ?? "")">
                                    @service.SubCategoryName
                                </a>
                            </li>
                        }
                    </ol>
                </nav>
                <h1 class="fw-900 mb-0 display-5 text-dark">@service.Title</h1>
            </div>

            <!-- Main Info Row -->
            <div class="row g-4 mb-5">
                <!-- Physycal Right (Start in RTL): Image & Stats -->
                <div class="col-12 col-md-5">
                    <div class="main-image-v3 rounded-5 overflow-hidden shadow-lg position-relative mb-4">
                        <!-- Blurred Background Image to fill the space beautifully without cropping -->
                        <img src="@mainImage" 
                             class="position-absolute w-100 h-100" 
                             style="top: 0; left: 0; object-fit: cover; filter: blur(20px); opacity: 0.35; z-index: 1; transform: scale(1.15);" />
                        <!-- Semi-transparent overlay to enhance contrast -->
                        <div class="position-absolute top-0 start-0 w-100 h-100" style="background: rgba(255, 255, 255, 0.15); z-index: 2;"></div>
                        <!-- Sharp Foreground Image -->
                        <img src="@mainImage" class="w-100 h-100 position-relative z-3" style="object-fit: contain;" alt="@service.Title" />
                        
                        <!-- Favorite Button Overlay -->
                        <div class="position-absolute top-0 start-0 m-3 z-3">
                            <button class="btn btn-glass-dark @(service.IsFavorite ? "text-danger" : "") shadow" @onclick="ToggleFavorite">
                                <i class="@(service.IsFavorite ? "fa-solid" : "fa-regular") fa-heart"></i>
                            </button>
                        </div>

                        @if (service.Images != null && service.Images.Count > 1)
                        {
                            <div class="gallery-preview-mini">
                                @foreach (var img in service.Images.Take(3))
                                {
                                    <img src="@img" class="mini-img @(img == selectedImage ? "active" : "")" @onclick="() => selectedImage = img" />
                                }
                                @if (service.Images.Count > 3)
                                {
                                    <div class="more-imgs" @onclick='() => selectedImage = service.Images.Skip(3).FirstOrDefault()'>+@(service.Images.Count - 3)</div>
                                }
                            </div>
                        }
                    </div>
                    
                    <!-- Star Rating Display (clickable) -->
                    <div class="rating-display-v3 mb-3 text-center py-2 bg-light bg-opacity-50 rounded-4">
                        <div class="stars-v3 text-warning d-flex justify-content-center gap-1">
                            @for (int i = 1; i <= 5; i++)
                            {
                                int starVal = i;
                                @if (i <= Math.Floor(service.Rating))
                                {
                                    <i class="fa-solid fa-star fs-3 rating-star-clickable" title="قيّم بـ @starVal نجوم" @onclick="() => StartRating(starVal)"></i>
                                }
                                else if (i == Math.Ceiling(service.Rating) && service.Rating % 1 >= 0.3)
                                {
                                    <i class="fa-solid fa-star-half-stroke fs-3 rating-star-clickable" title="قيّم بـ @starVal نجوم" @onclick="() => StartRating(starVal)"></i>
                                }
                                else
                                {
                                    <i class="fa-regular fa-star fs-3 rating-star-clickable" title="قيّم بـ @starVal نجوم" @onclick="() => StartRating(starVal)"></i>
                                }
                            }
                        </div>
                        <div class="fw-bold mt-1" style="color: #444;">
                            @service.Rating.ToString("0.1")
                            <span class="text-muted small fw-normal ms-1">(إجمالي @service.RatersCount تقييم)</span>
                        </div>
                        <button class="btn btn-sm btn-warning rounded-pill px-3 mt-2 fw-bold" style="font-size:0.78rem;" @onclick="() => StartRating(0)">
                            <i class="fa-solid fa-star me-1"></i> قيّم واكتب رأيك
                        </button>
                    </div>

                    <!-- Stats Box (Below Image) -->
                    <div class="stats-box-v3 p-4 rounded-5 shadow-sm border bg-white mb-4">
                        <div class="row g-2 align-items-center text-center">
                            <div class="col-4 border-start">
                                <div class="x-small text-muted">السعر</div>
                                <div class="fw-900 fs-5 text-gradient">@service.Price?.ToString("N0") ج.م</div>
                            </div>
                            <div class="col-4 border-start">
                                <div class="x-small text-muted">المشاهدات</div>
                                <div class="fw-900 fs-5 text-indigo">
                                    <i class="fa-solid fa-eye"></i> @service.ViewsCount
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="x-small text-muted">إعجاب</div>
                                <div class="fw-900 fs-5 text-danger">
                                     <i class="fa-solid fa-heart"></i> @service.LikesCount
                                </div>
                            </div>
                        </div>
                        <hr class="my-3 opacity-10" />
                        <div class="text-center x-small text-muted px-2">
                             <span><i class="fa-solid fa-calendar-alt me-1"></i> تم النشر في @service.CreatedAt.ToString("yyyy/MM/dd")</span>
                        </div>
                    </div>

                    <div class="contact-actions-v3 d-flex flex-column gap-2 mt-auto">
                        @if (!CanEdit)
                        {
                            <button class="btn btn-request-main w-100 py-3 shadow-lg d-flex align-items-center justify-content-center gap-2" @onclick="OpenRequestModal">
                                <i class="fa-solid fa-calendar-check fs-4"></i>
                                <span class="fs-6 fw-bold">طلب الخدمة الآن</span>
                            </button>
                        }
                        
                        @if (!string.IsNullOrEmpty(service.YouTubeUrl))
                        {
                            <a href="@service.YouTubeUrl" target="_blank" class="btn btn-outline-danger w-100 rounded-4 py-2 mt-1">
                                <i class="fa-brands fa-youtube me-1"></i> مشاهدة العرض المرئي
                            </a>
                        }
                    </div>
                </div>

                <!-- Physycal Left (End in RTL): Details -->
                <div class="col-12 col-md-7">
                    <div class="details-content-v3 ps-md-3">
                        <!-- Description -->
                        <div class="service-description-v3 mb-4">
                            <p class="text-muted fs-5 leading-relaxed">@service.Description</p>
                        </div>


                        <div class="info-grid-v3 mb-4">
                            <!-- Location: Governorate & City -->
                            <div class="info-item-v3">
                                <i class="fa-solid fa-location-dot text-danger"></i>
                                <div>
                                    <div class="fw-bold">الموقع</div>
                                    <div class="small">@service.GovernorateName - @service.CityName</div>
                                    <div class="x-small text-muted">@service.Address</div>
                                </div>
                            </div>

                            <!-- Appointments -->
                            <div class="info-item-v3">
                                <i class="fa-solid fa-clock text-primary"></i>
                                <div>
                                    <div class="fw-bold">المواعيد</div>
                                    <div class="small">@(string.IsNullOrEmpty(service.WorkDays) ? "متاح يومياً" : service.WorkDays)</div>
                                    <div class="small text-muted">@service.WorkHours</div>
                                </div>
                            </div>

                            <!-- Contact Numbers -->
                            <div class="info-item-v3">
                                <i class="fa-solid fa-phone text-success"></i>
                                <div>
                                    <div class="fw-bold">أرقام التواصل</div>
                                    <div class="small" dir="ltr" style="unicode-bidi: isolate; text-align: right;">@service.Phone1</div>
                                    @if (!string.IsNullOrEmpty(service.Phone2))
                                    {
                                        <div class="small" dir="ltr" style="unicode-bidi: isolate; text-align: right;">@service.Phone2</div>
                                    }
                                </div>
                            </div>

                            <!-- Social Links -->
                            @if (!string.IsNullOrEmpty(service.WhatsApp) || !string.IsNullOrEmpty(service.Telegram) || !string.IsNullOrEmpty(service.Facebook) || !string.IsNullOrEmpty(service.YouTubeUrl))
                            {
                                <div class="info-item-v3">
                                    <i class="fa-solid fa-share-nodes text-primary"></i>
                                    <div>
                                        <div class="fw-bold">روابط التواصل</div>
                                        <div class="d-flex gap-2 mt-1 social-links-v3 flex-wrap">
                                            @if (!string.IsNullOrEmpty(service.WhatsApp))
                                            {
                                                <a href="@GetWhatsAppDirectUrl(service.WhatsApp)" target="_blank" rel="noopener noreferrer" title="مراسلة عبر واتساب" class="social-icon-btn whatsapp shadow-sm">
                                                    <i class="fa-brands fa-whatsapp fs-5"></i>
                                                </a>
                                            }
                                            @if (!string.IsNullOrEmpty(service.Telegram))
                                            {
                                                <a href="@GetTelegramUrl(service.Telegram)" target="_blank" rel="noopener noreferrer" title="تليجرام" class="social-icon-btn telegram shadow-sm">
                                                    <i class="fa-brands fa-telegram fs-5"></i>
                                                </a>
                                            }
                                            @if (!string.IsNullOrEmpty(service.Facebook))
                                            {
                                                <a href="@GetFacebookUrl(service.Facebook)" target="_blank" rel="noopener noreferrer" title="فيسبوك" class="social-icon-btn facebook shadow-sm">
                                                    <i class="fa-brands fa-facebook-f fs-5"></i>
                                                </a>
                                            }
                                            @if (!string.IsNullOrEmpty(service.YouTubeUrl))
                                            {
                                                <a href="@GetYouTubeUrl(service.YouTubeUrl)" target="_blank" rel="noopener noreferrer" title="يوتيوب" class="social-icon-btn youtube shadow-sm">
                                                    <i class="fa-brands fa-youtube fs-5"></i>
                                                </a>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Disclaimer Alert -->
                        <div class="disclaimer-alert p-3 rounded-4 mb-3 border bg-warning bg-opacity-10 border-warning border-opacity-25 d-flex align-items-start gap-3">
                            <i class="fa-solid fa-shield-halved text-warning fs-4 flex-shrink-0 mt-1"></i>
                            <div class="small">
                                <strong class="text-dark d-block mb-1">إخلاء مسؤولية وتأكيد الطلب:</strong>
                                <span class="text-muted leading-relaxed">
                                    التطبيق غير مسؤول عن الطلبات والتعاملات المالية أو الاتفاقات المبرمة بين العملاء ومقدمي الخدمات.
                                    يُرجى تأكيد طلبك دائماً بالاتصال المباشر مع مقدم الخدمة عبر طرق التواصل المتاحة في بيانات الخدمة (الاتصال الهاتفي أو عبر واتساب).
                                </span>
                            </div>
                        </div>


                        <!-- Action Buttons: Direct Phone Call -->
                        <div class="action-buttons-v3 mb-2">
                            <button class="btn btn-call w-100 py-3 shadow-sm d-flex align-items-center justify-content-center gap-2" @onclick="CallProvider" disabled="@(string.IsNullOrEmpty(service.Phone1) && string.IsNullOrEmpty(service.Phone2))">
                                <i class="fa-solid fa-phone fs-5"></i>
                                <span class="fs-6 fw-bold">اتصال هاتفياً</span>
                            </button>
                        </div>

                        <!-- Action Buttons: Message Provider -->
                        @if (!string.IsNullOrEmpty(service.UserId) && !CanEdit)
                        {
                            <div class="action-buttons-v3 mb-2">
                                <AuthorizeView>
                                    <Authorized>
                                        <button class="btn btn-message w-100 py-3 shadow-sm d-flex align-items-center justify-content-center gap-2"
                                                @onclick="StartChat">
                                            <i class="fa-solid fa-comment-dots fs-5"></i>
                                            <span class="fs-6 fw-bold">راسل المزود</span>
                                        </button>
                                    </Authorized>
                                    <NotAuthorized>
                                        <button class="btn btn-message w-100 py-3 shadow-sm d-flex align-items-center justify-content-center gap-2"
                                                @onclick='() => Navigation.NavigateTo("/login")'>
                                            <i class="fa-solid fa-comment-dots fs-5"></i>
                                            <span class="fs-6 fw-bold">راسل المزود</span>
                                        </button>
                                    </NotAuthorized>
                                </AuthorizeView>
                            </div>
                        }

                        <!-- Share Button (Opens Share Modal) -->
                        <div class="d-flex gap-2 mb-4">
                            <button class="btn btn-share-premium flex-grow-1 py-3 shadow" @onclick="OpenShareModal">
                                <i class="fa-solid fa-share-nodes me-2"></i> مشاركة الخدمة
                            </button>
                            <button class="btn btn-outline-secondary py-3 px-3 shadow-sm rounded-4" @onclick="CopyShareLink" title="نسخ الرابط">
                                <i class="fa-solid @(shareCopyStatus != null ? "fa-check text-success" : "fa-link")"></i>
                            </button>
                        </div>
                        @if (!string.IsNullOrEmpty(shareCopyStatus))
                        {
                            <div class="alert alert-success py-2 text-center small rounded-4 mb-3">@shareCopyStatus</div>
                        }

                        <!-- New Request Edit Enhancement Button -->
                        <div class="edit-request-banner p-4 rounded-5 mt-4 mb-4 shadow-sm border border-info border-opacity-25 bg-info bg-opacity-5 animate-up">
                            <div class="d-flex align-items-center gap-3">
                                <div class="icon-circle bg-info text-white shadow-sm">
                                    <i class="fa-solid fa-circle-info fs-4"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <h6 class="fw-800 mb-1">هل لاحظت شيئاً غير دقيق؟</h6>
                                    <p class="small text-muted mb-0">ساعدنا وساعد بقية المستخدمين بتصحيح بيانات هذه الخدمة لتبقى تجربتكم دائماً الأفضل.</p>
                                </div>
                                <button class="btn btn-info rounded-pill px-4 py-2 text-white fw-bold shadow-sm" @onclick="OpenRequestEditModal">
                                    تحديث البيانات <i class="fa-solid fa-magic-wand-sparkles ms-1"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Posts Section -->
            <div class="mb-5 pt-4 border-top">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4 class="fw-900 mb-0 border-right-styled pe-3">أحدث المنشورات</h4>
                    @if (CanEdit)
                    {
                        <button class="btn btn-primary btn-sm rounded-pill px-3" @onclick="() => showCreatePostBox = !showCreatePostBox">
                            <i class="fa-solid @(showCreatePostBox ? "fa-xmark" : "fa-plus") me-1"></i>
                            @(showCreatePostBox ? "إلغاء" : "منشور جديد")
                        </button>
                    }
                </div>

                @if (CanEdit && showCreatePostBox)
                {
                    <div class="glass-card-v3 p-4 mb-4 animate-pop">
                        <label class="form-label fw-bold small">اكتب منشوراً جديداً لعملائك</label>
                        <textarea @bind="newPostContent" class="form-control border-light mb-3" rows="3" placeholder="أخبر عملائك عن تخفيضاتك أو أعمالك الجديدة..."></textarea>
                        <div class="d-flex justify-content-end">
                            <button class="btn btn-primary rounded-pill px-4" @onclick="CreatePost" disabled="@isPostingPost">
                                @if (isPostingPost)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                <i class="fa-solid fa-paper-plane me-1"></i> نشر الآن
                            </button>
                        </div>
                    </div>
                }

                @if (service.Posts.Any())
                {
                    <div class="row g-4">
                        @foreach (var post in service.Posts)
                        {
                            <div class="col-12 col-lg-6">
                                <div class="glass-card-v3 p-4 h-100">
                                    <div class="d-flex align-items-center gap-2 mb-3">
                                        <img src="@Khadamat.BlazorUI.Helpers.DefaultImages.GetUserAvatar(service.ProviderName, null, service.ProviderPhoto)" class="rounded-circle" width="35" />
                                        <div class="x-small fw-bold">@service.ProviderName</div>
                                        <div class="ms-auto x-small text-muted">@post.CreatedAt.ToString("dd/MM")</div>
                                    </div>
                                    <p class="mb-3 small">@post.Content</p>
                                    @if (!string.IsNullOrEmpty(post.ImageUrl))
                                    {
                                        <img src="@post.ImageUrl" class="w-100 rounded-4 mb-3" />
                                    }
                                    <div class="d-flex gap-3 pt-3 border-top x-small">
                                        <span><i class="fa-regular fa-heart"></i> @post.LikesCount</span>
                                        <span class="cursor-pointer" @onclick="() => ToggleComments(post.Id)">
                                            <i class="fa-regular fa-comment"></i> @post.CommentsCount تعليقات
                                        </span>
                                    </div>

                                    @if (expandedPostId == post.Id)
                                    {
                                        <div class="comments-section mt-3 pt-3 border-top animate-fade-in">
                                            @if (post.Comments != null && post.Comments.Any())
                                            {
                                                <div class="comments-list mb-3">
                                                    @foreach (var comment in post.Comments)
                                                    {
                                                        <div class="comment-item mb-2 p-2 rounded-3 bg-light">
                                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                                <span class="fw-bold x-small">@comment.UserName</span>
                                                                <span class="text-muted xx-small">@comment.CreatedAt.ToString("MM/dd HH:mm")</span>
                                                            </div>
                                                            <div class="small">@comment.Text</div>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="text-center text-muted x-small py-2">لا توجد تعليقات بعد</div>
                                            }

                                            <div class="add-comment-box d-flex gap-2">
                                                <input type="text" @bind="newCommentText" class="form-control form-control-sm rounded-pill" placeholder="أضف تعليقاً..." />
                                                <button class="btn btn-primary btn-sm rounded-circle" @onclick="() => AddComment(post.Id)" disabled="@isPostingComment">
                                                    <i class="fa-solid fa-paper-plane"></i>
                                                </button>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-5 bg-white rounded-5 border border-dashed">
                        <div class="mb-3 opacity-25"><i class="fa-solid fa-newspaper fs-1"></i></div>
                        <div class="text-muted">لا توجد منشورات حالياً</div>
                    </div>
                }
            </div>

            <!-- Reviews List -->
            <div class="mb-5 pt-4 border-top">
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <h4 class="fw-900 mb-0 border-right-styled pe-3">تقييمات العملاء</h4>
                    <button class="btn btn-warning rounded-pill px-3 fw-bold" style="font-size:0.82rem;" @onclick="() => StartRating(0)">
                        <i class="fa-solid fa-star me-1"></i> أضف تقييمك
                    </button>
                </div>

                @if (service.Reviews == null || !service.Reviews.Any())
                {
                    <div class="text-center py-5">
                        <i class="fa-regular fa-star fs-1 text-warning opacity-50 mb-3 d-block"></i>
                        <p class="text-muted fw-semibold mb-1">لا توجد تقييمات أو تعليقات حتى الآن.</p>
                        <p class="text-muted small mb-3">كن أول من يقيّم هذه الخدمة ويشارك تجربته!</p>
                        <button class="btn btn-warning rounded-pill px-4 fw-bold" @onclick="() => StartRating(5)">
                            <i class="fa-solid fa-star me-1"></i> أضف تقييمك الآن
                        </button>
                    </div>
                }
                else
                {
                    <div class="row g-3">
                        @foreach (var review in service.Reviews)
                        {
                            <div class="col-12 col-md-6">
                                <div class="glass-card-v3 p-4 h-100" style="border-radius:16px;">
                                    <div class="d-flex align-items-center gap-3 mb-3">
                                        <img src="@Khadamat.BlazorUI.Helpers.DefaultImages.GetUserAvatar(review.UserName, null, review.UserAvatar)"
                                             class="rounded-circle border shadow-sm" width="44" height="44" style="object-fit:cover;" />
                                        <div class="flex-grow-1">
                                            <div class="fw-bold" style="color:#1e293b;font-size:0.95rem;">@review.UserName</div>
                                            <div class="x-small text-muted">
                                                <i class="fa-regular fa-calendar me-1"></i>
                                                @review.CreatedAt.ToString("yyyy/MM/dd")
                                            </div>
                                        </div>
                                        <div class="text-warning d-flex gap-1">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <i class="@(i <= review.Rating ? "fa-solid" : "fa-regular") fa-star small"></i>
                                            }
                                        </div>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(review.Comment))
                                    {
                                        <p class="text-muted mb-0" style="font-size:0.88rem;line-height:1.6;">@review.Comment</p>
                                    }
                                    else
                                    {
                                        <p class="text-muted mb-0 fst-italic" style="font-size:0.82rem;">لم يترك تعليقاً</p>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Similar Services -->
            <div class="mb-5 pt-4 border-top">
                <h4 class="fw-900 mb-4 border-right-styled pe-3">@similarServicesLabel</h4>
                @if (similarServices == null)
                {
                    <div class="row g-3">
                        <Khadamat.BlazorUI.Shared.SkeletonLoader Type="card" Count="3" />
                    </div>
                }
                else if (!similarServices.Any())
                {
                    <p class="text-muted small text-center">لا توجد خدمات مشابهة في الوقت الحالي</p>
                }
                else
                {
                    <div class="row g-3">
                        @foreach (var s in similarServices)
                        {
                            <div class="col-6 col-md-3">
                                <div class="glass-card-v3 p-0 overflow-hidden h-100 cursor-pointer" @onclick='() => Navigation.NavigateTo($"/service/{s.Id}")'>
                                    <img src="@Api.GetAbsoluteUrl(Khadamat.BlazorUI.Helpers.DefaultImages.GetServiceImage(s.Images.FirstOrDefault(), s.SubCategoryName, s.CategoryName, s.MainCategoryName, s.SubCategoryImageUrl, s.CategoryImageUrl, s.MainCategoryImageUrl))" class="w-100 object-fit-cover" style="height: 140px; display: block;" />
                                    <div class="p-2">
                                        <div class="fw-bold x-small text-truncate">@s.Title</div>
                                        <div class="text-muted xx-small" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">@s.Description</div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>

<!-- Share Modal -->
<div class="share-modal-overlay @(showShareModal ? "active" : "")" @onclick="() => showShareModal = false">
    @if (service != null)
    {
        <div class="glass-card p-4 rounded-4 animate-pop share-modal-container" @onclick:stopPropagation="true">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0 text-dark"><i class="fa-solid fa-share-nodes text-primary me-2"></i>مشاركة الخدمة</h5>
                <button class="btn-close shadow-none border-0 bg-transparent text-muted" @onclick="() => showShareModal = false">
                    <i class="fa-solid fa-xmark fs-5"></i>
                </button>
            </div>

            <!-- Share Preview Card (landscape format for social media) -->
