    protected override async Task OnInitializedAsync()
    {
        try
        {
            service = await Api.GetServiceByIdAsync(Id);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"API Error in ServiceDetails: {ex.Message}");
        }

        if (service == null)
            GenerateMockServiceSafe(Id);

        // Only fill truly missing fields — never overwrite real API data
        EnsureRequiredFields();

        // Auth check — non-blocking
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user.Identity?.IsAuthenticated == true)
            {
                var profile = await AuthService.GetProfileAsync();
                if (profile?.Success == true)
                {
                    var myUserId = profile.Data?.Id;
                    CanEdit = user.IsInRole("Admin") ||
                              user.IsInRole("SystemAdmin") ||
                              (service?.UserId != null && service.UserId == myUserId);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Auth check error: {ex.Message}");
        }
    }

    private void GenerateMockServiceSafe(int id)
    {
        try
        {
            var safeId = Math.Abs(id);
            var categories = new[] { "صيانة", "كهرباء", "سباكة", "نظافة", "ديكور", "نقل" };
            var category = categories[safeId % categories.Length];
            var random = new Random(safeId);

            service = new ServiceDto
            {
                Id = id,
                Title = GetMockTitle(id, category),
                Description = "هذه خدمة تجريبية تم توليدها تلقائياً لعرض تفاصيل الخدمة. نقدم أفضل الخدمات بأعلى جودة وأفضل الأسعار.",
                Price = 100 + safeId, // Simple math
                CategoryName = category,
                MainCategoryName = "خدمات منزلية",
                SubCategoryName = category,
                Location = "الرياض",
                Address = "عنوان تجريبي",
                Rating = 4.5,
                RatersCount = 50,
                WorkDays = "السبت - الخميس",
                WorkHours = "8 ص - 10 م",
                ProviderName = "مقدم خدمة " + id,
                ProviderPhoto = null,
                Phone1 = "0500000000",
                IsFavorite = false,
                Images = new List<string>
                {
                    "https://picsum.photos/seed/" + id + "/800/600",
                    "https://picsum.photos/seed/" + (id+1) + "/800/600"
                },
                Reviews = new List<ReviewDto>(),
                Posts = new List<PostDto>()
            };
        }
        catch(Exception ex)
        {
             Console.WriteLine($"Mock Gen Error: {ex}");
             service = new ServiceDto { Id = id, Title = "Mock Error", Images=new(), Reviews=new(), Posts=new() };
        }
    }

    private string GetMockTitle(int id, string category)
    {
        return category switch
        {
            "صيانة" => "صيانة مكيفات سبليت وشباك",
            "كهرباء" => "تأسيس وصيانة كهرباء منازل",
            "سباكة" => "كشف تسربات المياه وإصلاحها",
            "نظافة" => "تنظيف شقق وفلل وقصور",
            "ديكور" => "تصميم وتنفيذ ديكورات داخلية",
            "نقل" => "نقل عفش مع الفك والتركيب",
            _ => "خدمة مميزة رقم " + id
        };
    }

    /// <summary>Only fills missing/empty fields — never overwrites real API data.</summary>
    private void EnsureRequiredFields()
    {
        if (service == null) return;

        // Lists must never be null
        service.Images  ??= new List<string>();
        service.Reviews ??= new List<ReviewDto>();
        service.Posts   ??= new List<PostDto>();

        // Add a placeholder image if none exist
        if (!service.Images.Any())
            service.Images.Add($"https://picsum.photos/seed/{service.Id}/800/600");

        // Ensure location strings have a fallback
        if (string.IsNullOrEmpty(service.GovernorateName)) service.GovernorateName = service.Location ?? "غير محدد";
        if (string.IsNullOrEmpty(service.CityName)) service.CityName = "غير محدد";
    }

    private void SetTab(string tab) => activeTab = tab;
    
    private void GoBack() => Navigation.NavigateTo("explore");

    private async Task ToggleFavorite()
    {
        if (service == null) return;
        // Optimistic update
        service.IsFavorite = !service.IsFavorite;
        StateHasChanged();
        try
        {
            await Api.ToggleFavoriteAsync(service.Id);
        }
        catch
        {
            // Revert on failure
            service.IsFavorite = !service.IsFavorite;
            StateHasChanged();
        }
    }

