                categoryImage = Khadamat.BlazorUI.Helpers.CategoryIconResolver.GetIconUrl(service.SubCategoryName, service.SubCategoryImageUrl, "images/subcategories", service.CategoryName, service.CategoryImageUrl, "images/categories", service.MainCategoryImageUrl, "images/maincategories");
            }
            else if (!string.IsNullOrEmpty(service.CategoryName))
            {
                categoryImage = Khadamat.BlazorUI.Helpers.CategoryIconResolver.GetIconUrl(service.CategoryName, service.CategoryImageUrl, "images/categories", service.MainCategoryName, service.MainCategoryImageUrl, "images/maincategories");
            }
            else if (!string.IsNullOrEmpty(service.MainCategoryName))
            {
                categoryImage = Khadamat.BlazorUI.Helpers.CategoryIconResolver.GetIconUrl(service.MainCategoryName, service.MainCategoryImageUrl, "images/maincategories");
            }

            if (string.IsNullOrEmpty(categoryImage) || categoryImage.Contains("other_services"))
            {
                categoryImage = $"https://picsum.photos/seed/{service.Id}/800/600";
            }
            else
            {
                if (!categoryImage.StartsWith("/") && !categoryImage.StartsWith("http"))
                {
                    categoryImage = "/" + categoryImage;
                }
            }
            service.Images.Add(categoryImage);
        }

        // Ensure location strings have a fallback
        if (string.IsNullOrEmpty(service.GovernorateName)) service.GovernorateName = service.Location ?? "غير محدد";
        if (string.IsNullOrEmpty(service.CityName)) service.CityName = "غير محدد";
    }

    /// <summary>
    /// Smart similar services loader:
    /// 1. Same subCategory + same city
    /// 2. Same category + same city
    /// 3. Same subCategory + same governorate
    /// 4. Same category + same governorate
    /// 5. Latest services (fallback)
    /// </summary>
    private async Task<List<ServiceDto>> LoadSmartSimilarServicesAsync(ServiceDto current)
    {
        const int needed = 3;
        var results = new List<ServiceDto>();
        var excludeId = current.Id;

        // Helper: filter out current service and already-collected ids
        List<ServiceDto> Filter(IEnumerable<ServiceDto> items)
            => items.Where(s => s.Id != excludeId && results.All(r => r.Id != s.Id))
                    .Take(needed - results.Count)
                    .ToList();

        // --- Step 1: Same sub-category + same city ---
        if (current.SubCategoryId.HasValue && current.CityId.HasValue)
        {
            var r = await Api.GetServicesAsync(subCategoryId: current.SubCategoryId, cityId: current.CityId, pageSize: 10);
            results.AddRange(Filter(r.Items));
            if (results.Count >= needed)
            {
                similarServicesLabel = $"خدمات مشابهة في {current.CityName}";
                return results;
            }
        }

        // --- Step 2: Same category + same city ---
        if (current.CategoryId.HasValue && current.CityId.HasValue)
        {
            var r = await Api.GetServicesAsync(categoryId: current.CategoryId, cityId: current.CityId, pageSize: 10);
            results.AddRange(Filter(r.Items));
            if (results.Count >= needed)
            {
                similarServicesLabel = $"خدمات في نفس الفئة بـ {current.CityName}";
                return results;
            }
        }

        // --- Step 3: Same sub-category + same governorate ---
        if (current.SubCategoryId.HasValue && current.GovernorateId.HasValue)
        {
            var r = await Api.GetServicesAsync(subCategoryId: current.SubCategoryId, governorateId: current.GovernorateId, pageSize: 10);
            results.AddRange(Filter(r.Items));
            if (results.Count >= needed)
            {
                similarServicesLabel = $"خدمات مشابهة في محافظة {current.GovernorateName}";
                return results;
            }
        }

        // --- Step 4: Same category + same governorate ---
        if (current.CategoryId.HasValue && current.GovernorateId.HasValue)
        {
            var r = await Api.GetServicesAsync(categoryId: current.CategoryId, governorateId: current.GovernorateId, pageSize: 10);
            results.AddRange(Filter(r.Items));
            if (results.Count >= needed)
            {
                similarServicesLabel = $"خدمات في محافظة {current.GovernorateName}";
                return results;
            }
        }

        // --- Step 5: Fallback — latest services ---
        if (results.Count < needed)
        {
            var r = await Api.GetServicesAsync(pageSize: 10, sortBy: "latest");
            results.AddRange(Filter(r.Items));
            similarServicesLabel = "خدمات مقترحة لك";
        }

        return results.Take(needed).ToList();
    }

