    private string SharePageUrl
    {
        get
        {
            var uri = new Uri(Navigation.Uri);
            var host = uri.Host.ToLowerInvariant();
            if (host == "localhost" || host == "127.0.0.1" || host == "0.0.0.0" || State.IsNativeApp)
            {
                // Use the live site origin from AppShareUrl or current navigation
                var baseOrigin = !string.IsNullOrEmpty(State.AppShareUrl)
                    ? new Uri(State.AppShareUrl).GetLeftPart(UriPartial.Authority)
                    : Navigation.BaseUri.TrimEnd('/');
                try { baseOrigin = new Uri(baseOrigin).GetLeftPart(UriPartial.Authority); } catch { }
                return $"{baseOrigin}/share/service/{Id}";
            }
            return $"{uri.Scheme}://{uri.Authority}/share/service/{Id}";
        }
    }

