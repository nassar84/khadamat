    private async Task OpenShareModal()
    {
        showPlatformChoices = false;
        showShareModal = true;
        shareCopyStatus = null;
        shareCardImageUrl = null;
        isGeneratingCard = true;
        StateHasChanged();
        await Task.Delay(500);
        try
        {
            await JS.InvokeVoidAsync("generateQRCode", "service-share-card-qrcode", Navigation.Uri);
            await Task.Delay(300);

            // 1) Try server-side card generation (reliable, no html2canvas)
            var (success, imgUrl) = await Api.GenerateShareCardAsync(service?.Id ?? Id);
            if (success && !string.IsNullOrEmpty(imgUrl))
            {
                shareCardImageUrl = Api.GetAbsoluteUrl(imgUrl);
                StateHasChanged();
            }
            else
            {
                // 2) Fallback: client-side canvas capture and upload
                var uploaded = await JS.InvokeAsync<bool>("uploadShareCardImage", "service-share-card", SharePageUrl, service?.Id ?? Id, Api.BaseUrl);
                if (uploaded)
                {
                    shareCardImageUrl = $"{Api.BaseUrl.TrimEnd('/')}/images/share_cards/card_{service?.Id ?? Id}.png?v={DateTime.UtcNow.Ticks}";
                    StateHasChanged();
                }
                else
                {
                    var previewUrl = await JS.InvokeAsync<string?>("captureServiceCardAsImage", "service-share-card", SharePageUrl);
                    if (!string.IsNullOrEmpty(previewUrl))
                    {
                        shareCardImageUrl = previewUrl;
                        StateHasChanged();
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Share] Error rendering QR/Uploading card: {ex.Message}");
        }
        finally
        {
            isGeneratingCard = false;
            StateHasChanged();
        }
    }

