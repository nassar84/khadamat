        background: linear-gradient(180deg, rgba(99, 102, 241, 0.05) 0%, #ffffff 20%);
    }
    .share-logo-container {
        background: white;
        padding: 5px;
        border-radius: 12px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.05);
    }
    .share-brand div { line-height: 1; }
    .share-divider {
        height: 1px;
        background: #e2e8f0;
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
    }
    .share-cta {
        background: white;
        padding: 0 15px;
        font-size: 0.75rem;
        color: #64748b;
        font-weight: 700;
        position: absolute;
    }
    .qr-container { width: 110px; height: 110px; }

    /* Skeleton Loading System */
    .skeleton-box {
        background: #f1f5f9;
        overflow: hidden;
        position: relative;
        border-radius: 12px;
        animation: ghost-pulse 1.5s ease-in-out infinite;
    }

    .skeleton-box::after {
        content: '';
        position: absolute;
        top: 0;
        right: 0;
        bottom: 0;
        left: 0;
        background-image: linear-gradient(
            90deg, 
            rgba(255, 255, 255, 0) 0, 
            rgba(255, 255, 255, 0.4) 20%, 
            rgba(255, 255, 255, 0.6) 60%, 
            rgba(255, 255, 255, 0)
        );
        transform: translateX(-100%);
        animation: ghost-shimmer 2s infinite ease-in-out;
    }

    @@keyframes ghost-shimmer {
        100% {
            transform: translateX(100%);
        }
    }

    @@keyframes ghost-pulse {
        0%, 100% { background-color: #f1f5f9; }
        50% { background-color: #e2e8f0; }
    }
</style>

@code {
    [Parameter] public int Id { get; set; }
    
    private ServiceDto? service;
    private List<ServiceDto>? similarServices;
    private string activeTab = "details";
    private bool showRateModal = false;
    private int userRating = 0;
    private string userComment = "";
    private string mainImage => Khadamat.BlazorUI.Helpers.DefaultImages.GetServiceImage(service?.CategoryName, service?.Images?.FirstOrDefault());

    private string? selectedImage;
    private bool CanEdit = false;
    
    // Posts
    private string newPostContent = "";
    private bool isPostingPost = false;
    private bool showCreatePostBox = false;
    
    // Comments
    private int? expandedPostId = null;
    private string newCommentText = "";
    private bool isPostingComment = false;

    // Service Request
    private bool showRequestModal = false;
    private DateTime? requestPreferredDate;
    private string requestNotes = "";
    private bool isSubmittingRequest = false;
    private string? requestError;

    protected override void OnInitialized()
    {
        _ = LoadServiceDataAsync();
    }

    private async Task LoadServiceDataAsync()
    {
        try
        {
            service = await Api.GetServiceByIdAsync(Id);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"API Error in ServiceDetails: {ex.Message}");
        }

        if (service == null)
        {
            // Handle not found or error cases gracefully in production
            await InvokeAsync(StateHasChanged);
            return;
        }

        // Fetch similar services
        try
        {
            var similarResult = await Api.GetSimilarServicesAsync(Id, 4);
            similarServices = similarResult.Items;
        }
        catch { similarServices = new(); }

        // Only fill truly missing fields — never overwrite real API data
        EnsureRequiredFields();
        await InvokeAsync(StateHasChanged);

        // Auth check — non-blocking
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user.Identity?.IsAuthenticated == true)
            {
                IsAuthenticated = true;
                var profile = await AuthService.GetProfileAsync();
                if (profile?.Success == true)
                {
                    var myUserId = profile.Data?.Id;
                    CanEdit = user.IsInRole("Admin") ||
                              user.IsInRole("SystemAdmin") ||
                              (service?.UserId != null && service.UserId == myUserId);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Auth check error: {ex.Message}");
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }


    /// <summary>Only fills missing/empty fields — never overwrites real API data.</summary>
    private void EnsureRequiredFields()
    {
        if (service == null) return;

        // Lists must never be null
        service.Images  ??= new List<string>();
        service.Reviews ??= new List<ReviewDto>();
        service.Posts   ??= new List<PostDto>();

        // Add a placeholder image if none exist
        if (!service.Images.Any())
            service.Images.Add($"https://picsum.photos/seed/{service.Id}/800/600");

        // Ensure location strings have a fallback
        if (string.IsNullOrEmpty(service.GovernorateName)) service.GovernorateName = service.Location ?? "غير محدد";
        if (string.IsNullOrEmpty(service.CityName)) service.CityName = "غير محدد";
    }

    private void SetTab(string tab) => activeTab = tab;
    
    private void GoBack() => Navigation.NavigateTo("explore");

    private async Task ToggleFavorite()
    {
        if (service == null) return;
        // Optimistic update
        service.IsFavorite = !service.IsFavorite;
        StateHasChanged();
        try
        {
            await Api.ToggleFavoriteAsync(service.Id);
        }
        catch
        {
            // Revert on failure
            service.IsFavorite = !service.IsFavorite;
            StateHasChanged();
        }
    }

    private async Task ShareService()
    {
        try 
        {
            var fileName = $"Khadamat_Service_{service?.Id}";
            var shareUrl = Navigation.Uri;
            
            // Invoke the JS we added to index.html
            await JS.InvokeVoidAsync("shareServiceAsImage", "service-share-card", shareUrl, fileName);

            // Record the share for points
            await Api.RecordShareAsync("Service", Id);
        }
        catch (Exception ex)
        {
            // Fallback to simple link if complex share fails
            await DeviceShareService.ShareLinkAsync(Navigation.Uri, service?.Title ?? "خدمة");
            Console.WriteLine($"Advanced share failed: {ex.Message}");
        }
    }

    private async Task ContactWhatsApp()
    {
        var wp = service?.WhatsApp ?? "201000000000";
        await PhoneService.OpenWhatsAppChatAsync(wp, $"بخصوص خدمتك: {service?.Title}");
    }

    private async Task CallProvider()
    {
        if (!string.IsNullOrEmpty(service?.Phone1))
            await PhoneService.MakePhoneCallAsync(service.Phone1);
    }

    private async Task OpenMap()
    {
        if (service != null)
        {
            var loc = !string.IsNullOrEmpty(service.Location) ? service.Location : $"{service.CityName}, {service.GovernorateName}";
            await LocationService.OpenMapsNavigationAsync(0, 0, loc);
        }
    }

    private void JoinTelegram()
    {
        if (!string.IsNullOrEmpty(service?.Telegram))
            Navigation.NavigateTo(service.Telegram);
    }

    private void VisitFacebook()
    {
        if (!string.IsNullOrEmpty(service?.Facebook))
            Navigation.NavigateTo(service.Facebook);
    }

    private async Task SuggestToFriend()
    {
       await JS.InvokeVoidAsync("navigator.clipboard.writeText", Navigation.Uri);
       // Ideally show a toast here
    }

    private void OpenEdit(string section)
    {
        if (service != null)
        {
            Navigation.NavigateTo($"/provider/editservice/{service.Id}");
        }
    }
    
    private void AddImage() { /* Add Image */ }
    private void RemoveImage(string img) { /* Remove Image */ }
    
    // Posts Logic
    private async Task CreatePost()
    {
        if (string.IsNullOrWhiteSpace(newPostContent)) return;
        
        isPostingPost = true;
        try
        {
            var success = await Api.CreatePostAsync(new CreatePostRequest { Content = newPostContent, ImageUrl = null });
            if (success)
            {
                service?.Posts.Insert(0, new PostDto
                {
                    Content = newPostContent,
                    CreatedAt = DateTime.Now,
                    LikesCount = 0
                });
                newPostContent = "";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error creating post: {ex.Message}");
        }
        finally
        {
            isPostingPost = false;
        }
    }
    
    // Comments Logic
    private void ToggleComments(int postId)
    {
        expandedPostId = expandedPostId == postId ? null : postId;
    }
    
    private async Task AddComment(int postId)
    {
        if (string.IsNullOrWhiteSpace(newCommentText)) return;
        
        isPostingComment = true;
        try
        {
            var success = await Api.CreateCommentAsync(new CreateCommentRequest { PostId = postId, Text = newCommentText });
            if (success)
            {
                var post = service?.Posts.FirstOrDefault(p => p.Id == postId);
                if (post != null)
                {
                    post.Comments.Insert(0, new CommentDto
                    {
                        UserName = "أنت",
                        Text = newCommentText,
                        CreatedAt = DateTime.Now
                    });
                    post.CommentsCount = (post.CommentsCount ?? 0) + 1;
                }
                newCommentText = "";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error adding comment: {ex.Message}");
        }
        finally
        {
            isPostingComment = false;
        }
    }
    
    // Rating Logic
    private void OpenRateModal() => showRateModal = true;
    private async Task SubmitRating()
    {
        if (service == null) return;
        
        try 
        {
            var success = await Api.AddReviewAsync(service.Id, userRating, userComment);
            if (success)
            {
                service.Reviews.Insert(0, new ReviewDto 
                { 
                    UserName = "أنت", 
                    Rating = userRating, 
                    Comment = userComment, 
                    CreatedAt = DateTime.Now 
                });
                showRateModal = false;
                userComment = "";
                userRating = 0;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error submitting rating: {ex.Message}");
        }
    }

    private void ViewImage(string src)
    {
        selectedImage = src;
        StateHasChanged();
    }

    private void CloseLightbox()
    {
        selectedImage = null;
        StateHasChanged();
    }

    private string GetEmbedUrl(string url)
    {
        if (string.IsNullOrEmpty(url)) return "";
        if (url.Contains("youtube.com/watch?v="))
            return url.Replace("watch?v=", "embed/");
        if (url.Contains("youtu.be/"))
            return url.Replace("youtu.be/", "youtube.com/embed/");
        return url;
    }

    private void StartChat()
    {
        if (service?.UserId != null)
        {
            Navigation.NavigateTo($"/user/messages/{service.UserId}");
        }
    }

    private void OpenRequestModal()
    {
        requestError = null;
        requestNotes = "";
        requestPreferredDate = null;
        showRequestModal = true;
    }

    private async Task SubmitRequest()
    {
        if (service == null) return;

        isSubmittingRequest = true;
        requestError = null;

        try
        {
            var dto = new CreateServiceRequestDto
            {
                ServiceId = service.Id,
                Notes = requestNotes,
                PreferredDate = requestPreferredDate
            };

            var result = await Api.CreateRequestAsync(dto);
            
            if (result.Success)
            {
                showRequestModal = false;
                await JS.InvokeVoidAsync("alert", "تم إرسال طلبك بنجاح! يمكنك متابعة حالة الطلب من صفحة 'طلباتي'");
                Navigation.NavigateTo("/user/my-requests");
            }
            else
            {
                requestError = result.Message ?? "حدث خطأ أثناء إرسال الطلب";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error submitting request: {ex.Message}");
            requestError = "حدث خطأ غير متوقع. يرجى المحاولة مرة أخرى.";
        }
        finally
        {
            isSubmittingRequest = false;
        }
    }

    // --- Request Edit Logic ---
    private bool IsAuthenticated = false;
    private bool showRequestEditModal = false;
    private string editReason = "";
    private string? editProposedName;
    private string? editProposedPhone;
    private bool isSubmittingEditRequest = false;
    private string? editRequestError;

    private void OpenRequestEditModal()
    {
        editReason = "";
        editProposedName = "";
        editProposedPhone = "";
        editRequestError = null;
        showRequestEditModal = true;
    }

    private async Task SubmitEditRequest()
    {
        if (string.IsNullOrWhiteSpace(editReason))
        {
            editRequestError = "يرجى كتابة سبب التعديل";
            return;
        }

        isSubmittingEditRequest = true;
        editRequestError = null;

        try
        {
            var success = await Api.RequestServiceEditAsync(service.Id, new 
            {
                ServiceId = service.Id,
                Reason = editReason,
                ProposedName = editProposedName,
                ProposedPhone1 = editProposedPhone
            });

            if (success)
            {
                showRequestEditModal = false;
                await JS.InvokeVoidAsync("alert", "تم إرسال اقتراح التعديل بنجاح والمراجعة من قبل الإدارة");
            }
            else
            {
                editRequestError = "حدث خطأ أثناء الإرسال. تأكد من اتصالك.";
            }
        }
        catch (Exception ex)
        {
            editRequestError = "حدث خطأ. حاول مرة أخرى لاحقاً.";
        }
        finally
        {
            isSubmittingEditRequest = false;
        }
    }
}
