    private void OpenRateModal() => showRateModal = true;

    private async Task StartRating(int initialRating)
    {
        if (service == null) return;

        // Auth check
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated != true)
        {
            Navigation.NavigateTo($"/login?returnUrl=/service/{Id}");
            return;
        }

        // Self-rating guard — compare UserId from profile
        var profile = await AuthService.GetProfileAsync();
        if (profile?.Success == true)
        {
            var myId = profile.Data?.Id;
            if (service.UserId == myId)
            {
                await JS.InvokeVoidAsync("alert", "لا يمكنك تقييم خدمتك الخاصة.");
                return;
            }

            // Pre-fill if user already rated this service
            var existingReview = service.Reviews?.FirstOrDefault(r => r.UserId == myId);
            if (existingReview != null)
            {
                userRating  = existingReview.Rating;
                userComment = existingReview.Comment ?? "";
            }
            else
            {
                userRating  = initialRating > 0 ? initialRating : 0;
                userComment = "";
            }
        }
        else
        {
            userRating  = initialRating > 0 ? initialRating : 0;
            userComment = "";
        }

        ratingValidationMsg = null;
        showRateModal = true;
    }

    private async Task SubmitRating()
    {
        if (service == null) return;

        if (userRating < 1)
        {
            ratingValidationMsg = "يرجى اختيار تقييم بالنجوم (1 على الأقل)";
            return;
        }

        ratingValidationMsg  = null;
        isSubmittingRating   = true;

        try
        {
            var res = await Api.CreateReviewAsync(new CreateReviewRequest
            {
                ServiceId = service.Id,
                Rating    = userRating,
                Comment   = userComment
            });

            if (res.Success && res.Data != null)
            {
                var result = res.Data;

                // Get current user's id to identify existing review
                var authState = await AuthStateProvider.GetAuthenticationStateAsync();
                var profile   = await AuthService.GetProfileAsync();
                var myId      = profile?.Data?.Id;

                // Remove old review by this user (update scenario)
                if (!string.IsNullOrEmpty(myId))
                {
                    var existingIdx = service.Reviews.FindIndex(r => r.UserId == myId || r.UserName == result.ReviewerName);
                    if (existingIdx >= 0)
                        service.Reviews.RemoveAt(existingIdx);
                }

                // Insert updated/new review at top
                service.Reviews.Insert(0, new ReviewDto
                {
                    UserId    = myId,
                    UserName  = result.ReviewerName,
                    UserAvatar = result.ReviewerAvatar,
                    Rating    = userRating,
                    Comment   = userComment,
                    CreatedAt = DateTime.Now
                });

                // Update service aggregate rating
                service.Rating      = result.NewAverage;
                service.RatersCount = result.RatersCount;

                showRateModal = false;
                userComment   = "";
                userRating    = 0;

                // Show success toast
                showRatingSuccess = true;
                StateHasChanged();
                await Task.Delay(3000);
                showRatingSuccess = false;
            }
            else
            {
                ratingValidationMsg = res.Message ?? "حدث خطأ أثناء إرسال التقييم";
            }
        }
        catch (Exception ex)
        {
            ratingValidationMsg = "حدث خطأ غير متوقع. يرجى المحاولة مرة أخرى.";
            Console.WriteLine($"Error submitting rating: {ex.Message}");
        }
        finally
        {
            isSubmittingRating = false;
        }
    }

    private void ViewImage(string src)
    {
        selectedImage = src;
        StateHasChanged();
    }

    private void CloseLightbox()
    {
        selectedImage = null;
        StateHasChanged();
    }

    private string GetEmbedUrl(string url)
    {
        if (string.IsNullOrEmpty(url)) return "";
        if (url.Contains("youtube.com/watch?v="))
            return url.Replace("watch?v=", "embed/");
        if (url.Contains("youtu.be/"))
            return url.Replace("youtu.be/", "youtube.com/embed/");
        return url;
    }

    private void StartChat()
    {
        if (service?.UserId != null)
        {
            var name = Uri.EscapeDataString(service.ProviderName ?? "");
            var photo = Uri.EscapeDataString(service.ProviderPhoto ?? "");
            Navigation.NavigateTo($"/user/messages/{service.UserId}?name={name}&photo={photo}");
        }
    }

    private async Task OpenRequestModal()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated != true)
        {
            Navigation.NavigateTo($"/login?returnUrl=/service/{Id}");
            return;
        }

        requestError = null;
        requestNotes = "";
        requestPreferredDate = null;
        requestSubmittedSuccess = false;
        showRequestModal = true;
    }

    private void CloseRequestModal()
    {
        showRequestModal = false;
        requestSubmittedSuccess = false;
        requestError = null;
        requestNotes = "";
        requestPreferredDate = null;
    }

    private async Task SubmitRequest()
    {
        if (service == null) return;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated != true)
        {
            Navigation.NavigateTo($"/login?returnUrl=/service/{Id}");
            return;
        }

        isSubmittingRequest = true;
        requestError = null;

        try
        {
            var dto = new CreateServiceRequestDto
            {
                ServiceId = service.Id,
                Notes = requestNotes,
                PreferredDate = requestPreferredDate
            };

            var result = await Api.CreateRequestAsync(dto);
            
            if (result.Success)
            {
                requestSubmittedSuccess = true;
                _ = JS.InvokeVoidAsync("showAppToast", "تم إرسال طلبك بنجاح!", "success");
            }
            else
            {
                requestError = result.Message ?? "حدث خطأ أثناء إرسال الطلب";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error submitting request: {ex.Message}");
            requestError = "حدث خطأ غير متوقع. يرجى المحاولة مرة أخرى.";
        }
        finally
        {
            isSubmittingRequest = false;
        }
    }

    // --- Request Edit Logic ---
    private bool IsAuthenticated = false;
    private bool showRequestEditModal = false;
    private string editReason = "";
    private List<FieldEdit> fieldEdits = new() { new FieldEdit() };
    private bool isSubmittingEditRequest = false;
    private string? editRequestError;

    public class FieldEdit 
    { 
        public string FieldName { get; set; } = ""; 
        public string ProposedValue { get; set; } = ""; 
    }

    private void AddFieldEdit() => fieldEdits.Add(new FieldEdit());
    private void RemoveFieldEdit(FieldEdit edit) => fieldEdits.Remove(edit);

    private void OpenRequestEditModal()
    {
        if (!IsAuthenticated)
        {
            _ = JS.InvokeVoidAsync("alert", "يرجى تسجيل الدخول أولاً لتتمكن من اقتراح تعديل البيانات.");
            Navigation.NavigateTo("/login?returnUrl=" + Uri.EscapeDataString(Navigation.Uri));
            return;
        }
        editReason = "";
        fieldEdits = new() { new FieldEdit() };
        editRequestError = null;
        showRequestEditModal = true;
    }

    private async Task SubmitEditRequest()
    {
        if (string.IsNullOrWhiteSpace(editReason))
        {
            editRequestError = "يرجى كتابة سبب التعديل";
            return;
        }

        isSubmittingEditRequest = true;
        editRequestError = null;

        try
        {
            if (service == null) return;

            // Map dynamic edits to specific fields if they match, or add to reason
            string? proposedName = fieldEdits.FirstOrDefault(e => e.FieldName == "الاسم" || e.FieldName.ToLower() == "name")?.ProposedValue;
            string? proposedPhone = fieldEdits.FirstOrDefault(e => e.FieldName == "الهاتف" || e.FieldName.ToLower() == "phone")?.ProposedValue;
            string? proposedPrice = fieldEdits.FirstOrDefault(e => e.FieldName == "السعر" || e.FieldName.ToLower() == "price")?.ProposedValue;
            string? proposedAddress = fieldEdits.FirstOrDefault(e => e.FieldName == "العنوان" || e.FieldName.ToLower() == "address")?.ProposedValue;
            string? proposedDesc = fieldEdits.FirstOrDefault(e => e.FieldName == "الوصف" || e.FieldName.ToLower() == "description")?.ProposedValue;
            string? proposedPhone2 = fieldEdits.FirstOrDefault(e => e.FieldName == "الهاتف الثاني" || e.FieldName == "هاتف 2" || e.FieldName.ToLower() == "phone 2" || e.FieldName.ToLower() == "phone2")?.ProposedValue;
            string? proposedWhatsApp = fieldEdits.FirstOrDefault(e => e.FieldName == "واتساب" || e.FieldName == "الواتساب" || e.FieldName == "واتس" || e.FieldName.ToLower() == "whatsapp")?.ProposedValue;

            // Build full reason including other edits
            var fullReason = editReason;
            var otherEdits = fieldEdits.Where(e => 
                e.FieldName != "الاسم" && e.FieldName.ToLower() != "name" &&
                e.FieldName != "الهاتف" && e.FieldName.ToLower() != "phone" &&
                e.FieldName != "السعر" && e.FieldName.ToLower() != "price" &&
                e.FieldName != "العنوان" && e.FieldName.ToLower() != "address" &&
                e.FieldName != "الوصف" && e.FieldName.ToLower() != "description" &&
                e.FieldName != "الهاتف الثاني" && e.FieldName != "هاتف 2" && e.FieldName.ToLower() != "phone 2" && e.FieldName.ToLower() != "phone2" &&
                e.FieldName != "واتساب" && e.FieldName != "الواتساب" && e.FieldName != "واتس" && e.FieldName.ToLower() != "whatsapp" &&
                !string.IsNullOrWhiteSpace(e.FieldName));

            if (otherEdits.Any())
            {
                fullReason += "\nتعديلات إضافية:\n" + string.Join("\n", otherEdits.Select(e => $"- {e.FieldName}: {e.ProposedValue}"));
            }

            decimal? priceVal = null;
            if (decimal.TryParse(proposedPrice, out var p)) priceVal = p;

            var success = await Api.RequestServiceEditAsync(service.Id, new 
            {
                ServiceId = service.Id,
                Reason = fullReason,
                ProposedName = proposedName,
                ProposedPhone1 = proposedPhone,
                ProposedDescription = proposedDesc,
                ProposedAddress = proposedAddress,
                ProposedPrice = priceVal,
                ProposedPhone2 = proposedPhone2,
                ProposedWhatsApp = proposedWhatsApp
            });

            if (success)
            {
                showRequestEditModal = false;
                await JS.InvokeVoidAsync("alert", "تم إرسال اقتراح التعديل بنجاح والمراجعة من قبل الإدارة");
            }
            else
            {
                editRequestError = "حدث خطأ أثناء الإرسال. تأكد من اتصالك.";
            }
        }
        catch (Exception ex)
        {
            editRequestError = "حدث خطأ. حاول مرة أخرى لاحقاً.";
        }
        finally
        {
            isSubmittingEditRequest = false;
        }
    }
}


