        isCapturingCard = true;
        StateHasChanged();
        try
        {
            var fileName = $"Khadamat_Service_{service?.Id}";
            var addressDetail = GetCardDetailedAddress();
            var addressLine = !string.IsNullOrEmpty(addressDetail) ? $"\n📍 العنوان بالتفصيل: {addressDetail}" : "";
            var fbLine = !string.IsNullOrWhiteSpace(service?.Facebook) ? $"\n🌐 صفحة فيسبوك: {GetFacebookUrl(service.Facebook)}" : "";
            var shareText = $"🌟 شاهد هذه الخدمة المميزة على منصة خدماوي:\n*{service?.Title}*\n🔗 رابط الخدمة والتفاصيل:\n{SharePageUrl}\n\n📝 {service?.Description}{addressLine}{fbLine}\n\n📲 حمّل تطبيق خدماوي مجاناً للأندرويد:\n{(string.IsNullOrEmpty(State.GooglePlayUrl) ? State.AppShareUrl : State.GooglePlayUrl)}";
            
            // Ensure card image is ready
            var imageUrl = shareCardImageUrl;
            if (string.IsNullOrEmpty(imageUrl))
            {
                var (success, imgUrl) = await Api.GenerateShareCardAsync(service?.Id ?? Id);
                if (success && !string.IsNullOrEmpty(imgUrl))
                {
                    imageUrl = Api.GetAbsoluteUrl(imgUrl);
                    shareCardImageUrl = imageUrl;
                }
            }
            if (string.IsNullOrEmpty(imageUrl))
            {
                imageUrl = GetBestServiceImageUrl();
            }

            try
            {
                await JS.InvokeVoidAsync("shareCardWithPlatform", "service-share-card", SharePageUrl, fileName, shareText, imageUrl);
            }
            catch
            {
                try
                {
                    await JS.InvokeVoidAsync("window._showShareOptions", imageUrl, SharePageUrl, shareText, fileName);
                }
                catch (Exception jsEx)
                {
                    Console.WriteLine($"[Share] _showShareOptions also failed: {jsEx.Message}");
                }
            }
            _ = Api.RecordShareAsync("Service", Id);
            showShareModal = false;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Share] Direct share failed: {ex.Message}");
        }
        finally
        {
            isCapturingCard = false;
            StateHasChanged();
        }
    }

    private string GetWhatsAppDirectUrl(string? rawNumber)
    {
        if (string.IsNullOrWhiteSpace(rawNumber)) return "#";
        var digits = new string(rawNumber.Where(char.IsDigit).ToArray());
        if (digits.StartsWith("01") && digits.Length == 11) digits = "2" + digits;
        var msg = Uri.EscapeDataString($"مرحباً، بخصوص خدمتك على منصة خدماوي ({service?.Title})");
        return $"https://wa.me/{digits}?text={msg}";
    }

    private string GetTelegramUrl(string? rawTelegram)
    {
        if (string.IsNullOrWhiteSpace(rawTelegram)) return "#";
        var clean = rawTelegram.Trim();
        if (clean.StartsWith("http://", StringComparison.OrdinalIgnoreCase) || clean.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
            return clean;
        var user = clean.TrimStart('@').Trim();
        return $"https://t.me/{user}";
    }

    private string GetFacebookUrl(string? rawFacebook)
    {
        if (string.IsNullOrWhiteSpace(rawFacebook)) return "#";
        var clean = rawFacebook.Trim();
        if (clean.StartsWith("http://", StringComparison.OrdinalIgnoreCase) || clean.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
            return clean;
        return $"https://facebook.com/{clean}";
    }

    private string GetYouTubeUrl(string? rawYoutube)
    {
        if (string.IsNullOrWhiteSpace(rawYoutube)) return "#";
        var clean = rawYoutube.Trim();
        if (clean.StartsWith("http://", StringComparison.OrdinalIgnoreCase) || clean.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
            return clean;
        return $"https://youtube.com/{clean}";
    }

