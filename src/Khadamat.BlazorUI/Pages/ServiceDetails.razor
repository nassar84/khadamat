                    <div id="service-share-card" class="share-capture-card" style="width: 600px; min-width: 600px; max-width: 600px; height: 315px; min-height: 315px; max-height: 315px; overflow: hidden; background: white; display: flex; flex-direction: column; border-radius: 0; font-family: Tajawal, Arial, sans-serif; box-sizing: border-box;">
                        
                        <!-- TOP: Main content row (Height 255px) -->
                        <div style="display: flex; flex-direction: row; direction: rtl; height: 255px; max-height: 255px; width: 600px; overflow: hidden; box-sizing: border-box;">
                            
                            <!-- RIGHT: Service Image Panel (Width 220px) -->
                            <div style="width: 220px; min-width: 220px; max-width: 220px; height: 255px; overflow: hidden; position: relative; background: #0f172a; box-sizing: border-box;">
                                <!-- Blurred Background -->
                                <img src="@Api.GetAbsoluteUrl(mainImage)"
                                     crossorigin="anonymous"
                                     onerror="this.onerror=null;this.src='/images/logo.png';"
                                     style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; filter: blur(16px); opacity: 0.55; transform: scale(1.15);" />
                                <!-- Gradient Overlay -->
                                <div style="position: absolute; inset: 0; background: linear-gradient(135deg, rgba(0,0,0,0.2) 0%, rgba(0,0,0,0.5) 100%);"></div>
