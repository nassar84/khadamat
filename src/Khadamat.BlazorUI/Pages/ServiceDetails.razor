@page "/service/{Id:int}"
@using Khadamat.Application.DTOs
@using Khadamat.BlazorUI.Services
@using Khadamat.BlazorUI.Services.Auth
@using Microsoft.AspNetCore.Components.Authorization
@inject ApiClient Api
@inject Khadamat.BlazorUI.State.AppState State
@inject IAuthService AuthService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject Khadamat.Shared.Interfaces.IShareService DeviceShareService
@inject Khadamat.Shared.Interfaces.IPhoneService PhoneService
@inject Khadamat.Shared.Interfaces.ILocationService LocationService

<div class="service-v3-container">
    @if (service == null)
    {
        <div class="container py-4">
            <!-- Top Actions Skeleton -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="btn-glass-dark skeleton-box" style="width: 45px;"></div>
                <div class="btn-glass-dark skeleton-box" style="width: 45px;"></div>
            </div>

            <div class="row g-4 mb-5">
                <div class="col-12 col-md-5">
                    <!-- Image Skeleton -->
                    <div class="main-image-v3 rounded-5 overflow-hidden shadow-lg position-relative mb-4 skeleton-box"></div>
                    <!-- Stats Skeleton -->
                    <div class="stats-box-v3 p-4 rounded-5 shadow-sm border bg-white mb-4 skeleton-box" style="height: 120px;"></div>
                    <div class="skeleton-box rounded-pill mt-auto" style="height: 50px; width: 100%;"></div>
                </div>
                <div class="col-12 col-md-7">
                    <!-- Details Skeleton -->
                    <div class="details-content-v3 ps-md-3">
                        <div class="skeleton-box mb-2 rounded-pill" style="height: 25px; width: 30%;"></div>
                        <div class="skeleton-box mb-4" style="height: 40px; width: 70%;"></div>
                        <div class="skeleton-box mb-4" style="height: 20px; width: 100%;"></div>
                        <div class="skeleton-box mb-4" style="height: 20px; width: 80%;"></div>
                        
                        <!-- Provider Skeleton -->
                        <div class="provider-strip mb-4 skeleton-box" style="height: 70px;"></div>
                        
                        <!-- Grid Skeleton -->
                        <div class="info-grid-v3 mb-4">
                            <div class="skeleton-box" style="height: 60px;"></div>
                            <div class="skeleton-box" style="height: 60px;"></div>
                            <div class="skeleton-box" style="height: 60px;"></div>
                            <div class="skeleton-box" style="height: 60px;"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="container py-4">
            <!-- Top Actions -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <button class="btn btn-glass-dark" @onclick="GoBack">
                    <i class="fa-solid fa-arrow-right"></i>
                </button>
                <div class="d-flex gap-2">
                    @if (CanEdit)
                    {
                        <button class="btn btn-glass-dark text-warning" @onclick='() => OpenEdit("main")'>
                            <i class="fa-solid fa-pen"></i>
                        </button>
                    }
                    else if (IsAuthenticated)
                    {
                        <button class="btn btn-glass-dark text-info" title="اطلب تعديل بيانات" @onclick="OpenRequestEditModal">
                            <i class="fa-solid fa-code-pull-request"></i>
                        </button>
                    }
                    <button class="btn btn-glass-dark @(service.IsFavorite ? "text-danger" : "")" @onclick="ToggleFavorite">
                        <i class="@(service.IsFavorite ? "fa-solid" : "fa-regular") fa-heart"></i>
                    </button>
                </div>
            </div>

            <!-- Main Info Row -->
            <div class="row g-4 mb-5">
                <!-- Physycal Right (Start in RTL): Image & Stats -->
                <div class="col-12 col-md-5">
                    <div class="main-image-v3 rounded-5 overflow-hidden shadow-lg position-relative mb-4">
                        <img src="@mainImage" class="w-100 h-100 object-fit-cover" alt="@service.Title" />
                        
                        <!-- Favorite Button Overlay -->
                        <div class="position-absolute top-0 start-0 m-3 z-3">
                            <button class="btn btn-glass-dark @(service.IsFavorite ? "text-danger" : "") shadow" @onclick="ToggleFavorite">
                                <i class="@(service.IsFavorite ? "fa-solid" : "fa-regular") fa-heart"></i>
                            </button>
                        </div>

                        @if (service.Images != null && service.Images.Count > 1)
                        {
                            <div class="gallery-preview-mini">
                                @foreach (var img in service.Images.Take(3))
                                {
                                    <img src="@img" class="mini-img @(img == selectedImage ? "active" : "")" @onclick="() => selectedImage = img" />
                                }
                                @if (service.Images.Count > 3)
                                {
                                    <div class="more-imgs" @onclick='() => selectedImage = service.Images.Skip(3).FirstOrDefault()'>+@(service.Images.Count - 3)</div>
                                }
                            </div>
                        }
                    </div>

                    <!-- Stats Box moved here (Below Image) -->
                    <div class="stats-box-v3 p-4 rounded-5 shadow-sm border bg-white mb-4">
                        <div class="row g-2 align-items-center text-center">
                            <div class="col-4 border-start">
                                <div class="x-small text-muted">السعر</div>
                                <div class="fw-900 fs-5 text-gradient">@service.Price?.ToString("N0") ج.م</div>
                            </div>
                            <div class="col-4 border-start">
                                <div class="x-small text-muted">التقييم</div>
                                <div class="fw-900 fs-5">
                                    @service.Rating.ToString("0.1") <i class="fa-solid fa-star text-warning small"></i>
                                    <span class="raters-count-v3 d-block">(@service.RatersCount تقييم)</span>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="x-small text-muted">إعجاب</div>
                                <div class="fw-900 fs-5 text-danger">
                                     <i class="fa-solid fa-heart"></i> @(new Random(service.Id).Next(10, 100))
                                </div>
                            </div>
                        </div>
                        <hr class="my-3 opacity-10" />
                        <div class="d-flex justify-content-between x-small text-muted px-2">
                            <span><i class="fa-solid fa-eye me-1"></i> @service.ViewsCount مشاهدة</span>
                            <span><i class="fa-solid fa-calendar-alt me-1"></i> منذ @service.CreatedAt.ToString("yyyy/MM/dd")</span>
                        </div>
                    </div>

                    <div class="contact-actions-v3 d-flex flex-column gap-2 mt-auto">
                        <button class="btn btn-request-main w-100 py-3 shadow-lg" @onclick="OpenRequestModal">
                            <i class="fa-solid fa-calendar-check fs-4"></i> طلب الخدمة الآن
                        </button>
                        
                        @if (!string.IsNullOrEmpty(service.YouTubeUrl))
                        {
                            <a href="@service.YouTubeUrl" target="_blank" class="btn btn-outline-danger w-100 rounded-4 py-2 mt-1">
                                <i class="fa-brands fa-youtube me-1"></i> مشاهدة العرض المرئي
                            </a>
                        }
                    </div>
                </div>

                <!-- Physycal Left (End in RTL): Details -->
                <div class="col-12 col-md-7">
                    <div class="details-content-v3 ps-md-3">
                        <div class="d-flex flex-wrap gap-2 mb-2">
                            <span class="category-tag">@service.MainCategoryName</span>
                            <span class="category-tag bg-indigo-light text-indigo">@service.CategoryName</span>
                            @if (!string.IsNullOrEmpty(service.SubCategoryName))
                            {
                                <span class="category-tag bg-purple-light text-purple">@service.SubCategoryName</span>
                            }
                        </div>
                        <h1 class="fw-900 mb-2 display-5">@service.Title</h1>
                        
                        <!-- Description below title -->
                        <div class="service-description-v3 mb-4">
                            <p class="text-muted fs-5 leading-relaxed">@service.Description</p>
                        </div>

                        <div class="provider-strip mb-4" @onclick='() => Navigation.NavigateTo("/provider/profile")'>
                            <img src="@Khadamat.BlazorUI.Helpers.DefaultImages.GetUserAvatar(service.ProviderName, null, service.ProviderPhoto)" class="provider-avatar" />
                            <div class="ms-3">
                                <div class="fw-bold fs-5">@service.ProviderName</div>
                                <div class="text-primary small"><i class="fa-solid fa-circle-check"></i> مقدم خدمة موثوق</div>
                            </div>
                        </div>

                        <div class="info-grid-v3 mb-4">
                            <!-- Location: Governorate & City -->
                            <div class="info-item-v3">
                                <i class="fa-solid fa-location-dot text-danger"></i>
                                <div>
                                    <div class="fw-bold">الموقع</div>
                                    <div class="small">@service.GovernorateName - @service.CityName</div>
                                    <div class="x-small text-muted">@service.Address</div>
                                </div>
                            </div>

                            <!-- Appointments -->
                            <div class="info-item-v3">
                                <i class="fa-solid fa-clock text-primary"></i>
                                <div>
                                    <div class="fw-bold">المواعيد</div>
                                    <div class="small">@(string.IsNullOrEmpty(service.WorkDays) ? "متاح يومياً" : service.WorkDays)</div>
                                    <div class="small text-muted">@service.WorkHours</div>
                                </div>
                            </div>

                            <!-- Contact Numbers -->
                            <div class="info-item-v3">
                                <i class="fa-solid fa-phone text-success"></i>
                                <div>
                                    <div class="fw-bold">أرقام التواصل</div>
                                    <div class="small">@service.Phone1</div>
                                    @if (!string.IsNullOrEmpty(service.Phone2))
                                    {
                                        <div class="small">@service.Phone2</div>
                                    }
                                </div>
                            </div>

                            <!-- Social Links -->
                            <div class="info-item-v3">
                                <i class="fa-solid fa-share-nodes text-primary"></i>
                                <div>
                                    <div class="fw-bold">روابط التواصل</div>
                                    <div class="d-flex gap-3 mt-1 social-links-v3">
                                        @if (!string.IsNullOrEmpty(service.WhatsApp))
                                        {
                                            <a href="https://wa.me/@service.WhatsApp" target="_blank" title="واتساب" class="social-icon-btn whatsapp"><i class="fa-brands fa-whatsapp"></i></a>
                                        }
                                        @if (!string.IsNullOrEmpty(service.Telegram))
                                        {
                                            <a href="@service.Telegram" target="_blank" title="تليجرام" class="social-icon-btn telegram"><i class="fa-brands fa-telegram"></i></a>
                                        }
                                        @if (!string.IsNullOrEmpty(service.Facebook))
                                        {
                                            <a href="@service.Facebook" target="_blank" title="فيسبوك" class="social-icon-btn facebook"><i class="fa-brands fa-facebook"></i></a>
                                        }
                                        <button class="social-icon-btn share" @onclick="ShareService" title="مشاركة"><i class="fa-solid fa-share-alt"></i></button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="action-buttons-v3 d-flex gap-2 mb-4">
                            @if (!string.IsNullOrEmpty(service.WhatsApp))
                            {
                                <button class="btn btn-whatsapp flex-grow-1" @onclick="ContactWhatsApp">
                                    <i class="fa-brands fa-whatsapp me-1"></i> واتساب
                                </button>
                            }
                            <button class="btn btn-call flex-grow-1" @onclick="CallProvider">
                                <i class="fa-solid fa-phone me-1"></i> اتصال
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Posts Section -->
            <div class="mb-5 pt-4 border-top">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4 class="fw-900 mb-0 border-right-styled pe-3">أحدث المنشورات</h4>
                    @if (CanEdit)
                    {
                        <button class="btn btn-primary btn-sm rounded-pill px-3" @onclick="() => showCreatePostBox = !showCreatePostBox">
                            <i class="fa-solid @(showCreatePostBox ? "fa-xmark" : "fa-plus") me-1"></i>
                            @(showCreatePostBox ? "إلغاء" : "منشور جديد")
                        </button>
                    }
                </div>

                @if (CanEdit && showCreatePostBox)
                {
                    <div class="glass-card-v3 p-4 mb-4 animate-pop">
                        <label class="form-label fw-bold small">اكتب منشوراً جديداً لعملائك</label>
                        <textarea @bind="newPostContent" class="form-control border-light mb-3" rows="3" placeholder="أخبر عملائك عن تخفيضاتك أو أعمالك الجديدة..."></textarea>
                        <div class="d-flex justify-content-end">
                            <button class="btn btn-primary rounded-pill px-4" @onclick="CreatePost" disabled="@isPostingPost">
                                @if (isPostingPost)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                <i class="fa-solid fa-paper-plane me-1"></i> نشر الآن
                            </button>
                        </div>
                    </div>
                }

                @if (service.Posts.Any())
                {
                    <div class="row g-4">
                        @foreach (var post in service.Posts)
                        {
                            <div class="col-12 col-lg-6">
                                <div class="glass-card-v3 p-4 h-100">
                                    <div class="d-flex align-items-center gap-2 mb-3">
                                        <img src="@Khadamat.BlazorUI.Helpers.DefaultImages.GetUserAvatar(service.ProviderName, null, service.ProviderPhoto)" class="rounded-circle" width="35" />
                                        <div class="x-small fw-bold">@service.ProviderName</div>
                                        <div class="ms-auto x-small text-muted">@post.CreatedAt.ToString("dd/MM")</div>
                                    </div>
                                    <p class="mb-3 small">@post.Content</p>
                                    @if (!string.IsNullOrEmpty(post.ImageUrl))
                                    {
                                        <img src="@post.ImageUrl" class="w-100 rounded-4 mb-3" />
                                    }
                                    <div class="d-flex gap-3 pt-3 border-top x-small">
                                        <span><i class="fa-regular fa-heart"></i> @post.LikesCount</span>
                                        <span class="cursor-pointer" @onclick="() => ToggleComments(post.Id)">
                                            <i class="fa-regular fa-comment"></i> @(post.CommentsCount ?? 0) تعليقات
                                        </span>
                                    </div>

                                    @if (expandedPostId == post.Id)
                                    {
                                        <div class="comments-section mt-3 pt-3 border-top animate-fade-in">
                                            @if (post.Comments != null && post.Comments.Any())
                                            {
                                                <div class="comments-list mb-3">
                                                    @foreach (var comment in post.Comments)
                                                    {
                                                        <div class="comment-item mb-2 p-2 rounded-3 bg-light">
                                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                                <span class="fw-bold x-small">@comment.UserName</span>
                                                                <span class="text-muted xx-small">@comment.CreatedAt.ToString("MM/dd HH:mm")</span>
                                                            </div>
                                                            <div class="small">@comment.Text</div>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="text-center text-muted x-small py-2">لا توجد تعليقات بعد</div>
                                            }

                                            <div class="add-comment-box d-flex gap-2">
                                                <input type="text" @bind="newCommentText" class="form-control form-control-sm rounded-pill" placeholder="أضف تعليقاً..." />
                                                <button class="btn btn-primary btn-sm rounded-circle" @onclick="() => AddComment(post.Id)" disabled="@isPostingComment">
                                                    <i class="fa-solid fa-paper-plane"></i>
                                                </button>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-5 bg-white rounded-5 border border-dashed">
                        <div class="mb-3 opacity-25"><i class="fa-solid fa-newspaper fs-1"></i></div>
                        <div class="text-muted">لا توجد منشورات حالياً</div>
                    </div>
                }
            </div>

            <!-- Similar Services -->
            <div class="mb-5 pt-4 border-top">
                <h4 class="fw-900 mb-4 border-right-styled pe-3">خدمات مشابهة قد تهمك</h4>
                @if (similarServices == null)
                {
                    <div class="d-flex justify-content-center py-4">
                        <div class="spinner-border text-primary spinner-border-sm"></div>
                    </div>
                }
                else if (!similarServices.Any())
                {
                    <p class="text-muted small text-center">لا توجد خدمات مشابهة في الوقت الحالي</p>
                }
                else
                {
                    <div class="row g-3">
                        @foreach (var s in similarServices)
                        {
                            <div class="col-6 col-md-3">
                                <div class="glass-card-v3 p-0 overflow-hidden h-100 cursor-pointer" @onclick='() => Navigation.NavigateTo($"/service/{s.Id}")'>
                                    <img src="@Khadamat.BlazorUI.Helpers.DefaultImages.GetServiceImage(s.CategoryName, s.Images.FirstOrDefault())" class="w-100 aspect-square object-fit-cover" />
                                    <div class="p-2">
                                        <div class="fw-bold x-small text-truncate">@s.Title</div>
                                        <div class="text-primary fw-bold xx-small">@s.Price?.ToString("N0") ج.م</div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Reviews List -->
            <div class="mb-5">
                <h4 class="fw-900 mb-4 border-right-styled pe-3">تقييمات العملاء</h4>
                <div class="row g-4">
                    @foreach (var review in service.Reviews)
                    {
                        <div class="col-12 col-md-6">
                            <div class="glass-card-v3 p-4">
                                <div class="d-flex justify-content-between mb-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <img src="@Khadamat.BlazorUI.Helpers.DefaultImages.GetUserAvatar(review.UserName, null, review.UserAvatar)" class="rounded-circle" width="35" />
                                        <div class="fw-bold small">@review.UserName</div>
                                    </div>
                                    <div class="text-warning x-small">
                                        @for(int i=1; i<=5; i++) {
                                            <i class="@(i <= review.Rating ? "fa-solid" : "fa-regular") fa-star"></i>
                                        }
                                    </div>
                                </div>
                                <p class="text-muted small mb-0">@review.Comment</p>
                            </div>
                        </div>
                    }
                </div>
                <div class="text-center mt-4">
                    <button class="btn btn-outline-primary rounded-pill px-5" @onclick="OpenRateModal">أضف تقييمك الخاص</button>
                </div>
            </div>
        </div>
    }
</div>

<!-- Hidden Share Card for Social Media Captures -->
<div id="service-share-card" class="share-capture-card" style="display: none;">
    <div class="share-card-content p-4 text-center">
        <!-- Logo Header -->
        <div class="d-flex align-items-center justify-content-center mb-3">
            <div class="share-logo-container me-2">
                <img src="/favicon.png" width="40" height="40" alt="Logo" />
            </div>
            <div class="share-brand">
                <div class="fw-900 fs-4 text-primary">@State.AppName</div>
                <div class="x-small text-muted">@($"{State.AppName}.com")</div>
            </div>
        </div>

        <!-- Service Image -->
        <div class="share-main-img-container mb-3">
            <img src="@mainImage" class="w-100 rounded-4 shadow-sm" style="max-height: 250px; object-fit: cover;" />
        </div>

        <!-- Service Info -->
        <div class="share-service-title fw-900 fs-3 mb-2">@service?.Title</div>
        <div class="share-service-price fs-4 text-success fw-bold mb-3">@service?.Price?.ToString("N0") ج.م</div>
        
        <p class="share-description text-muted small px-3 mb-4">
            @((service?.Description?.Length > 150) ? service.Description.Substring(0, 147) + "..." : service?.Description)
        </p>

        <!-- Divider with CTA -->
        <div class="share-divider mb-4">
            <span class="share-cta">امسح الكود لمعرفة التفاصيل والطلب</span>
        </div>

        <!-- QR and App Promo -->
        <div class="d-flex justify-content-between align-items-center bg-light p-3 rounded-4">
            <div id="service-share-card-qrcode" class="qr-container shadow-sm border rounded-3 p-1 bg-white"></div>
            <div class="text-end ms-3">
                <div class="fw-bold small mb-1">متوفر الآن للتطبيق والموقع</div>
                <div class="badges-mini d-flex gap-1 justify-content-end">
                    <i class="fa-brands fa-google-play text-muted"></i>
                    <i class="fa-brands fa-apple text-muted"></i>
                </div>
            </div>
        </div>
        
        <div class="mt-4 x-small text-primary opacity-50">@State.AppName &copy; 2026 - منصة جميع الخدمات في مكان واحد</div>
    </div>
</div>

<!-- Simple Modals (rendered as overlays for now) -->
@if (showRateModal)
{
    <div class="modal-overlay">
        <div class="glass-card p-4 rounded-4 w-75 animate-pop">
            <h5 class="fw-bold text-center mb-3">قيم تجربتك</h5>
            <div class="d-flex justify-content-center gap-2 mb-3">
                @for (int i = 1; i <= 5; i++)
                {
                    int rating = i;
                    <i class="@(userRating >= rating ? "fa-solid text-warning" : "fa-regular text-muted") fa-star fs-2 cursor-pointer" 
                       @onclick="() => userRating = rating"></i>
                }
            </div>
            <textarea @bind="userComment" class="form-control mb-3" rows="3" placeholder="اكتب تعليقك هنا..."></textarea>
            <div class="d-flex gap-2">
                <button class="btn btn-primary flex-grow-1 rounded-pill" @onclick="SubmitRating">إرسال</button>
                <button class="btn btn-light flex-grow-1 rounded-pill" @onclick="() => showRateModal = false">إلغاء</button>
            </div>
        </div>
    </div>
}

<!-- Request Service Modal -->
@if (showRequestModal)
{
    <div class="modal-overlay">
        <div class="glass-card p-4 rounded-4 animate-pop" style="max-width: 500px; width: 90%;">
            <h5 class="fw-bold text-center mb-3">طلب الخدمة</h5>
            <p class="text-muted small text-center mb-4">@service?.Title</p>
            
            <div class="mb-3">
                <label class="form-label fw-bold small">التاريخ المفضل (اختياري)</label>
                <input type="date" @bind="requestPreferredDate" class="form-control" min="@DateTime.Now.ToString("yyyy-MM-dd")" />
            </div>
            
            <div class="mb-3">
                <label class="form-label fw-bold small">ملاحظات إضافية (اختياري)</label>
                <textarea @bind="requestNotes" class="form-control" rows="3" placeholder="أي تفاصيل إضافية تود إخبار مقدم الخدمة بها..."></textarea>
            </div>
            
            <div class="d-flex gap-2">
                <button class="btn btn-success flex-grow-1 rounded-pill" @onclick="SubmitRequest" disabled="@isSubmittingRequest">
                    @if (isSubmittingRequest)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    إرسال الطلب
                </button>
                <button class="btn btn-light flex-grow-1 rounded-pill" @onclick="() => showRequestModal = false" disabled="@isSubmittingRequest">إلغاء</button>
            </div>
            
            @if (!string.IsNullOrEmpty(requestError))
            {
                <div class="alert alert-danger mt-3 mb-0 small">@requestError</div>
            }
        </div>
    </div>
}

<!-- Request Edit Service Modal -->
@if (showRequestEditModal)
{
    <div class="modal-overlay">
        <div class="glass-card p-4 rounded-4 animate-pop" style="max-width: 500px; width: 90%; max-height: 90vh; overflow-y: auto;">
            <h5 class="fw-bold text-center mb-3">اقتراح تعديل بيانات</h5>
            <p class="text-muted small text-center mb-4">@service?.Title</p>
            
            <div class="mb-3">
                <label class="form-label fw-bold small">سبب التعديل <span class="text-danger">*</span></label>
                <textarea @bind="editReason" class="form-control" rows="2" placeholder="مثال: رقم الهاتف تغير، السعر خطأ..."></textarea>
            </div>
            
            <div class="mb-3">
                <label class="form-label fw-bold small">الاسم المقترح (اختياري)</label>
                <input type="text" @bind="editProposedName" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold small">رقم التواصل المقترح (اختياري)</label>
                <input type="text" @bind="editProposedPhone" class="form-control" />
            </div>

            <div class="d-flex gap-2 mt-4">
                <button class="btn btn-info flex-grow-1 rounded-pill text-white" @onclick="SubmitEditRequest" disabled="@isSubmittingEditRequest">
                    @if (isSubmittingEditRequest)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    إرسال الاقتراح
                </button>
                <button class="btn btn-light flex-grow-1 rounded-pill" @onclick="() => showRequestEditModal = false" disabled="@isSubmittingEditRequest">إلغاء</button>
            </div>
            
            @if (!string.IsNullOrEmpty(editRequestError))
            {
                <div class="alert alert-danger mt-3 mb-0 small">@editRequestError</div>
            }
        </div>
    </div>
}

<!-- Lightbox Modal -->
@if (!string.IsNullOrEmpty(selectedImage))
{
    <div class="lightbox-overlay animate-fade-in" @onclick="CloseLightbox">
        <button class="btn btn-glass-icon position-absolute top-0 end-0 m-4 text-white z-3" @onclick="CloseLightbox">
            <i class="fa-solid fa-xmark"></i>
        </button>
        <img src="@selectedImage" class="lightbox-img shadow-lg rounded-4" @onclick:stopPropagation="true" />
    </div>
}

