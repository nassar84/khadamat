    // Rating Logic
    private void OpenRateModal() => showRateModal = true;

    private async Task StartRating(int initialRating)
    {
        if (service == null) return;

        // Auth check
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated != true)
        {
            Navigation.NavigateTo($"/login?returnUrl=/service/{Id}");
            return;
        }

        // Self-rating guard — compare UserId from profile
        var profile = await AuthService.GetProfileAsync();
        if (profile?.Success == true)
        {
            var myId = profile.Data?.Id;
            if (service.UserId == myId)
            {
                await JS.InvokeVoidAsync("alert", "لا يمكنك تقييم خدمتك الخاصة.");
                return;
            }

            // Pre-fill if user already rated this service
            var existingReview = service.Reviews?.FirstOrDefault(r => r.UserId == myId);
            if (existingReview != null)
            {
                userRating  = existingReview.Rating;
                userComment = existingReview.Comment ?? "";
            }
            else
            {
                userRating  = initialRating > 0 ? initialRating : 0;
                userComment = "";
            }
        }
        else
        {
            userRating  = initialRating > 0 ? initialRating : 0;
            userComment = "";
        }

        ratingValidationMsg = null;
        showRateModal = true;
    }

    private async Task SubmitRating()
    {
        if (service == null) return;

        if (userRating < 1)
        {
            ratingValidationMsg = "يرجى اختيار تقييم بالنجوم (1 على الأقل)";
            return;
        }

        ratingValidationMsg  = null;
        isSubmittingRating   = true;

        try
        {
            var res = await Api.CreateReviewAsync(new CreateReviewRequest
            {
                ServiceId = service.Id,
                Rating    = userRating,
                Comment   = userComment
            });

            if (res.Success && res.Data != null)
            {
                var result = res.Data;

                // Get current user's id to identify existing review
                var authState = await AuthStateProvider.GetAuthenticationStateAsync();
                var profile   = await AuthService.GetProfileAsync();
                var myId      = profile?.Data?.Id;

                // Remove old review by this user (update scenario)
                if (!string.IsNullOrEmpty(myId))
                {
                    var existingIdx = service.Reviews.FindIndex(r => r.UserId == myId || r.UserName == result.ReviewerName);
                    if (existingIdx >= 0)
                        service.Reviews.RemoveAt(existingIdx);
                }

                // Insert updated/new review at top
                service.Reviews.Insert(0, new ReviewDto
                {
                    UserId    = myId,
                    UserName  = result.ReviewerName,
                    UserAvatar = result.ReviewerAvatar,
                    Rating    = userRating,
                    Comment   = userComment,
                    CreatedAt = DateTime.Now
                });

                // Update service aggregate rating
                service.Rating      = result.NewAverage;
                service.RatersCount = result.RatersCount;

                showRateModal = false;
                userComment   = "";
                userRating    = 0;

                // Show success toast
                showRatingSuccess = true;
                StateHasChanged();
                await Task.Delay(3000);
                showRatingSuccess = false;
            }
            else
            {
                ratingValidationMsg = res.Message ?? "حدث خطأ أثناء إرسال التقييم";
            }
        }
        catch (Exception ex)
        {
            ratingValidationMsg = "حدث خطأ غير متوقع. يرجى المحاولة مرة أخرى.";
            Console.WriteLine($"Error submitting rating: {ex.Message}");
        }
        finally
        {
            isSubmittingRating = false;
        }
    }

