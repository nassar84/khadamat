        }
        finally
        {
            isSubmittingRequest = false;
        }
    }

    // --- Request Edit Logic ---
    private bool IsAuthenticated = false;
    private bool showRequestEditModal = false;
    private string editReason = "";
    private List<FieldEdit> fieldEdits = new() { new FieldEdit() };
    private bool isSubmittingEditRequest = false;
    private string? editRequestError;

    public class FieldEdit 
    { 
        public string FieldName { get; set; } = ""; 
        public string ProposedValue { get; set; } = ""; 
    }

    private void AddFieldEdit() => fieldEdits.Add(new FieldEdit());
    private void RemoveFieldEdit(FieldEdit edit) => fieldEdits.Remove(edit);

    private void OpenRequestEditModal()
    {
        if (!IsAuthenticated)
        {
            _ = JS.InvokeVoidAsync("alert", "يرجى تسجيل الدخول أولاً لتتمكن من اقتراح تعديل البيانات.");
            Navigation.NavigateTo("/login?returnUrl=" + Uri.EscapeDataString(Navigation.Uri));
            return;
        }
        editReason = "";
        fieldEdits = new() { new FieldEdit() };
        editRequestError = null;
        showRequestEditModal = true;
    }

    private async Task SubmitEditRequest()
    {
        if (string.IsNullOrWhiteSpace(editReason))
        {
            editRequestError = "يرجى كتابة سبب التعديل";
            return;
        }

        isSubmittingEditRequest = true;
        editRequestError = null;

        try
        {
            if (service == null) return;

            // Map dynamic edits to specific fields if they match, or add to reason
            string? proposedName = fieldEdits.FirstOrDefault(e => e.FieldName == "الاسم" || e.FieldName.ToLower() == "name")?.ProposedValue;
            string? proposedPhone = fieldEdits.FirstOrDefault(e => e.FieldName == "الهاتف" || e.FieldName.ToLower() == "phone")?.ProposedValue;
            string? proposedPrice = fieldEdits.FirstOrDefault(e => e.FieldName == "السعر" || e.FieldName.ToLower() == "price")?.ProposedValue;
            string? proposedAddress = fieldEdits.FirstOrDefault(e => e.FieldName == "العنوان" || e.FieldName.ToLower() == "address")?.ProposedValue;
            string? proposedDesc = fieldEdits.FirstOrDefault(e => e.FieldName == "الوصف" || e.FieldName.ToLower() == "description")?.ProposedValue;
            string? proposedPhone2 = fieldEdits.FirstOrDefault(e => e.FieldName == "الهاتف الثاني" || e.FieldName == "هاتف 2" || e.FieldName.ToLower() == "phone 2" || e.FieldName.ToLower() == "phone2")?.ProposedValue;
            string? proposedWhatsApp = fieldEdits.FirstOrDefault(e => e.FieldName == "واتساب" || e.FieldName == "الواتساب" || e.FieldName == "واتس" || e.FieldName.ToLower() == "whatsapp")?.ProposedValue;

            // Build full reason including other edits
            var fullReason = editReason;
            var otherEdits = fieldEdits.Where(e => 
                e.FieldName != "الاسم" && e.FieldName.ToLower() != "name" &&
                e.FieldName != "الهاتف" && e.FieldName.ToLower() != "phone" &&
                e.FieldName != "السعر" && e.FieldName.ToLower() != "price" &&
                e.FieldName != "العنوان" && e.FieldName.ToLower() != "address" &&
                e.FieldName != "الوصف" && e.FieldName.ToLower() != "description" &&
                e.FieldName != "الهاتف الثاني" && e.FieldName != "هاتف 2" && e.FieldName.ToLower() != "phone 2" && e.FieldName.ToLower() != "phone2" &&
                e.FieldName != "واتساب" && e.FieldName != "الواتساب" && e.FieldName != "واتس" && e.FieldName.ToLower() != "whatsapp" &&
                !string.IsNullOrWhiteSpace(e.FieldName));

            if (otherEdits.Any())
            {
                fullReason += "\nتعديلات إضافية:\n" + string.Join("\n", otherEdits.Select(e => $"- {e.FieldName}: {e.ProposedValue}"));
            }

            decimal? priceVal = null;
            if (decimal.TryParse(proposedPrice, out var p)) priceVal = p;

            var success = await Api.RequestServiceEditAsync(service.Id, new 
            {
                ServiceId = service.Id,
                Reason = fullReason,
                ProposedName = proposedName,
                ProposedPhone1 = proposedPhone,
                ProposedDescription = proposedDesc,
                ProposedAddress = proposedAddress,
                ProposedPrice = priceVal,
                ProposedPhone2 = proposedPhone2,
                ProposedWhatsApp = proposedWhatsApp
            });

            if (success)
            {
                showRequestEditModal = false;
                await JS.InvokeVoidAsync("alert", "تم إرسال اقتراح التعديل بنجاح والمراجعة من قبل الإدارة");
            }
            else
            {
                editRequestError = "حدث خطأ أثناء الإرسال. تأكد من اتصالك.";
            }
        }
        catch (Exception ex)
        {
            editRequestError = "حدث خطأ. حاول مرة أخرى لاحقاً.";
        }
        finally
        {
            isSubmittingEditRequest = false;
        }
    }
