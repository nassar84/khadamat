        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error adding comment: {ex.Message}");
        }
        finally
        {
            isPostingComment = false;
        }
    }
    
    // Rating Logic
    private void OpenRateModal() => showRateModal = true;
    private async Task SubmitRating()
    {
        if (service == null) return;
        
        try 
        {
            var success = await Api.AddReviewAsync(service.Id, userRating, userComment);
            if (success)
            {
                service.Reviews.Insert(0, new ReviewDto 
                { 
                    UserName = "أنت", 
