@page "/user/messages"
@page "/user/messages/{OtherUserId}"
@page "/messages"
@page "/messages/{OtherUserId}"
@using Khadamat.Application.DTOs
@using Khadamat.BlazorUI.Services
@using Khadamat.BlazorUI.State
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize]
@inject ApiClient Api
@inject SignalRClientService SignalRService
@inject NavigationManager Navigation
@inject AppState State
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider
@implements IDisposable

<div class="messages-container glass-card overflow-hidden m-0 m-md-3">
    @if (isNotAuthenticated)
    {
        <div class="text-center py-5 h-100 d-flex flex-column justify-content-center align-items-center">
            <i class="fa-solid fa-lock text-warning fs-1 mb-3"></i>
            <h4 class="fw-bold">يجب عليك تسجيل الدخول أولاً</h4>
            <p class="text-muted">لعرض رسائلك، يرجى تسجيل الدخول إلى حسابك.</p>
            <button class="btn btn-primary rounded-pill px-4 mt-3" @onclick='() => Navigation.NavigateTo("/login")'>تسجيل الدخول</button>
        </div>
    }
    else
    {
        <div class="row g-0 h-100">
            <!-- Sidebar: Conversations List -->
            <div class="col-12 col-md-4 col-lg-3 conversation-sidebar @(string.IsNullOrEmpty(OtherUserId) ? "" : "d-none d-md-block")">
                <div class="p-3 border-bottom bg-light d-flex align-items-center justify-content-between">
                    <h5 class="mb-0 fw-bold"><i class="fa-solid fa-comments text-primary me-2"></i>المحادثات</h5>
                    <button class="btn btn-sm btn-outline-primary rounded-pill px-3 shadow-sm d-flex align-items-center gap-1" @onclick="OpenNewChatModal" title="محادثة جديدة">
                        <i class="fa-solid fa-pen-to-square"></i>
                        <span class="small fw-bold">جديدة</span>
                    </button>
                </div>
                <div class="conversation-list overflow-auto">
                    @if (conversations == null)
                    {
                        <div class="p-3">
                            <Khadamat.BlazorUI.Shared.SkeletonLoader Type="list" Count="6" />
                        </div>
                    }
                    else if (!conversations.Any())
                    {
                        <div class="p-4 text-center text-muted">
                            <i class="far fa-comments fs-1 mb-3 opacity-25"></i>
                            <h6 class="fw-bold text-dark mb-1">لا توجد محادثات بعد</h6>
                            <p class="small text-muted mb-3">ستظهر هنا رسائلك واستفساراتك مع العملاء ومقدمي الخدمات.</p>
                            <button class="btn btn-outline-primary btn-sm rounded-pill px-3" @onclick="OpenNewChatModal">
                                <i class="fa-solid fa-pen-to-square me-1"></i> بدء محادثة جديدة
                            </button>
                        </div>
                    }
                    else
                    {
                        @foreach (var conv in conversations)
                        {
                            <div class="conversation-item p-3 d-flex align-items-center cursor-pointer @(OtherUserId == conv.OtherPartyId ? "active" : "") @(conv.UnreadCount > 0 ? "unread" : "")"
                                 @onclick="() => SelectConversation(conv.OtherPartyId)">
                                <div class="avatar-wrapper me-3">
                                    <img src="@(string.IsNullOrEmpty(conv.OtherPartyPhoto) ? "/img/default-avatar.png" : conv.OtherPartyPhoto)" class="avatar rounded-circle" alt="@conv.OtherPartyName" />
                                    @if (conv.UnreadCount > 0)
                                    {
                                        <span class="unread-badge">@conv.UnreadCount</span>
                                    }
                                </div>
                                <div class="flex-grow-1 min-width-0">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <h6 class="mb-0 text-truncate fw-bold">@conv.OtherPartyName</h6>
                                        <span class="smaller text-muted">@FormatDate(conv.LastMessageTime)</span>
                                    </div>
                                    <p class="mb-0 text-truncate smaller @(conv.UnreadCount > 0 ? "text-dark" : "text-muted")">@conv.LastMessage</p>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <!-- Main: Chat Area -->
            <div class="col-12 col-md-8 col-lg-9 chat-area d-flex flex-column @(string.IsNullOrEmpty(OtherUserId) ? "d-none d-md-flex justify-content-center align-items-center bg-light" : "")">
                @if (string.IsNullOrEmpty(OtherUserId))
                {
                    <div class="text-center p-4 p-md-5 text-muted d-flex flex-column align-items-center justify-content-center h-100">
                        <div class="mb-3 d-flex align-items-center justify-content-center shadow-sm" style="width: 70px; height: 70px; border-radius: 50%; background: rgba(99, 102, 241, 0.1);">
                            <i class="fa-solid fa-comments text-primary fs-2"></i>
                        </div>
                        <h5 class="fw-bold text-dark mb-1">المحادثات والرسائل</h5>
                        <p class="text-muted small mb-3" style="max-width: 380px;">اختر محادثة من القائمة لعرض الرسائل أو اضغط على زر محادثة جديدة للتواصل المباشر.</p>
                        <button class="btn btn-primary rounded-pill px-4 btn-sm shadow-sm" @onclick="OpenNewChatModal">
                            <i class="fa-solid fa-pen-to-square me-1"></i> بدء محادثة جديدة
                        </button>
                    </div>
                }
                else
                {
                    <!-- Chat Header -->
                    <div class="chat-header p-3 border-bottom bg-white d-flex align-items-center">
                        <button class="btn btn-link link-dark d-md-none me-2" @onclick="GoBackToConversations">
                            <i class="fas fa-arrow-right"></i>
                        </button>
                        <div class="d-flex align-items-center">
                            <img src="@(currentOtherPartyPhoto ?? "/img/default-avatar.png")" class="avatar-sm rounded-circle me-3" />
                            <div>
                                <h6 class="mb-0 fw-bold">@currentOtherPartyName</h6>
                                <span class="smaller text-success"><i class="fas fa-circle me-1"></i> متصل الآن</span>
                            </div>
                        </div>
                        <div class="ms-auto">
                            <button class="btn btn-icon-light"><i class="fas fa-phone"></i></button>
                            <button class="btn btn-icon-light"><i class="fas fa-ellipsis-v"></i></button>
                        </div>
                    </div>

                    <!-- Messages area -->
                    <div class="chat-messages p-3 flex-grow-1 overflow-auto bg-light-soft" id="chatMessages">
                        @if (messages == null)
                        {
                            <div class="h-100 p-4">
                                <Khadamat.BlazorUI.Shared.SkeletonLoader Type="text" Count="4" />
                                <div class="text-end mt-4"><Khadamat.BlazorUI.Shared.SkeletonLoader Type="text" Count="2" /></div>
                                <Khadamat.BlazorUI.Shared.SkeletonLoader Type="text" Count="3" />
                            </div>
                        }
                        else
                        {
                            DateTime? lastDate = null;
                            @foreach (var msg in messages)
                            {
                                bool mine = (!string.IsNullOrEmpty(currentUserId) && msg.SenderId == currentUserId) || (msg.SenderId != OtherUserId);

                                if (lastDate == null || lastDate.Value.Date != msg.CreatedAt.Date)
                                {
                                    <div class="date-divider my-4 text-center px-3">
                                        <span class="bg-white px-3 py-1 rounded-pill smaller shadow-sm border">@msg.CreatedAt.ToString("D")</span>
                                    </div>
                                    lastDate = msg.CreatedAt;
                                }

                                <div class="message-wrapper mb-3 @(mine ? "mine" : "theirs")">
                                    <div class="message-content p-3 shadow-sm">
                                        <p class="mb-1">@msg.Content</p>
                                        <div class="text-end smaller opacity-50 message-time">
                                            @msg.CreatedAt.ToString("t")
                                            @if (mine)
                                            {
                                                <i class="fas fa-check-double ms-1 @(msg.IsRead ? "text-primary" : "")"></i>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>

                    <!-- Input area -->
                    <div class="chat-input-area p-3 bg-white border-top">
                        <div class="input-group">
                            <button class="btn btn-light-premium rounded-circle me-2"><i class="fas fa-paperclip"></i></button>
                            <input type="text" class="form-control premium-input br-50" 
                                   placeholder="اكتب رسالتك هنا..." 
                                   @bind="newMessage" 
                                   @onkeyup="HandleKeyPress" />
                            <button class="btn btn-primary-premium rounded-circle ms-2 send-btn" 
                                    @onclick="SendMessage" 
                                    disabled="@(string.IsNullOrWhiteSpace(newMessage))">
                                <i class="fas fa-paper-plane"></i>
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@if (showNewChatModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5); z-index: 1050;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow">
                <div class="modal-header border-bottom">
                    <h5 class="modal-title fw-bold"><i class="fa-solid fa-pen-to-square text-primary me-2"></i>بدء محادثة جديدة</h5>
                    <button type="button" class="btn-close" @onclick="CloseNewChatModal"></button>
                </div>
                <div class="modal-body p-3">
                    <div class="input-group mb-3">
                        <span class="input-group-text bg-white"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                        <input type="text" class="form-control" placeholder="ابحث باسم الخدمة أو المزود..." @bind="newChatSearchQuery" @bind:event="oninput" @onkeyup="SearchProvidersForChat" />
                    </div>

                    @if (isSearchingProviders)
                    {
                        <div class="text-center py-4">
                            <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                            <span class="ms-2 small text-muted">جاري البحث...</span>
                        </div>
                    }
                    else if (chatProviderResults == null || !chatProviderResults.Any())
                    {
                        <div class="text-center py-4 text-muted">
                            <p class="small mb-0">لم يتم العثور على نتائج للبحث</p>
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush overflow-auto" style="max-height: 320px;">
                            @foreach (var s in chatProviderResults)
                            {
                                <div class="list-group-item list-group-item-action d-flex align-items-center gap-3 p-2 rounded-3 mb-1 cursor-pointer border-0" @onclick="() => StartChatWithService(s)">
                                    <img src="@(!string.IsNullOrEmpty(s.ProviderPhoto) ? s.ProviderPhoto : (s.Images?.FirstOrDefault() ?? "/img/default-avatar.png"))" class="rounded-circle" style="width: 44px; height: 44px; object-fit: cover;" />
                                    <div class="flex-grow-1 overflow-hidden">
                                        <div class="fw-bold small text-truncate">@s.Title</div>
                                        <div class="text-muted x-small text-truncate">
                                            <i class="fa-solid fa-user me-1 text-primary"></i>@(string.IsNullOrEmpty(s.ProviderName) ? s.CategoryName : s.ProviderName)
                                        </div>
                                    </div>
                                    <span class="btn btn-sm btn-primary-subtle text-primary rounded-pill px-3 py-1" style="font-size: 0.75rem;">
                                        مراسلة <i class="fa-solid fa-arrow-left ms-1"></i>
                                    </span>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

<style>
    .messages-container {
        height: calc(100vh - 120px);
        background: white;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    }

    .conversation-sidebar {
        border-left: 1px solid #eee;
        display: flex;
        flex-direction: column;
    }

    .conversation-list {
        flex-grow: 1;
    }

    .conversation-item {
        transition: all 0.2s ease;
        border-bottom: 1px solid #f8f9fa;
    }

    .conversation-item:hover {
        background-color: #f0f4ff;
    }

    .conversation-item.active {
        background-color: #eef2ff;
        border-right: 4px solid var(--primary-color, #6366f1);
    }

    .conversation-item.unread {
        background-color: #fff;
    }

    .avatar-wrapper {
        position: relative;
    }

    .avatar {
        width: 48px;
        height: 48px;
        object-fit: cover;
    }

    .avatar-sm {
        width: 40px;
        height: 40px;
        object-fit: cover;
    }

    .unread-badge {
        position: absolute;
        top: -5px;
        right: -5px;
        background: #ef4444;
        color: white;
        font-size: 10px;
        width: 18px;
        height: 18px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 2px solid white;
    }

    .chat-messages {
        background: #f8fafc;
        display: flex;
        flex-direction: column;
    }

    .message-wrapper {
        display: flex;
        width: 100%;
        margin-bottom: 0.5rem;
    }

    .message-wrapper.mine {
        justify-content: flex-end;
    }

    .message-wrapper.theirs {
        justify-content: flex-start;
    }

    .message-content {
        max-width: 75%;
        border-radius: 1.2rem;
        position: relative;
    }

    .mine .message-content {
        background: linear-gradient(135deg, #6366f1, #4f46e5);
        color: white;
        border-bottom-right-radius: 0.2rem;
    }

    .theirs .message-content {
        background: white;
        color: #1e293b;
        border-bottom-left-radius: 0.2rem;
    }

    .message-time {
        font-size: 10px;
        margin-top: 4px;
    }

    .br-50 {
        border-radius: 25px !important;
    }

    .chat-input-area .send-btn {
        width: 45px;
        height: 45px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
    }

    .bg-light-soft {
        background-color: #f1f5f9;
        background-image: radial-gradient(#e2e8f0 1px, transparent 1px);
        background-size: 20px 20px;
    }

    .smaller {
        font-size: 0.75rem;
    }

    .cursor-pointer {
        cursor: pointer;
    }

    @@media (max-width: 767.98px) {
        .messages-container {
            height: calc(100vh - 140px);
            margin: 0;
            border-radius: 0;
        }
    }
</style>

@code {
    [Parameter] public string? OtherUserId { get; set; }
    [SupplyParameterFromQuery(Name = "name")] public string? ProviderNameParam { get; set; }
    [SupplyParameterFromQuery(Name = "photo")] public string? ProviderPhotoParam { get; set; }

    private List<ConversationDto>? conversations;
    private List<MessageDto>? messages;
    private string newMessage = "";
    private string? currentOtherPartyName;
    private string? currentOtherPartyPhoto;
    private string? currentUserId;
    private string? _lastLoadedUserId;
    private bool isNotAuthenticated = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState?.User?.Identity?.IsAuthenticated != true)
        {
            isNotAuthenticated = true;
            return;
        }

        currentUserId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
            ?? authState.User.FindFirst("sub")?.Value;

        SignalRService.MessageReceived += HandleMessageReceived;
        await LoadConversations();

        if (!string.IsNullOrEmpty(OtherUserId))
        {
            _lastLoadedUserId = OtherUserId;
            await LoadMessages(OtherUserId);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(OtherUserId) && OtherUserId != _lastLoadedUserId)
        {
            _lastLoadedUserId = OtherUserId;
            await LoadMessages(OtherUserId);
        }
        else if (string.IsNullOrEmpty(OtherUserId))
        {
            _lastLoadedUserId = null;
            messages = null;
        }
    }

    private async Task LoadConversations()
    {
        conversations = await Api.GetConversationsAsync();
        StateHasChanged();
    }

    private async Task LoadMessages(string userId)
    {
        messages = await Api.GetMessagesAsync(userId);
        var conv = conversations?.FirstOrDefault(c => c.OtherPartyId == userId);
        if (conv != null)
        {
            currentOtherPartyName = conv.OtherPartyName;
            currentOtherPartyPhoto = conv.OtherPartyPhoto;
        }
        else 
        {
            currentOtherPartyName = !string.IsNullOrWhiteSpace(ProviderNameParam) ? ProviderNameParam : "مقدم الخدمة";
            currentOtherPartyPhoto = !string.IsNullOrWhiteSpace(ProviderPhotoParam) ? ProviderPhotoParam : null;
        }
        
        StateHasChanged();
        await ScrollToBottom();
    }

    private async Task SelectConversation(string userId)
    {
        if (OtherUserId == userId) return;
        OtherUserId = userId;
        Navigation.NavigateTo($"/user/messages/{userId}", false);
        await LoadMessages(userId);
    }

    private void GoBackToConversations()
    {
        OtherUserId = null;
        _lastLoadedUserId = null;
        messages = null;
        Navigation.NavigateTo("/user/messages", false);
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(newMessage) || string.IsNullOrEmpty(OtherUserId)) return;

        var content = newMessage;
        newMessage = "";

        var success = await Api.SendMessageAsync(OtherUserId, content);
        if (success)
        {
            var msg = new MessageDto
            {
                SenderId = currentUserId ?? "",
                ReceiverId = OtherUserId,
                Content = content,
                CreatedAt = DateTime.UtcNow,
                IsRead = false
            };
            
            messages?.Add(msg);
            
            await LoadConversations();
            await ScrollToBottom();
        }
    }

    private void HandleMessageReceived(MessageDto message)
    {
        InvokeAsync(async () => {
            if (message.SenderId == OtherUserId)
            {
                messages?.Add(message);
                await ScrollToBottom();
            }
            
            await LoadConversations();
            StateHasChanged();
        });
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SendMessage();
        }
    }

    private string FormatDate(DateTime dt)
    {
        if (dt.Date == DateTime.Today) return dt.ToString("t");
        if (dt.Date == DateTime.Today.AddDays(-1)) return "أمس";
        if ((DateTime.Today - dt.Date).TotalDays < 7) return dt.ToString("dddd");
        return dt.ToString("d");
    }

    private async Task ScrollToBottom()
    {
        try 
        {
            await JS.InvokeVoidAsync("scrollToBottom", "chatMessages");
        }
        catch { }
    }

    // ─── New Chat Modal Logic ────────────────────────────────────────────────
    private bool showNewChatModal = false;
    private bool isSearchingProviders = false;
    private string newChatSearchQuery = "";
    private List<ServiceDto> chatProviderResults = new();

    private async Task OpenNewChatModal()
    {
        showNewChatModal = true;
        newChatSearchQuery = "";
        await SearchProvidersForChat();
    }

    private void CloseNewChatModal()
    {
        showNewChatModal = false;
    }

    private async Task SearchProvidersForChat()
    {
        isSearchingProviders = true;
        try
        {
            var res = await Api.GetServicesAsync(search: string.IsNullOrWhiteSpace(newChatSearchQuery) ? null : newChatSearchQuery, pageSize: 12);
            chatProviderResults = res?.Items?.Where(s => !string.IsNullOrEmpty(s.UserId) && s.UserId != currentUserId).ToList() ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error searching services for chat: {ex.Message}");
            chatProviderResults = new();
        }
        finally
        {
            isSearchingProviders = false;
            StateHasChanged();
        }
    }

    private async Task StartChatWithService(ServiceDto service)
    {
        if (string.IsNullOrEmpty(service.UserId)) return;
        showNewChatModal = false;
        OtherUserId = service.UserId;
        currentOtherPartyName = !string.IsNullOrEmpty(service.ProviderName) ? service.ProviderName : service.Title;
        currentOtherPartyPhoto = !string.IsNullOrEmpty(service.ProviderPhoto) ? service.ProviderPhoto : service.Images?.FirstOrDefault();
        Navigation.NavigateTo($"/user/messages/{service.UserId}?name={Uri.EscapeDataString(currentOtherPartyName)}", false);
        await LoadMessages(service.UserId);
    }

    public void Dispose()
    {
        SignalRService.MessageReceived -= HandleMessageReceived;
    }
}
