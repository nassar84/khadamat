@page "/user/my-requests"
@page "/user/requests"
@using Khadamat.Application.DTOs
@using Khadamat.BlazorUI.Services
@using Khadamat.BlazorUI.State
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject ApiClient Api
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject AppState State
@inject IFeedbackService FeedbackService

<div class="px-3 pt-3 pb-5">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h3 class="fw-bold mb-1">طلباتي</h3>
            <p class="text-muted small mb-0">متابعة حالة الطلبات التي أرسلتها للمهنيين ومقدمي الخدمات</p>
        </div>
        <button class="btn btn-primary-premium rounded-pill px-4 shadow-sm" @onclick='() => Navigation.NavigateTo("/services")'>
            <i class="fa-solid fa-plus me-2"></i> طلب خدمة جديدة
        </button>
    </div>

    <!-- Provider Notice Banner -->
    @if (State.IsProvider)
    {
        <div class="alert alert-info border-0 shadow-sm rounded-4 d-flex align-items-center justify-content-between p-3 mb-4 flex-wrap gap-2" style="background: rgba(59, 130, 246, 0.08);">
            <div class="d-flex align-items-center gap-3">
                <div class="bg-primary text-white rounded-circle p-2 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 42px; height: 42px;">
                    <i class="fa-solid fa-briefcase fs-6"></i>
                </div>
                <div>
                    <div class="fw-bold text-dark small">أنت مسجل كمقدم خدمة</div>
                    <div class="text-muted x-small">هذه الصفحة خاصة بطلباتك الشخصية. لإدارة طلبات العملاء الواردة على خدماتك المعروضة:</div>
                </div>
            </div>
            <button class="btn btn-sm btn-primary rounded-pill px-3 fw-bold" @onclick='() => Navigation.NavigateTo("/provider/incoming-requests")'>
                <i class="fa-solid fa-inbox me-1"></i> الطلبات الواردة لخدماتي
            </button>
        </div>
    }

    <!-- Modern Filter Tabs -->
    @if (!isLoading && requests != null && requests.Any())
    {
        <div class="requests-filter-wrap mb-4">
            <div class="requests-filter-bar">
                <button class="rfb-btn @(activeFilter == "all" ? "active" : "")" @onclick='() => activeFilter = "all"'>
                    <i class="fa-solid fa-layer-group"></i>
                    <span>الكل</span>
                    <span class="rfb-count">@requests.Count</span>
                </button>
                <button class="rfb-btn @(activeFilter == "accepted" ? "active accepted" : "")" @onclick='() => activeFilter = "accepted"'>
                    <i class="fa-solid fa-circle-check"></i>
                    <span>مقبولة</span>
                    <span class="rfb-count">@requests.Count(r => r.Status == Khadamat.Domain.Enums.RequestStatus.Accepted)</span>
                </button>
                <button class="rfb-btn @(activeFilter == "rejected" ? "active rejected" : "")" @onclick='() => activeFilter = "rejected"'>
                    <i class="fa-solid fa-circle-xmark"></i>
                    <span>مرفوضة</span>
                    <span class="rfb-count">@requests.Count(r => r.Status == Khadamat.Domain.Enums.RequestStatus.Rejected)</span>
                </button>
            </div>
        </div>
    }

    @if (isLoading)
    {
        <div class="d-flex justify-content-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
        </div>
    }
    else if (requests == null || !requests.Any())
    {
        <div class="glass-card p-5 text-center rounded-4 shadow-sm">
            <div class="mb-3">
                <i class="fa-solid fa-clipboard-list display-1 text-primary opacity-25"></i>
            </div>
            <h5 class="fw-bold mb-2">سجل طلباتك فارغ حالياً</h5>
            <p class="text-muted small mb-4 mx-auto" style="max-width: 480px;">
                لم تقم بإرسال أي طلبات خدمات للمهنيين حتى الآن. يمكنك استكشاف الخدمات والتواصل مع الفنيين لطلب الخدمة التي تحتاجها.
            </p>
            <button class="btn btn-primary-premium rounded-pill px-5 py-2 shadow" @onclick='() => Navigation.NavigateTo("/services")'>
                <i class="fa-solid fa-magnifying-glass me-2"></i> استكشف الخدمات وقدم طلبك الأول
            </button>
        </div>
    }
    else if (!FilteredRequests.Any())
    {
        <div class="glass-card p-5 text-center rounded-4 shadow-sm">
            <i class="fa-solid fa-filter display-3 text-muted opacity-25 mb-3"></i>
            <h6 class="fw-bold text-dark">لا توجد طلبات في هذا التصنيف</h6>
            <button class="btn btn-outline-secondary btn-sm rounded-pill px-4 mt-3" @onclick='() => activeFilter = "all"'>
                عرض كل الطلبات
            </button>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var r in FilteredRequests)
            {
                <div class="glass-card p-3 animate-up request-card">
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="d-flex gap-3 flex-grow-1">
                            <!-- Service Image or Icon -->
                            <div class="req-thumb rounded-4 overflow-hidden flex-shrink-0" style="width: 68px; height: 68px;">
                                @if (!string.IsNullOrEmpty(r.ServiceImage))
                                {
                                    <img src="@State.GetAbsoluteUrl(r.ServiceImage)"
                                         onerror="this.onerror=null;this.src='/images/services/default_service.png';"
                                         class="w-100 h-100" style="object-fit: cover;" alt="@r.ServiceTitle" />
                                }
                                else
                                {
                                    <div class="w-100 h-100 d-flex align-items-center justify-content-center" style="background: rgba(99,102,241,0.08);">
                                        <i class="fa-solid @r.ServiceIcon text-primary fs-3"></i>
                                    </div>
                                }
                            </div>
                            <div class="flex-grow-1">
                                <h6 class="fw-bold mb-1">@r.ServiceTitle</h6>
                                <p class="text-muted small mb-2">
                                    <i class="fa-solid fa-user me-1"></i>@r.ProviderName
                                    <span class="mx-1 opacity-25">•</span>
                                    <i class="fa-regular fa-clock me-1"></i>@r.RequestedAt.ToShortDateString()
                                </p>
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <span class="badge rounded-pill @GetStatusBadge(r.Status)">@r.StatusText</span>
                                    @if (r.PreferredDate.HasValue)
                                    {
                                        <span class="text-muted x-small">
                                            <i class="fa-solid fa-calendar me-1"></i>
                                            @r.PreferredDate.Value.ToString("dd/MM/yyyy")
                                        </span>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(r.Notes))
                                {
                                    <p class="text-muted x-small mt-2 mb-0">
                                        <i class="fa-solid fa-note-sticky me-1"></i>
                                        @r.Notes
                                    </p>
                                }

                                @if (r.HasRated && r.RatingStars.HasValue)
                                {
                                    <div class="mt-2 p-2 rounded-3 d-inline-flex flex-column" style="background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.2);">
                                        <div class="d-flex align-items-center gap-1">
                                            <span class="x-small fw-bold text-dark">تقييمك:</span>
                                            <div class="x-small">
                                                @for (int s = 1; s <= 5; s++)
                                                {
                                                    <i class="@(s <= r.RatingStars.Value ? "fa-solid" : "fa-regular") fa-star"
                                                       style="color: #f59e0b !important; @(s > r.RatingStars.Value ? "opacity:0.3;" : "")"></i>
                                                }
                                            </div>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(r.RatingComment))
                                        {
                                            <span class="text-muted x-small mt-1">"@r.RatingComment"</span>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="d-flex flex-column align-items-end gap-2">
                            <button class="btn btn-sm btn-outline-secondary rounded-pill px-3" @onclick="() => ViewDetails(r.ServiceId)">التفاصيل</button>
                            
                            @if (r.Status == Khadamat.Domain.Enums.RequestStatus.Completed && !r.HasRated)
                            {
                                <button class="btn btn-sm btn-warning text-dark fw-bold rounded-pill px-3 shadow-sm animate-pulse-subtle" @onclick="() => OpenRateModal(r)">
                                    <i class="fa-solid fa-star me-1"></i> تقييم الخدمة
                                </button>
                            }
                            
                            @if (r.Status == Khadamat.Domain.Enums.RequestStatus.Pending)
                            {
                                <button class="btn btn-sm btn-outline-danger rounded-pill px-3" @onclick="() => CancelRequest(r.Id)">
                                    <i class="fa-solid fa-times me-1"></i> إلغاء
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Rating Modal for Completed Order -->
@if (selectedRequestForRating != null)
{
    <div class="modal-overlay animate-fade-in">
        <div class="glass-card p-4 rounded-4 shadow-lg animate-pop" style="max-width: 460px; width: 92%;">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="fa-solid fa-star text-warning me-2"></i>تقييم تجربة الخدمة
                </h5>
                <button class="btn-close shadow-none border-0 bg-transparent text-muted" @onclick="CloseRateModal">
                    <i class="fa-solid fa-xmark fs-5"></i>
                </button>
            </div>

            <div class="p-3 bg-light rounded-4 mb-3 text-center border">
                <div class="fw-bold text-primary fs-6 mb-1">@selectedRequestForRating.ServiceTitle</div>
                <div class="text-muted small">مقدم الخدمة: <span class="fw-bold text-dark">@selectedRequestForRating.ProviderName</span></div>
            </div>

            <div class="text-center mb-4">
                <div class="small text-muted mb-2">كيف كانت تجربتك مع مقدم الخدمة؟</div>
                <div class="d-flex justify-content-center gap-2 mb-2" dir="ltr">
                    @for (int i = 1; i <= 5; i++)
                    {
                        int star = i;
                        <i class="@(userRating >= star ? "fa-solid text-warning" : "fa-regular text-muted") fa-star fs-1 cursor-pointer star-hover"
                           @onclick="() => userRating = star"></i>
                    }
                </div>
                <div class="fw-bold text-warning small">
                    @GetStarLabel(userRating)
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold small">تعليقك ورأيك (اختياري)</label>
                <textarea @bind="userComment" class="form-control rounded-3" rows="3" placeholder="اكتب تفاصيل تجربتك، مدى التزامه بالميعاد وجودة العمل..."></textarea>
            </div>

            @if (!string.IsNullOrEmpty(ratingError))
            {
                <div class="alert alert-danger py-2 px-3 small rounded-3 mb-3">
                    <i class="fa-solid fa-circle-exclamation me-1"></i> @ratingError
                </div>
            }

            <div class="d-flex gap-2">
                <button class="btn btn-primary-premium flex-grow-1 rounded-pill py-2 fw-bold" @onclick="SubmitRating" disabled="@isSubmittingRating">
                    @if (isSubmittingRating)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    حفظ التقييم
                </button>
                <button class="btn btn-light flex-grow-1 rounded-pill py-2" @onclick="CloseRateModal" disabled="@isSubmittingRating">إلغاء</button>
            </div>
        </div>
    </div>
}

<style>
    /* ── Request Card Thumb ── */
    .req-thumb { background: #f1f5f9; }

    /* ── Modern Filter Bar ── */
    .requests-filter-wrap { overflow-x: auto; scrollbar-width: none; }
    .requests-filter-wrap::-webkit-scrollbar { display: none; }
    .requests-filter-bar {
        display: inline-flex;
        gap: 8px;
        padding: 6px;
        background: rgba(241,245,249,0.8);
        border-radius: 16px;
        border: 1px solid rgba(0,0,0,0.05);
        backdrop-filter: blur(8px);
        min-width: max-content;
    }
    .rfb-btn {
        display: flex;
        align-items: center;
        gap: 5px;
        padding: 7px 14px;
        border: none;
        border-radius: 12px;
        background: transparent;
        color: #64748b;
        font-size: 0.82rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
        white-space: nowrap;
    }
    .rfb-btn:hover { background: white; color: #334155; box-shadow: 0 2px 8px rgba(0,0,0,0.06); }
    .rfb-btn.active {
        background: white;
        color: #6366f1;
        box-shadow: 0 3px 10px rgba(99,102,241,0.15);
    }
    .rfb-btn.active.pending { color: #d97706; }
    .rfb-btn.active.inprogress { color: #2563eb; }
    .rfb-btn.active.accepted { color: #059669; }
    .rfb-btn.active.rejected { color: #dc2626; }
    .rfb-btn.active.completed { color: #d97706; }
    .rfb-count {
        background: rgba(99,102,241,0.1);
        color: #6366f1;
        border-radius: 20px;
        padding: 1px 7px;
        font-size: 0.72rem;
        font-weight: 700;
    }
    .rfb-btn.active.pending .rfb-count { background: rgba(217,119,6,0.12); color: #d97706; }
    .rfb-btn.active.accepted .rfb-count { background: rgba(5,150,105,0.12); color: #059669; }
    .rfb-btn.active.rejected .rfb-count { background: rgba(220,38,38,0.12); color: #dc2626; }
    .rfb-btn.active.completed .rfb-count { background: rgba(217,119,6,0.12); color: #d97706; }

    /* ── Modal & Animations ── */
    .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.6);
        backdrop-filter: blur(4px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        direction: rtl;
    }
    .star-hover { transition: transform 0.15s, color 0.15s; }
    .star-hover:hover { transform: scale(1.2); }
    .animate-pop { animation: popUp 0.25s cubic-bezier(0.16, 1, 0.3, 1); }
    @@keyframes popUp {
        0% { transform: scale(0.9); opacity: 0; }
        100% { transform: scale(1); opacity: 1; }
    }
    .animate-pulse-subtle { animation: pulseSubtle 2s infinite ease-in-out; }
    @@keyframes pulseSubtle {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.03); }
    }
</style>

@code {
    private List<ServiceRequestDto>? requests;
    private bool isLoading = true;
    private string activeFilter = "all";

    private IEnumerable<ServiceRequestDto> FilteredRequests
    {
        get
        {
            if (requests == null) return Enumerable.Empty<ServiceRequestDto>();
            return activeFilter switch
            {
                "pending"     => requests.Where(r => r.Status == Khadamat.Domain.Enums.RequestStatus.Pending),
                "in_progress" => requests.Where(r => r.Status == Khadamat.Domain.Enums.RequestStatus.Accepted || r.Status == Khadamat.Domain.Enums.RequestStatus.InProgress),
                "accepted"    => requests.Where(r => r.Status == Khadamat.Domain.Enums.RequestStatus.Accepted),
                "rejected"    => requests.Where(r => r.Status == Khadamat.Domain.Enums.RequestStatus.Rejected),
                "completed"   => requests.Where(r => r.Status == Khadamat.Domain.Enums.RequestStatus.Completed),
                "cancelled"   => requests.Where(r => r.Status == Khadamat.Domain.Enums.RequestStatus.Cancelled || r.Status == Khadamat.Domain.Enums.RequestStatus.Rejected),
                _ => requests
            };
        }
    }

    // Rating State
    private ServiceRequestDto? selectedRequestForRating;
    private int userRating = 5;
    private string userComment = "";
    private bool isSubmittingRating = false;
    private string? ratingError;

    protected override async Task OnInitializedAsync()
    {
        await LoadRequests();
    }

    private async Task LoadRequests()
    {
        isLoading = true;
        try
        {
            requests = await Api.GetMyRequestsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading requests: {ex.Message}");
            requests = new List<ServiceRequestDto>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetStatusBadge(Khadamat.Domain.Enums.RequestStatus status) => status switch
    {
        Khadamat.Domain.Enums.RequestStatus.Pending => "bg-warning text-dark",
        Khadamat.Domain.Enums.RequestStatus.Accepted => "bg-info text-dark",
        Khadamat.Domain.Enums.RequestStatus.InProgress => "bg-primary text-white",
        Khadamat.Domain.Enums.RequestStatus.Completed => "bg-success text-white",
        Khadamat.Domain.Enums.RequestStatus.Cancelled => "bg-secondary text-white",
        Khadamat.Domain.Enums.RequestStatus.Rejected => "bg-danger text-white",
        _ => "bg-secondary"
    };

    private void ViewDetails(int serviceId)
    {
        Navigation.NavigateTo($"/service/{serviceId}");
    }

    private void OpenRateModal(ServiceRequestDto r)
    {
        selectedRequestForRating = r;
        userRating = 5;
        userComment = "";
        ratingError = null;
    }

    private void CloseRateModal()
    {
        selectedRequestForRating = null;
        ratingError = null;
    }

    private string GetStarLabel(int stars) => stars switch
    {
        5 => "ممتاز جداً ⭐⭐⭐⭐⭐",
        4 => "جيد جداً ⭐⭐⭐⭐",
        3 => "جيد ⭐⭐⭐",
        2 => "مقبول ⭐⭐",
        1 => "سيء ⭐",
        _ => "اضغط لتقييم النجوم"
    };

    private async Task SubmitRating()
    {
        if (selectedRequestForRating == null) return;

        if (userRating < 1 || userRating > 5)
        {
            ratingError = "يرجى اختيار التقييم من 1 إلى 5 نجوم";
            return;
        }

        isSubmittingRating = true;
        ratingError = null;

        try
        {
            var res = await Api.CreateReviewAsync(new CreateReviewRequest
            {
                ServiceId = selectedRequestForRating.ServiceId,
                ServiceRequestId = selectedRequestForRating.Id,
                Rating = userRating,
                Comment = userComment?.Trim() ?? string.Empty
            });

            if (res.Success)
            {
                selectedRequestForRating.HasRated = true;
                selectedRequestForRating.RatingStars = userRating;
                selectedRequestForRating.RatingComment = userComment;
                CloseRateModal();
                StateHasChanged();
            }
            else
            {
                ratingError = res.Message ?? "تعذر حفظ التقييم، يرجى المحاولة لاحقاً.";
            }
        }
        catch (Exception ex)
        {
            ratingError = ex.Message;
        }
        finally
        {
            isSubmittingRating = false;
        }
    }

    private async Task CancelRequest(int requestId)
    {
        bool confirmed = await FeedbackService.ConfirmDangerAsync("هل أنت متأكد من رغبتك في إلغاء هذا الطلب؟", "تأكيد إلغاء الطلب", "نعم، إلغاء الطلب", "تراجع");
        if (!confirmed) return;

        var result = await Api.CancelRequestAsync(requestId);
        
        if (result.Success)
        {
            FeedbackService.ShowSuccess("تم الإلغاء بنجاح", "تم إلغاء الطلب بنجاح.");
            await LoadRequests();
            StateHasChanged();
        }
        else
        {
            FeedbackService.ShowError("تعذر الإلغاء", result.Message ?? "حدث خطأ أثناء محاولة إلغاء الطلب.");
        }
    }
}
