@page "/reset-password"
@layout AuthLayout
@using Khadamat.Application.DTOs
@inject Khadamat.BlazorUI.Services.Auth.IAuthService AuthService
@inject NavigationManager Navigation
@inject Khadamat.BlazorUI.State.AppState AppState

<div class="glass-card auth-card">
    <div class="auth-header">
        @if (!string.IsNullOrEmpty(AppState.AppLogo))
        {
            <img src="@AppState.AppLogo" alt="@AppState.AppName" class="auth-logo mb-3" />
        }
        <h3>تعيين كلمة المرور</h3>
        <p>يرجى إدخال كلمة المرور الجديدة الخاصة بك.</p>
    </div>

    @if (isSuccess)
    {
        <div class="alert alert-success text-center">
            <i class="fa-solid fa-circle-check fa-3x mb-3 d-block"></i>
            <p>@message</p>
            <button class="btn btn-primary glass-btn-primary mt-3" @onclick='() => Navigation.NavigateTo("/login")'>تسجيل الدخول الآن</button>
        </div>
    }
    else
    {
        <EditForm Model="@request" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />
            
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">@errorMessage</div>
            }

            <div class="form-group">
                <label>كلمة المرور الجديدة</label>
                <div class="input-group">
                    <InputText @bind-Value="request.NewPassword" type="@(showPassword ? "text" : "password")" class="form-control glass-input" placeholder="••••••••" />
                    <button type="button" class="btn position-absolute end-0 top-50 translate-middle-y border-0 ps-3" @onclick="() => showPassword = !showPassword" style="z-index: 10;">
                        <i class="fa-solid @(showPassword ? "fa-eye-slash" : "fa-eye") text-muted"></i>
                    </button>
                </div>
                <ValidationMessage For="@(() => request.NewPassword)" />
            </div>

            <div class="form-group">
                <label>تأكيد كلمة المرور</label>
                <InputText @bind-Value="request.ConfirmPassword" type="password" class="form-control glass-input" placeholder="••••••••" />
                <ValidationMessage For="@(() => request.ConfirmPassword)" />
            </div>

            <button type="submit" class="btn btn-primary glass-btn-primary mb-3" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span> جاري التعيين...</span>
                }
                else
                {
                    <span>تغيير كلمة المرور</span>
                }
            </button>
        </EditForm>
    }

    <div class="auth-footer">
        <a href="/login" class="text-muted text-decoration-none">
            <i class="fa-solid fa-arrow-right ms-1"></i> العودة لتسجيل الدخول
        </a>
    </div>
</div>

<style>
    .auth-card {
        padding: 40px;
        backdrop-filter: blur(20px);
    }
    
    .auth-header {
        text-align: center;
        margin-bottom: 30px;
    }

    .auth-header h3 {
        color: var(--theme-primary);
        margin: 10px 0;
        font-weight: 700;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-group label {
        display: block;
        margin-bottom: 8px;
        color: #475569;
        font-weight: 600;
    }

    .glass-input {
        width: 100%;
        padding: 12px 15px;
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.4);
        background: rgba(255, 255, 255, 0.5);
    }

    .glass-btn-primary {
        width: 100%;
        padding: 14px;
        border-radius: 12px;
        background: linear-gradient(135deg, var(--theme-primary), var(--theme-secondary));
        border: none;
        color: white;
        font-weight: 700;
    }

    .auth-footer {
        margin-top: 30px;
        text-align: center;
    }
</style>

@code {
    private ResetPasswordRequest request = new ResetPasswordRequest();
    private bool isLoading = false;
    private bool isSuccess = false;
    private bool showPassword = false;
    private string message = "";
    private string errorMessage = "";

    [CascadingParameter]
    private Task<AuthenticationState> authenticationStateTask { get; set; }

    protected override void OnInitialized()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        
        request.Email = query["email"] ?? "";
        request.Token = query["token"] ?? "";

        if (string.IsNullOrEmpty(request.Email) || string.IsNullOrEmpty(request.Token))
        {
            errorMessage = "رابط إعادة التعيين غير صالح أو منتهي الصلاحية.";
        }
    }

    private async Task HandleSubmit()
    {
        if (string.IsNullOrEmpty(request.Email) || string.IsNullOrEmpty(request.Token))
        {
            errorMessage = "بيانات التحقق مفقودة. يرجى استخدام الرابط المرسل إليك.";
            return;
        }

        isLoading = true;
        errorMessage = "";
        
        try
        {
            var result = await AuthService.ResetPassword(request);
            if (result.Success)
            {
                isSuccess = true;
                message = result.Message;
            }
            else
            {
                errorMessage = result.Message;
            }
        }
        catch (Exception ex)
        {
            errorMessage = "حدث خطأ غير متوقع. يرجى المحاولة مرة أخرى.";
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }
}
