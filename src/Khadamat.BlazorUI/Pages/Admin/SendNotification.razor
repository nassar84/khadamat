@page "/admin/send-notification"
@attribute [Authorize(Roles = "Admin,SystemAdmin,SuperAdmin")]
@inject ApiClient Api
@inject IJSRuntime JS
@inject NavigationManager Navigation

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 text-end">
        <div>
            <h2 class="fw-bold mb-0">إرسال تنبيهات النظام</h2>
            <p class="text-muted">أرسل إشعارات فورية ومصورة للمستخدمين أو مجموعات مخصصة</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <button class="btn btn-outline-warning rounded-pill btn-sm" @onclick="TestFcmQuickly" title="إرسال إشعار فوري تجريبي لجميع الهواتف عبر Firebase">
                <i class="fas fa-satellite-dish me-1"></i> اختبار Firebase FCM
            </button>
            <button class="btn btn-outline-primary rounded-pill btn-sm" @onclick='() => Navigation.NavigateTo("/admin/reminders")'>
                <i class="fas fa-bell me-1"></i> إدارة التذكيرات المجدولة
            </button>
            <button class="btn btn-outline-secondary rounded-pill btn-sm" @onclick='() => Navigation.NavigateTo("/admin")'>
                <i class="fas fa-arrow-right me-1"></i> العودة للوحة الإدارة
            </button>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-7">
            <div class="glass-card p-4 shadow-sm h-100">
                <h5 class="fw-bold mb-4 border-bottom pb-2">محتوى الإشعار</h5>
                
                <div class="mb-3">
                    <label class="form-label fw-bold">عنوان الإشعار</label>
                    <input type="text" class="form-control premium-input" @bind="request.Title" @bind:event="oninput" placeholder="مثلاً: صيانة مجدولة، عرض جديد..." />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">نص الرسالة</label>
                    <textarea class="form-control premium-input" rows="4" @bind="request.Message" @bind:event="oninput" placeholder="اكتب تفاصيل التنبيه هنا..."></textarea>
                </div>

                <!-- Rich Image Notification Section -->
                <div class="mb-4 p-3 bg-light rounded-4 border">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label class="form-label fw-bold mb-0 text-primary">
                            <i class="fas fa-image me-1"></i> صورة الإشعار (اختياري - Rich Push Notification)
                        </label>
                        @if (!string.IsNullOrWhiteSpace(request.ImageUrl))
                        {
                            <button type="button" class="btn btn-outline-danger btn-sm rounded-pill py-0 px-2" @onclick="ClearImage">
                                <i class="fas fa-trash-alt me-1"></i> إزالة الصورة
                            </button>
                        }
                    </div>
                    <p class="text-muted small mb-2">
                        تظهر الصورة كبانر عريض (BigPicture) في شريط إشعارات أندرويد لشد انتباه المستخدم حتى والتطبيق مغلق.
                    </p>

                    <div class="row g-2 align-items-center mb-2">
                        <div class="col-sm-8">
                            <input type="text" class="form-control premium-input form-control-sm" 
                                   @bind="request.ImageUrl" 
                                   @bind:event="oninput"
                                   placeholder="رابط الصورة المباشر https://..." />
                        </div>
                        <div class="col-sm-4">
                            <label class="btn btn-outline-primary btn-sm w-100 rounded-pill mb-0 @(isUploadingImage ? "disabled" : "")" style="cursor: pointer;">
                                @if (isUploadingImage)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                    <span>جاري الرفع...</span>
                                }
                                else
                                {
                                    <i class="fas fa-cloud-arrow-up me-1"></i>
                                    <span>رفع صورة</span>
                                }
                                <InputFile OnChange="HandleImageUpload" accept="image/*" class="d-none" disabled="@isUploadingImage" />
                            </label>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(request.ImageUrl))
                    {
                        <div class="position-relative mt-2 rounded-3 overflow-hidden border bg-white text-center p-2">
                            <img src="@request.ImageUrl" alt="معاينة الصورة" class="img-fluid rounded-2 shadow-xs" style="max-height: 180px; width: 100%; object-fit: cover;" @onerror="OnImageLoadError" />
                            @if (imageLoadFailed)
                            {
                                <div class="text-danger small mt-2">
                                    <i class="fas fa-triangle-exclamation me-1"></i> تعذر تحميل الصورة من هذا الرابط. تأكد من أن الرابط مباشر ويبدأ بـ https://
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Destination Selection (App Screen / Service / Custom Link) -->
                <div class="mb-4 p-3 bg-light rounded-4 border">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label class="form-label fw-bold mb-0">
                            <i class="fas fa-location-arrow text-primary me-1"></i> وجهة التنبيه (عند النقر على الإشعار)
                        </label>
                        @if (!string.IsNullOrWhiteSpace(request.RelatedLink))
                        {
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 small" dir="ltr">
                                @request.RelatedLink
                            </span>
                        }
                    </div>

                    <!-- Destination Mode Switcher -->
                    <div class="btn-group w-100 mb-3 shadow-sm rounded-pill overflow-hidden" role="group">
                        <input type="radio" class="btn-check" name="destType" id="destScreen" @onclick='() => SetDestinationMode("Screen")' checked="@(destinationMode == "Screen")">
                        <label class="btn btn-outline-primary btn-sm" for="destScreen">
                            <i class="fas fa-mobile-alt me-1"></i> شاشة من التطبيق
                        </label>

                        <input type="radio" class="btn-check" name="destType" id="destService" @onclick='() => SetDestinationMode("Service")' checked="@(destinationMode == "Service")">
                        <label class="btn btn-outline-primary btn-sm" for="destService">
                            <i class="fas fa-briefcase me-1"></i> صفحة خدمة معينة
                        </label>

                        <input type="radio" class="btn-check" name="destType" id="destCustom" @onclick='() => SetDestinationMode("Custom")' checked="@(destinationMode == "Custom")">
                        <label class="btn btn-outline-primary btn-sm" for="destCustom">
                            <i class="fas fa-link me-1"></i> رابط مخصص
                        </label>
                    </div>

                    @if (destinationMode == "Screen")
                    {
                        <div class="animate-fade-in">
                            <label class="form-label small text-muted">اختر الشاشة المستهدفة:</label>
                            <select class="form-select premium-input" value="@selectedAppScreen" @onchange="OnAppScreenChanged">
                                <option value="/">الصفحة الرئيسية (/)</option>
                                <option value="/marketplace">سوق المستعمل والمنتجات (/marketplace)</option>
                                <option value="/services">تصفح الخدمات (/services)</option>
                                <option value="/search">البحث والاستكشاف (/search)</option>
                                <option value="/categories">الأقسام والتصنيفات (/categories)</option>
                                <option value="/feed">المنشورات والتحديثات (/feed)</option>
                                <option value="/profile">الملف الشخصي والحساب (/profile)</option>
                                <option value="/user/my-requests">طلباتي (/user/my-requests)</option>
                                <option value="/messages">الرسائل والمحادثات (/messages)</option>
                                <option value="/favorites">المفضلة (/favorites)</option>
                                <option value="/register-provider">التسجيل كمقدم خدمة (/register-provider)</option>
                                <option value="/provider/dashboard">لوحة تحكم مقدم الخدمة (/provider/dashboard)</option>
                                <option value="/provider/create-service">إضافة خدمة جديدة (/provider/create-service)</option>
                                <option value="/notifications">مركز التنبيهات (/notifications)</option>
                                <option value="/contact">تواصل معنا والدعم (/contact)</option>
                                <option value="/terms">الشروط والأحكام (/terms)</option>
                                <option value="/privacy">سياسة الخصوصية (/privacy)</option>
                            </select>
                        </div>
                    }
                    else if (destinationMode == "Service")
                    {
                        <div class="animate-fade-in">
                            <div class="row g-2 mb-2">
                                <div class="col-8">
                                    <label class="form-label small text-muted">اختر خدمة من المنصة:</label>
                                    <select class="form-select premium-input" value="@selectedServiceId" @onchange="OnServiceSelectChanged">
                                        <option value="">-- اختر الخدمة --</option>
                                        @foreach (var s in servicesList)
                                        {
                                            <option value="@s.Id">#@s.Id - @s.Title (@s.ProviderName)</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-4">
                                    <label class="form-label small text-muted">أو رقم الخدمة:</label>
                                    <input type="number" class="form-control premium-input" value="@selectedServiceId" @oninput="OnServiceIdInput" placeholder="ID" />
                                </div>
                            </div>

                            @if (selectedService != null)
                            {
                                <div class="p-2 rounded bg-white border small d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong class="text-primary">@selectedService.Title</strong>
                                        <div class="text-muted x-small">@selectedService.ProviderName • @selectedService.Address</div>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-2" @onclick="AutoFillFromSelectedService" title="نسخ اسم ووصف وصورة الخدمة في تفاصيل الإشعار">
                                        <i class="fas fa-magic me-1"></i> نسخ تفاصيل الخدمة
                                    </button>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="animate-fade-in">
                            <label class="form-label small text-muted">اكتب الرابط أو المسار:</label>
                            <input type="text" class="form-control premium-input" @bind="request.RelatedLink" placeholder="مثال: /service/123 أو https://example.com" />
                        </div>
                    }
                </div>

                <!-- Delivery Channel Selection -->
                <div class="mb-4 p-3 bg-light rounded-4 border">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label class="form-label fw-bold mb-0">
                            <i class="fas fa-tower-broadcast text-primary me-1"></i> قناة الإرسال ومكان الظهور
                        </label>
                        <span class="badge bg-primary-subtle text-primary border small">
                            @(request.DeliveryChannel switch {
                                "PushOnly" => "شاشة الموبايل فقط",
                                "InAppOnly" => "داخلي فقط",
                                _ => "كلاهما (موبايل + داخلي)"
                            })
                        </span>
                    </div>
                    <div class="btn-group w-100 shadow-sm rounded-pill overflow-hidden" role="group">
                        <input type="radio" class="btn-check" name="deliveryChannel" id="channelBoth" @onclick='() => request.DeliveryChannel = "Both"' checked="@(request.DeliveryChannel == "Both" || string.IsNullOrEmpty(request.DeliveryChannel))">
                        <label class="btn btn-outline-primary btn-sm py-2" for="channelBoth" title="يصل على شاشة الهاتف كـ Push Notification ويظهر أيضاً داخل التطبيق">
                            <i class="fas fa-layer-group me-1"></i> كلاهما (شاشة الهاتف + داخلي)
                        </label>

                        <input type="radio" class="btn-check" name="deliveryChannel" id="channelPushOnly" @onclick='() => request.DeliveryChannel = "PushOnly"' checked="@(request.DeliveryChannel == "PushOnly")">
                        <label class="btn btn-outline-primary btn-sm py-2" for="channelPushOnly" title="يصل كإشعار خارجي فقط على شاشة الموبايل دون حفظه داخل صندوق الإشعارات">
                            <i class="fas fa-mobile-screen me-1"></i> شاشة الموبايل فقط
                        </label>

                        <input type="radio" class="btn-check" name="deliveryChannel" id="channelInAppOnly" @onclick='() => request.DeliveryChannel = "InAppOnly"' checked="@(request.DeliveryChannel == "InAppOnly")">
                        <label class="btn btn-outline-primary btn-sm py-2" for="channelInAppOnly" title="يظهر فقط داخل التطبيق في الجرس وشريط التنبيهات دون إرسال push notification خارجي">
                            <i class="fas fa-inbox me-1"></i> داخلي فقط
                        </label>
                    </div>
                    <div class="text-muted smaller mt-2">
                        @if (request.DeliveryChannel == "PushOnly")
                        {
                            <span><i class="fas fa-info-circle me-1 text-warning"></i> سيصل التنبيه على شاشة قفل الموبايل وشريط النظام ولن يُحفظ في مركز التنبيهات الداخلي.</span>
                        }
                        else if (request.DeliveryChannel == "InAppOnly")
                        {
                            <span><i class="fas fa-info-circle me-1 text-info"></i> سيظهر التنبيه داخل التطبيق فقط عند فتح المستخدم للتطبيق (في الجرس والشريط).</span>
                        }
                        else
                        {
                            <span><i class="fas fa-check-circle me-1 text-success"></i> الخيار القياسي الموصى به: يظهر على شاشة الهاتف ويُحفظ داخل مركز التنبيهات.</span>
                        }
                    </div>
                </div>

                <button class="btn btn-primary-premium w-100 py-3 rounded-pill shadow" @onclick="HandleSubmit" disabled="@isSubmitting">
                    @if (isSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    <i class="fas fa-paper-plane me-2"></i> إرسال الآن
                </button>
            </div>
        </div>

        <div class="col-lg-5 mt-4 mt-lg-0">
            <div class="glass-card p-4 shadow-sm h-100 d-flex flex-column">
                <h5 class="fw-bold mb-4 border-bottom pb-2">خيارات الاستهداف والمعاينة</h5>

                <!-- Target Type Selector -->
                <div class="mb-4">
                    <label class="form-label fw-bold d-block">إرسال إلى:</label>
                    <div class="btn-group w-100 shadow-sm rounded-pill overflow-hidden" role="group">
                        <input type="radio" class="btn-check" name="targetType" id="targetAll" @onclick='() => SetTarget("All")' checked="@(targetType == "All")">
                        <label class="btn btn-outline-primary" for="targetAll">الكل</label>

                        <input type="radio" class="btn-check" name="targetType" id="targetRole" @onclick='() => SetTarget("Role")' checked="@(targetType == "Role")">
                        <label class="btn btn-outline-primary" for="targetRole">حسب الدور</label>

                        <input type="radio" class="btn-check" name="targetType" id="targetLocation" @onclick='() => SetTarget("Location")' checked="@(targetType == "Location")">
                        <label class="btn btn-outline-primary" for="targetLocation">الموقع</label>

                        <input type="radio" class="btn-check" name="targetType" id="targetCategory" @onclick='() => SetTarget("Category")' checked="@(targetType == "Category")">
                        <label class="btn btn-outline-primary" for="targetCategory">الأقسام</label>
                    </div>
                </div>

                @if (targetType == "Role")
                {
                    <div class="mb-3 animate-fade-in">
                        <label class="form-label">اختر الدور المستهدف</label>
                        <select class="form-select premium-input" @bind="request.TargetRole">
                            <option value="">-- اختر --</option>
                            <option value="User">المستخدمين (العملاء)</option>
                            <option value="Provider">مزودي الخدمة</option>
                            <option value="SystemAdmin">المديرين</option>
                        </select>
                    </div>
                }

                @if (targetType == "Location")
                {
                    <div class="animate-fade-in">
                        <div class="mb-3">
                            <label class="form-label">المحافظة</label>
                            <select class="form-select premium-input" @onchange="OnGovernorateChange">
                                <option value="">كل المحافظات</option>
                                @foreach (var gov in governorates ?? new())
                                {
                                    <option value="@gov.Id">@gov.NameAr</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">المدينة</label>
                            <select class="form-select premium-input" @bind="request.CityId">
                                <option value="">كل المدن</option>
                                @foreach (var city in cities ?? new())
                                {
                                    <option value="@city.Id">@city.NameAr</option>
                                }
                            </select>
                        </div>
                    </div>
                }

                @if (targetType == "Category")
                {
                    <div class="mb-3 animate-fade-in">
                        <label class="form-label">القسم الرئيسي (لمزودي الخدمة فقط)</label>
                        <select class="form-select premium-input" @bind="request.MainCategoryId">
                            <option value="">كل الأقسام</option>
                            @foreach (var cat in mainCategories ?? new())
                            {
                                <option value="@cat.Id">@cat.Name</option>
                            }
                        </select>
                    </div>
                }

                <!-- Live Android Notification Mockup Preview -->
                <div class="mt-3 pt-3 border-top">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label class="form-label fw-bold mb-0 text-dark">
                            <i class="fab fa-android text-success me-1"></i> معاينة شكل الإشعار على هاتف أندرويد
                        </label>
                        <span class="badge bg-success-subtle text-success small">مباشر</span>
                    </div>

                    <div class="p-3 rounded-4 shadow-sm border bg-dark text-white" style="font-family: system-ui, -apple-system, sans-serif;">
                        <!-- Header -->
                        <div class="d-flex align-items-center justify-content-between mb-2 text-light opacity-75">
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-primary rounded-circle p-1" style="width: 20px; height: 20px; display: inline-flex; align-items: center; justify-content: center;">
                                    <i class="fas fa-bell text-white" style="font-size: 10px;"></i>
                                </span>
                                <span class="fw-bold" style="font-size: 0.85rem;">خدماوي</span>
                                <span style="font-size: 0.75rem;">• الآن</span>
                            </div>
                            <i class="fas fa-chevron-down small opacity-50"></i>
                        </div>

                        <!-- Content -->
                        <div class="mb-2">
                            <div class="fw-bold text-white mb-1" style="font-size: 0.95rem;">
                                @(!string.IsNullOrWhiteSpace(request.Title) ? request.Title : "عنوان الإشعار يظهر هنا")
                            </div>
                            <div class="text-light opacity-90 small" style="font-size: 0.85rem; line-height: 1.4;">
                                @(!string.IsNullOrWhiteSpace(request.Message) ? request.Message : "نص الرسالة وتفاصيل الإشعار تظهر هنا للمستخدم...")
                            </div>
                        </div>

                        <!-- Rich Banner Image -->
                        @if (!string.IsNullOrWhiteSpace(request.ImageUrl) && !imageLoadFailed)
                        {
                            <div class="mt-2 rounded-3 overflow-hidden border border-secondary" style="max-height: 170px;">
                                <img src="@request.ImageUrl" alt="بانر الإشعار" style="width: 100%; max-height: 170px; object-fit: cover;" />
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-1.5 text-light opacity-50" style="font-size: 0.7rem;">
                                <span>بانر عريض (BigPictureStyle)</span>
                                <span>Google Play Services</span>
                            </div>
                        }
                    </div>

                    <div class="text-muted smaller mt-2 text-center">
                        <i class="fas fa-shield-alt text-primary me-1"></i>
                        يتم تسليم الإشعار والصورة للمستخدمين عبر خدمات Google Play حتى والتطبيق مغلق تماماً.
                    </div>
                </div>

                <div class="alert alert-info py-2 small mt-auto">
                    <i class="fas fa-info-circle me-1"></i>
                    سيتم إرسال هذا التنبيه كإشعار فوري وتخزينه في مركز التنبيهات الخاص بالمستخدمين المستهدفين.
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private SendNotificationRequest request = new();
    private string targetType = "All";
    private bool isSubmitting = false;
    private bool isUploadingImage = false;
    private bool imageLoadFailed = false;

    // Destination Selection
    private string destinationMode = "Screen";
    private string selectedAppScreen = "/";
    private string selectedServiceId = "";
    private ServiceDto? selectedService;
    private List<ServiceDto> servicesList = new();

    private List<GovernorateDto>? governorates;
    private List<CityDto>? cities;
    private List<MainCategoryDto>? mainCategories;

    protected override async Task OnInitializedAsync()
    {
        request.RelatedLink = "/";
        governorates = await Api.GetGovernoratesAsync();
        mainCategories = await Api.GetMainCategoriesAsync();
        try
        {
            var sResult = await Api.GetServicesAsync(page: 1, pageSize: 100, isApproved: true);
            servicesList = sResult?.Items?.ToList() ?? new();
        }
        catch { }
    }

    private void ClearImage()
    {
        request.ImageUrl = null;
        imageLoadFailed = false;
    }

    private void OnImageLoadError()
    {
        imageLoadFailed = true;
    }

    private async Task HandleImageUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        imageLoadFailed = false;
        isUploadingImage = true;
        try
        {
            var res = await Api.UploadImageAsync(file, Khadamat.BlazorUI.Helpers.EntityImageType.Ad);
            if (res != null && !string.IsNullOrWhiteSpace(res.Url))
            {
                var fullUrl = res.Url.StartsWith("http", StringComparison.OrdinalIgnoreCase) 
                    ? res.Url 
                    : Navigation.ToAbsoluteUri(res.Url).ToString();
                request.ImageUrl = fullUrl;
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "فشل رفع الصورة، يرجى التأكد من صيغة الملف وحجمه.");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"خطأ أثناء الرفع: {ex.Message}");
        }
        finally
        {
            isUploadingImage = false;
        }
    }

    private void SetDestinationMode(string mode)
    {
        destinationMode = mode;
        if (mode == "Screen")
        {
            request.RelatedLink = selectedAppScreen;
        }
        else if (mode == "Service")
        {
            if (int.TryParse(selectedServiceId, out int sid) && sid > 0)
            {
                request.RelatedLink = $"/service/{sid}";
            }
            else
            {
                request.RelatedLink = "";
            }
        }
    }

    private void OnAppScreenChanged(ChangeEventArgs e)
    {
        selectedAppScreen = e.Value?.ToString() ?? "/";
        request.RelatedLink = selectedAppScreen;
    }

    private void OnServiceSelectChanged(ChangeEventArgs e)
    {
        selectedServiceId = e.Value?.ToString() ?? "";
        if (int.TryParse(selectedServiceId, out int sid) && sid > 0)
        {
            selectedService = servicesList.FirstOrDefault(s => s.Id == sid);
            request.RelatedLink = $"/service/{sid}";
        }
        else
        {
            selectedService = null;
            request.RelatedLink = "";
        }
    }

    private void OnServiceIdInput(ChangeEventArgs e)
    {
        selectedServiceId = e.Value?.ToString() ?? "";
        if (int.TryParse(selectedServiceId, out int sid) && sid > 0)
        {
            selectedService = servicesList.FirstOrDefault(s => s.Id == sid);
            request.RelatedLink = $"/service/{sid}";
        }
        else
        {
            selectedService = null;
            request.RelatedLink = "";
        }
    }

    private void AutoFillFromSelectedService()
    {
        if (selectedService == null) return;
        request.Title = $"خدمة جديدة: {selectedService.Title} ✨";
        request.Message = !string.IsNullOrWhiteSpace(selectedService.Description)
            ? (selectedService.Description.Length > 150 ? selectedService.Description[..150] + "..." : selectedService.Description)
            : $"تصفح تفاصيل خدمة {selectedService.Title} الآن على منصة خدماوى واطلبها مباشرة!";

        if (selectedService.Images != null && selectedService.Images.Count > 0)
        {
            var firstImg = selectedService.Images.First();
            var imgRel = Khadamat.BlazorUI.Helpers.ImagePathResolver.Service(firstImg);
            request.ImageUrl = Navigation.ToAbsoluteUri(imgRel).ToString();
            imageLoadFailed = false;
        }
    }

    private void SetTarget(string type)
    {
        targetType = type;
        // Reset specific filters when target type changes
        request.TargetRole = null;
        request.GovernorateId = null;
        request.CityId = null;
        request.MainCategoryId = null;
    }

    private async Task OnGovernorateChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int govId))
        {
            request.GovernorateId = govId;
            cities = await Api.GetCitiesAsync(govId);
        }
        else
        {
            request.GovernorateId = null;
            cities = null;
        }
    }

    private async Task HandleSubmit()
    {
        if (string.IsNullOrEmpty(request.Title) || string.IsNullOrEmpty(request.Message))
        {
            await JS.InvokeVoidAsync("alert", "يرجى ملء العنوان ونص الرسالة");
            return;
        }

        isSubmitting = true;
        try
        {
            var (success, errorMsg) = await Api.SendAdminNotificationAsync(
                request.UserId, 
                request.Title, 
                request.Message, 
                request.RelatedLink,
                request.TargetRole,
                request.GovernorateId,
                request.CityId,
                request.MainCategoryId,
                request.ImageUrl,
                request.DeliveryChannel ?? "Both");
            if (success)
            {
                 await JS.InvokeVoidAsync("alert", "تم إرسال التنبيه بنجاح مع الصورة إلى هواتف المستخدمين!");
                 request = new();
                 destinationMode = "Screen";
                 selectedAppScreen = "/";
                 request.RelatedLink = "/";
                 selectedServiceId = "";
                 selectedService = null;
                 targetType = "All";
                 imageLoadFailed = false;
            }
            else
            {
                 await JS.InvokeVoidAsync("alert", $"حدث خطأ أثناء الإرسال: {errorMsg ?? "يرجى المحاولة لاحقاً"}");
            }
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task TestFcmQuickly()
    {
        isSubmitting = true;
        try
        {
            var testTitle = !string.IsNullOrWhiteSpace(request.Title) ? request.Title : "إشعار تجريبي من خدماوى";
            var testMessage = !string.IsNullOrWhiteSpace(request.Message) ? request.Message : "تجربة وصول الإشعار الفوري بنجاح إلى هاتفك الآن!";

            var (success, msg) = await Api.TestFcmPushAsync(testTitle, testMessage, request.ImageUrl);
            await JS.InvokeVoidAsync("alert", msg);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"خطأ: {ex.Message}");
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
