@page "/admin/send-notification"
@attribute [Authorize(Roles = "Admin,SystemAdmin,SuperAdmin")]
@inject ApiClient Api
@inject IJSRuntime JS
@inject NavigationManager Navigation

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 text-end">
        <div>
            <h2 class="fw-bold mb-0">إرسال تنبيهات النظام</h2>
            <p class="text-muted">أرسل إشعارات فورية للمستخدمين أو مجموعات مخصصة</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <button class="btn btn-outline-warning rounded-pill btn-sm" @onclick="TestFcmQuickly" title="إرسال إشعار فوري تجريبي لجميع الهواتف عبر Firebase">
                <i class="fas fa-satellite-dish me-1"></i> اختبار Firebase FCM
            </button>
            <button class="btn btn-outline-primary rounded-pill btn-sm" @onclick='() => Navigation.NavigateTo("/admin/reminders")'>
                <i class="fas fa-bell me-1"></i> إدارة التذكيرات المجدولة
            </button>
            <button class="btn btn-outline-secondary rounded-pill btn-sm" @onclick='() => Navigation.NavigateTo("/admin")'>
                <i class="fas fa-arrow-right me-1"></i> العودة للوحة الإدارة
            </button>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-7">
            <div class="glass-card p-4 shadow-sm h-100">
                <h5 class="fw-bold mb-4 border-bottom pb-2">محتوى الإشعار</h5>
                
                <div class="mb-3">
                    <label class="form-label fw-bold">عنوان الإشعار</label>
                    <input type="text" class="form-control premium-input" @bind="request.Title" placeholder="مثلاً: صيانة مجدولة، عرض جديد..." />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">نص الرسالة</label>
                    <textarea class="form-control premium-input" rows="5" @bind="request.Message" placeholder="اكتب تفاصيل التنبيه هنا..."></textarea>
                </div>

                <!-- Destination Selection (App Screen / Service / Custom Link) -->
                <div class="mb-4 p-3 bg-light rounded-4 border">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label class="form-label fw-bold mb-0">
                            <i class="fas fa-location-arrow text-primary me-1"></i> وجهة التنبيه (عند النقر على الإشعار)
                        </label>
                        @if (!string.IsNullOrWhiteSpace(request.RelatedLink))
                        {
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 small" dir="ltr">
                                @request.RelatedLink
                            </span>
                        }
                    </div>

                    <!-- Destination Mode Switcher -->
                    <div class="btn-group w-100 mb-3 shadow-sm rounded-pill overflow-hidden" role="group">
                        <input type="radio" class="btn-check" name="destType" id="destScreen" @onclick='() => SetDestinationMode("Screen")' checked="@(destinationMode == "Screen")">
                        <label class="btn btn-outline-primary btn-sm" for="destScreen">
                            <i class="fas fa-mobile-alt me-1"></i> شاشة من التطبيق
                        </label>

                        <input type="radio" class="btn-check" name="destType" id="destService" @onclick='() => SetDestinationMode("Service")' checked="@(destinationMode == "Service")">
                        <label class="btn btn-outline-primary btn-sm" for="destService">
                            <i class="fas fa-briefcase me-1"></i> صفحة خدمة معينة
                        </label>

                        <input type="radio" class="btn-check" name="destType" id="destCustom" @onclick='() => SetDestinationMode("Custom")' checked="@(destinationMode == "Custom")">
                        <label class="btn btn-outline-primary btn-sm" for="destCustom">
                            <i class="fas fa-link me-1"></i> رابط مخصص
                        </label>
                    </div>

                    @if (destinationMode == "Screen")
                    {
                        <div class="animate-fade-in">
                            <label class="form-label small text-muted">اختر الشاشة المستهدفة:</label>
                            <select class="form-select premium-input" value="@selectedAppScreen" @onchange="OnAppScreenChanged">
                                <option value="/">الصفحة الرئيسية (/)</option>
                                <option value="/marketplace">سوق المستعمل والمنتجات (/marketplace)</option>
                                <option value="/services">تصفح الخدمات (/services)</option>
                                <option value="/search">البحث والاستكشاف (/search)</option>
                                <option value="/categories">الأقسام والتصنيفات (/categories)</option>
                                <option value="/feed">المنشورات والتحديثات (/feed)</option>
                                <option value="/profile">الملف الشخصي والحساب (/profile)</option>
                                <option value="/user/my-requests">طلباتي (/user/my-requests)</option>
                                <option value="/messages">الرسائل والمحادثات (/messages)</option>
                                <option value="/favorites">المفضلة (/favorites)</option>
                                <option value="/register-provider">التسجيل كمقدم خدمة (/register-provider)</option>
                                <option value="/provider/dashboard">لوحة تحكم مقدم الخدمة (/provider/dashboard)</option>
                                <option value="/provider/create-service">إضافة خدمة جديدة (/provider/create-service)</option>
                                <option value="/notifications">مركز التنبيهات (/notifications)</option>
                                <option value="/contact">تواصل معنا والدعم (/contact)</option>
                                <option value="/terms">الشروط والأحكام (/terms)</option>
                                <option value="/privacy">سياسة الخصوصية (/privacy)</option>
                            </select>
                        </div>
                    }
                    else if (destinationMode == "Service")
                    {
                        <div class="animate-fade-in">
                            <div class="row g-2 mb-2">
                                <div class="col-8">
                                    <label class="form-label small text-muted">اختر خدمة من المنصة:</label>
                                    <select class="form-select premium-input" value="@selectedServiceId" @onchange="OnServiceSelectChanged">
                                        <option value="">-- اختر الخدمة --</option>
                                        @foreach (var s in servicesList)
                                        {
                                            <option value="@s.Id">#@s.Id - @s.Title (@s.ProviderName)</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-4">
                                    <label class="form-label small text-muted">أو رقم الخدمة:</label>
                                    <input type="number" class="form-control premium-input" value="@selectedServiceId" @oninput="OnServiceIdInput" placeholder="ID" />
                                </div>
                            </div>

                            @if (selectedService != null)
                            {
                                <div class="p-2 rounded bg-white border small d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong class="text-primary">@selectedService.Title</strong>
                                        <div class="text-muted x-small">@selectedService.ProviderName • @selectedService.Address</div>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-2" @onclick="AutoFillFromSelectedService" title="نسخ اسم ووصف الخدمة في عنوان ونص الإشعار">
                                        <i class="fas fa-magic me-1"></i> نسخ للبيانات
                                    </button>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="animate-fade-in">
                            <label class="form-label small text-muted">اكتب الرابط أو المسار:</label>
                            <input type="text" class="form-control premium-input" @bind="request.RelatedLink" placeholder="مثال: /service/123 أو https://example.com" />
                        </div>
                    }
                </div>

                <button class="btn btn-primary-premium w-100 py-3 rounded-pill shadow" @onclick="HandleSubmit" disabled="@isSubmitting">
                    @if (isSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    <i class="fas fa-paper-plane me-2"></i> إرسال الآن
                </button>
            </div>
        </div>

        <div class="col-lg-5 mt-4 mt-lg-0">
            <div class="glass-card p-4 shadow-sm h-100">
                <h5 class="fw-bold mb-4 border-bottom pb-2">خيارات الاستهداف</h5>

                <!-- Target Type Selector -->
                <div class="mb-4">
                    <label class="form-label fw-bold d-block">إرسال إلى:</label>
                    <div class="btn-group w-100 shadow-sm rounded-pill overflow-hidden" role="group">
                        <input type="radio" class="btn-check" name="targetType" id="targetAll" @onclick='() => SetTarget("All")' checked="@(targetType == "All")">
                        <label class="btn btn-outline-primary" for="targetAll">الكل</label>

                        <input type="radio" class="btn-check" name="targetType" id="targetRole" @onclick='() => SetTarget("Role")' checked="@(targetType == "Role")">
                        <label class="btn btn-outline-primary" for="targetRole">حسب الدور</label>

                        <input type="radio" class="btn-check" name="targetType" id="targetLocation" @onclick='() => SetTarget("Location")' checked="@(targetType == "Location")">
                        <label class="btn btn-outline-primary" for="targetLocation">الموقع</label>

                        <input type="radio" class="btn-check" name="targetType" id="targetCategory" @onclick='() => SetTarget("Category")' checked="@(targetType == "Category")">
                        <label class="btn btn-outline-primary" for="targetCategory">الأقسام</label>
                    </div>
                </div>

                @if (targetType == "Role")
                {
                    <div class="mb-3 animate-fade-in">
                        <label class="form-label">اختر الدور المستهدف</label>
                        <select class="form-select premium-input" @bind="request.TargetRole">
                            <option value="">-- اختر --</option>
                            <option value="User">المستخدمين (العملاء)</option>
                            <option value="Provider">مزودي الخدمة</option>
                            <option value="SystemAdmin">المديرين</option>
                        </select>
                    </div>
                }

                @if (targetType == "Location")
                {
                    <div class="animate-fade-in">
                        <div class="mb-3">
                            <label class="form-label">المحافظة</label>
                            <select class="form-select premium-input" @onchange="OnGovernorateChange">
                                <option value="">كل المحافظات</option>
                                @foreach (var gov in governorates ?? new())
                                {
                                    <option value="@gov.Id">@gov.NameAr</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">المدينة</label>
                            <select class="form-select premium-input" @bind="request.CityId">
                                <option value="">كل المدن</option>
                                @foreach (var city in cities ?? new())
                                {
                                    <option value="@city.Id">@city.NameAr</option>
                                }
                            </select>
                        </div>
                    </div>
                }

                @if (targetType == "Category")
                {
                    <div class="mb-3 animate-fade-in">
                        <label class="form-label">القسم الرئيسي (لمزودي الخدمة فقط)</label>
                        <select class="form-select premium-input" @bind="request.MainCategoryId">
                            <option value="">كل الأقسام</option>
                            @foreach (var cat in mainCategories ?? new())
                            {
                                <option value="@cat.Id">@cat.Name</option>
                            }
                        </select>
                    </div>
                }

                <div class="alert alert-info py-2 small mt-auto">
                    <i class="fas fa-info-circle me-1"></i>
                    سيتم إرسال هذا التنبيه كإشعار فوري وتخزينه في مركز التنبيهات الخاص بالمستخدمين المستهدفين.
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private SendNotificationRequest request = new();
    private string targetType = "All";
    private bool isSubmitting = false;

    // Destination Selection
    private string destinationMode = "Screen";
    private string selectedAppScreen = "/";
    private string selectedServiceId = "";
    private ServiceDto? selectedService;
    private List<ServiceDto> servicesList = new();

    private List<GovernorateDto>? governorates;
    private List<CityDto>? cities;
    private List<MainCategoryDto>? mainCategories;

    protected override async Task OnInitializedAsync()
    {
        request.RelatedLink = "/";
        governorates = await Api.GetGovernoratesAsync();
        mainCategories = await Api.GetMainCategoriesAsync();
        try
        {
            var sResult = await Api.GetServicesAsync(page: 1, pageSize: 100, isApproved: true);
            servicesList = sResult?.Items?.ToList() ?? new();
        }
        catch { }
    }

    private void SetDestinationMode(string mode)
    {
        destinationMode = mode;
        if (mode == "Screen")
        {
            request.RelatedLink = selectedAppScreen;
        }
        else if (mode == "Service")
        {
            if (int.TryParse(selectedServiceId, out int sid) && sid > 0)
            {
                request.RelatedLink = $"/service/{sid}";
            }
            else
            {
                request.RelatedLink = "";
            }
        }
    }

    private void OnAppScreenChanged(ChangeEventArgs e)
    {
        selectedAppScreen = e.Value?.ToString() ?? "/";
        request.RelatedLink = selectedAppScreen;
    }

    private void OnServiceSelectChanged(ChangeEventArgs e)
    {
        selectedServiceId = e.Value?.ToString() ?? "";
        if (int.TryParse(selectedServiceId, out int sid) && sid > 0)
        {
            selectedService = servicesList.FirstOrDefault(s => s.Id == sid);
            request.RelatedLink = $"/service/{sid}";
        }
        else
        {
            selectedService = null;
            request.RelatedLink = "";
        }
    }

    private void OnServiceIdInput(ChangeEventArgs e)
    {
        selectedServiceId = e.Value?.ToString() ?? "";
        if (int.TryParse(selectedServiceId, out int sid) && sid > 0)
        {
            selectedService = servicesList.FirstOrDefault(s => s.Id == sid);
            request.RelatedLink = $"/service/{sid}";
        }
        else
        {
            selectedService = null;
            request.RelatedLink = "";
        }
    }

    private void AutoFillFromSelectedService()
    {
        if (selectedService == null) return;
        request.Title = $"خدمة جديدة: {selectedService.Title} ✨";
        request.Message = !string.IsNullOrWhiteSpace(selectedService.Description)
            ? (selectedService.Description.Length > 150 ? selectedService.Description[..150] + "..." : selectedService.Description)
            : $"تصفح تفاصيل خدمة {selectedService.Title} الآن على منصة خدماوى واطلبها مباشرة!";
    }

    private void SetTarget(string type)
    {
        targetType = type;
        // Reset specific filters when target type changes
        request.TargetRole = null;
        request.GovernorateId = null;
        request.CityId = null;
        request.MainCategoryId = null;
    }

    private async Task OnGovernorateChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int govId))
        {
            request.GovernorateId = govId;
            cities = await Api.GetCitiesAsync(govId);
        }
        else
        {
            request.GovernorateId = null;
            cities = null;
        }
    }

    private async Task HandleSubmit()
    {
        if (string.IsNullOrEmpty(request.Title) || string.IsNullOrEmpty(request.Message))
        {
            await JS.InvokeVoidAsync("alert", "يرجى ملء العنوان ونص الرسالة");
            return;
        }

        isSubmitting = true;
        try
        {
            var (success, errorMsg) = await Api.SendAdminNotificationAsync(
                request.UserId, 
                request.Title, 
                request.Message, 
                request.RelatedLink,
                request.TargetRole,
                request.GovernorateId,
                request.CityId,
                request.MainCategoryId);
            if (success)
            {
                 await JS.InvokeVoidAsync("alert", "تم إرسال التنبيه بنجاح!");
                 request = new();
                 destinationMode = "Screen";
                 selectedAppScreen = "/";
                 request.RelatedLink = "/";
                 selectedServiceId = "";
                 selectedService = null;
                 targetType = "All";
            }
            else
            {
                 await JS.InvokeVoidAsync("alert", $"حدث خطأ أثناء الإرسال: {errorMsg ?? "يرجى المحاولة لاحقاً"}");
            }
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task TestFcmQuickly()
    {
        isSubmitting = true;
        try
        {
            var (success, msg) = await Api.TestFcmPushAsync("إشعار تجريبي من خدماوى", "تجربة وصول الإشعار الفوري بنجاح إلى هاتفك الآن!");
            await JS.InvokeVoidAsync("alert", msg);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"خطأ: {ex.Message}");
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
