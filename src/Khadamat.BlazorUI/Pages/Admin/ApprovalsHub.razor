@page "/admin/approvals"
@using Khadamat.Application.DTOs
@using Khadamat.BlazorUI.Services
@using Khadamat.BlazorUI.Services.Admin
@using Khadamat.Application.Features.Services.Commands
@inject ApiClient Api
@inject IAdminService AdminService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject Khadamat.BlazorUI.State.AppState State

<PageTitle>مركز الموافقات والاعتمادات - الإدارة</PageTitle>

<div class="approvals-hub-container" dir="rtl">
    <!-- Top Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3 mt-2">
        <div class="d-flex align-items-center gap-2 flex-wrap min-w-0">
            <div class="hub-icon-badge shadow-sm">
                <i class="fa-solid fa-stamp text-warning fs-4"></i>
            </div>
            <div class="min-w-0">
                <h3 class="fw-bold mb-0 text-dark">مركز الموافقات والاعتمادات</h3>
                <p class="text-muted small mb-0 mt-1">اختر نوع الطلبات لعرضها بالأسفل، مع الترتيب والفلترة</p>
            </div>
        </div>

        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-outline-primary rounded-pill px-3 shadow-2xs" @onclick="ReloadAllAsync" disabled="@isLoading">
                <i class="fa-solid fa-rotate @(isLoading ? "fa-spin" : "") me-1"></i> تحديث الكل
            </button>
        </div>
    </div>

    <!-- Alert Message / Toast -->
    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert alert-@statusMessageType alert-dismissible fade show rounded-4 shadow-sm mb-3 d-flex align-items-center gap-2" role="alert">
            <i class="fa-solid @(statusMessageType == "success" ? "fa-circle-check text-success" : "fa-triangle-exclamation text-danger") fs-5"></i>
            <span class="fw-bold small">@statusMessage</span>
            <button type="button" class="btn-close ms-auto" @onclick="() => statusMessage = null"></button>
        </div>
    }

    <!-- ═══ Type Selector Buttons (لا يوجد Tab Controller - أزرار فقط) ═══ -->
    <div class="row g-2 g-sm-3 mb-3">
        <div class="col-12 col-sm-4">
            <button type="button" class="type-btn @(activeTab == "providers" ? "active" : "")" @onclick='() => SetTab("providers")'>
                <span class="t-icon"><i class="fa-solid fa-user-shield"></i></span>
                <span class="t-label">أصحاب الخدمات</span>
                <span class="t-count">@pendingProviders.Count</span>
            </button>
        </div>
        <div class="col-12 col-sm-4">
            <button type="button" class="type-btn @(activeTab == "services" ? "active" : "")" @onclick='() => SetTab("services")'>
                <span class="t-icon"><i class="fa-solid fa-briefcase"></i></span>
                <span class="t-label">الخدمات الجديدة</span>
                <span class="t-count">@pendingServices.Count</span>
            </button>
        </div>
        <div class="col-12 col-sm-4">
            <button type="button" class="type-btn @(activeTab == "edits" ? "active" : "")" @onclick='() => SetTab("edits")'>
                <span class="t-icon"><i class="fa-solid fa-pen-to-square"></i></span>
                <span class="t-label">طلبات التعديل</span>
                <span class="t-count">@pendingEdits.Count</span>
            </button>
        </div>
    </div>

    <!-- ═══ Filters ═══ -->
    <div class="filters-card mb-3">
        <div class="row g-2 g-md-3 align-items-end">
            <!-- Search -->
            <div class="col-12 col-md-6 col-lg-4">
                <label>بحث سريع</label>
                <div class="position-relative">
                    <i class="fa-solid fa-magnifying-glass position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                    <input type="text"
                           class="form-control rounded-pill ps-5 pe-3 bg-light border-0 py-2 small"
                           placeholder="الاسم، الهاتف، التصنيف، المدينة..."
                           @bind="searchQuery"
                           @bind:event="oninput" />
                </div>
            </div>

            @if (activeTab == "services")
            {
                <div class="col-6 col-md-3 col-lg-2">
                    <label>فئة الخدمة</label>
                    <select class="form-select rounded-pill small" @bind="filterCategory">
                        <option value="">كل الفئات</option>
                        @foreach (var c in CategoryOptions)
                        {
                            <option value="@c">@c</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-md-3 col-lg-2">
                    <label>صاحب الخدمة</label>
                    <select class="form-select rounded-pill small" @bind="filterProvider">
                        <option value="">الكل</option>
                        @foreach (var p in ServiceProviderOptions)
                        {
                            <option value="@p">@p</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-md-3 col-lg-2">
                    <label>المدينة</label>
                    <select class="form-select rounded-pill small" @bind="filterCity">
                        <option value="">الكل</option>
                        @foreach (var c in ServiceCityOptions)
                        {
                            <option value="@c">@c</option>
                        }
                    </select>
                </div>
            }
            else if (activeTab == "providers")
            {
                <div class="col-6 col-md-3 col-lg-2">
                    <label>المدينة / المنطقة</label>
                    <select class="form-select rounded-pill small" @bind="filterCity">
                        <option value="">الكل</option>
                        @foreach (var c in ProviderCityOptions)
                        {
                            <option value="@c">@c</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-md-3 col-lg-2">
                    <label>صاحب الخدمة</label>
                    <select class="form-select rounded-pill small" @bind="filterProvider">
                        <option value="">الكل</option>
                        @foreach (var p in ProviderNameOptions)
                        {
                            <option value="@p">@p</option>
                        }
                    </select>
                </div>
            }
            else
            {
                <div class="col-6 col-md-3 col-lg-2">
                    <label>مقدم الطلب</label>
                    <select class="form-select rounded-pill small" @bind="filterProvider">
                        <option value="">الكل</option>
                        @foreach (var p in RequesterOptions)
                        {
                            <option value="@p">@p</option>
                        }
                    </select>
                </div>
            }

            <!-- Date range -->
            <div class="col-6 col-md-3 col-lg-2">
                <label>من تاريخ</label>
                <input type="date" class="form-control rounded-pill small" @bind="dateFrom" />
            </div>
            <div class="col-6 col-md-3 col-lg-2">
                <label>إلى تاريخ</label>
                <input type="date" class="form-control rounded-pill small" @bind="dateTo" />
            </div>

            <!-- Sort -->
            <div class="col-12 col-md-6 col-lg-3">
                <label>الترتيب</label>
                <select class="form-select rounded-pill small" @bind="sortMode">
                    <option value="default">الفئة ثم التاريخ ثم صاحب الخدمة</option>
                    <option value="date_desc">التاريخ (الأحدث أولاً)</option>
                    <option value="date_asc">التاريخ (الأقدم أولاً)</option>
                </select>
            </div>

            <!-- Reset -->
            <div class="col-12 col-md-6 col-lg-auto">
                <button type="button" class="btn btn-outline-secondary rounded-pill w-100 py-2 small" @onclick="ClearFilters">
                    <i class="fa-solid fa-filter-circle-xmark me-1"></i> مسح الفلاتر
                </button>
            </div>
        </div>
    </div>

    @{
        var filteredProviders = FilteredProviders;
        var filteredServices = FilteredServices;
        var filteredEdits = FilteredEdits;
        var shownCount = activeTab == "services" ? filteredServices.Count : (activeTab == "edits" ? filteredEdits.Count : filteredProviders.Count);
        var totalCount = activeTab == "services" ? pendingServices.Count : (activeTab == "edits" ? pendingEdits.Count : pendingProviders.Count);
    }

    <!-- Results summary -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <div class="small text-muted">
            <i class="fa-solid fa-list-check me-1"></i>
            عرض <strong class="text-dark">@shownCount</strong> من <strong class="text-dark">@totalCount</strong> طلب
        </div>
        @if (HasActiveFilters)
        {
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1">
                <i class="fa-solid fa-filter me-1"></i>فلاتر مُطبَّقة
            </span>
        }
    </div>

    <!-- Main Content Area -->
    @if (isLoading)
    {
        <div class="text-center p-5 glass-card rounded-4">
            <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;" role="status"></div>
            <h5 class="fw-bold">جاري تحميل طلبات الموافقة...</h5>
            <p class="text-muted small mb-0">يرجى الانتظار لحظات ريثما يتم جلب أحدث البيانات</p>
        </div>
    }
    else
    {
        @* ══════════════════════════════════════════════════════════════════════
           النوع 1: أصحاب الخدمات (Provider Approval)
           ══════════════════════════════════════════════════════════════════════ *@
        @if (activeTab == "providers")
        {
            @if (!filteredProviders.Any())
            {
                <div class="glass-card p-5 text-center rounded-4 shadow-sm">
                    <i class="fa-solid @(HasActiveFilters ? "fa-magnifying-glass text-primary" : "fa-circle-check text-success") display-1 mb-3 opacity-25"></i>
                    <h4 class="fw-bold text-dark">@(HasActiveFilters ? "لا توجد نتائج مطابقة للفلاتر" : "لا توجد طلبات انضمام معلقة")</h4>
                    <p class="text-muted mb-0">@(HasActiveFilters ? "جرّب تعديل الفلاتر أو مسحها لعرض جميع الطلبات." : "تمت مراجعة واعتماد جميع طلبات مقدمي الخدمات بنجاح.")</p>
                    @if (HasActiveFilters)
                    {
                        <button class="btn btn-outline-primary rounded-pill px-4 mt-3" @onclick="ClearFilters">مسح الفلاتر</button>
                    }
                </div>
            }
            else
            {
                <div class="row g-3 g-lg-4">
                    @foreach (var provider in filteredProviders)
                    {
                        <div class="col-12 col-lg-6">
                            <div class="approval-card glass-card p-0 rounded-4 overflow-hidden shadow-sm h-100 d-flex flex-column border">
                                <!-- Card Header -->
                                <div class="p-3 bg-light border-bottom d-flex align-items-center gap-3">
                                    <img src="@Khadamat.BlazorUI.Helpers.DefaultImages.GetUserAvatar(provider.Name)"
                                         class="rounded-circle shadow-sm border border-2 border-white flex-shrink-0"
                                         width="56" height="56" alt="@provider.Name" />
                                    <div class="flex-grow-1 min-w-0">
                                        <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap">
                                            <h6 class="fw-bold mb-0 text-dark text-truncate">@provider.Name</h6>
                                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-2 py-1 x-small">
                                                طلب انضمام جديد
                                            </span>
                                        </div>
                                        @if (!string.IsNullOrEmpty(provider.BusinessName))
                                        {
                                            <div class="small fw-semibold text-primary text-truncate">
                                                <i class="fa-solid fa-briefcase me-1"></i>@provider.BusinessName
                                            </div>
                                        }
                                        <div class="x-small text-muted mt-1">
                                            <i class="fa-solid fa-clock me-1"></i>تاريخ الطلب: @provider.JoinedAt.ToString("yyyy/MM/dd - hh:mm tt")
                                        </div>
                                    </div>
                                </div>

                                <!-- Card Body: Info & Contacts -->
                                <div class="p-3 flex-grow-1 d-flex flex-column gap-3">
                                    <!-- Contact details bar -->
                                    <div class="row g-2 small">
                                        <div class="col-sm-6">
                                            <div class="p-2 rounded-3 bg-light border d-flex align-items-center gap-2">
                                                <i class="fa-solid fa-phone text-primary"></i>
                                                <span class="fw-bold text-truncate" dir="ltr">@provider.Phone</span>
                                                <div class="ms-auto d-flex gap-1">
                                                    <a href="tel:@provider.Phone" class="btn btn-xs btn-outline-primary rounded-circle" title="اتصال">
                                                        <i class="fa-solid fa-phone-volume"></i>
                                                    </a>
                                                    <a href="@GetWhatsAppLink(provider.Phone)" target="_blank" class="btn btn-xs btn-outline-success rounded-circle" title="واتساب">
                                                        <i class="fa-brands fa-whatsapp"></i>
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-sm-6">
                                            <div class="p-2 rounded-3 bg-light border d-flex align-items-center gap-2">
                                                <i class="fa-solid fa-envelope text-primary"></i>
                                                <span class="text-truncate" dir="ltr">@provider.Email</span>
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <div class="p-2 rounded-3 bg-light border d-flex align-items-center gap-2">
                                                <i class="fa-solid fa-location-dot text-danger"></i>
                                                <span>المدينة / المنطقة: <strong>@(string.IsNullOrEmpty(provider.City) ? "غير محدد" : provider.City)</strong></span>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Bio / Expertise -->
                                    @if (!string.IsNullOrWhiteSpace(provider.Expertise))
                                    {
                                        <div class="p-3 rounded-3 bg-light-subtle border">
                                            <div class="x-small fw-bold text-muted mb-1"><i class="fa-solid fa-award me-1 text-warning"></i>الخبرات والتخصص والنبذة:</div>
                                            <div class="small text-dark lh-base">@provider.Expertise</div>
                                        </div>
                                    }

                                    <!-- Official Documents Verification Section (معاينة المستندات) -->
                                    <div>
                                        <div class="x-small fw-bold text-muted mb-2 d-flex align-items-center gap-1">
                                            <i class="fa-solid fa-file-shield text-primary"></i>
                                            <span>معاينة المستندات والوثائق الرسمية:</span>
                                        </div>
                                        <div class="row g-2">
                                            <!-- National ID Card Preview -->
                                            <div class="col-6">
                                                <div class="doc-card p-2 rounded-3 border text-center cursor-pointer position-relative @(!string.IsNullOrEmpty(provider.IdCardImage) ? "border-primary bg-primary-subtle bg-opacity-10" : "bg-light")"
                                                     @onclick='() => ViewDoc(provider, "ID")' title="انقر للمعاينة بالحجم الكامل">
                                                    @if (!string.IsNullOrEmpty(provider.IdCardImage))
                                                    {
                                                        <div class="doc-thumb-wrap mb-1 position-relative overflow-hidden rounded-2">
                                                            <img src="@Api.GetAbsoluteUrl(provider.IdCardImage)" class="doc-thumb-img" alt="البطاقة الشخصية" />
                                                            <div class="doc-hover-overlay">
                                                                <i class="fa-solid fa-magnifying-glass-plus text-white fs-5"></i>
                                                            </div>
                                                        </div>
                                                        <span class="x-small fw-bold text-primary d-block">البطاقة الشخصية</span>
                                                        <span class="badge bg-success-subtle text-success border border-success-subtle x-small mt-1">مرفق</span>
                                                    }
                                                    else
                                                    {
                                                        <div class="py-3 text-muted">
                                                            <i class="fa-solid fa-id-card fs-3 mb-1 opacity-50"></i>
                                                            <div class="x-small fw-bold">البطاقة الشخصية</div>
                                                            <span class="badge bg-secondary-subtle text-secondary x-small mt-1">غير مرفق</span>
                                                        </div>
                                                    }
                                                </div>
                                            </div>

                                            <!-- Certificate Preview -->
                                            <div class="col-6">
                                                <div class="doc-card p-2 rounded-3 border text-center cursor-pointer position-relative @(!string.IsNullOrEmpty(provider.CertificateImage) ? "border-info bg-info-subtle bg-opacity-10" : "bg-light")"
                                                     @onclick='() => ViewDoc(provider, "Certificate")' title="انقر للمعاينة بالحجم الكامل">
                                                    @if (!string.IsNullOrEmpty(provider.CertificateImage))
                                                    {
                                                        <div class="doc-thumb-wrap mb-1 position-relative overflow-hidden rounded-2">
                                                            <img src="@Api.GetAbsoluteUrl(provider.CertificateImage)" class="doc-thumb-img" alt="الشهادة المهنية" />
                                                            <div class="doc-hover-overlay">
                                                                <i class="fa-solid fa-magnifying-glass-plus text-white fs-5"></i>
                                                            </div>
                                                        </div>
                                                        <span class="x-small fw-bold text-info d-block">الشهادة / الترخيص</span>
                                                        <span class="badge bg-success-subtle text-success border border-success-subtle x-small mt-1">مرفق</span>
                                                    }
                                                    else
                                                    {
                                                        <div class="py-3 text-muted">
                                                            <i class="fa-solid fa-certificate fs-3 mb-1 opacity-50"></i>
                                                            <div class="x-small fw-bold">الشهادة المهنية</div>
                                                            <span class="badge bg-secondary-subtle text-secondary x-small mt-1">غير مرفق</span>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Card Footer: Full Actions (قبول، رفض) -->
                                <div class="p-3 bg-light border-top mt-auto d-flex flex-wrap gap-2">
                                    <button class="btn btn-success flex-grow-1 rounded-pill py-2 fw-bold shadow-sm d-flex align-items-center justify-content-center gap-2"
                                            @onclick="() => ApproveProvider(provider)">
                                        <i class="fa-solid fa-check fs-6"></i>
                                        <span>قبول واعتماد المزود</span>
                                    </button>
                                    <button class="btn btn-outline-danger flex-grow-1 rounded-pill py-2 fw-bold d-flex align-items-center justify-content-center gap-2"
                                            @onclick="() => RejectProvider(provider)">
                                        <i class="fa-solid fa-xmark fs-6"></i>
                                        <span>رفض الطلب</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        }

        @* ══════════════════════════════════════════════════════════════════════
           النوع 2: الخدمات الجديدة (Service Approval)
           ══════════════════════════════════════════════════════════════════════ *@
        @if (activeTab == "services")
        {
            @if (!filteredServices.Any())
            {
                <div class="glass-card p-5 text-center rounded-4 shadow-sm">
                    <i class="fa-solid @(HasActiveFilters ? "fa-magnifying-glass text-primary" : "fa-circle-check text-success") display-1 mb-3 opacity-25"></i>
                    <h4 class="fw-bold text-dark">@(HasActiveFilters ? "لا توجد نتائج مطابقة للفلاتر" : "لا توجد خدمات بانتظار المراجعة")</h4>
                    <p class="text-muted mb-0">@(HasActiveFilters ? "جرّب تعديل الفلاتر أو مسحها لعرض جميع الطلبات." : "تمت مراجعة واعتماد ونشر جميع الخدمات بنجاح.")</p>
                    @if (HasActiveFilters)
                    {
                        <button class="btn btn-outline-primary rounded-pill px-4 mt-3" @onclick="ClearFilters">مسح الفلاتر</button>
                    }
                </div>
            }
            else
            {
                <div class="row g-3 g-lg-4">
                    @foreach (var service in filteredServices)
                    {
                        var mainImg = service.Images?.FirstOrDefault();
                        var serviceImgUrl = Api.GetAbsoluteUrl(Khadamat.BlazorUI.Helpers.DefaultImages.GetServiceImage(mainImg, service.SubCategoryName, service.CategoryName, service.MainCategoryName));

                        <div class="col-12 col-lg-6">
                            <div class="approval-card glass-card p-0 rounded-4 overflow-hidden shadow-sm h-100 d-flex flex-column border">
                                <!-- Top Bar -->
                                <div class="p-3 bg-light border-bottom d-flex align-items-center justify-content-between gap-2">
                                    <div class="d-flex align-items-center gap-2 flex-wrap min-w-0">
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1 fw-bold">
                                            @service.CategoryName
                                        </span>
                                        @if (!string.IsNullOrEmpty(service.SubCategoryName))
                                        {
                                            <span class="badge bg-light text-muted border rounded-pill px-2 py-1 x-small">
                                                @service.SubCategoryName
                                            </span>
                                        }
                                    </div>
                                    <span class="x-small text-muted text-nowrap">
                                        <i class="fa-solid fa-clock me-1"></i>@service.CreatedAt.ToString("yyyy/MM/dd")
                                    </span>
                                </div>

                                <!-- Service Details Body -->
                                <div class="p-3 flex-grow-1 d-flex flex-column gap-3">
                                    <div class="d-flex align-items-start gap-3">
                                        <!-- Main Image with Clickable Zoom -->
                                        <div class="service-img-preview-box flex-shrink-0 cursor-pointer position-relative rounded-3 overflow-hidden shadow-2xs border"
                                             @onclick="() => PreviewImage(serviceImgUrl, service.Title)" title="انقر لتكبير الصورة">
                                            <img src="@serviceImgUrl" class="w-100 h-100 object-fit-cover" alt="@service.Title" />
                                            <div class="doc-hover-overlay">
                                                <i class="fa-solid fa-magnifying-glass-plus text-white"></i>
                                            </div>
                                        </div>

                                        <!-- Title & Price -->
                                        <div class="flex-grow-1 min-w-0">
                                            <h5 class="fw-bold mb-1 text-dark">@service.Title</h5>
                                            <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                                                @if (service.Price.HasValue && service.Price.Value > 0)
                                                {
                                                    <span class="badge bg-success-subtle text-success fs-6 fw-bold px-2 py-1">
                                                        @service.Price.Value.ToString("N0") ج.م
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary-subtle text-secondary px-2 py-1 small">
                                                        السعر حسب الاتفاق
                                                    </span>
                                                }

                                                @if (!string.IsNullOrEmpty(service.GovernorateName) || !string.IsNullOrEmpty(service.CityName))
                                                {
                                                    <span class="badge bg-light text-dark border small">
                                                        <i class="fa-solid fa-location-dot me-1 text-danger"></i>
                                                        @service.GovernorateName @(!string.IsNullOrEmpty(service.CityName) ? " - " + service.CityName : "")
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Description -->
                                    <div class="p-3 rounded-3 bg-light-subtle border">
                                        <div class="x-small fw-bold text-muted mb-1"><i class="fa-solid fa-align-right me-1 text-primary"></i>تفاصيل ووصف الخدمة:</div>
                                        <div class="small text-dark lh-base" style="white-space: pre-line;">@service.Description</div>
                                    </div>

                                    <!-- Additional Images Gallery (معرض صور الخدمة) -->
                                    @if (service.Images != null && service.Images.Count > 1)
                                    {
                                        <div>
                                            <div class="x-small fw-bold text-muted mb-1"><i class="fa-solid fa-images me-1 text-primary"></i>صور الخدمة المرفقة (@service.Images.Count صور):</div>
                                            <div class="d-flex gap-2 overflow-x-auto pb-1">
                                                @foreach (var img in service.Images)
                                                {
                                                    var fullImgUrl = Api.GetAbsoluteUrl(img);
                                                    <div class="gallery-thumb cursor-pointer border rounded-2 overflow-hidden position-relative flex-shrink-0"
                                                         style="width: 50px; height: 50px;"
                                                         @onclick="() => PreviewImage(fullImgUrl, service.Title)">
                                                        <img src="@fullImgUrl" class="w-100 h-100 object-fit-cover" alt="Service photo" />
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }

                                    <!-- Provider Info Bar -->
                                    <div class="p-2 rounded-3 bg-light border d-flex align-items-center justify-content-between gap-2 mt-auto">
                                        <div class="d-flex align-items-center gap-2 min-w-0">
                                            <img src="@Api.GetAbsoluteUrl(Khadamat.BlazorUI.Helpers.DefaultImages.GetUserAvatar(service.ProviderName, null, service.ProviderPhoto))"
                                                 class="rounded-circle border" width="34" height="34" alt="@service.ProviderName" />
                                            <div class="min-w-0">
                                                <div class="fw-bold small text-dark text-truncate">@service.ProviderName</div>
                                                <div class="x-small text-muted">صاحب الخدمة</div>
                                            </div>
                                        </div>

                                        @if (!string.IsNullOrEmpty(service.Phone1))
                                        {
                                            <div class="d-flex gap-1">
                                                <a href="tel:@service.Phone1" class="btn btn-xs btn-outline-primary rounded-circle" title="اتصال">
                                                    <i class="fa-solid fa-phone"></i>
                                                </a>
                                                <a href="@GetWhatsAppLink(service.Phone1)" target="_blank" class="btn btn-xs btn-outline-success rounded-circle" title="واتساب">
                                                    <i class="fa-brands fa-whatsapp"></i>
                                                </a>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <!-- Card Footer: Full Control (معاينة، قبول، رفض) -->
                                <div class="p-3 bg-light border-top d-flex flex-wrap gap-2">
                                    <button class="btn btn-outline-primary rounded-pill px-3 py-2 fw-bold d-flex align-items-center gap-1"
                                            @onclick='() => Navigation.NavigateTo($"/service/{service.Id}")' title="فتح صفحة الخدمة لمعاينتها كاملاً">
                                        <i class="fa-solid fa-eye"></i>
                                        <span>معاينة الخدمة</span>
                                    </button>
                                    <button class="btn btn-success flex-grow-1 rounded-pill py-2 fw-bold shadow-sm d-flex align-items-center justify-content-center gap-1"
                                            @onclick="() => ApproveService(service)">
                                        <i class="fa-solid fa-check"></i>
                                        <span>قبول ونشر الخدمة</span>
                                    </button>
                                    <button class="btn btn-outline-danger flex-grow-1 rounded-pill py-2 fw-bold d-flex align-items-center justify-content-center gap-1"
                                            @onclick="() => RejectService(service)">
                                        <i class="fa-solid fa-xmark"></i>
                                        <span>رفض الخدمة</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        }

        @* ══════════════════════════════════════════════════════════════════════
           النوع 3: طلبات التعديل (Service Edits)
           ══════════════════════════════════════════════════════════════════════ *@
        @if (activeTab == "edits")
        {
            @if (!filteredEdits.Any())
            {
                <div class="glass-card p-5 text-center rounded-4 shadow-sm">
                    <i class="fa-solid @(HasActiveFilters ? "fa-magnifying-glass text-primary" : "fa-circle-check text-success") display-1 mb-3 opacity-25"></i>
                    <h4 class="fw-bold text-dark">@(HasActiveFilters ? "لا توجد نتائج مطابقة للفلاتر" : "لا توجد طلبات تعديل معلقة")</h4>
                    <p class="text-muted mb-0">@(HasActiveFilters ? "جرّب تعديل الفلاتر أو مسحها لعرض جميع الطلبات." : "تمت معالجة جميع اقتراحات التعديل المقدمة.")</p>
                    @if (HasActiveFilters)
                    {
                        <button class="btn btn-outline-primary rounded-pill px-4 mt-3" @onclick="ClearFilters">مسح الفلاتر</button>
                    }
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var req in filteredEdits)
                    {
                        <div class="card border-0 shadow-sm rounded-4 overflow-hidden border">
                            <div class="card-header bg-white border-bottom py-3 px-4 d-flex flex-wrap justify-content-between align-items-center gap-2">
                                <div class="d-flex align-items-center gap-3 min-w-0">
                                    <div class="bg-primary-subtle p-2 rounded-3 text-primary flex-shrink-0">
                                        <i class="fa-solid fa-pen-to-square fs-5"></i>
                                    </div>
                                    <div class="min-w-0">
                                        <h6 class="mb-0 fw-bold text-truncate">@req.ServiceName</h6>
                                        <small class="text-muted">مقدم الطلب: @req.RequesterName | @req.CreatedAt.ToString("yyyy/MM/dd HH:mm")</small>
                                    </div>
                                </div>
                                <span class="badge bg-warning text-dark rounded-pill px-3">بانتظار المراجعة</span>
                            </div>
                            <div class="card-body p-4 bg-light-subtle">
                                <div class="row g-3">
                                    @if (!string.IsNullOrEmpty(req.ProposedName))
                                    {
                                        <div class="col-md-6">
                                            <div class="p-3 bg-white rounded-3 border">
                                                <small class="text-muted d-block mb-1">الاسم المقترح:</small>
                                                <strong>@req.ProposedName</strong>
                                            </div>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(req.ProposedPhone1))
                                    {
                                        <div class="col-md-6">
                                            <div class="p-3 bg-white rounded-3 border">
                                                <small class="text-muted d-block mb-1">الهاتف المقترح:</small>
                                                <strong dir="ltr">@req.ProposedPhone1</strong>
                                            </div>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(req.ProposedDescription))
                                    {
                                        <div class="col-12">
                                            <div class="p-3 bg-white rounded-3 border">
                                                <small class="text-muted d-block mb-1">الوصف المقترح:</small>
                                                <span>@req.ProposedDescription</span>
                                            </div>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(req.ProposedAddress))
                                    {
                                        <div class="col-12">
                                            <div class="p-3 bg-white rounded-3 border">
                                                <small class="text-muted d-block mb-1">العنوان المقترح:</small>
                                                <span>@req.ProposedAddress</span>
                                            </div>
                                        </div>
                                    }
                                </div>

                                <div class="d-flex flex-wrap justify-content-end gap-2 mt-3 pt-3 border-top">
                                    <button class="btn btn-sm btn-outline-primary rounded-pill px-4" @onclick="@(() => Navigation.NavigateTo($"/service/{req.ServiceId}"))">
                                        <i class="fa-solid fa-eye me-1"></i> معاينة الخدمة
                                    </button>
                                    <button class="btn btn-sm btn-success rounded-pill px-4" @onclick="() => ApproveEdit(req)">
                                        <i class="fa-solid fa-check me-1"></i> قبول التعديل
                                    </button>
                                    <button class="btn btn-sm btn-danger rounded-pill px-4" @onclick="() => RejectEdit(req)">
                                        <i class="fa-solid fa-xmark me-1"></i> رفض التعديل
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        }
    }
</div>

