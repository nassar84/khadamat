@code {
    [SupplyParameterFromQuery]
    public string? Tab { get; set; }

    private string activeTab = "providers";
    private string searchQuery = "";
    private bool isLoading = true;

    private List<PendingProviderDto> pendingProviders = new();
    private List<ServiceDto> pendingServices = new();
    private List<ServiceEditRequestDto> pendingEdits = new();

    // Modal state
    private bool isDocModalOpen = false;
    private string modalImageUrl = "";
    private string modalTitle = "";

    // Status toast
    private string? statusMessage;
    private string statusMessageType = "success";

    private int TotalPendingCount => pendingProviders.Count + pendingServices.Count + pendingEdits.Count;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(Tab))
        {
            activeTab = Tab.ToLower();
        }

        await ReloadAllAsync();
    }

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(Tab) && Tab.ToLower() != activeTab)
        {
            activeTab = Tab.ToLower();
        }
    }

    private void SetTab(string tab)
    {
        activeTab = tab;
    }

    private async Task ReloadAllAsync()
    {
        isLoading = true;
        statusMessage = null;
        try
        {
            var pTask = AdminService.GetPendingProviders();
            var sTask = Api.GetServicesAsync(page: 1, isApproved: false);
            var eTask = AdminService.GetServiceEditRequests("Pending");

            await Task.WhenAll(pTask, sTask, eTask);

            pendingProviders = pTask.Result ?? new();
            pendingServices = sTask.Result?.Items ?? new();
            pendingEdits = eTask.Result ?? new();

            UpdateGlobalCount();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ApprovalsHub] Error loading approvals: {ex.Message}");
            statusMessage = "حدث خطأ أثناء تحميل بيانات الطلبات: " + ex.Message;
            statusMessageType = "danger";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void UpdateGlobalCount()
    {
        State.PendingApprovalsCount = TotalPendingCount;
    }

    private IEnumerable<PendingProviderDto> FilteredProviders
    {
        get
        {
            if (string.IsNullOrWhiteSpace(searchQuery)) return pendingProviders;
            var q = searchQuery.Trim().ToLower();
            return pendingProviders.Where(p =>
                (p.Name != null && p.Name.ToLower().Contains(q)) ||
                (p.BusinessName != null && p.BusinessName.ToLower().Contains(q)) ||
                (p.Phone != null && p.Phone.Contains(q)) ||
                (p.City != null && p.City.ToLower().Contains(q)) ||
                (p.Expertise != null && p.Expertise.ToLower().Contains(q)));
        }
    }

    private IEnumerable<ServiceDto> FilteredServices
    {
        get
        {
            if (string.IsNullOrWhiteSpace(searchQuery)) return pendingServices;
            var q = searchQuery.Trim().ToLower();
            return pendingServices.Where(s =>
                (s.Title != null && s.Title.ToLower().Contains(q)) ||
                (s.CategoryName != null && s.CategoryName.ToLower().Contains(q)) ||
                (s.SubCategoryName != null && s.SubCategoryName.ToLower().Contains(q)) ||
                (s.ProviderName != null && s.ProviderName.ToLower().Contains(q)) ||
                (s.Phone1 != null && s.Phone1.Contains(q)) ||
                (s.CityName != null && s.CityName.ToLower().Contains(q)));
        }
    }

    private string GetWhatsAppLink(string? phone)
    {
        if (string.IsNullOrWhiteSpace(phone)) return "#";
        var clean = new string(phone.Where(char.IsDigit).ToArray());
        if (clean.StartsWith("0")) clean = "2" + clean;
        return $"https://wa.me/{clean}";
    }

    // ── معاينة المستندات والصور ──
    private void ViewDoc(PendingProviderDto provider, string type)
    {
        var rawUrl = type == "ID" ? provider.IdCardImage : provider.CertificateImage;
        if (string.IsNullOrEmpty(rawUrl)) return;

        modalTitle = type == "ID" ? $"البطاقة الشخصية: {provider.Name}" : $"الشهادة المهنية: {provider.Name}";
        modalImageUrl = Api.GetAbsoluteUrl(rawUrl);
        isDocModalOpen = true;
    }

    private void PreviewImage(string imageUrl, string title)
    {
        modalTitle = title;
        modalImageUrl = imageUrl;
        isDocModalOpen = true;
    }

    private void CloseDocModal()
    {
        isDocModalOpen = false;
        modalImageUrl = "";
        modalTitle = "";
    }

    // ── مزودي الخدمات: قبول ورفض ──
    private async Task ApproveProvider(PendingProviderDto provider)
    {
        if (await JS.InvokeAsync<bool>("confirm", $"هل أنت متأكد من اعتماد مقدم الخدمة {provider.Name} وتفعيل حسابه كصاحب خدمة معتمد؟"))
        {
            try
            {
                await AdminService.ApproveProvider(provider.Id);
                pendingProviders.Remove(provider);
                UpdateGlobalCount();
                statusMessage = $"تم قبول واعتماد مزود الخدمة ({provider.Name}) بنجاح!";
                statusMessageType = "success";
                StateHasChanged();
            }
            catch (Exception ex)
            {
                statusMessage = "فشل اعتماد المزود: " + ex.Message;
                statusMessageType = "danger";
            }
        }
    }

    private async Task RejectProvider(PendingProviderDto provider)
    {
        if (await JS.InvokeAsync<bool>("confirm", $"هل تريد بالتأكيد رفض طلب انضمام {provider.Name}؟"))
        {
            try
            {
                await AdminService.RejectProvider(provider.Id);
                pendingProviders.Remove(provider);
                UpdateGlobalCount();
                statusMessage = $"تم رفض طلب انضمام ({provider.Name}).";
                statusMessageType = "warning";
                StateHasChanged();
            }
            catch (Exception ex)
            {
                statusMessage = "فشل رفض الطلب: " + ex.Message;
                statusMessageType = "danger";
            }
        }
    }

    // ── الخدمات الجديدة: قبول ورفض ──
    private async Task ApproveService(ServiceDto service)
    {
        if (await JS.InvokeAsync<bool>("confirm", $"هل أنت متأكد من اعتماد ونشر خدمة ({service.Title})؟"))
        {
            try
            {
                await AdminService.ApproveService(service.Id);
                pendingServices.Remove(service);
                UpdateGlobalCount();
                statusMessage = $"تم اعتماد ونشر خدمة ({service.Title}) بنجاح!";
                statusMessageType = "success";
                StateHasChanged();
            }
            catch (Exception ex)
            {
                statusMessage = "فشل اعتماد الخدمة: " + ex.Message;
                statusMessageType = "danger";
            }
        }
    }

    private async Task RejectService(ServiceDto service)
    {
        if (await JS.InvokeAsync<bool>("confirm", $"هل تريد بالتأكيد رفض خدمة ({service.Title})؟"))
        {
            try
            {
                await AdminService.RejectService(service.Id);
                pendingServices.Remove(service);
                UpdateGlobalCount();
                statusMessage = $"تم رفض خدمة ({service.Title}).";
                statusMessageType = "warning";
                StateHasChanged();
            }
            catch (Exception ex)
            {
                statusMessage = "فشل رفض الخدمة: " + ex.Message;
                statusMessageType = "danger";
            }
        }
    }

    // ── تعديلات الخدمات ──
    private async Task ApproveEdit(ServiceEditRequestDto req)
    {
        if (await JS.InvokeAsync<bool>("confirm", "قبول واعتماد هذه التعديلات المقترحة على الخدمة؟"))
        {
            try
            {
                var cmd = new UpdateServiceEditRequestCommand
                {
                    RequestId = req.Id,
                    Status = "Approved",
                    ApproveName = true,
                    ApproveDescription = true,
                    ApprovePrice = true,
                    ApproveAddress = true,
                    ApprovePhone1 = true,
                    ApprovePhone2 = true,
                    ApproveWhatsApp = true
                };
                await AdminService.UpdateServiceEditRequestStatus(req.Id, cmd);
                pendingEdits.Remove(req);
                UpdateGlobalCount();
                statusMessage = $"تم قبول التعديلات على خدمة ({req.ServiceName}) بنجاح!";
                statusMessageType = "success";
                StateHasChanged();
            }
            catch (Exception ex)
            {
                statusMessage = "فشل اعتماد التعديل: " + ex.Message;
                statusMessageType = "danger";
            }
        }
    }

    private async Task RejectEdit(ServiceEditRequestDto req)
    {
        if (await JS.InvokeAsync<bool>("confirm", "رفض مقترح التعديل هذا؟"))
        {
            try
            {
                var cmd = new UpdateServiceEditRequestCommand
                {
                    RequestId = req.Id,
                    Status = "Rejected"
                };
                await AdminService.UpdateServiceEditRequestStatus(req.Id, cmd);
                pendingEdits.Remove(req);
                UpdateGlobalCount();
                statusMessage = $"تم رفض التعديل على خدمة ({req.ServiceName}).";
                statusMessageType = "warning";
                StateHasChanged();
            }
            catch (Exception ex)
            {
                statusMessage = "فشل رفض التعديل: " + ex.Message;
                statusMessageType = "danger";
            }
        }
    }
}
