@page "/admin/approvals"
@using Khadamat.Application.DTOs
@using Khadamat.BlazorUI.Services
@using Khadamat.BlazorUI.Services.Admin
@using Khadamat.Application.Features.Services.Commands
@inject ApiClient Api
@inject IAdminService AdminService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject Khadamat.BlazorUI.State.AppState State

<PageTitle>مركز طلبات الموافقة والاعتماد</PageTitle>

<div class="px-2 pb-5">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2">
                <h4 class="fw-bold mb-0">مركز طلبات الموافقة</h4>
                @if (TotalPendingCount > 0)
                {
                    <span class="badge rounded-pill bg-danger px-3 py-2 fs-6">
                        @TotalPendingCount بانتظار المراجعة
                    </span>
                }
                else
                {
                    <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle px-3 py-2">
                        <i class="fa-solid fa-check me-1"></i> مكتمل
                    </span>
                }
            </div>
            <p class="text-muted small mb-0 mt-1">مراجعة واعتماد طلبات الانضمام والخدمات والتعديلات المعلقة للمدير الخارق</p>
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-outline-primary rounded-pill px-3" @onclick="ReloadAllAsync">
                <i class="fa-solid fa-rotate me-1"></i> تحديث الكل
            </button>
        </div>
    </div>

    <!-- Navigation Tabs -->
    <div class="approval-tabs glass-card p-2 mb-4 d-flex gap-2 overflow-x-auto">
        <button class="tab-btn flex-fill @(activeTab == "providers" ? "active" : "")" @onclick='() => SetTab("providers")'>
            <i class="fa-solid fa-user-check me-2"></i>
            <span>مقدمي الخدمات</span>
            @if (pendingProviders.Count > 0)
            {
                <span class="tab-badge bg-danger text-white">@pendingProviders.Count</span>
            }
        </button>

        <button class="tab-btn flex-fill @(activeTab == "services" ? "active" : "")" @onclick='() => SetTab("services")'>
            <i class="fa-solid fa-briefcase me-2"></i>
            <span>الخدمات الجديدة</span>
            @if (pendingServices.Count > 0)
            {
                <span class="tab-badge bg-warning text-dark">@pendingServices.Count</span>
            }
        </button>

        <button class="tab-btn flex-fill @(activeTab == "edits" ? "active" : "")" @onclick='() => SetTab("edits")'>
            <i class="fa-solid fa-pen-to-square me-2"></i>
            <span>تعديلات الخدمات</span>
            @if (pendingEdits.Count > 0)
            {
                <span class="tab-badge bg-info text-dark">@pendingEdits.Count</span>
            }
        </button>
    </div>

    <!-- Content Area -->
    @if (isLoading)
    {
        <div class="text-center p-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted small">جاري تحميل طلبات الموافقة...</p>
        </div>
    }
    else
    {
        @* ── TAB 1: مقدمي الخدمات ── *@
        @if (activeTab == "providers")
        {
            @if (!pendingProviders.Any())
            {
                <div class="glass-card p-5 text-center">
                    <i class="fa-solid fa-circle-check text-success display-1 mb-3 opacity-25"></i>
                    <h5 class="fw-bold">لا توجد طلبات انضمام معلقة</h5>
                    <p class="text-muted">تمت مراجعة جميع طلبات مقدمي الخدمات بنجاح.</p>
                </div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var provider in pendingProviders)
                    {
                        <div class="col-12 col-md-6 col-lg-4">
                            <div class="glass-card p-0 overflow-hidden border-0 shadow-sm h-100 animate-up">
                                <div class="p-3 bg-light d-flex align-items-center gap-3 border-bottom">
                                    <img src="@Khadamat.BlazorUI.Helpers.DefaultImages.GetUserAvatar(provider.Name)" class="rounded-circle shadow-sm" width="50" height="50" alt="@provider.Name" />
                                    <div>
                                        <h6 class="fw-bold mb-0">@provider.Name</h6>
                                        <span class="small text-muted">@provider.Expertise</span>
                                    </div>
                                </div>
                                <div class="p-3">
                                    <div class="small mb-3">
                                        <div class="mb-1"><i class="fa-solid fa-envelope me-2 text-primary opacity-50"></i> @provider.Email</div>
                                        <div class="mb-1"><i class="fa-solid fa-phone me-2 text-primary opacity-50"></i> @provider.Phone</div>
                                        <div class="mb-1"><i class="fa-solid fa-location-dot me-2 text-primary opacity-50"></i> @provider.City</div>
                                    </div>

                                    <div class="docs-preview d-flex gap-2 mb-3">
                                        <div class="doc-item flex-grow-1 p-2 rounded-3 bg-light text-center cursor-pointer" @onclick='() => ViewDoc(provider, "ID")'>
                                            <i class="fa-solid fa-id-card d-block mb-1 text-muted"></i>
                                            <span class="x-small fw-bold">البطاقة الشخصية</span>
                                        </div>
                                        <div class="doc-item flex-grow-1 p-2 rounded-3 bg-light text-center cursor-pointer" @onclick='() => ViewDoc(provider, "Certificate")'>
                                            <i class="fa-solid fa-certificate d-block mb-1 text-muted"></i>
                                            <span class="x-small fw-bold">الشهادات</span>
                                        </div>
                                    </div>

                                    <div class="d-flex gap-2">
                                        <button class="btn btn-success flex-grow-1 rounded-pill btn-sm py-2" @onclick="() => ApproveProvider(provider)">
                                            <i class="fa-solid fa-check me-1"></i> قبول
                                        </button>
                                        <button class="btn btn-danger flex-grow-1 rounded-pill btn-sm py-2" @onclick="() => RejectProvider(provider)">
                                            <i class="fa-solid fa-xmark me-1"></i> رفض
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        }

        @* ── TAB 2: الخدمات الجديدة ── *@
        @if (activeTab == "services")
        {
            @if (!pendingServices.Any())
            {
                <div class="glass-card p-5 text-center">
                    <i class="fa-solid fa-circle-check text-success display-1 mb-3 opacity-25"></i>
                    <h5 class="fw-bold">لا توجد خدمات بانتظار المراجعة</h5>
                    <p class="text-muted">تمت مراجعة جميع الخدمات المنشورة.</p>
                </div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var service in pendingServices)
                    {
                        <div class="col-12 col-md-6 col-lg-4">
                            <div class="glass-card p-3 border-0 shadow-sm rounded-4 h-100 d-flex flex-direction-column justify-content-between">
                                <div>
                                    <div class="d-flex align-items-start gap-3 mb-3">
                                        <img src="@Api.GetAbsoluteUrl(Khadamat.BlazorUI.Helpers.DefaultImages.GetServiceImage(service.Images?.FirstOrDefault(), service.SubCategoryName, service.CategoryName, service.MainCategoryName))"
                                             class="rounded-3 object-fit-cover flex-shrink-0" width="64" height="64" alt="@service.Title" />
                                        <div class="flex-grow-1 min-w-0">
                                            <div class="fw-bold text-dark text-truncate mb-1">@service.Title</div>
                                            <div class="small text-muted text-truncate mb-1">@service.Description</div>
                                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                                <span class="badge bg-light text-dark border" style="font-size:0.7rem;">@service.CategoryName</span>
                                                @if (service.Price.HasValue)
                                                {
                                                    <span class="badge bg-primary-subtle text-primary" style="font-size:0.7rem;">@service.Price.Value.ToString("N0") ج.م</span>
                                                }
                                            </div>
                                        </div>
                                    </div>

                                    <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
                                        <img src="@Api.GetAbsoluteUrl(Khadamat.BlazorUI.Helpers.DefaultImages.GetUserAvatar(service.ProviderName, null, service.ProviderPhoto))"
                                             class="rounded-circle flex-shrink-0" width="28" height="28" alt="@service.ProviderName" />
                                        <div class="small">
                                            <span class="fw-bold">@service.ProviderName</span>
                                            @if (!string.IsNullOrEmpty(service.CityName))
                                            {
                                                <span class="text-muted"> - @service.CityName</span>
                                            }
                                        </div>
                                        <div class="ms-auto x-small text-muted">@service.CreatedAt.ToString("dd/MM")</div>
                                    </div>
                                </div>

                                <div class="d-flex gap-2 mt-2">
                                    <button class="btn btn-sm btn-outline-primary rounded-pill px-3 flex-grow-1" @onclick="@(() => Navigation.NavigateTo($"/service/{service.Id}"))">
                                        <i class="fa-solid fa-eye me-1"></i> عرض
                                    </button>
                                    <button class="btn btn-sm btn-success rounded-pill px-3 flex-grow-1" @onclick="() => ApproveService(service)">
                                        <i class="fa-solid fa-check me-1"></i> قبول
                                    </button>
                                    <button class="btn btn-sm btn-danger rounded-pill px-3 flex-grow-1" @onclick="() => RejectService(service)">
                                        <i class="fa-solid fa-xmark me-1"></i> رفض
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        }

        @* ── TAB 3: تعديلات الخدمات ── *@
        @if (activeTab == "edits")
        {
            @if (!pendingEdits.Any())
            {
                <div class="glass-card p-5 text-center">
                    <i class="fa-solid fa-circle-check text-success display-1 mb-3 opacity-25"></i>
                    <h5 class="fw-bold">لا توجد طلبات تعديل معلقة</h5>
                    <p class="text-muted">تمت معالجة جميع اقتراحات التعديل المقدمة.</p>
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var req in pendingEdits)
                    {
                        <div class="card border-0 shadow-sm edit-request-card rounded-4 overflow-hidden">
                            <div class="card-header bg-white border-0 py-3 px-4 d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="bg-primary-subtle p-2 rounded-3">
                                        <i class="fa-solid fa-pen-to-square text-primary"></i>
                                    </div>
                                    <div>
                                        <h6 class="mb-0 fw-bold">@req.ServiceName</h6>
                                        <small class="text-muted">بواسطة: @req.RequesterName | @req.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                                    </div>
                                </div>
                                <span class="badge bg-warning text-dark rounded-pill px-3">معلق</span>
                            </div>
                            <div class="card-body p-4 bg-light-subtle">
                                <div class="row g-3">
                                    @if (!string.IsNullOrEmpty(req.ProposedName))
                                    {
                                        <div class="col-md-6">
                                            <div class="p-2 bg-white rounded-3 border">
                                                <small class="text-muted d-block">الاسم المقترح:</small>
                                                <strong>@req.ProposedName</strong>
                                            </div>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(req.ProposedPhone1))
                                    {
                                        <div class="col-md-6">
                                            <div class="p-2 bg-white rounded-3 border">
                                                <small class="text-muted d-block">الهاتف المقترح:</small>
                                                <strong>@req.ProposedPhone1</strong>
                                            </div>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(req.ProposedDescription))
                                    {
                                        <div class="col-12">
                                            <div class="p-2 bg-white rounded-3 border">
                                                <small class="text-muted d-block">الوصف المقترح:</small>
                                                <span>@req.ProposedDescription</span>
                                            </div>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(req.ProposedAddress))
                                    {
                                        <div class="col-12">
                                            <div class="p-2 bg-white rounded-3 border">
                                                <small class="text-muted d-block">العنوان المقترح:</small>
                                                <span>@req.ProposedAddress</span>
                                            </div>
                                        </div>
                                    }
                                </div>

                                <div class="d-flex justify-content-end gap-2 mt-3 pt-3 border-top">
                                    <button class="btn btn-sm btn-outline-primary rounded-pill px-4" @onclick="@(() => Navigation.NavigateTo($"/service/{req.ServiceId}"))">
                                        <i class="fa-solid fa-eye me-1"></i> معاينة الخدمة
                                    </button>
                                    <button class="btn btn-sm btn-success rounded-pill px-4" @onclick="() => ApproveEdit(req)">
                                        <i class="fa-solid fa-check me-1"></i> قبول التعديل
                                    </button>
                                    <button class="btn btn-sm btn-danger rounded-pill px-4" @onclick="() => RejectEdit(req)">
                                        <i class="fa-solid fa-xmark me-1"></i> رفض التعديل
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        }
    }
</div>

@* Modal لعرض مستندات مقدم الخدمة *@
@if (selectedDocProvider != null)
{
    <div class="modal-overlay" @onclick="() => selectedDocProvider = null">
        <div class="glass-card p-4 rounded-4 w-75 animate-pop text-center" @onclick:stopPropagation="true">
            <h5 class="fw-bold mb-3">مستند: @(selectedDocType == "ID" ? "البطاقة الشخصية" : "الشهادة المهنية")</h5>
            <img src="@GetSelectedDocImage()" class="img-fluid rounded-4 mb-3 shadow-lg" style="max-height: 80vh;" alt="Document" />
            <button class="btn btn-light rounded-pill px-5" @onclick="() => selectedDocProvider = null">إغلاق</button>
        </div>
    </div>
}

<style>
    .approval-tabs {
        background: #ffffff;
        border-radius: 14px;
        border: 1px solid rgba(0,0,0,0.06);
    }
    .tab-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 10px 18px;
        border-radius: 10px;
        border: none;
        background: transparent;
        color: var(--text-secondary);
        font-weight: 600;
        font-size: 0.9rem;
        transition: all 0.2s;
        cursor: pointer;
        white-space: nowrap;
    }
    .tab-btn:hover {
        background: #f8fafc;
        color: var(--theme-primary);
    }
    .tab-btn.active {
        background: var(--theme-primary);
        color: #ffffff;
        box-shadow: 0 4px 12px rgba(var(--theme-primary-rgb, 99, 102, 241), 0.25);
    }
    .tab-badge {
        margin-inline-start: 8px;
        padding: 2px 8px;
        border-radius: 10px;
        font-size: 0.75rem;
        font-weight: 700;
    }

    .doc-item {
        transition: all 0.2s;
        border: 1px solid transparent;
    }
    .doc-item:hover {
        background: #fff !important;
        border-color: var(--theme-primary);
        color: var(--theme-primary);
        transform: translateY(-2px);
    }

    .modal-overlay {
        position: fixed; inset: 0; z-index: 2000;
        background: rgba(0,0,0,0.6);
        backdrop-filter: blur(8px);
        display: flex; align-items: center; justify-content: center;
    }
    .animate-pop {
        animation: pop 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    @@keyframes pop {
        from { transform: scale(0.85); opacity: 0; }
        to { transform: scale(1); opacity: 1; }
    }
    .x-small { font-size: 0.75rem; }
</style>

@code {
    [SupplyParameterFromQuery]
    public string? Tab { get; set; }

    private string activeTab = "providers";
    private bool isLoading = true;

    private List<PendingProviderDto> pendingProviders = new();
    private List<ServiceDto> pendingServices = new();
    private List<ServiceEditRequestDto> pendingEdits = new();

    private PendingProviderDto? selectedDocProvider;
    private string selectedDocType = "";

    private int TotalPendingCount => pendingProviders.Count + pendingServices.Count + pendingEdits.Count;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(Tab))
        {
            activeTab = Tab.ToLower();
        }

        await ReloadAllAsync();
    }

    private void SetTab(string tab)
    {
        activeTab = tab;
    }

    private async Task ReloadAllAsync()
    {
        isLoading = true;
        try
        {
            var pTask = AdminService.GetPendingProviders();
            var sTask = Api.GetServicesAsync(page: 1, isApproved: false);
            var eTask = AdminService.GetServiceEditRequests("Pending");

            await Task.WhenAll(pTask, sTask, eTask);

            pendingProviders = pTask.Result ?? new();
            pendingServices = sTask.Result?.Items ?? new();
            pendingEdits = eTask.Result ?? new();

            UpdateGlobalCount();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ApprovalsHub] Error loading approvals: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void UpdateGlobalCount()
    {
        State.PendingApprovalsCount = TotalPendingCount;
    }

    // ── مزودي الخدمات ──
    private void ViewDoc(PendingProviderDto provider, string type)
    {
        selectedDocProvider = provider;
        selectedDocType = type;
    }

    private string GetSelectedDocImage()
    {
        if (selectedDocProvider == null) return "";
        return selectedDocType == "ID" ? selectedDocProvider.IdCardImage : selectedDocProvider.CertificateImage;
    }

    private async Task ApproveProvider(PendingProviderDto provider)
    {
        if (await JS.InvokeAsync<bool>("confirm", $"تأكيد اعتماد مقدم الخدمة {provider.Name}؟"))
        {
            await AdminService.ApproveProvider(provider.Id);
            pendingProviders.Remove(provider);
            UpdateGlobalCount();
            StateHasChanged();
        }
    }

    private async Task RejectProvider(PendingProviderDto provider)
    {
        if (await JS.InvokeAsync<bool>("confirm", $"هل تريد رفض طلب {provider.Name}؟"))
        {
            await AdminService.RejectProvider(provider.Id);
            pendingProviders.Remove(provider);
            UpdateGlobalCount();
            StateHasChanged();
        }
    }

    // ── الخدمات الجديدة ──
    private async Task ApproveService(ServiceDto service)
    {
        if (await JS.InvokeAsync<bool>("confirm", $"تأكيد نشر واعتماد خدمة {service.Title}؟"))
        {
            await AdminService.ApproveService(service.Id);
            pendingServices.Remove(service);
            UpdateGlobalCount();
            StateHasChanged();
        }
    }

    private async Task RejectService(ServiceDto service)
    {
        if (await JS.InvokeAsync<bool>("confirm", $"هل تريد رفض خدمة {service.Title}؟"))
        {
            await AdminService.RejectService(service.Id);
            pendingServices.Remove(service);
            UpdateGlobalCount();
            StateHasChanged();
        }
    }

    // ── تعديلات الخدمات ──
    private async Task ApproveEdit(ServiceEditRequestDto req)
    {
        if (await JS.InvokeAsync<bool>("confirm", "قبول واعتماد هذه التعديلات على الخدمة؟"))
        {
            var cmd = new UpdateServiceEditRequestCommand
            {
                RequestId = req.Id,
                Status = "Approved",
                ApproveName = true,
                ApproveDescription = true,
                ApprovePrice = true,
                ApproveAddress = true,
                ApprovePhone1 = true,
                ApprovePhone2 = true,
                ApproveWhatsApp = true
            };
            await AdminService.UpdateServiceEditRequestStatus(req.Id, cmd);
            pendingEdits.Remove(req);
            UpdateGlobalCount();
            StateHasChanged();
        }
    }

    private async Task RejectEdit(ServiceEditRequestDto req)
    {
        if (await JS.InvokeAsync<bool>("confirm", "رفض مقترح التعديل هذا؟"))
        {
            var cmd = new UpdateServiceEditRequestCommand
            {
                RequestId = req.Id,
                Status = "Rejected"
            };
            await AdminService.UpdateServiceEditRequestStatus(req.Id, cmd);
            pendingEdits.Remove(req);
            UpdateGlobalCount();
            StateHasChanged();
        }
    }
}
