@code {
    [SupplyParameterFromQuery]
    public string? Tab { get; set; }

    private string activeTab = "providers";
    private string searchQuery = "";
    private bool isLoading = true;

    private List<PendingProviderDto> pendingProviders = new();
    private List<ServiceDto> pendingServices = new();
    private List<ServiceEditRequestDto> pendingEdits = new();

    // ── Filters ──
    private string? filterCategory;
    private string? filterProvider;
    private string? filterCity;
    private DateTime? dateFrom;
    private DateTime? dateTo;

    /// <summary>default = فئة الخدمة ← التاريخ ← صاحب الخدمة ← أبجدى، أو الترتيب بالتاريخ فقط.</summary>
    private string sortMode = "default";

    // Modal state
    private bool isDocModalOpen = false;
    private string modalImageUrl = "";
    private string modalTitle = "";

    // Status toast
    private string? statusMessage;
    private string statusMessageType = "success";

    private int TotalPendingCount => pendingProviders.Count + pendingServices.Count + pendingEdits.Count;

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(searchQuery) ||
        !string.IsNullOrWhiteSpace(filterCategory) ||
        !string.IsNullOrWhiteSpace(filterProvider) ||
        !string.IsNullOrWhiteSpace(filterCity) ||
        dateFrom.HasValue || dateTo.HasValue;

    protected override async Task OnInitializedAsync()
    {
        ApplyTabFromQuery();
        await ReloadAllAsync();
    }

    protected override void OnParametersSet()
    {
        ApplyTabFromQuery();
    }

    private void ApplyTabFromQuery()
    {
        if (string.IsNullOrWhiteSpace(Tab)) return;
        var t = Tab.Trim().ToLowerInvariant();
        if (t is "providers" or "services" or "edits") activeTab = t;
    }

    // ── أزرار اختيار النوع (ليست Tab Controller) ──
    private void SetTab(string tab)
    {
        if (activeTab == tab) return;
        activeTab = tab;
        // مسح الفلاتر الخاصة بالنوع السابق حتى لا تُفلتر القائمة الجديدة بشكل غير مقصود
        filterCategory = null;
        filterProvider = null;
        filterCity = null;
        dateFrom = null;
        dateTo = null;
    }

    private void ClearFilters()
    {
        searchQuery = "";
        filterCategory = null;
        filterProvider = null;
        filterCity = null;
        dateFrom = null;
        dateTo = null;
    }

    private async Task ReloadAllAsync()
    {
        isLoading = true;
        statusMessage = null;
        try
        {
            var pTask = AdminService.GetPendingProviders();
            // لاحظ: يجب تمرير pageSize كبير وإلا لن تُجلب إلا أول 10 خدمات
            var sTask = Api.GetServicesAsync(page: 1, pageSize: 200, isApproved: false);
            var eTask = AdminService.GetServiceEditRequests("Pending");

            await Task.WhenAll(pTask, sTask, eTask);

            pendingProviders = pTask.Result ?? new();
            pendingServices = sTask.Result?.Items ?? new();
            pendingEdits = eTask.Result ?? new();

            UpdateGlobalCount();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ApprovalsHub] Error loading approvals: {ex.Message}");
            statusMessage = "حدث خطأ أثناء تحميل بيانات الطلبات: " + ex.Message;
            statusMessageType = "danger";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void UpdateGlobalCount()
    {
        State.PendingApprovalsCount = TotalPendingCount;
    }

    // ── قوائم الفلترة (من البيانات المتاحة فعلياً) ──
    private IEnumerable<string> CategoryOptions =>
        pendingServices.Select(s => s.CategoryName)
            .Where(v => !string.IsNullOrWhiteSpace(v))
            .Distinct()
            .OrderBy(v => v, StringComparer.CurrentCulture);

    private IEnumerable<string> ServiceProviderOptions =>
        pendingServices.Select(s => s.ProviderName)
            .Where(v => !string.IsNullOrWhiteSpace(v))
            .Distinct()
            .OrderBy(v => v, StringComparer.CurrentCulture);

    private IEnumerable<string> ServiceCityOptions =>
        pendingServices.Select(s => s.CityName)
            .Where(v => !string.IsNullOrWhiteSpace(v))
            .Select(v => v!)
            .Distinct()
            .OrderBy(v => v, StringComparer.CurrentCulture);

    private IEnumerable<string> ProviderCityOptions =>
        pendingProviders.Select(p => p.City)
            .Where(v => !string.IsNullOrWhiteSpace(v))
            .Distinct()
            .OrderBy(v => v, StringComparer.CurrentCulture);

    private IEnumerable<string> ProviderNameOptions =>
        pendingProviders.Select(DisplayProviderName)
            .Where(v => !string.IsNullOrWhiteSpace(v))
            .Distinct()
            .OrderBy(v => v, StringComparer.CurrentCulture);

    private IEnumerable<string> RequesterOptions =>
        pendingEdits.Select(e => e.RequesterName)
            .Where(v => !string.IsNullOrWhiteSpace(v))
            .Distinct()
            .OrderBy(v => v, StringComparer.CurrentCulture);

    private static string DisplayProviderName(PendingProviderDto p) =>
        string.IsNullOrWhiteSpace(p.BusinessName) ? (p.Name ?? "") : p.BusinessName;

    private static bool Has(string? haystack, string needle) =>
        !string.IsNullOrEmpty(haystack) && haystack.ToLowerInvariant().Contains(needle);

    private bool InDateRange(DateTime dt)
    {
        if (dateFrom.HasValue && dt.Date < dateFrom.Value.Date) return false;
        if (dateTo.HasValue && dt.Date > dateTo.Value.Date) return false;
        return true;
    }

    // ── القوائم المفلترة والمرتبة ──
    // الترتيب المطلوب: فئة الخدمة ثم التاريخ ثم صاحب الخدمة ثم أبجدي
    private List<PendingProviderDto> FilteredProviders
    {
        get
        {
            IEnumerable<PendingProviderDto> q = pendingProviders;

            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                var t = searchQuery.Trim().ToLowerInvariant();
                q = q.Where(p =>
                    Has(p.Name, t) || Has(p.BusinessName, t) || Has(p.Phone, t) ||
                    Has(p.City, t) || Has(p.Expertise, t) || Has(p.Email, t));
            }
            if (!string.IsNullOrWhiteSpace(filterCity)) q = q.Where(p => p.City == filterCity);
            if (!string.IsNullOrWhiteSpace(filterProvider)) q = q.Where(p => DisplayProviderName(p) == filterProvider);
            q = q.Where(p => InDateRange(p.JoinedAt));

            return (sortMode switch
            {
                "date_asc" => q.OrderBy(p => p.JoinedAt),
                "date_desc" => q.OrderByDescending(p => p.JoinedAt),
                _ => q.OrderBy(p => p.City, StringComparer.CurrentCulture)
                      .ThenByDescending(p => p.JoinedAt)
                      .ThenBy(p => DisplayProviderName(p), StringComparer.CurrentCulture)
                      .ThenBy(p => p.Name, StringComparer.CurrentCulture)
            }).ToList();
        }
    }

    private List<ServiceDto> FilteredServices
    {
        get
        {
            IEnumerable<ServiceDto> q = pendingServices;

            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                var t = searchQuery.Trim().ToLowerInvariant();
                q = q.Where(s =>
                    Has(s.Title, t) || Has(s.CategoryName, t) || Has(s.SubCategoryName, t) ||
                    Has(s.ProviderName, t) || Has(s.Phone1, t) || Has(s.CityName, t));
            }
            if (!string.IsNullOrWhiteSpace(filterCategory)) q = q.Where(s => s.CategoryName == filterCategory);
            if (!string.IsNullOrWhiteSpace(filterProvider)) q = q.Where(s => s.ProviderName == filterProvider);
            if (!string.IsNullOrWhiteSpace(filterCity)) q = q.Where(s => s.CityName == filterCity);
            q = q.Where(s => InDateRange(s.CreatedAt));

            return (sortMode switch
            {
                "date_asc" => q.OrderBy(s => s.CreatedAt),
                "date_desc" => q.OrderByDescending(s => s.CreatedAt),
                _ => q.OrderBy(s => s.CategoryName, StringComparer.CurrentCulture)
                      .ThenByDescending(s => s.CreatedAt)
                      .ThenBy(s => s.ProviderName, StringComparer.CurrentCulture)
                      .ThenBy(s => s.Title, StringComparer.CurrentCulture)
            }).ToList();
        }
    }

    private List<ServiceEditRequestDto> FilteredEdits
    {
        get
        {
            IEnumerable<ServiceEditRequestDto> q = pendingEdits;

            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                var t = searchQuery.Trim().ToLowerInvariant();
                q = q.Where(e =>
                    Has(e.ServiceName, t) || Has(e.RequesterName, t) ||
                    Has(e.ProposedName, t) || Has(e.ProposedPhone1, t) || Has(e.ProposedAddress, t));
            }
            if (!string.IsNullOrWhiteSpace(filterProvider)) q = q.Where(e => e.RequesterName == filterProvider);
            q = q.Where(e => InDateRange(e.CreatedAt));

            return (sortMode switch
            {
                "date_asc" => q.OrderBy(e => e.CreatedAt),
                "date_desc" => q.OrderByDescending(e => e.CreatedAt),
                _ => q.OrderByDescending(e => e.CreatedAt)
                      .ThenBy(e => e.RequesterName, StringComparer.CurrentCulture)
                      .ThenBy(e => e.ServiceName, StringComparer.CurrentCulture)
            }).ToList();
        }
    }

    private string GetWhatsAppLink(string? phone)
    {
        if (string.IsNullOrWhiteSpace(phone)) return "#";
        var clean = new string(phone.Where(char.IsDigit).ToArray());
        if (clean.StartsWith("0")) clean = "2" + clean;
        return $"https://wa.me/{clean}";
    }

    // ── معاينة المستندات والصور ──
    private void ViewDoc(PendingProviderDto provider, string type)
    {
        var rawUrl = type == "ID" ? provider.IdCardImage : provider.CertificateImage;
        if (string.IsNullOrEmpty(rawUrl)) return;

        modalTitle = type == "ID" ? $"البطاقة الشخصية: {provider.Name}" : $"الشهادة المهنية: {provider.Name}";
        modalImageUrl = Api.GetAbsoluteUrl(rawUrl);
        isDocModalOpen = true;
    }

    private void PreviewImage(string imageUrl, string title)
    {
        modalTitle = title;
        modalImageUrl = imageUrl;
        isDocModalOpen = true;
    }

    private void CloseDocModal()
    {
        isDocModalOpen = false;
        modalImageUrl = "";
        modalTitle = "";
    }

    // ── مزودي الخدمات: قبول ورفض ──
    private async Task ApproveProvider(PendingProviderDto provider)
    {
        if (await JS.InvokeAsync<bool>("confirm", $"هل أنت متأكد من اعتماد مقدم الخدمة {provider.Name} وتفعيل حسابه كصاحب خدمة معتمد؟"))
        {
            try
            {
                await AdminService.ApproveProvider(provider.Id);
                pendingProviders.Remove(provider);
                UpdateGlobalCount();
                statusMessage = $"تم قبول واعتماد مزود الخدمة ({provider.Name}) بنجاح!";
                statusMessageType = "success";
                StateHasChanged();
            }
            catch (Exception ex)
            {
                statusMessage = "فشل اعتماد المزود: " + ex.Message;
                statusMessageType = "danger";
            }
        }
    }

