@page "/admin/ads"
@page "/admin/adsmanagement"
@using Khadamat.Application.DTOs
@using Khadamat.BlazorUI.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "SystemAdmin,SuperAdmin")]
@inject ApiClient Api
@inject IJSRuntime JS
@inject NavigationManager Navigation

<div class="px-2 pb-5">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-rectangle-ad text-primary me-2"></i> إدارة الإعلانات</h4>
            <p class="text-muted small mb-0">إنشاء الإعلانات وإدارة مواضعها وعرضها واستهدافها</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary rounded-pill btn-sm" @onclick='() => Navigation.NavigateTo("/admin/ad-analytics")'>
                <i class="fa-solid fa-chart-line me-1"></i> الإحصائيات
            </button>
            <button class="btn btn-outline-info rounded-pill btn-sm" @onclick='() => Navigation.NavigateTo("/admin/ad-packages")'>
                <i class="fa-solid fa-gem me-1"></i> الباقات
            </button>
            <button class="btn btn-primary-premium rounded-pill px-4" @onclick="OpenAddModal">
                <i class="fa-solid fa-plus me-2"></i> إعلان جديد
            </button>
            <button class="btn btn-outline-warning rounded-pill px-3 ms-2" @onclick="() => showMap = true">
                <i class="fa-solid fa-map me-2"></i> دليل الأماكن
            </button>
            <button class="btn btn-outline-primary rounded-pill px-3 ms-2" @onclick="() => showDimensionsGuide = !showDimensionsGuide">
                <i class="fa-solid fa-ruler-combined me-2"></i> دليل أبعاد الصور
            </button>
        </div>
    </div>

    <!-- Dimensions Guide Card (Hero & Ads) -->
    @if (showDimensionsGuide)
    {
        <div class="card glass-card border-0 rounded-4 p-3 mb-4 shadow-sm animate-pop" style="background: linear-gradient(135deg, rgba(255,255,255,0.98), rgba(240,249,255,0.98)); border-right: 4px solid #0284c7 !important;">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="fw-bold text-primary mb-0"><i class="fa-solid fa-ruler-combined me-2"></i> دليل الأبعاد والمقاسات الموصى بها للصور (الهيرو والإعلانات)</h6>
                <button class="btn-close btn-sm" @onclick="() => showDimensionsGuide = false"></button>
            </div>
            <p class="text-muted small mb-3">لضمان مظهر حاد واحترافي دون تشويه أو اقتصاص غير مرغوب على أجهزة الكمبيوتر، التابلت، الهواتف الذكية، وتطبيق الموبايل:</p>
            <div class="row g-2">
                <div class="col-12 col-md-6 col-lg-3">
                    <div class="p-2.5 rounded-3 bg-white border h-100 shadow-2xs">
                        <div class="d-flex align-items-center justify-content-between mb-1">
                            <span class="badge bg-primary-subtle text-primary fw-bold">الهيرو (Hero Slider)</span>
                            <span class="small fw-bold text-dark">1920 × 1080</span>
                        </div>
                        <div class="extra-small text-muted">نسبة 16:9 (أو 1920×640 نسبة 3:1). الحجم الأقصى 300KB. مناسب لواجهة الموقع الرئيسية ويملأ الشاشة تلقائياً.</div>
                    </div>
                </div>
                <div class="col-12 col-md-6 col-lg-3">
                    <div class="p-2.5 rounded-3 bg-white border h-100 shadow-2xs">
                        <div class="d-flex align-items-center justify-content-between mb-1">
                            <span class="badge bg-success-subtle text-success fw-bold">سلايدر الإعلانات (Slider)</span>
                            <span class="small fw-bold text-dark">1200 × 400</span>
                        </div>
                        <div class="extra-small text-muted">نسبة 3:1 (أو 1200×500 نسبة 2.4:1). الحجم الأقصى 150KB. متناسق مع ارتفاع السلايدر (200px) وعرض الشاشات.</div>
                    </div>
                </div>
                <div class="col-12 col-md-6 col-lg-3">
                    <div class="p-2.5 rounded-3 bg-white border h-100 shadow-2xs">
                        <div class="d-flex align-items-center justify-content-between mb-1">
                            <span class="badge bg-info-subtle text-info fw-bold">الجانبي والبطاقات (Cards)</span>
                            <span class="small fw-bold text-dark">800 × 800</span>
                        </div>
                        <div class="extra-small text-muted">نسبة 1:1 مربعة (أو 1200×800 نسبة 3:2). مخصص للقوائم الجانبية والبطاقات الممولة في نتائج البحث والفئات.</div>
                    </div>
                </div>
                <div class="col-12 col-md-6 col-lg-3">
                    <div class="p-2.5 rounded-3 bg-white border h-100 shadow-2xs">
                        <div class="d-flex align-items-center justify-content-between mb-1">
                            <span class="badge bg-warning-subtle text-warning fw-bold">أسفل الصفحة (Bottom)</span>
                            <span class="small fw-bold text-dark">1200 × 300</span>
                        </div>
                        <div class="extra-small text-muted">نسبة 4:1 شريط بانورامي عريض يظهر قبل تذييل الصفحة (Footer).</div>
                    </div>
                </div>
            </div>
            <div class="mt-2.5 pt-2 border-top extra-small text-muted d-flex align-items-center gap-2">
                <i class="fa-solid fa-lightbulb text-warning fs-6"></i>
                <span><strong>قاعدة منطقة الأمان (Safe Zone):</strong> ضع النصوص والعناصر الأساسية في الـ <strong>60% الوسطى</strong> من مساحة الصورة لتفادي اقتصاصها عند فتح الموقع أو التطبيق من الهاتف. يُفضل دائماً حفظ الصور بصيغة <strong>WebP</strong>.</span>
            </div>
        </div>
    }

    <!-- Filter & Stats Bar -->
    @if (ads != null)
    {
        <div class="row g-3 mb-4 animate-fade-in">
            <div class="col-md-3">
                <div class="glass-card p-3 rounded-4 border-start border-primary border-4 shadow-sm h-100">
                    <div class="small text-muted mb-1">إجمالي الإعلانات</div>
                    <div class="h4 fw-bold mb-0 text-primary">@ads.Count</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="glass-card p-3 rounded-4 border-start border-success border-4 shadow-sm h-100">
                    <div class="small text-muted mb-1">إجمالي المشاهدات</div>
                    <div class="h4 fw-bold mb-0 text-success">@ads.Sum(a => a.ViewCount).ToString("N0")</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="glass-card p-3 rounded-4 border-start border-info border-4 shadow-sm h-100">
                    <div class="small text-muted mb-1">إجمالي النقرات</div>
                    <div class="h4 fw-bold mb-0 text-info">@ads.Sum(a => a.ClickCount).ToString("N0")</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="glass-card p-3 rounded-4 border-start border-warning border-4 shadow-sm h-100">
                    <div class="small text-muted mb-1">إجمالي الإيرادات</div>
                    <div class="h4 fw-bold mb-0 text-warning">@ads.Sum(a => a.AmountPaid).ToString("C0")</div>
                </div>
            </div>
        </div>
    }

    <div class="glass-card p-3 rounded-4 shadow-sm border-0 mb-4">
        <div class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-0 pe-0"><i class="fa-solid fa-search text-muted"></i></span>
                    <input type="text" class="form-control border-0 shadow-none bg-transparent" placeholder="بحث بالعنوان أو المعلن..." @bind="searchText" @bind:event="oninput" @onkeyup="FilterAds">
                </div>
            </div>
            <div class="col-md-3">
                <select class="form-select border-0 shadow-none bg-light rounded-pill" @bind="filterPlacement" @bind:after="FilterAds">
                    <option value="">كل الأماكن</option>
                    <option value="Slider">السلايدر</option>
                    <option value="Sidebar">الجانبي</option>
                    <option value="Bottom">الأسفل</option>
                    <option value="Category">الفئات</option>
                    <option value="Search">البحث</option>
                    <option value="Popup">المنبثق</option>
                </select>
            </div>
            <div class="col-md-2">
                <select class="form-select border-0 shadow-none bg-light rounded-pill" @bind="filterStatus" @bind:after="FilterAds">
                    <option value="">كل الحالات</option>
                    <option value="active">نشط فقط</option>
                    <option value="inactive">موقف فقط</option>
                </select>
            </div>
            <div class="col-md-3 text-end ps-3 pt-1">
                <span class="badge bg-primary rounded-pill px-3">@(filteredAds?.Count ?? 0) إعلان</span>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger rounded-4 shadow-sm animate-pop">
            <i class="fa-solid fa-circle-exclamation me-2"></i> @errorMessage
            <button class="btn btn-sm btn-outline-danger ms-3 rounded-pill" @onclick="LoadAds">إعادة المحاولة</button>
        </div>
    }

    @if (isPageLoading)
    {
        <div class="d-flex justify-content-center p-5">
            <div class="spinner-border text-primary" role="status"></div>
        </div>
    }
    else if (ads == null || !ads.Any())
    {
        <div class="glass-card p-5 text-center text-muted">
            <i class="fa-solid fa-rectangle-ad fs-1 mb-3 opacity-50"></i>
            <p>لا توجد إعلانات مسجلة حالياً</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var ad in filteredAds ?? new())
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="glass-card overflow-hidden p-0 h-100 animate-up @(ad.IsActive ? "" : "opacity-75")">
                        <div class="ad-image-container position-relative">
                            @if (ad.AdType == "Video")
                            {
                                <div class="bg-dark d-flex align-items-center justify-content-center" style="height: 180px;">
                                    <i class="fa-solid fa-play fs-1 text-white opacity-50"></i>
                                </div>
                            }
                            else
                            {
                                <div class="ad-preview-img @(ad.ImageUrl?.StartsWith("hero-gradient") == true || string.IsNullOrEmpty(ad.ImageUrl) ? (ad.ImageUrl ?? "hero-gradient-1") : "")"
                                     style="height: 180px; @(ad.ImageUrl?.StartsWith("hero-gradient") != true && !string.IsNullOrEmpty(ad.ImageUrl) ? $"background-image: url('{Api.GetAbsoluteUrl(Khadamat.BlazorUI.Helpers.ImagePathResolver.Ad(ad.ImageUrl))}'); background-size: cover; background-position: center;" : "")">
                                </div>
                            }
                            <div class="ad-actions position-absolute top-0 end-0 p-2 d-flex gap-2">
                                <button class="btn btn-white btn-sm rounded-circle shadow-sm" @onclick="() => EditAd(ad)"><i class="fa-solid fa-pen text-primary"></i></button>
                                <button class="btn btn-white btn-sm rounded-circle shadow-sm" @onclick="() => DeleteAd(ad)"><i class="fa-solid fa-trash text-danger"></i></button>
                            </div>
                            <div class="position-absolute bottom-0 start-0 p-2 d-flex gap-1">
                                <span class="badge bg-dark bg-opacity-75 rounded-pill shadow-sm">@ad.Placement</span>
                                @if (ad.TargetCategories != null)
                                {
                                    <span class="badge bg-info bg-opacity-75 rounded-pill shadow-sm"><i class="fa-solid fa-bullseye me-1"></i>مستهدف</span>
                                }
                            </div>
                            <div class="position-absolute top-0 start-0 p-2">
                                <span class="badge @(ad.IsActive ? "bg-success" : "bg-warning") rounded-pill shadow-sm">
                                    <i class="fa-solid @(ad.IsActive ? "fa-bolt" : "fa-pause") me-1"></i>@(ad.IsActive ? "نشط" : "موقوف")
                                </span>
                            </div>
                        </div>
                        <div class="p-3">
                            <h6 class="fw-bold mb-1 text-truncate">@ad.Title</h6>
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-muted x-small text-truncate" title="صاحب الإعلان: @(ad.AdvertiserName ?? ad.CreatedBy ?? "إعلان للمنصة")">
                                    <i class="fa-solid fa-user-tag me-1 text-primary"></i>
                                    @(string.IsNullOrEmpty(ad.AdvertiserName) ? (string.IsNullOrEmpty(ad.CreatedBy) ? "إعلان المنصة" : (ad.CreatedBy.Length > 12 ? ad.CreatedBy.Substring(0, 10) + "..." : ad.CreatedBy)) : ad.AdvertiserName)
                                </span>
                                <span class="badge bg-soft-warning p-1 px-2 text-warning rounded-pill small">@ad.AmountPaid.ToString("C0")</span>
                            </div>
                            <div class="row g-1 text-center border-top pt-2">
                                <div class="col-4 border-end">
                                    <div class="fw-bold small">@ad.ViewCount</div>
                                    <div class="extra-small text-muted">مشاهدة</div>
                                </div>
                                <div class="col-4 border-end">
                                    <div class="fw-bold small">@ad.ClickCount</div>
                                    <div class="extra-small text-muted">نقرة</div>
                                </div>
                                <div class="col-4">
                                    <div class="fw-bold small">@ad.CTR.ToString("F1")%</div>
                                    <div class="extra-small text-muted">CTR</div>
                                </div>
                            </div>
                            <div class="row g-1 text-center border-top pt-2 mt-2">
                                <div class="col-6 border-end">
                                    <div class="extra-small text-muted">البداية</div>
                                    <div class="small extra-small fw-bold">@ad.StartDate?.ToString("yyyy/MM/dd")</div>
                                </div>
                                <div class="col-6">
                                    <div class="extra-small text-muted">النهاية</div>
                                    <div class="small extra-small fw-bold">@ad.EndDate?.ToString("yyyy/MM/dd")</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (showModal)
{
    <div class="modal-overlay">
        <div class="glass-card p-0 rounded-4 w-100 mx-3 animate-pop shadow-2xl" style="max-width: 800px; max-height: 90vh; overflow: hidden; display: flex; flex-direction: column;">
            <div class="p-3 bg-primary text-white d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0">@(currentAd.Id == 0 ? "إضافة إعلان جديد" : "تعديل إعلان الحملة")</h5>
                <button class="btn-close btn-close-white" @onclick="() => showModal = false"></button>
            </div>
            
            <div class="p-4 overflow-auto flex-grow-1">
                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="form-label small fw-bold">العنوان</label>
                        <input type="text" class="form-control rounded-pill" @bind="currentAd.Title">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold">النوع</label>
                        <select class="form-select rounded-pill" @bind="currentAd.AdType">
                            <option value="Image">صورة</option>
                            <option value="Video">فيديو</option>
                            <option value="Text">نص</option>
                        </select>
                    </div>

                    <div class="col-12">
                        <label class="form-label small fw-bold">الوصف</label>
                        <textarea class="form-control rounded-4" @bind="currentAd.Description" rows="2"></textarea>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-bold">تحميل صورة أو رابط</label>
                        <div class="input-group">
                            <input type="text" class="form-control rounded-start-pill" @bind="currentAd.ImageUrl" placeholder="رابط خارجي...">
                            <label class="btn btn-primary rounded-end-pill mb-0" for="adImageFile">
                                <i class="fa-solid fa-upload"></i>
                                <InputFile id="adImageFile" class="d-none" OnChange="HandleFileSelected" />
                            </label>
                        </div>
                        <div class="form-text extra-small mt-1 text-primary">
                            <i class="fa-solid fa-circle-info me-1"></i>
                            <strong>الأبعاد الموصى بها:</strong> للسلايدر (1200×400 بكسل نسبة 3:1) | للجانبي والبطاقات (800×800 بكسل 1:1) | الهيرو (1920×1080 بكسل).
                            <span class="text-muted d-block mt-0.5">تمركز العناصر المهمة في الـ 60% الوسطى (Safe Zone) يضمن ظهورها ممتازاً على الموبايل وداخل التطبيق.</span>
                        </div>
                        @if (!string.IsNullOrEmpty(imagePreview))
                        {
                            <div class="mt-2 text-center">
                                <img src="@imagePreview" class="rounded shadow-sm" style="max-height: 80px;" />
                                <button class="btn btn-link btn-sm text-danger" @onclick="() => { imagePreview = null; currentAd.ImageBase64 = null; }">إلغاء</button>
                            </div>
                        }
                    </div>
                    <!-- Gradient Selector (when ImageUrl is empty or gradient) -->
                    <div class="col-12">
                        <label class="form-label small fw-bold">تدرج لوني (اختياري - إذا لم تحمّل صورة)</label>
                        <div class="d-flex gap-2 flex-wrap">
                            @foreach (var g in new[] { "hero-gradient-1", "hero-gradient-2", "hero-gradient-3", "hero-gradient-4" })
                            {
                                <div class="gradient-swatch @g @(currentAd.ImageUrl == g && string.IsNullOrEmpty(imagePreview) ? "selected" : "")"
                                     @onclick="() => { if(string.IsNullOrEmpty(imagePreview)) { currentAd.ImageUrl = g; } }" title="@g">
                                </div>
                            }
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-bold">الخدمة المرتبطة (اختياري)</label>
                        <select class="form-select rounded-pill" value="@(currentAd.ServiceId ?? 0)" @onchange="OnLinkedServiceChanged">
                            <option value="0">-- بدون ربط بخدمة --</option>
                            @foreach (var svc in availableServices)
                            {
                                <option value="@svc.Id">[@svc.Id] @svc.Title (@(string.IsNullOrEmpty(svc.ProviderName) ? "بدون مزود" : svc.ProviderName))</option>
                            }
                        </select>
                        <div class="form-text extra-small mt-1 text-success">
                            <i class="fa-solid fa-circle-info me-1"></i>
                            عند اختيار خدمة، يتم تحديد الرابط والمزود تلقائياً.
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-bold">المعلن / صاحب الإعلان (المزود)</label>
                        <select class="form-select rounded-pill" @bind="currentAd.CreatedBy">
                            <option value="">-- إعلان المنصة / النظام --</option>
                            @foreach (var u in availableUsers.Where(u => u.IsProvider || u.Role == "Provider"))
                            {
                                <option value="@u.Id">⭐ مزود: @u.FullName (@u.UserName)</option>
                            }
                            @foreach (var u in availableUsers.Where(u => !u.IsProvider && u.Role != "Provider"))
                            {
                                <option value="@u.Id">👤 مستخدم: @u.FullName (@u.UserName)</option>
                            }
                        </select>
                        <div class="form-text extra-small mt-1 text-muted">
                            المزود المحدد يستطيع متابعة إحصائيات هذا الإعلان في حسابه.
                        </div>
                    </div>

                    <div class="col-md-8">
                        <label class="form-label small fw-bold">الرابط الموجه (URL)</label>
                        <input type="text" class="form-control rounded-pill" @bind="currentAd.TargetUrl" placeholder="https://...‏ أو /contact">
                        <div class="d-flex gap-2 flex-wrap mt-2">
                            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3" @onclick='() => currentAd.TargetUrl = "/contact"'>
                                <i class="fa-solid fa-phone me-1"></i>تواصل معنا
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" @onclick='() => currentAd.TargetUrl = "/services"'>
                                <i class="fa-solid fa-briefcase me-1"></i>الخدمات
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" @onclick='() => currentAd.TargetUrl = "/about"'>
                                <i class="fa-solid fa-circle-info me-1"></i>من نحن
                            </button>
                        </div>
                        <div class="form-text extra-small mt-1 text-success">
                            <i class="fa-solid fa-circle-info me-1"></i>
                            الصفحات الداخلية: /contact ، /services ، /about أو رابط خارجي https://...
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold">المبلغ المدفوع (جنيه)</label>
                        <input type="number" class="form-control rounded-pill" @bind="currentAd.AmountPaid">
                    </div>

                    <div class="col-md-4">
                        <label class="form-label small fw-bold">المكان (موضع الظهور)</label>
                        <select class="form-select rounded-pill" @bind="currentAd.Placement">
                            <option value="Slider">سلايدر الرئيسي (أعلى الصفحة)</option>
                            <option value="Sidebar">جانبي (في القائمة الجانبية)</option>
                            <option value="Bottom">أسفل الصفحة (قبل التذييل)</option>
                            <option value="Category">قائمة الفئات (بين الخدمات)</option>
                            <option value="Search">نتائج البحث (بين الخدمات)</option>
                            <option value="Popup">منبثق (عند فتح الصفحة)</option>
                        </select>
                        <div class="form-text extra-small mt-1 text-primary">
                            @placementDescriptions.GetValueOrDefault(currentAd.Placement ?? "Slider")
                        </div>
                    </div>

                    <!-- Visual Guide Reference -->
                    <div class="col-12 mt-3">
                        <div class="alert alert-info rounded-4 border-0 bg-opacity-10 d-flex align-items-center">
                            <i class="fa-solid fa-circle-info me-3 fs-4"></i>
                            <div class="small">
                                <strong>دليل الأماكن:</strong> يمكنك اختيار المكان المناسب للإعلان لضمان وصوله للجمهور المستهدف. الإعلانات الجانبية تظهر في جميع الصفحات، بينما إعلانات الفئات والبحث تظهر تلقائياً بين نتائج العرض.
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold">ترتيب العرض</label>
                        <input type="number" class="form-control rounded-pill" @bind="currentAd.DisplayOrder" min="0" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold">تاريخ البدء</label>
                        <input type="date" class="form-control rounded-pill" @bind="currentAd.StartDate" @bind:format="yyyy-MM-dd">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold">تاريخ الانتهاء</label>
                        <input type="date" class="form-control rounded-pill" @bind="currentAd.EndDate" @bind:format="yyyy-MM-dd">
                    </div>

                    <div class="col-12 mt-4 pt-2 border-top">
                        <h6 class="fw-bold text-primary mb-3"><i class="fa-solid fa-bullseye me-2"></i> الاستهداف المتقدم (Advanced Targeting)</h6>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-bold">الفئة الرئيسية المستهدفة</label>
                        <select class="form-select rounded-pill form-select-sm" value="@selectedMainCategoryId" @onchange="OnMainCategoryChanged">
                            <option value="0">الكل</option>
                            @foreach (var cat in mainCategories)
                            {
                                <option value="@cat.Id">@cat.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold">التصنيف (L2)</label>
                        <select class="form-select rounded-pill form-select-sm" value="@selectedSubCategoryId" @onchange="OnCategoryChanged">
                            <option value="0">الكل</option>
                            @foreach (var sub in subCategories)
                            {
                                <option value="@sub.Id">@sub.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold">النوع (الفئة تحت الفرعية L3)</label>
                        <select class="form-select rounded-pill form-select-sm" @bind="selectedDeepSubCategoryId">
                            <option value="0">الكل</option>
                            @foreach (var deep in deepSubCategories)
                            {
                                <option value="@deep.Id">@deep.Name</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label small fw-bold">الجنس</label>
                        <select class="form-select rounded-pill form-select-sm" @bind="currentAd.TargetUserGender">
                            <option value="All">الجميع</option>
                            <option value="Male">ذكور</option>
                            <option value="Female">إناث</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-bold">أيام العرض</label>
                        <div class="d-flex flex-wrap gap-3 bg-light p-3 rounded-4 border border-info border-opacity-10">
                            @foreach (var day in allDays)
                            {
                                <div class="form-check form-check-inline m-0">
                                    <input class="form-check-input" type="checkbox" id="day-@day.Key" 
                                           checked="@selectedDays.Contains(day.Key)"
                                           @onchange='(e) => ToggleDay(day.Key, (bool)e.Value!)'>
                                    <label class="form-check-label small" for="day-@day.Key">@day.Value</label>
                                </div>
                            }
                        </div>
                        <div class="form-text extra-small mt-1">سيظهر الإعلان في الأيام المختارة فقط. (الافتراضي: كل الأيام)</div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-bold">وقت البدء</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text rounded-start-pill bg-light border-end-0"><i class="fa-solid fa-clock-rotate-left"></i></span>
                            <input type="time" class="form-control rounded-end-pill border-start-0" @bind="currentAd.TargetTimeStart" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold">وقت الانتهاء</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text rounded-start-pill bg-light border-end-0"><i class="fa-solid fa-clock"></i></span>
                            <input type="time" class="form-control rounded-end-pill border-start-0" @bind="currentAd.TargetTimeEnd" />
                        </div>
                    </div>

                    <div class="col-12 pt-2">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="isActive" @bind="currentAd.IsActive">
                            <label class="form-check-label small fw-bold ms-2" for="isActive">نشط وقابل للعرض</label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="p-3 bg-light d-flex gap-2">
                <button class="btn btn-primary-premium flex-grow-1 rounded-pill" @onclick="SaveAd">حفظ البيانات</button>
                <button class="btn btn-outline-secondary flex-grow-1 rounded-pill" @onclick="() => showModal = false">إلغاء</button>
            </div>
        </div>
    </div>
}

