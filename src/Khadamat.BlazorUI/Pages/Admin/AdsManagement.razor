@code {
    private List<EnhancedAdDto>? ads;
    private List<EnhancedAdDto>? filteredAds;
    private List<MainCategoryDto> mainCategories = new();
    private List<CategoryDto> subCategories = new();
    private List<SubCategoryDto> deepSubCategories = new();
    private int selectedMainCategoryId = 0;
    private int selectedSubCategoryId = 0;
    private int selectedDeepSubCategoryId = 0;
    private string? imagePreview;
    private bool showModal = false;
    private EnhancedAdDto currentAd = new();
    private string searchText = "";
    private string? errorMessage;
    private string filterPlacement = "";
    private string filterStatus = "";
    private bool isPageLoading = true;
    private bool showMap = false;
    private List<string> selectedDays = new();

    private Dictionary<string, string> allDays = new()
    {
        { "Sat", "السبت" }, { "Sun", "الأحد" }, { "Mon", "الاثنين" }, 
        { "Tue", "الثلاثاء" }, { "Wed", "الأربعاء" }, { "Thu", "الخميس" }, { "Fri", "الجمعة" }
    };

    private Dictionary<string, string> placementDescriptions = new()
    {
        { "Slider", "يظهر في السلايدر الرئيسي أعلى الصفحة الرئيسية وصفحات الاستكشاف." },
        { "Sidebar", "يظهر في القائمة الجانبية في جميع صفحات الموقع للشاشات الكبيرة." },
        { "Bottom", "يظهر في أسفل الصفحة الرئيسية قبل التذييل (Footer)." },
        { "Category", "يظهر بشكل أصلي (Native) داخل قائمة الخدمات أثناء التصفح." },
        { "Search", "يظهر بشكل أصلي (Native) داخل نتائج البحث بين الخدمات." },
        { "Popup", "يظهر كنافذة منبثقة عند دخول الموقع (قيد التطوير حالياً)." }
    };

    protected override async Task OnInitializedAsync()
    {
        isPageLoading = true;
        try
        {
            await LoadAds();
            mainCategories = await Api.GetMainCategoriesAsync();
        }
        catch (Exception ex)
        {
            errorMessage = "حدث خطأ أثناء تحميل البيانات الإدارية. يرجى مراجعة الصلاحيات.";
            Console.WriteLine($"Error initializing AdsManagement: {ex.Message}");
        }
        finally
        {
            isPageLoading = false;
        }
    }
    private async Task OnMainCategoryChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int id))
        {
            selectedMainCategoryId = id;
            selectedSubCategoryId = 0;
            selectedDeepSubCategoryId = 0;
            deepSubCategories.Clear();
            if (id > 0)
                subCategories = await Api.GetCategoriesByMainIdAsync(id);
            else
                subCategories.Clear();
        }
    }

    private async Task OnCategoryChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int id))
        {
            selectedSubCategoryId = id;
            selectedDeepSubCategoryId = 0;
            if (id > 0)
                deepSubCategories = await Api.GetSubCategoriesByCategoryIdAsync(id);
            else
                deepSubCategories.Clear();
        }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        var format = "image/jpeg";
        var resizedImage = await file.RequestImageFileAsync(format, 1200, 600);
        var buffer = new byte[resizedImage.Size];
        using var stream = resizedImage.OpenReadStream();
        await stream.ReadAsync(buffer);
        
        currentAd.ImageBase64 = Convert.ToBase64String(buffer);
        imagePreview = $"data:{format};base64,{currentAd.ImageBase64}";
        currentAd.ImageUrl = null; // Clear URL if uploading
    }

    private async Task LoadAds()
    {
        try
        {
            ads = await Api.GetAllAdsAsync();
            FilterAds();
        }
        catch (Exception ex)
        {
            errorMessage = "فشل في جلب قائمة الإعلانات من الخادم.";
            Console.WriteLine($"Error loading ads: {ex.Message}");
        }
    }

    private void FilterAds()
    {
        if (ads == null) { filteredAds = null; return; }
        filteredAds = ads
            .Where(a => string.IsNullOrEmpty(searchText) || 
                        (a.Title?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                        (a.CreatedBy?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false))
            .Where(a => string.IsNullOrEmpty(filterPlacement) || a.Placement == filterPlacement)
            .Where(a => string.IsNullOrEmpty(filterStatus) || (filterStatus == "active" ? a.IsActive : !a.IsActive))
            .ToList();
    }

    private void OpenAddModal()
    {
        currentAd = new EnhancedAdDto 
        { 
            ImageUrl = "hero-gradient-1", 
            AdType = "Image", 
            Placement = "Slider",
            IsActive = true,
            StartDate = DateTime.Now,
            EndDate = DateTime.Now.AddMonths(1),
            TargetUserGender = "All",
            TargetDays = "Sat,Sun,Mon,Tue,Wed,Thu,Fri"
        };
        selectedMainCategoryId = 0;
        selectedSubCategoryId = 0;
        selectedDeepSubCategoryId = 0;
        subCategories.Clear();
        deepSubCategories.Clear();
        selectedDays = allDays.Keys.ToList(); // All days selected by default
        showModal = true;
    }

    private async Task EditAd(EnhancedAdDto ad)
    {
        imagePreview = null;
        currentAd = new EnhancedAdDto
        {
            Id = ad.Id,
            Title = ad.Title,
            Description = ad.Description,
            AdType = ad.AdType,
            ImageUrl = ad.ImageUrl,
            VideoUrl = ad.VideoUrl,
            TextContent = ad.TextContent,
            TargetUrl = ad.TargetUrl,
            Placement = ad.Placement,
            DisplayOrder = ad.DisplayOrder,
            StartDate = ad.StartDate,
            EndDate = ad.EndDate,
            IsActive = ad.IsActive,
            TargetGovernorates = ad.TargetGovernorates,
            TargetCities = ad.TargetCities,
            TargetCategories = ad.TargetCategories,
            TargetSubCategories = ad.TargetSubCategories,
            TargetServices = ad.TargetServices,
            TargetUserGender = ad.TargetUserGender,
            TargetDays = ad.TargetDays,
            TargetMonths = ad.TargetMonths,
            TargetTimeStart = ad.TargetTimeStart,
            TargetTimeEnd = ad.TargetTimeEnd,
            TargetKeywords = ad.TargetKeywords,
            TargetDeepSubCategories = ad.TargetDeepSubCategories
        };

        if (int.TryParse(currentAd.TargetCategories, out int cid)) 
        {
            selectedMainCategoryId = cid;
            if (cid > 0) subCategories = await Api.GetCategoriesByMainIdAsync(cid);
        }
        else selectedMainCategoryId = 0;
        
        if (int.TryParse(currentAd.TargetSubCategories, out int scid)) 
        {
            selectedSubCategoryId = scid;
            if (scid > 0) deepSubCategories = await Api.GetSubCategoriesByCategoryIdAsync(scid);
        }
        else selectedSubCategoryId = 0;

        if (int.TryParse(currentAd.TargetDeepSubCategories, out int dscid)) 
            selectedDeepSubCategoryId = dscid;
        else selectedDeepSubCategoryId = 0;

        // Populate selected days from TargetDays string
        if (!string.IsNullOrEmpty(currentAd.TargetDays))
            selectedDays = currentAd.TargetDays.Split(',', StringSplitOptions.RemoveEmptyEntries).ToList();
        else
            selectedDays = allDays.Keys.ToList(); // Default to all if empty

        showModal = true;
    }

    private void ToggleDay(string dayKey, bool isChecked)
    {
        if (isChecked && !selectedDays.Contains(dayKey))
            selectedDays.Add(dayKey);
        else if (!isChecked && selectedDays.Contains(dayKey))
            selectedDays.Remove(dayKey);
        
        currentAd.TargetDays = string.Join(",", selectedDays);
    }

    private async Task SaveAd()
    {
        if (string.IsNullOrWhiteSpace(currentAd.Title)) return;
        
        currentAd.TargetCategories = selectedMainCategoryId > 0 ? selectedMainCategoryId.ToString() : null;
        currentAd.TargetSubCategories = selectedSubCategoryId > 0 ? selectedSubCategoryId.ToString() : null;
        currentAd.TargetDeepSubCategories = selectedDeepSubCategoryId > 0 ? selectedDeepSubCategoryId.ToString() : null;

        bool success;
        if (currentAd.Id == 0)
            success = await Api.CreateAdAsync(currentAd);
        else
            success = await Api.UpdateAdAsync(currentAd.Id, currentAd);

        if (success)
        {
            await LoadAds();
            showModal = false;
            imagePreview = null;
        }
    }

    private async Task DeleteAd(EnhancedAdDto ad)
    {
        if (await JS.InvokeAsync<bool>("confirm", $"هل أنت متأكد من حذف الإعلان: {ad.Title}؟"))
        {
            var success = await Api.DeleteAdAsync(ad.Id);
            if (success)
            {
                ads?.Remove(ad);
            }
        }
    }
}
