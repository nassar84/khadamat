                                <tr>
                                    <td>إعدادات النظام</td>
                                    <td class="text-center text-danger"><i class="fa-solid fa-xmark"></i></td>
                                    <td class="text-center text-success"><i class="fa-solid fa-check"></i></td>
                                </tr>
                                <tr>
                                    <td>حذف المستخدمين</td>
                                    <td class="text-center text-danger"><i class="fa-solid fa-xmark"></i></td>
                                    <td class="text-center text-success"><i class="fa-solid fa-check"></i></td>
                                </tr>
                                <tr>
                                    <td>سجلات النشاط</td>
                                    <td class="text-center text-danger"><i class="fa-solid fa-xmark"></i></td>
                                    <td class="text-center text-success"><i class="fa-solid fa-check"></i></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Actions -->
            <div class="col-12 text-end mb-5 pb-5">
                <hr class="my-4 opacity-25" />
                <button class="btn btn-primary-premium btn-lg px-5 rounded-pill shadow w-100 w-md-auto" @onclick="SaveSettings" disabled="@isSaving">
                    @if (isSaving) { <span class="spinner-border spinner-border-sm me-2"></span> }
                    <i class="fa-solid fa-save me-2"></i>حفظ جميع التغييرات
                </button>
