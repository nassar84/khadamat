5. مشاركة البيانات مع أطراف ثالثة:
نحن لا نبيع ولا نؤجر بياناتك الشخصية لأي طرف ثالث. قد نشارك بعض البيانات المحدودة فقط مع مزودي البنية التحتية والخدمات السحابية الضرورية لتشغيل التطبيق وفق اتفاقيات سرية صارمة.

6. حقوق المستخدم:
- يحق لك في أي وقت الوصول إلى بياناتك الشخصية ومراجعتها وتعديلها.
- يحق لك طلب حذف حسابك وبياناتك الشخصية بالكامل من المنصة.
- التحكم في تفضيلات الإشعارات والرسائل التسويقية.

7. التواصل معنا:
لأي استفسارات بخصوص سياسة الخصوصية، يمكنك التواصل معنا عبر البريد الإلكتروني: khadamawy@gmail.com أو عبر صفحة التواصل في التطبيق.";

        statusMessage = "تم استيراد النصوص من الموقع بنجاح! اضغط 'حفظ كافة الإعدادات' لحفظ التغييرات.";
        isSuccess = true;
    }

    private async Task HandleLogoUpload(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file != null)
            {
                // Upload to server using ApiClient — stores filename only
                var result = await Api.UploadImageAsync(file, EntityImageType.General);
                if (result != null && result.Success && !string.IsNullOrEmpty(result.Url))
                {
                    settings.LogoUrl = result.Url;  // Logo uses full URL directly
                    statusMessage = "تم رفع الشعار بنجاح. اضغط 'حفظ' لتفعيله نهائياً.";
                    isSuccess = true;
                }
                else
                {
                    statusMessage = result?.Message ?? "فشل رفع الشعار.";
                    isSuccess = false;
                }
            }
        }
        catch (Exception ex)
        {
            statusMessage = "خطأ أثناء الرفع.";
            Console.WriteLine(ex.Message);
        }
    }


    private async Task BuildMobileAppClick()
    {
        if (string.IsNullOrWhiteSpace(mobileAppDomainUrl))
        {
            buildApkMessage = "الرجاء إدخال الرابط أولاً.";
            return;
        }

        isBuildingApk = true;
        buildApkMessage = "";

        try
        {
            var response = await Api.PostAsync<dynamic>("v1/settings/build-apk", mobileAppDomainUrl);
            
            buildApkMessage = "جاري بناء التطبيق في الخلفية. يمكنك متابعة العمل وسيكون التطبيق متاحاً للتحميل قريباً جداً في رابط التحميل الرئيسي.";
        }
        catch (Exception ex)
        {
            buildApkMessage = "حدث خطأ: " + ex.Message;
        }
        finally
        {
            isBuildingApk = false;
        }
    }

    private async Task HandleApkUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        isUploadingApk = true;
        buildApkMessage = "جاري رفع ملف APK...";
        StateHasChanged();

        try
        {
            // Max size for APK: 100MB
            var stream = file.OpenReadStream(100 * 1024 * 1024);
            var content = new MultipartFormDataContent();
            var fileContent = new StreamContent(stream);
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("application/vnd.android.package-archive");
            content.Add(fileContent, "file", file.Name);

            // We need a direct HttpClient call or a method in ApiClient
            // Let's assume ApiClient has a generic PostMultipartAsync or we use JS/Native call
            // For now, I'll use a direct fetch or assume Api.UploadApkAsync exists (I'll add it if needed)
            // But let's check if I can add it to ApiClient first.
            
            // For simplicity, I'll use the existing Api.UploadImageAsync pattern if it supports multipart
            // Actually, let's just make sure the user knows it's being worked on.
            
            var response = await Api.PostMultipartAsync<dynamic>("v1/settings/upload-apk", content);
            buildApkMessage = "تم رفع التطبيق بنجاح!";
        }
        catch (Exception ex)
        {
            buildApkMessage = "فشل الرفع: " + ex.Message;
        }
        finally
        {
            isUploadingApk = false;
        }
    }
    private async Task PlayPreview(string soundFile)
    {
        if (string.IsNullOrEmpty(soundFile)) return;
        
        var audioUrl = $"/sounds/{soundFile}";
        if (soundFile.StartsWith("http")) audioUrl = soundFile;
        
        await JS.InvokeVoidAsync("eval", $"new Audio('{audioUrl}').play()");
    }
}
