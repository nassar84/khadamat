@page "/admin/systemsettings"
@page "/admin/settings"
@using Khadamat.Application.DTOs
@using Khadamat.BlazorUI.Services
@inject ApiClient Api
@inject Khadamat.BlazorUI.State.AppState AppState
@inject IJSRuntime JS
@attribute [Authorize(Roles = "SuperAdmin,SystemAdmin")]

<div class="px-2 pb-5 settings-page-wrapper">
    <div class="d-flex justify-content-between align-items-start align-items-md-center mb-4 flex-wrap gap-2 mt-2">
        <div>
            <h1 class="fw-bold mb-1 text-primary fs-4"><i class="fa-solid fa-gears me-2"></i>إعدادات النظام</h1>
            <p class="text-muted small mb-0">تحكم في هوية الموقع، اللوجو، الألوان، وإعدادات تطبيق الموبايل</p>
        </div>
        <div class="d-flex gap-2 w-100 w-md-auto">
            <button class="btn btn-primary-premium px-4 rounded-pill shadow-sm w-100 w-md-auto" @onclick="SaveSettings" disabled="@isSaving">
                @if (isSaving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                <i class="fa-solid fa-save me-2"></i>حفظ التغييرات
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert @(isSuccess ? "alert-success" : "alert-danger") rounded-4 shadow-sm mb-4 d-flex align-items-center justify-content-between animate-fade-in" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="fa-solid @(isSuccess ? "fa-circle-check text-success" : "fa-circle-exclamation text-danger") fs-5"></i>
                <span class="fw-bold">@statusMessage</span>
            </div>
            <button type="button" class="btn-close" @onclick='() => statusMessage = ""'></button>
        </div>
    }

    @if (isLoading)
    {
         <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">جاري تحميل الإعدادات...</p>
        </div>
    }
    else
    {
        <div class="row g-3">
            <!-- General Settings -->
            <div class="col-12 col-md-6 mb-2">
                <div class="glass-card p-3 h-100">
                    <h5 class="fw-bold mb-3 fs-6"><i class="fa-solid fa-server me-2 text-primary"></i>بيانات النظام</h5>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">الاسم بالعربية</label>
                        <input type="text" @bind="settings.ApplicationNameAr" class="form-control rounded-pill px-3" placeholder="مثال: خدماوي">
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">الاسم بالإنجليزية</label>
                        <input type="text" @bind="settings.ApplicationNameEn" class="form-control rounded-pill px-3" placeholder="Example: Khadamawi">
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">رسالة الترحيب / الوصف</label>
                        <textarea @bind="settings.WelcomeMessage" class="form-control rounded-3 px-3" rows="3" placeholder="أدخل رسالة ترحيبية تظهر للمستخدمين..."></textarea>
                    </div>
                    <div class="mb-0">
                        <label class="form-label small fw-bold">شعار الموقع (Logo)</label>
                        <div class="d-flex align-items-center gap-3 p-3 bg-light rounded-4 flex-wrap flex-sm-nowrap">
                            <div class="logo-preview-box bg-white p-2 rounded-3 border d-flex align-items-center justify-content-center flex-shrink-0" style="width: 70px; height: 70px;">
                                @if (!string.IsNullOrEmpty(settings.LogoUrl))
                                {
                                    <img src="@settings.LogoUrl" style="max-width: 100%; max-height: 100%;" />
                                }
                                else
                                {
                                    <i class="fa-solid fa-image text-muted fs-3"></i>
                                }
                            </div>
                            <div class="flex-grow-1 w-100" style="min-width: 0;">
                                <label class="btn btn-outline-primary btn-sm rounded-pill px-3 cursor-pointer w-100 mb-2">
                                    <i class="fa-solid fa-upload me-1"></i> رفع شعار جديد
                                    <InputFile OnChange="HandleLogoUpload" class="d-none" accept=".jpg,.jpeg,.png,.svg" />
                                </label>
                                <div class="x-small text-muted mb-2">يفضل صورة شفافة (PNG) بأبعاد متناسقة</div>
                                <input type="text" @bind="settings.LogoUrl" class="form-control form-control-sm rounded-pill opacity-75" placeholder="أو أدخل رابطاً مباشراً...">
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Contact Info -->
            <div class="col-12 col-md-6 mb-2">
                <div class="glass-card p-3 h-100">
                    <h5 class="fw-bold mb-3 fs-6"><i class="fa-solid fa-address-book me-2 text-success"></i>بيانات التواصل</h5>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">البريد الإلكتروني للدعم</label>
                        <input type="email" @bind="settings.ContactEmail" class="form-control rounded-pill px-3" placeholder="khadamawy@gmail.com">
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">رقم الهاتف للدعم</label>
                        <input type="text" @bind="settings.ContactPhone" class="form-control rounded-pill px-3" placeholder="+20...">
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold"><i class="fa-brands fa-whatsapp text-success me-1"></i>رقم واتساب الإدارة</label>
                        <input type="text" @bind="settings.ContactWhatsApp" class="form-control rounded-pill px-3" placeholder="201XXXXXXXXX (بدون +)">
                    </div>
                </div>
            </div>

            <!-- Payment Channels -->
            <div class="col-12 mb-2">
                <div class="glass-card p-3">
                    <h5 class="fw-bold mb-3 fs-6"><i class="fa-solid fa-money-bill-wave me-2 text-warning"></i>أرقام الدفع والمحافظ الإلكترونية</h5>
                    <p class="text-muted small mb-3">هذه الأرقام تظهر للمستخدمين عند الاشتراك في الباقات المدفوعة</p>
                    <div class="row g-3">
                        <div class="col-12 col-md-4">
                            <label class="form-label small fw-bold"><i class="fa-solid fa-mobile-screen text-primary me-1"></i>رقم انستا باي</label>
                            <div class="input-group">
                                <span class="input-group-text border-0 bg-light"><i class="fa-solid fa-credit-card text-primary"></i></span>
                                <input type="text" @bind="settings.InstaPayNumber" class="form-control border-0 bg-light" placeholder="010XXXXXXXX">
                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label small fw-bold"><i class="fa-solid fa-sim-card text-danger me-1"></i>رقم فودافون كاش</label>
                            <div class="input-group">
                                <span class="input-group-text border-0 bg-light"><i class="fa-solid fa-phone text-danger"></i></span>
                                <input type="text" @bind="settings.VodafoneCashNumber" class="form-control border-0 bg-light" placeholder="010XXXXXXXX">
                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label small fw-bold"><i class="fa-solid fa-wallet text-info me-1"></i>رقم محفظة أخرى</label>
                            <div class="input-group">
                                <span class="input-group-text border-0 bg-light"><i class="fa-solid fa-wallet text-info"></i></span>
                                <input type="text" @bind="settings.OtherWalletNumber" class="form-control border-0 bg-light" placeholder="010XXXXXXXX">
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">تعليمات الدفع (تظهر للمستخدم)</label>
                            <textarea @bind="settings.PaymentInstructions" class="form-control border-0 bg-light rounded-3" rows="3" 
                                      placeholder="مثال: قم بتحويل قيمة الاشتراك على أحد الأرقام أعلاه ثم أرسل إيصال الدفع على واتساب الإدارة..."></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <!-- System Features Control -->
            <div class="col-12 col-md-6 mb-2">
                <div class="glass-card p-3 h-100">
                    <h5 class="fw-bold mb-3 fs-6"><i class="fa-solid fa-sliders me-2 text-info"></i>التحكم في الميزات</h5>
                    
                    <div class="setting-toggle-row mb-3">
                        <div>
                            <div class="fw-bold small mb-0">السماح بالتسجيل</div>
                            <div class="text-muted x-small">السماح للمستخدمين الجدد بإنشاء حسابات</div>
                        </div>
                        <div class="form-check form-switch m-0">
                            <input class="form-check-input fs-4" type="checkbox" @bind="settings.AllowUserRegistration">
                        </div>
                    </div>

                    <div class="setting-toggle-row mb-3">
                        <div>
                            <div class="fw-bold small mb-0">التحقق من البريد الإلكتروني</div>
                            <div class="text-muted x-small">طلب تأكيد البريد عند التسجيل</div>
                        </div>
                        <div class="form-check form-switch m-0">
                            <input class="form-check-input fs-4" type="checkbox" @bind="settings.RequireEmailVerification">
                        </div>
                    </div>

                    <div class="setting-toggle-row mb-3">
                        <div>
                            <div class="fw-bold small mb-0">الموافقة التلقائية على التقييمات</div>
                            <div class="text-muted x-small">نشر التقييمات مباشرة دون مراجعة</div>
                        </div>
                        <div class="form-check form-switch m-0">
                            <input class="form-check-input fs-4" type="checkbox" @bind="settings.EnableReviewAutoApproval">
                        </div>
                    </div>

                    <div class="mb-0">
                        <label class="form-label small fw-bold">الحد الأقصى للخدمات لكل مزود</label>
                        <input type="number" @bind="settings.MaxServicesPerProvider" class="form-control rounded-pill px-3" min="1" max="100">
                    </div>
                </div>
            </div>

            <!-- System Control & Maintenance -->
            <div class="col-12 col-md-6 mb-2">
                <div class="glass-card p-3 h-100">
                    <h5 class="fw-bold mb-3 fs-6"><i class="fa-solid fa-shield-halved me-2 text-warning"></i>التحكم والأمان</h5>
                    
                    <div class="setting-toggle-row mb-3">
                        <div>
                            <div class="fw-bold small text-danger mb-0">وضع الصيانة</div>
                            <div class="text-muted x-small">سيتوقف التطبيق عن العمل للمستخدمين العاديين</div>
                        </div>
                        <div class="form-check form-switch m-0">
                            <input class="form-check-input fs-4" type="checkbox" @bind="settings.IsMaintenanceMode">
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">اللون الأساسي (Primary)</label>
                        <div class="color-row">
                            <input type="color" @bind="settings.PrimaryColor" class="form-control form-control-color rounded-pill flex-shrink-0" style="width: 50px; height: 38px;">
                            <input type="text" value="@settings.PrimaryColor" @oninput="e => settings.PrimaryColor = e.Value?.ToString()" class="form-control rounded-pill px-3 small" placeholder="#6c5ce7">
                        </div>
                    </div>

                    <div class="mb-0">
                        <label class="form-label small fw-bold">اللون الثانوي (Secondary)</label>
                        <div class="color-row">
                            <input type="color" @bind="settings.SecondaryColor" class="form-control form-control-color rounded-pill flex-shrink-0" style="width: 50px; height: 38px;">
                            <input type="text" value="@settings.SecondaryColor" @oninput="e => settings.SecondaryColor = e.Value?.ToString()" class="form-control rounded-pill px-3 small" placeholder="#a29bfe">
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sound Settings -->
            <div class="col-12 col-md-6 mb-2">
                <div class="glass-card p-3 h-100">
                    <h5 class="fw-bold mb-3 fs-6"><i class="fa-solid fa-volume-high me-2 text-primary"></i>نغمات وأصوات التطبيق</h5>
                    <p class="text-muted small mb-3">الأصوات المحسنة لتفاعل المستخدم مع الأنشطة المختلفة.</p>
                    
                    <div class="mb-3">
                        <label class="form-label small fw-bold">صوت فتح التطبيق</label>
                        <div class="sound-input-row">
                            <input type="text" @bind="settings.OpenAppSound" class="form-control rounded-pill px-3" placeholder="open_app.mp3">
                            <button class="btn btn-outline-secondary btn-sm rounded-pill px-3 sound-play-btn" @onclick='() => PlayPreview(settings.OpenAppSound ?? "")'><i class="fa-solid fa-play"></i></button>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">صوت إيجاد خدمة</label>
                        <div class="sound-input-row">
                            <input type="text" @bind="settings.FindServiceSound" class="form-control rounded-pill px-3" placeholder="find_service.mp3">
                            <button class="btn btn-outline-secondary btn-sm rounded-pill px-3 sound-play-btn" @onclick='() => PlayPreview(settings.FindServiceSound ?? "")'><i class="fa-solid fa-play"></i></button>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">صوت فتح التفاصيل</label>
                        <div class="sound-input-row">
                            <input type="text" @bind="settings.OpenDetailsSound" class="form-control rounded-pill px-3" placeholder="open_details.mp3">
                            <button class="btn btn-outline-secondary btn-sm rounded-pill px-3 sound-play-btn" @onclick='() => PlayPreview(settings.OpenDetailsSound ?? "")'><i class="fa-solid fa-play"></i></button>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">صوت استقبال رسالة</label>
                        <div class="sound-input-row">
                            <input type="text" @bind="settings.MessageReceivedSound" class="form-control rounded-pill px-3" placeholder="message.mp3">
                            <button class="btn btn-outline-secondary btn-sm rounded-pill px-3 sound-play-btn" @onclick='() => PlayPreview(settings.MessageReceivedSound ?? "")'><i class="fa-solid fa-play"></i></button>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">صوت استقبال تنبيه</label>
                        <div class="sound-input-row">
                            <input type="text" @bind="settings.NotificationReceivedSound" class="form-control rounded-pill px-3" placeholder="notif.mp3">
                            <button class="btn btn-outline-secondary btn-sm rounded-pill px-3 sound-play-btn" @onclick='() => PlayPreview(settings.NotificationReceivedSound ?? "")'><i class="fa-solid fa-play"></i></button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Mobile App Builder -->
            <div class="col-12 col-md-6 mb-2">
                <div class="glass-card p-3 h-100 bg-light border-0 shadow-sm border-top border-primary border-4">
                    <h5 class="fw-bold mb-3 fs-6"><i class="fa-brands fa-android me-2 text-success"></i>بناء تطبيق الموبايل</h5>
                    <p class="text-muted small mb-3">
                        يمكنك تغيير الرابط الذي سيتصل به تطبيق الموبايل وبناء التطبيق (APK) ورفعه تلقائياً.
                    </p>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">رابط الاستضافة (API Base URL)</label>
                        <input type="url" @bind="mobileAppDomainUrl" class="form-control rounded-pill px-3 bg-white" placeholder="https://api.khadamat.com">
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">اسم ملف الـ APK</label>
                        <input type="text" @bind="settings.ApkFilename" class="form-control rounded-pill px-3" placeholder="app.apk">
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">رابط أيقونة الـ APK</label>
                        <input type="text" @bind="settings.ApkIconUrl" class="form-control rounded-pill px-3" placeholder="رابط الأيقونة...">
                    </div>
                    <div class="d-grid mt-3">
                        <button class="btn btn-success rounded-pill fw-bold shadow-sm" @onclick="BuildMobileAppClick" disabled="@isBuildingApk">
                            @if (isBuildingApk)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                <span>جاري البناء... (قد يستغرق دقائق)</span>
                            }
                            else
                            {
                                <i class="fa-solid fa-hammer me-2"></i>
                                <span>بناء ونسخ التطبيق (APK)</span>
                            }
                        </button>
                    </div>
                    @if (!string.IsNullOrEmpty(buildApkMessage))
                    {
                        <div class="alert alert-info mt-3 mb-0 small text-center p-2 rounded-3">@buildApkMessage</div>
                    }

                    <div class="mt-3 pt-3 border-top">
                        <h6 class="fw-bold small mb-2"><i class="fa-solid fa-cloud-arrow-up me-2 text-primary"></i>رفع ملف APK مباشر</h6>
                        <p class="x-small text-muted">إذا كنت تمتلك ملف APK جاهزاً وتريد رفعه مباشرة للموقع:</p>
                        <div class="d-flex align-items-center gap-2">
                            <label class="btn btn-outline-dark btn-sm rounded-pill px-3 flex-grow-1 cursor-pointer">
                                <i class="fa-solid fa-file-export me-1"></i> اختر ملف التطبيق
                                <InputFile OnChange="HandleApkUpload" class="d-none" accept=".apk" />
                            </label>
                            @if (isUploadingApk)
                            {
                                <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Social Media Links -->
            <div class="col-12 col-md-6 mb-2">
                <div class="glass-card p-3 h-100">
                    <h5 class="fw-bold mb-3 fs-6"><i class="fa-brands fa-facebook me-2 text-primary"></i>روابط التواصل الاجتماعي</h5>
                    <div class="mb-3">
                        <label class="form-label small fw-bold"><i class="fa-brands fa-facebook me-2"></i>Facebook</label>
                        <input type="text" @bind="settings.FacebookUrl" class="form-control rounded-pill px-3" placeholder="https://facebook.com/...">
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold"><i class="fa-brands fa-twitter me-2"></i>Twitter</label>
                        <input type="text" @bind="settings.TwitterUrl" class="form-control rounded-pill px-3" placeholder="https://twitter.com/...">
                    </div>
                    <div class="mb-0">
                        <label class="form-label small fw-bold"><i class="fa-brands fa-instagram me-2"></i>Instagram</label>
                        <input type="text" @bind="settings.InstagramUrl" class="form-control rounded-pill px-3" placeholder="https://instagram.com/...">
                    </div>
                </div>
            </div>

            <!-- App Sharing Settings -->
            <div class="col-12 mb-2">
                <div class="glass-card p-3">
                    <h5 class="fw-bold mb-3 fs-6"><i class="fa-solid fa-share-nodes me-2 text-success"></i>إعدادات مشاركة التطبيق</h5>
                    <p class="text-muted small mb-3">هذه الإعدادات تُستخدم في جميع أزرار "شارك التطبيق" داخل الموقع والتطبيق</p>
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-bold"><i class="fa-solid fa-link me-1 text-primary"></i>رابط تحميل / مشاركة التطبيق</label>
                            <input type="url" @bind="settings.AppShareUrl" class="form-control rounded-pill px-3" placeholder="https://.../downloads/app.apk">
                            <div class="x-small text-muted mt-1">رابط تحميل APK أو صفحة التطبيق — يُستخدم في كل أزرار المشاركة</div>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-bold"><i class="fa-brands fa-google-play me-1 text-success"></i>رابط Google Play</label>
                            <input type="url" @bind="settings.GooglePlayUrl" class="form-control rounded-pill px-3" placeholder="https://play.google.com/store/apps/...">
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-bold"><i class="fa-brands fa-apple me-1"></i>رابط App Store (iOS)</label>
                            <input type="url" @bind="settings.AppStoreUrl" class="form-control rounded-pill px-3" placeholder="https://apps.apple.com/...">
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-bold"><i class="fa-solid fa-message me-1 text-warning"></i>نص رسالة المشاركة</label>
                            <textarea @bind="settings.AppShareText" class="form-control rounded-3 px-3" rows="3"
                                      placeholder="📲 تطبيق خدماوي — كل خدماتك في مكان واحد!&#10;تواصل مع أفضل الحرفيين والمهنيين بكل سهولة وأمان.&#10;&#10;🔗 حمل التطبيق الآن:"></textarea>
                            <div class="x-small text-muted mt-1">سيُضاف الرابط تلقائياً في نهاية الرسالة</div>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold mb-2">معاينة كارت المشاركة</label>
                            <AppShareCard ShowTagline="true" ShowStoreButtons="true" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Legal Documents -->
            <div class="col-12 col-md-6 mb-2">
                <div class="glass-card p-3 h-100">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold mb-0 fs-6"><i class="fa-solid fa-gavel me-2 text-secondary"></i>المستندات القانونية</h5>
                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3" style="font-size:0.75rem;" @onclick="FillDefaultLegalTexts" title="استيراد وتعبئة النصوص من صفحات الموقع">
                            <i class="fa-solid fa-rotate-left me-1"></i> استيراد من الموقع
                        </button>
                    </div>
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label small fw-bold mb-0">الشروط والأحكام</label>
                            <a href="/terms" target="_blank" class="text-decoration-none x-small text-primary">
                                <i class="fa-solid fa-arrow-up-right-from-square me-1"></i>معاينة صفحة الشروط
                            </a>
                        </div>
                        <textarea @bind="settings.TermsAndConditions" class="form-control rounded-3 px-3" rows="5" placeholder="أدخل نص الشروط والأحكام..."></textarea>
                    </div>
                    <div class="mb-0">
                        <div class="d-flex justify-content-between align-items-center mb-1">
