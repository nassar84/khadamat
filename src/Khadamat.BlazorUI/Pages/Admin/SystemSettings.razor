@code {
    private AppSettingsDto settings = new();
    private bool isLoading = true;
    private bool isSaving = false;
    private string statusMessage = "";
    private bool isSuccess = false;

    // Mobile App Build
    private string mobileAppDomainUrl = "";
    private bool isBuildingApk = false;
    private bool isUploadingApk = false;
    private string buildApkMessage = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadSettings();
    }

    private async Task LoadSettings()
    {
        isLoading = true;
        try
        {
            var response = await Api.GetSettingsAsync(forceRefresh: true);
            if (response.Success && response.Data != null)
            {
                settings = response.Data;
                if (!string.IsNullOrEmpty(settings.AppShareUrl)) AppState.AppShareUrl = settings.AppShareUrl;
                if (!string.IsNullOrEmpty(settings.AppShareText)) AppState.AppShareText = settings.AppShareText;
                if (!string.IsNullOrEmpty(settings.AppStoreUrl)) AppState.AppStoreUrl = settings.AppStoreUrl;
                if (!string.IsNullOrEmpty(settings.GooglePlayUrl)) AppState.GooglePlayUrl = settings.GooglePlayUrl;
                if (!string.IsNullOrEmpty(settings.ContactEmail)) AppState.ContactEmail = settings.ContactEmail;
                if (!string.IsNullOrEmpty(settings.ContactPhone)) AppState.ContactPhone = settings.ContactPhone;
                if (!string.IsNullOrEmpty(settings.ContactWhatsApp)) AppState.ContactWhatsApp = settings.ContactWhatsApp;
                AppState.TriggerStateChanged();
            }
            else
            {
                statusMessage = response.Message ?? "فشل تحميل الإعدادات.";
                isSuccess = false;
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"حدث خطأ أثناء الاتصال بالخادم: {ex.Message}";
            isSuccess = false;
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveSettings()
    {
        isSaving = true;
        statusMessage = "";
        
        var request = new UpdateAppSettingsRequest
        {
            ApplicationName = !string.IsNullOrWhiteSpace(settings.ApplicationNameAr) ? settings.ApplicationNameAr : (settings.ApplicationName ?? string.Empty),
            ApplicationNameAr = settings.ApplicationNameAr ?? string.Empty,
            ApplicationNameEn = settings.ApplicationNameEn ?? string.Empty,
            LogoUrl = settings.LogoUrl ?? string.Empty,
            ApkFilename = settings.ApkFilename ?? string.Empty,
            ApkIconUrl = settings.ApkIconUrl ?? string.Empty,
            PrimaryColor = settings.PrimaryColor ?? string.Empty,
            SecondaryColor = settings.SecondaryColor ?? string.Empty,
            ContactEmail = settings.ContactEmail ?? string.Empty,
            ContactPhone = settings.ContactPhone ?? string.Empty,
            ContactWhatsApp = settings.ContactWhatsApp ?? string.Empty,
            InstaPayNumber = settings.InstaPayNumber ?? string.Empty,
            VodafoneCashNumber = settings.VodafoneCashNumber ?? string.Empty,
            OtherWalletNumber = settings.OtherWalletNumber ?? string.Empty,
            PaymentInstructions = settings.PaymentInstructions ?? string.Empty,
            IsMaintenanceMode = settings.IsMaintenanceMode,
            WelcomeMessage = settings.WelcomeMessage ?? string.Empty,
            OpenAppSound = settings.OpenAppSound ?? string.Empty,
            FindServiceSound = settings.FindServiceSound ?? string.Empty,
            OpenDetailsSound = settings.OpenDetailsSound ?? string.Empty,
            MessageReceivedSound = settings.MessageReceivedSound ?? string.Empty,
            NotificationReceivedSound = settings.NotificationReceivedSound ?? string.Empty,
            AllowUserRegistration = settings.AllowUserRegistration,
            RequireEmailVerification = settings.RequireEmailVerification,
            MaxServicesPerProvider = settings.MaxServicesPerProvider,
            EnableReviewAutoApproval = settings.EnableReviewAutoApproval,
            MarketplaceDefaultListingDays = settings.MarketplaceDefaultListingDays,
            MarketplaceMaxListingsPerUser = settings.MarketplaceMaxListingsPerUser,
            MarketplaceRequireApproval = settings.MarketplaceRequireApproval,
            MarketplaceAutoExpire = settings.MarketplaceAutoExpire,
            FacebookUrl = settings.FacebookUrl ?? string.Empty,
            TwitterUrl = settings.TwitterUrl ?? string.Empty,
            InstagramUrl = settings.InstagramUrl ?? string.Empty,
            TermsAndConditions = settings.TermsAndConditions ?? string.Empty,
            PrivacyPolicy = settings.PrivacyPolicy ?? string.Empty,
            AppShareUrl = settings.AppShareUrl ?? string.Empty,
            AppShareText = settings.AppShareText ?? string.Empty,
            AppStoreUrl = settings.AppStoreUrl ?? string.Empty,
            GooglePlayUrl = settings.GooglePlayUrl ?? string.Empty
        };

        try
        {
            var response = await Api.UpdateSettingsAsync(request);
            if (response.Success)
            {
                isSuccess = true;
                statusMessage = "تم حفظ وتثبيت كافة إعدادات النظام بنجاح!";
                
                // Update AppState
                AppState.AppName = !string.IsNullOrEmpty(settings.ApplicationNameAr) ? settings.ApplicationNameAr : (settings.ApplicationName ?? string.Empty);
                AppState.AppNameAr = settings.ApplicationNameAr ?? string.Empty;
                AppState.AppLogo = settings.LogoUrl ?? string.Empty;
                AppState.PrimaryColor = settings.PrimaryColor ?? string.Empty;
                AppState.SecondaryColor = settings.SecondaryColor ?? string.Empty;
                AppState.AppShareUrl = settings.AppShareUrl ?? string.Empty;
                AppState.AppShareText = settings.AppShareText ?? string.Empty;
                AppState.AppStoreUrl = settings.AppStoreUrl ?? string.Empty;
                AppState.GooglePlayUrl = settings.GooglePlayUrl ?? string.Empty;
                AppState.ContactEmail = settings.ContactEmail ?? string.Empty;
                AppState.ContactPhone = settings.ContactPhone ?? string.Empty;
                AppState.ContactWhatsApp = settings.ContactWhatsApp ?? string.Empty;
                AppState.TriggerStateChanged();

                // Reload fresh copy from DB
                await LoadSettings();
            }
            else
            {
                isSuccess = false;
                statusMessage = response.Message ?? "فشل حفظ الإعدادات على الخادم.";
            }
        }
        catch (Exception ex)
        {
            isSuccess = false;
            statusMessage = $"حدث خطأ غير متوقع: {ex.Message}";
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

