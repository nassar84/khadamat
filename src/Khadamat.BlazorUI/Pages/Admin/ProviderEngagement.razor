    private void OpenCreateCampaignModal()
    {
        editingCampaign = new MarketingCampaignDto
        {
            CampaignName = "حملة جديدة",
            SubscriptionOfferMonths = 3,
            SubscriptionOfferText = "اشتراك مجاني لأول 3 شهور! ❤️",
            FacebookCommunityUrl = "https://www.facebook.com/profile.php?id=61595461124579",
            Slogan = "خدماوي.. خدمات بلدنا في مكان واحد ❤️",
            IsActive = true,
            TargetStage = "Launch"
        };
        showCampaignModal = true;
    }

    private void EditCampaign(MarketingCampaignDto campaign)
    {
        editingCampaign = new MarketingCampaignDto
        {
            Id = campaign.Id,
            CampaignName = campaign.CampaignName,
            CityId = campaign.CityId,
            CityName = campaign.CityName,
            GovernorateId = campaign.GovernorateId,
            GovernorateName = campaign.GovernorateName,
            Slogan = campaign.Slogan,
            MessageTemplate = campaign.MessageTemplate,
            SubscriptionOfferMonths = campaign.SubscriptionOfferMonths,
            SubscriptionOfferText = campaign.SubscriptionOfferText,
            FacebookCommunityUrl = campaign.FacebookCommunityUrl,
            IsActive = campaign.IsActive,
            IsDefault = campaign.IsDefault,
            TargetStage = campaign.TargetStage
        };
        showCampaignModal = true;
    }

    private async Task SaveCampaign()
    {
        if (editingCampaign == null) return;
        try
        {
            var success = await Api.SaveMarketingCampaignAsync(editingCampaign);
            if (success)
            {
                showCampaignModal = false;
                await LoadCampaigns();
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "فشل حفظ بيانات الحملة.");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", "خطأ: " + ex.Message);
        }
    }

    private async Task DeleteCampaign(int id)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "هل أنت متأكد من حذف هذه الحملة؟")) return;
        try
        {
            var success = await Api.DeleteMarketingCampaignAsync(id);
            if (success) await LoadCampaigns();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", "خطأ: " + ex.Message);
        }
    }

