            </div>

            <div class="col-12">
                <label class="form-label small fw-bold">الفقرة الترويجية التشجيعية (Follow-Up Text):</label>
                <textarea class="form-control" rows="3" @bind="distConfig.FollowUpText"></textarea>
                <div class="x-small text-muted mt-1">الفقرة التي توضح اهتمام خدماوي بالتعريف بأصحاب الخدمات والتواصل مع العملاء.</div>
            </div>
        </div>

        <div class="d-flex justify-content-end mt-4 pt-3 border-top">
            <button class="btn btn-success rounded-pill px-4 fw-bold shadow-sm" @onclick="SaveDistinctionConfig" disabled="@isSavingDistConfig">
