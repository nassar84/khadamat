@page "/admin/provider-engagement"
@using Khadamat.Application.DTOs
@using Khadamat.BlazorUI.Services
@using Khadamat.BlazorUI.Components.Admin
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "SystemAdmin,SuperAdmin,Admin")]
@inject ApiClient Api
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>نظام متابعة وتنشيط مقدمي الخدمات والتسويق المحلي | خدماوي</PageTitle>

<div class="px-2 pb-5">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-2 fw-bold">
                    <i class="fa-brands fa-whatsapp fa-lg me-1"></i> KHADAMAWY ENGAGEMENT & MARKETING
                </span>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2 py-1 x-small">
                    إطلاق سرس الليان 🚀
                </span>
            </div>
            <h3 class="fw-bold mt-2 mb-1">مركز متابعة وتنشيط مقدمي الخدمات</h3>
            <p class="text-muted small mb-0">نظام إدارة التذكيرات، التواصل التسويقي عبر واتساب، وحملات المدن المحلية</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary rounded-pill px-3 shadow-sm btn-sm" @onclick="RefreshCurrentTab">
                <i class="fa-solid fa-rotate me-1"></i> تحديث البيانات
            </button>
            <button class="btn btn-light border rounded-pill px-3 shadow-sm btn-sm" @onclick='() => Navigation.NavigateTo("/admin")'>
                <i class="fa-solid fa-arrow-right me-1"></i> العودة للوحة التحكم
            </button>
        </div>
    </div>

    <!-- Navigation Tabs -->
    <ul class="nav nav-pills custom-admin-tabs mb-4 gap-2 flex-wrap border-bottom pb-3">
        <li class="nav-item">
            <button class="nav-link @(activeTab == "services" ? "active" : "") rounded-pill" @onclick='() => SwitchTab("services")'>
                <i class="fa-solid fa-users-gear me-1"></i> متابعة مقدمي الخدمات (@servicesList.Count)
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(activeTab == "campaigns" ? "active" : "") rounded-pill" @onclick='() => SwitchTab("campaigns")'>
                <i class="fa-solid fa-bullhorn me-1"></i> حملات المدن والتسويق (@campaignsList.Count)
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(activeTab == "titles" ? "active" : "") rounded-pill" @onclick='() => SwitchTab("titles")'>
                <i class="fa-solid fa-signature me-1"></i> قاموس الألقاب المهنية (@titlesList.Count)
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(activeTab == "templates" ? "active" : "") rounded-pill" @onclick='() => SwitchTab("templates")'>
                <i class="fa-solid fa-file-lines me-1"></i> قوالب رسائل المتابعة (@templatesList.Count)
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(activeTab == "logs" ? "active" : "") rounded-pill" @onclick='() => SwitchTab("logs")'>
                <i class="fa-solid fa-clock-rotate-left me-1"></i> سجل العمليات والتوثيق (@logsList.Count)
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(activeTab == "distinction" ? "active" : "") rounded-pill" @onclick='() => SwitchTab("distinction")'>
                <i class="fa-solid fa-star me-1 text-warning"></i> نصوص وإعدادات تميز الخدمات
            </button>
        </li>
    </ul>

    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <!-- TAB 1: Services & KPIs Dashboard                                        -->
    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    @if (activeTab == "services")
    {
        <!-- KPI Cards -->
        <div class="row g-3 mb-4">
            <div class="col-6 col-md-3 col-xl-2">
                <div class="kpi-mini-card p-3 rounded-4 bg-white border shadow-sm">
                    <div class="text-muted x-small fw-bold mb-1">إجمالي الخدمات</div>
                    <div class="fs-4 fw-bold text-dark">@(kpi?.TotalServices ?? 0)</div>
                    <div class="x-small text-muted mt-1">متوسط الاكتمال: @(kpi?.AverageCompletenessPercentage.ToString("F0") ?? "0")%</div>
                </div>
            </div>
            <div class="col-6 col-md-3 col-xl-2">
                <div class="kpi-mini-card p-3 rounded-4 bg-white border border-danger-subtle shadow-sm">
                    <div class="text-danger x-small fw-bold mb-1"><i class="fa-solid fa-circle-exclamation me-1"></i>غير مكتملة (&lt;80%)</div>
                    <div class="fs-4 fw-bold text-danger">@(kpi?.IncompleteServices ?? 0)</div>
                    <div class="x-small text-muted mt-1">تحتاج متابعة وتنشيط</div>
                </div>
            </div>
            <div class="col-6 col-md-3 col-xl-2">
                <div class="kpi-mini-card p-3 rounded-4 bg-white border border-warning-subtle shadow-sm">
                    <div class="text-warning-emphasis x-small fw-bold mb-1"><i class="fa-solid fa-images me-1"></i>تحتاج صور أو أعمال</div>
                    <div class="fs-4 fw-bold text-warning-emphasis">@(kpi?.NeedsImages ?? 0)</div>
                    <div class="x-small text-muted mt-1">بدون صورة رئيسية أو نماذج</div>
                </div>
            </div>
            <div class="col-6 col-md-3 col-xl-2">
                <div class="kpi-mini-card p-3 rounded-4 bg-white border border-info-subtle shadow-sm">
                    <div class="text-info x-small fw-bold mb-1"><i class="fa-solid fa-align-right me-1"></i>تحتاج وصف / تواصل</div>
                    <div class="fs-4 fw-bold text-info">@((kpi?.NeedsDescription ?? 0) + (kpi?.NeedsContacts ?? 0))</div>
                    <div class="x-small text-muted mt-1">وصف موجز أو بدون هاتف</div>
                </div>
            </div>
            <div class="col-6 col-md-3 col-xl-2">
                <div class="kpi-mini-card p-3 rounded-4 bg-white border border-success-subtle shadow-sm">
                    <div class="text-success x-small fw-bold mb-1"><i class="fa-brands fa-whatsapp me-1"></i>واتساب تم تأكيده</div>
                    <div class="fs-4 fw-bold text-success">@(kpi?.ConfirmedWhatsAppSent ?? 0)</div>
                    <div class="x-small text-muted mt-1">تمت مراجعته وتأكيده</div>
                </div>
            </div>
            <div class="col-6 col-md-3 col-xl-2">
                <div class="kpi-mini-card p-3 rounded-4 bg-white border border-primary-subtle shadow-sm">
                    <div class="text-primary x-small fw-bold mb-1"><i class="fa-solid fa-check-double me-1"></i>اكتملت بعد المتابعة</div>
                    <div class="fs-4 fw-bold text-primary">@(kpi?.CompletedAfterEngagement ?? 0)</div>
                    <div class="x-small text-muted mt-1">تجاوزت 80% اكتمال</div>
                </div>
            </div>
        </div>

        <!-- Filter Bar -->
        <div class="glass-card p-3 rounded-4 mb-4 border bg-white shadow-sm">
            <div class="row g-2 align-items-center">
                <div class="col-12 col-md-3">
                    <div class="position-relative">
                        <i class="fa-solid fa-magnifying-glass position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                        <input type="text" class="form-control form-control-sm rounded-pill ps-5 bg-light border-0"
                               placeholder="بحث بالخدمة أو المزود أو الهاتف..."
                               @bind="searchFilter" @bind:event="oninput" @bind:after="ApplyServicesFilter" />
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <select class="form-select form-select-sm rounded-pill bg-light border-0" @bind="cityFilter" @bind:after="ApplyServicesFilter">
                        <option value="">جميع المدن</option>
                        <option value="212">سرس الليان (الحملة الحالية)</option>
                        <option value="211">منوف</option>
                        <option value="209">شبين الكوم</option>
                        <option value="213">أشمون</option>
                        <option value="216">قويسنا</option>
                        <option value="214">الباجور</option>
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <select class="form-select form-select-sm rounded-pill bg-light border-0" @bind="completenessFilter" @bind:after="ApplyServicesFilter">
                        <option value="">كل نسب الاكتمال</option>
                        <option value="critical">حرجة (&lt;50%)</option>
                        <option value="incomplete">غير مكتملة (&lt;80%)</option>
                        <option value="complete">مكتملة (&gt;=80%)</option>
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <select class="form-select form-select-sm rounded-pill bg-light border-0" @bind="missingFieldFilter" @bind:after="ApplyServicesFilter">
                        <option value="">كل النواقص</option>
                        <option value="mainImage">صورة الخدمة الرئيسية</option>
                        <option value="workImages">معرض صور الأعمال</option>
                        <option value="description">الوصف والتفاصيل</option>
                        <option value="contacts">أرقام التواصل</option>
                        <option value="location">الموقع والمدينة</option>
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <select class="form-select form-select-sm rounded-pill bg-light border-0" @bind="contactStatusFilter" @bind:after="ApplyServicesFilter">
                        <option value="">حالة التواصل</option>
                        <option value="never">لم يتم التواصل أبداً</option>
                        <option value="sent">تم التواصل مؤخراً</option>
                        <option value="optout">طلب عدم التواصل 🚫</option>
                    </select>
                </div>
                <div class="col-12 col-md-1 text-end">
                    <button class="btn btn-sm btn-outline-secondary rounded-pill w-100" @onclick="ResetFilters" title="إعادة ضبط الفلاتر">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Services Table -->
        <div class="glass-card rounded-4 border bg-white shadow-sm overflow-hidden">
            @if (isLoadingServices)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <div class="mt-2 text-muted small">جاري تحميل خدمات المزودين...</div>
                </div>
            }
            else if (!servicesList.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="fa-solid fa-briefcase fs-1 mb-2 opacity-25"></i>
                    <p class="fw-bold mb-1">لا توجد خدمات مطابقة للفلاتر المحددة</p>
                    <p class="small">جرب تعديل شروط البحث أو إزالة بعض الفلاتر</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>#</th>
                                <th>الخدمة ومقدمها</th>
                                <th>المدينة والمهنة</th>
                                <th>الهاتف والواتساب</th>
                                <th>نسبة الاكتمال والنواقص</th>
                                <th>حالة المتابعة</th>
                                <th class="text-end">إجراء المتابعة والتسويق</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in servicesList)
                            {
                                <tr>
                                    <td class="text-muted small">@s.ServiceId</td>
                                    <td>
                                        <div class="fw-bold text-dark">@s.ServiceName</div>
                                        <div class="x-small text-muted d-flex align-items-center gap-1">
                                            <span class="badge bg-secondary-subtle text-secondary rounded-pill px-2">@s.DetectedTitle</span>
                                            <span>@s.ProviderName</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="small fw-semibold">
                                            <i class="fa-solid fa-location-dot text-danger me-1"></i>@(string.IsNullOrEmpty(s.CityName) ? "غير محدد" : s.CityName)
                                        </div>
                                        <div class="x-small text-muted">@(s.CategoryName ?? "عام") @(!string.IsNullOrEmpty(s.Specialization) ? $"• {s.Specialization}" : "")</div>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="small font-monospace">@(s.FormattedPhone.Length > 0 ? s.FormattedPhone : (s.Phone1 ?? "بدون"))</span>
                                            @if (!string.IsNullOrEmpty(s.WhatsApp) || !string.IsNullOrEmpty(s.Phone1))
                                            {
                                                <button class="btn btn-sm btn-link text-success p-0" title="فتح واتساب سريع" @onclick="() => OpenOutreachModal(s.ServiceId)">
                                                    <i class="fa-brands fa-whatsapp fa-lg"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                    <td style="min-width: 220px;">
                                        <div class="d-flex align-items-center justify-content-between mb-1">
                                            <span class="x-small fw-bold">@s.CompletenessPercentage%</span>
                                            <span class="badge @(s.CompletenessPercentage >= 80 ? "bg-success" : s.CompletenessPercentage >= 50 ? "bg-warning text-dark" : "bg-danger") rounded-pill x-small">
                                                @(s.CompletenessPercentage >= 80 ? "مكتمل" : s.CompletenessPercentage >= 50 ? "متوسط" : "حرج")
                                            </span>
                                        </div>
                                        <div class="progress" style="height: 6px;">
                                            <div class="progress-bar @(s.CompletenessPercentage >= 80 ? "bg-success" : s.CompletenessPercentage >= 50 ? "bg-warning" : "bg-danger")"
                                                 style="width: @s.CompletenessPercentage%"></div>
                                        </div>
                                        @if (s.MissingFields.Any())
                                        {
                                            <div class="d-flex flex-wrap gap-1 mt-1">
                                                @foreach (var mf in s.MissingFields.Take(2))
                                                {
                                                    <span class="badge bg-light text-dark border x-small">@mf</span>
                                                }
                                                @if (s.MissingFields.Count > 2)
                                                {
                                                    <span class="badge bg-light text-muted border x-small">+@(s.MissingFields.Count - 2)</span>
                                                }
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        @if (s.DoNotContact)
                                        {
                                            <span class="badge bg-danger rounded-pill x-small">طلب عدم التواصل 🚫</span>
                                        }
                                        else if (s.ContactAttemptsCount > 0)
                                        {
                                            <div>
                                                <span class="badge @(s.LastContactStatus == "SentConfirmed" ? "bg-success" : "bg-info") rounded-pill x-small">
                                                    @s.LastContactStatus
                                                </span>
                                                <div class="x-small text-muted mt-1">
                                                    @(s.LastContactDate?.ToString("yyyy/MM/dd") ?? "") (@s.ContactAttemptsCount محاولات)
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary rounded-pill x-small">لم يتم التواصل</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-success btn-sm rounded-pill px-3 shadow-sm fw-bold"
                                                @onclick="() => OpenOutreachModal(s.ServiceId)">
                                            <i class="fa-brands fa-whatsapp me-1"></i> تواصل وتسويق
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }

    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <!-- TAB 2: City Marketing Campaigns (حملة سرس الليان والمدن)                 -->
    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    else if (activeTab == "campaigns")
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h5 class="fw-bold mb-1">حملات التسويق المحلي والمدن</h5>
                <p class="text-muted small mb-0">تخصيص الرسائل الترويجية والشعارات حسب كل مدينة ومرحلة إطلاق</p>
            </div>
            <button class="btn btn-primary rounded-pill px-4 btn-sm" @onclick="OpenCreateCampaignModal">
                <i class="fa-solid fa-plus me-1"></i> إضافة حملة جديدة
            </button>
        </div>

        <div class="row g-3">
            @foreach (var c in campaignsList)
            {
                <div class="col-12 col-lg-6">
                    <div class="p-4 rounded-4 bg-white border shadow-sm h-100 position-relative d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge @(c.IsActive ? "bg-success" : "bg-secondary") rounded-pill">
                                    @(c.IsActive ? "حملة نشطة ✅" : "غير نشطة")
                                </span>
                                @if (c.IsDefault)
                                {
                                    <span class="badge bg-primary rounded-pill">الحملة الافتراضية ⭐️</span>
                                }
                                <span class="badge bg-light text-dark border rounded-pill">@c.TargetStage</span>
                            </div>
                            <div class="d-flex gap-1">
                                <button class="btn btn-sm btn-link text-primary p-0" title="تعديل" @onclick="() => EditCampaign(c)">
                                    <i class="fa-solid fa-pen"></i>
                                </button>
                                @if (!c.IsDefault)
                                {
                                    <button class="btn btn-sm btn-link text-danger p-0 ms-2" title="حذف" @onclick="() => DeleteCampaign(c.Id)">
                                        <i class="fa-solid fa-trash-can"></i>
                                    </button>
                                }
                            </div>
                        </div>

                        <h5 class="fw-bold mb-1 text-dark">@c.CampaignName</h5>
                        <div class="text-muted small mb-3">
                            <i class="fa-solid fa-location-dot text-danger me-1"></i>@(string.IsNullOrEmpty(c.CityName) ? "عام (كل المدن)" : $"{c.CityName} - {c.GovernorateName}")
                        </div>

                        <div class="p-3 rounded-3 bg-light border mb-3 flex-grow-1">
                            <div class="small fw-bold text-primary mb-1">
                                <i class="fa-solid fa-quote-right me-1"></i>الشعار التسويقي (Slogan):
                            </div>
                            <div class="text-dark fw-semibold mb-2">"@c.Slogan"</div>

                            <div class="small fw-bold text-success mb-1">
                                <i class="fa-solid fa-gift me-1"></i>العرض الترويجي:
                            </div>
                            <div class="x-small text-muted mb-2">@c.SubscriptionOfferText (@c.SubscriptionOfferMonths شهور مجاناً)</div>

                            <div class="small fw-bold text-info mb-1">
                                <i class="fa-brands fa-facebook me-1"></i>رابط مجتمع فيسبوك:
                            </div>
                            <a href="@c.FacebookCommunityUrl" target="_blank" class="x-small text-truncate d-block text-primary">
                                @c.FacebookCommunityUrl
                            </a>
                        </div>

                        <div class="x-small text-muted d-flex justify-content-between">
                            <span>كود المدينة: @(c.CityId.HasValue ? c.CityId.ToString() : "افتراضي")</span>
                            <span>أول 3 شهور مجاناً</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <!-- TAB 3: Professional Titles Dictionary (قاموس الألقاب)                   -->
    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    else if (activeTab == "titles")
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h5 class="fw-bold mb-1">قاموس الألقاب المهنية الذكية</h5>
                <p class="text-muted small mb-0">قواعد المناداة التلقائية وفق طبيعة العمل (مدرس &larr; مستر، طبيب &larr; دكتور، مهندس &larr; باشمهندس)</p>
            </div>
            <button class="btn btn-primary rounded-pill px-4 btn-sm" @onclick="OpenCreateTitleModal">
                <i class="fa-solid fa-plus me-1"></i> إضافة قاعدة لقب
            </button>
        </div>

        <div class="glass-card rounded-4 border bg-white shadow-sm overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small">
                        <tr>
                            <th>الكلمة المفتاحية للنشاط</th>
                            <th>لقب المذكر</th>
                            <th>لقب المؤنث</th>
                            <th>اللقب الافتراضي</th>
                            <th>الأولوية</th>
                            <th>الحالة</th>
                            <th>ملاحظات</th>
                            <th class="text-end">إجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in titlesList)
                        {
                            <tr>
                                <td class="fw-bold text-primary">@t.ProfessionKeyword</td>
                                <td><span class="badge bg-light text-dark border">@t.MaleTitle</span></td>
                                <td><span class="badge bg-light text-dark border">@t.FemaleTitle</span></td>
                                <td><span class="badge bg-primary-subtle text-primary border border-primary-subtle">@t.DefaultTitle</span></td>
                                <td>@t.Priority</td>
                                <td>
                                    <span class="badge @(t.IsActive ? "bg-success" : "bg-secondary") rounded-pill">
                                        @(t.IsActive ? "نشط" : "معطل")
                                    </span>
                                </td>
                                <td class="x-small text-muted">@t.Notes</td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-link text-primary p-0" @onclick="() => EditTitle(t)">
                                        <i class="fa-solid fa-pen"></i>
                                    </button>
                                    <button class="btn btn-sm btn-link text-danger p-0 ms-2" @onclick="() => DeleteTitle(t.Id)">
                                        <i class="fa-solid fa-trash-can"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <!-- TAB 4: Reminder Templates (قوالب التذكيرات العشرة)                      -->
    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    else if (activeTab == "templates")
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h5 class="fw-bold mb-1">قوالب رسائل المتابعة والتذكير (10 قوالب مدمجة)</h5>
                <p class="text-muted small mb-0">تعديل نصوص واتساب، الإشعارات الفورية والتوجيه الداخلي لكل نوع متابعة</p>
            </div>
        </div>

        <div class="row g-3">
            @foreach (var tmpl in templatesList)
            {
                <div class="col-12 col-lg-6">
                    <div class="p-3 rounded-4 bg-white border shadow-sm h-100 d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-primary-subtle text-primary rounded-pill">@tmpl.ReminderType</span>
                                <span class="badge bg-light text-dark border">@tmpl.TargetChannel</span>
                            </div>
                            <button class="btn btn-sm btn-outline-primary rounded-pill px-3" @onclick="() => EditTemplate(tmpl)">
                                <i class="fa-solid fa-pen me-1"></i> تعديل القالب
                            </button>
                        </div>

                        <h6 class="fw-bold text-dark mb-1">@tmpl.Title</h6>
                        <p class="text-muted x-small mb-2">@tmpl.Description</p>

                        <div class="p-2 rounded-3 bg-light border flex-grow-1 mb-2 font-monospace x-small" style="white-space: pre-line; max-height: 160px; overflow-y: auto;">
                            @tmpl.WhatsAppTemplate
                        </div>

                        <div class="x-small text-muted d-flex justify-content-between">
                            <span>مسار التوجيه: @tmpl.DeepLinkRoute</span>
                            <span>بعد @tmpl.DaysAfterRegistration يوم</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <!-- TAB 5: Audit Logs (سجل العمليات والتوثيق)                                -->
    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    else if (activeTab == "logs")
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h5 class="fw-bold mb-1">سجل عمليات المتابعة والتوثيق الشامل</h5>
                <p class="text-muted small mb-0">تتبع حركات التواصل وتأكيدات واتساب والإشعارات الفورية</p>
            </div>
            <button class="btn btn-outline-secondary rounded-pill px-3 btn-sm" @onclick="LoadLogs">
                <i class="fa-solid fa-rotate me-1"></i> تحديث السجل
            </button>
        </div>

        <div class="glass-card rounded-4 border bg-white shadow-sm overflow-hidden">
            @if (!logsList.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="fa-solid fa-clock-rotate-left fs-1 mb-2 opacity-25"></i>
                    <p class="fw-bold mb-0">لا توجد عمليات مسجلة حتى الآن</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 x-small">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>الخدمة</th>
                                <th>المستلم والهاتف</th>
                                <th>القناة</th>
                                <th>نوع المتابعة</th>
                                <th>الحالة</th>
                                <th>التاريخ والتأكيد</th>
                                <th>المشرف</th>
                                <th>ملاحظات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in logsList)
                            {
                                <tr>
                                    <td class="text-muted">@log.Id</td>
                                    <td class="fw-bold">@log.ServiceName</td>
                                    <td>
                                        <div>@log.RecipientName</div>
                                        <div class="text-muted font-monospace">@log.RecipientPhone</div>
                                    </td>
                                    <td>
                                        <span class="badge @(log.Channel == "WhatsApp" ? "bg-success" : log.Channel == "PushNotification" ? "bg-primary" : "bg-info") rounded-pill">
                                            @log.Channel
                                        </span>
                                    </td>
                                    <td>@log.ReminderTypeTitle</td>
                                    <td>
                                        <span class="badge @(log.Status == "SentConfirmed" ? "bg-success" : log.Status == "Sent" ? "bg-info" : "bg-secondary") rounded-pill">
                                            @log.StatusArabic
                                        </span>
                                    </td>
                                    <td>
                                        <div>@log.PreparedAt.ToString("yyyy/MM/dd HH:mm")</div>
                                        @if (log.SentConfirmedAt.HasValue)
                                        {
                                            <div class="text-success"><i class="fa-solid fa-check me-1"></i>@log.SentConfirmedAt.Value.ToString("HH:mm")</div>
                                        }
                                    </td>
                                    <td>@(log.AdminUserName ?? "المشرف")</td>
                                    <td class="text-muted">@log.AdminNotes</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
</div>

