@code {
    private string activeTab = "services";
    private bool isLoadingServices = true;
    private EngagementKpiDto? kpi;
    private List<ServiceEngagementSummaryDto> servicesList = new();
    private List<MarketingCampaignDto> campaignsList = new();
    private List<ProfessionalTitleRuleDto> titlesList = new();
    private List<ProviderEngagementReminderDto> templatesList = new();
    private List<EngagementLogDto> logsList = new();

    // Filters
    private string searchFilter = "";
    private string cityFilter = "";
    private string completenessFilter = "";
    private string missingFieldFilter = "";
    private string contactStatusFilter = "";

    // Modal state
    private bool showOutreachModal = false;
    private int selectedServiceIdForModal = 0;

    // Campaign edit
    private bool showCampaignModal = false;
    private MarketingCampaignDto? editingCampaign;

    // Title edit
    private bool showTitleModal = false;
    private ProfessionalTitleRuleDto? editingTitle;

    // Template edit
    private bool showTemplateModal = false;
    private ProviderEngagementReminderDto? editingTemplate;

    // Distinction config
    private ServiceDistinctionConfigDto distConfig = new();
    private bool isSavingDistConfig = false;
    private string? distConfigFeedback;
    private bool distConfigSuccess = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadKpis();
        await LoadServices();
        await LoadCampaigns();
        await LoadTitles();
        await LoadTemplates();
        await LoadLogs();
        await LoadDistConfig();
    }

    private async Task SwitchTab(string tab)
    {
        activeTab = tab;
        await RefreshCurrentTab();
    }

    private async Task RefreshCurrentTab()
    {
        if (activeTab == "services")
        {
            await LoadKpis();
            await LoadServices();
        }
        else if (activeTab == "campaigns")
        {
            await LoadCampaigns();
        }
        else if (activeTab == "titles")
        {
            await LoadTitles();
        }
        else if (activeTab == "templates")
        {
            await LoadTemplates();
        }
        else if (activeTab == "logs")
        {
            await LoadLogs();
        }
        else if (activeTab == "distinction")
        {
            await LoadDistConfig();
        }
    }

    private async Task LoadDistConfig()
    {
        try
        {
            var res = await Api.GetServiceDistinctionConfigAsync();
            if (res != null) distConfig = res;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"LoadDistConfig: {ex.Message}");
        }
    }

    private async Task SaveDistinctionConfig()
    {
        isSavingDistConfig = true;
        distConfigFeedback = null;
        try
        {
            var res = await Api.SaveServiceDistinctionConfigAsync(distConfig);
            if (res != null && res.Success)
            {
                distConfigSuccess = true;
                distConfigFeedback = "✅ تم حفظ نصوص وإعدادات تميز الخدمات بنجاح!";
            }
            else
            {
                distConfigSuccess = false;
                distConfigFeedback = $"❌ فشل الحفظ: {res?.Message}";
            }
        }
        catch (Exception ex)
        {
            distConfigSuccess = false;
            distConfigFeedback = $"❌ خطأ: {ex.Message}";
        }
        finally
        {
            isSavingDistConfig = false;
        }
    }

    private async Task LoadKpis()
    {
        try { kpi = await Api.GetEngagementKpisAsync(); }
        catch (Exception ex) { Console.WriteLine($"LoadKpis: {ex.Message}"); }
    }

    private async Task LoadServices()
    {
        isLoadingServices = true;
        try
        {
            int? cityId = int.TryParse(cityFilter, out int cid) ? cid : null;
            servicesList = await Api.GetEngageableServicesAsync(
                search: string.IsNullOrWhiteSpace(searchFilter) ? null : searchFilter,
                cityId: cityId,
                completeness: string.IsNullOrWhiteSpace(completenessFilter) ? null : completenessFilter,
                missingField: string.IsNullOrWhiteSpace(missingFieldFilter) ? null : missingFieldFilter,
                contactStatus: string.IsNullOrWhiteSpace(contactStatusFilter) ? null : contactStatusFilter
            );
        }
        catch (Exception ex)
        {
            Console.WriteLine($"LoadServices: {ex.Message}");
        }
        finally
        {
            isLoadingServices = false;
        }
    }

    private async Task ApplyServicesFilter()
    {
        await LoadServices();
    }

    private async Task ResetFilters()
    {
        searchFilter = "";
        cityFilter = "";
        completenessFilter = "";
        missingFieldFilter = "";
        contactStatusFilter = "";
        await LoadServices();
    }

