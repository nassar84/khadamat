@code {
    private string activeTab = "providers"; // "providers" or "plans"
    
    // Providers Data
    private List<AdminProviderSubscriptionDto> providers = new();
    private List<AdminProviderSubscriptionDto> filteredProviders = new();
    private HashSet<int> selectedProviderIds = new();
    private bool isLoadingProviders = true;
    private string searchTerm = "";
    private string statusFilter = "";

    // Plans Data
    private List<SubscriptionPlanDto> plans = new();
    private bool isLoadingPlans = true;

    // Modals & Actions
    private bool showExtendModal = false;
    private bool extendIsAll = false;
    private int extendDays = 90;

    private bool showAssignModal = false;
    private AdminProviderSubscriptionDto? selectedProviderForPlan;
    private int targetPlanId;
    private int targetCustomDays = 90;

    private bool showPlanModal = false;
    private SubscriptionPlanDto? editingPlan;

    private bool isExecutingAction = false;
    private string? feedback;
    private bool feedbackSuccess;

    private bool IsAllSelected => filteredProviders.Any() && filteredProviders.All(p => selectedProviderIds.Contains(p.ProviderId));

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadProviders(), LoadPlans());
    }

    private void SetTab(string tab)
    {
        activeTab = tab;
        feedback = null;
    }

    private async Task LoadProviders()
    {
        isLoadingProviders = true;
        try
        {
            providers = await Api.GetAdminProviderSubscriptionsAsync();
            FilterProviders();
        }
        catch (Exception ex)
        {
            ShowFeedback("فشل تحميل اشتراكات المزودين: " + ex.Message, false);
        }
        finally
        {
            isLoadingProviders = false;
        }
    }

    private async Task LoadPlans()
    {
        isLoadingPlans = true;
        try
        {
            plans = await Api.GetSubscriptionPlansAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine("Plans load error: " + ex.Message);
        }
        finally
        {
            isLoadingPlans = false;
        }
    }

    private void FilterProviders()
    {
        var list = providers.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            string s = searchTerm.Trim().ToLower();
            list = list.Where(x =>
                (x.BusinessName?.ToLower().Contains(s) ?? false) ||
                (x.OwnerName?.ToLower().Contains(s) ?? false) ||
                (x.Email?.ToLower().Contains(s) ?? false) ||
                (x.PhoneNumber?.Contains(s) ?? false) ||
                (x.CityName?.ToLower().Contains(s) ?? false)
            );
        }

        if (!string.IsNullOrWhiteSpace(statusFilter))
        {
            if (statusFilter == "active")
                list = list.Where(x => x.IsActive && !x.IsExpired);
            else if (statusFilter == "expired")
                list = list.Where(x => !x.IsActive || x.IsExpired);
            else if (statusFilter == "expiring")
                list = list.Where(x => x.IsActive && !x.IsExpired && x.DaysRemainingCount <= 7);
        }

        filteredProviders = list.ToList();
    }

    private void ApplyFilter(string status)
    {
        statusFilter = status;
        FilterProviders();
    }

    // ── Selection Methods ───────────────────────────────────────────────

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        bool isChecked = (bool)(e.Value ?? false);
        if (isChecked)
        {
            foreach (var p in filteredProviders)
            {
                selectedProviderIds.Add(p.ProviderId);
            }
        }
        else
        {
            foreach (var p in filteredProviders)
            {
                selectedProviderIds.Remove(p.ProviderId);
            }
        }
    }

    private void ToggleSelectProvider(int providerId)
    {
        if (selectedProviderIds.Contains(providerId))
            selectedProviderIds.Remove(providerId);
        else
            selectedProviderIds.Add(providerId);
    }

    // ── Extend Actions (All / Selected / Single) ────────────────────────

    private void OpenExtendModal(bool isAll)
    {
        extendIsAll = isAll;
        extendDays = 90;
        showExtendModal = true;
    }

    private async Task ExecuteExtend()
    {
        isExecutingAction = true;
        try
        {
            var req = new ExtendSubscriptionsRequest
            {
                All = extendIsAll,
                ProviderIds = extendIsAll ? new List<int>() : selectedProviderIds.ToList(),
                DaysToAdd = extendDays
            };

            var res = await Api.ExtendSubscriptionsAsync(req);
            if (res.Success)
            {
                showExtendModal = false;
                selectedProviderIds.Clear();
                await LoadProviders();
                ShowFeedback(res.Message ?? "تم تمديد الاشتراكات بنجاح", true);
            }
            else
            {
                ShowFeedback(res.Message ?? "فشل تمديد الاشتراكات", false);
            }
        }
        catch (Exception ex)
        {
            ShowFeedback("خطأ: " + ex.Message, false);
        }
        finally
        {
            isExecutingAction = false;
        }
    }

    private async Task QuickExtendProvider(int providerId, int days)
    {
        isExecutingAction = true;
        try
        {
            var req = new ExtendSubscriptionsRequest
            {
                All = false,
                ProviderIds = new List<int> { providerId },
                DaysToAdd = days
            };

            var res = await Api.ExtendSubscriptionsAsync(req);
            if (res.Success)
            {
                await LoadProviders();
                ShowFeedback($"تم تمديد الاشتراك بمقدار {days} يوماً بنجاح", true);
            }
            else
            {
                ShowFeedback(res.Message ?? "فشل تمديد الاشتراك", false);
            }
        }
        catch (Exception ex)
        {
            ShowFeedback("خطأ: " + ex.Message, false);
        }
        finally
        {
            isExecutingAction = false;
        }
    }

    // ── Toggle Status Actions ───────────────────────────────────────────

    private async Task ToggleSingleProviderStatus(int providerId, bool isActive)
    {
        isExecutingAction = true;
        try
        {
            var req = new ToggleSubscriptionsStatusRequest
            {
                All = false,
                ProviderIds = new List<int> { providerId },
                IsActive = isActive
            };

            var res = await Api.ToggleSubscriptionsStatusAsync(req);
            if (res.Success)
            {
                await LoadProviders();
                ShowFeedback(res.Message ?? "تم تغيير حالة الاشتراك بنجاح", true);
            }
            else
            {
                ShowFeedback(res.Message ?? "فشل تغيير حالة الاشتراك", false);
            }
        }
        catch (Exception ex)
        {
            ShowFeedback("خطأ: " + ex.Message, false);
        }
        finally
        {
            isExecutingAction = false;
        }
    }

    private async Task ToggleSelectedStatus(bool isActive)
    {
        if (!selectedProviderIds.Any()) return;

        string actionText = isActive ? "تفعيل" : "إيقاف";
        if (!await JS.InvokeAsync<bool>("confirm", $"هل أنت متأكد من {actionText} اشتراك ({selectedProviderIds.Count}) مقدم خدمة محدد؟"))
            return;

        isExecutingAction = true;
        try
        {
            var req = new ToggleSubscriptionsStatusRequest
            {
                All = false,
                ProviderIds = selectedProviderIds.ToList(),
                IsActive = isActive
            };

            var res = await Api.ToggleSubscriptionsStatusAsync(req);
            if (res.Success)
            {
                selectedProviderIds.Clear();
                await LoadProviders();
                ShowFeedback(res.Message ?? $"تم {actionText} الاشتراكات المحددة بنجاح", true);
            }
            else
            {
                ShowFeedback(res.Message ?? "فشل تنفيذ العملية", false);
            }
        }
        catch (Exception ex)
        {
            ShowFeedback("خطأ: " + ex.Message, false);
        }
        finally
        {
            isExecutingAction = false;
        }
    }

    // ── Assign Plan Actions ─────────────────────────────────────────────

    private void OpenAssignPlanModal(AdminProviderSubscriptionDto p)
    {
        selectedProviderForPlan = p;
        targetPlanId = p.PlanId ?? plans.FirstOrDefault()?.Id ?? 0;
        var plan = plans.FirstOrDefault(x => x.Id == targetPlanId);
        targetCustomDays = plan?.DurationInDays ?? 90;
        showAssignModal = true;
    }

    private async Task ExecuteAssignPlan()
    {
        if (selectedProviderForPlan == null || targetPlanId <= 0) return;

        isExecutingAction = true;
        try
        {
            var req = new AssignPlanRequest
            {
                ProviderId = selectedProviderForPlan.ProviderId,
                PlanId = targetPlanId,
                CustomDays = targetCustomDays
            };

            var res = await Api.AssignPlanAsync(req);
            if (res.Success)
            {
                showAssignModal = false;
                await LoadProviders();
                ShowFeedback(res.Message ?? "تم تعيين الخطة بنجاح", true);
            }
            else
            {
                ShowFeedback(res.Message ?? "فشل تعيين الخطة", false);
            }
        }
        catch (Exception ex)
        {
            ShowFeedback("خطأ: " + ex.Message, false);
        }
        finally
        {
            isExecutingAction = false;
        }
    }

    // ── Plans CRUD Actions ──────────────────────────────────────────────

    private void OpenPlanModal(SubscriptionPlanDto? plan)
    {
        editingPlan = plan != null
            ? new SubscriptionPlanDto
              {
                  Id = plan.Id,
                  Name = plan.Name,
                  Price = plan.Price,
                  DurationInDays = plan.DurationInDays,
                  MaxServices = plan.MaxServices,
                  IsFeatured = plan.IsFeatured
              }
            : new SubscriptionPlanDto { DurationInDays = 90, MaxServices = 5 };
        showPlanModal = true;
        feedback = null;
    }

    private void ClosePlanModal()
    {
        showPlanModal = false;
        editingPlan = null;
    }

    private async Task SavePlan()
    {
        if (editingPlan == null) return;
        if (string.IsNullOrWhiteSpace(editingPlan.Name))
        {
            ShowFeedback("يرجى إدخال اسم الخطة", false);
            return;
        }

        isExecutingAction = true;
        try
        {
            bool success;
            if (editingPlan.Id > 0)
            {
                success = await Api.PostAsync<bool>($"v1/subscriptions/plans/{editingPlan.Id}", editingPlan);
            }
            else
            {
                success = await Api.PostAsync<bool>("v1/subscriptions/plans", editingPlan);
            }

            if (success)
            {
                ClosePlanModal();
                await LoadPlans();
                ShowFeedback(editingPlan.Id > 0 ? "تم تحديث الخطة بنجاح" : "تم إضافة الخطة بنجاح", true);
            }
            else
            {
                ShowFeedback("حدث خطأ أثناء حفظ الخطة", false);
            }
        }
        catch (Exception ex)
        {
            ShowFeedback("خطأ: " + ex.Message, false);
        }
        finally
        {
            isExecutingAction = false;
        }
    }

    private async Task DeletePlan(SubscriptionPlanDto plan)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"هل أنت متأكد من حذف باقة \"{plan.Name}\"؟"))
            return;

        try
        {
            var success = await Api.PostAsync<bool>($"v1/subscriptions/plans/{plan.Id}/delete", new { });
            if (success)
            {
                plans.Remove(plan);
                ShowFeedback("تم حذف الباقة بنجاح", true);
            }
            else
            {
                ShowFeedback("لا يمكن حذف الباقة، قد تكون مستخدمة في اشتراكات نشطة", false);
            }
        }
        catch (Exception ex)
        {
            ShowFeedback("خطأ: " + ex.Message, false);
        }
    }

    private void ShowFeedback(string msg, bool success)
    {
        feedback = msg;
        feedbackSuccess = success;
        StateHasChanged();
    }

    private string GetPlanIcon(string name) => name switch
    {
        var n when n.Contains("مجانية") || n.Contains("تجريبية") => "fa-solid fa-leaf",
        var n when n.Contains("أساسية") || n.Contains("مبتدئ") => "fa-solid fa-seedling",
        var n when n.Contains("مميزة") || n.Contains("احترافية") => "fa-solid fa-rocket",
        var n when n.Contains("سنوية") || n.Contains("محترفين") || n.Contains("ذهبية") => "fa-solid fa-crown",
        _ => "fa-solid fa-gem"
    };

    private string GetDurationText(int days) => days switch
    {
        7 => "أسبوعية",
        14 => "نصف شهرية",
        30 => "شهرية",
        90 => "ربع سنوية (3 أشهر)",
        180 => "نصف سنوية (6 أشهر)",
        365 => "سنوية",
        _ => $"{days} يوم"
    };
}
