@code {
    private List<MarketplaceItemDto> allItems = new();
    private List<MarketplaceItemDto> displayedItems = new();

    private string activeTab = "all";
    private string searchQuery = "";
    private string filterStatus = "";
    private string filterCondition = "";
    private string filterFeatured = "";

    private bool isLoading = true;
    private bool isActionLoading = false;
    private int defaultListingDays = 30;

    // Modals
    private bool showApproveModal = false;
    private bool showRejectModal = false;
    private bool showStatusModal = false;
    private bool showEditDatesModal = false;
    private bool showFeaturedModal = false;

    private MarketplaceItemDto? selectedItem;
    private string rejectNotes = "";
    private string approveNotes = "";
    private DateTime approveStartDate = DateTime.Today;
    private DateTime approveEndDate = DateTime.Today.AddDays(30);
    private string newStatus = "";
    private int featuredDays = 7;

    // Toast
    private bool showToast = false;
    private bool toastSuccess = true;
    private string toastMsg = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        StateHasChanged();

        // Load settings first
        var settings = await Api.GetMarketplaceSettingsAsync();
        if (settings != null) defaultListingDays = settings.DefaultListingDays;

        // Load ALL items via admin endpoint (includes pending/unapproved)
        allItems = await Api.GetAllMarketplaceItemsAdminAsync(300);

        ApplyFilter();
        isLoading = false;
    }

    private void SetTab(string tab)
    {
        activeTab = tab;
        filterStatus = tab switch
        {
            "active"  => "Available",
            "sold"    => "Sold",
            "expired" => "Expired",
            "locked"  => "Locked",
            "pending" => "__pending__",
            _         => ""
        };
        ApplyFilter();
    }

    private void OnSearchChanged() => ApplyFilter();

    private void ApplyFilter()
    {
        var result = allItems.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            var q = searchQuery.ToLower();
            result = result.Where(i =>
                i.Title.ToLower().Contains(q) ||
                i.SellerName.ToLower().Contains(q) ||
                i.CategoryName.ToLower().Contains(q));
        }

        if (filterStatus == "__pending__")
        {
            // Items not yet approved/listed
            result = result.Where(i => !i.Approved);
        }
        else if (!string.IsNullOrEmpty(filterStatus))
        {
            result = result.Where(i => i.ItemStatus == filterStatus);
        }

        if (!string.IsNullOrEmpty(filterCondition))
            result = result.Where(i => i.Condition == filterCondition);

        if (filterFeatured == "featured")
            result = result.Where(i => i.IsFeatured);
        else if (filterFeatured == "not_featured")
            result = result.Where(i => !i.IsFeatured);

        displayedItems = result.OrderByDescending(i => i.CreatedAt).ToList();
        StateHasChanged();
    }

    private void ResetFilters()
    {
        searchQuery = "";
        filterStatus = "";
        filterCondition = "";
        filterFeatured = "";
        activeTab = "all";
        ApplyFilter();
    }

    // ===== Modal Openers =====
    private void OpenApproveModal(MarketplaceItemDto item)
    {
        selectedItem = item;
        approveStartDate = DateTime.Today;
        approveEndDate = DateTime.Today.AddDays(defaultListingDays);
        approveNotes = "";
        showApproveModal = true;
    }

    private void OpenRejectModal(MarketplaceItemDto item)
    {
        selectedItem = item;
        rejectNotes = "";
        showRejectModal = true;
    }

    private void OpenStatusModal(MarketplaceItemDto item)
    {
        selectedItem = item;
        newStatus = item.ItemStatus;
        showStatusModal = true;
    }

    private void OpenEditDatesModal(MarketplaceItemDto item)
    {
        selectedItem = item;
        approveStartDate = item.StartDate?.ToLocalTime().Date ?? DateTime.Today;
        approveEndDate = item.EndDate?.ToLocalTime().Date ?? DateTime.Today.AddDays(defaultListingDays);
        showEditDatesModal = true;
    }

    private void OpenFeaturedModal(MarketplaceItemDto item)
    {
        selectedItem = item;
        featuredDays = 7;
        showFeaturedModal = true;
    }

    private void SetDefaultDates()
    {
        approveStartDate = DateTime.Today;
        approveEndDate = DateTime.Today.AddDays(defaultListingDays);
    }

    // ===== Actions =====
    private async Task ConfirmApprove()
    {
        if (selectedItem == null) return;
        isActionLoading = true;
        var success = await Api.ApproveMarketplaceItemWithDatesAsync(
            selectedItem.Id,
            approveStartDate,
            approveEndDate,
            approveNotes);
        if (success)
        {
            selectedItem.ListedAt = DateTime.UtcNow;
            selectedItem.StartDate = approveStartDate;
            selectedItem.EndDate = approveEndDate;
            selectedItem.ItemStatus = "Available";
            selectedItem.Approved = true;
            ShowToast($"✅ تم قبول الإعلان ونشره حتى {approveEndDate:dd/MM/yyyy}", true);
            ApplyFilter();
        }
        else ShowToast("فشل قبول الإعلان", false);
        isActionLoading = false;
        CloseModals();
    }

    private async Task ConfirmReject()
    {
        if (selectedItem == null) return;
        isActionLoading = true;
        var success = await Api.RejectMarketplaceItemAsync(selectedItem.Id, rejectNotes);
        if (success)
        {
            allItems.Remove(selectedItem);
            ShowToast("تم رفض الإعلان", true);
            ApplyFilter();
        }
        else ShowToast("فشل رفض الإعلان", false);
        isActionLoading = false;
        CloseModals();
    }

    private async Task ConfirmStatusChange()
    {
        if (selectedItem == null || string.IsNullOrEmpty(newStatus)) return;
        isActionLoading = true;
        var success = await Api.ChangeMarketplaceItemStatusAsync(selectedItem.Id, newStatus);
        if (success)
        {
            var old = selectedItem.ItemStatus;
            selectedItem.ItemStatus = newStatus;
            ShowToast($"تم تغيير الحالة إلى '{GetStatusName(newStatus)}'", true);
            ApplyFilter();
        }
        else ShowToast("فشل تغيير الحالة", false);
        isActionLoading = false;
        CloseModals();
    }

    private async Task ConfirmEditDates()
    {
        if (selectedItem == null) return;
        isActionLoading = true;
        // Re-approve with new dates (admin action)
        var success = await Api.ApproveMarketplaceItemWithDatesAsync(
            selectedItem.Id,
            approveStartDate,
            approveEndDate,
            null);
        if (success)
        {
            selectedItem.StartDate = approveStartDate;
            selectedItem.EndDate = approveEndDate;
            ShowToast($"✅ تم تحديث مدة الإعلان حتى {approveEndDate:dd/MM/yyyy}", true);
            ApplyFilter();
        }
        else ShowToast("فشل تحديث المدة", false);
        isActionLoading = false;
        CloseModals();
    }

    private async Task ConfirmFeatured()
    {
        if (selectedItem == null) return;
        isActionLoading = true;
        var success = await Api.SetMarketplaceItemFeaturedAsync(selectedItem.Id, featuredDays);
        if (success)
        {
            selectedItem.IsFeatured = true;
            ShowToast($"⭐ تم تمييز الإعلان لمدة {featuredDays} أيام", true);
        }
        else ShowToast("فشل تمييز الإعلان", false);
        isActionLoading = false;
        CloseModals();
    }

    private async Task AdminChangeStatus(MarketplaceItemDto item, string status)
    {
        var success = await Api.ChangeMarketplaceItemStatusAsync(item.Id, status);
        if (success)
        {
            item.ItemStatus = status;
            ShowToast($"تم تغيير حالة الإعلان إلى '{GetStatusName(status)}'", true);
            ApplyFilter();
            StateHasChanged();
        }
        else ShowToast("فشل تغيير الحالة", false);
    }

    private void CloseModals()
    {
        showApproveModal = false;
        showRejectModal = false;
        showStatusModal = false;
        showEditDatesModal = false;
        showFeaturedModal = false;
        selectedItem = null;
    }

    // ===== Helpers =====
    private string GetAdminStatusLabel(MarketplaceItemDto item)
    {
        if (!item.Approved) return "قيد المراجعة";
        if (item.IsExpired && item.ItemStatus == "Available") return "منتهي";
        return item.ItemStatus switch
        {
            "Available"  => "نشط",
            "Sold"       => "تم البيع",
            "Expired"    => "منتهي",
            "Locked"     => "مقفل",
            "Cancelled"  => "ملغي",
            _            => item.ItemStatus
        };
    }

    private string GetAdminStatusIcon(MarketplaceItemDto item)
    {
        if (!item.Approved) return "fa-solid fa-hourglass-half";
        if (item.IsExpired && item.ItemStatus == "Available") return "fa-solid fa-clock-rotate-left";
        return item.ItemStatus switch
        {
            "Available"  => "fa-solid fa-circle-check",
            "Sold"       => "fa-solid fa-handshake",
            "Expired"    => "fa-solid fa-clock-rotate-left",
            "Locked"     => "fa-solid fa-lock",
            "Cancelled"  => "fa-solid fa-ban",
            _            => "fa-solid fa-circle"
        };
    }

    private string GetAdminStatusClass(MarketplaceItemDto item)
    {
        if (!item.Approved) return "status-pill pill-pending";
        if (item.IsExpired && item.ItemStatus == "Available") return "status-pill pill-expired";
        return item.ItemStatus switch
        {
            "Available"  => "status-pill pill-available",
            "Sold"       => "status-pill pill-sold",
            "Expired"    => "status-pill pill-expired",
            "Locked"     => "status-pill pill-locked",
            "Cancelled"  => "status-pill pill-cancelled",
            _            => "status-pill pill-pending"
        };
    }

    private string GetStatusName(string s) => s switch
    {
        "Available"  => "نشط",
        "Sold"       => "تم البيع",
        "Expired"    => "منتهي",
        "Locked"     => "مقفل",
        "Cancelled"  => "ملغي",
        _            => s
    };

    private async void ShowToast(string message, bool success)
    {
        toastMsg = message;
        toastSuccess = success;
        showToast = true;
        StateHasChanged();
        await Task.Delay(3500);
        showToast = false;
        StateHasChanged();
    }
}
