@page "/admin/marketplace"
@using Khadamat.Application.DTOs
@using Khadamat.BlazorUI.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "SystemAdmin,SuperAdmin")]
@inject ApiClient Api
@inject NavigationManager Navigation

<PageTitle>إدارة المتجر - لوحة التحكم</PageTitle>

<div class="marketplace-admin px-2 px-md-3 py-4">

    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <div>
            <h3 class="fw-bold mb-1">
                <span class="store-icon-wrap me-2">
                    <i class="fa-solid fa-store store-anim text-primary"></i>
                </span>إدارة إعلانات المتجر
            </h3>
            <p class="text-muted small mb-0">مراجعة وإدارة إعلانات البيع، الموافقة، التحكم في المدة والحالة</p>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <button class="btn btn-outline-primary rounded-pill btn-sm" @onclick="LoadData">
                <i class="fa-solid fa-rotate me-1"></i> تحديث
            </button>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-sm-4 col-md-2">
            <div class="admin-stat-card p-3 rounded-4 text-center cursor-pointer @(activeTab=="all" ? "stat-active" : "")" @onclick='() => SetTab("all")'>
                <div class="stat-num text-primary fw-bold">@allItems.Count</div>
                <div class="stat-label">الكل</div>
            </div>
        </div>
        <div class="col-6 col-sm-4 col-md-2">
            <div class="admin-stat-card p-3 rounded-4 text-center cursor-pointer @(activeTab=="pending" ? "stat-active" : "")" @onclick='() => SetTab("pending")'>
                <div class="stat-num text-warning fw-bold">@allItems.Count(i => !i.Approved)</div>
                <div class="stat-label">بانتظار المراجعة</div>
            </div>
        </div>
        <div class="col-6 col-sm-4 col-md-2">
            <div class="admin-stat-card p-3 rounded-4 text-center cursor-pointer @(activeTab=="active" ? "stat-active" : "")" @onclick='() => SetTab("active")'>
                <div class="stat-num text-success fw-bold">@allItems.Count(i => i.ItemStatus == "Available")</div>
                <div class="stat-label">نشط</div>
            </div>
        </div>
        <div class="col-6 col-sm-4 col-md-2">
            <div class="admin-stat-card p-3 rounded-4 text-center cursor-pointer @(activeTab=="sold" ? "stat-active" : "")" @onclick='() => SetTab("sold")'>
                <div class="stat-num text-secondary fw-bold">@allItems.Count(i => i.ItemStatus == "Sold")</div>
                <div class="stat-label">تم البيع</div>
            </div>
        </div>
        <div class="col-6 col-sm-4 col-md-2">
            <div class="admin-stat-card p-3 rounded-4 text-center cursor-pointer @(activeTab=="expired" ? "stat-active" : "")" @onclick='() => SetTab("expired")'>
                <div class="stat-num text-danger fw-bold">@allItems.Count(i => i.ItemStatus == "Expired" || i.IsExpired)</div>
                <div class="stat-label">منتهي</div>
            </div>
        </div>
        <div class="col-6 col-sm-4 col-md-2">
            <div class="admin-stat-card p-3 rounded-4 text-center cursor-pointer @(activeTab=="locked" ? "stat-active" : "")" @onclick='() => SetTab("locked")'>
                <div class="stat-num text-warning fw-bold">@allItems.Count(i => i.ItemStatus == "Locked")</div>
                <div class="stat-label">مقفل</div>
            </div>
        </div>
    </div>

    <!-- Search & Filter Bar -->
    <div class="search-filter-bar p-3 rounded-4 mb-4">
        <div class="row g-2 align-items-end">
            <div class="col-12 col-md-4">
                <input type="text" class="form-control rounded-3" placeholder="🔍 بحث بالعنوان أو اسم البائع..."
                       @bind="searchQuery" @bind:event="oninput" @onkeyup="OnSearchChanged" />
            </div>
            <div class="col-6 col-md-2">
                <select class="form-select rounded-3" @bind="filterStatus" @bind:after="ApplyFilter">
                    <option value="">كل الحالات</option>
                    <option value="Available">نشط</option>
                    <option value="Sold">تم البيع</option>
                    <option value="Expired">منتهي</option>
                    <option value="Locked">مقفل</option>
                    <option value="Cancelled">ملغي</option>
                </select>
            </div>
            <div class="col-6 col-md-2">
                <select class="form-select rounded-3" @bind="filterCondition" @bind:after="ApplyFilter">
                    <option value="">كل الحالات</option>
                    <option value="New">جديد</option>
                    <option value="Used">مستعمل</option>
                </select>
            </div>
            <div class="col-6 col-md-2">
                <select class="form-select rounded-3" @bind="filterFeatured" @bind:after="ApplyFilter">
                    <option value="">كل الإعلانات</option>
                    <option value="featured">مميزة فقط</option>
                    <option value="not_featured">غير مميزة</option>
                </select>
            </div>
            <div class="col-6 col-md-2 text-end">
                <button class="btn btn-outline-secondary rounded-3 w-100" @onclick="ResetFilters">
                    <i class="fa-solid fa-filter-circle-xmark me-1"></i> مسح
                </button>
            </div>
        </div>
    </div>

    <!-- Loading -->
    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-3 text-muted">جاري تحميل الإعلانات...</p>
        </div>
    }
    else if (!displayedItems.Any())
    {
        <div class="empty-box text-center py-5">
            <i class="fa-solid fa-box-open fa-3x text-muted opacity-25 mb-3 d-block"></i>
            <h5 class="text-muted">لا توجد إعلانات في هذا القسم</h5>
            <p class="text-muted small">@(searchQuery.Length > 0 ? "جرب تغيير كلمات البحث" : "لا توجد إعلانات بعد")</p>
        </div>
    }
    else
    {
        <!-- Items Table -->
        <div class="admin-table-card rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" style="min-width: 950px;">
                    <thead>
                        <tr>
                            <th class="ps-3">الإعلان</th>
                            <th>البائع</th>
                            <th>السعر</th>
                            <th>الحالة</th>
                            <th>المدة</th>
                            <th>المشاهدات</th>
                            <th class="text-center pe-3">إجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in displayedItems)
                        {
                            <tr class="@(item.ItemStatus == "Locked" ? "table-warning-row" : "")">
                                <!-- Item Info -->
                                <td class="ps-3" style="min-width:220px;">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="item-thumb">
                                            <img src="@Khadamat.BlazorUI.Helpers.ImagePathResolver.MarketplaceItem(item.Images.FirstOrDefault()?.ImageUrl)"
                                                 alt="@item.Title" />
                                            @if (item.ItemStatus == "Sold")
                                            {
                                                <div class="thumb-overlay"><i class="fa-solid fa-handshake"></i></div>
                                            }
                                            else if (item.ItemStatus == "Locked")
                                            {
                                                <div class="thumb-overlay thumb-locked"><i class="fa-solid fa-lock"></i></div>
                                            }
                                        </div>
                                        <div>
                                            <div class="fw-bold small text-truncate" style="max-width:160px;" title="@item.Title">@item.Title</div>
                                            <div class="text-muted x-small">@item.CategoryName</div>
                                            <div class="d-flex gap-1 mt-1 flex-wrap">
                                                @if (item.IsFeatured)
                                                {
                                                    <span class="badge bg-warning text-dark" style="font-size:0.6rem;">⭐ مميز</span>
                                                }
                                                @if (item.IsPromoted)
                                                {
                                                    <span class="badge bg-info text-dark" style="font-size:0.6rem;">📣 مروّج</span>
                                                }
                                                <span class="badge @(item.Condition == "New" ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary")" style="font-size:0.6rem;">
                                                    @(item.Condition == "New" ? "جديد" : "مستعمل")
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <!-- Seller -->
                                <td style="min-width:140px;">
                                    <div class="fw-bold small">@item.SellerName</div>
                                    @if (!string.IsNullOrEmpty(item.CityName))
                                    {
                                        <div class="text-muted x-small"><i class="fa-solid fa-location-dot me-1"></i>@item.CityName</div>
                                    }
                                    <div class="text-muted x-small">
                                        <i class="fa-regular fa-calendar me-1"></i>@item.CreatedAt.ToString("dd/MM/yy")
                                    </div>
                                </td>

                                <!-- Price -->
                                <td>
                                    <span class="price-badge">@item.Price.ToString("N0")</span>
                                    <div class="text-muted x-small">@item.Currency</div>
                                </td>

                                <!-- Status -->
                                <td>
                                    <span class="status-pill @GetAdminStatusClass(item)">
                                        <i class="@GetAdminStatusIcon(item) me-1"></i>@GetAdminStatusLabel(item)
                                    </span>
                                    @if (!item.Approved)
                                    {
                                        <div class="x-small text-warning mt-1">
                                            <i class="fa-solid fa-clock me-1"></i>بانتظار الموافقة
                                        </div>
                                    }
                                    else if (item.ListedAt.HasValue)
                                    {
                                        <div class="x-small text-success mt-1">
                                            <i class="fa-solid fa-circle-check me-1"></i>عُرض @item.ListedAt.Value.ToString("dd/MM/yy")
                                        </div>
                                    }
                                </td>

                                <!-- Duration -->
                                <td style="min-width:130px;">
                                    @if (item.StartDate.HasValue && item.EndDate.HasValue)
                                    {
                                        var daysLeft = item.DaysRemaining ?? 0;
                                        var totalDays = Math.Max(1,(item.EndDate.Value - item.StartDate.Value).TotalDays);
                                        var passed = (DateTime.UtcNow - item.StartDate.Value).TotalDays;
                                        var pct = (int)Math.Min(100, Math.Max(0, (passed / totalDays) * 100));
                                        <div class="x-small text-muted mb-1">
                                            @item.StartDate.Value.ToString("dd/MM/yy") ← @item.EndDate.Value.ToString("dd/MM/yy")
                                        </div>
                                        <div class="progress" style="height:5px;border-radius:5px;">
                                            <div class="progress-bar @(pct>80?"bg-danger":pct>55?"bg-warning":"bg-success")"
                                                 style="width:@pct%"></div>
                                        </div>
                                        <div class="x-small @(daysLeft<=5?"text-danger fw-bold":"text-muted") mt-1">
                                            @(daysLeft==0 ? "ينتهي اليوم!" : $"{daysLeft} يوم متبقي")
                                        </div>
                                    }
                                    else if (item.EndDate.HasValue)
                                    {
                                        <div class="x-small text-muted">حتى @item.EndDate.Value.ToString("dd/MM/yy")</div>
                                    }
                                    else
                                    {
                                        <span class="text-muted x-small">—</span>
                                    }
                                </td>

                                <!-- Views -->
                                <td>
                                    <div class="d-flex align-items-center gap-1 text-muted small">
                                        <i class="fa-solid fa-eye"></i>
                                        <span>@item.ViewsCount</span>
                                    </div>
                                    @if (item.SoldDate.HasValue)
                                    {
                                        <div class="x-small text-secondary mt-1">
                                            <i class="fa-solid fa-handshake me-1"></i>@item.SoldDate.Value.ToString("dd/MM/yy")
                                        </div>
                                    }
                                </td>

                                <!-- Actions -->
                                <td class="pe-3 text-center" style="min-width:170px;">
                                    <div class="d-flex gap-1 flex-wrap justify-content-center">
                                        <!-- View -->
                                        @{ var itemUrl = $"/marketplace/item/{item.Id}"; }
                                        <button class="btn btn-xs btn-outline-primary rounded-3"
                                                @onclick="() => Navigation.NavigateTo(itemUrl)"
                                                title="عرض">
                                            <i class="fa-solid fa-eye"></i>
                                        </button>

                                        <!-- Approve (if not approved yet) -->
                                        @if (!item.Approved)
                                        {
                                            <button class="btn btn-xs btn-success rounded-3"
                                                    @onclick="() => OpenApproveModal(item)"
                                                    title="موافقة">
                                                <i class="fa-solid fa-check"></i>
                                            </button>
                                            <button class="btn btn-xs btn-danger rounded-3"
                                                    @onclick="() => OpenRejectModal(item)"
                                                    title="رفض">
                                                <i class="fa-solid fa-xmark"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <!-- Change Status -->
                                            <button class="btn btn-xs btn-outline-secondary rounded-3"
                                                    @onclick="() => OpenStatusModal(item)"
                                                    title="تغيير الحالة">
                                                <i class="fa-solid fa-sliders"></i>
                                            </button>

                                            <!-- Feature toggle -->
                                            @if (!item.IsFeatured)
                                            {
                                                <button class="btn btn-xs btn-outline-warning rounded-3"
                                                        @onclick="() => OpenFeaturedModal(item)"
                                                        title="تمييز">
                                                    <i class="fa-solid fa-star"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-xs btn-warning rounded-3"
                                                        title="مميز بالفعل">
                                                    <i class="fa-solid fa-star"></i>
                                                </button>
                                            }

                                            <!-- Lock/Unlock -->
                                            @if (item.ItemStatus == "Locked")
                                            {
                                                <button class="btn btn-xs btn-outline-success rounded-3"
                                                        @onclick='() => AdminChangeStatus(item, "Available")'
                                                        title="إلغاء القفل">
                                                    <i class="fa-solid fa-lock-open"></i>
                                                </button>
                                            }
                                            else if (item.ItemStatus == "Available")
                                            {
                                                <button class="btn btn-xs btn-outline-danger rounded-3"
                                                        @onclick='() => AdminChangeStatus(item, "Locked")'
                                                        title="إيقاف/قفل">
                                                    <i class="fa-solid fa-lock"></i>
                                                </button>
                                            }

                                            <!-- Edit Dates -->
                                            <button class="btn btn-xs btn-outline-info rounded-3"
                                                    @onclick="() => OpenEditDatesModal(item)"
                                                    title="تعديل المدة">
                                                <i class="fa-solid fa-calendar-pen"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="text-muted small mt-2 text-end">
            عرض @displayedItems.Count من @allItems.Count إعلان
        </div>
    }
</div>

<!-- ============ MODALS ============ -->

<!-- Approve Modal -->
@if (showApproveModal && selectedItem != null)
{
    <div class="modal-overlay" @onclick="CloseModals">
        <div class="modal-box" @onclick:stopPropagation>
            <div class="modal-box-header">
                <div class="d-flex align-items-center gap-2">
                    <div class="modal-icon-wrap bg-success-subtle">
                        <i class="fa-solid fa-check text-success"></i>
                    </div>
                    <h5 class="fw-bold mb-0">الموافقة على الإعلان</h5>
                </div>
                <button class="btn btn-sm btn-light rounded-circle" @onclick="CloseModals">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div class="modal-box-body">
                <div class="item-preview-card mb-4">
                    <div class="d-flex gap-3 align-items-center">
                        <img src="@Khadamat.BlazorUI.Helpers.ImagePathResolver.MarketplaceItem(selectedItem.Images.FirstOrDefault()?.ImageUrl)"
                             class="rounded-3" width="60" height="60" style="object-fit:cover;" />
                        <div>
                            <div class="fw-bold">@selectedItem.Title</div>
                            <div class="text-muted small">@selectedItem.SellerName · @selectedItem.Price.ToString("N0") @selectedItem.Currency</div>
                        </div>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-12 col-sm-6">
                        <label class="form-label fw-bold small">تاريخ بداية العرض</label>
                        <input type="date" class="form-control rounded-3"
                               @bind="approveStartDate" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-12 col-sm-6">
                        <label class="form-label fw-bold small">تاريخ انتهاء العرض</label>
                        <input type="date" class="form-control rounded-3"
                               @bind="approveEndDate" min="@approveStartDate.ToString("yyyy-MM-dd")" />
                        <div class="text-muted x-small mt-1">
                            المدة الافتراضية: @defaultListingDays يوM
                            <a href="#" @onclick="SetDefaultDates" @onclick:preventDefault class="ms-1">تعيين</a>
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-bold small">ملاحظات (اختياري)</label>
                        <textarea class="form-control rounded-3" rows="2" placeholder="ملاحظات للسجل..." @bind="approveNotes"></textarea>
                    </div>
                </div>

                <div class="duration-preview mt-3 p-2 rounded-3" style="background:#f0fdf4;border:1px solid #bbf7d0;">
                    <i class="fa-solid fa-calendar-check text-success me-2"></i>
                    مدة العرض: <strong>@((approveEndDate - approveStartDate).Days) يوم</strong>
                    من <strong>@approveStartDate.ToString("dd/MM/yyyy")</strong>
                    إلى <strong>@approveEndDate.ToString("dd/MM/yyyy")</strong>
                </div>
            </div>
            <div class="modal-box-footer">
                <button class="btn btn-light rounded-pill px-4" @onclick="CloseModals">إلغاء</button>
                <button class="btn btn-success rounded-pill px-4" @onclick="ConfirmApprove" disabled="@isActionLoading">
                    @if (isActionLoading) { <span class="spinner-border spinner-border-sm me-1"></span> }
                    <i class="fa-solid fa-check me-1"></i> موافقة ونشر
                </button>
            </div>
        </div>
    </div>
}

<!-- Reject Modal -->
@if (showRejectModal && selectedItem != null)
{
    <div class="modal-overlay" @onclick="CloseModals">
        <div class="modal-box" @onclick:stopPropagation>
            <div class="modal-box-header">
                <div class="d-flex align-items-center gap-2">
                    <div class="modal-icon-wrap bg-danger-subtle">
                        <i class="fa-solid fa-ban text-danger"></i>
                    </div>
                    <h5 class="fw-bold mb-0">رفض الإعلان</h5>
                </div>
                <button class="btn btn-sm btn-light rounded-circle" @onclick="CloseModals">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div class="modal-box-body">
                <div class="item-preview-card mb-4">
                    <div class="d-flex gap-3 align-items-center">
                        <img src="@Khadamat.BlazorUI.Helpers.ImagePathResolver.MarketplaceItem(selectedItem.Images.FirstOrDefault()?.ImageUrl)"
                             class="rounded-3" width="60" height="60" style="object-fit:cover;" />
                        <div>
                            <div class="fw-bold">@selectedItem.Title</div>
                            <div class="text-muted small">@selectedItem.SellerName</div>
                        </div>
                    </div>
                </div>
                <label class="form-label fw-bold small">سبب الرفض <span class="text-muted">(اختياري)</span></label>
                <textarea class="form-control rounded-3" rows="3"
                          placeholder="مثلاً: الإعلان ينتهك سياسة المنصة، لقطات غير واضحة..."
                          @bind="rejectNotes"></textarea>
            </div>
            <div class="modal-box-footer">
                <button class="btn btn-light rounded-pill px-4" @onclick="CloseModals">إلغاء</button>
                <button class="btn btn-danger rounded-pill px-4" @onclick="ConfirmReject" disabled="@isActionLoading">
                    @if (isActionLoading) { <span class="spinner-border spinner-border-sm me-1"></span> }
                    <i class="fa-solid fa-ban me-1"></i> رفض الإعلان
                </button>
            </div>
        </div>
    </div>
}

<!-- Status Change Modal -->
@if (showStatusModal && selectedItem != null)
{
    <div class="modal-overlay" @onclick="CloseModals">
        <div class="modal-box" @onclick:stopPropagation>
            <div class="modal-box-header">
                <div class="d-flex align-items-center gap-2">
                    <div class="modal-icon-wrap bg-primary-subtle">
                        <i class="fa-solid fa-sliders text-primary"></i>
                    </div>
                    <h5 class="fw-bold mb-0">تغيير حالة الإعلان</h5>
                </div>
                <button class="btn btn-sm btn-light rounded-circle" @onclick="CloseModals">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div class="modal-box-body">
                <div class="item-preview-card mb-4">
                    <div class="fw-bold">@selectedItem.Title</div>
                    <div class="text-muted small">الحالة الحالية:
                        <span class="badge @GetAdminStatusClass(selectedItem) ms-1">@GetAdminStatusLabel(selectedItem)</span>
                    </div>
                </div>

                <label class="form-label fw-bold small">الحالة الجديدة</label>
                <div class="status-options-grid">
                    @foreach (var s in new[] {
                        ("Available", "نشط", "fa-solid fa-circle-check", "success"),
                        ("Sold", "تم البيع", "fa-solid fa-handshake", "secondary"),
                        ("Expired", "منتهي", "fa-solid fa-clock-rotate-left", "danger"),
                        ("Locked", "مقفل", "fa-solid fa-lock", "warning"),
                        ("Cancelled", "ملغي", "fa-solid fa-ban", "dark")
                    })
                    {
                        <div class="status-option @(newStatus == s.Item1 ? $"selected border-{s.Item4}" : "")"
                             @onclick="() => newStatus = s.Item1">
                            <i class="@s.Item3 text-@s.Item4 me-2"></i>
                            <span class="fw-bold">@s.Item2</span>
                        </div>
                    }
                </div>
            </div>
            <div class="modal-box-footer">
                <button class="btn btn-light rounded-pill px-4" @onclick="CloseModals">إلغاء</button>
                <button class="btn btn-primary rounded-pill px-4" @onclick="ConfirmStatusChange" disabled="@(isActionLoading || string.IsNullOrEmpty(newStatus))">
                    @if (isActionLoading) { <span class="spinner-border spinner-border-sm me-1"></span> }
                    <i class="fa-solid fa-check me-1"></i> تطبيق الحالة
                </button>
            </div>
        </div>
    </div>
}

<!-- Edit Dates Modal -->
@if (showEditDatesModal && selectedItem != null)
{
    <div class="modal-overlay" @onclick="CloseModals">
        <div class="modal-box" @onclick:stopPropagation>
            <div class="modal-box-header">
                <div class="d-flex align-items-center gap-2">
                    <div class="modal-icon-wrap bg-info-subtle">
                        <i class="fa-solid fa-calendar-pen text-info"></i>
                    </div>
                    <h5 class="fw-bold mb-0">تعديل مدة الإعلان</h5>
                </div>
                <button class="btn btn-sm btn-light rounded-circle" @onclick="CloseModals">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div class="modal-box-body">
                <div class="item-preview-card mb-4">
                    <div class="fw-bold">@selectedItem.Title</div>
                    @if (selectedItem.EndDate.HasValue)
                    {
                        <div class="text-muted small">
                            الفترة الحالية: @selectedItem.StartDate?.ToString("dd/MM/yyyy") — @selectedItem.EndDate.Value.ToString("dd/MM/yyyy")
                        </div>
                    }
                </div>
                <div class="row g-3">
                    <div class="col-12 col-sm-6">
                        <label class="form-label fw-bold small">تاريخ البداية</label>
                        <input type="date" class="form-control rounded-3" @bind="approveStartDate" />
                    </div>
                    <div class="col-12 col-sm-6">
                        <label class="form-label fw-bold small">تاريخ الانتهاء</label>
                        <input type="date" class="form-control rounded-3"
                               @bind="approveEndDate"
                               min="@approveStartDate.ToString("yyyy-MM-dd")" />
                    </div>
                </div>
                <div class="duration-preview mt-3 p-2 rounded-3" style="background:#eff6ff;border:1px solid #bfdbfe;">
                    <i class="fa-solid fa-calendar-days text-primary me-2"></i>
                    المدة الجديدة: <strong>@((approveEndDate - approveStartDate).Days) يوم</strong>
                </div>
                <div class="alert alert-warning small mt-3 rounded-3">
                    <i class="fa-solid fa-triangle-exclamation me-1"></i>
                    تعديل التاريخ سيؤثر على ظهور الإعلان تلقائياً. إذا انتهى التاريخ الجديد في الماضي، سيُعامل الإعلان كمنتهٍ.
                </div>
            </div>
            <div class="modal-box-footer">
                <button class="btn btn-light rounded-pill px-4" @onclick="CloseModals">إلغاء</button>
                <button class="btn btn-info text-white rounded-pill px-4" @onclick="ConfirmEditDates" disabled="@isActionLoading">
                    @if (isActionLoading) { <span class="spinner-border spinner-border-sm me-1"></span> }
                    <i class="fa-solid fa-save me-1"></i> حفظ التغييرات
                </button>
            </div>
        </div>
    </div>
}

<!-- Featured Modal -->
@if (showFeaturedModal && selectedItem != null)
{
    <div class="modal-overlay" @onclick="CloseModals">
        <div class="modal-box" @onclick:stopPropagation>
            <div class="modal-box-header">
                <div class="d-flex align-items-center gap-2">
                    <div class="modal-icon-wrap" style="background:#fef3c7;">
                        <i class="fa-solid fa-star text-warning"></i>
                    </div>
                    <h5 class="fw-bold mb-0">تمييز الإعلان</h5>
                </div>
                <button class="btn btn-sm btn-light rounded-circle" @onclick="CloseModals">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div class="modal-box-body">
                <div class="item-preview-card mb-4">
                    <div class="fw-bold">@selectedItem.Title</div>
                    <div class="text-muted small">@selectedItem.SellerName</div>
                </div>
                <label class="form-label fw-bold small">مدة التمييز</label>
                <div class="days-picker d-flex gap-2 flex-wrap">
                    @foreach (var d in new[] { 7, 14, 30, 60, 90 })
                    {
                        <button class="btn @(featuredDays == d ? "btn-warning text-dark" : "btn-outline-secondary") rounded-pill px-3"
                                @onclick="() => featuredDays = d">
                            @d يوم
                        </button>
                    }
                </div>
                <div class="duration-preview mt-3 p-2 rounded-3" style="background:#fffbeb;border:1px solid #fde68a;">
                    <i class="fa-solid fa-star text-warning me-2"></i>
                    سيُميَّز الإعلان حتى <strong>@DateTime.Today.AddDays(featuredDays).ToString("dd/MM/yyyy")</strong>
                </div>
            </div>
            <div class="modal-box-footer">
                <button class="btn btn-light rounded-pill px-4" @onclick="CloseModals">إلغاء</button>
                <button class="btn btn-warning text-dark rounded-pill px-4" @onclick="ConfirmFeatured" disabled="@isActionLoading">
                    @if (isActionLoading) { <span class="spinner-border spinner-border-sm me-1"></span> }
                    <i class="fa-solid fa-star me-1"></i> تمييز الإعلان
                </button>
            </div>
        </div>
    </div>
}

<!-- Toast -->
@if (showToast)
{
    <div class="admin-toast @(toastSuccess ? "toast-ok" : "toast-err")">
        <i class="fa-solid @(toastSuccess ? "fa-check-circle" : "fa-circle-exclamation") me-2"></i>@toastMsg
    </div>
}

