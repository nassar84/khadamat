@page "/admin/marketplace"
@using Khadamat.Application.DTOs
@using Khadamat.BlazorUI.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "SystemAdmin,SuperAdmin")]
@inject ApiClient Api
@inject NavigationManager Navigation

<div class="marketplace-admin-page px-3 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-0">
                <i class="fa-solid fa-store me-2 text-primary"></i> إدارة السوق
            </h3>
            <p class="text-muted small mb-0">مراجعة وإدارة إعلانات البيع والشراء</p>
        </div>
        <div class="d-flex gap-2">
            <span class="badge bg-danger-soft text-danger rounded-pill px-3 py-2">
                <i class="fa-solid fa-clock me-1"></i> @pendingItems.Count بانتظار الموافقة
            </span>
        </div>
    </div>

    <!-- Filter Tabs -->
    <div class="filter-tabs mb-4 d-flex gap-2 flex-wrap">
        <button class="btn @(activeTab == "pending" ? "btn-primary" : "btn-outline-secondary") rounded-pill px-4"
                @onclick='() => SetTab("pending")'>
            <i class="fa-solid fa-clock me-1"></i> بانتظار الموافقة
            @if (pendingItems.Any())
            {
                <span class="badge bg-danger ms-1">@pendingItems.Count</span>
            }
        </button>
        <button class="btn @(activeTab == "approved" ? "btn-primary" : "btn-outline-secondary") rounded-pill px-4"
                @onclick='() => SetTab("approved")'>
            <i class="fa-solid fa-check me-1"></i> مقبولة
        </button>
        <button class="btn @(activeTab == "featured" ? "btn-primary" : "btn-outline-secondary") rounded-pill px-4"
                @onclick='() => SetTab("featured")'>
            <i class="fa-solid fa-star me-1"></i> مميزة
        </button>
        <button class="btn @(activeTab == "all" ? "btn-primary" : "btn-outline-secondary") rounded-pill px-4"
                @onclick='() => SetTab("all")'>
            <i class="fa-solid fa-list me-1"></i> جميع الإعلانات
        </button>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">جاري تحميل البيانات...</p>
        </div>
    }
    else if (!displayedItems.Any())
    {
        <div class="empty-state text-center py-5">
            <div class="empty-icon mb-3">
                <i class="fa-solid fa-box-open fa-3x text-muted opacity-25"></i>
            </div>
            <h5 class="text-muted">لا توجد إعلانات في هذا القسم</h5>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var item in displayedItems)
            {
                <div class="col-12 col-md-6 col-xl-4">
                    <div class="item-admin-card card border-0 shadow-sm rounded-4 overflow-hidden">
                        <!-- Image & Status Bar -->
                        <div class="card-img-top position-relative" style="height: 180px; background: #f8f9fa;">
                            <img src="@(item.Images.FirstOrDefault()?.ImageUrl ?? "/images/defaults/default-product.png")"
                                 alt="@item.Title"
                                 class="w-100 h-100"
                                 style="object-fit: cover;" />
                            <div class="position-absolute top-0 start-0 p-2 d-flex gap-1">
                                @if (item.IsFeatured)
                                {
                                    <span class="badge bg-warning text-dark"><i class="fa-solid fa-star me-1"></i>مميز</span>
                                }
                                @if (item.IsPromoted)
                                {
                                    <span class="badge bg-info text-dark"><i class="fa-solid fa-bullhorn me-1"></i>مروّج</span>
                                }
                            </div>
                            <div class="position-absolute top-0 end-0 p-2">
                                <span class="badge @(item.Condition == "New" ? "bg-success" : "bg-secondary")">
                                    @(item.Condition == "New" ? "جديد" : "مستعمل")
                                </span>
                            </div>
                        </div>

                        <div class="card-body p-3">
                            <h6 class="fw-bold text-truncate mb-1">@item.Title</h6>
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-primary fw-bold">@item.Price.ToString("N0") @item.Currency</span>
                                <span class="text-muted small">
                                    <i class="fa-solid fa-eye me-1"></i>@item.ViewsCount
                                </span>
                            </div>
                            <div class="text-muted small mb-3">
                                <i class="fa-solid fa-layer-group me-1"></i>@item.CategoryName
                                @if (!string.IsNullOrEmpty(item.CityName))
                                {
                                    <span class="ms-2"><i class="fa-solid fa-location-dot me-1"></i>@item.CityName</span>
                                }
                            </div>
                            <div class="text-muted x-small mb-3">
                                <i class="fa-regular fa-calendar me-1"></i> @item.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                            </div>

                            <!-- Action Buttons -->
                            <div class="d-flex flex-wrap gap-2">
                                <button class="btn btn-sm btn-outline-primary rounded-3 flex-grow-1"
                                        @onclick="() => ViewItem(item.Id)">
                                    <i class="fa-solid fa-eye me-1"></i>عرض
                                </button>

                                @if (activeTab == "pending")
                                {
                                    <button class="btn btn-sm btn-success rounded-3 flex-grow-1"
                                            @onclick="() => ApproveItem(item)">
                                        <i class="fa-solid fa-check me-1"></i>قبول
                                    </button>
                                    <button class="btn btn-sm btn-danger rounded-3 flex-grow-1"
                                            @onclick="() => OpenRejectModal(item)">
                                        <i class="fa-solid fa-xmark me-1"></i>رفض
                                    </button>
                                }
                                else
                                {
                                    @if (!item.IsFeatured)
                                    {
                                        <button class="btn btn-sm btn-warning rounded-3"
                                                @onclick="() => SetFeatured(item)">
                                            <i class="fa-solid fa-star"></i>
                                        </button>
                                    }
                                    <button class="btn btn-sm btn-outline-danger rounded-3"
                                            @onclick="() => OpenRejectModal(item)">
                                        <i class="fa-solid fa-ban"></i>
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Reject Modal -->
@if (showRejectModal && selectedItem != null)
{
    <div class="modal-overlay" @onclick="CloseModal">
        <div class="modal-dialog-custom" @onclick:stopPropagation>
            <div class="modal-header-custom">
                <h5 class="fw-bold mb-0">
                    <i class="fa-solid fa-ban me-2 text-danger"></i>
                    رفض الإعلان
                </h5>
                <button class="btn btn-sm btn-light rounded-circle" @onclick="CloseModal">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div class="modal-body-custom">
                <p class="text-muted mb-3">الإعلان: <strong>@selectedItem.Title</strong></p>
                <label class="form-label fw-bold">سبب الرفض (اختياري)</label>
                <textarea class="form-control rounded-3" rows="3"
                          placeholder="مثلاً: المنتج ينتهك سياسة المنصة..."
                          @bind="rejectNotes"></textarea>
            </div>
            <div class="modal-footer-custom d-flex gap-2 justify-content-end">
                <button class="btn btn-light rounded-pill px-4" @onclick="CloseModal">إلغاء</button>
                <button class="btn btn-danger rounded-pill px-4" @onclick="ConfirmReject" disabled="@isActionLoading">
                    @if (isActionLoading) { <span class="spinner-border spinner-border-sm me-1"></span> }
                    تأكيد الرفض
                </button>
            </div>
        </div>
    </div>
}

<!-- Set Featured Modal -->
@if (showFeaturedModal && selectedItem != null)
{
    <div class="modal-overlay" @onclick="CloseModal">
        <div class="modal-dialog-custom" @onclick:stopPropagation>
            <div class="modal-header-custom">
                <h5 class="fw-bold mb-0">
                    <i class="fa-solid fa-star me-2 text-warning"></i>
                    تمييز الإعلان
                </h5>
                <button class="btn btn-sm btn-light rounded-circle" @onclick="CloseModal">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div class="modal-body-custom">
                <p class="text-muted mb-3">الإعلان: <strong>@selectedItem.Title</strong></p>
                <label class="form-label fw-bold">مدة التمييز</label>
                <select class="form-select rounded-3" @bind="featuredDays">
                    <option value="7">7 أيام</option>
                    <option value="14">14 يوم</option>
                    <option value="30">30 يوم</option>
                    <option value="90">90 يوم</option>
                </select>
            </div>
            <div class="modal-footer-custom d-flex gap-2 justify-content-end">
                <button class="btn btn-light rounded-pill px-4" @onclick="CloseModal">إلغاء</button>
                <button class="btn btn-warning text-dark rounded-pill px-4" @onclick="ConfirmSetFeatured" disabled="@isActionLoading">
                    @if (isActionLoading) { <span class="spinner-border spinner-border-sm me-1"></span> }
                    تأكيد التمييز
                </button>
            </div>
        </div>
    </div>
}

@if (showSuccessToast)
{
    <div class="toast-success-custom">
        <i class="fa-solid fa-check-circle me-2"></i> @toastMessage
    </div>
}

<style>
    .marketplace-admin-page {
        min-height: 100vh;
        background: #f8fafc;
    }

    .badge.bg-danger-soft {
        background: rgba(239, 68, 68, 0.1) !important;
    }

    .filter-tabs .btn {
        font-size: 0.85rem;
        transition: all 0.2s;
    }

    .item-admin-card {
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .item-admin-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 30px rgba(0,0,0,0.08) !important;
    }

    .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.5);
        backdrop-filter: blur(4px);
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
        animation: fadeIn 0.2s ease;
    }

    .modal-dialog-custom {
        background: white;
        border-radius: 20px;
        width: 100%;
        max-width: 480px;
        margin: 1rem;
        overflow: hidden;
        animation: slideUp 0.25s ease;
    }

    .modal-header-custom {
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid #f1f5f9;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .modal-body-custom {
        padding: 1.5rem;
    }

    .modal-footer-custom {
        padding: 1rem 1.5rem;
        border-top: 1px solid #f1f5f9;
    }

    .empty-state {
        background: white;
        border-radius: 20px;
        padding: 3rem;
    }

    .toast-success-custom {
        position: fixed;
        bottom: 2rem;
        left: 50%;
        transform: translateX(-50%);
        background: #10b981;
        color: white;
        padding: 0.75rem 1.5rem;
        border-radius: 50px;
        font-weight: 600;
        z-index: 99999;
        box-shadow: 0 10px 30px rgba(16,185,129,0.3);
        animation: slideUpFade 0.3s ease, fadeOut 0.5s 2.5s ease forwards;
    }

    @@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    @@keyframes slideUp { from { transform: translateY(30px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
    @@keyframes slideUpFade { from { transform: translateX(-50%) translateY(20px); opacity: 0; } to { transform: translateX(-50%) translateY(0); opacity: 1; } }
    @@keyframes fadeOut { from { opacity: 1; } to { opacity: 0; } }

    .x-small { font-size: 0.75rem; }
</style>

@code {
    private List<MarketplaceItemDto> allItems = new();
    private List<MarketplaceItemDto> pendingItems = new();
    private List<MarketplaceItemDto> displayedItems = new();

    private string activeTab = "pending";
    private bool isLoading = true;
    private bool isActionLoading = false;

    private bool showRejectModal = false;
    private bool showFeaturedModal = false;
    private MarketplaceItemDto? selectedItem;
    private string rejectNotes = "";
    private int featuredDays = 7;

    private bool showSuccessToast = false;
    private string toastMessage = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;

        // Load pending (unapproved) items
        // We use a broad search but filter locally since API might not filter by approved=false
        var pending = await Api.SearchMarketplaceItemsAsync(pageSize: 100);
        // For now we load all and add pending simulator
        allItems = await Api.SearchMarketplaceItemsAsync(pageSize: 50);
        pendingItems = new List<MarketplaceItemDto>(); // Real pending comes from admin API

        // Load via admin search if available (no sellerId = all items, approved items only for now)
        // In a full implementation, we'd have a dedicated admin endpoint
        allItems = await Api.GetLatestMarketplaceItemsAsync(50);
        pendingItems = allItems.Where(i => !i.IsFeatured).Take(5).ToList(); // Simulated

        SetTab(activeTab);
        isLoading = false;
    }

    private void SetTab(string tab)
    {
        activeTab = tab;
        displayedItems = tab switch
        {
            "pending" => pendingItems,
            "approved" => allItems.Where(i => !i.IsFeatured && !i.IsPromoted).ToList(),
            "featured" => allItems.Where(i => i.IsFeatured || i.IsPromoted).ToList(),
            _ => allItems
        };
    }

    private void ViewItem(int id)
    {
        Navigation.NavigateTo($"/marketplace/item/{id}", true);
    }

    private async Task ApproveItem(MarketplaceItemDto item)
    {
        isActionLoading = true;
        var success = await Api.ApproveMarketplaceItemAsync(item.Id);
        if (success)
        {
            pendingItems.Remove(item);
            ShowToast("تم قبول الإعلان بنجاح ✓");
            SetTab(activeTab);
        }
        isActionLoading = false;
    }

    private void OpenRejectModal(MarketplaceItemDto item)
    {
        selectedItem = item;
        rejectNotes = "";
        showRejectModal = true;
    }

    private async Task ConfirmReject()
    {
        if (selectedItem == null) return;
        isActionLoading = true;
        var success = await Api.RejectMarketplaceItemAsync(selectedItem.Id, rejectNotes);
        if (success)
        {
            allItems.Remove(selectedItem);
            pendingItems.Remove(selectedItem);
            ShowToast("تم رفض الإعلان");
            SetTab(activeTab);
        }
        isActionLoading = false;
        CloseModal();
    }

    private void SetFeatured(MarketplaceItemDto item)
    {
        selectedItem = item;
        featuredDays = 7;
        showFeaturedModal = true;
    }

    private async Task ConfirmSetFeatured()
    {
        if (selectedItem == null) return;
        isActionLoading = true;
        var success = await Api.SetMarketplaceItemFeaturedAsync(selectedItem.Id, featuredDays);
        if (success)
        {
            ShowToast($"تم تمييز الإعلان لمدة {featuredDays} أيام ✓");
            await LoadData();
        }
        isActionLoading = false;
        CloseModal();
    }

    private void CloseModal()
    {
        showRejectModal = false;
        showFeaturedModal = false;
        selectedItem = null;
        rejectNotes = "";
    }

    private async void ShowToast(string message)
    {
        toastMessage = message;
        showSuccessToast = true;
        StateHasChanged();
        await Task.Delay(3000);
        showSuccessToast = false;
        StateHasChanged();
    }
}
