@page "/admin/services"
@using Khadamat.Application.DTOs
@using Khadamat.Application.Common.Models
@using Khadamat.BlazorUI.Services
@using Khadamat.BlazorUI.Services.Admin
@using Khadamat.BlazorUI.Components.Common
@using Khadamat.BlazorUI.Shared.Components
@using Khadamat.BlazorUI.Helpers
@using Khadamat.Application.Features.Services.Commands
@inject ApiClient Api
@inject IAdminService AdminService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>إدارة الخدمات</PageTitle>

<div class="px-2 pb-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-0">إدارة الخدمات</h4>
            <p class="text-muted small mb-0">تصفح الخدمات حسب الفئات — التحميل عند الحاجة</p>
        </div>
        <button class="btn btn-primary-premium rounded-pill px-4" @onclick="NavigateToCreateService">
            <i class="fa-solid fa-plus me-2"></i>إضافة خدمة
        </button>
    </div>

    <div class="glass-card p-3">
        @if (isLoadingMain)
        {
            <div class="text-center p-5">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="mt-2 text-muted small">جاري تحميل الفئات الرئيسية...</p>
            </div>
        }
        else if (!mainCategories.Any())
        {
            <div class="text-center p-5 text-muted">
                <i class="fa-solid fa-folder-open fs-1 mb-3 opacity-25"></i>
                <p>لا توجد فئات رئيسية</p>
            </div>
        }
        else
        {
            <div class="lazy-tree">
                @foreach (var mc in mainCategories)
                {
                    <!-- ── مستوى 0: الفئة الرئيسية ── -->
                    <div class="tree-node level-0">
                        <div class="tree-row @(expandedMain == mc.Id ? "active-row" : "")"
                             @onclick="() => ToggleMain(mc.Id)">
                            <span class="toggle-icon">
                                @if (loadingNodeId == $"m{mc.Id}")
                                {
                                    <span class="spinner-border spinner-border-sm text-primary" style="width:14px;height:14px;"></span>
                                }
                                else
                                {
                                    <i class="fa-solid @(expandedMain == mc.Id ? "fa-chevron-down" : "fa-chevron-left") text-muted x-small"></i>
                                }
                            </span>
                            <i class="fa-solid fa-layer-group text-primary ms-1"></i>
                            <span class="tree-label fw-bold">@mc.Name</span>
                            @if (categoriesOf.ContainsKey(mc.Id))
                            {
                                <span class="badge bg-light text-dark border rounded-pill ms-2 x-small">
                                    @categoriesOf[mc.Id].Count
                                </span>
                            }
                        </div>

                        <!-- ── مستوى 1: الفئات (Categories) ── -->
                        @if (expandedMain == mc.Id && categoriesOf.TryGetValue(mc.Id, out var cats))
                        {
                            @if (!cats.Any())
                            {
                                <div class="tree-empty ms-4">لا توجد فئات</div>
                            }
                            else
                            {
                                @foreach (var cat in cats)
                                {
                                    <div class="tree-node level-1 ms-3">
                                        <div class="tree-row @(expandedCat == cat.Id ? "active-row" : "")"
                                             @onclick="() => ToggleCat(mc.Id, cat.Id)">
                                            <span class="toggle-icon">
                                                @if (loadingNodeId == $"c{cat.Id}")
                                                {
                                                    <span class="spinner-border spinner-border-sm text-warning" style="width:12px;height:12px;"></span>
                                                }
                                                else
                                                {
                                                    <i class="fa-solid @(expandedCat == cat.Id ? "fa-chevron-down" : "fa-chevron-left") text-muted x-small"></i>
                                                }
                                            </span>
                                            <i class="fa-solid fa-folder text-warning ms-1"></i>
                                            <span class="tree-label">@cat.Name</span>
                                            @if (subsOf.ContainsKey(cat.Id))
                                            {
                                                <span class="badge bg-light text-dark border rounded-pill ms-2 x-small">
                                                    @subsOf[cat.Id].Count
                                                </span>
                                            }
                                        </div>

                                        <!-- ── مستوى 2: الفئات الفرعية (SubCategories) ── -->
                                        @if (expandedCat == cat.Id && subsOf.TryGetValue(cat.Id, out var subs))
                                        {
                                            @if (!subs.Any())
                                            {
                                                <div class="tree-empty ms-4">لا توجد فئات فرعية</div>
                                            }
                                            else
                                            {
                                                @foreach (var sub in subs)
                                                {
                                                    <div class="tree-node level-2 ms-3">
                                                        <div class="tree-row @(expandedSub == sub.Id ? "active-row" : "")"
                                                             @onclick="() => ToggleSub(sub.Id)">
                                                            <span class="toggle-icon">
                                                                @if (loadingNodeId == $"s{sub.Id}")
                                                                {
                                                                    <span class="spinner-border spinner-border-sm text-info" style="width:12px;height:12px;"></span>
                                                                }
                                                                else
                                                                {
                                                                    <i class="fa-solid @(expandedSub == sub.Id ? "fa-chevron-down" : "fa-chevron-left") text-muted x-small"></i>
                                                                }
                                                            </span>
                                                            <i class="fa-solid fa-tag text-info ms-1"></i>
                                                            <span class="tree-label">@sub.Name</span>
                                                            @if (servicesOf.ContainsKey(sub.Id))
                                                            {
                                                                <span class="badge bg-light text-dark border rounded-pill ms-2 x-small">
                                                                    @servicesOf[sub.Id].Count خدمة
                                                                </span>
                                                            }
                                                        </div>

                                                        <!-- ── مستوى 3: الخدمات ── -->
                                                        @if (expandedSub == sub.Id && servicesOf.TryGetValue(sub.Id, out var svcs))
                                                        {
                                                            @if (!svcs.Any())
                                                            {
                                                                <div class="tree-empty ms-4">لا توجد خدمات في هذه الفئة</div>
                                                            }
                                                            else
                                                            {
                                                                @foreach (var svc in svcs)
                                                                {
                                                                    <div class="tree-node level-3 ms-3">
                                                                        <div class="tree-row service-row">
                                                                            <span class="toggle-icon invisible"><i class="fa-solid fa-chevron-left x-small"></i></span>
                                                                            <i class="fa-solid fa-briefcase text-success ms-1"></i>
                                                                            <span class="tree-label flex-grow-1">@svc.Name</span>

                                                                            @if (!svc.IsApproved)
                                                                            {
                                                                                <span class="badge bg-warning text-dark rounded-pill x-small me-2">قيد الانتظار</span>
                                                                            }

                                                                            <!-- أزرار الخدمة -->
                                                                            <div class="svc-actions d-flex gap-1">
                                                                                <button class="btn btn-sm btn-light border text-primary" title="تعديل"
                                                                                        @onclick:stopPropagation="true"
                                                                                        @onclick="() => OpenEditService(svc)">
                                                                                    <i class="fa-solid fa-pen x-small"></i>
                                                                                </button>
                                                                                <button class="btn btn-sm btn-light border text-secondary" title="ربط بمستخدم"
                                                                                        @onclick:stopPropagation="true"
                                                                                        @onclick="() => OpenChangeOwner(svc)">
                                                                                    <i class="fa-solid fa-user-gear x-small"></i>
                                                                                </button>
                                                                                @if (!svc.IsApproved)
                                                                                {
                                                                                    <button class="btn btn-sm btn-light border text-success" title="اعتماد"
                                                                                            @onclick:stopPropagation="true"
                                                                                            @onclick="() => Approve(svc, sub.Id)">
                                                                                        <i class="fa-solid fa-check x-small"></i>
                                                                                    </button>
                                                                                }
                                                                                @if (svc.IsApproved)
                                                                                {
                                                                                    <button class="btn btn-sm btn-light border text-warning" title="إلغاء اعتماد"
                                                                                            @onclick:stopPropagation="true"
                                                                                            @onclick="() => Reject(svc, sub.Id)">
                                                                                        <i class="fa-solid fa-xmark x-small"></i>
                                                                                    </button>
                                                                                }
                                                                                <button class="btn btn-sm btn-light border text-danger" title="حذف"
                                                                                        @onclick:stopPropagation="true"
                                                                                        @onclick="() => DeleteService(svc, sub.Id)">
                                                                                    <i class="fa-solid fa-trash x-small"></i>
                                                                                </button>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                }
                                                            }
                                                        }
                                                    </div>
                                                }
                                            }
                                        }
                                    </div>
                                }
                            }
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- ── مودال تعديل الخدمة ── -->
@if (showEditModal && serviceFormModel != null)
{
    <div class="modal-overlay" @onclick="() => showEditModal = false">
        <div class="glass-card p-4 rounded-4 w-100 mx-3 animate-pop"
             style="max-width:800px;max-height:90vh;overflow-y:auto;"
             @onclick:stopPropagation="true">
            <ServiceForm Model="@serviceFormModel"
                         MainCategories="@mainCategories"
                         Governorates="@governorates"
                         IsSaving="@isSaving"
                         ShowTitle="true"
                         Id="@editServiceId"
                         OnSave="SaveChanges"
                         OnCancel="() => showEditModal = false" />
        </div>
    </div>
}

<!-- ── مودال ربط المستخدم ── -->
@if (showChangeOwnerModal)
{
    <div class="modal-overlay" @onclick="() => showChangeOwnerModal = false">
        <div class="glass-card p-4 rounded-4 w-100 mx-3 animate-pop d-flex flex-column"
             style="max-width:680px; max-height:90vh;"
             @onclick:stopPropagation="true">
            
            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                <div>
                    <h5 class="fw-bold mb-1 d-flex align-items-center gap-2">
                        <i class="fa-solid fa-user-gear text-primary"></i>
                        <span>ربط الخدمة بمستخدم موجود</span>
                    </h5>
                    <div class="text-muted small">
                        الخدمة المستهدفة: <span class="fw-bold text-dark">@serviceToChangeOwner?.Name</span>
                    </div>
                </div>
                <button class="btn-close" @onclick="() => showChangeOwnerModal = false"></button>
            </div>

            <!-- شروط مزود الخدمة التوضيحية -->
            <div class="alert alert-info py-2 px-3 small border-0 rounded-3 mb-3 d-flex align-items-center justify-content-between">
                <div>
                    <i class="fa-solid fa-circle-info me-1"></i>
                    <strong>شروط الربط:</strong> يجب أن يتوفر للمستخدم رقم هاتف للتواصل وموقع (محافظة ومدينة) مسجل.
                </div>
            </div>

            <!-- حقل البحث والفلترة -->
            <div class="row g-2 mb-3">
                <div class="col-12 col-md-7">
                    <div class="position-relative">
                        <i class="fa-solid fa-magnifying-glass position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                        <input type="text" class="form-control rounded-pill ps-5 bg-light border-0" 
                               placeholder="ابحث بالاسم أو البريد أو الهاتف..." 
                               @bind="userSearchTerm" @bind:event="oninput" />
                    </div>
                </div>
                <div class="col-12 col-md-5">
                    <select class="form-select rounded-pill bg-light border-0 px-3" @bind="userFilterEligibility">
                        <option value="all">جميع المستخدمين (@allUsers.Count)</option>
                        <option value="eligible">مستوفون للشروط فقط ✅</option>
                        <option value="ineligible">غير مستوفين للشروط ⚠️</option>
                        <option value="provider">مقدمو خدمات حاليون 💼</option>
                    </select>
                </div>
            </div>

            <!-- قائمة المستخدمين القابلة للتمرير -->
            <div class="users-assign-list flex-grow-1 overflow-auto border rounded-4 p-2 mb-3 bg-light-subtle" style="min-height: 200px; max-height: 280px;">
                @if (isLoadingUsers)
                {
                    <div class="text-center p-4">
                        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                        <div class="small text-muted mt-2">جاري تحميل المستخدمين...</div>
                    </div>
                }
                else if (!FilteredUsersForAssign.Any())
                {
                    <div class="text-center p-4 text-muted small">
                        <i class="fa-solid fa-user-slash fs-2 mb-2 opacity-50"></i>
                        <div>لا يوجد مستخدمون يطابقون معايير البحث</div>
                    </div>
                }
                else
                {
                    @foreach (var user in FilteredUsersForAssign)
                    {
                        var isSelected = selectedUserIdForOwner == user.Id;
                        var isEligible = IsUserEligibleForProvider(user);
                        
                        <div class="user-select-card p-2 px-3 mb-2 rounded-3 border d-flex align-items-center justify-content-between cursor-pointer transition-all @(isSelected ? "border-primary bg-primary-subtle shadow-sm" : "bg-white")"
                             @onclick="() => SelectUserForOwner(user.Id)">
                            <div class="d-flex align-items-center gap-3 flex-grow-1 overflow-hidden">
                                <img src="@DefaultImages.GetUserAvatar(user.FullName, user.Gender, user.ProfileImageUrl)"
                                     class="rounded-circle border"
                                     style="width: 42px; height: 42px; object-fit: cover; flex-shrink: 0;" />
                                <div class="overflow-hidden">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="fw-bold text-truncate small">@user.FullName</div>
                                        @if (isEligible)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill x-small">
                                                مستوفٍ <i class="fa-solid fa-check"></i>
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning-subtle text-dark border border-warning-subtle rounded-pill x-small">
                                                غير مكتمل ⚠️
                                            </span>
                                        }
                                    </div>
                                    <div class="d-flex flex-wrap gap-2 text-muted x-small mt-1">
                                        <span><i class="fa-regular fa-envelope me-1"></i>@user.Email</span>
                                        @if (!string.IsNullOrWhiteSpace(user.PhoneNumber))
                                        {
                                            <span><i class="fa-solid fa-phone me-1"></i>@user.PhoneNumber</span>
                                        }
                                        else
                                        {
                                            <span class="text-danger"><i class="fa-solid fa-phone-slash me-1"></i>بدون هاتف</span>
                                        }
                                        <span><i class="fa-solid fa-location-dot me-1"></i>@GetUserCityName(user.CityId)</span>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="d-flex align-items-center gap-2 flex-shrink-0 ms-2">
                                <button class="btn btn-sm btn-light border rounded-pill px-2 py-1"
                                        title="تعديل بيانات المستخدم"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => OpenEditUser(user)">
                                    <i class="fa-solid fa-pen-to-square text-primary x-small"></i>
                                    <span class="x-small ms-1 d-none d-sm-inline">تعديل</span>
                                </button>
                                <div class="form-check m-0">
                                    <input class="form-check-input" type="radio" name="selectedOwnerRadio" 
                                           checked="@isSelected"
                                           @onchange="() => SelectUserForOwner(user.Id)" />
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>

            <!-- بطاقة التحقق من المستخدم المختار -->
            @if (SelectedOwnerUser != null)
            {
                var isSelectedEligible = IsUserEligibleForProvider(SelectedOwnerUser);
                if (isSelectedEligible)
                {
                    <div class="alert alert-success py-2 px-3 small rounded-3 mb-3 border-0 d-flex align-items-center justify-content-between">
                        <div>
                            <i class="fa-solid fa-circle-check text-success me-1"></i>
                            المستخدم <strong>@SelectedOwnerUser.FullName</strong> مستوفٍ للشروط. سيتم ربط الخدمة وإرسال إشعار فوري وتنبيه للمستخدم عند التأكيد.
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning py-2 px-3 small rounded-3 mb-3 border-0">
                        <div class="fw-bold mb-1 text-danger d-flex align-items-center gap-1">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                            <span>المستخدم <strong>@SelectedOwnerUser.FullName</strong> غير مستوفٍ لشروط مزود الخدمة:</span>
                        </div>
                        <ul class="mb-2 ps-3 x-small text-dark">
                            @if (string.IsNullOrWhiteSpace(SelectedOwnerUser.PhoneNumber))
                            {
                                <li>لا يوجد رقم هاتف مسجل للتواصل.</li>
                            }
                            @if (!SelectedOwnerUser.CityId.HasValue || SelectedOwnerUser.CityId.Value <= 0)
                            {
                                <li>المحافظة والمدينة غير مسجلة.</li>
                            }
                        </ul>
                        <button class="btn btn-sm btn-warning rounded-pill w-100" @onclick="() => OpenEditUser(SelectedOwnerUser)">
                            <i class="fa-solid fa-pen-to-square me-1"></i>
                            تعديل واستكمال بيانات المستخدم الآن
                        </button>
                    </div>
                }
            }

            <!-- أزرار الإجراءات -->
            <div class="d-flex gap-2 pt-2 border-top">
                <button class="btn btn-primary-premium flex-grow-1 rounded-pill"
                        disabled="@(!CanSaveSelectedOwner || isSavingOwner)"
                        @onclick="SaveChangeOwner">
                    @if (isSavingOwner) { <span class="spinner-border spinner-border-sm me-2"></span> }
                    <i class="fa-solid fa-link me-1"></i> حفظ وتأكيد الربط
                </button>
                <button class="btn btn-light flex-grow-1 rounded-pill"
                        @onclick="() => showChangeOwnerModal = false">إلغاء</button>
            </div>
        </div>
    </div>
}

<!-- ── مودال تعديل بيانات المستخدم ── -->
@if (showUserEditModal && userToEdit != null)
{
    <UserForm Show="showUserEditModal"
              Mode="Edit"
              User="userToEdit"
              Governorates="governorates"
              Cities="cities"
              IsSaving="isSavingUserEdit"
              ErrorMessage="@userEditErrorMessage"
              OnSave="HandleSaveUserEdit"
              OnCancel="() => showUserEditModal = false" />
}

<style>
    /* ── شجرة Lazy ── */
    .lazy-tree { max-width: 900px; }
    .tree-node { border-radius: 8px; margin-bottom: 2px; }

    .tree-row {
        display: flex; align-items: center; gap: 6px;
        padding: 8px 10px; border-radius: 10px;
        cursor: pointer; transition: background .15s;
        position: relative;
    }
    .tree-row:hover { background: rgba(0,0,0,.04); }
    .tree-row.active-row { background: rgba(var(--theme-primary-rgb,42,127,143),.08); }
    .tree-row.service-row { cursor: default; }
    .tree-row.service-row:hover { background: rgba(0,0,0,.03); }

    .toggle-icon { width: 16px; display: inline-flex; justify-content: center; flex-shrink: 0; }
    .tree-label { font-size: .88rem; }
    .level-0 > .tree-row { font-weight: 700; font-size: .9rem; }
    .level-1 > .tree-row { font-size: .87rem; }
    .level-2 > .tree-row { font-size: .85rem; }
    .level-3 > .tree-row { font-size: .83rem; }

    .tree-empty { font-size: .8rem; color: #94a3b8; padding: 6px 12px; }

    /* حد جانبي للأطفال */
    .level-1, .level-2, .level-3 {
        border-right: 2px solid rgba(0,0,0,.07);
        padding-right: 4px;
    }

    /* أزرار الخدمة */
    .svc-actions { opacity: 0.7; transition: opacity .2s; flex-shrink: 0; display: flex; gap: 4px; }
    .tree-row:hover .svc-actions { opacity: 1; }

    /* x-small */
    .x-small { font-size: .72rem; }

    /* مودال */
    .modal-overlay {
        position: fixed; inset: 0; z-index: 2000;
        background: rgba(0,0,0,.4);
        backdrop-filter: blur(5px);
        display: flex; align-items: center; justify-content: center;
    }
    .animate-pop { animation: pop .3s cubic-bezier(.175,.885,.32,1.275); }
    @@keyframes pop {
        from { transform: scale(.85); opacity: 0; }
        to   { transform: scale(1);   opacity: 1; }
    }

    .cursor-pointer { cursor: pointer; }
    .user-select-card:hover { border-color: rgba(var(--theme-primary-rgb,42,127,143),.5) !important; }

    /* ── التوافق مع الوضع الرأسي وشاشات الموبايل ── */
    @@media (max-width: 768px) {
        .lazy-tree .level-1, 
        .lazy-tree .level-2, 
        .lazy-tree .level-3 {
            margin-right: 6px !important;
            padding-right: 4px !important;
        }
        .tree-row.service-row {
            flex-wrap: wrap !important;
            padding: 8px 10px !important;
            gap: 4px 6px !important;
        }
        .tree-row.service-row .tree-label {
            flex: 1 1 55% !important;
            font-weight: 600;
        }
        .tree-row.service-row .svc-actions {
            opacity: 1 !important;
            width: 100% !important;
            display: flex !important;
            justify-content: flex-end !important;
            gap: 6px !important;
            margin-top: 4px !important;
            padding-top: 4px !important;
            border-top: 1px dashed rgba(0,0,0,0.08) !important;
        }
        .tree-row.service-row .svc-actions .btn {
            padding: 4px 10px !important;
            font-size: 0.8rem !important;
            border-radius: 8px !important;
            background: #ffffff !important;
            box-shadow: 0 1px 2px rgba(0,0,0,0.04) !important;
        }
    }
</style>

@code {
    // ── بيانات الشجرة ──
    private List<MainCategoryDto> mainCategories = new();
    private bool isLoadingMain = true;
    private string? loadingNodeId;   // تتبع العقدة التي يتم تحميلها

    // ── حالة التمديد (فتح عقدة واحدة فقط في كل مستوى) ──
    private int? expandedMain;
    private int? expandedCat;
    private int? expandedSub;

    // ── بيانات محمّلة حسب الحاجة ──
    private readonly Dictionary<int, List<CategoryDto>>    categoriesOf = new();
    private readonly Dictionary<int, List<SubCategoryDto>> subsOf       = new();
    private readonly Dictionary<int, List<ServiceNode>>    servicesOf   = new();

    // ── نموذج الخدمة مبسّط للعرض في الشجرة ──
    public class ServiceNode
    {
        public int    Id         { get; set; }
        public string Name       { get; set; } = "";
        public bool   IsApproved { get; set; }
    }

    // ── بيانات النماذج ──
    private List<MainCategoryDto> mainCatsForForm = new();
    private List<GovernorateDto>  governorates    = new();
    private List<CityDto>         cities          = new();
    private ServiceForm.ServiceFormModel? serviceFormModel;
    private int  editServiceId;
    private bool showEditModal = false;
    private bool isSaving      = false;

