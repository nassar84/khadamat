    private async Task SaveChanges(ServiceForm.ServiceFormModel model)
    {
        isSaving = true;
        try
        {
            await AdminService.UpdateService(editServiceId, new ServiceDto
            {
                Id            = editServiceId,
                Title         = model.Title,
                Description   = model.Description,
                Price         = model.Price,
                Address       = model.Address,
                CityId        = model.CityId,
                Location      = model.Location,
                CategoryId    = model.CategoryId,
                SubCategoryId = model.SubCategoryId,
                Phone1        = model.Phone1,
                WhatsApp      = model.WhatsApp,
                Facebook      = model.Facebook,
                Telegram      = model.Telegram,
                WorkDays      = model.WorkDays,
                WorkHours     = model.WorkHours,
                YouTubeUrl    = model.YouTubeUrl,
                Images        = model.Images
            });

            await JS.InvokeVoidAsync("alert", "تم حفظ التغييرات بنجاح");
            showEditModal = false;

            // تحديث اسم الخدمة في الشجرة مباشرة بدون إعادة تحميل كاملة
            foreach (var kvp in servicesOf)
            {
                var svc = kvp.Value.FirstOrDefault(s => s.Id == editServiceId);
                if (svc != null) { svc.Name = model.Title; break; }
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", "خطأ في حفظ البيانات: " + ex.Message);
        }
        finally { isSaving = false; }
    }

    private UserDto? SelectedOwnerUser => allUsers.FirstOrDefault(u => u.Id == selectedUserIdForOwner);

    private bool CanSaveSelectedOwner =>
        !string.IsNullOrEmpty(selectedUserIdForOwner) &&
        IsUserEligibleForProvider(SelectedOwnerUser);

    private IEnumerable<UserDto> FilteredUsersForAssign
    {
        get
        {
            var result = allUsers.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(userSearchTerm))
            {
                var term = userSearchTerm.Trim().ToLower();
                result = result.Where(u =>
                    (u.FullName?.ToLower().Contains(term) ?? false) ||
                    (u.Email?.ToLower().Contains(term) ?? false) ||
                    (u.PhoneNumber?.ToLower().Contains(term) ?? false));
            }

            if (userFilterEligibility == "eligible")
            {
                result = result.Where(IsUserEligibleForProvider);
            }
            else if (userFilterEligibility == "ineligible")
            {
                result = result.Where(u => !IsUserEligibleForProvider(u));
            }
            else if (userFilterEligibility == "provider")
            {
                result = result.Where(u => u.IsProvider || u.Role == "Provider");
            }

            return result;
        }
    }

    private bool IsUserEligibleForProvider(UserDto? user)
    {
        if (user == null) return false;
        var hasPhone = !string.IsNullOrWhiteSpace(user.PhoneNumber);
        var hasLocation = user.CityId.HasValue && user.CityId.Value > 0;
        return hasPhone && hasLocation;
    }

    private string GetUserCityName(int? cityId)
    {
        if (!cityId.HasValue) return "بدون موقع";
        var city = cities.FirstOrDefault(c => c.Id == cityId.Value);
        if (city == null) return "بدون موقع";
        var govName = !string.IsNullOrEmpty(city.GovernorateName) ? city.GovernorateName :
                      governorates.FirstOrDefault(g => g.Id == city.GovernorateId)?.NameAr;
        return !string.IsNullOrEmpty(govName) ? $"{city.NameAr}، {govName}" : city.NameAr;
    }

