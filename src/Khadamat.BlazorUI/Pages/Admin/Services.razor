    private async Task HandleSaveUserEdit(UserForm.UserFormModel model)
    {
        if (userToEdit == null) return;
        isSavingUserEdit = true;
        userEditErrorMessage = "";
        try
        {
            var updateDto = new UserDto
            {
                Id = model.Id,
                FullName = model.FullName,
                UserName = model.UserName,
                Email = model.Email,
                PhoneNumber = model.PhoneNumber,
                Role = model.Role,
                IsActive = model.IsActive,
                CityId = model.CityId,
                Gender = model.Gender,
                ProfileImageUrl = model.ProfileImageUrl,
                Bio = model.Bio,
                WebsiteUrl = model.WebsiteUrl,
                InstagramUrl = model.InstagramUrl,
                TwitterUrl = model.TwitterUrl,
                FacebookUrl = model.FacebookUrl,
                LinkedInUrl = model.LinkedInUrl,
                TikTokUrl = model.TikTokUrl
            };

            await AdminService.UpdateUser(userToEdit.Id, updateDto);

            // Update user in local allUsers list
            var idx = allUsers.FindIndex(u => u.Id == userToEdit.Id);
            if (idx != -1)
            {
                allUsers[idx] = updateDto;
            }

            // If this was the selected user, keep it selected and updated
            if (selectedUserIdForOwner == userToEdit.Id)
            {
                selectedUserIdForOwner = userToEdit.Id;
            }

            showUserEditModal = false;
            await JS.InvokeVoidAsync("alert", "تم تحديث بيانات المستخدم بنجاح.");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            userEditErrorMessage = "خطأ في حفظ البيانات: " + ex.Message;
        }
        finally
        {
            isSavingUserEdit = false;
        }
    }

    private async Task SaveChangeOwner()
    {
        if (string.IsNullOrEmpty(selectedUserIdForOwner)) return;

        var selectedUser = SelectedOwnerUser;
        if (selectedUser == null || !IsUserEligibleForProvider(selectedUser))
        {
            await JS.InvokeVoidAsync("alert", "المستخدم غير مستوفٍ لشروط مزود الخدمة. يرجى استكمال بيانات الهاتف والموقع أولاً.");
            return;
        }

        isSavingOwner = true;
        try
        {
            var res = await Api.PostAsync<ApiResponse<bool>>($"v1/admin/services/{serviceIdToChangeOwner}/change-owner", selectedUserIdForOwner);
            if (res != null && res.Success)
            {
                await JS.InvokeVoidAsync("alert", $"تم ربط الخدمة بالمستخدم '{selectedUser.FullName}' بنجاح وإرسال إشعار فوري وتنبيه له.");
                showChangeOwnerModal = false;
            }
            else
            {
                await JS.InvokeVoidAsync("alert", res?.Message ?? "خطأ في ربط المستخدم");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", "خطأ في ربط المستخدم: " + ex.Message);
        }
        finally { isSavingOwner = false; }
    }
