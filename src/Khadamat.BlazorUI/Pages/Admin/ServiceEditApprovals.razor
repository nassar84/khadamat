@page "/admin/approvals/service-edits"
@page "/admin/service-edits"
@using Khadamat.Application.DTOs
@using Khadamat.BlazorUI.Services.Admin
@using Khadamat.Application.Features.Services.Commands
@inject IAdminService AdminService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>طلبات تعديل البيانات</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">مراجعة تعديلات الخدمات</h2>
            <p class="text-muted">قم بمراجعة الاقتراحات المقدمة من المستخدمين لتصحيح بيانات الخدمات.</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-primary rounded-pill px-4" @onclick="LoadRequests">
                <i class="fa-solid fa-rotate me-1"></i> تحديث
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2">جاري تحميل الطلبات...</p>
        </div>
    }
    else if (requests == null || !requests.Any())
    {
        <div class="glass-card text-center py-5 border-0 shadow-sm">
            <i class="fa-solid fa-clipboard-check fs-1 text-success opacity-25 mb-3"></i>
            <h4 class="text-muted">لا توجد طلبات تعديل معلقة</h4>
            <p class="text-muted mb-0">تمت معالجة جميع الطلبات بنجاح.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var req in requests)
            {
                <div class="col-12">
                    <div class="card border-0 shadow-sm overflow-hidden" style="border-radius: 15px;">
                        <div class="card-header bg-white border-0 py-3 px-4 d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-primary-subtle p-2 rounded-3">
                                    <i class="fa-solid fa-pen-to-square text-primary"></i>
                                </div>
                                <div>
                                    <h5 class="mb-0 fw-bold">@req.ServiceName</h5>
                                    <small class="text-muted">بواسطة: @req.RequesterName | @req.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                                </div>
                            </div>
                            <span class="badge @GetStatusBadge(req.Status) rounded-pill px-3">@TranslateStatus(req.Status)</span>
                        </div>
                        <div class="card-body p-4 bg-light-subtle">
                            <div class="mb-3">
                                <label class="fw-bold text-primary small mb-1">سبب التعديل:</label>
                                <div class="p-3 bg-white border rounded-3 italic text-muted">"@req.Reason"</div>
                            </div>

                            <div class="table-responsive">
                                <table class="table table-bordered bg-white rounded-3 overflow-hidden shadow-sm align-middle">
                                    <thead class="bg-light">
                                        <tr>
                                            <th style="width: 150px;">الحقل</th>
                                            <th>القيمة الحالية</th>
                                            <th>القيمة المقترحة</th>
                                            <th class="text-center" style="width: 100px;">اعتماد؟</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (!string.IsNullOrEmpty(req.ProposedName))
                                        {
                                            <tr>
                                                <td class="fw-bold small">اسم الخدمة</td>
                                                <td class="text-muted">@req.CurrentName</td>
                                                <td class="fw-bold text-success">@req.ProposedName</td>
                                                <td class="text-center">
                                                    <input type="checkbox" class="form-check-input" @bind="approvalStates[req.Id].ApproveName" />
                                                </td>
                                            </tr>
                                        }
                                        @if (!string.IsNullOrEmpty(req.ProposedDescription))
                                        {
                                            <tr>
                                                <td class="fw-bold small">الوصف</td>
                                                <td class="text-muted text-truncate" style="max-width: 200px;">@req.CurrentDescription</td>
                                                <td class="fw-bold text-success text-truncate" style="max-width: 250px;">@req.ProposedDescription</td>
                                                <td class="text-center">
                                                    <input type="checkbox" class="form-check-input" @bind="approvalStates[req.Id].ApproveDescription" />
                                                </td>
                                            </tr>
                                        }
                                        @if (!string.IsNullOrEmpty(req.ProposedAddress))
                                        {
                                            <tr>
                                                <td class="fw-bold small">العنوان</td>
                                                <td class="text-muted">@req.CurrentAddress</td>
                                                <td class="fw-bold text-success">@req.ProposedAddress</td>
                                                <td class="text-center">
                                                    <input type="checkbox" class="form-check-input" @bind="approvalStates[req.Id].ApproveAddress" />
                                                </td>
                                            </tr>
                                        }
                                        @if (req.ProposedPrice.HasValue)
                                        {
                                            <tr>
                                                <td class="fw-bold small">السعر</td>
                                                <td class="text-muted">@(req.CurrentPrice?.ToString("N0") ?? "N/A")</td>
                                                <td class="fw-bold text-success">@req.ProposedPrice.Value.ToString("N0")</td>
                                                <td class="text-center">
                                                    <input type="checkbox" class="form-check-input" @bind="approvalStates[req.Id].ApprovePrice" />
                                                </td>
                                            </tr>
                                        }
                                        @if (!string.IsNullOrEmpty(req.ProposedPhone1))
                                        {
                                            <tr>
                                                <td class="fw-bold small">رقم الهاتف</td>
                                                <td class="text-muted">@req.CurrentPhone1</td>
                                                <td class="fw-bold text-success">@req.ProposedPhone1</td>
                                                <td class="text-center">
                                                    <input type="checkbox" class="form-check-input" @bind="approvalStates[req.Id].ApprovePhone1" />
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <div class="row mt-4">
                                <div class="col-md-6">
                                    <label class="small text-muted mb-1">ملاحظات المدير (تظهر للمستخدم):</label>
                                    <textarea class="form-control" rows="2" @bind="approvalStates[req.Id].AdminNotes" placeholder="أدخل ملاحظاتك هنا..."></textarea>
                                </div>
                                <div class="col-md-6 d-flex align-items-end justify-content-end gap-2 mt-3 mt-md-0">
                                    @if (req.HasOwner)
                                    {
                                        <button class="btn btn-info text-white rounded-pill px-3" @onclick='() => Process(req, "ForwardedToProvider")'>
                                            <i class="fa-solid fa-share me-1"></i> إرسال لصاحب الخدمة
                                        </button>
                                    }
                                    <button class="btn btn-success rounded-pill px-4" @onclick='() => Process(req, "Approved")'>
                                        <i class="fa-solid fa-check me-1"></i> اعتماد المختار
                                    </button>
                                    <button class="btn btn-outline-danger rounded-pill px-4" @onclick='() => Process(req, "Rejected")'>
                                        <i class="fa-solid fa-xmark me-1"></i> رفض الطلب
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .glass-card {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(10px);
        border-radius: 20px;
        padding: 2rem;
    }
    .bg-light-subtle {
        background-color: #f8f9fa !important;
    }
</style>

@code {
    private List<ServiceEditRequestDto> requests = new();
    private bool isLoading = true;
    private Dictionary<int, UpdateServiceEditRequestCommand> approvalStates = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadRequests();
    }

    private async Task LoadRequests()
    {
        isLoading = true;
        try
        {
            requests = await AdminService.GetServiceEditRequests("Pending");
            
            // Re-map following status changes if needed, but for now we filter Pending
            approvalStates = requests.ToDictionary(r => r.Id, r => new UpdateServiceEditRequestCommand
            {
                RequestId = r.Id,
                ApproveName = !string.IsNullOrEmpty(r.ProposedName),
                ApproveDescription = !string.IsNullOrEmpty(r.ProposedDescription),
                ApproveAddress = !string.IsNullOrEmpty(r.ProposedAddress),
                ApprovePrice = r.ProposedPrice.HasValue,
                ApprovePhone1 = !string.IsNullOrEmpty(r.ProposedPhone1)
            });
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task Process(ServiceEditRequestDto request, string status)
    {
        var command = approvalStates[request.Id];
        command.Status = status;

        string confirmMsg = status switch {
            "Approved" => "هل أنت متأكد من اعتماد التعديلات المختارة وتحديث بيانات الخدمة فوراً؟",
            "Rejected" => "هل أنت متأكد من رفض هذا الطلب؟",
            "ForwardedToProvider" => "سيتم إرسال الاقتراح لصاحب الخدمة لمراجعته. متابعة؟",
            _ => "هل أنت متأكد؟"
        };

        if (await JS.InvokeAsync<bool>("confirm", confirmMsg))
        {
            var success = await AdminService.UpdateServiceEditRequestStatus(request.Id, command);
            if (success)
            {
                requests.Remove(request);
                StateHasChanged();
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "فشل في معالجة الطلب. يرجى المحاولة مرة أخرى.");
            }
        }
    }

    private string GetStatusBadge(string status) => status switch
    {
        "Pending" => "bg-warning-subtle text-warning border border-warning",
        "Approved" => "bg-success-subtle text-success border border-success",
        "Rejected" => "bg-danger-subtle text-danger border border-danger",
        "ForwardedToProvider" => "bg-info-subtle text-info border border-info",
        _ => "bg-secondary text-white"
    };

    private string TranslateStatus(string status) => status switch
    {
        "Pending" => "قيد المراجعة",
        "Approved" => "تم الاعتماد",
        "Rejected" => "مرفوض",
        "ForwardedToProvider" => "أرسل للصاحب",
        _ => status
    };
}
