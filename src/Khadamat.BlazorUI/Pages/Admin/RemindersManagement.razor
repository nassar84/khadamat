    private async Task SaveReminder()
    {
        if (string.IsNullOrWhiteSpace(currentForm.Title))
        {
            await JS.InvokeVoidAsync("alert", "يرجى إدخال عنوان التذكير");
            return;
        }

        if (currentForm.MessageSelectionMode == "Single" && string.IsNullOrWhiteSpace(currentForm.Message))
        {
            await JS.InvokeVoidAsync("alert", "يرجى كتابة نص الرسالة للتذكير الثابت");
            return;
        }

        if (string.IsNullOrWhiteSpace(currentForm.Message))
        {
            currentForm.Message = "تذكير تلقائي مستمر من منصة خدماوى";
        }

        currentForm.ScheduledTime = scheduledTimeVal.ToTimeSpan();
        currentForm.StartDate = startDateVal;
        currentForm.EndDate = endDateVal;

        isSaving = true;
        try
        {
            if (isEditing)
            {
                var updateDto = new UpdateReminderCampaignDto
                {
                    Id = currentEditingId,
                    Title = currentForm.Title,
                    InternalDescription = currentForm.InternalDescription,
                    Message = currentForm.Message,
                    Language = currentForm.Language,
                    Status = currentForm.Status,
                    StartDate = currentForm.StartDate,
                    EndDate = currentForm.EndDate,
                    RecurrenceType = currentForm.RecurrenceType,
                    ScheduledTime = currentForm.ScheduledTime,
                    IntervalValue = currentForm.IntervalValue,
                    DaysOfWeek = currentForm.DaysOfWeek,
                    DurationDays = currentForm.DurationDays,
                    MaxOccurrences = currentForm.MaxOccurrences,
                    TimeZoneId = currentForm.TimeZoneId,
                    Priority = currentForm.Priority,
                    TargetAudience = currentForm.TargetAudience,
                    TargetRole = currentForm.TargetRole,
                    DisplayType = currentForm.DisplayType,
                    ActionRoute = currentForm.ActionRoute,
                    ImageUrl = currentForm.ImageUrl,
                    DeliveryChannel = currentForm.DeliveryChannel,
                    MessageSelectionMode = currentForm.MessageSelectionMode,
                    BankCategory = currentForm.BankCategory,
                    LastSequentialIndex = currentForm.LastSequentialIndex,
                    MessageBankItems = currentForm.MessageBankItems,
                    IsActive = (currentForm.Status == ReminderStatus.Active)
                };
                var result = await Api.UpdateReminderAsync(currentEditingId, updateDto);
                if (result != null)
                {
                    statusMessage = "تم حفظ تعديلات التذكير بنجاح وسيتم تحديث الجدولة على الأجهزة تلقائياً.";
                    isSuccess = true;
                }
            }
            else
            {
                var result = await Api.CreateReminderAsync(currentForm);
                if (result != null)
                {
                    statusMessage = "تم إنشاء التذكير الجديد بنجاح.";
                    isSuccess = true;
                }
            }

            showEditModal = false;
            await LoadReminders();
        }
        catch (Exception ex)
        {
            statusMessage = $"خطأ أثناء حفظ التذكير: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            isSaving = false;
        }
    }

