@code {
    private string activeTab = "campaigns"; // "campaigns" or "bank"

    private List<ReminderCampaignDto> reminders = new();
    private ReminderFilterDto filter = new();
    private bool isLoading = true;
    private bool isSaving = false;
    private string statusMessage = "";
    private bool isSuccess = true;

    // Bank State
    private List<ReminderBankItemDto> bankItems = new();
    private List<string> bankCategories = new();
    private string selectedBankCategory = "All";
    private string bankSearchTerm = "";
    private bool isBankLoading = false;

    // Master Bank Modal
    private bool showMasterBankModal = false;
    private bool isEditingMasterBank = false;
    private CreateReminderBankItemDto masterBankForm = new();
    private int currentMasterBankId = 0;
    private TimeOnly masterBankSuggestedTimeVal = new(9, 0);
    private bool isUploadingMasterBankImage = false;

    // Campaign Edit modal state
    private bool showEditModal = false;
    private bool isEditing = false;
    private int currentEditingId = 0;
    private CreateReminderCampaignDto currentForm = new();
    private TimeOnly scheduledTimeVal = new(20, 0);
    private DateTime startDateVal = DateTime.UtcNow.Date;
    private DateTime? endDateVal = DateTime.UtcNow.Date.AddDays(14);
    private string selectedStatusString = "";
    private string selectedAudienceString = "";

    // Campaign Bank item modal state (local items)
    private bool showBankItemModal = false;
    private bool isEditingBankItem = false;
    private ReminderMessageBankItemDto? editingBankItem;
    private DateTime bankItemDateTimeVal = DateTime.Now;

    // Destination Selection
    private string reminderDestMode = "Screen";
    private string selectedReminderScreen = "/";
    private string selectedReminderServiceId = "";
    private ServiceDto? selectedReminderService;
    private List<ServiceDto> servicesList = new();

    // Preview modal state
    private bool showPreviewModal = false;
    private ReminderCampaignDto? previewItem;

    // Image upload state
    private bool isUploadingReminderImage = false;
    private bool reminderImageLoadFailed = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadReminders();
        await LoadBankItems();
        try
        {
            var serv = await Api.GetServicesAsync(page: 1, pageSize: 100, isApproved: true);
            servicesList = serv?.Items?.ToList() ?? new();
        }
        catch { }
    }

    private async Task SwitchTab(string tab)
    {
        activeTab = tab;
        if (tab == "bank")
        {
            await LoadBankItems();
        }
        else
        {
            await LoadReminders();
        }
    }

    private async Task LoadBankItems()
    {
        isBankLoading = true;
        try
        {
            bankItems = await Api.GetReminderBankItemsAsync();
            bankCategories = await Api.GetReminderBankCategoriesAsync();
        }
        catch (Exception ex)
        {
            statusMessage = $"خطأ في تحميل بنك التذكيرات: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            isBankLoading = false;
        }
    }

    private void SelectBankCategoryFilter(string cat)
    {
        selectedBankCategory = cat;
    }

    private List<ReminderBankItemDto> GetFilteredBankItems()
    {
        var query = bankItems.AsEnumerable();
        if (selectedBankCategory != "All")
        {
            query = query.Where(b => b.Category == selectedBankCategory);
        }
        if (!string.IsNullOrWhiteSpace(bankSearchTerm))
        {
            var term = bankSearchTerm.Trim().ToLowerInvariant();
            query = query.Where(b => b.Title.ToLowerInvariant().Contains(term) || b.Message.ToLowerInvariant().Contains(term));
        }
        return query.OrderBy(b => b.OrderIndex).ThenBy(b => b.Id).ToList();
    }

    private void OpenCreateMasterBankModal()
    {
        isEditingMasterBank = false;
        currentMasterBankId = 0;
        masterBankForm = new CreateReminderBankItemDto
        {
            Title = "",
            Message = "",
            Category = selectedBankCategory != "All" ? selectedBankCategory : "صباحية",
            OrderIndex = bankItems.Count > 0 ? bankItems.Max(b => b.OrderIndex) + 1 : 1,
            ActionRoute = "/",
            IsActive = true
        };
        masterBankSuggestedTimeVal = new TimeOnly(9, 0);
        showMasterBankModal = true;
    }

    private void OpenEditMasterBankModal(ReminderBankItemDto item)
    {
        isEditingMasterBank = true;
        currentMasterBankId = item.Id;
        masterBankForm = new CreateReminderBankItemDto
        {
            Title = item.Title,
            Message = item.Message,
            Category = item.Category,
            OrderIndex = item.OrderIndex,
            SuggestedTime = item.SuggestedTime,
            ImageUrl = item.ImageUrl,
            ActionRoute = item.ActionRoute,
            IsActive = item.IsActive
        };
        masterBankSuggestedTimeVal = item.SuggestedTime.HasValue 
            ? TimeOnly.FromTimeSpan(item.SuggestedTime.Value) 
            : new TimeOnly(9, 0);
        showMasterBankModal = true;
    }

    private async Task SaveMasterBankItem()
    {
        if (string.IsNullOrWhiteSpace(masterBankForm.Title) || string.IsNullOrWhiteSpace(masterBankForm.Message))
        {
            await JS.InvokeVoidAsync("alert", "يرجى كتابة عنوان التذكير ونصه");
            return;
        }

        masterBankForm.SuggestedTime = masterBankSuggestedTimeVal.ToTimeSpan();

        try
        {
            if (isEditingMasterBank)
            {
                var updateDto = new UpdateReminderBankItemDto
                {
                    Id = currentMasterBankId,
                    Title = masterBankForm.Title,
                    Message = masterBankForm.Message,
                    Category = masterBankForm.Category,
                    OrderIndex = masterBankForm.OrderIndex,
                    SuggestedTime = masterBankForm.SuggestedTime,
                    ImageUrl = masterBankForm.ImageUrl,
                    ActionRoute = masterBankForm.ActionRoute,
                    IsActive = masterBankForm.IsActive
                };
                var updated = await Api.UpdateReminderBankItemAsync(currentMasterBankId, updateDto);
                if (updated != null)
                {
                    statusMessage = "تم تحديث رسالة البنك بنجاح!";
                    isSuccess = true;
                }
            }
            else
            {
                var created = await Api.CreateReminderBankItemAsync(masterBankForm);
                if (created != null)
                {
                    statusMessage = "تمت إضافة الرسالة إلى بنك التذكيرات بنجاح!";
                    isSuccess = true;
                }
            }

            showMasterBankModal = false;
            await LoadBankItems();
        }
        catch (Exception ex)
        {
            statusMessage = $"خطأ: {ex.Message}";
            isSuccess = false;
        }
    }

