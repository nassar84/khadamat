@page "/admin/reminders"
@attribute [Authorize(Roles = "SuperAdmin,SystemAdmin")]
@using Khadamat.Application.DTOs
@using Khadamat.Domain.Enums
@using Khadamat.BlazorUI.Services
@inject ApiClient Api
@inject IJSRuntime JS
@inject NavigationManager Navigation

<div class="px-2 pb-5 reminders-page-wrapper" dir="rtl">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-start align-items-md-center mb-4 flex-wrap gap-2 mt-2">
        <div>
            <h1 class="fw-bold mb-1 text-primary fs-4">
                <i class="fa-solid fa-bell me-2"></i>إدارة التذكيرات والإشعارات المحلية
            </h1>
            <p class="text-muted small mb-0">تحكم كامل في مواعيد ونصوص وطرق عرض التذكيرات لحملات الاختبار والمستخدمين</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <button class="btn btn-outline-info rounded-pill px-3 shadow-sm btn-sm" @onclick='() => Navigation.NavigateTo("/admin/send-notification")' title="إرسال إشعار فوري لجميع المستخدمين أو فئة معينة">
                <i class="fa-solid fa-paper-plane me-1"></i>إرسال تنبيه فوري
            </button>
            <button class="btn btn-outline-warning rounded-pill px-3 shadow-sm btn-sm" @onclick="TestFcmBroadcast" title="إرسال إشعار فوري لجميع الأجهزة النشطة عبر Firebase">
                <i class="fa-solid fa-satellite-dish me-1"></i>اختبار Firebase FCM
            </button>
            <button class="btn btn-outline-primary rounded-pill px-3 shadow-sm btn-sm" @onclick="LoadDefaultTesterTemplate" title="إنشاء أو استعادة حملة اختبار Google Play">
                <i class="fa-brands fa-google-play me-1 text-success"></i>حملة الـ 14 يوماً للمختبرين
            </button>
            <button class="btn btn-primary-premium rounded-pill px-4 shadow-sm btn-sm" @onclick="OpenCreateModal">
                <i class="fa-solid fa-plus me-1"></i>تذكير جديد
            </button>
        </div>
    </div>

    <!-- Alert / Status Message -->
    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert @(isSuccess ? "alert-success" : "alert-danger") rounded-4 shadow-sm mb-4 d-flex align-items-center justify-content-between animate-fade-in" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="fa-solid @(isSuccess ? "fa-circle-check text-success" : "fa-circle-exclamation text-danger") fs-5"></i>
                <span class="fw-bold">@statusMessage</span>
            </div>
            <button type="button" class="btn-close" @onclick='() => statusMessage = ""'></button>
        </div>
    }

    <!-- Quick Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="glass-card p-3 text-center border-start border-primary border-4">
                <span class="text-muted small d-block mb-1">إجمالي التذكيرات</span>
                <h3 class="fw-bold mb-0 text-primary">@reminders.Count</h3>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="glass-card p-3 text-center border-start border-success border-4">
                <span class="text-muted small d-block mb-1">المفعلة حالياً</span>
                <h3 class="fw-bold mb-0 text-success">@reminders.Count(r => r.Status == ReminderStatus.Active)</h3>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="glass-card p-3 text-center border-start border-warning border-4">
                <span class="text-muted small d-block mb-1">متوقفة مؤقتاً</span>
                <h3 class="fw-bold mb-0 text-warning">@reminders.Count(r => r.Status == ReminderStatus.Paused)</h3>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="glass-card p-3 text-center border-start border-secondary border-4">
                <span class="text-muted small d-block mb-1">المسودات والمنتهية</span>
                <h3 class="fw-bold mb-0 text-muted">@reminders.Count(r => r.Status == ReminderStatus.Draft || r.Status == ReminderStatus.Expired)</h3>
            </div>
        </div>
    </div>

    <!-- Filters Bar -->
    <div class="glass-card p-3 mb-4">
        <div class="row g-2 align-items-center">
            <div class="col-12 col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-end-0"><i class="fa-solid fa-search text-muted"></i></span>
                    <input type="text" class="form-control border-start-0 ps-0" placeholder="بحث بالاسم أو نص الرسالة..." 
                           @bind="filter.SearchTerm" @bind:event="oninput" @onkeyup="HandleSearch" />
                </div>
            </div>
            <div class="col-6 col-md-2">
                <select class="form-select" @bind="selectedStatusString" @bind:after="ApplyFilter">
                    <option value="">جميع الحالات</option>
                    <option value="Active">مفعّل</option>
                    <option value="Paused">متوقف مؤقتاً</option>
                    <option value="Draft">مسودة</option>
                    <option value="Expired">منتهي</option>
                </select>
            </div>
            <div class="col-6 col-md-3">
                <select class="form-select" @bind="selectedAudienceString" @bind:after="ApplyFilter">
                    <option value="">جميع الفئات</option>
                    <option value="Testers">مختبرو التطبيق</option>
                    <option value="AllUsers">جميع المستخدمين</option>
                    <option value="Clients">العملاء</option>
                    <option value="Providers">مقدمو الخدمات</option>
                </select>
            </div>
            <div class="col-12 col-md-3 text-md-start">
                <button class="btn btn-outline-secondary w-100 rounded-pill" @onclick="ResetFilters">
                    <i class="fa-solid fa-rotate-left me-1"></i>إعادة تعيين
                </button>
            </div>
        </div>
    </div>

    <!-- List of Reminders -->
    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">جاري تحميل التذكيرات...</p>
        </div>
    }
    else if (!reminders.Any())
    {
        <div class="glass-card p-5 text-center">
            <div class="mb-3">
                <i class="fa-regular fa-bell-slash fs-1 text-muted"></i>
            </div>
            <h5 class="fw-bold">لا توجد تذكيرات مطابقة</h5>
            <p class="text-muted small">يمكنك إضافة تذكير جديد أو تفعيل نموذج حملة مختبري Google Play بنقرة واحدة.</p>
            <div class="d-flex justify-content-center gap-2 mt-3">
                <button class="btn btn-primary-premium rounded-pill px-4 btn-sm" @onclick="LoadDefaultTesterTemplate">
                    <i class="fa-brands fa-google-play me-1"></i>تفعيل حملة المختبرين الافتراضية
                </button>
                <button class="btn btn-outline-primary rounded-pill px-4 btn-sm" @onclick="OpenCreateModal">
                    <i class="fa-solid fa-plus me-1"></i>إنشاء تذكير جديد
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var rem in reminders)
            {
                <div class="col-12 col-lg-6" key="@rem.Id">
                    <div class="glass-card p-3 h-100 d-flex flex-column border @(rem.Status == ReminderStatus.Active ? "border-success-subtle" : "border-light") shadow-sm">
                        <!-- Top Row: Title, Badges, Dropdown -->
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                            <div>
                                <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                                    <h5 class="fw-bold mb-0 fs-6 text-dark">@rem.Title</h5>
                                    <span class="badge @GetStatusBadgeClass(rem.Status) rounded-pill px-2 py-1 small">
                                        @rem.StatusText
                                    </span>
                                    <span class="badge bg-light text-dark border rounded-pill px-2 py-1 small">
                                        <i class="fa-solid fa-clock me-1 text-primary"></i>@rem.ScheduledTimeString
                                    </span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(rem.InternalDescription))
                                {
                                    <span class="text-muted x-small d-block"><i class="fa-solid fa-tag me-1"></i>@rem.InternalDescription</span>
                                }
                            </div>

                            <div class="d-flex gap-1">
                                <button class="btn btn-sm btn-outline-secondary rounded-circle" title="معاينة التذكير" @onclick="() => OpenPreviewModal(rem)">
                                    <i class="fa-solid fa-eye"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-primary rounded-circle" title="تعديل" @onclick="() => OpenEditModal(rem)">
                                    <i class="fa-solid fa-pen"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-info rounded-circle" title="نسخ لإنشاء تذكير مشابه" @onclick="() => DuplicateReminder(rem.Id)">
                                    <i class="fa-solid fa-clone"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger rounded-circle" title="حذف" @onclick="() => DeleteReminder(rem.Id)">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(rem.ImageUrl))
                        {
                            <div class="mb-2 rounded-3 overflow-hidden border shadow-xs" style="max-height: 140px;">
                                <img src="@rem.ImageUrl" alt="" style="width: 100%; height: 140px; object-fit: cover;" />
                            </div>
                        }

                        <!-- Message Body Preview -->
                        <div class="bg-light p-2 rounded-3 mb-3 border-start border-3 border-primary text-secondary small flex-grow-1">
                            @rem.Message
                        </div>

                        <!-- Meta details badges -->
                        <div class="d-flex flex-wrap gap-2 text-muted x-small mb-3">
                            <span class="badge bg-light text-secondary border">
                                <i class="fa-solid fa-repeat me-1 text-info"></i>@rem.RecurrenceTypeText
                            </span>
                            <span class="badge bg-light text-secondary border">
                                <i class="fa-solid fa-users me-1 text-primary"></i>@rem.TargetAudienceText
                            </span>
                            <span class="badge bg-light text-secondary border">
                                <i class="fa-solid fa-tv me-1 text-warning"></i>@rem.DisplayTypeText
                            </span>
                            <span class="badge bg-light text-secondary border">
                                <i class="fa-solid fa-tower-broadcast me-1 text-info"></i>
                                @(rem.DeliveryChannel switch {
                                    "PushOnly" => "شاشة الموبايل فقط",
                                    "InAppOnly" => "داخلي فقط",
                                    _ => "كلاهما (موبايل + داخلي)"
                                })
                            </span>
                            @if (rem.MessageSelectionMode != "Single" && !string.IsNullOrEmpty(rem.MessageSelectionMode))
                            {
                                <span class="badge bg-warning-subtle text-warning-emphasis border">
                                    <i class="fa-solid fa-vault me-1"></i>
                                    @(rem.MessageSelectionMode.StartsWith("Random") ? "بنك عشوائي" : "بنك مجدول")
                                    (@rem.MessageBankItems.Count)
                                </span>
                            }
                            <span class="badge bg-light text-secondary border">
                                <i class="fa-solid fa-location-arrow me-1 text-danger"></i>الوجهة: @rem.ActionRoute
                            </span>
                            @if (rem.DurationDays.HasValue)
                            {
                                <span class="badge bg-light text-secondary border">
                                    <i class="fa-solid fa-hourglass-half me-1 text-success"></i>المدة: @rem.DurationDays يوم
                                </span>
                            }
                        </div>

                        <!-- Footer: Dates & Quick Action buttons -->
                        <div class="d-flex justify-content-between align-items-center pt-2 border-top x-small mt-auto">
                            <span class="text-muted">
                                <i class="fa-regular fa-calendar me-1"></i>من: @rem.StartDate.ToString("yyyy/MM/dd") 
                                @(rem.EndDate.HasValue ? $"إلى: {rem.EndDate.Value:yyyy/MM/dd}" : "")
                            </span>

                            <div class="d-flex gap-1 align-items-center">
                                <button class="btn btn-sm btn-outline-primary rounded-pill px-2 py-1 x-small fw-bold" @onclick="() => TestTriggerReminder(rem)" title="إرسال هذا التذكير فوراً للتجربة والتأكد من وصوله للهاتف والمركز">
                                    <i class="fa-solid fa-paper-plane me-1"></i>تجربة الآن
                                </button>
                                @if (rem.Status == ReminderStatus.Active)
                                {
                                    <button class="btn btn-sm btn-outline-warning rounded-pill px-3 py-1 x-small" @onclick="() => ToggleStatus(rem.Id, ReminderStatus.Paused)">
                                        <i class="fa-solid fa-pause me-1"></i>إيقاف مؤقت
                                    </button>
                                }
                                else if (rem.Status == ReminderStatus.Paused || rem.Status == ReminderStatus.Draft)
                                {
                                    <button class="btn btn-sm btn-outline-success rounded-pill px-3 py-1 x-small" @onclick="() => ToggleStatus(rem.Id, ReminderStatus.Active)">
                                        <i class="fa-solid fa-play me-1"></i>تفعيل
                                    </button>
                                }
                                @if (rem.Status != ReminderStatus.Expired)
                                {
                                    <button class="btn btn-sm btn-outline-secondary rounded-pill px-2 py-1 x-small" @onclick="() => ToggleStatus(rem.Id, ReminderStatus.Expired)" title="إنهاء الحملة">
                                        <i class="fa-solid fa-stop me-1"></i>إنهاء
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- ========================================== -->
<!-- Modal: Create / Edit Reminder              -->
<!-- ========================================== -->
@if (showEditModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" dir="rtl">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content glass-card border-0 shadow-lg rounded-4">
                <div class="modal-header border-bottom pb-3">
                    <h5 class="modal-title fw-bold text-primary">
                        <i class="fa-solid @(isEditing ? "fa-pen" : "fa-plus") me-2"></i>
                        @(isEditing ? "تعديل التذكير" : "إنشاء تذكير جديد")
                    </h5>
                    <button type="button" class="btn-close ms-0 me-auto" @onclick="CloseEditModal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <!-- Title -->
                        <div class="col-12 col-md-8">
                            <label class="form-label small fw-bold">عنوان التذكير <span class="text-danger">*</span></label>
                            <input type="text" class="form-control rounded-pill" @bind="currentForm.Title" placeholder="مثلاً: تذكير المختبرين بالاستخدام اليومي" />
                        </div>

                        <!-- Language -->
                        <div class="col-12 col-md-4">
                            <label class="form-label small fw-bold">اللغة</label>
                            <select class="form-select rounded-pill" @bind="currentForm.Language">
                                <option value="ar">العربية (ar)</option>
                                <option value="en">الإنجليزية (en)</option>
                                <option value="all">جميع اللغات (all)</option>
                            </select>
                        </div>

                        <!-- Internal Description -->
                        <div class="col-12">
                            <label class="form-label small fw-bold">الغرض الداخلي (للمدير فقط)</label>
                            <input type="text" class="form-control rounded-pill" @bind="currentForm.InternalDescription" placeholder="مثلاً: دعم الاختبار المغلق لمدة 14 يوماً على Google Play" />
                        </div>

                        <!-- Delivery Channel Selection -->
                        <div class="col-12">
                            <div class="p-3 bg-light rounded-3 border">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <label class="form-label small fw-bold mb-0">
                                        <i class="fa-solid fa-tower-broadcast text-primary me-1"></i>قناة الإرسال ومكان الظهور
                                    </label>
                                    <span class="badge bg-primary-subtle text-primary border small">
                                        @(currentForm.DeliveryChannel switch {
                                            "PushOnly" => "شاشة الموبايل فقط",
                                            "InAppOnly" => "داخلي فقط",
                                            _ => "كلاهما (موبايل + داخلي)"
                                        })
                                    </span>
                                </div>
                                <div class="btn-group w-100 shadow-sm rounded-pill overflow-hidden" role="group">
                                    <input type="radio" class="btn-check" name="remDeliveryChannel" id="remChannelBoth" @onclick='() => currentForm.DeliveryChannel = "Both"' checked="@(currentForm.DeliveryChannel == "Both" || string.IsNullOrEmpty(currentForm.DeliveryChannel))">
                                    <label class="btn btn-outline-primary btn-sm py-1.5" for="remChannelBoth" title="يصل على شاشة الهاتف كـ Push ويظهر أيضاً داخل التطبيق">
                                        <i class="fa-solid fa-layer-group me-1"></i>كلاهما (شاشة الهاتف + داخلي)
                                    </label>

                                    <input type="radio" class="btn-check" name="remDeliveryChannel" id="remChannelPush" @onclick='() => currentForm.DeliveryChannel = "PushOnly"' checked="@(currentForm.DeliveryChannel == "PushOnly")">
                                    <label class="btn btn-outline-primary btn-sm py-1.5" for="remChannelPush" title="يصل كإشعار خارجي فقط على شاشة الموبايل دون حفظه داخل صندوق الإشعارات">
                                        <i class="fa-solid fa-mobile-screen me-1"></i>شاشة الموبايل فقط
                                    </label>

                                    <input type="radio" class="btn-check" name="remDeliveryChannel" id="remChannelInApp" @onclick='() => currentForm.DeliveryChannel = "InAppOnly"' checked="@(currentForm.DeliveryChannel == "InAppOnly")">
                                    <label class="btn btn-outline-primary btn-sm py-1.5" for="remChannelInApp" title="يظهر فقط داخل التطبيق دون إرسال push notification خارجي">
                                        <i class="fa-solid fa-inbox me-1"></i>داخلي فقط
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- Message Selection Mode & Message Bank -->
                        <div class="col-12">
                            <div class="p-3 bg-light rounded-3 border">
                                <label class="form-label small fw-bold mb-2">
                                    <i class="fa-solid fa-envelope-open-text text-primary me-1"></i>طريقة اختيار الرسائل (بنك التنبيهات)
                                </label>
                                <div class="btn-group w-100 shadow-sm rounded-pill overflow-hidden mb-2" role="group">
                                    <input type="radio" class="btn-check" name="remMsgMode" id="msgModeSingle" @onclick='() => currentForm.MessageSelectionMode = "Single"' checked="@(currentForm.MessageSelectionMode == "Single" || string.IsNullOrEmpty(currentForm.MessageSelectionMode))">
                                    <label class="btn btn-outline-primary btn-sm py-1.5" for="msgModeSingle">
                                        <i class="fa-solid fa-message me-1"></i>رسالة واحدة ثابتة
                                    </label>

                                    <input type="radio" class="btn-check" name="remMsgMode" id="msgModeRandom" @onclick='() => currentForm.MessageSelectionMode = "RandomBank"' checked="@(currentForm.MessageSelectionMode == "RandomBank" || currentForm.MessageSelectionMode == "Random")">
                                    <label class="btn btn-outline-primary btn-sm py-1.5" for="msgModeRandom">
                                        <i class="fa-solid fa-shuffle me-1"></i>بنك رسائل - اختيار عشوائي
                                    </label>

                                    <input type="radio" class="btn-check" name="remMsgMode" id="msgModeScheduled" @onclick='() => currentForm.MessageSelectionMode = "ScheduledBank"' checked="@(currentForm.MessageSelectionMode == "ScheduledBank" || currentForm.MessageSelectionMode == "Scheduled")">
                                    <label class="btn btn-outline-primary btn-sm py-1.5" for="msgModeScheduled">
                                        <i class="fa-solid fa-calendar-days me-1"></i>بنك رسائل - مجدول بتاريخ ووقت
                                    </label>
                                </div>
                                <div class="text-muted x-small">
                                    @(currentForm.MessageSelectionMode switch {
                                        "RandomBank" or "Random" => "سيتم اختيار رسالة مختلفة عشوائياً من بنك التنبيهات عند كل تذكير.",
                                        "ScheduledBank" or "Scheduled" => "سيتم إرسال كل رسالة مسجلة في بنك التنبيهات في التاريخ والوقت المحدد لها بدقة.",
                                        _ => "سيتم إرسال نفس الرسالة الثابتة المحددة أدناه في كل مرة."
                                    })
                                </div>

                                @if (currentForm.MessageSelectionMode != "Single" && !string.IsNullOrEmpty(currentForm.MessageSelectionMode))
                                {
                                    <div class="mt-3 pt-3 border-top">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="fw-bold small text-dark">
                                                <i class="fa-solid fa-vault text-warning me-1"></i>قائمة رسائل البنك (@currentForm.MessageBankItems.Count رسالة)
                                            </span>
                                            <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 py-1" @onclick="OpenAddBankItemModal">
                                                <i class="fa-solid fa-plus me-1"></i>إضافة رسالة للبنك
                                            </button>
                                        </div>

                                        @if (currentForm.MessageBankItems.Count == 0)
                                        {
                                            <div class="alert alert-warning py-2 small mb-2 text-center">
                                                <i class="fa-solid fa-triangle-exclamation me-1"></i>لم تتم إضافة أي رسائل إلى بنك التنبيهات بعد. اضغط "إضافة رسالة للبنك" لإضافة رسائل غير محدودة.
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="d-flex flex-column gap-2 mb-2" style="max-height: 280px; overflow-y: auto;">
                                                @foreach (var item in currentForm.MessageBankItems)
                                                {
                                                    <div class="p-2.5 rounded-3 border bg-white shadow-xs d-flex justify-content-between align-items-center gap-2">
                                                        <div class="min-w-0 flex-grow-1">
                                                            <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                                                                <span class="fw-bold text-dark small text-truncate" style="max-width: 250px;">
                                                                    @(!string.IsNullOrWhiteSpace(item.Title) ? item.Title : currentForm.Title)
                                                                </span>
                                                                @if (item.ScheduledDateTime.HasValue)
                                                                {
                                                                    <span class="badge bg-primary-subtle text-primary x-small">
                                                                        <i class="fa-regular fa-clock me-1"></i>@item.ScheduledDateTime.Value.ToString("yyyy/MM/dd HH:mm")
                                                                    </span>
                                                                }
                                                                @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                                                {
                                                                    <span class="badge bg-light text-secondary border x-small">
                                                                        <i class="fa-solid fa-image text-info me-1"></i>صورة
                                                                    </span>
                                                                }
                                                                @if (item.IsSent)
                                                                {
                                                                    <span class="badge bg-success-subtle text-success x-small">
                                                                        <i class="fa-solid fa-check me-1"></i>أُرسلت (@item.SendCount مرة)
                                                                    </span>
                                                                }
                                                            </div>
                                                            <p class="mb-0 text-muted x-small text-truncate">@item.Message</p>
                                                        </div>
                                                        <div class="d-flex gap-1 flex-shrink-0">
                                                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill py-0 px-2 x-small" @onclick="() => OpenEditBankItemModal(item)">
                                                                <i class="fa-solid fa-pen"></i>
                                                            </button>
                                                            <button type="button" class="btn btn-sm btn-outline-danger rounded-pill py-0 px-2 x-small" @onclick="() => DeleteBankItem(item.Id)">
                                                                <i class="fa-solid fa-trash"></i>
                                                            </button>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Message Body -->
                        <div class="col-12">
                            <label class="form-label small fw-bold">نص الرسالة للمستخدم <span class="text-danger">*</span></label>
                            <textarea class="form-control rounded-3" rows="4" @bind="currentForm.Message" placeholder="اكتب النص الذي سيظهر في الإشعار أو داخل التطبيق..."></textarea>
                            <span class="x-small text-muted">احرص على كتابة نص جذاب وواضح يشجع المستخدم على التفاعل دون إزعاج.</span>
                        </div>

                        <!-- Reminder Image (Optional) -->
                        <div class="col-12">
                            <div class="p-3 rounded-3 border bg-white shadow-xs">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <label class="form-label small fw-bold mb-0">
                                        <i class="fa-solid fa-image text-primary me-1"></i>صورة التذكير (اختياري - تظهر كصورة بارزة في الإشعار)
                                    </label>
                                </div>

                                <!-- Image Guidelines & Conditions -->
                                <div class="p-2.5 mb-2.5 rounded-3 border bg-light small text-muted" style="border-right: 4px solid #0d6efd !important;">
                                    <div class="d-flex align-items-center gap-1.5 fw-bold text-dark mb-1">
                                        <i class="fa-solid fa-circle-info text-primary"></i>
                                        <span>تعليمات الصورة للظهور على شاشة الموبايل وقفل الشاشة:</span>
                                    </div>
                                    <ul class="mb-0 ps-3 x-small" style="line-height: 1.6;">
                                        <li><strong>الأبعاد والنسبة:</strong> يفضل أن تكون الصورة بالعرض <strong>(Landscape بنسبة 2:1)</strong> مثل <code>1024 × 512</code> بكسل لتملأ شريط إشعارات أندرويد.</li>
                                        <li><strong>حجم الملف:</strong> يفضل ألا يتجاوز <strong>1 ميجابايت</strong> (المثالي بين 100 و 400 كيلوبايت) لسرعة تنزيلها على الهاتف فوراً.</li>
                                        <li><strong>الصيغ المدعومة:</strong> JPG, PNG, WebP.</li>
                                        <li><strong>طريقة الظهور:</strong> تظهر كبانر عريض (BigPicture) عند سحب الإشعار لأسفل على هاتف أندرويد.</li>
                                    </ul>
                                </div>
                                <div>
                                    @if (!string.IsNullOrWhiteSpace(currentForm.ImageUrl))
                                    {
                                        <button type="button" class="btn btn-link text-danger p-0 small text-decoration-none" @onclick="ClearReminderImage">
                                            <i class="fa-solid fa-trash me-1"></i>حذف الصورة
                                        </button>
                                    }
                                </div>
                                <div class="row g-2 align-items-center">
                                    <div class="col-sm-8">
                                        <input type="text" class="form-control form-control-sm rounded-pill" 
                                               @bind="currentForm.ImageUrl" 
                                               @bind:event="oninput"
                                               placeholder="رابط الصورة المباشر https://..." />
                                    </div>
                                    <div class="col-sm-4">
                                        <label class="btn btn-outline-primary btn-sm w-100 rounded-pill mb-0 @(isUploadingReminderImage ? "disabled" : "")" style="cursor: pointer;">
                                            @if (isUploadingReminderImage)
                                            {
                                                <span class="spinner-border spinner-border-sm me-1"></span>
                                                <span>جاري الرفع...</span>
                                            }
                                            else
                                            {
                                                <i class="fa-solid fa-cloud-arrow-up me-1"></i>
                                                <span>رفع صورة</span>
                                            }
                                            <InputFile OnChange="HandleReminderImageUpload" accept="image/*" class="d-none" disabled="@isUploadingReminderImage" />
                                        </label>
                                    </div>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(currentForm.ImageUrl))
                                {
                                    <div class="position-relative mt-2 rounded-3 overflow-hidden border bg-light text-center p-2">
                                        <img src="@currentForm.ImageUrl" alt="معاينة الصورة" class="img-fluid rounded-2 shadow-xs" style="max-height: 150px; width: 100%; object-fit: cover;" @onerror="OnReminderImageLoadError" />
                                        @if (reminderImageLoadFailed)
                                        {
                                            <div class="text-danger small mt-2">
                                                <i class="fa-solid fa-triangle-exclamation me-1"></i>تعذر تحميل الصورة. تأكد من أن الرابط مباشر ويبدأ بـ https://
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Schedule & Recurrence -->
                        <div class="col-12">
                            <div class="border-top pt-3 mt-2">
                                <h6 class="fw-bold text-dark small mb-3"><i class="fa-solid fa-clock me-1 text-primary"></i>الجدولة والتكرار</h6>
                            </div>
                        </div>

                        <!-- Recurrence Type -->
                        <div class="col-12 col-md-4">
                            <label class="form-label small fw-bold">نوع التكرار</label>
                            <select class="form-select rounded-pill" @bind="currentForm.RecurrenceType">
                                <option value="@ReminderRecurrenceType.Daily">يومياً</option>
                                <option value="@ReminderRecurrenceType.Once">مرة واحدة</option>
                                <option value="@ReminderRecurrenceType.Weekly">أسبوعياً</option>
                                <option value="@ReminderRecurrenceType.SpecificDaysOfWeek">أيام محددة من الأسبوع</option>
                                <option value="@ReminderRecurrenceType.IntervalHours">كل عدد ساعات</option>
                                <option value="@ReminderRecurrenceType.IntervalDays">كل عدد أيام</option>
                            </select>
                        </div>

                        <!-- Time of Day -->
                        <div class="col-6 col-md-4">
                            <label class="form-label small fw-bold">موعد العرض / الإرسال</label>
                            <input type="time" class="form-control rounded-pill" @bind="scheduledTimeVal" />
                            <span class="x-small text-muted">حسب التوقيت المحلي للجهاز</span>
                        </div>

                        <!-- Duration in Days -->
                        <div class="col-6 col-md-4">
                            <label class="form-label small fw-bold">مدة الحملة (بالأيام)</label>
                            <input type="number" class="form-control rounded-pill" @bind="currentForm.DurationDays" placeholder="مثلاً: 14" min="1" max="365" />
                        </div>

                        <!-- Start Date -->
                        <div class="col-6 col-md-6">
                            <label class="form-label small fw-bold">تاريخ البداية</label>
                            <input type="date" class="form-control rounded-pill" @bind="startDateVal" />
                        </div>

                        <!-- End Date -->
                        <div class="col-6 col-md-6">
                            <label class="form-label small fw-bold">تاريخ النهاية (اختياري)</label>
                            <input type="date" class="form-control rounded-pill" @bind="endDateVal" />
                        </div>

                        <!-- Display & Audience -->
                        <div class="col-12">
                            <div class="border-top pt-3 mt-2">
                                <h6 class="fw-bold text-dark small mb-3"><i class="fa-solid fa-sliders me-1 text-primary"></i>طريقة العرض والجمهور المستهدف</h6>
                            </div>
                        </div>

                        <!-- Display Type -->
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-bold">طريقة العرض</label>
                            <select class="form-select rounded-pill" @bind="currentForm.DisplayType">
                                <option value="@ReminderDisplayType.NotificationBar">إشعار محلي بشريط النظام</option>
                                <option value="@ReminderDisplayType.InAppBanner">شريط تنبيهي داخل التطبيق</option>
                                <option value="@ReminderDisplayType.InAppDialog">نافذة حوارية منبثقة</option>
                                <option value="@ReminderDisplayType.TaskReminder">تذكير بمهمة محددة</option>
                            </select>
                        </div>

                        <!-- Target Audience -->
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-bold">الجمهور المستهدف</label>
                            <select class="form-select rounded-pill" @bind="currentForm.TargetAudience">
                                <option value="@ReminderTargetAudience.Testers">مختبرو التطبيق (Google Play)</option>
                                <option value="@ReminderTargetAudience.AllUsers">جميع المستخدمين</option>
                                <option value="@ReminderTargetAudience.Clients">العملاء والباحثون عن خدمات</option>
                                <option value="@ReminderTargetAudience.Providers">مقدمو الخدمات فقط</option>
                            </select>
                        </div>

                        <!-- Action Route Selection (App Screen / Service / Custom Link) -->
                        <div class="col-12">
                            <div class="p-3 bg-light rounded-3 border">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <label class="form-label small fw-bold mb-0">
                                        <i class="fa-solid fa-location-arrow text-primary me-1"></i>وجهة الضغط (عند النقر على التذكير)
                                    </label>
                                    @if (!string.IsNullOrWhiteSpace(currentForm.ActionRoute))
                                    {
                                        <span class="badge bg-primary-subtle text-primary border px-2 py-1 small" dir="ltr">
                                            @currentForm.ActionRoute
                                        </span>
                                    }
                                </div>

                                <div class="btn-group w-100 mb-2 shadow-sm rounded-pill overflow-hidden" role="group">
                                    <input type="radio" class="btn-check" name="reminderDestType" id="remDestScreen" @onclick='() => SetReminderDestMode("Screen")' checked="@(reminderDestMode == "Screen")">
                                    <label class="btn btn-outline-primary btn-sm" for="remDestScreen">
                                        <i class="fa-solid fa-mobile-screen me-1"></i>شاشة من التطبيق
                                    </label>

                                    <input type="radio" class="btn-check" name="reminderDestType" id="remDestService" @onclick='() => SetReminderDestMode("Service")' checked="@(reminderDestMode == "Service")">
                                    <label class="btn btn-outline-primary btn-sm" for="remDestService">
                                        <i class="fa-solid fa-briefcase me-1"></i>صفحة خدمة معينة
                                    </label>

                                    <input type="radio" class="btn-check" name="reminderDestType" id="remDestCustom" @onclick='() => SetReminderDestMode("Custom")' checked="@(reminderDestMode == "Custom")">
                                    <label class="btn btn-outline-primary btn-sm" for="remDestCustom">
                                        <i class="fa-solid fa-link me-1"></i>مسار مخصص
                                    </label>
                                </div>

                                @if (reminderDestMode == "Screen")
                                {
                                    <div>
                                        <select class="form-select rounded-pill small" value="@selectedReminderScreen" @onchange="OnReminderScreenChanged">
                                            <option value="/">الصفحة الرئيسية (/)</option>
                                            <option value="/marketplace">سوق المستعمل والمنتجات (/marketplace)</option>
                                            <option value="/services">تصفح الخدمات (/services)</option>
                                            <option value="/search">صفحة البحث والاستكشاف (/search)</option>
                                            <option value="/categories">الأقسام والتصنيفات (/categories)</option>
                                            <option value="/feed">المنشورات والتحديثات (/feed)</option>
                                            <option value="/profile">الملف الشخصي والحساب (/profile)</option>
                                            <option value="/user/my-requests">طلباتي (/user/my-requests)</option>
                                            <option value="/messages">الرسائل والمحادثات (/messages)</option>
                                            <option value="/favorites">المفضلة (/favorites)</option>
                                            <option value="/register-provider">التسجيل كمقدم خدمة (/register-provider)</option>
                                            <option value="/provider/dashboard">لوحة تحكم مقدم الخدمة (/provider/dashboard)</option>
                                            <option value="/provider/create-service">إضافة خدمة جديدة (/provider/create-service)</option>
                                            <option value="/notifications">مركز التنبيهات (/notifications)</option>
                                            <option value="/contact">تواصل معنا والدعم (/contact)</option>
                                            <option value="/terms">الشروط والأحكام (/terms)</option>
                                            <option value="/privacy">سياسة الخصوصية (/privacy)</option>
                                        </select>
                                    </div>
                                }
                                else if (reminderDestMode == "Service")
                                {
                                    <div>
                                        <div class="row g-2 mb-2">
                                            <div class="col-8">
                                                <select class="form-select rounded-pill small" value="@selectedReminderServiceId" @onchange="OnReminderServiceChanged">
                                                    <option value="">-- اختر الخدمة --</option>
                                                    @foreach (var s in servicesList)
                                                    {
                                                        <option value="@s.Id">#@s.Id - @s.Title (@s.ProviderName)</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-4">
                                                <input type="number" class="form-control rounded-pill small" value="@selectedReminderServiceId" @oninput="OnReminderServiceIdInput" placeholder="رقم ID" />
                                            </div>
                                        </div>

                                        @if (selectedReminderService != null)
                                        {
                                            <div class="p-2 rounded bg-white border small d-flex justify-content-between align-items-center">
                                                <div>
                                                    <strong class="text-primary">@selectedReminderService.Title</strong>
                                                    <div class="text-muted x-small">@selectedReminderService.ProviderName • @selectedReminderService.Address</div>
                                                </div>
                                                <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-2" @onclick="AutoFillReminderFromService" title="نسخ اسم ووصف الخدمة في عنوان ونص التذكير">
                                                    <i class="fa-solid fa-magic me-1"></i> نسخ للبيانات
                                                </button>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div>
                                        <input type="text" class="form-control rounded-pill small" @bind="currentForm.ActionRoute" placeholder="اكتب المسار المطلوب، مثلاً: /service/123 أو /feed" />
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Priority & Status -->
                        <div class="col-6 col-md-6">
                            <label class="form-label small fw-bold">أولوية التذكير</label>
                            <select class="form-select rounded-pill" @bind="currentForm.Priority">
                                <option value="@ReminderPriority.Normal">عادية</option>
                                <option value="@ReminderPriority.Low">منخفضة</option>
                                <option value="@ReminderPriority.High">مرتفعة</option>
                                <option value="@ReminderPriority.Urgent">عاجلة</option>
                            </select>
                        </div>

                        <div class="col-6 col-md-6">
                            <label class="form-label small fw-bold">الحالة الأولية</label>
                            <select class="form-select rounded-pill" @bind="currentForm.Status">
                                <option value="@ReminderStatus.Active">مفعّل فوراً</option>
                                <option value="@ReminderStatus.Draft">مسودة</option>
                                <option value="@ReminderStatus.Paused">متوقف مؤقتاً</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="modal-footer border-top pt-3 d-flex justify-content-between">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" @onclick="CloseEditModal">إلغاء</button>
                    <button type="button" class="btn btn-primary-premium rounded-pill px-4 shadow-sm" @onclick="SaveReminder" disabled="@isSaving">
                        @if (isSaving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        <i class="fa-solid fa-check me-1"></i>حفظ التغييرات
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ========================================== -->
<!-- Modal: Preview Reminder                    -->
<!-- ========================================== -->
@if (showPreviewModal && previewItem != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.6);" dir="rtl">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content glass-card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header border-bottom pb-2 bg-light">
                    <h6 class="modal-title fw-bold text-dark">
                        <i class="fa-solid fa-mobile-screen me-2 text-primary"></i>معاينة شكل التذكير على الهاتف
                    </h6>
                    <button type="button" class="btn-close ms-0 me-auto" @onclick='() => showPreviewModal = false'></button>
                </div>
                <div class="modal-body p-4 bg-dark bg-opacity-10 text-center">
                    <!-- Phone Frame Mockup -->
                    <div class="phone-mockup mx-auto p-3 rounded-4 shadow bg-white text-start text-rtl" style="max-width: 320px;">
                        <!-- Status Bar -->
                        <div class="d-flex justify-content-between align-items-center mb-3 text-muted x-small">
                            <span class="fw-bold">@previewItem.ScheduledTimeString</span>
                            <div>
                                <i class="fa-solid fa-wifi me-1"></i>
                                <i class="fa-solid fa-battery-full"></i>
                            </div>
                        </div>

                        @if (previewItem.DisplayType == ReminderDisplayType.NotificationBar)
                        {
                            <!-- Android Notification Shade Card -->
                            <div class="p-3 rounded-3 shadow-sm border bg-light text-dark mb-2">
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 22px; height: 22px; font-size: 11px;">
                                        <i class="fa-solid fa-handshake-angle"></i>
                                    </div>
                                    <span class="fw-bold small">خدماوى</span>
                                    <span class="text-muted x-small ms-auto">الآن</span>
                                </div>
                                <h6 class="fw-bold mb-1 fs-6">@previewItem.Title</h6>
                                <p class="text-secondary small mb-1">@previewItem.Message</p>
                                @if (!string.IsNullOrWhiteSpace(previewItem.ImageUrl))
                                {
                                    <div class="mt-2 rounded-2 overflow-hidden border">
                                        <img src="@previewItem.ImageUrl" alt="صورة الإشعار" style="width: 100%; max-height: 140px; object-fit: cover;" />
                                    </div>
                                }
                            </div>
                            <span class="text-muted x-small text-center d-block">عند الضغط، سيتم فتح: <strong>@previewItem.ActionRoute</strong></span>
                        }
                        else
                        {
                            <!-- In-App Dialog / Banner Mockup -->
                            <div class="p-3 rounded-3 shadow-sm border bg-white text-dark mb-2">
                                <div class="text-center mb-2">
                                    <i class="fa-solid fa-bell text-warning fs-3"></i>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(previewItem.ImageUrl))
                                {
                                    <div class="mb-2 rounded-2 overflow-hidden border">
                                        <img src="@previewItem.ImageUrl" alt="صورة الإشعار" style="width: 100%; max-height: 140px; object-fit: cover;" />
                                    </div>
                                }
                                <h6 class="fw-bold text-center mb-1">@previewItem.Title</h6>
                                <p class="text-muted small text-center mb-3">@previewItem.Message</p>
                                <button class="btn btn-primary-premium w-100 rounded-pill btn-sm">تصفح الآن</button>
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer border-top pt-2">
                    <button type="button" class="btn btn-secondary rounded-pill px-4 btn-sm" @onclick='() => showPreviewModal = false'>إغلاق</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal: Add/Edit Message Bank Item -->
@if (showBankItemModal && editingBankItem != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.6); z-index: 1060;" dir="rtl">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content glass-card border-0 shadow-lg rounded-4 p-3">
                <div class="modal-header border-bottom pb-2">
                    <h6 class="modal-title fw-bold text-primary">
                        <i class="fa-solid @(isEditingBankItem ? "fa-pen" : "fa-plus") me-2"></i>
                        @(isEditingBankItem ? "تعديل رسالة من بنك التنبيهات" : "إضافة رسالة جديدة لبنك التنبيهات")
                    </h6>
                    <button type="button" class="btn-close ms-0 me-auto" @onclick="() => showBankItemModal = false"></button>
                </div>
                <div class="modal-body py-3">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">عنوان الرسالة (اختياري)</label>
                        <input type="text" class="form-control form-control-sm rounded-pill" @bind="editingBankItem.Title" placeholder="اتركه فارغاً لاستخدام عنوان التذكير الرئيسي" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">نص الرسالة <span class="text-danger">*</span></label>
                        <textarea class="form-control rounded-3" rows="3" @bind="editingBankItem.Message" placeholder="اكتب نص هذه الرسالة..."></textarea>
                    </div>
                    @if (currentForm.MessageSelectionMode == "ScheduledBank" || currentForm.MessageSelectionMode == "Scheduled")
                    {
                        <div class="mb-3">
                            <label class="form-label small fw-bold">تاريخ ووقت الإرسال المحدد</label>
                            <input type="datetime-local" class="form-control form-control-sm rounded-pill" @bind="bankItemDateTimeVal" />
                            <span class="x-small text-muted">سيتم إرسال هذه الرسالة عندما يحين هذا الموعد.</span>
                        </div>
                    }
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label small fw-bold mb-0">صورة الرسالة (اختياري)</label>
                        </div>
                        <div class="p-2 mb-2 rounded-2 border bg-light x-small text-muted" style="border-right: 3px solid #0d6efd !important;">
                            <i class="fa-solid fa-circle-info text-primary me-1"></i>
                            <strong>شروط الصورة:</strong> يفضل أن تكون بالعرض (نسبة 2:1 مثل 1024×512) وحجمها أقل من 1 ميجابايت لتظهر كبانر عريض على شاشة الهاتف.
                        </div>
                        <div class="row g-2 align-items-center">
                            <div class="col-8">
                                <input type="text" class="form-control form-control-sm rounded-pill" @bind="editingBankItem.ImageUrl" placeholder="رابط الصورة https://..." />
                            </div>
                            <div class="col-4">
                                <label class="btn btn-outline-primary btn-sm w-100 rounded-pill mb-0" style="cursor: pointer;">
                                    <i class="fa-solid fa-cloud-arrow-up me-1"></i>رفع صورة
                                    <InputFile OnChange="HandleBankItemImageUpload" accept="image/*" class="d-none" />
                                </label>
                            </div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(editingBankItem.ImageUrl))
                        {
                            <div class="mt-2 rounded-3 overflow-hidden border text-center p-1 bg-light">
                                <img src="@editingBankItem.ImageUrl" alt="" style="max-height: 100px; max-width: 100%; object-fit: contain;" />
                            </div>
                        }
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-bold">وجهة النقر (اختياري)</label>
                        <input type="text" class="form-control form-control-sm rounded-pill" @bind="editingBankItem.ActionRoute" placeholder="مثال: / أو /services أو /service/123" />
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-3 btn-sm" @onclick="() => showBankItemModal = false">إلغاء</button>
                    <button type="button" class="btn btn-primary rounded-pill px-4 btn-sm fw-bold" @onclick="SaveBankItem">حفظ في البنك</button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .reminders-page-wrapper {
        animation: fadeIn 0.3s ease-in-out;
    }
    .x-small {
        font-size: 0.75rem;
    }
    .phone-mockup {
        border: 2px solid #e2e8f0;
    }
    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(6px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>

@code {
    private List<ReminderCampaignDto> reminders = new();
    private ReminderFilterDto filter = new();
    private bool isLoading = true;
    private bool isSaving = false;
    private string statusMessage = "";
    private bool isSuccess = true;

    // Message Bank State
    private bool showBankItemModal = false;
    private bool isEditingBankItem = false;
    private ReminderMessageBankItemDto? editingBankItem;
    private DateTime bankItemDateTimeVal = DateTime.Now;

    private void OpenAddBankItemModal()
    {
        isEditingBankItem = false;
        editingBankItem = new ReminderMessageBankItemDto
        {
            Id = Guid.NewGuid().ToString("N"),
            Title = currentForm.Title,
            ActionRoute = currentForm.ActionRoute,
            ScheduledDateTime = DateTime.Now.AddDays(1)
        };
        bankItemDateTimeVal = DateTime.Now.AddDays(1);
        showBankItemModal = true;
    }

    private void OpenEditBankItemModal(ReminderMessageBankItemDto item)
    {
        isEditingBankItem = true;
        editingBankItem = new ReminderMessageBankItemDto
        {
            Id = item.Id,
            Title = item.Title,
            Message = item.Message,
            ImageUrl = item.ImageUrl,
            ActionRoute = item.ActionRoute,
            ScheduledDateTime = item.ScheduledDateTime,
            IsSent = item.IsSent,
            SentAt = item.SentAt,
            SendCount = item.SendCount
        };
        bankItemDateTimeVal = item.ScheduledDateTime ?? DateTime.Now;
        showBankItemModal = true;
    }

    private void SaveBankItem()
    {
        if (editingBankItem == null || string.IsNullOrWhiteSpace(editingBankItem.Message)) return;

        if (currentForm.MessageSelectionMode == "ScheduledBank" || currentForm.MessageSelectionMode == "Scheduled")
        {
            editingBankItem.ScheduledDateTime = bankItemDateTimeVal;
        }

        if (isEditingBankItem)
        {
            var idx = currentForm.MessageBankItems.FindIndex(b => b.Id == editingBankItem.Id);
            if (idx >= 0)
            {
                currentForm.MessageBankItems[idx] = editingBankItem;
            }
        }
        else
        {
            currentForm.MessageBankItems.Add(editingBankItem);
        }

        showBankItemModal = false;
    }

    private void DeleteBankItem(string id)
    {
        currentForm.MessageBankItems.RemoveAll(b => b.Id == id);
    }

    private async Task HandleBankItemImageUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null || editingBankItem == null) return;

        if (file.Size > 1.5 * 1024 * 1024)
        {
            var proceed = await JS.InvokeAsync<bool>("confirm", "حجم الصورة المحددة أكبر من 1.5 ميجابايت، ويشترط أندرويد أن يكون حجم الصورة خفيفاً (أقل من 1 ميجابايت) ليتم عرضها فوراً على شاشات هواتف المستخدمين. هل تريد المتابعة برفعها؟");
            if (!proceed) return;
        }
        try
        {
            var res = await Api.UploadImageAsync(file, Khadamat.BlazorUI.Helpers.EntityImageType.Ad);
            if (res != null && !string.IsNullOrWhiteSpace(res.Url))
            {
                var fullUrl = res.Url.StartsWith("http", StringComparison.OrdinalIgnoreCase) 
                    ? res.Url 
                    : Navigation.ToAbsoluteUri(res.Url).ToString();
                editingBankItem.ImageUrl = fullUrl;
            }
        }
        catch {}
    }

    private string selectedStatusString = "";
    private string selectedAudienceString = "";

    // Edit modal state
    private bool showEditModal = false;
    private bool isEditing = false;
    private int currentEditingId = 0;
    private CreateReminderCampaignDto currentForm = new();
    private TimeOnly scheduledTimeVal = new(20, 0);
    private DateTime startDateVal = DateTime.UtcNow.Date;
    private DateTime? endDateVal = DateTime.UtcNow.Date.AddDays(14);

    // Destination Selection
    private string reminderDestMode = "Screen";
    private string selectedReminderScreen = "/";
    private string selectedReminderServiceId = "";
    private ServiceDto? selectedReminderService;
    private List<ServiceDto> servicesList = new();

    // Preview modal state
    private bool showPreviewModal = false;
    private ReminderCampaignDto? previewItem;

    // Image upload state
    private bool isUploadingReminderImage = false;
    private bool reminderImageLoadFailed = false;

    private void ClearReminderImage()
    {
        currentForm.ImageUrl = null;
        reminderImageLoadFailed = false;
    }

    private void OnReminderImageLoadError()
    {
        reminderImageLoadFailed = true;
    }

    private async Task HandleReminderImageUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        if (file.Size > 1.5 * 1024 * 1024)
        {
            var proceed = await JS.InvokeAsync<bool>("confirm", "حجم الصورة المحددة أكبر من 1.5 ميجابايت، ويشترط أندرويد أن يكون حجم الصورة خفيفاً (أقل من 1 ميجابايت) ليتم عرضها فوراً على شاشات هواتف المستخدمين. هل تريد المتابعة برفعها؟");
            if (!proceed) return;
        }

        reminderImageLoadFailed = false;
        isUploadingReminderImage = true;
        try
        {
            var res = await Api.UploadImageAsync(file, Khadamat.BlazorUI.Helpers.EntityImageType.Ad);
            if (res != null && !string.IsNullOrWhiteSpace(res.Url))
            {
                var fullUrl = res.Url.StartsWith("http", StringComparison.OrdinalIgnoreCase) 
                    ? res.Url 
                    : Navigation.ToAbsoluteUri(res.Url).ToString();
                currentForm.ImageUrl = fullUrl;
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "فشل رفع الصورة، يرجى التأكد من صيغة الملف وحجمه.");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"خطأ أثناء الرفع: {ex.Message}");
        }
        finally
        {
            isUploadingReminderImage = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadReminders();
        try
        {
            var serv = await Api.GetServicesAsync(page: 1, pageSize: 100, isApproved: true);
            servicesList = serv?.Items?.ToList() ?? new();
        }
        catch { }
    }

    private void SetReminderDestMode(string mode)
    {
        reminderDestMode = mode;
        if (mode == "Screen")
        {
            currentForm.ActionRoute = selectedReminderScreen;
        }
        else if (mode == "Service")
        {
            if (int.TryParse(selectedReminderServiceId, out int sid) && sid > 0)
            {
                currentForm.ActionRoute = $"/service/{sid}";
            }
            else
            {
                currentForm.ActionRoute = "";
            }
        }
    }

    private void OnReminderScreenChanged(ChangeEventArgs e)
    {
        selectedReminderScreen = e.Value?.ToString() ?? "/";
        currentForm.ActionRoute = selectedReminderScreen;
    }

    private void OnReminderServiceChanged(ChangeEventArgs e)
    {
        selectedReminderServiceId = e.Value?.ToString() ?? "";
        if (int.TryParse(selectedReminderServiceId, out int sid) && sid > 0)
        {
            selectedReminderService = servicesList.FirstOrDefault(s => s.Id == sid);
            currentForm.ActionRoute = $"/service/{sid}";
        }
        else
        {
            selectedReminderService = null;
            currentForm.ActionRoute = "";
        }
    }

    private void OnReminderServiceIdInput(ChangeEventArgs e)
    {
        selectedReminderServiceId = e.Value?.ToString() ?? "";
        if (int.TryParse(selectedReminderServiceId, out int sid) && sid > 0)
        {
            selectedReminderService = servicesList.FirstOrDefault(s => s.Id == sid);
            currentForm.ActionRoute = $"/service/{sid}";
        }
        else
        {
            selectedReminderService = null;
            currentForm.ActionRoute = "";
        }
    }

    private void AutoFillReminderFromService()
    {
        if (selectedReminderService == null) return;
        currentForm.Title = $"خدمة مميزة: {selectedReminderService.Title} ✨";
        currentForm.Message = !string.IsNullOrWhiteSpace(selectedReminderService.Description)
            ? (selectedReminderService.Description.Length > 150 ? selectedReminderService.Description[..150] + "..." : selectedReminderService.Description)
            : $"تصفح تفاصيل خدمة {selectedReminderService.Title} الآن على منصة خدماوى!";

        if (selectedReminderService.Images != null && selectedReminderService.Images.Count > 0)
        {
            var firstImg = selectedReminderService.Images.First();
            var imgRel = Khadamat.BlazorUI.Helpers.ImagePathResolver.Service(firstImg);
            currentForm.ImageUrl = Navigation.ToAbsoluteUri(imgRel).ToString();
            reminderImageLoadFailed = false;
        }
    }

    private async Task LoadReminders()
    {
        isLoading = true;
        try
        {
            reminders = await Api.GetRemindersAsync(filter);
        }
        catch (Exception ex)
        {
            statusMessage = $"حدث خطأ أثناء تحميل التذكيرات: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleSearch()
    {
        await LoadReminders();
    }

    private async Task ApplyFilter()
    {
        filter.Status = string.IsNullOrEmpty(selectedStatusString) 
            ? null 
            : Enum.Parse<ReminderStatus>(selectedStatusString);

        filter.TargetAudience = string.IsNullOrEmpty(selectedAudienceString)
            ? null
            : Enum.Parse<ReminderTargetAudience>(selectedAudienceString);

        await LoadReminders();
    }

    private async Task ResetFilters()
    {
        filter = new ReminderFilterDto();
        selectedStatusString = "";
        selectedAudienceString = "";
        await LoadReminders();
    }

    private void OpenCreateModal()
    {
        isEditing = false;
        currentEditingId = 0;
        reminderDestMode = "Screen";
        selectedReminderScreen = "/";
        selectedReminderServiceId = "";
        selectedReminderService = null;

        currentForm = new CreateReminderCampaignDto
        {
            Title = "",
            InternalDescription = "",
            Message = "",
            Language = "ar",
            Status = ReminderStatus.Active,
            RecurrenceType = ReminderRecurrenceType.Daily,
            ScheduledTime = new TimeSpan(20, 0, 0),
            DurationDays = 14,
            StartDate = DateTime.UtcNow.Date,
            EndDate = DateTime.UtcNow.Date.AddDays(14),
            Priority = ReminderPriority.Normal,
            TargetAudience = ReminderTargetAudience.Testers,
            DisplayType = ReminderDisplayType.NotificationBar,
            ActionRoute = "/",
            ImageUrl = null,
            DeliveryChannel = "Both",
            MessageSelectionMode = "Single",
            MessageBankItems = new(),
            IsActive = true
        };
        reminderImageLoadFailed = false;
        scheduledTimeVal = new(20, 0);
        startDateVal = DateTime.UtcNow.Date;
        endDateVal = DateTime.UtcNow.Date.AddDays(14);
        showEditModal = true;
    }

    private void OpenEditModal(ReminderCampaignDto rem)
    {
        isEditing = true;
        currentEditingId = rem.Id;

        // Determine destination mode
        if (!string.IsNullOrEmpty(rem.ActionRoute) && rem.ActionRoute.StartsWith("/service/"))
        {
            reminderDestMode = "Service";
            var idPart = rem.ActionRoute.Replace("/service/", "").Trim();
            selectedReminderServiceId = idPart;
            if (int.TryParse(idPart, out int sid))
            {
                selectedReminderService = servicesList.FirstOrDefault(s => s.Id == sid);
            }
        }
        else
        {
            var knownScreens = new HashSet<string> { "/", "/marketplace", "/services", "/search", "/categories", "/feed", "/profile", "/user/my-requests", "/messages", "/favorites", "/register-provider", "/provider/dashboard", "/provider/create-service", "/notifications", "/contact", "/terms", "/privacy" };
            if (knownScreens.Contains(rem.ActionRoute))
            {
                reminderDestMode = "Screen";
                selectedReminderScreen = rem.ActionRoute;
            }
            else
            {
                reminderDestMode = "Custom";
            }
        }

        currentForm = new CreateReminderCampaignDto
        {
            Title = rem.Title,
            InternalDescription = rem.InternalDescription,
            Message = rem.Message,
            Language = rem.Language,
            Status = rem.Status,
            RecurrenceType = rem.RecurrenceType,
            ScheduledTime = rem.ScheduledTime,
            IntervalValue = rem.IntervalValue,
            DaysOfWeek = rem.DaysOfWeek,
            DurationDays = rem.DurationDays,
            MaxOccurrences = rem.MaxOccurrences,
            TimeZoneId = rem.TimeZoneId,
            Priority = rem.Priority,
            TargetAudience = rem.TargetAudience,
            TargetRole = rem.TargetRole,
            DisplayType = rem.DisplayType,
            ActionRoute = rem.ActionRoute,
            ImageUrl = rem.ImageUrl,
            DeliveryChannel = rem.DeliveryChannel ?? "Both",
            MessageSelectionMode = rem.MessageSelectionMode ?? "Single",
            MessageBankItems = rem.MessageBankItems != null ? new List<ReminderMessageBankItemDto>(rem.MessageBankItems) : new(),
            IsActive = rem.IsActive,
            StartDate = rem.StartDate,
            EndDate = rem.EndDate
        };
        reminderImageLoadFailed = false;
        scheduledTimeVal = TimeOnly.FromTimeSpan(rem.ScheduledTime);
        startDateVal = rem.StartDate.Date;
        endDateVal = rem.EndDate?.Date;
        showEditModal = true;
    }

    private void CloseEditModal()
    {
        showEditModal = false;
    }

    private async Task SaveReminder()
    {
        if (string.IsNullOrWhiteSpace(currentForm.Title) || string.IsNullOrWhiteSpace(currentForm.Message))
        {
            await JS.InvokeVoidAsync("alert", "يرجى ملء عنوان التذكير ونص الرسالة");
            return;
        }

        currentForm.ScheduledTime = scheduledTimeVal.ToTimeSpan();
        currentForm.StartDate = startDateVal;
        currentForm.EndDate = endDateVal;

        isSaving = true;
        try
        {
            if (isEditing)
            {
                var updateDto = new UpdateReminderCampaignDto
                {
                    Id = currentEditingId,
                    Title = currentForm.Title,
                    InternalDescription = currentForm.InternalDescription,
                    Message = currentForm.Message,
                    Language = currentForm.Language,
                    Status = currentForm.Status,
                    StartDate = currentForm.StartDate,
                    EndDate = currentForm.EndDate,
                    RecurrenceType = currentForm.RecurrenceType,
                    ScheduledTime = currentForm.ScheduledTime,
                    IntervalValue = currentForm.IntervalValue,
                    DaysOfWeek = currentForm.DaysOfWeek,
                    DurationDays = currentForm.DurationDays,
                    MaxOccurrences = currentForm.MaxOccurrences,
                    TimeZoneId = currentForm.TimeZoneId,
                    Priority = currentForm.Priority,
                    TargetAudience = currentForm.TargetAudience,
                    TargetRole = currentForm.TargetRole,
                    DisplayType = currentForm.DisplayType,
                    ActionRoute = currentForm.ActionRoute,
                    ImageUrl = currentForm.ImageUrl,
                    DeliveryChannel = currentForm.DeliveryChannel,
                    MessageSelectionMode = currentForm.MessageSelectionMode,
                    MessageBankItems = currentForm.MessageBankItems,
                    IsActive = (currentForm.Status == ReminderStatus.Active)
                };
                var result = await Api.UpdateReminderAsync(currentEditingId, updateDto);
                if (result != null)
                {
                    statusMessage = "تم حفظ تعديلات التذكير بنجاح وسيتم تحديث الجدولة على الأجهزة تلقائياً.";
                    isSuccess = true;
                }
            }
            else
            {
                var result = await Api.CreateReminderAsync(currentForm);
                if (result != null)
                {
                    statusMessage = "تم إنشاء التذكير الجديد بنجاح.";
                    isSuccess = true;
                }
            }

            showEditModal = false;
            await LoadReminders();
        }
        catch (Exception ex)
        {
            statusMessage = $"حدث خطأ أثناء الحفظ: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ToggleStatus(int id, ReminderStatus newStatus)
    {
        var ok = await Api.UpdateReminderStatusAsync(id, newStatus);
        if (ok)
        {
            statusMessage = $"تم تغيير حالة التذكير بنجاح.";
            isSuccess = true;
            await LoadReminders();
        }
    }

    private async Task DuplicateReminder(int id)
    {
        var clone = await Api.DuplicateReminderAsync(id);
        if (clone != null)
        {
            statusMessage = $"تم إنشاء نسخة مسودة من التذكير بنجاح.";
            isSuccess = true;
            await LoadReminders();
        }
    }

    private async Task DeleteReminder(int id)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", "هل أنت متأكد من حذف هذا التذكير؟");
        if (!confirmed) return;

        var ok = await Api.DeleteReminderAsync(id);
        if (ok)
        {
            statusMessage = "تم حذف التذكير بنجاح.";
            isSuccess = true;
            await LoadReminders();
        }
    }

    private async Task LoadDefaultTesterTemplate()
    {
        try
        {
            var res = await Api.SeedDefaultTesterReminderAsync();
            if (res != null)
            {
                statusMessage = "تم تفعيل / التأكد من جاهزية حملة تذكير المختبرين بالاستخدام اليومي (14 يوماً).";
                isSuccess = true;
                await LoadReminders();
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"خطأ: {ex.Message}";
            isSuccess = false;
        }
    }

    private async Task TestTriggerReminder(ReminderCampaignDto rem)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", $"هل تريد تشغيل وإرسال تذكير '{rem.Title}' فوراً الآن لجميع الفئات المستهدفة للتأكد من وصوله؟");
        if (!confirmed) return;

        isLoading = true;
        try
        {
            var (success, msg) = await Api.TriggerReminderNowAsync(rem.Id);
            statusMessage = msg;
            isSuccess = success;
            await LoadReminders();
        }
        catch (Exception ex)
        {
            statusMessage = $"حدث خطأ: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task TestFcmBroadcast()
    {
        isLoading = true;
        try
        {
            var (success, msg) = await Api.TestFcmPushAsync("اختبار إشعارات خدماوى", "تم تسليم هذا الإشعار الفوري بنجاح إلى هاتفك!");
            statusMessage = msg;
            isSuccess = success;
        }
        catch (Exception ex)
        {
            statusMessage = $"خطأ: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenPreviewModal(ReminderCampaignDto rem)
    {
        previewItem = rem;
        showPreviewModal = true;
    }

    private string GetStatusBadgeClass(ReminderStatus status) => status switch
    {
        ReminderStatus.Active => "bg-success text-white",
        ReminderStatus.Paused => "bg-warning text-dark",
        ReminderStatus.Draft => "bg-secondary text-white",
        ReminderStatus.Expired => "bg-dark text-white",
        _ => "bg-light text-dark"
    };
}
