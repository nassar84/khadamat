@page "/admin/reminders"
@attribute [Authorize(Roles = "SuperAdmin,SystemAdmin")]
@using Khadamat.Application.DTOs
@using Khadamat.Domain.Enums
@using Khadamat.BlazorUI.Services
@inject ApiClient Api
@inject IJSRuntime JS
@inject NavigationManager Navigation

<div class="px-2 pb-5 reminders-page-wrapper" dir="rtl">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-start align-items-md-center mb-3 flex-wrap gap-2 mt-2">
        <div>
            <h1 class="fw-bold mb-1 text-primary fs-4">
                <i class="fa-solid fa-bell me-2"></i>إدارة التذكيرات وبنك الإشعارات
            </h1>
            <p class="text-muted small mb-0">تحكم كامل في مواعيد ونصوص وبنك التذكيرات المخزنة وحملات الاختبار للمستخدمين</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            @if (activeTab == "campaigns")
            {
                <button class="btn btn-outline-info rounded-pill px-3 shadow-sm btn-sm" @onclick='() => Navigation.NavigateTo("/admin/send-notification")' title="إرسال إشعار فوري لجميع المستخدمين أو فئة معينة">
                    <i class="fa-solid fa-paper-plane me-1"></i>إرسال تنبيه فوري
                </button>
                <button class="btn btn-outline-warning rounded-pill px-3 shadow-sm btn-sm" @onclick="TestFcmBroadcast" title="إرسال إشعار فوري لجميع الأجهزة النشطة عبر Firebase">
                    <i class="fa-solid fa-satellite-dish me-1"></i>اختبار Firebase FCM
                </button>
                <button class="btn btn-outline-primary rounded-pill px-3 shadow-sm btn-sm" @onclick="LoadDefaultTesterTemplate" title="إنشاء أو استعادة حملة اختبار Google Play">
                    <i class="fa-brands fa-google-play me-1 text-success"></i>حملة الـ 14 يوماً للمختبرين
                </button>
                <button class="btn btn-primary-premium rounded-pill px-4 shadow-sm btn-sm" @onclick="OpenCreateModal">
                    <i class="fa-solid fa-plus me-1"></i>تذكير مجدول جديد
                </button>
            }
            else
            {
                <button class="btn btn-primary-premium rounded-pill px-4 shadow-sm btn-sm" @onclick="OpenCreateMasterBankModal">
                    <i class="fa-solid fa-plus me-1"></i>إضافة رسالة لبنك التذكيرات
                </button>
            }
        </div>
    </div>

    <!-- Alert / Status Message -->
    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert @(isSuccess ? "alert-success" : "alert-danger") rounded-4 shadow-sm mb-3 d-flex align-items-center justify-content-between animate-fade-in" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="fa-solid @(isSuccess ? "fa-circle-check text-success" : "fa-circle-exclamation text-danger") fs-5"></i>
                <span class="fw-bold">@statusMessage</span>
            </div>
            <button type="button" class="btn-close" @onclick='() => statusMessage = ""'></button>
        </div>
    }

    <!-- Tabs: Campaigns vs Bank -->
    <ul class="nav nav-pills gap-2 mb-4 bg-light p-1.5 rounded-pill shadow-xs border" style="width: fit-content;">
        <li class="nav-item">
            <button class="nav-link rounded-pill px-4 py-2 fw-bold @(activeTab == "campaigns" ? "active shadow-sm" : "text-secondary")" @onclick='() => SwitchTab("campaigns")'>
                <i class="fa-solid fa-clock-rotate-left me-2"></i>الحملات والتذكيرات المجدولة
                <span class="badge @(activeTab == "campaigns" ? "bg-white text-primary" : "bg-secondary text-white") rounded-pill ms-2">@reminders.Count</span>
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link rounded-pill px-4 py-2 fw-bold @(activeTab == "bank" ? "active shadow-sm" : "text-secondary")" @onclick='() => SwitchTab("bank")'>
                <i class="fa-solid fa-vault me-2"></i>بنك التنبيهات والتذكيرات المخزنة
                <span class="badge @(activeTab == "bank" ? "bg-white text-primary" : "bg-primary text-white") rounded-pill ms-2">@bankItems.Count</span>
            </button>
        </li>
    </ul>

    <!-- ======================================================== -->
    <!-- TAB 1: CAMPAIGNS                                          -->
    <!-- ======================================================== -->
    @if (activeTab == "campaigns")
    {
        <!-- Quick Stats Cards -->
        <div class="row g-3 mb-4">
            <div class="col-6 col-md-3">
                <div class="glass-card p-3 text-center border-start border-primary border-4">
                    <span class="text-muted small d-block mb-1">إجمالي التذكيرات</span>
                    <h3 class="fw-bold mb-0 text-primary">@reminders.Count</h3>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="glass-card p-3 text-center border-start border-success border-4">
                    <span class="text-muted small d-block mb-1">المفعلة حالياً</span>
                    <h3 class="fw-bold mb-0 text-success">@reminders.Count(r => r.Status == ReminderStatus.Active)</h3>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="glass-card p-3 text-center border-start border-warning border-4">
                    <span class="text-muted small d-block mb-1">متوقفة مؤقتاً</span>
                    <h3 class="fw-bold mb-0 text-warning">@reminders.Count(r => r.Status == ReminderStatus.Paused)</h3>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="glass-card p-3 text-center border-start border-secondary border-4">
                    <span class="text-muted small d-block mb-1">المسودات والمنتهية</span>
                    <h3 class="fw-bold mb-0 text-muted">@reminders.Count(r => r.Status == ReminderStatus.Draft || r.Status == ReminderStatus.Expired)</h3>
                </div>
            </div>
        </div>

        <!-- Filters Bar -->
        <div class="glass-card p-3 mb-4">
            <div class="row g-2 align-items-center">
                <div class="col-12 col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-end-0"><i class="fa-solid fa-search text-muted"></i></span>
                        <input type="text" class="form-control border-start-0 ps-0" placeholder="بحث بالاسم أو نص الرسالة..." 
                               @bind="filter.SearchTerm" @bind:event="oninput" @onkeyup="HandleSearch" />
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <select class="form-select" @bind="selectedStatusString" @bind:after="ApplyFilter">
                        <option value="">جميع الحالات</option>
                        <option value="Active">مفعّل</option>
                        <option value="Paused">متوقف مؤقتاً</option>
                        <option value="Draft">مسودة</option>
                        <option value="Expired">منتهي</option>
                    </select>
                </div>
                <div class="col-6 col-md-3">
                    <select class="form-select" @bind="selectedAudienceString" @bind:after="ApplyFilter">
                        <option value="">جميع الفئات</option>
                        <option value="Testers">مختبرو التطبيق</option>
                        <option value="AllUsers">جميع المستخدمين</option>
                        <option value="Clients">العملاء</option>
                        <option value="Providers">مقدمو الخدمات</option>
                    </select>
                </div>
                <div class="col-12 col-md-3 text-md-start">
                    <button class="btn btn-outline-secondary w-100 rounded-pill" @onclick="ResetFilters">
                        <i class="fa-solid fa-rotate-left me-1"></i>إعادة تعيين
                    </button>
                </div>
            </div>
        </div>

        <!-- List of Reminders -->
        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="mt-2 text-muted">جاري تحميل التذكيرات...</p>
            </div>
        }
        else if (!reminders.Any())
        {
            <div class="glass-card p-5 text-center">
                <div class="mb-3">
                    <i class="fa-regular fa-bell-slash fs-1 text-muted"></i>
                </div>
                <h5 class="fw-bold">لا توجد تذكيرات مطابقة</h5>
                <p class="text-muted small">يمكنك إضافة تذكير جديد أو تفعيل نموذج حملة مختبري Google Play بنقرة واحدة.</p>
                <div class="d-flex justify-content-center gap-2 mt-3">
                    <button class="btn btn-primary-premium rounded-pill px-4 btn-sm" @onclick="LoadDefaultTesterTemplate">
                        <i class="fa-brands fa-google-play me-1"></i>تفعيل حملة المختبرين الافتراضية
                    </button>
                    <button class="btn btn-outline-primary rounded-pill px-4 btn-sm" @onclick="OpenCreateModal">
                        <i class="fa-solid fa-plus me-1"></i>إنشاء تذكير جديد
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var rem in reminders)
                {
                    <div class="col-12 col-lg-6" key="@rem.Id">
                        <div class="glass-card p-3 h-100 d-flex flex-column border @(rem.Status == ReminderStatus.Active ? "border-success-subtle" : "border-light") shadow-sm">
                            <!-- Top Row: Title, Badges, Dropdown -->
                            <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                <div>
                                    <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                                        <h5 class="fw-bold mb-0 fs-6 text-dark">@rem.Title</h5>
                                        <span class="badge @GetStatusBadgeClass(rem.Status) rounded-pill px-2 py-1 small">
                                            @rem.StatusText
                                        </span>
                                        <span class="badge bg-light text-dark border rounded-pill px-2 py-1 small">
                                            <i class="fa-solid fa-clock me-1 text-primary"></i>@rem.ScheduledTimeString
                                        </span>
                                        @if (rem.CampaignType == "Occasion" || rem.OverridesRegularReminders)
                                        {
                                            <span class="badge border rounded-pill px-2 py-1 small" style="background-color: #f3e8ff; color: #7e22ce;">
                                                <i class="fa-solid fa-wand-magic-sparkles me-1"></i>مناسبة: @(string.IsNullOrWhiteSpace(rem.OccasionName) ? "خاصة" : rem.OccasionName)
                                            </span>
                                            @if (rem.OverridesRegularReminders)
                                            {
                                                <span class="badge bg-warning-subtle text-warning-emphasis border rounded-pill px-2 py-1 small" title="تتجاوز الرسائل المعتادة أثناء المناسبة">
                                                    <i class="fa-solid fa-bolt me-1"></i>تتجاوز المعتادة
                                                </span>
                                            }
                                        }
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(rem.InternalDescription))
                                    {
                                        <span class="text-muted x-small d-block"><i class="fa-solid fa-tag me-1"></i>@rem.InternalDescription</span>
                                    }
                                </div>

                                <div class="d-flex gap-1">
                                    <button class="btn btn-sm btn-outline-secondary rounded-circle" title="معاينة التذكير" @onclick="() => OpenPreviewModal(rem)">
                                        <i class="fa-solid fa-eye"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-primary rounded-circle" title="تعديل" @onclick="() => OpenEditModal(rem)">
                                        <i class="fa-solid fa-pen"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-info rounded-circle" title="نسخ لإنشاء تذكير مشابه" @onclick="() => DuplicateReminder(rem.Id)">
                                        <i class="fa-solid fa-clone"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger rounded-circle" title="حذف" @onclick="() => DeleteReminder(rem.Id)">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(rem.ImageUrl))
                            {
                                <div class="mb-2 rounded-3 overflow-hidden border shadow-xs" style="max-height: 140px;">
                                    <img src="@rem.ImageUrl" alt="" style="width: 100%; height: 140px; object-fit: cover;" />
                                </div>
                            }

                            <!-- Message Body Preview -->
                            <div class="bg-light p-2 rounded-3 mb-3 border-start border-3 border-primary text-secondary small flex-grow-1">
                                @if (rem.MessageSelectionMode == "RandomBank")
                                {
                                    <span class="text-primary fw-bold d-block mb-1">
                                        <i class="fa-solid fa-shuffle me-1"></i>اختيار عشوائي من بنك التذكيرات @(!string.IsNullOrEmpty(rem.BankCategory) ? $"({rem.BankCategory})" : "")
                                    </span>
                                }
                                else if (rem.MessageSelectionMode == "SequentialBank")
                                {
                                    <span class="text-success fw-bold d-block mb-1">
                                        <i class="fa-solid fa-arrow-down-1-9 me-1"></i>تسلسلي بالترتيب من بنك التذكيرات @(!string.IsNullOrEmpty(rem.BankCategory) ? $"({rem.BankCategory})" : "")
                                    </span>
                                }
                                @rem.Message
                            </div>

                            <!-- Meta details badges -->
                            <div class="d-flex flex-wrap gap-2 text-muted x-small mb-3">
                                <span class="badge bg-light text-secondary border">
                                    <i class="fa-solid fa-repeat me-1 text-info"></i>@rem.RecurrenceTypeText
                                </span>
                                <span class="badge bg-light text-secondary border">
                                    <i class="fa-solid fa-users me-1 text-primary"></i>@rem.TargetAudienceText
                                </span>
                                <span class="badge bg-light text-secondary border">
                                    <i class="fa-solid fa-tv me-1 text-warning"></i>@rem.DisplayTypeText
                                </span>
                                <span class="badge bg-light text-secondary border">
                                    <i class="fa-solid fa-tower-broadcast me-1 text-info"></i>
                                    @(rem.DeliveryChannel switch {
                                        "PushOnly" => "شاشة الموبايل فقط",
                                        "InAppOnly" => "داخلي فقط",
                                        _ => "كلاهما (موبايل + داخلي)"
                                    })
                                </span>
                                @if (rem.MessageSelectionMode == "RandomBank")
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis border">
                                        <i class="fa-solid fa-vault me-1"></i>بنك عشوائي: @(rem.BankCategory ?? "الكل")
                                    </span>
                                }
                                else if (rem.MessageSelectionMode == "SequentialBank")
                                {
                                    <span class="badge bg-success-subtle text-success border">
                                        <i class="fa-solid fa-list-ol me-1"></i>بنك تسلسلي: @(rem.BankCategory ?? "الكل") (آخر ترتيب: #@rem.LastSequentialIndex)
                                    </span>
                                }
                                else if (rem.MessageSelectionMode == "ScheduledBank" || rem.MessageSelectionMode == "Scheduled")
                                {
                                    <span class="badge bg-info-subtle text-info border">
                                        <i class="fa-solid fa-calendar-check me-1"></i>بنك مجدول (@rem.MessageBankItems.Count)
                                    </span>
                                }
                                <span class="badge bg-light text-secondary border">
                                    <i class="fa-solid fa-location-arrow me-1 text-danger"></i>الوجهة: @rem.ActionRoute
                                </span>
                                @if (rem.DurationDays.HasValue)
                                {
                                    <span class="badge bg-light text-secondary border">
                                        <i class="fa-solid fa-hourglass-half me-1 text-success"></i>المدة: @rem.DurationDays يوم
                                    </span>
                                }
                            </div>

                            <!-- Footer: Dates & Quick Action buttons -->
                            <div class="d-flex justify-content-between align-items-center pt-2 border-top x-small mt-auto">
                                <span class="text-muted">
                                    <i class="fa-regular fa-calendar me-1"></i>من: @rem.StartDate.ToString("yyyy/MM/dd") 
                                    @(rem.EndDate.HasValue ? $"إلى: {rem.EndDate.Value:yyyy/MM/dd}" : "")
                                </span>

                                <div class="d-flex gap-1 align-items-center">
                                    <button class="btn btn-sm btn-outline-primary rounded-pill px-2 py-1 x-small fw-bold" @onclick="() => TestTriggerReminder(rem)" title="إرسال هذا التذكير فوراً للتجربة والتأكد من وصوله للهاتف والمركز">
                                        <i class="fa-solid fa-paper-plane me-1"></i>تجربة الآن
                                    </button>
                                    @if (rem.Status == ReminderStatus.Active)
                                    {
                                        <button class="btn btn-sm btn-outline-warning rounded-pill px-3 py-1 x-small" @onclick="() => ToggleStatus(rem.Id, ReminderStatus.Paused)">
                                            <i class="fa-solid fa-pause me-1"></i>إيقاف مؤقت
                                        </button>
                                    }
                                    else if (rem.Status == ReminderStatus.Paused || rem.Status == ReminderStatus.Draft)
                                    {
                                        <button class="btn btn-sm btn-outline-success rounded-pill px-3 py-1 x-small" @onclick="() => ToggleStatus(rem.Id, ReminderStatus.Active)">
                                            <i class="fa-solid fa-play me-1"></i>تفعيل
                                        </button>
                                    }
                                    @if (rem.Status != ReminderStatus.Expired)
                                    {
                                        <button class="btn btn-sm btn-outline-secondary rounded-pill px-2 py-1 x-small" @onclick="() => ToggleStatus(rem.Id, ReminderStatus.Expired)" title="إنهاء الحملة">
                                            <i class="fa-solid fa-stop me-1"></i>إنهاء
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
    <!-- ======================================================== -->
    <!-- TAB 2: REMINDER BANK (بنك التنبيهات والتذكيرات المخزنة)  -->
    <!-- ======================================================== -->
    else if (activeTab == "bank")
    {
        <!-- Bank Stats Row -->
        <div class="row g-3 mb-4">
            <div class="col-6 col-md-3">
                <div class="glass-card p-3 text-center border-start border-primary border-4">
                    <span class="text-muted small d-block mb-1">إجمالي رسائل البنك</span>
                    <h3 class="fw-bold mb-0 text-primary">@bankItems.Count</h3>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="glass-card p-3 text-center border-start border-info border-4">
                    <span class="text-muted small d-block mb-1">التصنيفات المتاحة</span>
                    <h3 class="fw-bold mb-0 text-info">@bankCategories.Count</h3>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="glass-card p-3 text-center border-start border-success border-4">
                    <span class="text-muted small d-block mb-1">الرسائل المفعلة</span>
                    <h3 class="fw-bold mb-0 text-success">@bankItems.Count(b => b.IsActive)</h3>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="glass-card p-3 text-center border-start border-warning border-4">
                    <span class="text-muted small d-block mb-1">إجمالي مرات الإرسال</span>
                    <h3 class="fw-bold mb-0 text-warning">@bankItems.Sum(b => b.UsageCount)</h3>
                </div>
            </div>
        </div>

        <!-- Filter Pills Bar & Search -->
        <div class="glass-card p-3 mb-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                <!-- Category Pills -->
                <div class="d-flex gap-1.5 flex-wrap">
                    <button class="btn btn-sm rounded-pill px-3 @(selectedBankCategory == "All" ? "btn-primary shadow-sm" : "btn-outline-secondary")" @onclick='() => SelectBankCategoryFilter("All")'>
                        الكل (@bankItems.Count)
                    </button>
                    @foreach (var cat in bankCategories)
                    {
                        var catCount = bankItems.Count(b => b.Category == cat);
                        <button class="btn btn-sm rounded-pill px-3 @(selectedBankCategory == cat ? "btn-primary shadow-sm" : "btn-outline-secondary")" @onclick="() => SelectBankCategoryFilter(cat)">
                            @cat (@catCount)
                        </button>
                    }
                </div>

                <button class="btn btn-primary-premium btn-sm rounded-pill px-3 shadow-sm" @onclick="OpenCreateMasterBankModal">
                    <i class="fa-solid fa-plus me-1"></i>إضافة رسالة جديدة للبنك
                </button>
            </div>

            <!-- Search input -->
            <div class="input-group">
                <span class="input-group-text bg-transparent border-end-0"><i class="fa-solid fa-search text-muted"></i></span>
                <input type="text" class="form-control border-start-0 ps-0" placeholder="بحث في رسائل البنك بالعنوان أو النص..." 
                       @bind="bankSearchTerm" @bind:event="oninput" />
                @if (!string.IsNullOrEmpty(bankSearchTerm))
                {
                    <button class="btn btn-outline-secondary border-start-0" @onclick='() => bankSearchTerm = ""'>
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                }
            </div>
        </div>

        <!-- Bank Items Grid -->
        @if (isBankLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="mt-2 text-muted">جاري تحميل رسائل بنك التذكيرات...</p>
            </div>
        }
        else
        {
            var filteredBankItems = GetFilteredBankItems();
            @if (!filteredBankItems.Any())
            {
                <div class="glass-card p-5 text-center">
                    <div class="mb-3">
                        <i class="fa-solid fa-box-open fs-1 text-muted"></i>
                    </div>
                    <h5 class="fw-bold">لا توجد رسائل في هذا التصنيف</h5>
                    <p class="text-muted small">يمكنك إضافة رسائل جديدة إلى بنك التذكيرات لتستخدمها في الحملات المجدولة لاحقاً.</p>
                    <button class="btn btn-primary-premium rounded-pill px-4 btn-sm" @onclick="OpenCreateMasterBankModal">
                        <i class="fa-solid fa-plus me-1"></i>إضافة أول رسالة للبنك
                    </button>
                </div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var item in filteredBankItems)
                    {
                        <div class="col-12 col-md-6 col-xl-4" key="@item.Id">
                            <div class="glass-card p-3 h-100 d-flex flex-column border shadow-sm position-relative @(item.IsActive ? "" : "opacity-75 bg-light")">
                                <!-- Top Bar: Category & Order Badges -->
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <div class="d-flex align-items-center gap-1.5 flex-wrap">
                                        <span class="badge @GetCategoryBadgeClass(item.Category) rounded-pill px-2.5 py-1 small">
                                            <i class="@GetCategoryIcon(item.Category) me-1"></i>@item.Category
                                        </span>
                                        <span class="badge bg-light text-dark border rounded-pill px-2 py-1 small" title="رقم الترتيب في السلسلة">
                                            ترتيب #@item.OrderIndex
                                        </span>
                                        @if (item.SuggestedTime.HasValue)
                                        {
                                            <span class="badge bg-light text-primary border rounded-pill px-2 py-1 small" title="الوقت المقترح">
                                                <i class="fa-regular fa-clock me-1"></i>@FormatTimeSpan(item.SuggestedTime.Value)
                                            </span>
                                        }
                                    </div>

                                    <div class="d-flex gap-1">
                                        <button class="btn btn-sm btn-outline-secondary rounded-circle" title="معاينة شكل التذكير على الهاتف" @onclick="() => OpenBankPreviewModal(item)">
                                            <i class="fa-solid fa-eye"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-primary rounded-circle" title="تعديل" @onclick="() => OpenEditMasterBankModal(item)">
                                            <i class="fa-solid fa-pen"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger rounded-circle" title="حذف" @onclick="() => DeleteMasterBankItem(item.Id)">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </div>
                                </div>

                                <!-- Image if present -->
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <div class="mb-2 rounded-3 overflow-hidden border shadow-xs" style="max-height: 120px;">
                                        <img src="@item.ImageUrl" alt="" style="width: 100%; height: 120px; object-fit: cover;" />
                                    </div>
                                }

                                <!-- Title & Message -->
                                <h6 class="fw-bold text-dark mb-1 fs-6">@item.Title</h6>
                                <p class="text-secondary small mb-3 flex-grow-1" style="line-height: 1.6; white-space: pre-line;">
                                    @item.Message
                                </p>

                                <!-- Destination & Usage meta -->
                                <div class="d-flex flex-wrap gap-2 text-muted x-small mb-2 pt-2 border-top">
                                    <span class="badge bg-light text-secondary border">
                                        <i class="fa-solid fa-location-arrow me-1 text-danger"></i>الوجهة: @item.ActionRoute
                                    </span>
                                    <span class="badge bg-light text-secondary border">
                                        <i class="fa-solid fa-paper-plane me-1 text-primary"></i>أُرسلت @item.UsageCount مرة
                                    </span>
                                    @if (item.LastUsedAt.HasValue)
                                    {
                                        <span class="badge bg-light text-secondary border">
                                            <i class="fa-solid fa-calendar me-1 text-success"></i>آخر استخدام: @item.LastUsedAt.Value.ToString("yyyy/MM/dd")
                                        </span>
                                    }
                                </div>

                                <!-- Active toggle / Status indicator -->
                                <div class="d-flex justify-content-between align-items-center pt-2 border-top x-small mt-auto">
                                    <span class="@(item.IsActive ? "text-success fw-bold" : "text-muted")">
                                        <i class="fa-solid @(item.IsActive ? "fa-circle-check" : "fa-circle-pause") me-1"></i>
                                        @(item.IsActive ? "مفعّلة وجاهزة للحملات" : "معطلة مؤقتاً")
                                    </span>
                                    <button class="btn btn-sm btn-link text-primary p-0 text-decoration-none x-small" @onclick="() => OpenEditMasterBankModal(item)">
                                        تعديل البيانات <i class="fa-solid fa-chevron-left ms-1"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        }
    }
</div>

<!-- ========================================== -->
<!-- Modal: Create / Edit Campaign               -->
<!-- ========================================== -->
@if (showEditModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" dir="rtl">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content glass-card border-0 shadow-lg rounded-4">
                <div class="modal-header border-bottom pb-3">
                    <h5 class="modal-title fw-bold text-primary">
                        <i class="fa-solid @(isEditing ? "fa-pen" : "fa-plus") me-2"></i>
                        @(isEditing ? "تعديل التذكير" : "إنشاء تذكير جديد")
                    </h5>
                    <button type="button" class="btn-close ms-0 me-auto" @onclick="CloseEditModal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <!-- Campaign Type: Regular vs Occasion -->
                        <div class="col-12">
                            <div class="p-3 bg-light rounded-3 border">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <label class="form-label small fw-bold mb-0">
                                        <i class="fa-solid fa-calendar-check text-primary me-1"></i>طبيعة التذكير (روتيني معتاد أم مناسبة خاصة وموسمية)
                                    </label>
                                    <span class="badge small rounded-pill px-2 py-1 text-white" style="background-color: @(currentForm.CampaignType == "Occasion" ? "#8b5cf6" : "#64748b");">
                                        @(currentForm.CampaignType == "Occasion" ? "مناسبة خاصة / موسمية" : "تذكير روتيني مستمر")
                                    </span>
                                </div>
                                
                                <div class="btn-group w-100 shadow-sm rounded-pill overflow-hidden mb-2" role="group">
                                    <input type="radio" class="btn-check" name="remCampaignType" id="campTypeRegular" @onclick='() => SetCampaignType("Regular")' checked="@(currentForm.CampaignType != "Occasion")">
                                    <label class="btn btn-outline-primary btn-sm py-1.5" for="campTypeRegular">
                                        <i class="fa-solid fa-arrows-rotate me-1"></i>تذكير روتيني معتاد (يومي/أسبوعي مستمر)
                                    </label>

                                    <input type="radio" class="btn-check" name="remCampaignType" id="campTypeOccasion" @onclick='() => SetCampaignType("Occasion")' checked="@(currentForm.CampaignType == "Occasion")">
                                    <label class="btn btn-outline-primary btn-sm py-1.5" for="campTypeOccasion">
                                        <i class="fa-solid fa-wand-magic-sparkles me-1"></i>مناسبة خاصة / موسمية (تتجاوز المعتادة)
                                    </label>
                                </div>

                                @if (currentForm.CampaignType == "Occasion")
                                {
                                    <div class="mt-3 p-3 bg-white rounded-3 border">
                                        <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                                            <span class="fw-bold small text-dark"><i class="fa-solid fa-sparkles text-warning me-1"></i>قوالب مناسبات سريعة:</span>
                                            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill py-0.5 px-2.5 small" @onclick='() => ApplyOccasionPreset("Friday")'>
                                                🕊️ يوم الجمعة
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-success rounded-pill py-0.5 px-2.5 small" @onclick='() => ApplyOccasionPreset("Ramadan")'>
                                                🌙 شهر رمضان
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-info rounded-pill py-0.5 px-2.5 small" @onclick='() => ApplyOccasionPreset("ShamElNessim")'>
                                                🌸 شم النسيم
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-warning rounded-pill py-0.5 px-2.5 small" @onclick='() => ApplyOccasionPreset("DhulHijjah")'>
                                                🕋 العشر من ذي الحجة
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-danger rounded-pill py-0.5 px-2.5 small" @onclick='() => ApplyOccasionPreset("Eid")'>
                                                🎉 الأعياد الرسمية
                                            </button>
                                        </div>

                                        <div class="row g-2 mb-2 align-items-center">
                                            <div class="col-md-6">
                                                <label class="form-label x-small fw-bold">اسم المناسبة</label>
                                                <input type="text" class="form-control form-control-sm rounded-pill" @bind="currentForm.OccasionName" placeholder="مثلاً: يوم شم النسيم، عيد الفطر، شهر رمضان" />
                                            </div>
                                            <div class="col-md-6 pt-md-3">
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input" type="checkbox" id="overrideSwitch" @bind="currentForm.OverridesRegularReminders">
                                                    <label class="form-check-label small fw-bold text-dark" for="overrideSwitch">
                                                        إيقاف التذكيرات المعتادة في يوم المناسبة تلقائياً
                                                    </label>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="text-muted x-small">
                                            <i class="fa-solid fa-circle-info text-info me-1"></i>عند تفعيل التجاوز، تظهر رسائل هذه المناسبة فقط وتتوقف الرسائل اليومية المعتادة مؤقتاً، على أن تستأنف المعتادة تلقائياً في الأيام التالية!
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Title -->
                        <div class="col-12 col-md-8">
                            <label class="form-label small fw-bold">عنوان التذكير / الحملة <span class="text-danger">*</span></label>
                            <input type="text" class="form-control rounded-pill" @bind="currentForm.Title" placeholder="مثلاً: تذكير المختبرين بالاستخدام اليومي" />
                        </div>

                        <!-- Language -->
                        <div class="col-12 col-md-4">
                            <label class="form-label small fw-bold">اللغة</label>
                            <select class="form-select rounded-pill" @bind="currentForm.Language">
                                <option value="ar">العربية (ar)</option>
                                <option value="en">الإنجليزية (en)</option>
                                <option value="all">جميع اللغات (all)</option>
                            </select>
                        </div>

                        <!-- Internal Description -->
                        <div class="col-12">
                            <label class="form-label small fw-bold">الغرض الداخلي (للمدير فقط)</label>
                            <input type="text" class="form-control rounded-pill" @bind="currentForm.InternalDescription" placeholder="مثلاً: دعم الاختبار المغلق لمدة 14 يوماً على Google Play" />
                        </div>

                        <!-- Delivery Channel Selection -->
                        <div class="col-12">
                            <div class="p-3 bg-light rounded-3 border">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <label class="form-label small fw-bold mb-0">
                                        <i class="fa-solid fa-tower-broadcast text-primary me-1"></i>قناة الإرسال ومكان الظهور
                                    </label>
                                    <span class="badge bg-primary-subtle text-primary border small">
                                        @(currentForm.DeliveryChannel switch {
                                            "PushOnly" => "شاشة الموبايل فقط",
                                            "InAppOnly" => "داخلي فقط",
                                            _ => "كلاهما (موبايل + داخلي)"
                                        })
                                    </span>
                                </div>
                                <div class="btn-group w-100 shadow-sm rounded-pill overflow-hidden" role="group">
                                    <input type="radio" class="btn-check" name="remDeliveryChannel" id="remChannelBoth" @onclick='() => currentForm.DeliveryChannel = "Both"' checked="@(currentForm.DeliveryChannel == "Both" || string.IsNullOrEmpty(currentForm.DeliveryChannel))">
                                    <label class="btn btn-outline-primary btn-sm py-1.5" for="remChannelBoth" title="يصل على شاشة الهاتف كـ Push ويظهر أيضاً داخل التطبيق">
                                        <i class="fa-solid fa-layer-group me-1"></i>كلاهما (شاشة الهاتف + داخلي)
                                    </label>

                                    <input type="radio" class="btn-check" name="remDeliveryChannel" id="remChannelPush" @onclick='() => currentForm.DeliveryChannel = "PushOnly"' checked="@(currentForm.DeliveryChannel == "PushOnly")">
                                    <label class="btn btn-outline-primary btn-sm py-1.5" for="remChannelPush" title="يصل كإشعار خارجي فقط على شاشة الموبايل دون حفظه داخل صندوق الإشعارات">
                                        <i class="fa-solid fa-mobile-screen me-1"></i>شاشة الموبايل فقط
                                    </label>

                                    <input type="radio" class="btn-check" name="remDeliveryChannel" id="remChannelInApp" @onclick='() => currentForm.DeliveryChannel = "InAppOnly"' checked="@(currentForm.DeliveryChannel == "InAppOnly")">
                                    <label class="btn btn-outline-primary btn-sm py-1.5" for="remChannelInApp" title="يظهر فقط داخل التطبيق دون إرسال push notification خارجي">
                                        <i class="fa-solid fa-inbox me-1"></i>داخلي فقط
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- Message Selection Mode: Static Text vs Bank -->
                        <div class="col-12">
                            <div class="p-3 bg-light rounded-3 border">
                                <label class="form-label small fw-bold mb-2">
                                    <i class="fa-solid fa-vault text-primary me-1"></i>مصدر نص التذكير (نص ثابت أو بنك التذكيرات المخزنة)
                                </label>
                                <div class="btn-group w-100 shadow-sm rounded-pill overflow-hidden mb-2" role="group">
                                    <input type="radio" class="btn-check" name="remMsgMode" id="msgModeSingle" @onclick='() => SetMessageMode("Single")' checked="@(currentForm.MessageSelectionMode == "Single" || string.IsNullOrEmpty(currentForm.MessageSelectionMode))">
                                    <label class="btn btn-outline-primary btn-sm py-1.5" for="msgModeSingle">
                                        <i class="fa-solid fa-message me-1"></i>نص ثابت
                                    </label>

                                    <input type="radio" class="btn-check" name="remMsgMode" id="msgModeRandom" @onclick='() => SetMessageMode("RandomBank")' checked="@(currentForm.MessageSelectionMode == "RandomBank")">
                                    <label class="btn btn-outline-primary btn-sm py-1.5" for="msgModeRandom">
                                        <i class="fa-solid fa-shuffle me-1"></i>بنك التذكيرات - عشوائي
                                    </label>

                                    <input type="radio" class="btn-check" name="remMsgMode" id="msgModeSequential" @onclick='() => SetMessageMode("SequentialBank")' checked="@(currentForm.MessageSelectionMode == "SequentialBank")">
                                    <label class="btn btn-outline-primary btn-sm py-1.5" for="msgModeSequential">
                                        <i class="fa-solid fa-arrow-down-1-9 me-1"></i>بنك التذكيرات - تسلسلي بالترتيب
                                    </label>

                                    <input type="radio" class="btn-check" name="remMsgMode" id="msgModeScheduled" @onclick='() => SetMessageMode("ScheduledBank")' checked="@(currentForm.MessageSelectionMode == "ScheduledBank")">
                                    <label class="btn btn-outline-primary btn-sm py-1.5" for="msgModeScheduled">
                                        <i class="fa-solid fa-calendar-days me-1"></i>بنك مجدول بتواريخ
                                    </label>
                                </div>

                                <!-- Info banner & Category Selector for Master Bank -->
                                @if (currentForm.MessageSelectionMode == "RandomBank" || currentForm.MessageSelectionMode == "SequentialBank")
                                {
                                    <div class="mt-3 p-3 bg-white rounded-3 border">
                                        <div class="row g-2 align-items-center mb-2">
                                            <div class="col-12 col-md-6">
                                                <label class="form-label small fw-bold mb-1">
                                                    <i class="fa-solid fa-tags text-primary me-1"></i>تصنيف رسائل البنك المطلوب
                                                </label>
                                                <select class="form-select rounded-pill small" @bind="currentForm.BankCategory">
                                                    <option value="All">جميع التصنيفات المخزنة في البنك</option>
                                                    @foreach (var cat in bankCategories)
                                                    {
                                                        <option value="@cat">@cat</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-12 col-md-6">
                                                <div class="text-muted small">
                                                    @if (currentForm.MessageSelectionMode == "RandomBank")
                                                    {
                                                        <span class="text-primary"><i class="fa-solid fa-circle-info me-1"></i>سيتم في كل موعد تذكير اختيار رسالة عشوائية تلقائياً من البنك.</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-success"><i class="fa-solid fa-circle-info me-1"></i>سيتم إرسال الرسائل بالترتيب (1 ثم 2 ثم 3...) وتكرار الدورة تلقائياً.</span>
                                                    }
                                                </div>
                                            </div>
                                        </div>

                                        @{
                                            var matchCount = string.IsNullOrEmpty(currentForm.BankCategory) || currentForm.BankCategory == "All"
                                                ? bankItems.Count(b => b.IsActive)
                                                : bankItems.Count(b => b.IsActive && b.Category == currentForm.BankCategory);
                                        }
                                        <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top x-small">
                                            <span class="badge bg-primary-subtle text-primary border">
                                                <i class="fa-solid fa-vault me-1"></i>الرسائل المتاحة حالياً في البنك: <strong>@matchCount</strong> رسالة
                                            </span>
                                            <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none" @onclick='() => SwitchTab("bank")'>
                                                <i class="fa-solid fa-arrow-up-right-from-square me-1"></i>إدارة رسائل البنك
                                            </button>
                                        </div>
                                    </div>
                                }
                                else if (currentForm.MessageSelectionMode == "ScheduledBank")
                                {
                                    <div class="mt-3 pt-3 border-top">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="fw-bold small text-dark">
                                                <i class="fa-solid fa-vault text-warning me-1"></i>قائمة رسائل الحملة المجدولة (@currentForm.MessageBankItems.Count رسالة)
                                            </span>
                                            <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 py-1" @onclick="OpenAddBankItemModal">
                                                <i class="fa-solid fa-plus me-1"></i>إضافة رسالة للبنك
                                            </button>
                                        </div>

                                        @if (currentForm.MessageBankItems.Count == 0)
                                        {
                                            <div class="alert alert-warning py-2 small mb-2 text-center">
                                                <i class="fa-solid fa-triangle-exclamation me-1"></i>لم تتم إضافة أي رسائل بعد. اضغط "إضافة رسالة للبنك" لإضافة رسائل غير محدودة.
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="d-flex flex-column gap-2 mb-2" style="max-height: 220px; overflow-y: auto;">
                                                @foreach (var item in currentForm.MessageBankItems)
                                                {
                                                    <div class="p-2.5 rounded-3 border bg-white shadow-xs d-flex justify-content-between align-items-center gap-2">
                                                        <div class="min-w-0 flex-grow-1">
                                                            <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                                                                <span class="fw-bold text-dark small text-truncate" style="max-width: 250px;">
                                                                    @(!string.IsNullOrWhiteSpace(item.Title) ? item.Title : currentForm.Title)
                                                                </span>
                                                                @if (item.ScheduledDateTime.HasValue)
                                                                {
                                                                    <span class="badge bg-primary-subtle text-primary x-small">
                                                                        <i class="fa-regular fa-clock me-1"></i>@item.ScheduledDateTime.Value.ToString("yyyy/MM/dd HH:mm")
                                                                    </span>
                                                                }
                                                            </div>
                                                            <p class="mb-0 text-muted x-small text-truncate">@item.Message</p>
                                                        </div>
                                                        <div class="d-flex gap-1 flex-shrink-0">
                                                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill py-0 px-2 x-small" @onclick="() => OpenEditBankItemModal(item)">
                                                                <i class="fa-solid fa-pen"></i>
                                                            </button>
                                                            <button type="button" class="btn btn-sm btn-outline-danger rounded-pill py-0 px-2 x-small" @onclick="() => DeleteBankItem(item.Id)">
                                                                <i class="fa-solid fa-trash"></i>
                                                            </button>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Message Body (Fallback / Static) -->
                        <div class="col-12">
                            <label class="form-label small fw-bold">
                                نص الرسالة للمستخدم @(currentForm.MessageSelectionMode == "Single" ? "(مطلوب)" : "(النص الاحتياطي في حال تعذر السحب من البنك)")
                                @if (currentForm.MessageSelectionMode == "Single")
                                {
                                    <span class="text-danger">*</span>
                                }
                            </label>
                            <textarea class="form-control rounded-3" rows="3" @bind="currentForm.Message" placeholder="اكتب النص الذي سيظهر في الإشعار أو داخل التطبيق..."></textarea>
                            <span class="x-small text-muted">احرص على كتابة نص جذاب وواضح يشجع المستخدم على التفاعل دون إزعاج.</span>
                        </div>

                        <!-- Reminder Image (Optional) -->
                        <div class="col-12">
                            <div class="p-3 rounded-3 border bg-white shadow-xs">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <label class="form-label small fw-bold mb-0">
                                        <i class="fa-solid fa-image text-primary me-1"></i>صورة التذكير (اختياري - تظهر كصورة بارزة في الإشعار)
                                    </label>
                                    @if (!string.IsNullOrWhiteSpace(currentForm.ImageUrl))
                                    {
                                        <button type="button" class="btn btn-link text-danger p-0 small text-decoration-none" @onclick="ClearReminderImage">
                                            <i class="fa-solid fa-trash me-1"></i>حذف الصورة
                                        </button>
                                    }
                                </div>
                                <div class="row g-2 align-items-center">
                                    <div class="col-sm-8">
                                        <input type="text" class="form-control form-control-sm rounded-pill" 
                                               @bind="currentForm.ImageUrl" 
                                               @bind:event="oninput"
                                               placeholder="رابط الصورة المباشر https://..." />
                                    </div>
                                    <div class="col-sm-4">
                                        <label class="btn btn-outline-primary btn-sm w-100 rounded-pill mb-0 @(isUploadingReminderImage ? "disabled" : "")" style="cursor: pointer;">
                                            @if (isUploadingReminderImage)
                                            {
                                                <span class="spinner-border spinner-border-sm me-1"></span>
                                                <span>جاري الرفع...</span>
                                            }
                                            else
                                            {
                                                <i class="fa-solid fa-cloud-arrow-up me-1"></i>
                                                <span>رفع صورة</span>
                                            }
                                            <InputFile OnChange="HandleReminderImageUpload" class="d-none" accept="image/*" />
                                        </label>
                                    </div>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(currentForm.ImageUrl))
                                {
                                    <div class="mt-2 text-center p-2 rounded bg-light border">
                                        <img src="@currentForm.ImageUrl" alt="Preview" style="max-height: 100px; max-width: 100%; object-fit: contain;" @onerror="OnReminderImageLoadError" />
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Schedule & Recurrence -->
                        <div class="col-12">
                            <div class="border-top pt-3 mt-2">
                                <h6 class="fw-bold text-dark small mb-3"><i class="fa-solid fa-clock me-1 text-primary"></i>الجدولة والتكرار</h6>
                            </div>
                        </div>

                        <!-- Recurrence Type -->
                        <div class="col-12 col-md-4">
                            <label class="form-label small fw-bold">نوع التكرار</label>
                            <select class="form-select rounded-pill" @bind="currentForm.RecurrenceType">
                                <option value="@ReminderRecurrenceType.Daily">يومياً</option>
                                <option value="@ReminderRecurrenceType.Once">مرة واحدة</option>
                                <option value="@ReminderRecurrenceType.Weekly">أسبوعياً</option>
                                <option value="@ReminderRecurrenceType.SpecificDaysOfWeek">أيام محددة من الأسبوع</option>
                                <option value="@ReminderRecurrenceType.IntervalHours">كل عدد ساعات</option>
                                <option value="@ReminderRecurrenceType.IntervalDays">كل عدد أيام</option>
                            </select>
                        </div>

                        <!-- Time of Day -->
                        <div class="col-6 col-md-4">
                            <label class="form-label small fw-bold">موعد العرض / الإرسال</label>
                            <input type="time" class="form-control rounded-pill" @bind="scheduledTimeVal" />
                            <span class="x-small text-muted">حسب التوقيت المحلي للجهاز</span>
                        </div>

                        <!-- Duration in Days -->
                        <div class="col-6 col-md-4">
                            <label class="form-label small fw-bold">مدة الحملة (بالأيام)</label>
                            <input type="number" class="form-control rounded-pill" @bind="currentForm.DurationDays" placeholder="مثلاً: 14" min="1" max="365" />
                        </div>

                        <!-- Start Date -->
                        <div class="col-6 col-md-6">
                            <label class="form-label small fw-bold">تاريخ البداية</label>
                            <input type="date" class="form-control rounded-pill" @bind="startDateVal" />
                        </div>

                        <!-- End Date -->
                        <div class="col-6 col-md-6">
                            <label class="form-label small fw-bold">تاريخ النهاية (اختياري)</label>
                            <input type="date" class="form-control rounded-pill" @bind="endDateVal" />
                        </div>

                        <!-- Display & Audience -->
                        <div class="col-12">
                            <div class="border-top pt-3 mt-2">
                                <h6 class="fw-bold text-dark small mb-3"><i class="fa-solid fa-sliders me-1 text-primary"></i>طريقة العرض والجمهور المستهدف</h6>
                            </div>
                        </div>

                        <!-- Display Type -->
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-bold">طريقة العرض</label>
                            <select class="form-select rounded-pill" @bind="currentForm.DisplayType">
                                <option value="@ReminderDisplayType.NotificationBar">إشعار محلي بشريط النظام</option>
                                <option value="@ReminderDisplayType.InAppBanner">شريط تنبيهي داخل التطبيق</option>
                                <option value="@ReminderDisplayType.InAppDialog">نافذة حوارية منبثقة</option>
                                <option value="@ReminderDisplayType.TaskReminder">تذكير بمهمة محددة</option>
                            </select>
                        </div>

                        <!-- Target Audience -->
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-bold">الجمهور المستهدف</label>
                            <select class="form-select rounded-pill" @bind="currentForm.TargetAudience">
                                <option value="@ReminderTargetAudience.Testers">مختبرو التطبيق (Google Play)</option>
                                <option value="@ReminderTargetAudience.AllUsers">جميع المستخدمين</option>
                                <option value="@ReminderTargetAudience.Clients">العملاء والباحثون عن خدمات</option>
                                <option value="@ReminderTargetAudience.Providers">مقدمو الخدمات فقط</option>
                            </select>
                        </div>

                        <!-- Action Route Selection -->
                        <div class="col-12">
                            <div class="p-3 bg-light rounded-3 border">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <label class="form-label small fw-bold mb-0">
                                        <i class="fa-solid fa-location-arrow text-primary me-1"></i>وجهة الضغط (عند النقر على التذكير)
                                    </label>
                                    @if (!string.IsNullOrWhiteSpace(currentForm.ActionRoute))
                                    {
                                        <span class="badge bg-primary-subtle text-primary border px-2 py-1 small" dir="ltr">
                                            @currentForm.ActionRoute
                                        </span>
                                    }
                                </div>

                                <div class="btn-group w-100 mb-2 shadow-sm rounded-pill overflow-hidden" role="group">
                                    <input type="radio" class="btn-check" name="reminderDestType" id="remDestScreen" @onclick='() => SetReminderDestMode("Screen")' checked="@(reminderDestMode == "Screen")">
                                    <label class="btn btn-outline-primary btn-sm" for="remDestScreen">
                                        <i class="fa-solid fa-mobile-screen me-1"></i>شاشة من التطبيق
                                    </label>

                                    <input type="radio" class="btn-check" name="reminderDestType" id="remDestService" @onclick='() => SetReminderDestMode("Service")' checked="@(reminderDestMode == "Service")">
                                    <label class="btn btn-outline-primary btn-sm" for="remDestService">
                                        <i class="fa-solid fa-briefcase me-1"></i>صفحة خدمة معينة
                                    </label>

                                    <input type="radio" class="btn-check" name="reminderDestType" id="remDestCustom" @onclick='() => SetReminderDestMode("Custom")' checked="@(reminderDestMode == "Custom")">
                                    <label class="btn btn-outline-primary btn-sm" for="remDestCustom">
                                        <i class="fa-solid fa-link me-1"></i>مسار مخصص
                                    </label>
                                </div>

                                @if (reminderDestMode == "Screen")
                                {
                                    <div>
                                        <select class="form-select rounded-pill small" value="@selectedReminderScreen" @onchange="OnReminderScreenChanged">
                                            <option value="/">الصفحة الرئيسية (/)</option>
                                            <option value="/marketplace">سوق المستعمل والمنتجات (/marketplace)</option>
                                            <option value="/services">تصفح الخدمات (/services)</option>
                                            <option value="/search">صفحة البحث والاستكشاف (/search)</option>
                                            <option value="/categories">الأقسام والتصنيفات (/categories)</option>
                                            <option value="/feed">المنشورات والتحديثات (/feed)</option>
                                            <option value="/profile">الملف الشخصي والحساب (/profile)</option>
                                            <option value="/user/my-requests">طلباتي (/user/my-requests)</option>
                                            <option value="/messages">الرسائل والمحادثات (/messages)</option>
                                            <option value="/favorites">المفضلة (/favorites)</option>
                                            <option value="/register-provider">التسجيل كمقدم خدمة (/register-provider)</option>
                                            <option value="/provider/dashboard">لوحة تحكم مقدم الخدمة (/provider/dashboard)</option>
                                            <option value="/provider/create-service">إضافة خدمة جديدة (/provider/create-service)</option>
                                            <option value="/notifications">مركز التنبيهات (/notifications)</option>
                                            <option value="/contact">تواصل معنا والدعم (/contact)</option>
                                            <option value="/terms">الشروط والأحكام (/terms)</option>
                                            <option value="/privacy">سياسة الخصوصية (/privacy)</option>
                                        </select>
                                    </div>
                                }
                                else if (reminderDestMode == "Service")
                                {
                                    <div>
                                        <div class="row g-2 mb-2">
                                            <div class="col-8">
                                                <select class="form-select rounded-pill small" value="@selectedReminderServiceId" @onchange="OnReminderServiceChanged">
                                                    <option value="">-- اختر الخدمة --</option>
                                                    @foreach (var s in servicesList)
                                                    {
                                                        <option value="@s.Id">#@s.Id - @s.Title (@s.ProviderName)</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-4">
                                                <input type="number" class="form-control rounded-pill small" value="@selectedReminderServiceId" @oninput="OnReminderServiceIdInput" placeholder="رقم ID" />
                                            </div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div>
                                        <input type="text" class="form-control rounded-pill small" @bind="currentForm.ActionRoute" placeholder="اكتب المسار المطلوب، مثلاً: /service/123 أو /feed" />
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Priority & Status -->
                        <div class="col-6 col-md-6">
                            <label class="form-label small fw-bold">أولوية التذكير</label>
                            <select class="form-select rounded-pill" @bind="currentForm.Priority">
                                <option value="@ReminderPriority.Normal">عادية</option>
                                <option value="@ReminderPriority.Low">منخفضة</option>
                                <option value="@ReminderPriority.High">مرتفعة</option>
                                <option value="@ReminderPriority.Urgent">عاجلة</option>
                            </select>
                        </div>

                        <div class="col-6 col-md-6">
                            <label class="form-label small fw-bold">الحالة الأولية</label>
                            <select class="form-select rounded-pill" @bind="currentForm.Status">
                                <option value="@ReminderStatus.Active">مفعّل فوراً</option>
                                <option value="@ReminderStatus.Draft">مسودة</option>
                                <option value="@ReminderStatus.Paused">متوقف مؤقتاً</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="modal-footer border-top pt-3 d-flex justify-content-between">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" @onclick="CloseEditModal">إلغاء</button>
                    <button type="button" class="btn btn-primary-premium rounded-pill px-4 shadow-sm" @onclick="SaveReminder" disabled="@isSaving">
                        @if (isSaving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        <i class="fa-solid fa-check me-1"></i>حفظ التغييرات
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ========================================== -->
<!-- Modal: Create / Edit Master Bank Item      -->
<!-- ========================================== -->
@if (showMasterBankModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" dir="rtl">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content glass-card border-0 shadow-lg rounded-4">
                <div class="modal-header border-bottom pb-3">
                    <h5 class="modal-title fw-bold text-primary">
                        <i class="fa-solid @(isEditingMasterBank ? "fa-pen" : "fa-plus") me-2"></i>
                        @(isEditingMasterBank ? "تعديل رسالة في بنك التذكيرات" : "إضافة رسالة جديدة إلى بنك التذكيرات")
                    </h5>
                    <button type="button" class="btn-close ms-0 me-auto" @onclick="() => showMasterBankModal = false"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <!-- Title -->
                        <div class="col-12 col-md-8">
                            <label class="form-label small fw-bold">عنوان الرسالة <span class="text-danger">*</span></label>
                            <input type="text" class="form-control rounded-pill" @bind="masterBankForm.Title" placeholder="مثلاً: صباح الخير والإنتاجية ☀️" />
                        </div>

                        <!-- Category -->
                        <div class="col-12 col-md-4">
                            <label class="form-label small fw-bold">التصنيف / النوع <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input type="text" class="form-control rounded-pill" list="bankCategoryList" @bind="masterBankForm.Category" placeholder="اختر أو اكتب تصنيفاً..." />
                                <datalist id="bankCategoryList">
                                    <option value="صباحية" />
                                    <option value="وسط اليوم" />
                                    <option value="مسائية" />
                                    <option value="يوم الجمعة" />
                                    <option value="عامة" />
                                    <option value="المختبرين" />
                                    @foreach (var c in bankCategories)
                                    {
                                        <option value="@c" />
                                    }
                                </datalist>
                            </div>
                            <span class="x-small text-muted">مثل: صباحية، وسط اليوم، مسائية، يوم الجمعة...</span>
                        </div>

                        <!-- Message Body -->
                        <div class="col-12">
                            <label class="form-label small fw-bold">نص الرسالة للمستخدم <span class="text-danger">*</span></label>
                            <textarea class="form-control rounded-3" rows="3" @bind="masterBankForm.Message" placeholder="اكتب محتوى الرسالة الذي سيصل للمستخدم..."></textarea>
                        </div>

                        <!-- Order & Suggested Time -->
                        <div class="col-6 col-md-4">
                            <label class="form-label small fw-bold">رقم الترتيب في السلسلة</label>
                            <input type="number" class="form-control rounded-pill" @bind="masterBankForm.OrderIndex" min="1" max="9999" />
                            <span class="x-small text-muted">يحدد الأولوية عند الإرسال التسلسلي</span>
                        </div>

                        <div class="col-6 col-md-4">
                            <label class="form-label small fw-bold">الوقت المقترح (اختياري)</label>
                            <input type="time" class="form-control rounded-pill" @bind="masterBankSuggestedTimeVal" />
                            <span class="x-small text-muted">وقت مناسب لطبيعة الرسالة</span>
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label small fw-bold">وجهة الضغط في التطبيق</label>
                            <input type="text" class="form-control rounded-pill" @bind="masterBankForm.ActionRoute" placeholder="مثال: / أو /services أو /feed" />
                            <span class="x-small text-muted">المسار الذي يفتح عند نقر الإشعار</span>
                        </div>

                        <!-- Image URL / Upload -->
                        <div class="col-12">
                            <div class="p-3 rounded-3 border bg-light shadow-xs">
                                <label class="form-label small fw-bold mb-1">
                                    <i class="fa-solid fa-image text-primary me-1"></i>صورة التذكير المرافقة (اختياري)
                                </label>
                                <div class="row g-2 align-items-center">
                                    <div class="col-sm-8">
                                        <input type="text" class="form-control form-control-sm rounded-pill" 
                                               @bind="masterBankForm.ImageUrl" 
                                               @bind:event="oninput"
                                               placeholder="رابط الصورة المباشر https://..." />
                                    </div>
                                    <div class="col-sm-4">
                                        <label class="btn btn-outline-primary btn-sm w-100 rounded-pill mb-0 @(isUploadingMasterBankImage ? "disabled" : "")" style="cursor: pointer;">
                                            @if (isUploadingMasterBankImage)
                                            {
                                                <span class="spinner-border spinner-border-sm me-1"></span>
                                                <span>جاري الرفع...</span>
                                            }
                                            else
                                            {
                                                <i class="fa-solid fa-cloud-arrow-up me-1"></i>
                                                <span>رفع صورة</span>
                                            }
                                            <InputFile OnChange="HandleMasterBankImageUpload" class="d-none" accept="image/*" />
                                        </label>
                                    </div>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(masterBankForm.ImageUrl))
                                {
                                    <div class="mt-2 text-center p-2 rounded bg-white border">
                                        <img src="@masterBankForm.ImageUrl" alt="Bank Preview" style="max-height: 90px; max-width: 100%; object-fit: contain;" />
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- IsActive switch -->
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="bankIsActive" @bind="masterBankForm.IsActive">
                                <label class="form-check-label fw-bold small" for="bankIsActive">
                                    رسالة مفعلة وجاهزة للاستخدام في الحملات المجدولة
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer border-top pt-3 d-flex justify-content-between">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" @onclick="() => showMasterBankModal = false">إلغاء</button>
                    <button type="button" class="btn btn-primary-premium rounded-pill px-4 shadow-sm fw-bold" @onclick="SaveMasterBankItem">
                        <i class="fa-solid fa-check me-1"></i>حفظ في البنك
                    </button>
                </div>
            </div>
        </div>
    </div>
}

