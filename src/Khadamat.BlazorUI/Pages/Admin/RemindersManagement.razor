    private static string GetStatusBadgeClass(ReminderStatus status) => status switch
    {
        ReminderStatus.Active => "bg-success text-white",
        ReminderStatus.Paused => "bg-warning text-dark",
        ReminderStatus.Draft => "bg-secondary text-white",
        ReminderStatus.Expired => "bg-dark text-white",
        _ => "bg-light text-dark"
    };

    private static string GetStatusName(ReminderStatus status) => status switch
    {
        ReminderStatus.Active => "مفعّل",
        ReminderStatus.Paused => "متوقف مؤقتاً",
        ReminderStatus.Draft => "مسودة",
        ReminderStatus.Expired => "منتهي",
        _ => "غير معروف"
    };
