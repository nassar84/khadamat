    private void OpenEditModal(ReminderCampaignDto rem)
    {
        isEditing = true;
        currentEditingId = rem.Id;

        // Determine destination mode
        if (!string.IsNullOrEmpty(rem.ActionRoute) && rem.ActionRoute.StartsWith("/service/"))
        {
            reminderDestMode = "Service";
            var idPart = rem.ActionRoute.Replace("/service/", "").Trim();
            selectedReminderServiceId = idPart;
            if (int.TryParse(idPart, out int sid))
            {
                selectedReminderService = servicesList.FirstOrDefault(s => s.Id == sid);
            }
        }
        else
        {
            var knownScreens = new HashSet<string> { "/", "/marketplace", "/services", "/search", "/categories", "/feed", "/profile", "/user/my-requests", "/messages", "/favorites", "/register-provider", "/provider/dashboard", "/provider/create-service", "/notifications", "/contact", "/terms", "/privacy" };
            if (knownScreens.Contains(rem.ActionRoute))
            {
                reminderDestMode = "Screen";
                selectedReminderScreen = rem.ActionRoute;
            }
            else
            {
                reminderDestMode = "Custom";
            }
        }

        currentForm = new CreateReminderCampaignDto
        {
            Title = rem.Title,
            InternalDescription = rem.InternalDescription,
            Message = rem.Message,
            Language = rem.Language,
            Status = rem.Status,
            RecurrenceType = rem.RecurrenceType,
            ScheduledTime = rem.ScheduledTime,
            IntervalValue = rem.IntervalValue,
            DaysOfWeek = rem.DaysOfWeek,
            DurationDays = rem.DurationDays,
            MaxOccurrences = rem.MaxOccurrences,
            TimeZoneId = rem.TimeZoneId,
            Priority = rem.Priority,
            TargetAudience = rem.TargetAudience,
            TargetRole = rem.TargetRole,
            DisplayType = rem.DisplayType,
            ActionRoute = rem.ActionRoute,
            ImageUrl = rem.ImageUrl,
            DeliveryChannel = rem.DeliveryChannel ?? "Both",
            MessageSelectionMode = rem.MessageSelectionMode ?? "Single",
            BankCategory = rem.BankCategory ?? "All",
            LastSequentialIndex = rem.LastSequentialIndex,
            MessageBankItems = rem.MessageBankItems != null ? new List<ReminderMessageBankItemDto>(rem.MessageBankItems) : new(),
            CampaignType = rem.CampaignType ?? "Regular",
            OverridesRegularReminders = rem.OverridesRegularReminders,
            OccasionName = rem.OccasionName,
            IsActive = rem.IsActive,
            StartDate = rem.StartDate,
            EndDate = rem.EndDate
        };
        reminderImageLoadFailed = false;
        scheduledTimeVal = TimeOnly.FromTimeSpan(rem.ScheduledTime);
        startDateVal = rem.StartDate.Date;
        endDateVal = rem.EndDate?.Date;
        showEditModal = true;
    }

