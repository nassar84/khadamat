    private void ApplyOccasionPreset(string preset)
    {
        currentForm.CampaignType = "Occasion";
        currentForm.OverridesRegularReminders = true;

        switch (preset)
        {
            case "Friday":
                currentForm.Title = "تذكير يوم الجمعة المباركة 🕊️";
                currentForm.OccasionName = "يوم الجمعة";
                currentForm.RecurrenceType = ReminderRecurrenceType.SpecificDaysOfWeek;
                currentForm.DaysOfWeek = "Friday";
                currentForm.MessageSelectionMode = "RandomBank";
                currentForm.BankCategory = "يوم الجمعة";
                scheduledTimeVal = new TimeOnly(10, 0);
                break;
            case "Ramadan":
                currentForm.Title = "نفحات شهر رمضان المبارك 🌙";
                currentForm.OccasionName = "شهر رمضان";
                currentForm.RecurrenceType = ReminderRecurrenceType.Daily;
                currentForm.MessageSelectionMode = "RandomBank";
                currentForm.BankCategory = "شهر رمضان";
                currentForm.DurationDays = 30;
                scheduledTimeVal = new TimeOnly(17, 30);
                break;
            case "ShamElNessim":
                currentForm.Title = "تهنئة يوم شم النسيم 🌸🥚";
                currentForm.OccasionName = "شم النسيم";
                currentForm.RecurrenceType = ReminderRecurrenceType.Once;
                currentForm.MessageSelectionMode = "RandomBank";
                currentForm.BankCategory = "مناسبات وأعياد";
                scheduledTimeVal = new TimeOnly(9, 30);
                break;
            case "DhulHijjah":
                currentForm.Title = "أيام العشر الفضيلة من ذي الحجة 🕋";
                currentForm.OccasionName = "العشر من ذي الحجة";
                currentForm.RecurrenceType = ReminderRecurrenceType.Daily;
                currentForm.MessageSelectionMode = "RandomBank";
                currentForm.BankCategory = "العشر من ذي الحجة";
                currentForm.DurationDays = 10;
                scheduledTimeVal = new TimeOnly(9, 0);
                break;
            case "Eid":
                currentForm.Title = "تهنئة العيد المبارك 🎉🎈";
                currentForm.OccasionName = "الأعياد الرسمية";
                currentForm.RecurrenceType = ReminderRecurrenceType.Daily;
                currentForm.MessageSelectionMode = "RandomBank";
                currentForm.BankCategory = "مناسبات وأعياد";
                currentForm.DurationDays = 4;
                scheduledTimeVal = new TimeOnly(8, 30);
                break;
        }
    }

