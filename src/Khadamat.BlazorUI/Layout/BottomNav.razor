@implements IDisposable

<div class="bottom-nav">
    @if (!AppState.IsAuthenticated)
    {
        <!-- 1. GUEST (Matches Target Mockup Exactly) -->
        <NavLink class="nav-item" href="/" Match="NavLinkMatch.All">
            <i class="fa-solid fa-house"></i>
            <span>الرئيسية</span>
            <div class="active-indicator"></div>
        </NavLink>

        <NavLink class="nav-item" href="/favorites">
            <i class="fa-regular fa-heart"></i>
            <span>المفضلة</span>
            <div class="active-indicator"></div>
        </NavLink>

        <NavLink class="nav-item nav-notifications" href="/notifications">
            <div class="position-relative d-inline-block">
                <i class="fa-regular fa-bell"></i>
                <span class="nav-badge">3</span>
            </div>
            <span>الإشعارات</span>
            <div class="active-indicator"></div>
        </NavLink>

        <NavLink class="nav-item" href="/messages">
            <i class="fa-regular fa-comments"></i>
            <span>المحادثات</span>
            <div class="active-indicator"></div>
        </NavLink>

        <NavLink class="nav-item" href="/login">
            <i class="fa-regular fa-user"></i>
            <span>حسابي</span>
            <div class="active-indicator"></div>
        </NavLink>
    }
    else if (AppState.IsAdmin)
    {
        <!-- 4. ADMIN -->
        <NavLink class="nav-item" href="/" Match="NavLinkMatch.All">
            <i class="fa-solid fa-house"></i>
            <span>التطبيق</span>
            <div class="active-indicator"></div>
        </NavLink>

        <button class="nav-item @(GetActiveNavClass("/admin"))" @onclick='() => Navigate("/admin")'>
            <i class="fa-solid fa-chart-pie"></i>
            <span>لوحة المدير</span>
            <div class="active-indicator"></div>
        </button>

        <button class="nav-item @(GetActiveNavClass("/admin/approvals"))" @onclick='() => Navigate("/admin/approvals")'>
            <i class="fa-solid fa-shield-halved"></i>
            <span>الموافقات</span>
            <div class="active-indicator"></div>
        </button>

        <button class="nav-item @(GetActiveNavClass("/admin/complaints"))" @onclick='() => Navigate("/admin/complaints")'>
            <i class="fa-solid fa-headset"></i>
            <span>الشكاوى</span>
            <div class="active-indicator"></div>
        </button>

        <button class="nav-item @(GetActiveNavClass("/profile"))" @onclick='() => Navigate("/profile")'>
            <div class="nav-avatar-wrapper">
                <img src="@AppState.UserImageUrl" class="nav-user-avatar" alt="User" />
            </div>
            <span>الإدارة</span>
            <div class="active-indicator"></div>
        </button>
    }
    else if (AppState.IsProviderMode)
    {
        <!-- 3. SERVICE PROVIDER (Provider Mode active) -->
        <button class="nav-item @(GetActiveNavClass("/provider/dashboard"))" @onclick='() => Navigate("/provider/dashboard")'>
            <i class="fa-solid fa-chart-line"></i>
            <span>لوحة التحكم</span>
            <div class="active-indicator"></div>
        </button>

        <button class="nav-item @(GetActiveNavClass("/provider/my-services"))" @onclick='() => Navigate("/provider/my-services")'>
            <i class="fa-solid fa-briefcase"></i>
            <span>خدماتي</span>
            <div class="active-indicator"></div>
        </button>

        <button class="nav-item @(GetActiveNavClass("/provider/create-request"))" @onclick='() => Navigate("/provider/create-request")'>
            <i class="fa-solid fa-plus"></i>
            <span>أضف خدمة</span>
            <div class="active-indicator"></div>
        </button>

        <button class="nav-item @(GetActiveNavClass("/user/messages"))" @onclick='() => Navigate("/user/messages")'>
            <i class="fa-solid fa-comments"></i>
            <span>المحادثات</span>
            <div class="active-indicator"></div>
        </button>

        <button class="nav-item @(GetActiveNavClass("/profile"))" @onclick='() => Navigate("/profile")'>
            <div class="nav-avatar-wrapper">
                <img src="@AppState.UserImageUrl" class="nav-user-avatar" alt="User" />
            </div>
            <span>حسابي</span>
            <div class="active-indicator"></div>
        </button>
    }
    else
    {
        <!-- 2. CLIENT (Matches Target Mockup Exactly) -->
        <NavLink class="nav-item" href="/" Match="NavLinkMatch.All">
            <i class="fa-solid fa-house"></i>
            <span>الرئيسية</span>
            <div class="active-indicator"></div>
        </NavLink>

        <NavLink class="nav-item" href="/favorites">
            <i class="fa-regular fa-heart"></i>
            <span>المفضلة</span>
            <div class="active-indicator"></div>
        </NavLink>

        <NavLink class="nav-item nav-notifications" href="/notifications">
            <div class="position-relative d-inline-block">
                <i class="fa-regular fa-bell"></i>
                @if (AppState.NotificationCount > 0)
                {
                    <span class="nav-badge">@(AppState.NotificationCount > 99 ? "+99" : AppState.NotificationCount.ToString())</span>
                }
                else
                {
                    <span class="nav-badge">3</span>
                }
            </div>
            <span>الإشعارات</span>
            <div class="active-indicator"></div>
        </NavLink>

        <NavLink class="nav-item" href="/messages">
            <i class="fa-regular fa-comments"></i>
            <span>المحادثات</span>
            <div class="active-indicator"></div>
        </NavLink>

        <NavLink class="nav-item" href="/profile">
            @if (!string.IsNullOrEmpty(AppState.UserImageUrl))
            {
                <div class="nav-avatar-wrapper">
                    <img src="@AppState.UserImageUrl" class="nav-user-avatar" alt="User" />
                </div>
            }
            else
            {
                <i class="fa-regular fa-user"></i>
            }
            <span>حسابي</span>
            <div class="active-indicator"></div>
        </NavLink>
    }
</div>

@inject NavigationManager Navigation
@inject Khadamat.BlazorUI.State.AppState AppState
@inject Khadamat.BlazorUI.Services.Auth.IAuthService AuthService
@inject Microsoft.JSInterop.IJSRuntime JS

@code {
    private bool _disposed = false;

    protected override void OnInitialized()
    {
        AppState.OnChange += OnStateChange;
        Navigation.LocationChanged += HandleLocationChanged;
    }

    private async void OnStateChange()
    {
        if (_disposed) return;
        try { await InvokeAsync(StateHasChanged); }
        catch (ObjectDisposedException) { }
        catch (InvalidOperationException) { }
    }

    private async void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (_disposed) return;
        try { await InvokeAsync(StateHasChanged); }
        catch (ObjectDisposedException) { }
        catch (InvalidOperationException) { }
    }

    public void Dispose()
    {
        _disposed = true;
        AppState.OnChange -= OnStateChange;
        Navigation.LocationChanged -= HandleLocationChanged;
    }

    private void Navigate(string path)
    {
        Navigation.NavigateTo(path);
    }

    private void NavigateToAuthOr(string path)
    {
        if (AppState.IsAuthenticated)
        {
            Navigation.NavigateTo(path);
        }
        else
        {
            Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(path)}");
        }
    }

    private string GetActiveNavClass(string path)
    {
        var current = new Uri(Navigation.Uri).AbsolutePath;
        return current.Equals(path, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    }

    private string GetFirstName(string fullName)
    {
        if (string.IsNullOrEmpty(fullName)) return "حسابي";
        return fullName.Split(' ')[0];
    }

    private async Task HandleLogout()
    {
        await AuthService.Logout();
        Navigation.NavigateTo("/login");
    }
}

<style>
    .bottom-nav {
        display: none; /* Default hidden */
    }

    @@media (max-width: 991px) {
        .bottom-nav {
            display: flex;
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            height: 68px;
            background: rgba(255, 255, 255, 0.98);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-top: 1.5px solid rgba(226, 232, 240, 0.85);
            justify-content: space-around;
            align-items: center;
            z-index: 1100;
            padding-bottom: env(safe-area-inset-bottom);
            box-shadow: 0 -4px 20px rgba(0,0,0,0.05);
        }
        
        .nav-item {
            display: flex !important;
            flex-direction: column !important;
            align-items: center !important;
            justify-content: center !important;
            text-decoration: none !important;
            color: #64748b !important;
            font-size: 0.72rem !important;
            font-weight: 600 !important;
            transition: color 0.2s ease;
            width: 20%;
            height: 100%;
            gap: 2px;
            position: relative;
            padding-top: 6px;
        }

        .nav-item i {
            font-size: 1.25rem !important;
            display: block !important;
            color: inherit !important;
            margin-bottom: 2px !important;
            transition: transform 0.2s ease;
        }

        .nav-item span {
            display: block !important;
            line-height: 1.2;
        }

        .nav-item.active {
            color: #2563eb !important;
            font-weight: 800 !important;
        }

        .nav-item.active i {
            color: #2563eb !important;
            transform: translateY(-1px);
        }

        .active-indicator {
            display: none;
            width: 32px;
            height: 3px;
            background: #2563eb;
            border-radius: 3px 3px 0 0;
            position: absolute;
            bottom: 0;
        }

        .nav-item.active .active-indicator {
            display: block;
        }

        .nav-badge {
            position: absolute;
            top: -4px;
            right: -8px;
            background: #ef4444;
            color: white;
            font-size: 0.62rem;
            font-weight: 800;
            border-radius: 9999px;
            min-width: 17px;
            height: 17px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0 4px;
            border: 2px solid #ffffff;
            box-shadow: 0 2px 5px rgba(239, 68, 68, 0.4);
        }

        .nav-avatar-wrapper {
            width: 24px;
            height: 24px;
            margin-bottom: 2px;
        }

        .nav-user-avatar {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            object-fit: cover;
            border: none;
            box-shadow: 0 0 0 2px #2563eb;
        }

        button.nav-item {
            background: none;
            border: none;
            outline: none;
            box-shadow: none;
            padding: 0;
            color: inherit;
            font: inherit;
            -webkit-tap-highlight-color: transparent;
            cursor: pointer;
        }

        button.nav-item:focus,
        button.nav-item:focus-visible {
            outline: none;
            box-shadow: none;
            border: none;
        }
    }
</style>
