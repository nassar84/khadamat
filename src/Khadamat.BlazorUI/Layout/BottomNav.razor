@implements IDisposable

<div class="bottom-nav">
    @if (!AppState.IsAuthenticated)
    {
        <!-- 1. GUEST -->
        <NavLink class="nav-item" href="/" Match="NavLinkMatch.All">
            <i class="fa-solid fa-house"></i>
            <span>الرئيسية</span>
        </NavLink>

        <NavLink class="nav-item" href="/services">
            <i class="fa-solid fa-compass"></i>
            <span>الخدمات</span>
        </NavLink>

        <NavLink class="nav-item home-item" href="/provider/apply">
            <div class="home-circle">
                <i class="fa-solid fa-briefcase"></i>
            </div>
            <span>اعرض خدماتك</span>
        </NavLink>

        <NavLink class="nav-item" href="/contact">
            <i class="fa-solid fa-headset"></i>
            <span>تواصل معنا</span>
        </NavLink>

        <NavLink class="nav-item" href="/login">
            <i class="fa-solid fa-arrow-right-to-bracket"></i>
            <span>دخول</span>
        </NavLink>
    }
    else if (AppState.IsAdmin)
    {
        <!-- 4. ADMIN -->
        <NavLink class="nav-item" href="/" Match="NavLinkMatch.All">
            <i class="fa-solid fa-house"></i>
            <span>التطبيق</span>
        </NavLink>

        <button class="nav-item @(GetActiveNavClass("/admin"))" @onclick='() => Navigate("/admin")'>
            <i class="fa-solid fa-chart-pie"></i>
            <span>لوحة المدير</span>
        </button>

        <button class="nav-item home-item @(GetActiveNavClass("/admin/approvals"))" @onclick='() => Navigate("/admin/approvals")'>
            <div class="home-circle">
                <i class="fa-solid fa-shield-halved"></i>
            </div>
            <span>الموافقات</span>
        </button>

        <button class="nav-item @(GetActiveNavClass("/admin/complaints"))" @onclick='() => Navigate("/admin/complaints")'>
            <i class="fa-solid fa-headset"></i>
            <span>الشكاوى</span>
        </button>

        <button class="nav-item @(GetActiveNavClass("/profile"))" @onclick='() => Navigate("/profile")'>
            <div class="nav-avatar-wrapper">
                <img src="@AppState.UserImageUrl" class="nav-user-avatar" alt="User" />
            </div>
            <span>الإدارة</span>
        </button>
    }
    else if (AppState.IsProviderMode)
    {
        <!-- 3. SERVICE PROVIDER (Provider Mode active) -->
        <button class="nav-item @(GetActiveNavClass("/provider/dashboard"))" @onclick='() => Navigate("/provider/dashboard")'>
            <i class="fa-solid fa-chart-line"></i>
            <span>لوحة التحكم</span>
        </button>

        <button class="nav-item @(GetActiveNavClass("/provider/my-services"))" @onclick='() => Navigate("/provider/my-services")'>
            <i class="fa-solid fa-briefcase"></i>
            <span>خدماتي</span>
        </button>

        <button class="nav-item home-item @(GetActiveNavClass("/provider/create-request"))" @onclick='() => Navigate("/provider/create-request")'>
            <div class="home-circle">
                <i class="fa-solid fa-plus"></i>
            </div>
            <span>أضف خدمة</span>
        </button>

        <button class="nav-item @(GetActiveNavClass("/user/messages"))" @onclick='() => Navigate("/user/messages")'>
            <i class="fa-solid fa-comments"></i>
            <span>المحادثات</span>
        </button>

        <button class="nav-item @(GetActiveNavClass("/profile"))" @onclick='() => Navigate("/profile")'>
            <div class="nav-avatar-wrapper">
                <img src="@AppState.UserImageUrl" class="nav-user-avatar" alt="User" />
            </div>
            <span>حسابي</span>
        </button>
    }
    else
    {
        <!-- 2. CLIENT -->
        <NavLink class="nav-item" href="/" Match="NavLinkMatch.All">
            <i class="fa-solid fa-house"></i>
            <span>الرئيسية</span>
        </NavLink>

        <NavLink class="nav-item" href="/services">
            <i class="fa-solid fa-compass"></i>
            <span>الخدمات</span>
        </NavLink>

        <button class="nav-item home-item @(GetActiveNavClass("/user/my-requests"))" @onclick='() => Navigate("/user/my-requests")'>
            <div class="home-circle">
                <i class="fa-solid fa-list-check"></i>
            </div>
            <span>طلباتي</span>
        </button>

        <button class="nav-item @(GetActiveNavClass("/user/messages"))" @onclick='() => Navigate("/user/messages")'>
            <i class="fa-solid fa-comments"></i>
            <span>رسائلي</span>
        </button>

        <button class="nav-item @(GetActiveNavClass("/profile"))" @onclick='() => Navigate("/profile")'>
            <div class="nav-avatar-wrapper">
                <img src="@AppState.UserImageUrl" class="nav-user-avatar" alt="User" />
            </div>
            <span>حسابي</span>
        </button>
    }
</div>

@inject NavigationManager Navigation
@inject Khadamat.BlazorUI.State.AppState AppState
@inject Khadamat.BlazorUI.Services.Auth.IAuthService AuthService
@inject Microsoft.JSInterop.IJSRuntime JS

@code {
    private bool _disposed = false;

    protected override void OnInitialized()
    {
        AppState.OnChange += OnStateChange;
        Navigation.LocationChanged += HandleLocationChanged;
    }

    private async void OnStateChange()
    {
        if (_disposed) return;
        try { await InvokeAsync(StateHasChanged); }
        catch (ObjectDisposedException) { }
        catch (InvalidOperationException) { }
    }

    private async void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (_disposed) return;
        try { await InvokeAsync(StateHasChanged); }
        catch (ObjectDisposedException) { }
        catch (InvalidOperationException) { }
    }

    public void Dispose()
    {
        _disposed = true;
        AppState.OnChange -= OnStateChange;
        Navigation.LocationChanged -= HandleLocationChanged;
    }

    private void Navigate(string path)
    {
        Navigation.NavigateTo(path);
    }

    private void NavigateToAuthOr(string path)
    {
        if (AppState.IsAuthenticated)
        {
            Navigation.NavigateTo(path);
        }
        else
        {
            Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(path)}");
        }
    }

    private string GetActiveNavClass(string path)
    {
        var current = new Uri(Navigation.Uri).AbsolutePath;
        return current.Equals(path, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    }

    private string GetFirstName(string fullName)
    {
        if (string.IsNullOrEmpty(fullName)) return "حسابي";
        return fullName.Split(' ')[0];
    }

    private async Task HandleLogout()
    {
        await AuthService.Logout();
        Navigation.NavigateTo("/login");
    }
}

<style>
    .bottom-nav {
        display: none; /* Default hidden */
    }

    @@media (max-width: 991px) {
        .bottom-nav {
            display: flex;
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            height: 75px;
            background: rgba(255, 255, 255, 0.98);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-top: 2px solid rgba(0,0,0,0.04);
            justify-content: space-around;
            align-items: center;
            z-index: 1100;
            padding-bottom: env(safe-area-inset-bottom);
            box-shadow: 0 -8px 25px rgba(0,0,0,0.06);
            border-top-left-radius: 20px;
            border-top-right-radius: 20px;
        }
        
        .nav-item {
            display: flex !important;
            flex-direction: column !important;
            align-items: center !important;
            justify-content: center !important;
            text-decoration: none !important;
            color: var(--text-muted) !important;
            font-size: 0.68rem !important;
            font-weight: 700 !important;
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            width: 20%;
            height: 100%;
            gap: 4px;
            position: relative;
        }

        .home-item {
            margin-top: -35px;
        }

        .home-circle {
            width: 52px;
            height: 52px;
            background: linear-gradient(135deg, var(--theme-primary, #8b5cf6), var(--theme-secondary, #6366f1));
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 8px 15px rgba(139, 92, 246, 0.3);
            border: 4px solid white;
            transition: all 0.3s;
        }

        .home-circle i {
            color: white !important;
            font-size: 1.4rem !important;
            margin-bottom: 0 !important;
        }

        .home-item.active .home-circle {
            transform: scale(1.1) translateY(-3px);
            box-shadow: 0 10px 20px rgba(139, 92, 246, 0.4);
        }
        
        .nav-item.active {
            color: var(--theme-primary, #8b5cf6) !important;
        }
        
        .nav-item i:not(.home-circle i) {
            font-size: 1.25rem !important;
            display: block !important;
            color: inherit !important;
        }

        .nav-item span {
            display: block !important;
        }

        .nav-avatar-wrapper {
            width: 24px;
            height: 24px;
            margin-bottom: 2px;
        }

        .nav-user-avatar {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            object-fit: cover;
            border: none;
            box-shadow: 0 0 0 2px var(--theme-primary, #8b5cf6);
        }

        button.nav-item {
            background: none;
            border: none;
            outline: none;
            box-shadow: none;
            padding: 0;
            color: inherit;
            font: inherit;
            -webkit-tap-highlight-color: transparent;
            cursor: pointer;
        }

        button.nav-item:focus,
        button.nav-item:focus-visible {
            outline: none;
            box-shadow: none;
            border: none;
        }
    }
</style>
