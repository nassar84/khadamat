@implements IDisposable
@using Khadamat.BlazorUI.State
@inject AppState State
@inject NavigationManager Navigation
@inject IJSRuntime JS

<header class="mobile-header-premium">
    <div class="header-glass-content">
        <!-- Right Side (RTL): Avatar / Menu -->
        <div class="header-right">
            <AuthorizeView>
                <Authorized>
                    <div class="user-profile-header-premium" @onclick="ToggleSidebar">
                        <div class="avatar-header-wrapper">
                            <img src="@State.UserImageUrl" alt="Profile" class="user-header-avatar-premium" />
                            <div class="online-dot-small"></div>
                        </div>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <button class="menu-toggle-btn-glass" @onclick="ToggleSidebar">
                        <i class="fa-solid fa-bars-staggered"></i>
                    </button>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <!-- Center: Logo -->
        <div class="header-center" @onclick='() => NavigateTo("/")'>
            <div class="logo-wrapper-mobile">
                @if (!string.IsNullOrEmpty(State.AppLogo))
                {
                    <img src="@State.GetAbsoluteUrl(State.AppLogo)" class="logo-img-mobile" alt="Logo" style="height: 34px; width: auto; object-fit: contain;" />
                }
                else
                {
                    <img src="images/logo.png" class="logo-img-mobile" alt="Logo" style="height: 34px; width: auto; object-fit: contain;" />
                }
                <span class="logo-text-premium">@(string.IsNullOrEmpty(State.AppNameAr) ? State.AppName : State.AppNameAr)</span>
            </div>
        </div>

        <!-- Left Side (RTL): Theme, Messages, Notifications -->
        <div class="header-left" dir="rtl">
            
            <!-- Theme Toggle -->
            <div id="mobileThemeToggle" class="icon-btn-minimal theme-switcher-mobile" @onclick="ToggleThemeMenu" title="تغيير الثيم">
                <i class="fa-solid fa-palette text-secondary"></i>
                @if (isThemeMenuOpen)
                {
                    <div class="theme-popover-mobile animate-up" @onclick:stopPropagation="true" dir="rtl">
                        <div class="theme-grid-mobile">
                            <div class="theme-dot-mobile default @(State.CurrentTheme == "default" ? "active" : "")" @onclick='() => HandleSetTheme("default")'></div>
                            <div class="theme-dot-mobile sunset @(State.CurrentTheme == "sunset" ? "active" : "")" @onclick='() => HandleSetTheme("sunset")'></div>
                            <div class="theme-dot-mobile ocean @(State.CurrentTheme == "ocean" ? "active" : "")" @onclick='() => HandleSetTheme("ocean")'></div>
                            <div class="theme-dot-mobile forest @(State.CurrentTheme == "forest" ? "active" : "")" @onclick='() => HandleSetTheme("forest")'></div>
                            <div class="theme-dot-mobile lavender @(State.CurrentTheme == "lavender" ? "active" : "")" @onclick='() => HandleSetTheme("lavender")'></div>
                            <div class="theme-dot-mobile royal @(State.CurrentTheme == "royal" ? "active" : "")" @onclick='() => HandleSetTheme("royal")'></div>
                        </div>
                    </div>
                }
            </div>

            <!-- Messages -->
            <div class="icon-btn-minimal" @onclick='() => NavigateTo("/user/messages")' title="الرسائل">
                <i class="fa-solid fa-message text-primary"></i>
                @if (State.HasUnreadMessages)
                {
                    <span class="badge-dot danger"></span>
                }
            </div>

            <AuthorizeView>
                <Authorized>

                    <!-- Notifications -->
                    <div class="icon-btn-minimal" @onclick='() => NavigateTo("/user/notifications")' title="الإشعارات">
                        <i class="fa-regular fa-bell"></i>
                        @if (State.HasUnreadNotifications)
                        {
                            <span class="badge-dot"></span>
                        }
                    </div>
                </Authorized>
            </AuthorizeView>
        </div>
    </div>
</header>

<div class="mobile-search-bar px-3 pb-2" @onclick="GoToSearch">
    <div class="search-tap-btn">
        <div class="search-tap-inner">
            <div class="search-tap-icon-wrap">
                <i class="fa-solid fa-magnifying-glass"></i>
            </div>
            <span class="search-tap-placeholder">ابحث عن خدمة أو مهني...</span>
            <div class="search-tap-filter">
                <i class="fa-solid fa-sliders"></i>
            </div>
        </div>
    </div>
</div>
@* <CategoryMarquee /> *@


<style>
    .mobile-header-premium {
        position: sticky;
        top: 0;
        z-index: 1000;
        padding: 8px 15px;
        background: transparent;
    }

    .header-glass-content {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.3);
        border-radius: 20px;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 15px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
        direction: rtl;
    }

    .menu-toggle-btn-glass {
        background: rgba(var(--theme-primary-rgb), 0.1);
        border: none;
        color: var(--theme-primary);
        width: 40px;
        height: 40px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        transition: all 0.2s;
    }

    .logo-wrapper-mobile {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .header-right {
        display: flex;
        align-items: center;
        gap: 4px;
        flex-direction: row;
    }

    .logo-icon-glow {
        color: var(--theme-primary);
        font-size: 1.3rem;
        filter: drop-shadow(0 0 10px var(--theme-glow));
        animation: pulse-glow 2s infinite;
    }

    .logo-text-premium {
        font-weight: 900;
        font-size: 1.2rem;
        background: linear-gradient(135deg, var(--theme-primary), var(--theme-secondary));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        letter-spacing: -0.5px;
        position: relative;
        overflow: hidden;
    }

    .logo-text-premium::after {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 50%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
        animation: shimmer 3s infinite;
    }

    @@keyframes shimmer {
        0% { left: -100%; }
        100% { left: 200%; }
    }

    .user-profile-header-premium {
        display: flex;
        align-items: center;
        gap: 10px;
        cursor: pointer;
        background: rgba(255, 255, 255, 0.5);
        padding: 4px 4px 4px 12px;
        border-radius: 50px;
        border: 1px solid rgba(0, 0, 0, 0.03);
    }

    [dir="rtl"] .user-profile-header-premium {
        padding: 4px 12px 4px 4px;
    }

    .user-name-header {
        font-size: 0.8rem;
        font-weight: 800;
        color: #1e293b;
        max-width: 80px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .avatar-header-wrapper {
        position: relative;
    }

    .user-header-avatar-premium {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid white;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    }

    .online-dot-small {
        position: absolute;
        bottom: 1px;
        right: 1px;
        width: 8px;
        height: 8px;
        background: #22c55e;
        border-radius: 50%;
        border: 1.5px solid white;
    }

    .icon-btn-minimal {
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #64748b;
        font-size: 1.1rem;
        position: relative;
        cursor: pointer;
        transition: transform 0.2s, background 0.2s;
        border-radius: 12px;
    }
    
    .icon-btn-minimal:hover {
        background: rgba(0,0,0,0.05);
        transform: scale(1.05);
    }
    
    .icon-btn-minimal:active {
        transform: scale(0.95);
    }

    .marketplace-mobile-premium {
        color: #f43f5e !important;
        background: rgba(244, 63, 94, 0.1);
        border-radius: 10px;
    }

    .icon-pulse {
        animation: pulse-icon 2s infinite;
    }

    @@keyframes pulse-icon {
        0% { transform: scale(1); }
        50% { transform: scale(1.2); }
        100% { transform: scale(1); }
    }

    .btn-login-minimal {
        background: var(--theme-primary);
        color: white;
        border: none;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.9rem;
        box-shadow: 0 4px 12px var(--theme-glow);
    }

    .badge-dot {
        position: absolute;
        top: 8px;
        right: 8px;
        width: 8px;
        height: 8px;
        background: #ef4444;
        border-radius: 50%;
        border: 2px solid white;
    }
    .badge-dot.danger { background: #f43f5e; box-shadow: 0 0 5px rgba(244, 63, 94, 0.5); }

    .mobile-search-bar {
        background: transparent;
        margin-top: -5px;
        cursor: pointer;
    }

    /* ── New tap-to-search button ── */
    .search-tap-btn {
        width: 100%;
        padding: 0 5px;
    }

    .search-tap-inner {
        display: flex;
        align-items: center;
        gap: 10px;
        background: rgba(255, 255, 255, 0.92);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1.5px solid rgba(99, 102, 241, 0.25);
        border-radius: 18px;
        padding: 11px 14px;
        box-shadow: 0 4px 18px rgba(99, 102, 241, 0.1), 0 1px 4px rgba(0,0,0,0.04);
        transition: all 0.2s ease;
        direction: rtl;
    }

    .search-tap-inner:active {
        transform: scale(0.98);
        box-shadow: 0 2px 10px rgba(99, 102, 241, 0.15);
        background: rgba(245, 243, 255, 0.98);
    }

    .search-tap-icon-wrap {
        width: 34px;
        height: 34px;
        border-radius: 12px;
        background: linear-gradient(135deg, var(--theme-primary, #6366f1), var(--theme-secondary, #a855f7));
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 0.9rem;
        flex-shrink: 0;
        box-shadow: 0 3px 10px rgba(99, 102, 241, 0.35);
    }

    .search-tap-placeholder {
        flex: 1;
        font-size: 0.88rem;
        font-weight: 600;
        color: #94a3b8;
        text-align: right;
        user-select: none;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .search-tap-filter {
        width: 30px;
        height: 30px;
        border-radius: 10px;
        background: rgba(99, 102, 241, 0.08);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--theme-primary, #6366f1);
        font-size: 0.85rem;
        flex-shrink: 0;
    }
    .theme-switcher-mobile {
        position: relative;
    }

    .theme-popover-mobile {
        position: absolute;
        top: 110%;
        right: 0;
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        padding: 12px;
        border-radius: 18px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
        z-index: 1001;
        border: 1px solid rgba(0, 0, 0, 0.05);
        min-width: 150px;
    }

    .theme-grid-mobile {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
    }

    .theme-dot-mobile {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        border: 2px solid white;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        cursor: pointer;
        transition: transform 0.2s;
    }

    .theme-dot-mobile:active { transform: scale(0.9); }
    .theme-dot-mobile.active { border-color: var(--theme-primary); transform: scale(1.1); }

    .theme-dot-mobile.default { background: linear-gradient(135deg, #8e2de2, #4a00e0); }
    .theme-dot-mobile.sunset { background: linear-gradient(135deg, #ff4e50, #f9d423); }
    .theme-dot-mobile.ocean { background: linear-gradient(135deg, #00c6ff, #0072ff); }
    .theme-dot-mobile.forest { background: linear-gradient(135deg, #00f260, #0575e6); }
    .theme-dot-mobile.lavender { background: linear-gradient(135deg, #bf5af2, #5e5ce6); }
    .theme-dot-mobile.royal { background: linear-gradient(135deg, #f093fb, #f5576c); }

    .animate-up { animation: slideUp 0.3s ease-out; }
    @@keyframes slideUp { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>

@code {
    private bool isThemeMenuOpen;
    private bool _disposed = false;

    protected override void OnInitialized()
    {
        State.OnChange += OnStateChange;
    }

    private async void OnStateChange()
    {
        if (_disposed) return;
        try { await InvokeAsync(StateHasChanged); }
        catch (ObjectDisposedException) { }
        catch (InvalidOperationException) { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await SetupClickOutsideHandler();
        }
    }

    public void Dispose()
    {
        _disposed = true;
        State.OnChange -= OnStateChange;
    }

    private void GoToSearch()
    {
        NavigateTo("/search");
    }

    private void NavigateTo(string path)
    {
        // Preserve nativeapp/mobileapp params when in mobile app
        if (State.IsNativeApp || State.IsMobileApp)
        {
            var separator = path.Contains('?') ? "&" : "?";
            var param = State.IsNativeApp ? "nativeapp=1" : "mobileapp=1";
            Navigation.NavigateTo(path + separator + param);
        }
        else
        {
            Navigation.NavigateTo(path);
        }
    }

    private async Task SetupClickOutsideHandler()
    {
        await JS.InvokeVoidAsync("eval", @"
            if (!window.mobileHeaderClickHandlerAdded) {
                window.mobileHeaderClickHandlerAdded = true;
                document.addEventListener('click', function(event) {
                    const themeToggle = document.getElementById('mobileThemeToggle');
                    
                    if (themeToggle && !themeToggle.contains(event.target)) {
                        const themeMenu = themeToggle.querySelector('.theme-popover-mobile');
                        if (themeMenu) {
                            themeMenu.remove();
                        }
                    }
                });
            }
        ");
    }

    private void ToggleSidebar()
    {
        State.IsSidebarOpen = !State.IsSidebarOpen;
        State.TriggerStateChanged();
    }

    private void ToggleThemeMenu()
    {
        isThemeMenuOpen = !isThemeMenuOpen;
    }

    private async Task HandleSetTheme(string theme)
    {
        State.SetTheme(theme);
        try 
        {
            await JS.InvokeVoidAsync("setBodyTheme", theme);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error setting theme in MobileHeader: {ex.Message}");
        }
        isThemeMenuOpen = false;
    }
}
