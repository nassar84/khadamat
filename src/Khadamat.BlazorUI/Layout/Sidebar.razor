@using System.Security.Claims
@using Khadamat.BlazorUI.State
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization
@using Khadamat.BlazorUI.Shared.Components
@inject AppState State
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject Khadamat.BlazorUI.Services.Auth.IAuthService AuthService
@inject Khadamat.Shared.Interfaces.IShareService ShareService
@inject AuthenticationStateProvider AuthStateProvider
@implements IDisposable

<div class="app-sidebar @(IsCollapsed ? "collapsed" : "") d-none d-lg-flex" dir="rtl">
    <!-- Top Header -->
    <div class="sidebar-top-bar">
        <div class="logo-box" @onclick='() => NavigateTo("/")' style="cursor:pointer" title="@State.AppName">
            @if (!string.IsNullOrEmpty(State.AppLogo))
            {
                <img src="@State.GetAbsoluteUrl(State.AppLogo)" class="logo-img" alt="Logo" />
            }
            else
            {
                <img src="images/logo.png" class="logo-img" alt="Logo" />
            }
            @if (!IsCollapsed)
            {
                <span class="logo-text">@(string.IsNullOrEmpty(State.AppNameAr) ? State.AppName : State.AppNameAr)</span>
            }
        </div>
        <button class="collapse-btn" @onclick="ToggleCollapse" title="@(IsCollapsed ? "توسيع الشريط" : "تصغير الشريط")">
            <i class="fa-solid @(IsCollapsed ? "fa-chevron-left" : "fa-chevron-right")"></i>
        </button>
    </div>

    @if (_isAuthenticated)
    {
        <!-- User Profile Header Banner -->
        @if (!IsCollapsed)
        {
            <div class="sidebar-top-modern profile-header animate-fade-in" @onclick='() => NavigateTo("/profile")'>
                <div class="user-brief-modern-row">
                    <div class="user-info-modern-left">
                        <span class="welcome-text">مرحباً بك،</span>
                        <span class="user-name-title" title="@State.UserName">@(!string.IsNullOrEmpty(State.UserName) ? State.UserName : "مستخدم")</span>
                        <span class="user-role-badge @GetRoleBadgeClass()">@DisplayName</span>
                    </div>
                    <div class="avatar-circle-shadow">
                        <img src="@State.UserImageUrl" class="user-avatar-modern" alt="Avatar" />
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="collapsed-avatar-box my-3" @onclick='() => NavigateTo("/profile")' title="@State.UserName (@DisplayName)">
                <img src="@State.UserImageUrl" class="collapsed-avatar" alt="Avatar" />
            </div>
        }

        <!-- Provider Request Banner (Only for regular clients - NEVER for Admins or Providers) -->
        @if (!_isAdmin && !_isProvider)
        {
            @if (!IsCollapsed)
            {
                <div class="px-3 pt-3 pb-1 animate-fade-in">
                    <div class="p-3 rounded-4 shadow-sm text-white d-flex align-items-center justify-content-between cursor-pointer"
                         style="background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);"
                         @onclick='() => NavigateTo("/provider/create-request")'>
                        <div>
                            <div class="fw-bold mb-1" style="font-size: 0.95rem;">صنايعي أو صاحب مهنة؟</div>
                            <div class="opacity-90 mb-2" style="font-size: 0.75rem;">اعرض خدماتك الآن وزود دخلك معانا</div>
                            <span class="badge bg-white text-primary rounded-pill px-3 py-1 fw-bold">اعرض خدماتك ←</span>
                        </div>
                        <div class="bg-white bg-opacity-20 rounded-circle p-2 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 44px; height: 44px;">
                            <i class="fa-solid fa-briefcase fs-5 text-white"></i>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="text-center my-2">
                    <button class="btn btn-sm btn-primary rounded-circle shadow-sm" style="width: 44px; height: 44px;" 
                            @onclick='() => NavigateTo("/provider/create-request")' title="اعرض خدماتك وزود دخلك">
                        <i class="fa-solid fa-briefcase"></i>
                    </button>
                </div>
            }
        }
    }
    else
    {
        @if (!IsCollapsed)
        {
            <div class="guest-banner px-3 pt-3 pb-2 text-center animate-fade-in">
                <p class="section-title mb-0">إكتشف @State.AppName</p>
            </div>
        }
    }

    <!-- Scrollable Menu Content -->
    <div class="sidebar-content">
        @if (_isAuthenticated)
        {
            @if (_isAdmin)
            {
                <!-- ==================== 1. دور الإدارة (SuperAdmin / SystemAdmin) ==================== -->
                <div class="menu-section">
                    <div class="section-label">لوحة الإدارة والتحكم</div>
                    <NavLink class="menu-item admin-link-premium" href="/admin" Match="NavLinkMatch.All" title="لوحة المدير">
                        <i class="fa-solid fa-chart-pie text-primary"></i>
                        <span class="item-label fw-bold">لوحة المدير</span>
                    </NavLink>
                    <NavLink class="menu-item approvals-highlight" href="/admin/approvals" title="مركز الموافقات">
                        <i class="fa-solid fa-shield-halved text-warning"></i>
                        <span class="item-label fw-bold">مركز الموافقات ⚡</span>
                        @if (!IsCollapsed && State.PendingApprovalsCount > 0)
                        {
                            <span class="badge rounded-pill bg-danger ms-auto px-2 py-1">@State.PendingApprovalsCount</span>
                        }
                    </NavLink>
                    <NavLink class="menu-item" href="/admin/ads" title="إدارة الإعلانات">
                        <i class="fa-solid fa-rectangle-ad text-primary"></i>
                        <span class="item-label">إدارة الإعلانات</span>
                    </NavLink>
                    <NavLink class="menu-item" href="/admin/users" title="إدارة المستخدمين">
                        <i class="fa-solid fa-users text-primary"></i>
                        <span class="item-label">إدارة المستخدمين</span>
                    </NavLink>
                    <NavLink class="menu-item" href="/admin/approvals/providers" title="اعتماد مقدمي الخدمات">
                        <i class="fa-solid fa-user-check text-primary"></i>
                        <span class="item-label">اعتماد مقدمي الخدمات</span>
                    </NavLink>
                    <NavLink class="menu-item" href="/admin/services" title="إدارة الخدمات">
                        <i class="fa-solid fa-briefcase text-primary"></i>
                        <span class="item-label">إدارة الخدمات</span>
                    </NavLink>
                    <NavLink class="menu-item" href="/admin/categories" title="التصنيفات">
                        <i class="fa-solid fa-th-large text-primary"></i>
                        <span class="item-label">التصنيفات والأقسام</span>
                    </NavLink>
                    <NavLink class="menu-item" href="/admin/locations" title="المناطق">
                        <i class="fa-solid fa-map-marker-alt text-primary"></i>
                        <span class="item-label">المناطق والمحافظات</span>
                    </NavLink>
                    <NavLink class="menu-item" href="/admin/complaints" title="الشكاوى والبلاغات">
                        <i class="fa-solid fa-headset text-danger"></i>
                        <span class="item-label">الشكاوى والبلاغات</span>
                    </NavLink>
                    <NavLink class="menu-item" href="/admin/reports" title="التقارير">
                        <i class="fa-solid fa-file-alt text-primary"></i>
                        <span class="item-label">التقارير والإحصائيات</span>
                    </NavLink>
                    <NavLink class="menu-item" href="/admin/settings" title="إعدادات لوحة التحكم">
                        <i class="fa-solid fa-cogs text-primary"></i>
                        <span class="item-label">إعدادات لوحة التحكم</span>
                    </NavLink>
                    @if (_isSuperAdmin)
                    {
                        <NavLink class="menu-item" href="/admin/systemsettings" title="إعدادات الموقع والتطبيق">
                            <i class="fa-solid fa-gears text-primary"></i>
                            <span class="item-label">إعدادات الموقع والتطبيق</span>
                        </NavLink>
                        <NavLink class="menu-item" href="/admin/auditlogs" title="سجلات النشاط">
                            <i class="fa-solid fa-shield-halved text-primary"></i>
                            <span class="item-label">سجلات النشاط والأمان</span>
                        </NavLink>
                    }
                </div>

                <div class="menu-section">
                    <div class="section-label">تصفح المنصة</div>
                    <NavLink class="menu-item" href="/" Match="NavLinkMatch.All" title="الرئيسية">
                        <i class="fa-solid fa-house"></i>
                        <span class="item-label">الرئيسية</span>
                    </NavLink>
                    <NavLink class="menu-item" href="/services" title="استكشاف الخدمات">
                        <i class="fa-solid fa-compass text-primary"></i>
                        <span class="item-label">استكشاف الخدمات</span>
                    </NavLink>
                    <NavLink class="menu-item" href="/categories" title="الأقسام والتصنيفات">
                        <i class="fa-solid fa-th-large text-info"></i>
                        <span class="item-label">الأقسام والتصنيفات</span>
                    </NavLink>
                    <div class="menu-item cursor-pointer" @onclick="RefreshApp" title="تحديث الموقع">
                        <i class="fa-solid fa-rotate"></i>
                        <span class="item-label">تحديث الموقع</span>
                    </div>
                </div>
            }
            else if (_isProvider)
            {
                <!-- ==================== 2. دور صاحب الخدمة / المزود ==================== -->
                <div class="menu-section">
                    <div class="section-label">إدارة أعمالي وخدماتي</div>
                    <NavLink class="menu-item" href="/provider/dashboard" Match="NavLinkMatch.All" title="لوحة صاحب الخدمة">
                        <i class="fa-solid fa-gauge-high text-primary"></i>
                        <span class="item-label fw-bold">لوحة صاحب الخدمة</span>
                    </NavLink>
                    <NavLink class="menu-item add-service-highlight" href="/provider/create-request" title="أضف خدمة جديدة">
                        <i class="fa-solid fa-circle-plus text-primary"></i>
                        <span class="item-label fw-bold">أضف خدمة جديدة ➕</span>
                    </NavLink>
                    <NavLink class="menu-item" href="/provider/incoming-requests" title="طلبات العملاء الواردة">
                        <i class="fa-solid fa-inbox text-primary"></i>
                        <span class="item-label">طلبات العملاء الواردة</span>
                    </NavLink>
                    <NavLink class="menu-item" href="/provider/my-services" title="خدماتي الحالية">
                        <i class="fa-solid fa-briefcase text-primary"></i>
                        <span class="item-label">خدماتي الحالية</span>
                    </NavLink>
                    <NavLink class="menu-item" href="/provider/statistics" title="الإحصائيات">
                        <i class="fa-solid fa-chart-line text-success"></i>
                        <span class="item-label">إحصائيات المشاهدات</span>
                    </NavLink>
                    <NavLink class="menu-item" href="/provider/referrals" title="نظام الإحالة">
                        <i class="fa-solid fa-users-viewfinder text-primary"></i>
                        <span class="item-label text-primary fw-bold">نظام الإحالة</span>
                    </NavLink>
                    <NavLink class="menu-item" href="/provider/ad-analytics" title="إحصائيات الإعلانات">
                        <i class="fa-solid fa-chart-pie text-success"></i>
                        <span class="item-label text-success fw-bold">إحصائيات الإعلانات</span>
                    </NavLink>
                    <NavLink class="menu-item" href="/provider/subscription" title="اشتراكي">
                        <i class="fa-solid fa-gem text-warning"></i>
                        <span class="item-label">اشتراكي وباقاتي</span>
                    </NavLink>
                    <NavLink class="menu-item" href="/provider/settings" title="إعدادات صاحب الخدمة">
                        <i class="fa-solid fa-sliders text-secondary"></i>
                        <span class="item-label">إعدادات صاحب الخدمة</span>
                    </NavLink>
                </div>

                <div class="menu-section">
                    <div class="section-label">نشاطي وتواصلي</div>
                    <NavLink class="menu-item" href="/user/messages" title="رسائلي ومحادثاتي">
                        <i class="fa-solid fa-envelope text-secondary"></i>
                        <span class="item-label">رسائلي ومحادثاتي</span>
                    </NavLink>
                    <NavLink class="menu-item" href="/user/notifications" title="الإشعارات">
                        <i class="fa-solid fa-bell text-secondary"></i>
                        <span class="item-label">الإشعارات</span>
                        @if (!IsCollapsed && State.NotificationCount > 0)
                        {
                            <span class="badge rounded-pill bg-danger ms-auto px-2 py-1">@State.NotificationCount</span>
                        }
                    </NavLink>
                    <NavLink class="menu-item" href="/user/my-requests" title="طلباتي كعميل">
                        <i class="fa-solid fa-list-check text-secondary"></i>
                        <span class="item-label">طلباتي كعميل</span>
                    </NavLink>
                    <NavLink class="menu-item" href="/client/favorites" title="المفضلة">
                        <i class="fa-solid fa-heart text-danger"></i>
                        <span class="item-label">المفضلة</span>
                    </NavLink>
                </div>

                <div class="menu-section">
                    <div class="section-label">استكشاف المنصة</div>
                    <NavLink class="menu-item" href="/" Match="NavLinkMatch.All" title="الرئيسية">
                        <i class="fa-solid fa-house"></i>
                        <span class="item-label">الرئيسية</span>
                    </NavLink>
                    <NavLink class="menu-item" href="/services" title="استكشاف الخدمات">
                        <i class="fa-solid fa-compass text-primary"></i>
                        <span class="item-label">استكشاف الخدمات</span>
                    </NavLink>
                    <NavLink class="menu-item" href="/categories" title="الأقسام والتصنيفات">
                        <i class="fa-solid fa-th-large text-info"></i>
                        <span class="item-label">الأقسام والتصنيفات</span>
                    </NavLink>
                    <div class="menu-item cursor-pointer" @onclick="RefreshApp" title="تحديث الموقع">
                        <i class="fa-solid fa-rotate"></i>
                        <span class="item-label">تحديث الموقع</span>
                    </div>
                </div>
            }
            else
            {
                <!-- ==================== 3. دور العميل / المستخدم العادي ==================== -->
                <div class="menu-section">
                    <div class="section-label">نشاطي وطلباتي</div>
                    <NavLink class="menu-item" href="/user/my-requests" title="طلباتي">
                        <i class="fa-solid fa-list-check text-primary"></i>
                        <span class="item-label fw-bold">طلباتي</span>
                    </NavLink>
                    <NavLink class="menu-item" href="/user/messages" title="رسائلي ومحادثاتي">
                        <i class="fa-solid fa-envelope text-secondary"></i>
                        <span class="item-label">رسائلي ومحادثاتي</span>
                    </NavLink>
                    <NavLink class="menu-item" href="/user/notifications" title="الإشعارات">
                        <i class="fa-solid fa-bell text-secondary"></i>
                        <span class="item-label">الإشعارات</span>
                        @if (!IsCollapsed && State.NotificationCount > 0)
                        {
                            <span class="badge rounded-pill bg-danger ms-auto px-2 py-1">@State.NotificationCount</span>
                        }
                    </NavLink>
                    <NavLink class="menu-item" href="/client/favorites" title="المفضلة">
                        <i class="fa-solid fa-heart text-danger"></i>
                        <span class="item-label">الخدمات المفضلة</span>
                    </NavLink>
                </div>

                <div class="menu-section">
                    <div class="section-label">تصفح الخدمات</div>
                    <NavLink class="menu-item" href="/" Match="NavLinkMatch.All" title="الرئيسية">
                        <i class="fa-solid fa-house"></i>
                        <span class="item-label">الرئيسية</span>
                    </NavLink>
                    <NavLink class="menu-item" href="/services" title="استكشاف الخدمات">
                        <i class="fa-solid fa-compass text-primary"></i>
                        <span class="item-label">استكشاف الخدمات</span>
                    </NavLink>
                    <NavLink class="menu-item" href="/categories" title="الأقسام والتصنيفات">
                        <i class="fa-solid fa-th-large text-info"></i>
                        <span class="item-label">الأقسام والتصنيفات</span>
                    </NavLink>
                    <NavLink class="menu-item" href="/explore" title="استكشف">
                        <i class="fa-solid fa-layer-group text-warning"></i>
                        <span class="item-label">استكشف</span>
                    </NavLink>
                    <div class="menu-item cursor-pointer" @onclick="RefreshApp" title="تحديث الموقع">
                        <i class="fa-solid fa-rotate"></i>
                        <span class="item-label">تحديث الموقع</span>
                    </div>
                </div>
            }

            <!-- المشترك لجميع المستخدمين المسجلين: الحساب والخروج -->
            <div class="menu-section mt-auto">
                <div class="section-label">الحساب والمساعدة</div>
                <NavLink class="menu-item" href="/profile" title="الملف الشخصي">
                    <i class="fa-solid fa-user-gear text-secondary"></i>
                    <span class="item-label">الملف الشخصي</span>
                </NavLink>
                <NavLink class="menu-item" href="/contact" title="تواصل معنا">
                    <i class="fa-solid fa-headset text-success"></i>
                    <span class="item-label">تواصل معنا</span>
                </NavLink>
                <NavLink class="menu-item" href="/support" title="الدعم والمساعدة">
                    <span class="item-icon">🆘</span>
                    <span class="item-label">الدعم والمساعدة</span>
                </NavLink>
                <div class="menu-item logout-item-new mt-2 cursor-pointer" @onclick="HandleLogout" title="تسجيل الخروج">
                    <i class="fa-solid fa-power-off text-danger"></i>
                    <span class="item-label text-danger fw-bold">تسجيل الخروج</span>
                </div>
            </div>
        }
        else
        {
            <!-- ==================== 4. قائمة الزوار (Guest) ==================== -->
            <div class="menu-section">
                <div class="section-label">استكشاف المنصة</div>
                <NavLink class="menu-item" href="/" Match="NavLinkMatch.All" title="الرئيسية">
                    <i class="fa-solid fa-house"></i>
                    <span class="item-label">الرئيسية</span>
                </NavLink>
                <NavLink class="menu-item" href="/services" title="استكشاف الخدمات">
                    <i class="fa-solid fa-compass text-primary"></i>
                    <span class="item-label">استكشاف الخدمات</span>
                </NavLink>
                <NavLink class="menu-item" href="/categories" title="الأقسام والتصنيفات">
                    <i class="fa-solid fa-th-large text-info"></i>
                    <span class="item-label">الأقسام والتصنيفات</span>
                </NavLink>
                <NavLink class="menu-item" href="/feed" title="آخر التحديثات">
                    <i class="fa-regular fa-newspaper text-info"></i>
                    <span class="item-label">آخر التحديثات</span>
                </NavLink>
                <NavLink class="menu-item" href="/contact" title="تواصل معنا">
                    <i class="fa-solid fa-headset text-success"></i>
                    <span class="item-label">تواصل معنا</span>
                </NavLink>
                <div class="menu-item cursor-pointer" @onclick="RefreshApp" title="تحديث الموقع">
                    <i class="fa-solid fa-rotate"></i>
                    <span class="item-label">تحديث الموقع</span>
                </div>
            </div>

            @if (!IsCollapsed)
            {
                <!-- كارت الانضمام للزوار -->
                <div class="px-2 mt-3 animate-fade-in">
                    <div class="join-card-web">
                        <div class="join-icon-circle">
                            <i class="fa-solid fa-user-plus"></i>
                        </div>
                        <h5 class="join-title">انضم إلينا الآن</h5>
                        <p class="join-subtitle">سجل دخولك لتتمكن من طلب الخدمات والتواصل مع المزودين</p>
                        <div class="d-flex gap-2 mt-3">
                            <button class="btn-join-primary flex-fill" @onclick='() => NavigateTo("/login")'>دخول</button>
                            <button class="btn-join-outline flex-fill" @onclick='() => NavigateTo("/login?tab=register")'>حساب جديد</button>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="text-center my-3">
                    <button class="btn btn-primary rounded-circle shadow-sm mb-2" style="width: 44px; height: 44px;" 
                            @onclick='() => NavigateTo("/login")' title="تسجيل الدخول">
                        <i class="fa-solid fa-sign-in-alt"></i>
                    </button>
                    <button class="btn btn-outline-primary rounded-circle shadow-sm" style="width: 44px; height: 44px;" 
                            @onclick='() => NavigateTo("/login?tab=register")' title="إنشاء حساب">
                        <i class="fa-solid fa-user-plus"></i>
                    </button>
                </div>
            }
        }

        <!-- Sidebar Ad Banner Slot -->
        @if (!IsCollapsed)
        {
            <div class="mt-4 px-2 pb-2">
                <Khadamat.BlazorUI.Components.Ads.AdLocation Placement="Sidebar" />
            </div>
        }
    </div>

    <!-- Bottom Footer Section -->
    <div class="sidebar-bottom">
        @if (!IsCollapsed)
        {
            <div class="px-2 mb-3">
                <AppShareCard ShowTagline="true" ShowStoreButtons="false" OnShareClicked="ShareApp" />
            </div>
            <div class="sidebar-links mb-2 px-2 d-flex flex-wrap justify-content-center gap-2">
                <a href="/contact" class="text-muted text-decoration-none smaller">تواصل معنا</a>
                <span class="text-muted opacity-50">•</span>
                <a href="/about" class="text-muted text-decoration-none smaller">من نحن</a>
                <span class="text-muted opacity-50">•</span>
                <a href="/terms" class="text-muted text-decoration-none smaller">الشروط</a>
                <span class="text-muted opacity-50">•</span>
                <a href="/privacy" class="text-muted text-decoration-none smaller">الخصوصية</a>
            </div>
            @* app-version removed *@
        }
        else
        {
            <div class="text-center">
                <button class="btn btn-sm btn-light rounded-circle shadow-sm" @onclick="ShareApp" title="مشاركة التطبيق">
                    <i class="fa-solid fa-share-nodes text-primary"></i>
                </button>
            </div>
        }
    </div>
</div>

<style>
    .app-sidebar {
        width: 280px;
        height: 100vh;
        background: #ffffff;
        border-left: 1px solid rgba(0, 0, 0, 0.06);
        display: flex;
        flex-direction: column;
        transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        position: sticky;
        top: 0;
        z-index: 1001;
        box-shadow: -4px 0 20px rgba(0, 0, 0, 0.04);
        direction: rtl;
        overflow: hidden;
    }

    .app-sidebar.collapsed {
        width: 80px;
    }

    .sidebar-top-bar {
        padding: 16px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid rgba(0, 0, 0, 0.04);
    }

    .collapsed .sidebar-top-bar {
        padding: 16px 12px;
        justify-content: center;
        flex-direction: column;
        gap: 12px;
    }

