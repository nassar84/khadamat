@using Khadamat.BlazorUI.State
@using Khadamat.BlazorUI.Services.Auth
@inject AppState State
@inject IJSRuntime JSRuntime
@inject IAuthService AuthService
@inject NavigationManager Navigation
@implements IDisposable
<header class="app-header-premium container-fluid" style="display: block; padding: 0;">
    <div class="header-inner-container h-100 mx-auto d-flex align-items-center justify-content-between gap-4" style="max-width: 1200px; padding: 0 20px;">
        
        <!-- Search Section (Expanded & Elegant) -->
        <div class="header-search-section flex-grow-1 d-flex align-items-center" style="max-width: 600px;">
            <div class="search-container-glass w-100">
                <i class="fa-solid fa-magnifying-glass search-icon opacity-50"></i>
                <input type="text" placeholder="ابحث عن خدمة، تاجر، أو صنايعي..." class="search-input" />
                <kbd class="search-shortcut d-none d-md-block">⌘K</kbd>
            </div>
        </div>

        <!-- Actions & Profile Section -->
        <div class="header-actions-section d-flex align-items-center gap-2 gap-md-3">
            
            <!-- Theme Toggle -->
            <div id="themeToggle" class="icon-action-btn position-relative" @onclick="ToggleThemeMenu" title="تغيير الثيم">
                <i class="fa-solid fa-palette text-secondary"></i>
                <div class="theme-popover @(isThemeMenuOpen ? "show" : "")">
                     <div class="theme-grid-minimal">
                        <button class="theme-dot default @(State.CurrentTheme == "default" ? "active" : "")" @onclick='() => HandleSetTheme("default")'></button>
                        <button class="theme-dot sunset @(State.CurrentTheme == "sunset" ? "active" : "")" @onclick='() => HandleSetTheme("sunset")'></button>
                        <button class="theme-dot ocean @(State.CurrentTheme == "ocean" ? "active" : "")" @onclick='() => HandleSetTheme("ocean")'></button>
                        <button class="theme-dot forest @(State.CurrentTheme == "forest" ? "active" : "")" @onclick='() => HandleSetTheme("forest")'></button>
                        <button class="theme-dot lavender @(State.CurrentTheme == "lavender" ? "active" : "")" @onclick='() => HandleSetTheme("lavender")'></button>
                        <button class="theme-dot royal @(State.CurrentTheme == "royal" ? "active" : "")" @onclick='() => HandleSetTheme("royal")'></button>
                    </div>
                </div>
            </div>

            <div class="vr mx-1 opacity-25 d-none d-md-block"></div>

            <!-- Messages -->
            <div class="icon-action-btn position-relative" @onclick='() => Navigation.NavigateTo("/user/messages")' title="الرسائل">
                <i class="fa-regular fa-envelope text-secondary"></i>
                @if (State.HasUnreadMessages)
                {
                    <span class="notification-badge bg-danger"></span>
                }
            </div>

            <!-- Notifications -->
            <div class="icon-action-btn position-relative" @onclick='() => Navigation.NavigateTo("/user/notifications")' title="الإشعارات">
                <i class="fa-regular fa-bell text-secondary"></i>
                @if (State.HasUnreadNotifications)
                {
                    <span class="notification-badge bg-primary"></span>
                }
            </div>

            <!-- User Profile (Minimal - Avatar Only in Bar) -->
            <AuthorizeView>
                <Authorized>
                    <div id="userDropdown" class="user-dropdown-wrapper position-relative ms-2">
                        <div class="user-trigger p-1 rounded-circle border border-2 border-white shadow-sm pointer position-relative" @onclick="ToggleUserMenu">
                            <img src="@(string.IsNullOrEmpty(State.UserImageUrl) ? "images/defaults/default-user.png" : State.UserImageUrl)" 
                                 class="rounded-circle object-fit-cover" 
                                 alt="Avatar" style="width: 42px; height: 42px;" />
                             <div class="online-status-dot"></div>
                        </div>

                        <div class="user-glass-menu @(isUserMenuOpen ? "show" : "")">
                            <div class="menu-header d-flex align-items-center p-3 border-bottom">
                                <img src="@(string.IsNullOrEmpty(State.UserImageUrl) ? "images/defaults/default-user.png" : State.UserImageUrl)" 
                                     class="rounded-3 me-3" style="width: 48px; height: 48px; object-fit: cover;" />
                                <div class="flex-grow-1 overflow-hidden">
                                    <div class="fw-bold text-dark text-truncate">@context.User.Identity?.Name</div>
                                    <div class="small text-muted text-truncate">@context.User.FindFirst("email")?.Value</div>
                                    <div class="d-flex align-items-center mt-1">
                                        <span class="badge bg-light text-dark border border-secondary border-opacity-25 rounded-pill fw-normal px-2 py-0" style="font-size: 0.7rem;">
                                            @(State.IsProvider ? "مزود خدمة" : "عميل")
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="p-2">
                                <a href="/profile" class="menu-link-item d-flex align-items-center p-2 rounded-2 text-decoration-none text-dark mb-1" @onclick="CloseMenus">
                                    <i class="fa-regular fa-id-card me-3 opacity-50 ms-1 width-20 text-center"></i>
                                    <span class="small fw-bold">الملف الشخصي</span>
                                </a>
                                <div class="menu-link-item d-flex align-items-center p-2 rounded-2 text-danger pointer" @onclick="HandleLogout">
                                    <i class="fa-solid fa-arrow-right-from-bracket me-3 opacity-50 ms-1 width-20 text-center"></i>
                                    <span class="small fw-bold">تسجيل الخروج</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </Authorized>
                <NotAuthorized Context="notAuth">
                     <a href="login" class="btn btn-primary btn-sm rounded-pill px-4 fw-bold shadow-sm">دخول</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</header>




@if (isUserMenuOpen || isThemeMenuOpen)
{
    <div class="menu-backdrop" @onclick="CloseMenus"></div>
}

<style>
    /* Header Styles */
    :root {
        --header-height: 72px;
    }
    
    .app-header-premium {
        height: var(--header-height);
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        position: sticky;
        top: 0;
        z-index: 1000;
        transition: all 0.3s ease;
        border-bottom: 1px solid rgba(0,0,0,0.04);
    }

    .search-container-glass {
        background: #f1f5f9;
        border: 1px solid transparent;
        border-radius: 14px;
        padding: 10px 18px;
        transition: all 0.25s ease;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .search-container-glass:focus-within {
        background: white;
        border-color: var(--theme-primary);
        box-shadow: 0 4px 12px rgba(var(--theme-primary-rgb), 0.08);
        transform: translateY(-1px);
    }
    
    .search-input {
        border: none;
        background: transparent;
        outline: none;
        flex-grow: 1;
        font-size: 0.95rem;
        color: #1e293b;
        font-weight: 500;
    }

    .search-input::placeholder {
        color: #94a3b8;
        font-weight: 400;
    }
    
    .icon-action-btn {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        color: #64748b;
        transition: all 0.2s;
        background: transparent;
        cursor: pointer;
    }
    
    .icon-action-btn:hover {
        background: #f8fafc;
        color: var(--theme-primary);
        transform: translateY(-1px);
    }

    .notification-badge {
        position: absolute;
        top: 10px;
        right: 10px;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        border: 2px solid white;
    }
    
    .online-status-dot {
        position: absolute;
        bottom: 2px;
        right: 2px;
        width: 12px;
        height: 12px;
        background: #10b981;
        border: 2px solid white;
        border-radius: 50%;
        box-shadow: 0 1px 2px rgba(0,0,0,0.1);
    }

    /* Menus & Dropdowns */
    .user-glass-menu, .theme-popover {
        position: absolute;
        top: calc(100% + 12px);
        background: white;
        border: 1px solid rgba(0,0,0,0.06);
        border-radius: 16px;
        box-shadow: 0 20px 40px -5px rgba(0,0,0,0.12), 0 8px 16px -8px rgba(0,0,0,0.08);
        opacity: 0;
        visibility: hidden;
        transform: translateY(10px);
        transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        z-index: 1002;
    }

    .user-glass-menu {
        right: 0;
        left: auto;
        min-width: 280px;
        padding: 0;
        overflow: hidden;
    }

    .theme-popover {
        left: 50%;
        transform: translateX(-50%) translateY(10px);
        width: 220px;
        padding: 12px;
    }

    [dir="rtl"] .user-glass-menu {
        right: auto;
        left: 0;
    }

    .theme-popover.show, .user-glass-menu.show {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
    }

    .theme-popover.show {
        transform: translateX(-50%) translateY(0);
    }
    
    .menu-link-item {
        transition: background 0.2s;
        color: #334155;
    }
    
    .menu-link-item:hover {
        background: #f8fafc;
        color: var(--theme-primary);
    }

    .width-20 { width: 20px; }
    
    /* Theme Dots */
    .theme-grid-minimal {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 8px;
    }

    .theme-dot {
        width: 100%;
        aspect-ratio: 1;
        border-radius: 10px; /* Slight square for modern look */
        border: 2px solid transparent;
        cursor: pointer;
        transition: all 0.2s;
    }
    .theme-dot:hover { transform: scale(1.05); }
    .theme-dot.active { border-color: #0f172a; transform: scale(0.95); }
    
    .default { background: linear-gradient(135deg, #2563eb, #1d4ed8); }
    .sunset { background: linear-gradient(135deg, #f59e0b, #ea580c); }
    .ocean { background: linear-gradient(135deg, #0ea5e9, #0284c7); }
    .forest { background: linear-gradient(135deg, #10b981, #059669); }
    .lavender { background: linear-gradient(135deg, #8b5cf6, #7c3aed); }
    .royal { background: linear-gradient(135deg, #e11d48, #be123c); }
</style>

@code {
    private bool isThemeMenuOpen = false;
    private bool isUserMenuOpen = false;
    private string DisplayName => State.IsProvider ? "مزود خدمة" : "عميل";

    protected override void OnInitialized()
    {
        State.OnChange += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("document.body.setAttribute", "data-theme", State.CurrentTheme);
        }
    }

    public void Dispose()
    {
        State.OnChange -= StateHasChanged;
    }



    private void ToggleThemeMenu() 
    {
        isThemeMenuOpen = !isThemeMenuOpen;
        if (isThemeMenuOpen) isUserMenuOpen = false;
    }

    private void ToggleUserMenu() 
    {
        isUserMenuOpen = !isUserMenuOpen;
        if (isUserMenuOpen) isThemeMenuOpen = false;
    }

    private void CloseMenus()
    {
        isThemeMenuOpen = false;
        isUserMenuOpen = false;
    }



    private async Task HandleSetTheme(string theme)
    {
        State.SetTheme(theme);
        await JSRuntime.InvokeVoidAsync("document.body.setAttribute", "data-theme", theme);
        isThemeMenuOpen = false;
    }

    private async Task HandleLogout()
    {
        CloseMenus();
        await AuthService.Logout();
        Navigation.NavigateTo("/login");
    }

    private void ToggleProviderMode()
    {
        CloseMenus();
        State.IsProviderMode = !State.IsProviderMode;
        if (State.IsProviderMode) 
        {
            Navigation.NavigateTo("provider/dashboard");
        }
        else 
        {
             Navigation.NavigateTo("/");
        }
    }
}

