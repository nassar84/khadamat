@code {
    private bool isThemeMenuOpen = false;
    private bool isUserMenuOpen = false;
    private string DisplayName => State.IsProvider ? "مزود خدمة" : "عميل";
    
    // Search
    private string searchQuery = "";
    
    private void OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" || e.Key == "NumpadEnter")
            ExecuteSearch();
    }
    
    private void ExecuteSearch()
    {
        var q = searchQuery?.Trim();
        if (!string.IsNullOrEmpty(q))
            Navigation.NavigateTo($"/search?q={Uri.EscapeDataString(q)}");
    }
    
    private void ClearSearch()
    {
        searchQuery = "";
    }


    protected override void OnInitialized()
    {
        State.OnChange += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try {
                await JSRuntime.InvokeVoidAsync("setBodyTheme", State.CurrentTheme);
            } catch { } // Ignore cache issues where js function is missing
        }
    }

    public void Dispose()
    {
        State.OnChange -= StateHasChanged;
    }



    private void ToggleThemeMenu() 
    {
        isThemeMenuOpen = !isThemeMenuOpen;
        if (isThemeMenuOpen) isUserMenuOpen = false;
    }

    private void ToggleUserMenu() 
    {
        isUserMenuOpen = !isUserMenuOpen;
        if (isUserMenuOpen) isThemeMenuOpen = false;
    }

    private void CloseMenus()
    {
        isThemeMenuOpen = false;
        isUserMenuOpen = false;
    }



    private async Task HandleSetTheme(string theme)
    {
        State.SetTheme(theme);
        try 
        {
            await JSRuntime.InvokeVoidAsync("setBodyTheme", theme);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error setting theme in Header: {ex.Message}");
        }
        isThemeMenuOpen = false;
    }

    private async Task HandleLogout()
    {
        CloseMenus();
        await AuthService.Logout();
        Navigation.NavigateTo("/login");
    }

    private void ToggleProviderMode()
    {
        CloseMenus();
        State.IsProviderMode = !State.IsProviderMode;
        if (State.IsProviderMode) 
        {
            Navigation.NavigateTo("provider/dashboard");
        }
        else 
        {
             Navigation.NavigateTo("/");
        }
    }
}

