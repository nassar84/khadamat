@using Khadamat.BlazorUI.State
@using Khadamat.BlazorUI.Services.Auth
@inject AppState State
@inject IJSRuntime JSRuntime
@inject IAuthService AuthService
@inject NavigationManager Navigation
@implements IDisposable
<header class="app-header-premium container-fluid" style="display: block; padding: 0;">
    <div class="header-inner-container h-100 mx-auto d-flex align-items-center justify-content-between gap-4" style="max-width: 1200px; padding: 0 20px;">
        <!-- Logo Section -->
        <div class="header-brand-section d-none d-lg-flex align-items-center gap-2 pointer" @onclick='() => Navigation.NavigateTo("/")'>
            @if (!string.IsNullOrEmpty(State.AppLogo))
            {
                <img src="@State.AppLogo" alt="Logo" style="height: 35px; width: auto;" />
            }
            else
            {
                <i class="fa-solid fa-bolt-lightning text-primary fs-3"></i>
            }
            <span class="fw-bold fs-5 text-dark">@State.AppName</span>
        </div>

        
        <!-- Search Section (Expanded & Elegant) -->
        <div class="header-search-section flex-grow-1 d-flex align-items-center" style="max-width: 600px;">
            <div class="search-container-glass w-100">
                <i class="fa-solid fa-magnifying-glass search-icon opacity-50" 
                   style="cursor:pointer;" @onclick="ExecuteSearch"></i>
                <input type="text" 
                       placeholder="ابحث عن خدمة، تاجر، أو صنايعي..." 
                       class="search-input" 
                       @bind="searchQuery"
                       @bind:event="oninput"
                       @onkeydown="OnSearchKeyDown" />
                @if (!string.IsNullOrEmpty(searchQuery))
                {
                    <i class="fa-solid fa-xmark text-muted" style="cursor:pointer; font-size:0.85rem;" 
                       @onclick="ClearSearch"></i>
                }
                else
                {
                    <kbd class="search-shortcut d-none d-md-block">⌘K</kbd>
                }
            </div>
        </div>

        <!-- Desktop Navigation -->
        <nav class="d-none d-lg-flex align-items-center gap-4 me-auto">
            <NavLink href="/" class="nav-link-premium" Match="NavLinkMatch.All">الرئيسية</NavLink>
            <NavLink href="/explore" class="nav-link-premium">استكشف</NavLink>
            <NavLink href="/marketplace" class="nav-link-premium nav-link-marketplace-premium">
                <span class="store-icon-wrap d-inline-flex me-1">
                    <i class="fa-solid fa-store store-anim" style="-webkit-text-fill-color:unset;"></i>
                </span> المتجر
            </NavLink>
        </nav>

        <!-- Actions & Profile Section -->
        <div class="header-actions-section d-flex align-items-center gap-2 gap-md-3">
            
            <!-- Theme Toggle -->
            <div id="themeToggle" class="icon-action-btn position-relative" @onclick="ToggleThemeMenu" title="تغيير الثيم">
                <i class="fa-solid fa-palette text-secondary"></i>
                <div class="theme-popover @(isThemeMenuOpen ? "show" : "")" @onclick:stopPropagation="true">
                    <div class="theme-popover-title">اختر الثيم</div>
                    <div class="theme-grid-minimal">
                        <button class="vial-btn @(State.CurrentTheme == "default" ? "active" : "")" @onclick='() => HandleSetTheme("default")' @onclick:stopPropagation="true" title="أزرق">
                            <div class="vial-glass"><div class="vial-liquid liquid-default"><div class="vial-bubble"></div><div class="vial-bubble b2"></div></div><div class="vial-shimmer"></div></div>
                        </button>
                        <button class="vial-btn @(State.CurrentTheme == "sunset" ? "active" : "")" @onclick='() => HandleSetTheme("sunset")' @onclick:stopPropagation="true" title="غروب">
                            <div class="vial-glass"><div class="vial-liquid liquid-sunset"><div class="vial-bubble"></div><div class="vial-bubble b2"></div></div><div class="vial-shimmer"></div></div>
                        </button>
                        <button class="vial-btn @(State.CurrentTheme == "ocean" ? "active" : "")" @onclick='() => HandleSetTheme("ocean")' @onclick:stopPropagation="true" title="مياه">
                            <div class="vial-glass"><div class="vial-liquid liquid-ocean"><div class="vial-bubble"></div><div class="vial-bubble b2"></div></div><div class="vial-shimmer"></div></div>
                        </button>
                        <button class="vial-btn @(State.CurrentTheme == "forest" ? "active" : "")" @onclick='() => HandleSetTheme("forest")' @onclick:stopPropagation="true" title="غابة">
                            <div class="vial-glass"><div class="vial-liquid liquid-forest"><div class="vial-bubble"></div><div class="vial-bubble b2"></div></div><div class="vial-shimmer"></div></div>
                        </button>
                        <button class="vial-btn @(State.CurrentTheme == "lavender" ? "active" : "")" @onclick='() => HandleSetTheme("lavender")' @onclick:stopPropagation="true" title="بنفسجي">
                            <div class="vial-glass"><div class="vial-liquid liquid-lavender"><div class="vial-bubble"></div><div class="vial-bubble b2"></div></div><div class="vial-shimmer"></div></div>
                        </button>
                        <button class="vial-btn @(State.CurrentTheme == "royal" ? "active" : "")" @onclick='() => HandleSetTheme("royal")' @onclick:stopPropagation="true" title="وردي">
                            <div class="vial-glass"><div class="vial-liquid liquid-royal"><div class="vial-bubble"></div><div class="vial-bubble b2"></div></div><div class="vial-shimmer"></div></div>
                        </button>
                        <button class="vial-btn @(State.CurrentTheme == "glass" ? "active" : "")" @onclick='() => HandleSetTheme("glass")' @onclick:stopPropagation="true" title="زجاج">
                            <div class="vial-glass"><div class="vial-liquid liquid-glass"><div class="vial-bubble"></div><div class="vial-bubble b2"></div></div><div class="vial-shimmer"></div></div>
                        </button>
                    </div>

                    <!-- Divider -->
                    <div class="theme-section-divider"></div>

                    <!-- Crystal Style (Image 1: Pink-Blue Glass) -->
                    <div class="theme-style-label">🔮 كريستال</div>
                    <div class="theme-grid-minimal">
                        <button class="vial-btn crystal-btn @(State.CurrentTheme == "crystal" ? "active" : "")" @onclick='() => HandleSetTheme("crystal")' @onclick:stopPropagation="true" title="كريستال وردي">
                            <div class="crystal-glass">
                                <div class="crystal-panel pink"></div>
                                <div class="crystal-panel blue"></div>
                                <div class="crystal-shine"></div>
                                <div class="crystal-shine s2"></div>
                            </div>
                        </button>
                    </div>

                    <!-- Candy Style (Image 2: Rainbow Jelly) -->
                    <div class="theme-style-label">🍬 كاندي</div>
                    <div class="theme-grid-minimal">
                        <button class="vial-btn candy-btn @(State.CurrentTheme == "candy" ? "active" : "")" @onclick='() => HandleSetTheme("candy")' @onclick:stopPropagation="true" title="قوس قزح">
                            <div class="candy-glass">
                                <div class="candy-orb c1"></div>
                                <div class="candy-orb c2"></div>
                                <div class="candy-orb c3"></div>
                                <div class="candy-shine"></div>
                            </div>
                        </button>
                    </div>

                    <!-- Fluffy Style (Image 3: Plush) -->
                    <div class="theme-style-label">🧸 فلافي</div>
                    <div class="theme-grid-minimal">
                        <button class="vial-btn fluffy-btn @(State.CurrentTheme == "fluffy" ? "active" : "")" @onclick='() => HandleSetTheme("fluffy")' @onclick:stopPropagation="true" title="ناعم">
                            <div class="fluffy-glass">
                                <div class="fluff-ball fb1"></div>
                                <div class="fluff-ball fb2"></div>
                                <div class="fluff-ball fb3"></div>
                                <div class="fluffy-shine"></div>
                            </div>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Store/Marketplace (Visible on small screens) -->
            <div class="icon-action-btn marketplace-action-btn position-relative d-lg-none animate-pulse-subtle" @onclick='() => Navigation.NavigateTo("/marketplace")' title="متجر السلع">
                 <div class="market-badge-premium">
                    <i class="fa-solid fa-store store-pulse-icon"></i>
                 </div>
            </div>

            <div class="vr mx-1 opacity-25 d-none d-md-block"></div>

            <!-- Messages -->
            <div class="icon-action-btn position-relative" @onclick='() => Navigation.NavigateTo("/user/messages")' title="الرسائل">
                 <i class="fa-regular fa-envelope text-secondary"></i>
                 @if (State.HasUnreadMessages)
                 {
                     <span class="notification-badge bg-danger"></span>
                 }
            </div>

            <!-- Notifications -->
            <div class="icon-action-btn position-relative" @onclick='() => Navigation.NavigateTo("/user/notifications")' title="الإشعارات">
                 <i class="fa-regular fa-bell text-secondary"></i>
                 @if (State.HasUnreadNotifications)
                 {
                     <span class="notification-badge bg-primary"></span>
                 }
            </div>

            <!-- User Profile (Minimal - Avatar Only in Bar) -->
            <AuthorizeView>
                <Authorized>
                    <div id="userDropdown" class="user-dropdown-wrapper position-relative ms-2">
                        <div class="user-trigger p-1 rounded-circle border border-2 border-white shadow-sm pointer position-relative" @onclick="ToggleUserMenu">
                            <img src="@(string.IsNullOrEmpty(State.UserImageUrl) ? "images/defaults/default-user.png" : State.UserImageUrl)" 
                                 class="rounded-circle object-fit-cover" 
                                 alt="Avatar" style="width: 42px; height: 42px;" />
                             <div class="online-status-dot"></div>
                        </div>

                        <div class="user-glass-menu @(isUserMenuOpen ? "show" : "")">
                            <div class="menu-header d-flex align-items-center p-3 border-bottom">
                                <img src="@(string.IsNullOrEmpty(State.UserImageUrl) ? "images/defaults/default-user.png" : State.UserImageUrl)" 
                                     class="rounded-3 me-3" style="width: 48px; height: 48px; object-fit: cover;" />
                                <div class="flex-grow-1 overflow-hidden">
                                    <div class="fw-bold text-dark text-truncate">@context.User.Identity?.Name</div>
                                    <div class="small text-muted text-truncate">@context.User.FindFirst("email")?.Value</div>
                                    <div class="d-flex align-items-center mt-1">
                                        <span class="badge bg-light text-dark border border-secondary border-opacity-25 rounded-pill fw-normal px-2 py-0" style="font-size: 0.7rem;">
                                            @(State.IsProvider ? "مزود خدمة" : "عميل")
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="p-2">
                                <a href="/profile" class="menu-link-item d-flex align-items-center p-2 rounded-2 text-decoration-none text-dark mb-1" @onclick="CloseMenus">
                                    <i class="fa-regular fa-id-card me-3 opacity-50 ms-1 width-20 text-center"></i>
                                    <span class="small fw-bold">الملف الشخصي</span>
                                </a>
                                <div class="menu-link-item d-flex align-items-center p-2 rounded-2 text-danger pointer" @onclick="HandleLogout">
                                    <i class="fa-solid fa-arrow-right-from-bracket me-3 opacity-50 ms-1 width-20 text-center"></i>
                                    <span class="small fw-bold">تسجيل الخروج</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </Authorized>
                <NotAuthorized Context="notAuth">
                     <a href="login" class="btn btn-primary btn-sm rounded-pill px-4 fw-bold shadow-sm">دخول</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</header>




@if (isUserMenuOpen || isThemeMenuOpen)
{
    <div class="menu-backdrop" @onclick="CloseMenus"></div>
}

<style>
    /* Header Styles */
    :root {
        --header-height: 72px;
    }
    
    .app-header-premium {
        height: var(--header-height);
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        position: sticky;
        top: 0;
        z-index: 1000;
        transition: all 0.3s ease;
        border-bottom: 1px solid rgba(0,0,0,0.04);
    }

    .search-container-glass {
        background: #f1f5f9;
        border: 1px solid transparent;
        border-radius: 14px;
        padding: 10px 18px;
        transition: all 0.25s ease;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .search-container-glass:focus-within {
        background: white;
        border-color: var(--theme-primary);
        box-shadow: 0 4px 12px rgba(var(--theme-primary-rgb), 0.08);
        transform: translateY(-1px);
    }
    
    .search-input {
        border: none;
        background: transparent;
        outline: none;
        flex-grow: 1;
        font-size: 0.95rem;
        color: #1e293b;
        font-weight: 500;
    }

    .search-input::placeholder {
        color: #94a3b8;
        font-weight: 400;
    }

    .nav-link-premium {
        color: #64748b;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.95rem;
        transition: all 0.2s;
        padding: 5px 0;
        position: relative;
    }

    .nav-link-premium:hover, .nav-link-premium.active {
        color: var(--theme-primary);
    }

    .nav-link-premium.active::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 2px;
        background: var(--theme-primary);
        border-radius: 2px;
    }

    /* Premium Marketplace Button */
    .nav-link-marketplace-premium {
        background: linear-gradient(135deg, #ff0844 0%, #ffb199 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        font-weight: 800 !important;
        padding: 5px 12px !important;
        border-radius: 10px;
        position: relative;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .nav-link-marketplace-premium:hover {
        transform: scale(1.1) translateY(-1px);
        filter: drop-shadow(0 0 8px rgba(255, 8, 68, 0.4));
    }

    .nav-link-marketplace-premium i {
        background: linear-gradient(135deg, #ff0844 0%, #ffb199 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        font-size: 1.1rem;
        vertical-align: middle;
    }

    .icon-pulse {
        animation: premiumPulse 2s infinite;
        display: inline-block;
    }

    @@keyframes premiumPulse {
        0% { transform: scale(1); filter: brightness(1); }
        50% { transform: scale(1.2) rotate(5deg); filter: brightness(1.3); }
        100% { transform: scale(1); filter: brightness(1); }
    }

    /* Mobile Marketplace Button */
    .marketplace-action-btn {
        background: rgba(255, 8, 68, 0.05) !important;
        border: 1px solid rgba(255, 8, 68, 0.1);
        width: 44px !important;
        height: 44px !important;
    }

    .market-badge-premium {
        position: relative;
        color: #ff0844;
        font-size: 1.2rem;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .store-pulse-icon {
        animation: storePulse 2s infinite cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    @@keyframes storePulse {
        0% { transform: scale(1); filter: drop-shadow(0 0 0px rgba(255, 8, 68, 0)); }
        50% { transform: scale(1.25); filter: drop-shadow(0 0 8px rgba(255, 8, 68, 0.5)); }
        100% { transform: scale(1); filter: drop-shadow(0 0 0px rgba(255, 8, 68, 0)); }
    }

    .animate-pulse-subtle {
        animation: pulseSubtle 3s infinite ease-in-out;
    }

    @@keyframes pulseSubtle {
        0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(255, 8, 68, 0.2); }
        50% { transform: scale(1.05); box-shadow: 0 0 0 10px rgba(255, 8, 68, 0); }
        100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(255, 8, 68, 0); }
    }

    .nav-link-marketplace-premium::before {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, rgba(255, 8, 68, 0.1), rgba(255, 177, 153, 0.1));
        border-radius: 10px;
        opacity: 0;
        transition: opacity 0.3s;
        z-index: -1;
    }

    .nav-link-marketplace-premium:hover::before {
        opacity: 1;
    }    
    .icon-action-btn {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        color: #64748b;
        transition: all 0.2s;
        background: transparent;
        cursor: pointer;
    }
    
    .icon-action-btn:hover {
        background: #f8fafc;
        color: var(--theme-primary);
        transform: translateY(-1px);
    }

    .notification-badge {
        position: absolute;
        top: 10px;
        right: 10px;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        border: 2px solid white;
    }
    
    .online-status-dot {
        position: absolute;
        bottom: 2px;
        right: 2px;
        width: 12px;
        height: 12px;
        background: #10b981;
        border: 2px solid white;
        border-radius: 50%;
        box-shadow: 0 1px 2px rgba(0,0,0,0.1);
    }

    /* Menus & Dropdowns */
    .user-glass-menu, .theme-popover {
        position: absolute;
        top: calc(100% + 12px);
        background: white;
        border: 1px solid rgba(0,0,0,0.06);
        border-radius: 16px;
        box-shadow: 0 20px 40px -5px rgba(0,0,0,0.12), 0 8px 16px -8px rgba(0,0,0,0.08);
        opacity: 0;
        visibility: hidden;
        transform: translateY(10px);
        transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        z-index: 1002;
    }

    .user-glass-menu {
        right: 0;
        left: auto;
        min-width: 280px;
        padding: 0;
        overflow: hidden;
    }

    .theme-popover {
        left: 50%;
        transform: translateX(-50%) translateY(10px);
        width: 280px;
        padding: 16px;
        max-height: 480px;
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: rgba(0,0,0,0.1) transparent;
    }

    [dir="rtl"] .user-glass-menu {
        right: auto;
        left: 0;
    }

    .theme-popover.show, .user-glass-menu.show {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
    }

    .theme-popover.show {
        transform: translateX(-50%) translateY(0);
    }
    
    .menu-link-item {
        transition: background 0.2s;
        color: #334155;
    }
    
    .menu-link-item:hover {
        background: #f8fafc;
        color: var(--theme-primary);
    }

    .width-20 { width: 20px; }
    
    /* Theme Popover Title */
    .theme-popover-title {
        font-size: 0.72rem;
        font-weight: 700;
        color: #94a3b8;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 12px;
        text-align: center;
    }

    /* Liquid Glass Vial Buttons */
    .theme-grid-minimal {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 10px;
    }

    .vial-btn {
        background: none;
        border: none;
        padding: 0;
        cursor: pointer;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 5px;
        outline: none;
        transition: transform 0.25s cubic-bezier(0.34,1.56,0.64,1);
    }
    .vial-btn:hover { transform: translateY(-4px) scale(1.08); }
    .vial-btn.active .vial-glass {
        box-shadow: 0 0 0 2.5px #0f172a, 0 6px 18px rgba(0,0,0,0.18);
    }
    .vial-btn.active { transform: scale(1.05); }

    .vial-glass {
        width: 46px;
        height: 46px;
        border-radius: 14px;
        /* Frosted glass bottle shell */
        background: rgba(255,255,255,0.18);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        border: 1.5px solid rgba(255,255,255,0.75);
        border-bottom: 1.5px solid rgba(255,255,255,0.3);
        box-shadow:
            0 4px 16px rgba(0,0,0,0.10),
            inset 0 1px 0 rgba(255,255,255,0.9),
            inset 0 -1px 0 rgba(0,0,0,0.04);
        position: relative;
        overflow: hidden;
        transition: box-shadow 0.2s;
    }

    /* Colored liquid fill inside the glass */
    .vial-liquid {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 68%;
        border-radius: 0 0 12px 12px;
        opacity: 0.82;
        animation: liquidWave 3s ease-in-out infinite alternate;
    }
    @@keyframes liquidWave {
        0%   { height: 65%; border-radius: 30% 40% 0 0 / 12px 12px 0 0; }
        100% { height: 72%; border-radius: 40% 20% 0 0 / 10px 12px 0 0; }
    }

    /* Liquid colors */
    .liquid-default  { background: linear-gradient(180deg, #60a5fa 0%, #2563eb 60%, #1d4ed8 100%); }
    .liquid-sunset   { background: linear-gradient(180deg, #fbbf24 0%, #f59e0b 40%, #ea580c 100%); }
    .liquid-ocean    { background: linear-gradient(180deg, #38bdf8 0%, #0ea5e9 50%, #0284c7 100%); }
    .liquid-forest   { background: linear-gradient(180deg, #34d399 0%, #10b981 50%, #059669 100%); }
    .liquid-lavender { background: linear-gradient(180deg, #a78bfa 0%, #8b5cf6 50%, #7c3aed 100%); }
    .liquid-royal    { background: linear-gradient(180deg, #fb7185 0%, #e11d48 50%, #be123c 100%); }
    .liquid-glass    { background: linear-gradient(180deg, rgba(253,210,239,0.9) 0%, rgba(161,196,253,0.85) 100%); backdrop-filter: blur(4px); }

    /* Floating bubbles inside liquid */
    .vial-bubble {
        position: absolute;
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: rgba(255,255,255,0.55);
        bottom: 6px;
        left: 30%;
        animation: bubbleRise 2.4s ease-in-out infinite;
    }
    .vial-bubble.b2 {
        width: 3px;
        height: 3px;
        left: 55%;
        animation-delay: 1.1s;
        animation-duration: 1.9s;
    }
    @@keyframes bubbleRise {
        0%   { transform: translateY(0) scale(1); opacity: 0.7; }
        80%  { opacity: 0.5; }
        100% { transform: translateY(-28px) scale(0.6); opacity: 0; }
    }

    /* Glass shimmer highlight (top reflection) */
    .vial-shimmer {
        position: absolute;
        top: 5px;
        left: 7px;
        width: 12px;
        height: 18px;
        border-radius: 50%;
        background: rgba(255,255,255,0.55);
        filter: blur(3px);
        pointer-events: none;
    }

    /* ===== DIVIDERS & LABELS ===== */
    .theme-section-divider {
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(0,0,0,0.08), transparent);
        margin: 12px 0 8px;
    }
    .theme-style-label {
        font-size: 0.68rem;
        font-weight: 700;
        color: #94a3b8;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        margin-bottom: 8px;
        text-align: center;
    }

    /* ===== CRYSTAL BUTTON (Image 1: Pink-Blue Glass Panels) ===== */
    .crystal-glass {
        width: 46px;
        height: 46px;
        border-radius: 14px;
        background: rgba(255,255,255,0.15);
        backdrop-filter: blur(12px);
