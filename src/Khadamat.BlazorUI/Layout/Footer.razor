@inject Khadamat.BlazorUI.State.AppState State

<footer class="app-footer">
    <div class="footer-content">
        <p class="copyright">&copy; 2026 @State.AppName. جميع الحقوق محفوظة. | إصدار: 1.1.0-Fixed</p>
        <div class="footer-links">
            <a href="/privacy">سياسة الخصوصية</a>
            <a href="/terms">الشروط والأحكام</a>
            <a href="/contact">تواصل معنا</a>
        </div>
        <div class="footer-app-badges">
            <span class="small text-muted d-block mb-2">حمل تطبيقنا الآن:</span>
            <div class="d-flex gap-2">
                <a href="/downloads/khadamat.apk" download="@($"{State.AppName.ToLower()}.apk")" class="app-badge" title="تنزيل مباشر للأندرويد"><i class="fa-brands fa-android"></i></a>
                <span class="app-badge opacity-50" title="قريباً للايفون"><i class="fa-brands fa-apple"></i></span>
            </div>
        </div>
    </div>
</footer>

<style>
    .app-badge {
        background: #f1f5f9;
        color: #334155;
        width: 38px;
        height: 38px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        transition: all 0.2s;
    }
    .app-badge:hover {
        background: var(--theme-primary);
        color: white;
        transform: translateY(-3px);
    }
    .footer-app-badges {
        text-align: center;
    }

    @@media (max-width: 991px) {
        .footer-app-badges {
            display: none !important;
        }
    }
</style>

@code {

}

<style>
    .app-footer {
        background: white;
        padding: 30px 0;
        border-top: 1px solid rgba(0,0,0,0.05);
        margin-top: auto;
    }
    
    .footer-content {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
    }
    
    .copyright {
        color: #64748b;
        font-size: 0.9rem;
        margin: 0;
        font-weight: 500;
    }
    
    .footer-links {
        display: flex;
        gap: 25px;
    }
    
    .footer-links a {
        color: #64748b;
        text-decoration: none;
        font-size: 0.9rem;
        transition: color 0.2s;
        font-weight: 500;
    }
    
    .footer-links a:hover {
        color: var(--theme-primary);
    }
    
    @@media (max-width: 768px) {
        .footer-content {
            flex-direction: column-reverse;
            text-align: center;
            padding-bottom: 80px; /* Space for mobile bottom nav */
        }
    }
</style>
