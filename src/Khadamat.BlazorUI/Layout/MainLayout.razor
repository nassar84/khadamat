@inherits LayoutComponentBase
@implements IDisposable

<PageTitle>@AppState.AppName</PageTitle>
<div class="khadamat-app @(AppState.IsMobileApp ? "mobile-mode" : "") @(AppState.IsNativeApp ? "native-mode" : "") @(isSidebarCollapsed ? "collapsed" : "")" dir="rtl">
    @if (!AppState.IsNativeApp)
    {
        <MobileSidebar />
        @if (!AppState.IsMobileApp)
        {
            <Sidebar @bind-IsCollapsed="isSidebarCollapsed" />
        }
    }
    
    <div class="app-main-view" style="@(AppState.IsMobileApp ? "max-width: 100%;" : "")">
        @if (!AppState.IsNativeApp)
        {
            @if (!AppState.IsMobileApp)
            {
                <Header />
            }
            else
            {
                <MobileHeader />
            }
        }
        
        @if (!IsAdminPage && !IsProviderPage)
        {
            <div class="sticky-categories-bar pb-0 pt-1 border-bottom" style="min-height: 95px; display: block !important;">
                <Khadamat.BlazorUI.Shared.CategoryMarquee />
            </div>
        }
        
        @if (ShowHeroAds && !AppState.IsMobileApp)
        {
            <div class="mt-3">
                <HeroAds />
            </div>
        }

        <main class="app-content">

            <div class="content-wrapper">
                @Body
            </div>
        </main>

        @if (!AppState.IsNativeApp)
        {
            @if (!AppState.IsMobileApp)
            {
                <Footer />
            }
        }
    </div>

    @if (!AppState.IsNativeApp)
    {
        @if (!AppState.IsMobileApp)
        {
            <BottomNav />
            <AppDownloadWidget />
        }
        else
        {
            <MobileBottomNav />
        }
    }
    
    <AdPopup />
</div>

<style>
    .khadamat-app {
        display: flex;
        flex-direction: row;
        min-height: 100vh;
        width: 100%;
        background: transparent;
        position: relative;
        /* overflow-x: hidden; - Removed to prevent breaking 'position: sticky' */
    }

    .app-main-view {
        flex: 1;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        position: relative;
        min-width: 0; /* Flexbox fix for overflow children */
        margin: 0; /* Reset margins by default */
        overflow: visible !important;
    }

    .app-content {
        flex: 1;
        overflow: visible !important;
    }

    .content-wrapper {
        overflow: visible !important;
    }

    /* Full width for small screens */
    @@media (max-width: 991px) {
        .khadamat-app {
            flex-direction: column;
            overflow-x: clip; /* Safer than hidden for sticky */
        }
        .app-main-view {
            width: 100%;
            max-width: 100%;
            margin: 0 !important;
        }
    }

    /* Handling sidebar space on desktop */
    @@media (min-width: 992px) {
        .khadamat-app:not(.mobile-mode) .app-main-view {
            /* Keep centered but account for sidebar if needed */
            max-width: calc(100% - 280px);
            margin-left: auto;
            margin-right: auto;
        }
        .khadamat-app.collapsed:not(.mobile-mode) .app-main-view {
            max-width: calc(100% - 80px);
            margin-left: auto;
            margin-right: auto;
        }
        
        /* If mobile mode is forced on desktop */
        .khadamat-app.mobile-mode .app-main-view {
            max-width: 100%;
            margin: 0;
        }
    }
    
    .sticky-categories-bar {
        position: -webkit-sticky; /* iOS support */
        position: sticky;
        top: 72px; /* Set for desktop/shrunk view by default */
        z-index: 998;
        background: rgba(255, 255, 255, 0.98);
        backdrop-filter: blur(15px);
        -webkit-backdrop-filter: blur(15px);
        border-bottom: 1px solid rgba(0,0,0,0.05);
        padding: 5px 0;
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
    }

    /* Adjust for mobile header which is slightly taller in total sticky space */
    .mobile-mode:not(.native-mode) .sticky-categories-bar {
        top: 76px; /* Sits right under floating mobile glass header */
        background: white; 
    }

    /* Small screens resizing on desktop */
    @@media (max-width: 991px) {
        .sticky-categories-bar:not(.native-mode .sticky-categories-bar) {
            top: 72px; /* Consistent with Consolidated Desktop Header height */
        }
    }

    .native-mode .sticky-categories-bar {
        top: 0 !important; /* In native app, it sits right under the native header */
        background: white;
    }

    .native-mode .app-main-view {
        padding-top: 0 !important;
        margin-top: 0 !important;
    }
</style>

@inject NavigationManager Navigation
@inject Khadamat.BlazorUI.Services.Auth.IAuthService AuthService
@inject Khadamat.BlazorUI.State.AppState AppState
@inject Khadamat.BlazorUI.Services.ApiClient Api
@inject Khadamat.BlazorUI.Services.SignalRClientService SignalRService
@inject IJSRuntime JS
@inject Khadamat.BlazorUI.Services.SoundService SoundService

@code {
    private bool isSidebarCollapsed = false;
    private bool _disposed = false;
    private bool IsAdminPage => Navigation.Uri.Contains("/admin", StringComparison.OrdinalIgnoreCase);
    private bool IsProfilePage => Navigation.Uri.Contains("/profile", StringComparison.OrdinalIgnoreCase) || Navigation.Uri.Contains("/settings", StringComparison.OrdinalIgnoreCase);
    private bool IsProviderPage => Navigation.Uri.Contains("/provider/", StringComparison.OrdinalIgnoreCase);
    private bool IsHomePage
    {
        get
        {
            var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri);
            var pathOnly = relativePath.Split('?')[0];
            return string.IsNullOrEmpty(pathOnly) || 
                   pathOnly.Equals("index", StringComparison.OrdinalIgnoreCase);
        }
    }

    private bool ShowHeroAds => IsHomePage && !IsAdminPage;

    protected override void OnInitialized()
    {
        AppState.OnChange += OnStateChange;
        Navigation.LocationChanged += HandleLocationChanged;
        
        CheckMobileModeFromUrl();
    }

    private async void OnStateChange()
    {
        if (_disposed) return;
        try { await InvokeAsync(StateHasChanged); }
        catch (ObjectDisposedException) { }
        catch (InvalidOperationException) { }
    }

    // Called from OnInitializedAsync - reads URL params only (JS not available yet)
    private void CheckMobileModeFromUrl()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        
        if (query.TryGetValue("mobileapp", out var mValue) && mValue == "1")
        {
            if (!AppState.IsMobileApp) AppState.IsMobileApp = true;
        }

        if (query.TryGetValue("nativeapp", out var nValue) && nValue == "1")
        {
            if (!AppState.IsNativeApp) AppState.IsNativeApp = true;
            if (!AppState.IsMobileApp) AppState.IsMobileApp = true;
        }

        // Handle deep link redirect from native app to avoid 404s on refresh/direct loads
        if (query.TryGetValue("redirect", out var rValue))
        {
            var target = rValue.ToString();
            if (!string.IsNullOrEmpty(target))
            {
                // Remove the redirect param and navigate
                var newUri = Navigation.GetUriWithQueryParameter("redirect", (string?)null);
                Navigation.NavigateTo(target);
            }
        }
    }

    // Full async check: reads URL params AND sessionStorage (JS required)
    private async Task CheckMobileModeAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        bool urlHasNative = false;
        
        if (query.TryGetValue("mobileapp", out var mValue) && mValue == "1")
        {
            if (!AppState.IsMobileApp) AppState.IsMobileApp = true;
            try { await JS.InvokeVoidAsync("sessionStorage.setItem", "mobileapp", "1"); } catch { }
        }

        if (query.TryGetValue("nativeapp", out var nValue) && nValue == "1")
        {
            urlHasNative = true;
            if (!AppState.IsNativeApp) AppState.IsNativeApp = true;
            if (!AppState.IsMobileApp) AppState.IsMobileApp = true;
            try { await JS.InvokeVoidAsync("sessionStorage.setItem", "nativeapp", "1"); } catch { }
        }
        
        if (!urlHasNative)
        {
            // Check sessionStorage in case user navigated internally without the query param
            try
            {
                var storedNative = await JS.InvokeAsync<string>("sessionStorage.getItem", "nativeapp");
                if (storedNative == "1")
                {
                    if (!AppState.IsNativeApp) AppState.IsNativeApp = true;
                    if (!AppState.IsMobileApp) AppState.IsMobileApp = true;
                }
                var storedMobile = await JS.InvokeAsync<string>("sessionStorage.getItem", "mobileapp");
                if (storedMobile == "1")
                {
                    if (!AppState.IsMobileApp) AppState.IsMobileApp = true;
                }
            }
            catch { }
        }
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _ = CheckMobileModeAsync();
        StateHasChanged();
    }
    private async Task LoadInitialDataAsync()
    {
        // Load global settings
        try
        {
            var settingsResult = await Api.GetSettingsAsync();
            if (settingsResult?.Success == true && settingsResult.Data != null)
            {
                AppState.AppName = settingsResult.Data.ApplicationName;
                AppState.AppNameAr = settingsResult.Data.ApplicationNameAr;
                AppState.AppNameEn = settingsResult.Data.ApplicationNameEn;
                AppState.AppLogo = settingsResult.Data.LogoUrl;
                AppState.PrimaryColor = settingsResult.Data.PrimaryColor;
                AppState.SecondaryColor = settingsResult.Data.SecondaryColor;

                AppState.OpenAppSound = settingsResult.Data.OpenAppSound;
                AppState.FindServiceSound = settingsResult.Data.FindServiceSound;
                AppState.OpenDetailsSound = settingsResult.Data.OpenDetailsSound;
                AppState.MessageReceivedSound = settingsResult.Data.MessageReceivedSound;
                AppState.NotificationReceivedSound = settingsResult.Data.NotificationReceivedSound;

                AppState.TriggerStateChanged();
                
                try { await JS.InvokeVoidAsync("updateWebDetails", AppState.AppName, AppState.AppLogo); } catch { }
                
                // Apply colors if we have them
                try 
                {
                    await JS.InvokeVoidAsync("applyThemeColors", AppState.PrimaryColor, AppState.SecondaryColor);
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error applying theme colors in LoadInitialDataAsync: {ex.Message}");
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading settings: {ex.Message}");
        }

        try 
        {
            if (AppState.IsAuthenticated)
            {
                 await SignalRService.StartAsync();
            }

            if (AppState.IsAuthenticated && !AppState.IsProfileComplete)
            {
                var profile = await AuthService.GetProfileAsync();
                if (profile?.Success == true && profile.Data != null)
                {
                    AppState.UserName = profile.Data.UserName;
                    AppState.IsProvider = profile.Data.IsProvider;
                    AppState.CityId = profile.Data.CityId;
                    AppState.GovernorateId = profile.Data.GovernorateId;
                    AppState.PhoneNumber = profile.Data.PhoneNumber;
                    AppState.TriggerStateChanged();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"ANTIGRAVITY_LOG: Error during background data sync: {ex.Message}");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // تشغيل loading screen إخفاء بعد اكتمال أول render
            // نُشغّل كل المنطق خارج render cycle باستخدام Task.Run + InvokeAsync
            // هذا يمنع Race Condition الذي يُسبب "No element is currently associated with component"
            _ = Task.Run(async () =>
            {
                // تأخير يضمن أن Blazor أنهى first render كاملاً
                await Task.Delay(150);

                await InvokeAsync(async () =>
                {
                    try
                    {
                        // تهيئة Auth Session (يُطلق NotifyAuthenticationStateChanged المؤجّل)
                        await AuthService.InitializeAsync();

                        // فحص Mobile/Native Mode من sessionStorage (يتطلب JS)
                        await CheckMobileModeAsync();

                        // تطبيق ألوان Theme إذا كانت محددة
                        if (!string.IsNullOrEmpty(AppState.PrimaryColor))
                        {
                            try
                            {
                                await JS.InvokeVoidAsync("applyThemeColors", AppState.PrimaryColor, AppState.SecondaryColor);
                            }
                            catch { }
                        }

                        // تشغيل خدمات الخلفية بدون انتظار
                        _ = LoadInitialDataAsync();

                        // صوت الترحيب
                        await SoundService.PlayStartupAsync();

                        // إخفاء شاشة التحميل (Splash Screen) بعد اكتمال كل شيء
                        await JS.InvokeVoidAsync("hideLoadingScreen");
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"ANTIGRAVITY_LOG: MainLayout Startup Error: {ex.Message}");
                    }
                });
            });
        }
    }

    public void Dispose()
    {
        _disposed = true;
        Navigation.LocationChanged -= HandleLocationChanged;
        AppState.OnChange -= OnStateChange;
        _ = SignalRService.StopAsync();
    }
}
