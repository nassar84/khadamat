@inherits LayoutComponentBase
@implements IDisposable

<div class="khadamat-app @(AppState.IsMobileApp ? "mobile-mode" : "") @(isSidebarCollapsed ? "collapsed" : "")">
    @if (!AppState.IsNativeApp)
    {
        @if (!AppState.IsMobileApp)
        {
            <Sidebar @bind-IsCollapsed="isSidebarCollapsed" />
        }
        else
        {
            <MobileSidebar />
        }
    }
    
    <div class="app-main-view" style="@(AppState.IsMobileApp ? "max-width: 100%;" : "")">
        @if (!AppState.IsNativeApp)
        {
            @if (!AppState.IsMobileApp)
            {
                <Header />
            }
            else
            {
                <MobileHeader />
            }
        }
        
        @if (ShowHeroAds && !AppState.IsMobileApp)
        {
            <div class="mt-3">
                <HeroAds />
            </div>
        }

        <main class="app-content">

            <div class="content-wrapper">
                @Body
            </div>
        </main>

        @if (!AppState.IsNativeApp)
        {
            @if (!AppState.IsMobileApp)
            {
                <Footer />
            }
        }
    </div>

    @if (!AppState.IsNativeApp)
    {
        @if (!AppState.IsMobileApp)
        {
            <BottomNav />
            <AppDownloadWidget />
        }
        else
        {
            <MobileBottomNav />
        }
    }
    
    <AdPopup />
</div>

<style>
    .khadamat-app {
        display: flex;
        flex-direction: row;
        min-height: 100vh;
        width: 100%;
        background: transparent;
        position: relative;
    }

    .app-main-view {
        flex: 1;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        position: relative;
        max-width: calc(100% - 280px); /* Account for sidebar width */
        margin-left: auto;
        margin-right: auto;
        overflow: visible !important; /* Critical for sticky children */
    }

    .app-content {
        flex: 1;
        overflow: visible !important;
    }

    .content-wrapper {
        overflow: visible !important;
    }

    .khadamat-app.collapsed .app-main-view {
        max-width: calc(100% - 80px);
    }

    @@media (max-width: 991px) {
        .khadamat-app {
            flex-direction: column;
        }
        .app-main-view {
            width: 100%;
            max-width: 100%;
        }
    }
    
    .sticky-categories-bar {
        position: sticky;
        top: 0; /* Default for mobile/integrated */
        z-index: 998;
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(15px);
        -webkit-backdrop-filter: blur(15px);
        border-bottom: 1px solid rgba(0,0,0,0.05);
        padding: 8px 0;
        box-shadow: 0 4px 15px rgba(0,0,0,0.02);
    }
    
    /* When header is visible, push sticky bar down */
    .khadamat-app:not(.mobile-mode) .sticky-categories-bar {
        top: 72px; 
    }
</style>

@inject NavigationManager Navigation
@inject Khadamat.BlazorUI.Services.Auth.IAuthService AuthService
@inject Khadamat.BlazorUI.State.AppState AppState
@inject Khadamat.BlazorUI.Services.ApiClient Api
@inject Khadamat.BlazorUI.Services.SignalRClientService SignalRService
@inject IJSRuntime JS

@code {
    private bool isSidebarCollapsed = false;
    private bool IsAdminPage => Navigation.Uri.Contains("/admin", StringComparison.OrdinalIgnoreCase);
    private bool IsProfilePage => Navigation.Uri.Contains("/profile", StringComparison.OrdinalIgnoreCase) || Navigation.Uri.Contains("/settings", StringComparison.OrdinalIgnoreCase);
    private bool IsProviderPage => Navigation.Uri.Contains("/provider/", StringComparison.OrdinalIgnoreCase);
    private bool IsHomePage
    {
        get
        {
            var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri);
            var pathOnly = relativePath.Split('?')[0];
            return string.IsNullOrEmpty(pathOnly) || 
                   pathOnly.Equals("index", StringComparison.OrdinalIgnoreCase);
        }
    }

    private bool ShowHeroAds => IsHomePage && !IsAdminPage;

    protected override async Task OnInitializedAsync()
    {
        AppState.OnChange += OnStateChange;
        Navigation.LocationChanged += HandleLocationChanged;
        
        CheckMobileModeFromUrl(); // URL params only (no JS needed)
        await AuthService.InitializeAsync();
    }

    private async void OnStateChange()
    {
        await InvokeAsync(StateHasChanged);
    }

    // Called from OnInitializedAsync - reads URL params only (JS not available yet)
    private void CheckMobileModeFromUrl()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        
        if (query.TryGetValue("mobileapp", out var mValue) && mValue == "1")
        {
            if (!AppState.IsMobileApp) AppState.IsMobileApp = true;
        }

        if (query.TryGetValue("nativeapp", out var nValue) && nValue == "1")
        {
            if (!AppState.IsNativeApp) AppState.IsNativeApp = true;
            if (!AppState.IsMobileApp) AppState.IsMobileApp = true;
        }
    }

    // Full async check: reads URL params AND sessionStorage (JS required)
    private async Task CheckMobileModeAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        bool urlHasNative = false;
        
        if (query.TryGetValue("mobileapp", out var mValue) && mValue == "1")
        {
            if (!AppState.IsMobileApp) AppState.IsMobileApp = true;
            try { await JS.InvokeVoidAsync("sessionStorage.setItem", "mobileapp", "1"); } catch { }
        }

        if (query.TryGetValue("nativeapp", out var nValue) && nValue == "1")
        {
            urlHasNative = true;
            if (!AppState.IsNativeApp) AppState.IsNativeApp = true;
            if (!AppState.IsMobileApp) AppState.IsMobileApp = true;
            try { await JS.InvokeVoidAsync("sessionStorage.setItem", "nativeapp", "1"); } catch { }
        }
        
        if (!urlHasNative)
        {
            // Check sessionStorage in case user navigated internally without the query param
            try
            {
                var storedNative = await JS.InvokeAsync<string>("sessionStorage.getItem", "nativeapp");
                if (storedNative == "1")
                {
                    if (!AppState.IsNativeApp) AppState.IsNativeApp = true;
                    if (!AppState.IsMobileApp) AppState.IsMobileApp = true;
                }
                var storedMobile = await JS.InvokeAsync<string>("sessionStorage.getItem", "mobileapp");
                if (storedMobile == "1")
                {
                    if (!AppState.IsMobileApp) AppState.IsMobileApp = true;
                }
            }
            catch { }
        }
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _ = CheckMobileModeAsync();
        StateHasChanged();
    }
    private async Task LoadInitialDataAsync()
    {
        // Load global settings
        try
        {
            var settingsResult = await Api.GetSettingsAsync();
            if (settingsResult?.Success == true && settingsResult.Data != null)
            {
                AppState.AppName = settingsResult.Data.ApplicationName;
                AppState.AppLogo = settingsResult.Data.LogoUrl;
                AppState.PrimaryColor = settingsResult.Data.PrimaryColor;
                AppState.SecondaryColor = settingsResult.Data.SecondaryColor;
                AppState.TriggerStateChanged();
                
                // Apply colors if we have them
                try 
                {
                    await JS.InvokeVoidAsync("applyThemeColors", AppState.PrimaryColor, AppState.SecondaryColor);
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error applying theme colors in LoadInitialDataAsync: {ex.Message}");
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading settings: {ex.Message}");
        }

        if (AppState.IsAuthenticated)
        {
             await SignalRService.StartAsync();
        }

        if (AppState.IsAuthenticated && !AppState.IsProfileComplete)
        {
            try
            {
                var profile = await AuthService.GetProfileAsync();
                if (profile?.Success == true && profile.Data != null)
                {
                    AppState.UserName = profile.Data.UserName;
                    AppState.IsProvider = profile.Data.IsProvider;
                    AppState.CityId = profile.Data.CityId;
                    AppState.GovernorateId = profile.Data.GovernorateId;
                    AppState.PhoneNumber = profile.Data.PhoneNumber;
                    AppState.TriggerStateChanged();
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error syncing profile: {ex.Message}");
            }
        }
    }

        protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try 
            {
                // Check sessionStorage for mobile/native mode flags (JS is now available)
                await CheckMobileModeAsync();
                
                _ = LoadInitialDataAsync(); // Trigger background load without awaiting it here
                
                if (!string.IsNullOrEmpty(AppState.PrimaryColor))
                {
                    await JS.InvokeVoidAsync("applyThemeColors", AppState.PrimaryColor, AppState.SecondaryColor);
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error in MainLayout OnAfterRenderAsync: {ex.Message}");
            }
        }
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
        AppState.OnChange -= OnStateChange;
        _ = SignalRService.StopAsync();
    }
}
