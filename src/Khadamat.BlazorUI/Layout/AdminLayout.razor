@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation
@inject Khadamat.BlazorUI.Services.Auth.IAuthService AuthService
@inject Khadamat.BlazorUI.State.AppState State
@inject IJSRuntime JS

<div class="admin-layout" dir="rtl">
    @if (State.IsNativeApp)
    {
        <main class="mobile-content">
            @Body
        </main>
    }
    else if (State.IsMobileApp)
    {
        <MobileHeader />
        <MobileSidebar />
        <main class="mobile-content">
            @Body
        </main>
        <MobileBottomNav />
    }
    else
    {
        <div class="sidebar-overlay @(SidebarOpen ? "visible" : "")" @onclick="ToggleSidebar"></div>

        <aside class="admin-sidebar glass-card @(SidebarOpen ? "open" : "")">
        <div class="sidebar-header d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                @if (!string.IsNullOrEmpty(State.AppLogo))
                {
                    <img src="@State.AppLogo" alt="Logo" style="height: 25px; width: auto;" />
                }
                <h3 class="brand-name mb-0">@State.AppName <span class="badge">Admin</span></h3>
            </div>
            <!-- Mobile Close Button -->
            <button class="btn btn-link text-muted d-lg-none" @onclick="ToggleSidebar">
                <i class="fas fa-times fs-5"></i>
            </button>
        </div>
        <nav class="sidebar-nav">
            <NavLink class="nav-link" href="/admin" Match="NavLinkMatch.All" @onclick="CloseSidebar">
                <i class="fas fa-chart-line"></i> لوحة التحكم
            </NavLink>

            <!-- Management Group -->
            <div class="nav-group-label text-muted x-small fw-bold mt-3 mb-2 px-3">الإدارة</div>
            
            <NavLink class="nav-link" href="/admin/users" @onclick="CloseSidebar">
                <i class="fas fa-users"></i> المستخدمين
            </NavLink>
             <NavLink class="nav-link" href="/admin/approvals/providers" @onclick="CloseSidebar">
                <i class="fas fa-user-check"></i> اعتماد المزودين
            </NavLink>

            <!-- Services Group -->
            <div class="nav-group-label text-muted x-small fw-bold mt-3 mb-2 px-3">الخدمات</div>
            
             <NavLink class="nav-link" href="/admin/services" @onclick="CloseSidebar">
                <i class="fas fa-briefcase"></i> إدارة الخدمات
            </NavLink>
             <NavLink class="nav-link" href="/admin/approvals/services" @onclick="CloseSidebar">
                <i class="fas fa-clipboard-check"></i> طلبات الخدمات
            </NavLink>
             <NavLink class="nav-link" href="/admin/categories" @onclick="CloseSidebar">
                <i class="fas fa-th-large"></i> التصنيفات
            </NavLink>
             <NavLink class="nav-link" href="/admin/locations" @onclick="CloseSidebar">
                <i class="fas fa-map-marker-alt"></i> المناطق
            </NavLink>

            <!-- Advertising & Economy Group -->
            <AuthorizeView Roles="SystemAdmin,SuperAdmin">
                <div class="nav-group-label text-muted x-small fw-bold mt-3 mb-2 px-3">الإعلانات والاقتصاد</div>
                
                <NavLink class="nav-link" href="/admin/ad-analytics" @onclick="CloseSidebar">
                    <i class="fas fa-chart-pie"></i> إحصائيات الإعلانات
                </NavLink>
                <NavLink class="nav-link" href="/admin/adsmanagement" @onclick="CloseSidebar">
                    <i class="fas fa-rectangle-ad"></i> إدارة الإعلانات
                </NavLink>
                <NavLink class="nav-link" href="/admin/ad-packages" @onclick="CloseSidebar">
                    <i class="fas fa-gem"></i> باقات الإعلانات
                </NavLink>
            </AuthorizeView>

            <!-- System Group (SuperAdmin Only) -->
            <AuthorizeView Roles="SuperAdmin">
                <div class="nav-group-label text-muted x-small fw-bold mt-3 mb-2 px-3">النظام</div>
                
                 <NavLink class="nav-link" href="/admin/reports" @onclick="CloseSidebar">
                    <i class="fas fa-file-alt"></i> التقارير
                </NavLink>
                 <NavLink class="nav-link" href="/admin/logs" @onclick="CloseSidebar">
                    <i class="fas fa-history"></i> سجل النشاط
                </NavLink>
                 <NavLink class="nav-link" href="/admin/subscriptions" @onclick="CloseSidebar">
                    <i class="fas fa-credit-card"></i> الاشتراكات
                </NavLink>
                 <NavLink class="nav-link" href="/admin/settings" @onclick="CloseSidebar">
                    <i class="fas fa-cogs"></i> الإعدادات
                </NavLink>
            </AuthorizeView>
            
             <div class="mt-auto"></div>
             <NavLink class="nav-link text-primary" href="/" @onclick="CloseSidebar">
                <i class="fas fa-home"></i> العودة للموقع
            </NavLink>
             <button class="nav-link btn-logout" @onclick="HandleLogout">
                <i class="fas fa-sign-out-alt"></i> تسجيل الخروج
            </button>
        </nav>
    </aside>

    <main class="admin-content">
        <div class="admin-header glass-card">
            <div class="d-flex align-items-center gap-3">
                <!-- Mobile Toggle Button -->
                <button class="btn btn-link text-dark p-0 d-lg-none" @onclick="ToggleSidebar">
                    <i class="fas fa-bars fs-4"></i>
                </button>
                <h4 class="mb-0">لوحة التحكم</h4>
            </div>

            <div class="admin-user-info">
                <AuthorizeView>
                    <Authorized>
                        <span class="d-none d-md-inline">مرحباً، @context.User.Identity?.Name</span>
                        <i class="fas fa-user-circle fs-4 d-md-none text-primary"></i>
                    </Authorized>
                </AuthorizeView>
            </div>
        </div>

        <div class="content-body">
            @Body
        </div>
    </main>
    }
</div>

<style>
    .admin-layout {
        display: flex;
        min-height: 100vh;
        /* Background handled by global body style for consistency */
    }

    .admin-sidebar {
        width: 280px;
        margin: 20px;
        padding: 20px;
        display: flex;
        flex-direction: column;
        border-radius: 20px;
        height: calc(100vh - 40px);
        position: sticky;
        top: 20px;
        transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        z-index: 1000;
        background: rgba(255, 255, 255, 0.82);
    }

    .sidebar-header {
        margin-bottom: 30px;
        text-align: center;
    }

    .sidebar-nav {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .nav-link {
        color: #1e293b;
        padding: 12px 15px;
        border-radius: 12px;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 12px;
        font-weight: 700;
        transition: all 0.2s ease;
    }

    .nav-link:hover, .nav-link.active {
        background: var(--theme-primary);
        color: white;
        box-shadow: 0 4px 12px rgba(99, 102, 241, 0.25); /* specific glow */
        transform: translateX(5px);
    }
    
    .btn-logout {
        background: none;
        border: none;
        width: 100%;
        cursor: pointer;
        margin-top: auto;
        color: #ef4444;
    }
    
    .btn-logout:hover {
        background: rgba(239, 68, 68, 0.1);
        color: #ef4444;
        box-shadow: none;
        transform: none;
    }

    .admin-content {
        flex: 1;
        padding: 20px;
        display: flex;
        flex-direction: column;
        gap: 20px;
        width: calc(100% - 320px); 
        overflow-x: hidden;
    }

    .admin-header {
        padding: 15px 25px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-radius: 15px;
    }

    .content-body {
        flex: 1;
    }
    
    .badge {
        font-size: 0.7rem;
        background: var(--theme-secondary);
        color: white;
        padding: 2px 8px;
        border-radius: 10px;
        vertical-align: middle;
    }

    .sidebar-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.3);
        backdrop-filter: blur(2px);
        z-index: 999;
        display: none;
        opacity: 0;
        transition: opacity 0.3s;
    }

    .sidebar-overlay.visible {
        display: block;
        opacity: 1;
    }

    /* Mobile Responsive Styles */
    @@media (max-width: 991px) {
        .admin-sidebar {
            position: fixed;
            top: 0;
            right: -280px; /* Hide off-screen to the right side */
            left: auto;
            height: 100vh;
            margin: 0;
            width: 280px;
            border-radius: 20px 0 0 20px;
            transition: right 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            transform: none !important;
            box-shadow: -5px 0 25px rgba(0,0,0,0.1);
        }

        .admin-sidebar.open {
            right: 0;
        }

        .admin-content {
            width: 100%;
            padding: 15px;
        }

        .admin-header {
            padding: 12px 15px;
        }
    }
</style>

@code {
    private bool SidebarOpen { get; set; } = false;
    private bool _disposed = false;

    protected override void OnInitialized()
    {
        State.OnChange += OnStateChange;
        Navigation.LocationChanged += HandleLocationChanged;
        CheckMobileMode();
    }

    private async void OnStateChange()
    {
        if (_disposed) return;
        try { await InvokeAsync(StateHasChanged); }
        catch (ObjectDisposedException) { }
        catch (InvalidOperationException) { }
    }

    private void CheckMobileMode()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("mobileapp", out var value) && value == "1")
        {
            if (!State.IsMobileApp) State.IsMobileApp = true;
        }
        if (query.TryGetValue("nativeapp", out var nValue) && nValue == "1")
        {
            if (!State.IsNativeApp) State.IsNativeApp = true;
            if (!State.IsMobileApp) State.IsMobileApp = true;
        }
    }

    private async void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (_disposed) return;
        _ = CheckMobileModeAsync();
        try { await InvokeAsync(StateHasChanged); }
        catch { }
    }

    private async Task CheckMobileModeAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("mobileapp", out var mValue) && mValue == "1")
        {
            if (!State.IsMobileApp) State.IsMobileApp = true;
            try { await JS.InvokeVoidAsync("sessionStorage.setItem", "mobileapp", "1"); } catch { }
        }

        if (query.TryGetValue("nativeapp", out var nValue) && nValue == "1")
        {
            if (!State.IsNativeApp) State.IsNativeApp = true;
            if (!State.IsMobileApp) State.IsMobileApp = true;
            try { await JS.InvokeVoidAsync("sessionStorage.setItem", "nativeapp", "1"); } catch { }
        }
        else
        {
            try
            {
                var storedNative = await JS.InvokeAsync<string>("sessionStorage.getItem", "nativeapp");
                if (storedNative == "1")
                {
                    if (!State.IsNativeApp) State.IsNativeApp = true;
                    if (!State.IsMobileApp) State.IsMobileApp = true;
                }
                var storedMobile = await JS.InvokeAsync<string>("sessionStorage.getItem", "mobileapp");
                if (storedMobile == "1")
                {
                    if (!State.IsMobileApp) State.IsMobileApp = true;
                }
            }
            catch { }
        }
    }

    public void Dispose()
    {
        _disposed = true;
        Navigation.LocationChanged -= HandleLocationChanged;
        State.OnChange -= OnStateChange;
    }

    private void ToggleSidebar()
    {
        SidebarOpen = !SidebarOpen;
    }

    private void CloseSidebar()
    {
        // Only relevant on mobile where sidebar overlays content
        SidebarOpen = false;
    }

    private async Task HandleLogout()
    {
        await AuthService.Logout();
        Navigation.NavigateTo("/login");
    }
}
