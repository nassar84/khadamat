@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation
@inject Khadamat.BlazorUI.State.AppState State
@inject IJSRuntime JS

<div class="provider-layout" dir="rtl">
    @if (State.IsNativeApp)
    {
        <main class="mobile-content">
            @Body
        </main>
    }
    else if (State.IsMobileApp)
    {
        <MobileHeader />
        <MobileSidebar />
        <main class="mobile-content">
            @Body
        </main>
        <MobileBottomNav />
    }
    else
    {
        <main class="provider-content">
            @Body
        </main>
    }
</div>

@code {
    private bool _disposed = false;

    protected override void OnInitialized()
    {
        State.OnChange += OnStateChange;
        Navigation.LocationChanged += HandleLocationChanged;
        CheckMobileMode();
    }

    private async void OnStateChange()
    {
        if (_disposed) return;
        try { await InvokeAsync(StateHasChanged); }
        catch (ObjectDisposedException) { }
        catch (InvalidOperationException) { }
    }

    private void CheckMobileMode()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("mobileapp", out var value) && value == "1")
        {
            if (!State.IsMobileApp) State.IsMobileApp = true;
        }
        if (query.TryGetValue("nativeapp", out var nValue) && nValue == "1")
        {
            if (!State.IsNativeApp) State.IsNativeApp = true;
            if (!State.IsMobileApp) State.IsMobileApp = true;
        }
    }

    private async void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (_disposed) return;
        _ = CheckMobileModeAsync();
        try { await InvokeAsync(StateHasChanged); }
        catch { }
    }

    private async Task CheckMobileModeAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("mobileapp", out var mValue) && mValue == "1")
        {
            if (!State.IsMobileApp) State.IsMobileApp = true;
            try { await JS.InvokeVoidAsync("sessionStorage.setItem", "mobileapp", "1"); } catch { }
        }

        if (query.TryGetValue("nativeapp", out var nValue) && nValue == "1")
        {
            if (!State.IsNativeApp) State.IsNativeApp = true;
            if (!State.IsMobileApp) State.IsMobileApp = true;
            try { await JS.InvokeVoidAsync("sessionStorage.setItem", "nativeapp", "1"); } catch { }
        }
        else
        {
            try
            {
                var storedNative = await JS.InvokeAsync<string>("sessionStorage.getItem", "nativeapp");
                if (storedNative == "1")
                {
                    if (!State.IsNativeApp) State.IsNativeApp = true;
                    if (!State.IsMobileApp) State.IsMobileApp = true;
                }
                var storedMobile = await JS.InvokeAsync<string>("sessionStorage.getItem", "mobileapp");
                if (storedMobile == "1")
                {
                    if (!State.IsMobileApp) State.IsMobileApp = true;
                }
            }
            catch { }
        }
    }

    public void Dispose()
    {
        _disposed = true;
        Navigation.LocationChanged -= HandleLocationChanged;
        State.OnChange -= OnStateChange;
    }
}
