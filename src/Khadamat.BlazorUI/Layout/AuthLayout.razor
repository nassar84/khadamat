@inherits LayoutComponentBase
@inject Khadamat.BlazorUI.State.AppState AppState
@inject Khadamat.BlazorUI.Services.ApiClient Api
@inject IJSRuntime JS

<div class="auth-layout @(AppState.IsMobileApp ? "mobile-mode" : "") @(AppState.IsNativeApp ? "native-mode" : "")" dir="rtl">
    @if (!AppState.IsNativeApp && AppState.IsMobileApp)
    {
        <MobileHeader />
    }

    <!-- Global Permanent Fixed Header Curve (Visible on ALL pages across the entire application) -->
    @if (AppState.IsMobileApp || AppState.IsNativeApp)
    {
        <div class="global-fixed-curved-transition" aria-hidden="true">
            <svg class="curve-corner left" width="32" height="32" viewBox="0 0 32 32">
                <path d="M0,0 L32,0 A32,32 0 0,0 0,32 Z" fill="#1e40af" />
            </svg>
            <svg class="curve-corner right" width="32" height="32" viewBox="0 0 32 32">
                <path d="M32,0 L0,0 A32,32 0 0,1 32,32 Z" fill="#1e40af" />
            </svg>
        </div>
    }

    @if (!AppState.IsMobileApp && !AppState.IsNativeApp)
    {
        <div class="auth-background"></div>
        <div class="auth-content">
            @Body
        </div>
    }
    else
    {
        <div class="global-curved-sheet auth-curved-sheet">
            <div class="auth-content">
                @Body
            </div>
        </div>
    }
</div>

<style>
    .auth-layout {
        position: relative;
        min-height: 100%;
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        box-sizing: border-box;
        overflow-x: hidden;
    }

    .auth-layout:not(.mobile-mode):not(.native-mode) {
        padding: 16px;
    }

    .auth-layout.native-mode,
    .auth-layout.mobile-mode {
        justify-content: flex-start;
        align-items: stretch;
        background: #1e40af !important;
        padding: 0;
    }

    .auth-background {
        position: absolute;
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
        z-index: -1;
    }

    .auth-curved-sheet {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 24px 16px;
        background: #f8fafc !important;
        border-top-left-radius: 28px !important;
        border-top-right-radius: 28px !important;
        box-sizing: border-box;
    }

    .auth-content {
        width: 100%;
        max-width: 440px;
        z-index: 10;
        margin: auto;
    }
</style>

@inject NavigationManager Navigation

@code {
    protected override async Task OnInitializedAsync()
    {
        CheckNativeModeFromUrl();

        // Load global settings if not already loaded (e.g. if arriving directly at login)
        if (AppState.AppName == "خدمات" || AppState.AppName == "خدماوى")
        {
            try
            {
                var settingsResult = await Api.GetSettingsAsync();
                if (settingsResult?.Success == true && settingsResult.Data != null)
                {
                    AppState.AppName = settingsResult.Data.ApplicationName;
                    AppState.AppLogo = settingsResult.Data.LogoUrl;
                    AppState.PrimaryColor = settingsResult.Data.PrimaryColor;
                    AppState.SecondaryColor = settingsResult.Data.SecondaryColor;

                    if (!string.IsNullOrEmpty(settingsResult.Data.AppShareUrl))
                        AppState.AppShareUrl = settingsResult.Data.AppShareUrl;
                    if (!string.IsNullOrEmpty(settingsResult.Data.AppShareText))
                        AppState.AppShareText = settingsResult.Data.AppShareText;
                    if (!string.IsNullOrEmpty(settingsResult.Data.AppStoreUrl))
                        AppState.AppStoreUrl = settingsResult.Data.AppStoreUrl;
                    if (!string.IsNullOrEmpty(settingsResult.Data.GooglePlayUrl))
                        AppState.GooglePlayUrl = settingsResult.Data.GooglePlayUrl;
                    if (!string.IsNullOrEmpty(settingsResult.Data.ContactEmail))
                        AppState.ContactEmail = settingsResult.Data.ContactEmail;
                    if (!string.IsNullOrEmpty(settingsResult.Data.ContactPhone))
                        AppState.ContactPhone = settingsResult.Data.ContactPhone;
                    if (!string.IsNullOrEmpty(settingsResult.Data.ContactWhatsApp))
                        AppState.ContactWhatsApp = settingsResult.Data.ContactWhatsApp;

                    AppState.TriggerStateChanged();
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error loading settings in AuthLayout: {ex.Message}");
            }
        }
    }

    private void CheckNativeModeFromUrl()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("nativeapp", out var nValue) && nValue == "1")
        {
            AppState.IsNativeApp = true;
            AppState.IsMobileApp = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !string.IsNullOrEmpty(AppState.PrimaryColor))
        {
            try
            {
                await JS.InvokeVoidAsync("applyThemeColors", AppState.PrimaryColor, AppState.SecondaryColor);
            }
            catch { }
        }
    }
}
