@code {
    private string DisplayName = "مستخدم";
    private bool _isAuthenticated = false;
    private bool _isAdmin = false;
    private bool _isSuperAdmin = false;
    private bool _isProvider = false;
    private bool _disposed = false;

    protected override async Task OnInitializedAsync()
    {
        State.OnChange += OnStateChange;
        AuthStateProvider.AuthenticationStateChanged += OnAuthStateChanged;
        await UpdateUserDataAsync();
    }

    private async void OnAuthStateChanged(Task<AuthenticationState> task)
    {
        if (_disposed) return;
        try
        {
            await UpdateUserDataAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch { }
    }

    private async void OnStateChange()
    {
        if (_disposed) return;
        try 
        { 
            await UpdateUserDataAsync();
            await InvokeAsync(StateHasChanged); 
        }
        catch (ObjectDisposedException) { }
        catch (InvalidOperationException) { }
    }

    private async Task UpdateUserDataAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            _isAuthenticated = (user.Identity?.IsAuthenticated == true) || State.IsLoggedIn;

            if (_isAuthenticated)
            {
                var roleClaims = user.FindAll(ClaimTypes.Role).Select(c => c.Value).ToList();
                if (!roleClaims.Any())
                {
                    roleClaims = user.FindAll("role").Select(c => c.Value).ToList();
                }

                _isSuperAdmin = roleClaims.Any(r => r.Equals("SuperAdmin", StringComparison.OrdinalIgnoreCase)) 
                                || State.IsSuperAdmin;
                
                _isAdmin = _isSuperAdmin 
                           || roleClaims.Any(r => r.Equals("SystemAdmin", StringComparison.OrdinalIgnoreCase) || r.Equals("Admin", StringComparison.OrdinalIgnoreCase)) 
                           || State.IsAdmin;

                _isProvider = State.IsProvider || roleClaims.Any(r => r.Equals("Provider", StringComparison.OrdinalIgnoreCase) || r.Equals("Craftsman", StringComparison.OrdinalIgnoreCase));

                if (_isSuperAdmin)
                    DisplayName = "مدير خارق";
                else if (_isAdmin)
                    DisplayName = "مدير نظام";
                else if (_isProvider)
                    DisplayName = "صاحب خدمة";
                else
                    DisplayName = "عميل";
            }
            else
            {
                _isAdmin = false;
                _isSuperAdmin = false;
                _isProvider = false;
                DisplayName = "زائر";
            }
        }
        catch { }
    }

    private string GetRoleBadgeClass()
    {
        if (_isSuperAdmin) return "badge-superadmin";
        if (_isAdmin) return "badge-admin";
        if (_isProvider) return "badge-provider";
        return "badge-client";
    }

    public void Dispose()
    {
        _disposed = true;
        State.OnChange -= OnStateChange;
        AuthStateProvider.AuthenticationStateChanged -= OnAuthStateChanged;
    }

    private void CloseSidebar()
    {
        State.IsSidebarOpen = false;
        _ = InvokeAsync(State.TriggerStateChanged);
    }

    private void NavigateTo(string path)
    {
        State.IsSidebarOpen = false;
        Navigation.NavigateTo(path, forceLoad: false);
        _ = InvokeAsync(State.TriggerStateChanged);
    }

    private async Task HandleLogout()
    {
        CloseSidebar();
        await AuthService.Logout();
        await UpdateUserDataAsync();
        if (!State.IsNativeApp)
        {
            Navigation.NavigateTo("/login", forceLoad: false);
        }
    }

    private async Task RefreshApp()
    {
        CloseSidebar();
        await JS.InvokeVoidAsync("location.reload");
    }

    private string GetActiveClass(string path)
    {
        var currentPath = new Uri(Navigation.Uri).AbsolutePath.Trim('/');
        return currentPath == path.Trim('/') ? "active" : "";
    }

    private async Task ShareApp()
    {
        var shareUrl = !string.IsNullOrEmpty(State.AppShareUrl) ? State.AppShareUrl : Navigation.BaseUri;
        var shareText = !string.IsNullOrEmpty(State.AppShareText)
            ? State.AppShareText
            : $"📲 منصة {State.AppName} — خدماتك في مكان واحد.. لكل المصريين!\nتواصل مباشرة مع أفضل الحرفيين والمهنيين ومقدمي الخدمات بكل سهولة وأمان.";
        var fullText = $"{shareText}\n\n🔗 رابط التحميل والمشاركة:\n{shareUrl}";
        await ShareService.ShareTextAsync(fullText, $"مشاركة تطبيق {State.AppName}");
    }
}
