@using Khadamat.BlazorUI.State
@inject AppState State
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject Khadamat.BlazorUI.Services.Auth.IAuthService AuthService
@inject Khadamat.Shared.Interfaces.IShareService ShareService
@implements IDisposable

<div class="sidebar-overlay @(State.IsSidebarOpen ? "show" : "")" @onclick="CloseSidebar"></div>

<aside class="mobile-sidebar-drawer @(State.IsSidebarOpen ? "open" : "")">
    <div class="sidebar-menu">
        <AuthorizeView>
            <Authorized>
                <div class="sidebar-top-modern profile-header">
                    <div class="user-brief-modern-row" @onclick='() => NavigateTo("/profile")'>
                        <div class="user-info-modern-left">
                            <span class="welcome-text">مرحباً بك،</span>
                            <span class="user-name-title">@State.UserName</span>
                        </div>
                        <div class="avatar-circle-shadow">
                            <img src="@State.UserImageUrl" class="user-avatar-modern" />
                        </div>
                    </div>
                </div>

                <div class="menu-sections-wrapper">
                    <div class="menu-section">
                        <h6 class="section-title">القائمة الرئيسية</h6>
                            <div class="menu-item @GetActiveClass("")" @onclick='() => NavigateTo("/")'>
                                <i class="fa-solid fa-house"></i>
                                <span>الرئيسية</span>
                            </div>
                            <h6 class="section-title">التصنيفات</h6>
                            <div class="menu-item @GetActiveClass("marketplace")" @onclick='() => NavigateTo("/marketplace")'>
                                <i class="fa-solid fa-store text-primary"></i>
                                <span>المتجر</span>
                                <span class="premium-badge-mini">مميز</span>
                            </div>
                            <div class="menu-item" @onclick="RefreshApp">
                                <i class="fa-solid fa-rotate"></i>
                                <span>تحديث التطبيق</span>
                            </div>
                    </div>

                    <div class="menu-section">
                        <h6 class="section-title">نشاطي</h6>
                        <div class="menu-items">
                            <div class="menu-item @GetActiveClass("user/my-services")" @onclick='() => NavigateTo("/user/my-services")'>
                                <i class="fa-solid fa-briefcase text-secondary"></i>
                                <span>خدماتي</span>
                            </div>
                            <div class="menu-item @GetActiveClass("user/my-requests")" @onclick='() => NavigateTo("/user/my-requests")'>
                                <i class="fa-solid fa-list-check text-secondary"></i>
                                <span>طلباتي</span>
                            </div>
                            <div class="menu-item @GetActiveClass("user/messages")" @onclick='() => NavigateTo("/user/messages")'>
                                <i class="fa-solid fa-envelope text-secondary"></i>
                                <span>رسائلي</span>
                            </div>
                            <div class="menu-item @GetActiveClass("user/notifications")" @onclick='() => NavigateTo("/user/notifications")'>
                                <i class="fa-solid fa-bell text-secondary"></i>
                                <span>الإشعارات</span>
                            </div>
                            <div class="menu-item @GetActiveClass("client/favorites")" @onclick='() => NavigateTo("/client/favorites")'>
                                <i class="fa-solid fa-heart text-danger"></i>
                                <span>المفضلة</span>
                            </div>
                            <div class="menu-item @GetActiveClass("profile/my-ads")" @onclick='() => NavigateTo("/profile/my-ads")'>
                                <i class="fa-solid fa-rectangle-ad" style="color: #f59e0b;"></i>
                                <span class="fw-bold" style="color: #92400e;">إحصائيات إعلاناتي</span>
                            </div>
                            <div class="menu-item @GetActiveClass("marketplace/my-listings")" @onclick='() => NavigateTo("/marketplace/my-listings")'>
                                <i class="fa-solid fa-box-open" style="color: #8b5cf6;"></i>
                                <span>إعلاناتي</span>
                            </div>
                        </div>
                    </div>

                    <div class="menu-section">
                        <h6 class="section-title">الإعدادات</h6>
                        <div class="menu-items">
                            <div class="menu-item @GetActiveClass("profile")" @onclick='() => NavigateTo("/profile")'>
                                <i class="fa-solid fa-user-gear"></i>
                                <span>الملف الشخصي</span>
                            </div>

                            <div class="menu-item @GetActiveClass("services")" @onclick='() => NavigateTo("/services")'>
                                <i class="fa-solid fa-briefcase"></i>
                                <span>استكشاف الخدمات</span>
                            </div>
                            <div class="menu-item @GetActiveClass("explore")" @onclick='() => NavigateTo("/explore")'>
                                <i class="fa-solid fa-compass"></i>
                                <span>استكشف</span>
                            </div>
                            <AuthorizeView Roles="SystemAdmin,SuperAdmin" Context="adminCtx">
                                <div class="menu-item admin-link-premium" @onclick='() => NavigateTo("/admin")'>
                                    <i class="fa-solid fa-shield-halved"></i>
                                    <span>لوحة المدير</span>
                                </div>
                                <div class="menu-item" style="background: rgba(var(--theme-primary-rgb), 0.05);" @onclick='() => NavigateTo("/admin/users")'>
                                    <i class="fa-solid fa-users text-primary"></i>
                                    <span>إدارة المستخدمين</span>
                                </div>
                                <div class="menu-item" style="background: rgba(var(--theme-primary-rgb), 0.05);" @onclick='() => NavigateTo("/admin/approvals/providers")'>
                                    <i class="fa-solid fa-user-check text-primary"></i>
                                    <span>اعتماد المزودين</span>
                                </div>
                                <div class="menu-item" style="background: rgba(var(--theme-primary-rgb), 0.05);" @onclick='() => NavigateTo("/admin/services")'>
                                    <i class="fa-solid fa-briefcase text-primary"></i>
                                    <span>إدارة الخدمات</span>
                                </div>
                                <div class="menu-item" style="background: rgba(var(--theme-primary-rgb), 0.05);" @onclick='() => NavigateTo("/admin/adsmanagement")'>
    <i class="fa-solid fa-rectangle-ad text-primary"></i>
    <span>إدارة الإعلانات</span>
</div>
                                <div class="menu-item" style="background: rgba(var(--theme-primary-rgb), 0.05);" @onclick='() => NavigateTo("/admin/categories")'>
                                    <i class="fa-solid fa-th-large text-primary"></i>
                                    <span>التصنيفات</span>
                                </div>
                                <div class="menu-item" style="background: rgba(var(--theme-primary-rgb), 0.05);" @onclick='() => NavigateTo("/admin/locations")'>
                                    <i class="fa-solid fa-map-marker-alt text-primary"></i>
                                    <span>المناطق</span>
                                </div>
                                <div class="menu-item" style="background: rgba(var(--theme-primary-rgb), 0.05);" @onclick='() => NavigateTo("/admin/reports")'>
                                    <i class="fa-solid fa-file-alt text-primary"></i>
                                    <span>التقارير</span>
                                </div>
                                <div class="menu-item" style="background: rgba(var(--theme-primary-rgb), 0.05);" @onclick='() => NavigateTo("/admin/settings")'>
                                    <i class="fa-solid fa-cogs text-primary"></i>
                                    <span>إعدادات لوحة التحكم</span>
                                </div>
                                <AuthorizeView Roles="SuperAdmin" Context="superCtx">
                                    <div class="menu-item" style="background: rgba(var(--theme-primary-rgb), 0.08);" @onclick='() => NavigateTo("/admin/systemsettings")'>
                                        <i class="fa-solid fa-gears text-primary"></i>
                                        <span>إعدادات الموقع والتطبيق</span>
                                    </div>
                                    <div class="menu-item" style="background: rgba(var(--theme-primary-rgb), 0.08);" @onclick='() => NavigateTo("/admin/auditlogs")'>
                                        <i class="fa-solid fa-shield-halved text-primary"></i>
                                        <span>سجلات النشاط</span>
                                    </div>
                                </AuthorizeView>
                            </AuthorizeView>
                        </div>
                    </div>

                    @if (State.IsProvider)
                    {
                        <div class="menu-section">
                            <h6 class="section-title">إعدادات المزود</h6>
                            <div class="menu-items">
                                 <div class="menu-item provider-switch-item" @onclick="ToggleProviderMode">
                                    <i class="fa-solid fa-shuffle"></i>
                                    <span>@(State.IsProviderMode ? "التبديل للمستخدم العادي" : "التبديل للمهني/المزود")</span>
                                 </div>
                                @if (State.IsProviderMode)
                                {
                                    <div class="menu-item @GetActiveClass("provider/dashboard")" @onclick='() => NavigateTo("/provider/dashboard")'>
                                        <i class="fa-solid fa-gauge-high"></i>
                                        <span>لوحة المزود</span>
                                    </div>
                                    <div class="menu-item @GetActiveClass("provider/my-services")" @onclick='() => NavigateTo("/provider/my-services")'>
                                        <i class="fa-solid fa-briefcase"></i>
                                        <span>خدماتي</span>
                                    </div>
                                    <div class="menu-item @GetActiveClass("provider/statistics")" @onclick='() => NavigateTo("/provider/statistics")'>
                                        <i class="fa-solid fa-chart-line"></i>
                                        <span>الإحصائيات</span>
                                    </div>
                                    <div class="menu-item @GetActiveClass("provider/referrals")" @onclick='() => NavigateTo("/provider/referrals")'>
                                        <i class="fa-solid fa-users-viewfinder text-primary"></i>
                                        <span class="text-primary fw-bold">نظام الإحالة</span>
                                    </div>
                                    <div class="menu-item @GetActiveClass("provider/ad-analytics")" @onclick='() => NavigateTo("/provider/ad-analytics")'>
                                        <i class="fa-solid fa-chart-pie text-success"></i>
                                        <span class="text-success fw-bold">إحصائيات الإعلانات</span>
                                    </div>
                                    <div class="menu-item @GetActiveClass("provider/create-service")" @onclick='() => NavigateTo("/provider/create-service")'>
                                        <i class="fa-solid fa-pen-to-square"></i>
                                        <span>منشور جديد</span>
                                    </div>
                                    <div class="menu-item @GetActiveClass("provider/subscription")" @onclick='() => NavigateTo("/provider/subscription")'>
                                        <i class="fa-solid fa-gem"></i>
                                        <span>اشتراكي</span>
                                    </div>
                                    <div class="menu-item @GetActiveClass("provider/settings")" @onclick='() => NavigateTo("/provider/settings")'>
                                        <i class="fa-solid fa-sliders"></i>
                                        <span>إعدادات المزود</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <div class="menu-section mt-auto">
                        <div class="menu-items mt-5">
                            <div class="menu-item" @onclick='() => NavigateTo("/support")'>
                                <span class="item-icon">🆘</span>
                                <span>الدعم والمساعدة</span>
                            </div>
                            <div class="menu-item" @onclick='() => NavigateTo("/terms")'>
                                <span class="item-icon">📜</span>
                                <span>الشروط والأحكام</span>
                            </div>
                            <div class="menu-item logout-item-new mt-3" @onclick="HandleLogout">
                                <i class="fa-solid fa-power-off"></i>
                                <span>تسجيل الخروج</span>
                            </div>
                        </div>
                    </div>
                </div>
            </Authorized>
            <NotAuthorized>
                <!-- Guest Header: White bg, logo + app name -->
                <div class="guest-header-white px-4 pt-5 pb-3">
                    <div class="d-flex align-items-center gap-2 mb-3" style="cursor:pointer" @onclick='() => NavigateTo("/")'>
                        @if (!string.IsNullOrEmpty(State.AppLogo))
                        {
                            <img src="@State.GetAbsoluteUrl(State.AppLogo)" alt="Logo" style="height: 38px; width: auto; object-fit: contain;" />
                        }
                        else
                        {
                            <span style="font-size:1.6rem; color: var(--theme-primary);">⚡</span>
                        }
                        <span style="font-size:1.3rem; font-weight:800; color: var(--theme-primary);">@(string.IsNullOrEmpty(State.AppNameAr) ? State.AppName : State.AppNameAr)</span>
                    </div>
                    <hr class="my-2" style="border-color:#f1f5f9;" />
                    <!-- Section label -->
                    <p class="section-title mb-2">إكتشف @State.AppName</p>
                    <!-- Home Button - active/filled -->
                    <div class="menu-item active mb-2" @onclick='() => NavigateTo("/")'>
                        <i class="fa-solid fa-house"></i>
                        <span>الرئيسية</span>
                    </div>
                    <!-- Refresh -->
                    <div class="menu-item" @onclick="RefreshApp">
                        <i class="fa-solid fa-rotate"></i>
                        <span>تحديث التطبيق</span>
                    </div>
                </div>

                <!-- Join Card -->
                <div class="px-3 mt-2">
                    <div class="join-card-web">
                        <div class="join-icon-circle">
                            <i class="fa-solid fa-user-plus"></i>
                        </div>
                        <h5 class="join-title">انضم إلينا الآن</h5>
                        <p class="join-subtitle">سجل دخولك لتتمكن من طلب الخدمات والتواصل مع المزودين</p>
                        <div class="d-flex gap-2 mt-3">
                            <button class="btn-join-primary flex-fill" @onclick='() => NavigateTo("/login")'>دخول</button>
                            <button class="btn-join-outline flex-fill" @onclick='() => NavigateTo("/login?tab=register")'>حساب جديد</button>
                        </div>
                    </div>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </div>

    <div class="sidebar-bottom">
        <div class="d-flex flex-column gap-2 mb-3 px-3">
             <button class="btn btn-outline-primary btn-sm rounded-pill w-100" @onclick="ShareApp">
                <i class="fa-solid fa-share-nodes me-2"></i> شارك التطبيق
             </button>
        </div>
        <div class="sidebar-links mb-2 px-3 d-flex justify-content-center gap-3">
            <a href="/terms" class="text-muted text-decoration-none smaller" @onclick="CloseSidebar">الشروط والأحكام</a>
            <a href="/privacy" class="text-muted text-decoration-none smaller" @onclick="CloseSidebar">الخصوصية</a>
        </div>
        <div class="app-version">إصدار 1.0.0</div>
    </div>
</aside>

<style>
    .sidebar-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.4);
        backdrop-filter: blur(4px);
        z-index: 1050;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
    }

    .sidebar-overlay.show {
        opacity: 1;
        pointer-events: auto;
    }

    .mobile-sidebar-drawer {
        position: fixed;
        top: 0;
        right: -300px; /* Hidden off-screen to the right side */
        left: auto !important;
        width: 300px;
        height: 100vh;
        background: #ffffff;
        z-index: 1100;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        flex-direction: column;
        box-shadow: -10px 0 30px rgba(0, 0, 0, 0.05);
        direction: rtl; /* Ensure internal content is RTL too */
        
        /* Enable scrolling */
        overflow-y: auto;
    }

    /* Modern & Subtle Scrollbar for Mobile Sidebar */
    .mobile-sidebar-drawer::-webkit-scrollbar {
        width: 4px;
    }

    .mobile-sidebar-drawer::-webkit-scrollbar-track {
        background: transparent;
    }

    .mobile-sidebar-drawer::-webkit-scrollbar-thumb {
        background: rgba(0, 0, 0, 0.1);
        border-radius: 10px;
    }

    .mobile-sidebar-drawer.open {
        right: 0 !important;
        left: auto !important;
    }

    .profile-header {
        background: linear-gradient(90deg, #6366f1 0%, #a855f7 100%);
        border-radius: 0 0 0 40px; /* Custom curve matching image */
        padding: 40px 20px;
    }

    .user-brief-modern-row {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 20px;
        cursor: pointer;
    }

    .user-info-modern-left {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        text-align: right;
    }

    .avatar-circle-shadow {
        width: 75px;
        height: 75px;
        background: white;
        border-radius: 20px;
        padding: 3px;
        box-shadow: 0 8px 20px rgba(0,0,0,0.2);
    }

    .user-avatar-modern {
        width: 100%;
        height: 100%;
        border-radius: 18px;
        object-fit: cover;
    }

    .welcome-text {
        font-size: 0.9rem;
        font-weight: 600;
        opacity: 0.9;
    }

    .user-name-title {
        font-size: 1.25rem;
        font-weight: 800;
        margin-top: 4px;
        letter-spacing: -0.5px;
    }

    /* Menu Items */
    .menu-item {
        display: flex;
        align-items: center;
        gap: 20px;
        padding: 16px 20px;
        border-radius: 18px;
        color: #1e293b;
        font-weight: 700;
        margin-bottom: 8px;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
