@namespace Khadamat.BlazorUI
<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(AppMain).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    <div class="container py-5 text-center">
                        <div class="glass-card p-5 mx-auto" style="max-width: 500px; border-radius: 30px;">
                            <i class="fa-solid fa-lock fa-3x text-primary mb-3 opacity-50"></i>
                            <h3 class="fw-bold mb-3">تسجيل الدخول مطلوب</h3>
                            <p class="text-muted mb-4">يرجى تسجيل الدخول للوصول إلى محتوى هذه الصفحة.</p>
                            <div class="d-grid gap-2">
                                <a href="/login" class="btn btn-primary btn-lg rounded-pill shadow-sm">تسجيل الدخول</a>
                                <a href="/" class="btn btn-link text-muted">العودة للرئيسية</a>
                            </div>
                        </div>
                    </div>
                </NotAuthorized>
            </AuthorizeRouteView>
        </Found>
        <NotFound>
            <PageTitle>Not found</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">
                <p role="alert">عذراً، هذه الصفحة غير موجودة.</p>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
