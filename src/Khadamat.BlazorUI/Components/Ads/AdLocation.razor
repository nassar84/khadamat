@using Khadamat.Application.DTOs
@using Khadamat.BlazorUI.Services
@inject ApiClient Api
@inject NavigationManager Navigation

@if (ads != null && ads.Any())
{
    <div class="ad-location-wrapper @Placement.ToLower()-ads mb-4">
        @foreach (var ad in ads)
        {
            <div class="ad-item-card mb-3 animate-fade-in" @onclick="() => OnAdClick(ad)">
                @{
                    var hasGradient = !string.IsNullOrEmpty(ad.ImageUrl) && ad.ImageUrl.StartsWith("hero-gradient");
                    var hasRealImage = !string.IsNullOrEmpty(ad.ImageUrl) && !ad.ImageUrl.StartsWith("hero-gradient");
                    var imageUrl = hasRealImage ? Api.GetAbsoluteUrl(Khadamat.BlazorUI.Helpers.ImagePathResolver.Ad(ad.ImageUrl)) : null;
                    var cardClass = hasGradient ? ad.ImageUrl : (string.IsNullOrEmpty(ad.ImageUrl) ? "hero-gradient-1" : "has-bg-image");
                }
                <div class="ad-box @cardClass" style="@(hasRealImage ? $"background-image: url({imageUrl});" : "")">
                    <div class="ad-overlay"></div>
                    <div class="ad-content-mini">
                        @if (!string.IsNullOrEmpty(ad.Title))
                        {
                            <h6 class="ad-title-mini">@ad.Title</h6>
                        }
                        @if (!string.IsNullOrEmpty(ad.Description))
                        {
                            <p class="ad-desc-mini">@ad.Description</p>
                        }
                        <span class="ad-cta-mini">
                            @if (ad.ServiceId.HasValue)
                            {
                                @("عرض الخدمة") <i class="fa-solid fa-arrow-left ms-1"></i>
                            }
                            else
                            {
                                @("عرض المزيد") <i class="fa-solid fa-arrow-left ms-1"></i>
                            }
                        </span>
                    </div>
                    <div class="ad-badge-mini">إعلان</div>
                </div>
            </div>
        }
    </div>
}

<style>
    .ad-box {
        width: 100%;
        min-height: 120px;
        border-radius: 16px;
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        padding: 15px;
        color: white;
        cursor: pointer;
        transition: transform 0.3s ease;
        background-size: cover;
        background-position: center;
        border: 1px solid rgba(0,0,0,0.05);
    }

    .ad-box:hover {
        transform: translateY(-3px);
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    }

    .ad-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(90deg, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0.2) 100%);
        z-index: 1;
    }

    .ad-content-mini {
        position: relative;
        z-index: 2;
        width: 100%;
    }

    .ad-title-mini {
        font-weight: 800;
        font-size: 1rem;
        margin-bottom: 4px;
        text-shadow: 0 1px 3px rgba(0,0,0,0.3);
    }

    .ad-desc-mini {
        font-size: 0.75rem;
        opacity: 0.9;
        margin-bottom: 8px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .ad-cta-mini {
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        border-bottom: 1px solid white;
        padding-bottom: 1px;
    }

    .ad-badge-mini {
        position: absolute;
        top: 10px;
        left: 10px;
        background: rgba(255,255,255,0.2);
        backdrop-filter: blur(4px);
        font-size: 0.6rem;
        padding: 2px 8px;
        border-radius: 10px;
        z-index: 2;
    }

    /* Gradients */
    .hero-gradient-1 { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); }
    .hero-gradient-2 { background: linear-gradient(135deg, #0abde3 0%, #00d2d3 100%); }
    .hero-gradient-3 { background: linear-gradient(135deg, #ff6b6b 0%, #ee5a24 100%); }
    .hero-gradient-4 { background: linear-gradient(135deg, #10ac84 0%, #01a3a4 100%); }

    .bottom-ads {
        margin-top: 20px;
    }
</style>

@code {
    [Parameter] public string Placement { get; set; } = "Sidebar";
    
    private List<EnhancedAdDto>? ads;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            ads = await Api.GetAdsByPlacementAsync(Placement);
            if (ads != null)
            {
                foreach (var ad in ads)
                {
                    _ = Api.TrackAdViewAsync(ad.Id); // Fire and forget
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading {Placement} ads: {ex.Message}");
        }
    }

    private async Task OnAdClick(EnhancedAdDto ad)
    {
        _ = Api.TrackAdClickAsync(ad.Id); // Track click
        if (ad.ServiceId.HasValue && ad.ServiceId.Value > 0)
        {
            Navigation.NavigateTo($"/service/{ad.ServiceId.Value}");
        }
        else if (!string.IsNullOrEmpty(ad.TargetUrl))
        {
            Navigation.NavigateTo(ad.TargetUrl);
        }
    }
}
