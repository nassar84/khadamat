@using Khadamat.Application.DTOs
@using Khadamat.BlazorUI.Services
@using Khadamat.BlazorUI.Helpers
@inject ApiClient Api
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

@if (ads != null && ads.Any())
{
    <div class="ad-location-wrapper @Placement.ToLower()-ads mb-4">
        @foreach (var ad in ads)
        {
            var hasGradient = !string.IsNullOrEmpty(ad.ImageUrl) && ad.ImageUrl.StartsWith("hero-gradient");
            var hasRealImage = !string.IsNullOrEmpty(ad.ImageUrl) && !hasGradient;
            var imageUrl = hasRealImage ? Api.GetAbsoluteUrl(ImagePathResolver.Ad(ad.ImageUrl)) : null;
            var cardClass = hasGradient ? ad.ImageUrl : "hero-gradient-1";

            <div class="ad-item-card mb-3 animate-fade-in cursor-pointer" @onclick="() => OnAdClick(ad)" title="اضغط للانتقال للإعلان">
                <div class="ad-box @cardClass">
                    @if (!string.IsNullOrEmpty(imageUrl))
                    {
                        <img src="@imageUrl" 
                             alt="@(!string.IsNullOrEmpty(ad.Title) ? ad.Title : "إعلان مميز")" 
                             class="ad-mini-img" 
                             onerror="this.style.display='none';" />
                    }

                    <div class="ad-overlay"></div>

                    <div class="ad-content-mini">
                        @if (!string.IsNullOrEmpty(ad.Title))
                        {
                            <h6 class="ad-title-mini">@ad.Title</h6>
                        }
                        else
                        {
                            <h6 class="ad-title-mini">إعلان مميز</h6>
                        }

                        @if (!string.IsNullOrEmpty(ad.Description))
                        {
                            <p class="ad-desc-mini">@ad.Description</p>
                        }
                        else if (!string.IsNullOrEmpty(ad.TextContent))
                        {
                            <p class="ad-desc-mini">@ad.TextContent</p>
                        }

                        <span class="ad-cta-mini">
                            @if (ad.ServiceId.HasValue)
                            {
                                @("عرض الخدمة") <i class="fa-solid fa-arrow-left ms-1"></i>
                            }
                            else
                            {
                                @("عرض المزيد") <i class="fa-solid fa-arrow-left ms-1"></i>
                            }
                        </span>
                    </div>

                    <div class="ad-badge-mini">إعلان</div>
                </div>
            </div>
        }
    </div>
}

<style>
    .ad-box {
        width: 100%;
        min-height: 120px;
        border-radius: 16px;
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        padding: 15px;
        color: white;
        cursor: pointer;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        border: 1px solid rgba(0,0,0,0.05);
        background-color: #1e293b;
    }

    .ad-mini-img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: 0;
        transition: transform 0.4s ease;
    }

    .ad-box:hover .ad-mini-img {
        transform: scale(1.05);
    }

    .ad-box:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgba(0,0,0,0.15);
    }

    .ad-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(90deg, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.3) 100%);
        z-index: 1;
    }

    .ad-content-mini {
        position: relative;
        z-index: 2;
        width: 100%;
    }

    .ad-title-mini {
        font-weight: 800;
        font-size: 1rem;
        margin-bottom: 4px;
        text-shadow: 0 1px 3px rgba(0,0,0,0.4);
        color: #ffffff;
    }

    .ad-desc-mini {
        font-size: 0.78rem;
        opacity: 0.95;
        margin-bottom: 8px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-shadow: 0 1px 3px rgba(0,0,0,0.4);
    }

    .ad-cta-mini {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        border-bottom: 1px solid white;
        padding-bottom: 1px;
    }

    .ad-badge-mini {
        position: absolute;
        top: 10px;
        left: 10px;
        background: rgba(255,255,255,0.25);
        backdrop-filter: blur(6px);
        font-size: 0.65rem;
        font-weight: 700;
        padding: 2px 10px;
        border-radius: 12px;
        z-index: 3;
        border: 1px solid rgba(255,255,255,0.3);
    }

    /* Gradients */
    .hero-gradient-1 { background: linear-gradient(135deg, #1e293b 0%, #334155 100%); }
    .hero-gradient-2 { background: linear-gradient(135deg, #0abde3 0%, #00d2d3 100%); }
    .hero-gradient-3 { background: linear-gradient(135deg, #ff6b6b 0%, #ee5a24 100%); }
    .hero-gradient-4 { background: linear-gradient(135deg, #10ac84 0%, #01a3a4 100%); }

    .bottom-ads {
        margin-top: 20px;
    }
</style>

@code {
    [Parameter] public string Placement { get; set; } = "Sidebar";
    
    private List<EnhancedAdDto>? ads;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            ads = await Api.GetAdsByPlacementAsync(Placement);
            if (ads != null)
            {
                foreach (var ad in ads)
                {
                    _ = Api.TrackAdViewAsync(ad.Id);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading {Placement} ads: {ex.Message}");
        }
    }

    private string GetAdTargetUrl(EnhancedAdDto ad)
    {
        if (ad.ServiceId.HasValue && ad.ServiceId.Value > 0)
        {
            return $"/service/{ad.ServiceId.Value}";
        }
        if (!string.IsNullOrWhiteSpace(ad.TargetUrl))
        {
            return ad.TargetUrl;
        }
        if (!string.IsNullOrWhiteSpace(ad.TargetCategories))
        {
            var firstCat = ad.TargetCategories.Split(',')[0].Trim();
            if (!string.IsNullOrEmpty(firstCat))
            {
                return $"/services?categoryId={firstCat}";
            }
        }
        return "/services";
    }

    private async Task OnAdClick(EnhancedAdDto ad)
    {
        _ = Api.TrackAdClickAsync(ad.Id);
        var target = GetAdTargetUrl(ad);

        if (target.StartsWith("http://", StringComparison.OrdinalIgnoreCase) || 
            target.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            await JSRuntime.InvokeVoidAsync("open", target, "_blank");
        }
        else
        {
            Navigation.NavigateTo(target);
        }
    }
}
