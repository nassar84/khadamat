@using Khadamat.Application.DTOs
@using Khadamat.BlazorUI.Services
@using Khadamat.BlazorUI.Helpers
@inject ApiClient Api
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

<div class="ads-slider-wrapper mb-4">
    @if (ads == null)
    {
        <div class="skeleton ads-skeleton rounded-4"></div>
    }
    else if (!ads.Any())
    {
        <div class="no-ads-placeholder rounded-4 d-flex flex-column align-items-center justify-content-center p-4 text-center cursor-pointer shadow-sm" @onclick='() => Navigation.NavigateTo("/services")'>
            <div class="d-flex align-items-center gap-2 mb-1 text-primary fw-bold fs-5">
                <i class="fa-solid fa-rectangle-ad"></i>
                <span>إعلانات وخدمات مميزة في خدماوي</span>
            </div>
            <p class="text-muted small mb-0">انقر هنا لاستكشاف أحدث الخدمات والمنتجات المتاحة</p>
        </div>
    }
    else
    {
        <div class="ads-carousel" id="adsCarousel">
            @for (int i = 0; i < ads.Count; i++)
            {
                var ad = ads[i];
                var targetUrl = GetAdTargetUrl(ad);
                var hasGradient = !string.IsNullOrEmpty(ad.ImageUrl) && ad.ImageUrl.StartsWith("hero-gradient");
                var hasRealImage = !string.IsNullOrEmpty(ad.ImageUrl) && !hasGradient;
                var imageUrl = hasRealImage ? Api.GetAbsoluteUrl(ImagePathResolver.Ad(ad.ImageUrl)) : null;
                var cardClass = hasGradient ? ad.ImageUrl : "hero-gradient-1";

                <div class="ad-slide @(i == currentIndex ? "active" : "")" @onclick="() => OnAdClick(ad)" title="اضغط للانتقال للإعلان">
                    <div class="ad-content-card @cardClass">
                        @if (!string.IsNullOrEmpty(imageUrl))
                        {
                            <img src="@imageUrl" 
                                 alt="@(!string.IsNullOrEmpty(ad.Title) ? ad.Title : "إعلان مميز")" 
                                 class="ad-background-image" 
                                 onerror="this.style.display='none';" />
                        }
                        
                        <div class="glass-overlay"></div>

                        <!-- Ad Text & Call To Action -->
                        <div class="ad-text-content">
                            @if (!string.IsNullOrEmpty(ad.Title))
                            {
                                <h2 class="ad-title animate-pop">@ad.Title</h2>
                            }
                            else
                            {
                                <h2 class="ad-title animate-pop">إعلان مميز</h2>
                            }

                            @if (!string.IsNullOrEmpty(ad.Description))
                            {
                                <p class="ad-desc animate-fade-in shadow-text">@ad.Description</p>
                            }
                            else if (!string.IsNullOrEmpty(ad.TextContent))
                            {
                                <p class="ad-desc animate-fade-in shadow-text">@ad.TextContent</p>
                            }

                            <div class="d-inline-flex align-items-center gap-2 btn btn-light rounded-pill px-4 btn-sm fw-bold mt-2 shadow-sm ad-cta-btn">
                                <span>@(ad.ServiceId.HasValue ? "عرض الخدمة" : "عرض التفاصيل")</span>
                                <i class="fa-solid fa-arrow-left"></i>
                            </div>
                        </div>

                        <div class="ad-badge-label">إعلان</div>
                    </div>
                </div>
            }
        </div>
        
        @if (ads.Count > 1)
        {
            <div class="ads-indicators">
                @for (int i = 0; i < ads.Count; i++)
                {
                    var index = i;
                    <span class="dot @(i == currentIndex ? "active" : "")" @onclick:stopPropagation="true" @onclick="() => GoToSlide(index)"></span>
                }
            </div>
        }
    }
</div>

<style>
    .ads-slider-wrapper {
        position: relative;
        width: 100%;
        height: 200px;
        overflow: hidden;
        border-radius: 24px;
    }
    
    .ads-carousel {
        width: 100%;
        height: 100%;
        position: relative;
    }
    
    .ad-slide {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        transition: opacity 0.8s ease-in-out, transform 0.5s ease;
        pointer-events: none;
        cursor: pointer;
    }
    
    .ad-slide.active {
        opacity: 1;
        pointer-events: auto;
    }
    
    .ad-content-card {
        width: 100%;
        height: 100%;
        background-color: #1e293b;
        border-radius: 24px;
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        padding: 0 40px;
        color: white;
        box-shadow: 0 10px 25px rgba(0,0,0,0.12);
    }

    .ad-background-image {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: 0;
        transition: transform 0.6s ease;
    }

    .ad-content-card:hover .ad-background-image {
        transform: scale(1.04);
    }
    
    .glass-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(90deg, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.3) 50%, rgba(0,0,0,0.1) 100%);
        z-index: 1;
    }
    
    .ad-text-content {
        position: relative;
        z-index: 2;
        max-width: 70%;
    }
    
    .ad-title {
        font-weight: 800;
        font-size: 1.6rem;
        margin-bottom: 6px;
        text-shadow: 0 2px 6px rgba(0,0,0,0.5);
        color: #ffffff;
    }
    
    .ad-desc {
        font-size: 0.95rem;
        opacity: 0.95;
        margin-bottom: 10px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-shadow: 0 1px 4px rgba(0,0,0,0.5);
    }

    .ad-badge-label {
        position: absolute;
        top: 15px;
        left: 20px;
        background: rgba(255, 255, 255, 0.25);
        backdrop-filter: blur(8px);
        color: white;
        font-size: 0.75rem;
        font-weight: 700;
        padding: 4px 12px;
        border-radius: 20px;
        z-index: 3;
        border: 1px solid rgba(255, 255, 255, 0.3);
    }
    
    .ad-cta-btn {
        transition: all 0.3s ease;
    }

    .ad-content-card:hover .ad-cta-btn {
        transform: translateX(-5px);
        background: #ffffff !important;
        color: #0f172a !important;
    }
    
    /* Predefined Gradients */
    .hero-gradient-1 { background: linear-gradient(135deg, #1e293b 0%, #334155 100%); }
    .hero-gradient-2 { background: linear-gradient(135deg, #0abde3 0%, #00d2d3 100%); }
    .hero-gradient-3 { background: linear-gradient(135deg, #ff6b6b 0%, #ee5a24 100%); }
    .hero-gradient-4 { background: linear-gradient(135deg, #10ac84 0%, #01a3a4 100%); }
    
    .ads-indicators {
        position: absolute;
        bottom: 12px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        gap: 8px;
        z-index: 10;
    }
    
    .dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: rgba(255,255,255,0.4);
        cursor: pointer;
        transition: all 0.3s ease;
    }
    
    .dot.active {
        width: 28px;
        border-radius: 6px;
        background: white;
        box-shadow: 0 2px 6px rgba(0,0,0,0.3);
    }
    
    .no-ads-placeholder {
        height: 100%;
        background: #f8fafc;
        border: 2px dashed #cbd5e1;
    }
    
    .ads-skeleton {
        height: 100%;
        background: linear-gradient(90deg, #f1f5f9 25%, #e2e8f0 50%, #f1f5f9 75%);
        background-size: 200% 100%;
        animation: skeleton-loading 1.5s infinite;
    }
    
    .animate-pop {
        animation: pop-in 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
</style>

@code {
    private List<EnhancedAdDto>? ads;
    private int currentIndex = 0;
    private System.Timers.Timer? timer;

    protected override void OnInitialized()
    {
        _ = LoadAdsAsync();
    }

    private async Task LoadAdsAsync()
    {
        try 
        {
            ads = await Api.GetSliderAdsAsync();
            
            if (ads != null && ads.Any())
            {
                foreach (var ad in ads)
                {
                    _ = Api.TrackAdViewAsync(ad.Id); // Fire and forget
                }

                if (ads.Count > 1)
                {
                    timer = new System.Timers.Timer(5000);
                    timer.Elapsed += (s, e) => 
                    {
                        currentIndex = (currentIndex + 1) % ads.Count;
                        InvokeAsync(StateHasChanged);
                    };
                    timer.Enabled = true;
                }
            }
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading ads slider: {ex.Message}");
        }
    }

    private string GetAdTargetUrl(EnhancedAdDto ad)
    {
        if (ad.ServiceId.HasValue && ad.ServiceId.Value > 0)
        {
            return $"/service/{ad.ServiceId.Value}";
        }
        if (!string.IsNullOrWhiteSpace(ad.TargetUrl))
        {
            return ad.TargetUrl;
        }
        if (!string.IsNullOrWhiteSpace(ad.TargetCategories))
        {
            var firstCat = ad.TargetCategories.Split(',')[0].Trim();
            if (!string.IsNullOrEmpty(firstCat))
            {
                return $"/services?categoryId={firstCat}";
            }
        }
        return "/services";
    }

    private void GoToSlide(int index)
    {
        currentIndex = index;
        timer?.Stop();
        timer?.Start();
    }

    private void OnAdClick(EnhancedAdDto ad)
    {
        _ = Api.TrackAdClickAsync(ad.Id);
        var target = GetAdTargetUrl(ad);

        if (target.StartsWith("http://", StringComparison.OrdinalIgnoreCase) || 
            target.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            _ = JSRuntime.InvokeVoidAsync("open", target, "_blank");
        }
        else
        {
            Navigation.NavigateTo(target);
        }
    }

    public void Dispose()
    {
        timer?.Dispose();
    }
}
