@using Khadamat.Application.DTOs
@using Khadamat.BlazorUI.Services
@using Khadamat.BlazorUI.Helpers
@inject ApiClient Api
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@implements IDisposable

<div class="ads-section-container mb-4" @ontouchstart="HandleTouchStart" @ontouchend="HandleTouchEnd">

    @if (ads == null)
    {
        <div class="skeleton ads-skeleton rounded-4"></div>
    }
    else if (ads.Any())
    {
        <!-- Main Sliding Carousel Viewport: Only ONE slide visible at a time (Stacked & Smooth Transition) -->
        <div class="ads-carousel-viewport rounded-4 overflow-hidden position-relative shadow-sm">
            @for (int i = 0; i < ads.Count; i++)
            {
                var ad = ads[i];
                var index = i;
                var imageUrl = ResolveAdImage(ad.ImageUrl);
                var isActive = (i == currentIndex);

                <div class="ad-slide-item @(isActive ? "active" : "")" 
                     @onclick="() => OnAdClick(ad)">
                    
                    <!-- Ambient Blurred Background + 100% Contained Foreground (Zero Cropping) -->
                    @if (!string.IsNullOrEmpty(imageUrl))
                    {
                        <img src="@imageUrl" 
                             alt="" 
                             aria-hidden="true"
                             class="ad-card-bg-blur" 
                             onerror="this.src='/images/ads/ad_electrician.jpg';" />

                        <img src="@imageUrl" 
                             alt="" 
                             aria-hidden="true"
                             class="ad-card-bg-contain" 
                             onerror="this.src='/images/ads/ad_electrician.jpg';" />
                    }
                    else
                    {
                        <div class="ad-card-gradient-bg"></div>
                    }

                    <!-- Cinematic Vignette Overlay -->
                    <div class="ad-card-overlay"></div>

                    <!-- Top Floating Row: Badge "عرض" + Audio Action Circle -->
                    <div class="ad-card-top-row">
                        <span class="ad-offer-pill">
                            <span class="live-dot-green me-1"></span> عرض
                        </span>
                        <button class="ad-audio-circle" type="button" @onclick:stopPropagation="true" title="صوت">
                            <i class="fa-solid fa-volume-high"></i>
                        </button>
                    </div>

                    <!-- Bottom Content: Title + Subtitle + Action Button "دور دلوقتي ←" -->
                    <div class="ad-card-bottom-row">
                        <div class="ad-text-box">
                            @if (!string.IsNullOrWhiteSpace(ad.Title))
                            {
                                <h3 class="ad-title-text">@ad.Title</h3>
                            }
                            <p class="ad-desc-text">@(!string.IsNullOrEmpty(ad.Description) ? ad.Description : ad.TextContent)</p>
                        </div>
                        <div class="ad-action-pill">
                            <span>دور دلوقتي</span>
                            <i class="fa-solid fa-arrow-left"></i>
                        </div>
                    </div>
                </div>
            }

            @if (ads.Count > 1)
            {
                <!-- Desktop Navigation Chevrons -->
                <button class="ad-nav-btn ad-prev-btn" type="button" @onclick="PrevAd" @onclick:stopPropagation="true" aria-label="السابق">
                    <i class="fa-solid fa-chevron-right"></i>
                </button>
                <button class="ad-nav-btn ad-next-btn" type="button" @onclick="NextAd" @onclick:stopPropagation="true" aria-label="التالي">
                    <i class="fa-solid fa-chevron-left"></i>
                </button>
            }
        </div>

        @if (ads.Count > 1)
        {
            <!-- Centered Indicators Below Card: • • ▬ • • -->
            <div class="ads-indicators-bar">
                @for (int i = 0; i < ads.Count; i++)
                {
                    var index = i;
                    <span class="indicator-pill @(i == currentIndex ? "active" : "")" 
                          @onclick="() => ScrollToIndex(index)"></span>
                }
            </div>
        }
    }
</div>

<style>
    .ads-section-container {
        position: relative;
        width: 100%;
        margin-bottom: 24px;
        user-select: none;
    }

    .live-dot-green {
        display: inline-block;
        width: 8px;
        height: 8px;
        background: #22c55e;
        border-radius: 50%;
        box-shadow: 0 0 8px rgba(34, 197, 94, 0.7);
        animation: pulse-live 2s infinite;
        vertical-align: middle;
    }

    @@keyframes pulse-live {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.6; transform: scale(1.2); }
    }

    /* Viewport for single-slide carousel */
    .ads-carousel-viewport {
        position: relative;
        width: 100%;
        height: 215px;
        background: #0f172a;
        border-radius: 24px;
        overflow: hidden;
    }

    @@media (min-width: 768px) {
        .ads-carousel-viewport {
            height: 250px;
        }
    }

    /* Stacked Slides: only the active slide is visible and interactive */
    .ad-slide-item {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.5s ease-in-out, transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
        transform: scale(0.98);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 16px 20px;
        color: #ffffff;
        cursor: pointer;
        z-index: 1;
    }

    @@media (min-width: 768px) {
        .ad-slide-item {
            padding: 22px 28px;
        }
    }

    .ad-slide-item.active {
        opacity: 1;
        pointer-events: auto;
        transform: scale(1);
        z-index: 2;
    }

    /* Ambient blurred layer: smoothly fills the card background */
    .ad-card-bg-blur {
        position: absolute;
        inset: -20px;
        width: calc(100% + 40px);
        height: calc(100% + 40px);
        object-fit: cover;
        filter: blur(24px) brightness(0.55);
        transform: scale(1.15);
        z-index: 0;
        pointer-events: none;
    }

    /* Foreground image: 100% CONTAINED - zero cropping or missing parts */
    .ad-card-bg-contain {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: contain;
        object-position: center;
        z-index: 1;
        pointer-events: none;
        transition: transform 0.4s ease;
    }

    .ad-slide-item:hover .ad-card-bg-contain {
        transform: scale(1.02);
    }

    .ad-card-gradient-bg {
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, #134e4a 0%, #064e3b 50%, #0f172a 100%);
        z-index: 0;
    }

    .ad-card-overlay {
        display: none !important;
    }

    /* Top Row: Offer pill + Audio button */
    .ad-card-top-row {
        position: relative;
        z-index: 3;
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
    }

    .ad-offer-pill {
        background: rgba(255, 255, 255, 0.18);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.25);
        border-radius: 20px;
        padding: 4px 14px;
        font-size: 0.78rem;
        font-weight: 800;
        color: #ffffff;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
    }

    .ad-audio-circle {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.18);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.25);
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.85rem;
        cursor: pointer;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
        transition: transform 0.2s ease, background 0.2s ease;
    }

    .ad-audio-circle:hover {
        background: rgba(255, 255, 255, 0.3);
        transform: scale(1.08);
    }

    /* Bottom Row: Text on Right, Button on Left */
    .ad-card-bottom-row {
        position: relative;
        z-index: 3;
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 12px;
        width: 100%;
    }

    .ad-text-box {
        flex: 1;
        min-width: 0;
        text-align: right;
    }

    .ad-title-text {
        font-weight: 900;
        font-size: 1.25rem;
        margin: 0 0 4px 0;
        color: #ffffff;
        text-shadow: 0 2px 8px rgba(0, 0, 0, 0.6);
        line-height: 1.3;
    }

    @@media (min-width: 768px) {
        .ad-title-text {
            font-size: 1.4rem;
        }
    }

    .ad-desc-text {
        font-size: 0.85rem;
        color: rgba(255, 255, 255, 0.9);
        margin: 0;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-shadow: 0 1px 4px rgba(0, 0, 0, 0.6);
    }

    /* Action button "دور دلوقتي" */
    .ad-action-pill {
        flex-shrink: 0;
        background: #ffffff;
        color: #0f172a;
        font-weight: 800;
        font-size: 0.82rem;
        padding: 8px 20px;
        border-radius: 25px;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.3);
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.25s ease;
        white-space: nowrap;
    }

    .ad-slide-item:hover .ad-action-pill {
        transform: scale(1.04);
        box-shadow: 0 6px 18px rgba(255, 255, 255, 0.25);
    }

    /* Desktop Navigation Buttons */
    .ad-nav-btn {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: rgba(15, 23, 42, 0.6);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        z-index: 10;
        transition: all 0.25s ease;
        opacity: 0.85;
    }

    .ad-nav-btn:hover {
        background: rgba(15, 23, 42, 0.9);
        border-color: rgba(255, 255, 255, 0.5);
        transform: translateY(-50%) scale(1.1);
        opacity: 1;
    }

    .ad-prev-btn {
        right: 14px;
    }

    .ad-next-btn {
        left: 14px;
    }

    @@media (max-width: 767px) {
        .ad-nav-btn {
            display: none;
        }
    }

    /* Indicators underneath the cards: • • ▬ • • */
    .ads-indicators-bar {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        margin-top: 12px;
    }

    .indicator-pill {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: rgba(148, 163, 184, 0.35);
        cursor: pointer;
        transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .indicator-pill.active {
        width: 24px;
        height: 7px;
        border-radius: 4px;
        background: #22c55e;
        box-shadow: 0 0 10px rgba(34, 197, 94, 0.6);
    }

    .ads-skeleton {
        height: 215px;
        background: linear-gradient(90deg, #1e293b 25%, #334155 50%, #1e293b 75%);
        background-size: 200% 100%;
        animation: skeleton-loading 1.5s infinite;
    }

    @@keyframes skeleton-loading {
        0% { background-position: 200% 0; }
        100% { background-position: -200% 0; }
    }
</style>

@code {
    private List<EnhancedAdDto>? ads;
    private int currentIndex = 0;
    private System.Timers.Timer? timer;
    private double _touchStartX = 0;

    protected override void OnInitialized()
    {
        _ = LoadAdsAsync();
    }

    private async Task LoadAdsAsync()
    {
        try 
        {
            var apiAds = await Api.GetSliderAdsAsync();
            
            if (apiAds != null && apiAds.Any())
            {
                ads = apiAds;
                foreach (var ad in ads)
                {
                    _ = Api.TrackAdViewAsync(ad.Id);
                }
            }
            else
            {
                ads = GetCuratedFallbackAds();
            }

            if (ads != null && ads.Count > 1)
            {
                timer = new System.Timers.Timer(5000);
                timer.Elapsed += async (s, e) => 
                {
                    if (ads != null && ads.Count > 1)
                    {
                        currentIndex = (currentIndex + 1) % ads.Count;
                        await InvokeAsync(StateHasChanged);
                    }
                };
                timer.AutoReset = true;
                timer.Enabled = true;
            }
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading ads slider: {ex.Message}");
            ads = GetCuratedFallbackAds();
            await InvokeAsync(StateHasChanged);
        }
    }

    private void NextAd()
    {
        if (ads == null || ads.Count <= 1) return;
        currentIndex = (currentIndex + 1) % ads.Count;
        ResetTimer();
        StateHasChanged();
    }

    private void PrevAd()
    {
        if (ads == null || ads.Count <= 1) return;
        currentIndex = (currentIndex - 1 + ads.Count) % ads.Count;
        ResetTimer();
        StateHasChanged();
    }

    private void ScrollToIndex(int index)
    {
        currentIndex = index;
        ResetTimer();
        StateHasChanged();
    }

    private void ResetTimer()
    {
        timer?.Stop();
        timer?.Start();
    }

    private void HandleTouchStart(TouchEventArgs e)
    {
        if (e.Touches.Length > 0)
        {
            _touchStartX = e.Touches[0].ClientX;
        }
    }

    private void HandleTouchEnd(TouchEventArgs e)
    {
        if (e.ChangedTouches.Length > 0)
        {
            var delta = e.ChangedTouches[0].ClientX - _touchStartX;
            // In RTL: swipe left (delta < -45) moves to next, swipe right (delta > 45) moves to prev
            if (delta < -45)
            {
                NextAd();
            }
            else if (delta > 45)
            {
                PrevAd();
            }
        }
    }

    private List<EnhancedAdDto> GetCuratedFallbackAds()
    {
        return new List<EnhancedAdDto>
        {
            new EnhancedAdDto
            {
                Id = -1,
                Title = "بتدور على كهربائي؟",
                Description = "فنيين محترفين جاهزين للتدخل السريع بأعلى معايير الأمان",
                ImageUrl = "/images/ads/ad_electrician.jpg",
                TargetUrl = "/services?search=كهربائي"
            },
            new EnhancedAdDto
            {
                Id = -2,
                Title = "محتاج سباك شاطر؟",
                Description = "صيانة وتأسيس أدوات صحية بأعلى كفاءة وأسعار مناسبة",
                ImageUrl = "/images/ads/ad_plumber.jpg",
                TargetUrl = "/services?search=سباك"
            },
            new EnhancedAdDto
            {
                Id = -3,
                Title = "صيانة تكييفات فورية؟",
                Description = "فحص وتنظيف وشحن فريون بخصومات مميزة وجودة معتمدة",
                ImageUrl = "/images/categories/c_2_1.webp",
                TargetUrl = "/services?search=تكييف"
            },
            new EnhancedAdDto
            {
                Id = -4,
                Title = "نقل وتركيب عفش وأثاث؟",
                Description = "سيارات مجهزة وعمالة مدربة بأمان وسرعة فائقة",
                ImageUrl = "/images/categories/c_3_1.webp",
                TargetUrl = "/services?search=نقل"
            },
            new EnhancedAdDto
            {
                Id = -5,
                Title = "صيانة الأجهزة المنزلية؟",
                Description = "تصليح غسالات وثلاجات في نفس اليوم بضمان معتمد",
                ImageUrl = "/images/categories/c_4_1.webp",
                TargetUrl = "/services?search=صيانة"
            }
        };
    }

    private string ResolveAdImage(string? imgUrl)
    {
        if (string.IsNullOrEmpty(imgUrl)) return "/images/ads/ad_electrician.jpg";
        if (imgUrl.StartsWith("http://", StringComparison.OrdinalIgnoreCase) || 
            imgUrl.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            return imgUrl;
        }
        if (imgUrl.StartsWith("/"))
        {
            return imgUrl;
        }
        if (imgUrl.StartsWith("images/"))
        {
            return "/" + imgUrl;
        }
        return Api.GetAbsoluteUrl(ImagePathResolver.Ad(imgUrl));
    }

    private string GetAdTargetUrl(EnhancedAdDto ad)
    {
        if (ad.ServiceId.HasValue && ad.ServiceId.Value > 0)
        {
            return $"/service/{ad.ServiceId.Value}";
        }
        if (!string.IsNullOrWhiteSpace(ad.TargetUrl))
        {
            return ad.TargetUrl;
        }
        if (!string.IsNullOrWhiteSpace(ad.TargetCategories))
        {
            var firstCat = ad.TargetCategories.Split(',')[0].Trim();
            if (!string.IsNullOrEmpty(firstCat))
            {
                return $"/services?categoryId={firstCat}";
            }
        }
        return "/services";
    }

    private void OnAdClick(EnhancedAdDto ad)
    {
        if (ad.Id > 0)
        {
            _ = Api.TrackAdClickAsync(ad.Id);
        }

        var target = GetAdTargetUrl(ad);

        if (target.StartsWith("http://", StringComparison.OrdinalIgnoreCase) || 
            target.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            _ = JSRuntime.InvokeVoidAsync("open", target, "_blank");
        }
        else
        {
            Navigation.NavigateTo(target);
        }
    }

    public void Dispose()
    {
        timer?.Stop();
        timer?.Dispose();
    }
}
