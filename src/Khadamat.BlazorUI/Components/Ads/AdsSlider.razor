@using Khadamat.Application.DTOs
@using Khadamat.BlazorUI.Services
@using Khadamat.BlazorUI.Helpers
@inject ApiClient Api
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@implements IDisposable

<div class="ads-section-container mb-4">
    <!-- Header: "اقتراحات 🟢" -->
    <div class="d-flex align-items-center justify-content-between mb-2 px-1">
        <div class="d-flex align-items-center gap-2">
            <span class="live-dot-green"></span>
            <span class="fw-bold fs-6 text-white" style="letter-spacing: -0.2px;">اقتراحات</span>
        </div>
    </div>

    @if (ads == null)
    {
        <div class="skeleton ads-skeleton rounded-4"></div>
    }
    else
    {
        <!-- Horizontal Scrollable Track: Consecutive Cards Beside Each Other -->
        <div class="ads-track-container" id="adsTrackContainer">
            <div class="ads-track">
                @for (int i = 0; i < ads.Count; i++)
                {
                    var ad = ads[i];
                    var index = i;
                    var imageUrl = ResolveAdImage(ad.ImageUrl);

                    <div class="ad-card-item @(i == currentIndex ? "is-focused" : "")" 
                         @onclick="() => OnAdClick(ad)" 
                         title="@ad.Title">
                        
                        <!-- Background Image: Ambient Blur + 100% Contained Foreground Image (Zero Cropping) -->
                        @if (!string.IsNullOrEmpty(imageUrl))
                        {
                            <img src="@imageUrl" 
                                 alt="" 
                                 aria-hidden="true"
                                 class="ad-card-bg-blur" 
                                 onerror="this.src='/images/ads/ad_electrician.jpg';" />

                            <img src="@imageUrl" 
                                 alt="@ad.Title" 
                                 class="ad-card-bg-contain" 
                                 onerror="this.src='/images/ads/ad_electrician.jpg';" />
                        }
                        else
                        {
                            <div class="ad-card-gradient-bg"></div>
                        }

                        <!-- Dark Cinematic Vignette Overlay -->
                        <div class="ad-card-overlay"></div>

                        <!-- Top Floating Row: Badge "عرض" + Audio Action Circle -->
                        <div class="ad-card-top-row">
                            <span class="ad-offer-pill">عرض</span>
                            <button class="ad-audio-circle" type="button" @onclick:stopPropagation="true" title="صوت">
                                <i class="fa-solid fa-volume-high"></i>
                            </button>
                        </div>

                        <!-- Bottom Content: Title + Subtitle + Action Button "دور دلوقتي ←" -->
                        <div class="ad-card-bottom-row">
                            <div class="ad-text-box">
                                <h3 class="ad-title-text">@ad.Title</h3>
                                <p class="ad-desc-text">@(!string.IsNullOrEmpty(ad.Description) ? ad.Description : ad.TextContent)</p>
                            </div>
                            <div class="ad-action-pill">
                                <span>دور دلوقتي</span>
                                <i class="fa-solid fa-arrow-left"></i>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @if (ads.Count > 1)
        {
            <!-- Centered Indicators Below Cards: • • ▬ • • -->
            <div class="ads-indicators-bar">
                @for (int i = 0; i < ads.Count; i++)
                {
                    var index = i;
                    <span class="indicator-pill @(i == currentIndex ? "active" : "")" 
                          @onclick="() => ScrollToIndex(index)"></span>
                }
            </div>
        }
    }
</div>

<style>
    .ads-section-container {
        position: relative;
        width: 100%;
        margin-bottom: 24px;
    }

    .live-dot-green {
        display: inline-block;
        width: 10px;
        height: 10px;
        background: #22c55e;
        border-radius: 50%;
        box-shadow: 0 0 10px rgba(34, 197, 94, 0.7);
        animation: pulse-live 2s infinite;
    }

    @@keyframes pulse-live {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.6; transform: scale(1.2); }
    }

    /* Horizontal scroll track: Consecutive cards sitting beside each other */
    .ads-track-container {
        width: 100%;
        overflow-x: auto;
        overflow-y: hidden;
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
        -ms-overflow-style: none;
        padding: 4px 0 6px 0;
    }

    .ads-track-container::-webkit-scrollbar {
        display: none;
    }

    .ads-track {
        display: flex;
        gap: 14px;
        width: max-content;
        padding: 0 2px;
    }

    /* Card Item: takes ~86% width on mobile so the adjacent card peeks in! */
    .ad-card-item {
        flex: 0 0 86vw;
        max-width: 440px;
        height: 205px;
        border-radius: 26px;
        position: relative;
        overflow: hidden;
        scroll-snap-align: center;
        scroll-snap-stop: always;
        cursor: pointer;
        background: #0f172a;
        box-shadow: 0 10px 28px rgba(0, 0, 0, 0.4);
        transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 16px 20px;
        color: #ffffff;
        user-select: none;
    }

    @@media (min-width: 768px) {
        .ad-card-item {
            flex: 0 0 420px;
            height: 220px;
        }
    }

    .ad-card-item:hover {
        transform: translateY(-2px);
    }

    /* Ambient blurred layer: smoothly fills the card corners and background */
    .ad-card-bg-blur {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: blur(24px) brightness(0.6);
        transform: scale(1.15);
        z-index: 0;
        pointer-events: none;
    }

    /* Foreground image: 100% CONTAINED - zero cropping or missing parts */
    .ad-card-bg-contain {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: contain;
        object-position: center;
        z-index: 1;
        pointer-events: none;
        transition: transform 0.4s ease;
    }

    .ad-card-item:hover .ad-card-bg-contain {
        transform: scale(1.02);
    }

    .ad-card-gradient-bg {
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, #134e4a 0%, #064e3b 50%, #0f172a 100%);
        z-index: 0;
    }

    .ad-card-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, rgba(15, 23, 42, 0.35) 0%, rgba(15, 23, 42, 0.1) 35%, rgba(15, 23, 42, 0.75) 70%, rgba(15, 23, 42, 0.95) 100%);
        z-index: 2;
        pointer-events: none;
    }

    /* Top Row: Offer pill + Audio button */
    .ad-card-top-row {
        position: relative;
        z-index: 3;
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
    }

    .ad-offer-pill {
        background: rgba(255, 255, 255, 0.18);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.25);
        border-radius: 20px;
        padding: 4px 14px;
        font-size: 0.78rem;
        font-weight: 800;
        color: #ffffff;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
    }

    .ad-audio-circle {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.18);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.25);
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.85rem;
        cursor: pointer;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
        transition: transform 0.2s ease, background 0.2s ease;
    }

    .ad-audio-circle:hover {
        background: rgba(255, 255, 255, 0.3);
        transform: scale(1.08);
    }

    /* Bottom Row: Text on Right, Button on Left */
    .ad-card-bottom-row {
        position: relative;
        z-index: 3;
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 12px;
        width: 100%;
    }

    .ad-text-box {
        flex: 1;
        min-width: 0;
        text-align: right;
    }

    .ad-title-text {
        font-weight: 900;
        font-size: 1.22rem;
        margin: 0 0 4px 0;
        color: #ffffff;
        text-shadow: 0 2px 8px rgba(0, 0, 0, 0.6);
        line-height: 1.3;
    }

    .ad-desc-text {
        font-size: 0.82rem;
        color: rgba(255, 255, 255, 0.88);
        margin: 0;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-shadow: 0 1px 4px rgba(0, 0, 0, 0.6);
    }

    /* Action button "دور دلوقتي" */
    .ad-action-pill {
        flex-shrink: 0;
        background: #ffffff;
        color: #0f172a;
        font-weight: 800;
        font-size: 0.8rem;
        padding: 7px 18px;
        border-radius: 25px;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.3);
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.25s ease;
        white-space: nowrap;
    }

    .ad-card-item:hover .ad-action-pill {
        transform: scale(1.04);
        box-shadow: 0 6px 18px rgba(255, 255, 255, 0.2);
    }

    /* Indicators underneath the cards: • • ▬ • • */
    .ads-indicators-bar {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        margin-top: 12px;
    }

    .indicator-pill {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: rgba(148, 163, 184, 0.35);
        cursor: pointer;
        transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .indicator-pill.active {
        width: 24px;
        height: 7px;
        border-radius: 4px;
        background: #22c55e;
        box-shadow: 0 0 10px rgba(34, 197, 94, 0.6);
    }

    .ads-skeleton {
        height: 205px;
        background: linear-gradient(90deg, #1e293b 25%, #334155 50%, #1e293b 75%);
        background-size: 200% 100%;
        animation: skeleton-loading 1.5s infinite;
    }

    @@keyframes skeleton-loading {
        0% { background-position: 200% 0; }
        100% { background-position: -200% 0; }
    }
</style>

@code {
    private List<EnhancedAdDto>? ads;
    private int currentIndex = 0;
    private System.Timers.Timer? timer;

    protected override void OnInitialized()
    {
        _ = LoadAdsAsync();
    }

    private async Task LoadAdsAsync()
    {
        try 
        {
            var apiAds = await Api.GetSliderAdsAsync();
            
            if (apiAds != null && apiAds.Any())
            {
                ads = apiAds;
                foreach (var ad in ads)
                {
                    _ = Api.TrackAdViewAsync(ad.Id);
                }
            }
            else
            {
                // Fallback curated suggestions matching the exact design and categories
                ads = GetCuratedFallbackAds();
            }

            if (ads != null && ads.Count > 1)
            {
                timer = new System.Timers.Timer(5000);
                timer.Elapsed += async (s, e) => 
                {
                    if (ads != null && ads.Count > 1)
                    {
                        currentIndex = (currentIndex + 1) % ads.Count;
                        await InvokeAsync(async () => 
                        {
                            StateHasChanged();
                            try 
                            {
                                await JSRuntime.InvokeVoidAsync("scrollAdsSlider", currentIndex);
                            }
                            catch { }
                        });
                    }
                };
                timer.AutoReset = true;
                timer.Enabled = true;
            }
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading ads slider: {ex.Message}");
            ads = GetCuratedFallbackAds();
            await InvokeAsync(StateHasChanged);
        }
    }

    private List<EnhancedAdDto> GetCuratedFallbackAds()
    {
        return new List<EnhancedAdDto>
        {
            new EnhancedAdDto
            {
                Id = -1,
                Title = "بتدور على كهربائي؟",
                Description = "فنيين محترفين جاهزين للتدخل السريع",
                ImageUrl = "/images/ads/ad_electrician.jpg",
                TargetUrl = "/services?search=كهربائي"
            },
            new EnhancedAdDto
            {
                Id = -2,
                Title = "محتاج سباك شاطر؟",
                Description = "صيانة وتأسيس أدوات صحية بأعلى كفاءة",
                ImageUrl = "/images/ads/ad_plumber.jpg",
                TargetUrl = "/services?search=سباك"
            },
            new EnhancedAdDto
            {
                Id = -3,
                Title = "صيانة تكييفات فورية؟",
                Description = "فحص وتنظيف وشحن فريون بخصومات مميزة",
                ImageUrl = "/images/categories/c_2_1.webp",
                TargetUrl = "/services?search=تكييف"
            },
            new EnhancedAdDto
            {
                Id = -4,
                Title = "نقل وتركيب عفش وأثاث؟",
                Description = "سيارات مجهزة وعمالة مدربة بأمان وسرعة",
                ImageUrl = "/images/categories/c_3_1.webp",
                TargetUrl = "/services?search=نقل"
            },
            new EnhancedAdDto
            {
                Id = -5,
                Title = "صيانة الأجهزة المنزلية؟",
                Description = "تصليح غسالات وثلاجات في نفس اليوم بضمان",
                ImageUrl = "/images/categories/c_4_1.webp",
                TargetUrl = "/services?search=صيانة"
            }
        };
    }

    private string ResolveAdImage(string? imgUrl)
    {
        if (string.IsNullOrEmpty(imgUrl)) return "/images/ads/ad_electrician.jpg";
        if (imgUrl.StartsWith("http://", StringComparison.OrdinalIgnoreCase) || 
            imgUrl.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            return imgUrl;
        }
        if (imgUrl.StartsWith("/"))
        {
            return imgUrl;
        }
        if (imgUrl.StartsWith("images/"))
        {
            return "/" + imgUrl;
        }
        return Api.GetAbsoluteUrl(ImagePathResolver.Ad(imgUrl));
    }

    private string GetAdTargetUrl(EnhancedAdDto ad)
    {
        if (ad.ServiceId.HasValue && ad.ServiceId.Value > 0)
        {
            return $"/service/{ad.ServiceId.Value}";
        }
        if (!string.IsNullOrWhiteSpace(ad.TargetUrl))
        {
            return ad.TargetUrl;
        }
        if (!string.IsNullOrWhiteSpace(ad.TargetCategories))
        {
            var firstCat = ad.TargetCategories.Split(',')[0].Trim();
            if (!string.IsNullOrEmpty(firstCat))
            {
                return $"/services?categoryId={firstCat}";
            }
        }
        return "/services";
    }

    private async Task ScrollToIndex(int index)
    {
        currentIndex = index;
        try 
        {
            await JSRuntime.InvokeVoidAsync("scrollAdsSlider", index);
        }
        catch { }
        
        timer?.Stop();
        timer?.Start();
    }

    private void OnAdClick(EnhancedAdDto ad)
    {
        if (ad.Id > 0)
        {
            _ = Api.TrackAdClickAsync(ad.Id);
        }

        var target = GetAdTargetUrl(ad);

        if (target.StartsWith("http://", StringComparison.OrdinalIgnoreCase) || 
            target.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            _ = JSRuntime.InvokeVoidAsync("open", target, "_blank");
        }
        else
        {
            Navigation.NavigateTo(target);
        }
    }

    public void Dispose()
    {
        timer?.Stop();
        timer?.Dispose();
    }
}
