@inject NavigationManager Navigation

<div class="stats-widget p-3 rounded-4 border shadow-sm h-100 bg-white d-flex flex-column justify-content-center @(HasLink ? "stats-widget-clickable" : "")"
     @onclick="HandleClick">
    <div class="d-flex align-items-center mb-2">
        <div class="stats-icon bg-@(Color) bg-opacity-10 text-@(Color) rounded-3 me-2">
            <i class="@Icon"></i>
        </div>
        <span class="text-muted small fw-bold">@Label</span>
    </div>
    <div class="fw-bold fs-4">@Value</div>
    @if (HasLink)
    {
        <div class="x-small text-muted mt-1 opacity-75">
            <i class="fa-solid fa-arrow-left me-1" style="font-size:10px;"></i>انقر للتفاصيل
        </div>
    }
</div>

<style>
    .stats-icon {
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
    }

    .stats-widget-clickable {
        cursor: pointer;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .stats-widget-clickable:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(0,0,0,0.1) !important;
    }

    @@media (max-width: 767px) {
        .stats-widget { padding: 0.65rem !important; }
        .stats-icon { width: 28px; height: 28px; font-size: 0.85rem; }
        .text-muted.small { font-size: 0.65rem !important; }
        .fs-4 { font-size: 1.1rem !important; }
    }
</style>

@code {
    [Parameter] public string Icon { get; set; } = "fa-solid fa-chart-line";
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Value { get; set; } = "0";
    [Parameter] public string Color { get; set; } = "primary";
    [Parameter] public string? Href { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }

    private bool HasLink => !string.IsNullOrEmpty(Href) || OnClick.HasDelegate;

    private async Task HandleClick()
    {
        if (!string.IsNullOrEmpty(Href))
            Navigation.NavigateTo(Href);
        else if (OnClick.HasDelegate)
            await OnClick.InvokeAsync();
    }
}
