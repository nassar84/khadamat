@using Khadamat.BlazorUI.Services
@inject ApiClient Api
<div class="service-card animate-up" @onclick="HandleClick">
    <div class="p-3" style="position: relative; z-index: 1;">
        <div class="d-flex gap-3">
            <div class="service-img rounded-4 bg-light overflow-hidden" style="width: 90px; height: 90px; flex-shrink: 0;">
                <img src="@Api.GetAbsoluteUrl(Khadamat.BlazorUI.Helpers.DefaultImages.GetServiceImage(Service.Images?.FirstOrDefault(), Service.SubCategoryName, Service.CategoryName, Service.MainCategoryName, Service.SubCategoryImageUrl, Service.CategoryImageUrl, Service.MainCategoryImageUrl))" 
                     onerror="@Khadamat.BlazorUI.Helpers.DefaultImages.GetServiceImageOnError(Service.SubCategoryName, Service.CategoryName, Service.MainCategoryName, Service.SubCategoryImageUrl, Service.CategoryImageUrl, Service.MainCategoryImageUrl, Api.BaseUrl)"
                     class="w-100 h-100 object-fit-cover" alt="@Service.Title" />
            </div>
            <div class="flex-grow-1 overflow-hidden">
                <div class="d-flex justify-content-between align-items-start mb-1">
                    <h6 class="fw-bold mb-0 text-truncate" style="font-size: 1rem;">@Service.Title</h6>
                    @if (IsFavorite)
                    {
                        <i class="fa-solid fa-heart text-danger ms-2" @onclick:stopPropagation="true"></i>
                    }
                    else
                    {
                        <i class="fa-regular fa-heart text-muted ms-2" @onclick:stopPropagation="true"></i>
                    }
                </div>
                <p class="text-muted small mb-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.4;">@Service.Description</p>
                
                <div class="d-flex justify-content-end align-items-center mt-2">
                    <div class="bg-warning bg-opacity-10 text-warning rounded-pill px-2 py-1 small fw-bold">
                        <i class="fa-solid fa-star me-1 small"></i> @Service.Rating.ToString("F1")
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public ServiceDto Service { get; set; } = new();
    [Parameter] public EventCallback<ServiceDto> OnClick { get; set; }

    private bool IsFavorite => Service.IsFavorite;

    private async Task HandleClick()
    {
        if (OnClick.HasDelegate)
        {
            await OnClick.InvokeAsync(Service);
        }
    }
}

