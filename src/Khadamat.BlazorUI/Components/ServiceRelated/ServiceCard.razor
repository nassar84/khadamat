@using Khadamat.BlazorUI.Services
@using Khadamat.BlazorUI.State
@inject ApiClient Api
@inject AppState State
@inject NavigationManager Navigation
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider

<div class="service-card animate-up card-variant-@(Service.Id % 6)" @onclick="HandleClick" style="overflow: visible;">
    <div class="card-accent-bar"></div>
    <div class="p-3" style="position: relative; z-index: 1;">
        <div class="d-flex gap-3">
            <div class="service-img rounded-4 bg-light overflow-hidden position-relative" style="width: 90px; height: 90px; flex-shrink: 0;">
                <img src="@Api.GetAbsoluteUrl(Khadamat.BlazorUI.Helpers.DefaultImages.GetServiceImage(Service.Images?.FirstOrDefault(), Service.SubCategoryName, Service.CategoryName, Service.MainCategoryName, Service.SubCategoryImageUrl, Service.CategoryImageUrl, Service.MainCategoryImageUrl))" 
                     onerror="this.onerror=null;this.src='/images/services/default_service.png';"
                     class="w-100 h-100 object-fit-contain p-1" alt="@Service.Title" />
            </div>
            <div class="flex-grow-1 overflow-hidden">
                <div class="d-flex justify-content-between align-items-start mb-1">
                    <h6 class="fw-bold mb-0 text-truncate" style="font-size: 1rem;">@Service.Title</h6>
                    <button type="button" class="btn p-0 border-0 bg-transparent ms-2 favorite-toggle-btn shadow-none" 
                            title="@(IsFavorite ? "إزالة من المفضلة" : "إضافة إلى المفضلة")"
                            @onclick="ToggleFavorite" 
                            @onclick:stopPropagation="true">
                        <i class="@(IsFavorite ? "fa-solid fa-heart text-danger animate-pop" : "fa-regular fa-heart text-muted") fs-5"></i>
                    </button>
                </div>
                <p class="text-muted small mb-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.4;">@Service.Description</p>
                
                <div class="d-flex justify-content-between align-items-center mt-2">
                    <div class="d-flex align-items-center gap-1 text-muted x-small">
                        <i class="fa-solid fa-heart text-danger opacity-75"></i>
                        <span class="fw-bold">@Service.LikesCount</span>
                        <span class="text-muted" style="font-size:0.75rem;">تفضيل</span>
                    </div>
                    <div class="bg-warning bg-opacity-10 text-warning rounded-pill px-2 py-1 small fw-bold">
                        <i class="fa-solid fa-star me-1 small"></i> @Service.Rating.ToString("F1")
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public ServiceDto Service { get; set; } = new();
    [Parameter] public EventCallback<ServiceDto> OnClick { get; set; }
    [Parameter] public EventCallback<ServiceDto> OnFavoriteToggled { get; set; }

    private bool IsFavorite => Service.IsFavorite || State.IsServiceFavorite(Service.Id);
    private bool isToggling = false;

    private async Task ToggleFavorite()
    {
        if (isToggling) return;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated != true)
        {
            Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(Navigation.Uri)}");
            return;
        }

        isToggling = true;
        bool wasFav = IsFavorite;
        
        // Optimistic UI update
        Service.IsFavorite = !wasFav;
        if (wasFav && Service.LikesCount > 0) Service.LikesCount--;
        else if (!wasFav) Service.LikesCount++;
        State.SetServiceFavorite(Service.Id, Service.IsFavorite);
        StateHasChanged();

        try
        {
            var res = await Api.ToggleFavoriteAsync(Service.Id);
            if (res.Success && res.Data != null)
            {
                Service.IsFavorite = res.Data.IsFavorite;
                Service.LikesCount = res.Data.FavoritesCount;
                State.SetServiceFavorite(Service.Id, res.Data.IsFavorite);
                if (OnFavoriteToggled.HasDelegate)
                {
                    await OnFavoriteToggled.InvokeAsync(Service);
                }
            }
            else
            {
                // Revert
                Service.IsFavorite = wasFav;
                Service.LikesCount = wasFav ? Service.LikesCount + 1 : Math.Max(0, Service.LikesCount - 1);
                State.SetServiceFavorite(Service.Id, wasFav);
            }
        }
        catch
        {
            Service.IsFavorite = wasFav;
            State.SetServiceFavorite(Service.Id, wasFav);
        }
        finally
        {
            isToggling = false;
            StateHasChanged();
        }
    }

    private async Task HandleClick()
    {
        if (OnClick.HasDelegate)
        {
            await OnClick.InvokeAsync(Service);
        }
    }
}

