@using Khadamat.BlazorUI.Components.Common

<div class="service-card animate-up skeleton-card">
    <div class="p-3" style="position: relative; z-index: 1;">
        <div class="d-flex gap-3">
            <div class="service-img rounded-4 overflow-hidden" style="width: 90px; height: 90px; flex-shrink: 0;">
                <Skeleton Style="width: 100%; height: 100%;" />
            </div>
            <div class="flex-grow-1 overflow-hidden">
                <div class="d-flex justify-content-between align-items-start mb-1">
                    <Skeleton Class="mb-2" Style="width: 70%; height: 1.2rem;" />
                    <Skeleton Style="width: 20px; height: 20px; border-radius: 50%;" />
                </div>
                <Skeleton Class="mb-3" Style="width: 40%; height: 0.8rem;" />
                
                <div class="d-flex justify-content-between align-items-center mt-3">
                    <Skeleton Style="width: 50px; height: 1.2rem;" />
                    <Skeleton Style="width: 40px; height: 1.2rem; border-radius: 50px;" />
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .skeleton-card {
        pointer-events: none;
        box-shadow: none !important;
        border-color: rgba(0,0,0,0.05) !important;
    }
</style>
