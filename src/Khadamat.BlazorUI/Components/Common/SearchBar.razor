<div class="search-container-modern animate-up">
    <div class="search-input-group glass-morphism">
        <div class="search-icon-wrapper" @onclick="Search" title="بحث" style="cursor: pointer;">
            <i class="fa-solid fa-magnifying-glass"></i>
        </div>
        <input type="text" class="modern-search-input" 
               placeholder="ابحث عن سباك، نجار، أو مبرمج..." 
               @bind="SearchTerm" 
               @bind:event="oninput" 
               @onkeyup="HandleKeyUp" />
        
        <button class="modern-search-btn" @onclick="Search" title="بحث">
            <span>بحث</span>
        </button>
    </div>
    
    <div class="trending-tags mt-3 d-none d-md-flex align-items-center gap-2">
        <span class="small text-muted fw-bold">الأكثر بحثاً:</span>
        <span class="trending-tag" @onclick='() => SetAndSearch("سباكة")'>سباكة</span>
        <span class="trending-tag" @onclick='() => SetAndSearch("كهرباء")'>كهرباء</span>
        <span class="trending-tag" @onclick='() => SetAndSearch("تنظيف")'>تنظيف</span>
    </div>
</div>

<style>
    .search-container-modern {
        width: 100%;
        max-width: 800px;
        margin: 0 auto;
    }

    .search-input-group {
        display: flex;
        align-items: center;
        background: rgba(255, 255, 255, 0.85);
        border-radius: 20px;
        padding: 5px 8px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.5);
        backdrop-filter: blur(10px);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        width: 100%;
        box-sizing: border-box;
    }

    .search-input-group:focus-within {
        transform: translateY(-2px);
        box-shadow: 0 15px 40px rgba(37, 99, 235, 0.15);
        border-color: var(--theme-primary, #2563eb);
    }

    .search-icon-wrapper {
        padding: 0 10px;
        color: #94a3b8;
        font-size: 1.1rem;
        flex-shrink: 0;
    }

    .modern-search-input {
        border: none;
        background: transparent;
        flex: 1 1 0%;
        min-width: 0;
        padding: 8px 6px;
        font-size: 0.95rem;
        outline: none;
        color: var(--text-body);
        direction: rtl;
        text-align: right;
    }

    .modern-search-input::placeholder {
        color: var(--text-placeholder);
    }

    .modern-search-btn {
        background: linear-gradient(135deg, var(--theme-primary, #2563eb), var(--theme-secondary, #0ea5e9));
        color: white;
        border: none;
        border-radius: 14px;
        padding: 8px 16px;
        font-weight: 700;
        font-size: 0.85rem;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        gap: 6px;
        white-space: nowrap;
        flex-shrink: 0;
        box-shadow: 0 3px 10px var(--theme-glow, rgba(37, 99, 235, 0.25));
    }

    .modern-search-btn:hover {
        background: var(--theme-primary-hover, #1d4ed8);
        transform: scale(1.02);
    }

    .modern-search-btn:active {
        transform: scale(0.98);
    }

    .trending-tag {
        font-size: 0.8rem;
        background: rgba(255, 255, 255, 0.5);
        padding: 4px 12px;
        border-radius: 8px;
        color: var(--text-muted);
        cursor: pointer;
        border: 1px solid rgba(0, 0, 0, 0.05);
        transition: all 0.2s;
    }

    .trending-tag:hover {
        background: var(--primary);
        color: white;
        border-color: var(--primary);
    }

    [data-theme='ocean'] .search-input-group { background: rgba(240, 249, 255, 0.9); }
    [data-theme='forest'] .search-input-group { background: rgba(240, 253, 244, 0.9); }
</style>

@code {
    [Parameter] public EventCallback<string> OnSearch { get; set; }
    private string SearchTerm { get; set; } = "";

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await Search();
        }
    }

    private async Task SetAndSearch(string term)
    {
        SearchTerm = term;
        await Search();
    }

    private async Task Search()
    {
        if (OnSearch.HasDelegate)
        {
            await OnSearch.InvokeAsync(SearchTerm);
        }
    }
}
