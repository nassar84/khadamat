@using Khadamat.Application.DTOs
@using Khadamat.BlazorUI.Services
@inject ApiClient Api
@inject NavigationManager Navigation
@inject Khadamat.Application.Interfaces.IOfflineDataService OfflineData
@implements IDisposable

@if (DisplayCategories == null)
{
    <div class="marquee-outer">
        <div class="marquee-track" style="animation:none;">
            <div class="marquee-copy">
                @for (int i = 0; i < 8; i++)
                {
                    <div class="category-item">
                        <div class="category-shape-wrapper skeleton-glow"></div>
                        <div class="skeleton-glow rounded-pill mt-2" style="width:40px;height:10px;"></div>
                    </div>
                }
            </div>
        </div>
    </div>
}
else
{
    <div class="marquee-outer">
        <div class="marquee-track">
            @* Copy 1 *@
            <div class="marquee-copy">
                @foreach (var cat in DisplayCategories)
                {
                    var c = cat;
                    <div class="category-item" @onclick="() => OnCategorySelected(c)">
                        <div class="category-shape-wrapper">
                            @if (!string.IsNullOrEmpty(c.ImageUrl))
                            {
                                <img src="@Api.GetAbsoluteUrl(c.ImageUrl ?? "images/maincategories/default.jpg")"
                                     class="cat-img" alt="@c.Name"
                                     onerror="this.onerror=null;this.src='/images/maincategories/default.jpg';" loading="lazy" />
                            }
                            else if (!string.IsNullOrEmpty(c.Icon))
                            {
                                <span class="cat-icon">@c.Icon</span>
                            }
                            else
                            {
                                <span class="cat-icon">📁</span>
                            }
                        </div>
                        <span class="category-name-small">@c.Name</span>
                    </div>
                }
            </div>
            @* Copy 2 — visual duplicate for seamless loop *@
            <div class="marquee-copy" aria-hidden="true">
                @foreach (var cat in DisplayCategories)
                {
                    var c = cat;
                    <div class="category-item" @onclick="() => OnCategorySelected(c)">
                        <div class="category-shape-wrapper">
                            @if (!string.IsNullOrEmpty(c.ImageUrl))
                            {
                                <img src="@Api.GetAbsoluteUrl(c.ImageUrl ?? "images/maincategories/default.jpg")"
                                     class="cat-img" alt="@c.Name"
                                     onerror="this.onerror=null;this.src='/images/maincategories/default.jpg';" loading="lazy" />
                            }
                            else if (!string.IsNullOrEmpty(c.Icon))
                            {
                                <span class="cat-icon">@c.Icon</span>
                            }
                            else
                            {
                                <span class="cat-icon">📁</span>
                            }
                        </div>
                        <span class="category-name-small">@c.Name</span>
                    </div>
                }
            </div>
        </div>
    </div>
}

<style>
    /* ── Outer container: clips overflow ── */
    .marquee-outer {
        width: 100%;
        overflow: hidden;
        min-height: 110px;
        display: flex;
        align-items: center;
        padding: 8px 0;
        /* disable RTL reversal for the marquee */
        direction: ltr;
    }

    /* ── Track: two copies side by side, grows to content width ── */
    .marquee-track {
        display: flex;
        width: max-content;          /* critical: track IS its content width */
        flex-shrink: 0;
        animation: marquee-rtl 28s linear infinite;
        will-change: transform;
    }

    /* Pause on hover so users can click */
    .marquee-outer:hover .marquee-track {
        animation-play-state: paused;
    }

    /* ── Each copy: a horizontal row of items ── */
    .marquee-copy {
        display: flex;
        flex-direction: row;
        align-items: center;
        flex-shrink: 0;
        gap: 16px;
        /* trailing padding equals gap → seam between copies = gap between items */
        padding-right: 16px;
    }

    /*
      Animation: move left by exactly the width of one .marquee-copy
      = 50% of the .marquee-track  (because track = 2 * copy + no extra)
      Wait: track width = copy1 + copy2, each copy has trailing padding-right:16px
      So track = 2 * copy_computed_width
      → translateX(-50%) = -copy_computed_width → seamless jump ✅
    */
    @@keyframes marquee-rtl {
        0%   { transform: translateX(0); }
        100% { transform: translateX(-50%); }
    }

    /* ── Category item ── */
    .category-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        flex-shrink: 0;
        min-width: 72px;
        cursor: pointer;
        user-select: none;
        transition: transform 0.25s ease;
    }

    .category-item:hover {
        transform: translateY(-5px) scale(1.05);
    }

    /* ── Circle ── */
    .category-shape-wrapper {
        width: 62px;
        height: 62px;
        border-radius: 50%;
        background: #fff;
        box-shadow: 0 4px 14px rgba(0,0,0,0.09);
        border: 1px solid rgba(0,0,0,0.04);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        position: relative;
        transition: box-shadow 0.3s ease, transform 0.3s ease;
    }

    .category-shape-wrapper::before {
        content: '';
        position: absolute;
        top: -50%; left: -50%;
        width: 200%; height: 200%;
        background: linear-gradient(135deg,
            rgba(255,255,255,0.55) 0%,
            transparent 50%,
            rgba(255,255,255,0.25) 100%);
        transform: rotate(30deg);
        pointer-events: none;
    }

    .category-item:hover .category-shape-wrapper {
        box-shadow:
            0 10px 28px rgba(0,0,0,0.14),
            0 0 0 2px var(--theme-primary, #6366f1);
    }

    .cat-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 50%;
        opacity: 0.92;
        transition: transform 0.35s ease;
    }

    .category-item:hover .cat-img {
        transform: scale(1.1);
    }

    .cat-icon {
        font-size: 1.8rem;
        color: var(--theme-primary, #6366f1);
        position: relative;
        z-index: 1;
        transition: transform 0.3s ease;
    }

    .category-item:hover .cat-icon {
        transform: scale(1.15) rotate(-5deg);
    }

    /* ── Label ── */
    .category-name-small {
        font-size: 0.78rem;
        font-weight: 700;
        color: #334155;
        margin-top: 6px;
        text-align: center;
        max-width: 80px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        direction: rtl; /* restore RTL for Arabic text */
    }

    /* ── Skeleton ── */
    .skeleton-glow {
        background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
        background-size: 200% 100%;
        animation: skel 1.5s infinite;
    }

    @@keyframes skel {
        0%   { background-position: 200% 0; }
        100% { background-position: -200% 0; }
    }

    @@media (max-width: 991px) {
        .category-shape-wrapper { width: 52px !important; height: 52px !important; }
        .category-item { min-width: 60px; }
        .category-name-small { font-size: 0.72rem !important; }
    }
</style>

@code {
    [Parameter] public List<MainCategoryDto>? Categories { get; set; }

    private List<MainCategoryDto>? internalCategories;
    private bool _disposed = false;

    private List<MainCategoryDto>? DisplayCategories
    {
        get
        {
            if (Categories != null && Categories.Any()) return Categories;
            if (internalCategories != null && internalCategories.Any()) return internalCategories;
            return null;
        }
    }

    protected override void OnInitialized()
    {
        if (Categories == null)
            _ = LoadCategoriesAsync();
    }

    private async Task LoadCategoriesAsync()
    {
        try
        {
            var results = await Api.GetMainCategoriesAsync();
            if (results != null && results.Any())
                internalCategories = results;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"CategoryMarquee: error loading - {ex.Message}");
        }
        finally
        {
            if (!_disposed)
            {
                try { await InvokeAsync(StateHasChanged); } catch { }
            }
        }
    }

    private void OnCategorySelected(MainCategoryDto category)
        => Navigation.NavigateTo($"/explore/main/{category.Id}/{Uri.EscapeDataString(category.Name)}");

    public void Dispose() => _disposed = true;
}
