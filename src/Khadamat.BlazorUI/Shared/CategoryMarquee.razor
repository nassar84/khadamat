@using Khadamat.Application.DTOs
@using Khadamat.BlazorUI.Services
@inject ApiClient Api
@inject NavigationManager Navigation
@inject Khadamat.Application.Interfaces.IOfflineDataService OfflineData
@inject IJSRuntime JS
@implements IDisposable

@if (DisplayCategories == null)
{
    <div class="drag-scroll-outer">
        <div class="drag-scroll-track">
            <div class="marquee-copy">
                @for (int i = 0; i < 8; i++)
                {
                    <div class="category-item border-0">
                        <div class="category-shape-wrapper skeleton-glow"></div>
                        <div class="skeleton-glow rounded-pill mt-2" style="width:40px;height:10px;"></div>
                    </div>
                }
            </div>
        </div>
    </div>
}
else
{
    <div class="drag-scroll-outer" id="@containerId">
        <div class="drag-scroll-track">
            @* Copy 1 *@
            <div class="marquee-copy">
                @foreach (var cat in DisplayCategories)
                {
                    var c = cat;
                    <div class="category-item border-0" @onclick="() => OnCategorySelected(c)">
                        <div class="category-shape-wrapper">
                            @if (!string.IsNullOrEmpty(c.ImageUrl))
                            {
                                <img src="@Api.GetAbsoluteUrl(c.ImageUrl ?? "images/maincategories/default.jpg")"
                                     class="cat-img draggable-img" alt="@c.Name"
                                     onerror="this.onerror=null;this.src='/images/maincategories/default.jpg';" loading="lazy" />
                            }
                            else if (!string.IsNullOrEmpty(c.Icon))
                            {
                                <span class="cat-icon">@c.Icon</span>
                            }
                            else
                            {
                                <span class="cat-icon">📁</span>
                            }
                        </div>
                        <span class="category-name-smalltext px-1">@c.Name</span>
                    </div>
                }
            </div>
            @* Copy 2 for seamless infinite scroll *@
            <div class="marquee-copy" aria-hidden="true">
                @foreach (var cat in DisplayCategories)
                {
                    var c = cat;
                    <div class="category-item border-0" @onclick="() => OnCategorySelected(c)">
                        <div class="category-shape-wrapper">
                            @if (!string.IsNullOrEmpty(c.ImageUrl))
                            {
                                <img src="@Api.GetAbsoluteUrl(c.ImageUrl ?? "images/maincategories/default.jpg")"
                                     class="cat-img draggable-img" alt="@c.Name"
                                     onerror="this.onerror=null;this.src='/images/maincategories/default.jpg';" loading="lazy" />
                            }
                            else if (!string.IsNullOrEmpty(c.Icon))
                            {
                                <span class="cat-icon">@c.Icon</span>
                            }
                            else
                            {
                                <span class="cat-icon">📁</span>
                            }
                        </div>
                        <span class="category-name-smalltext px-1">@c.Name</span>
                    </div>
                }
            </div>
        </div>
    </div>
}

<style>
    .drag-scroll-outer {
        width: 100%;
        overflow-x: auto;
        overflow-y: hidden;
        min-height: 95px;
        display: flex;
        align-items: center;
        /* Disable RTL here to ensure cross-browser scrollLeft math works correctly */
        direction: ltr; 
        cursor: grab;
        scrollbar-width: none; /* Firefox */
        -ms-overflow-style: none; /* IE and Edge */
        scroll-behavior: auto; /* Required for JS continuous scroll */
    }
    .drag-scroll-outer::-webkit-scrollbar {
        display: none;
    }
    .drag-scroll-outer.active {
        cursor: grabbing;
    }

    .drag-scroll-track {
        display: flex;
        flex-direction: row;
        align-items: center;
        width: max-content;
        padding: 8px 16px;
    }

    .marquee-copy {
        display: flex;
        flex-direction: row;
        align-items: center;
        flex-shrink: 0;
        gap: 16px;
        padding-right: 16px; /* Must equal gap size for seamless looping */
    }

    /* Prevent images from being dragged using default browser behavior */
    .draggable-img {
        pointer-events: none;
        user-select: none;
        -webkit-user-drag: none;
    }

    /* Category Item Styles */
    .category-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        flex-shrink: 0;
        min-width: 72px;
        cursor: pointer;
        user-select: none;
        transition: transform 0.25s ease;
    }

    .category-item:hover {
        transform: translateY(-5px) scale(1.05);
    }
    
    .category-item:active {
        transform: scale(0.95);
    }

    .category-shape-wrapper {
        width: 62px;
        height: 62px;
        border-radius: 50%;
        background: #fff;
        box-shadow: 0 4px 14px rgba(0,0,0,0.09);
        border: 1px solid rgba(0,0,0,0.04);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        position: relative;
        transition: box-shadow 0.3s ease, transform 0.3s ease;
    }

    .category-shape-wrapper::before {
        content: '';
        position: absolute;
        top: -50%; left: -50%;
        width: 200%; height: 200%;
        background: linear-gradient(135deg,
            rgba(255,255,255,0.55) 0%,
            transparent 50%,
            rgba(255,255,255,0.25) 100%);
        transform: rotate(30deg);
        pointer-events: none;
    }

    .category-item:hover .category-shape-wrapper {
        box-shadow:
            0 10px 28px rgba(0,0,0,0.14),
            0 0 0 2px var(--theme-primary, #6366f1);
    }

    .cat-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 50%;
        opacity: 0.92;
        transition: transform 0.35s ease;
    }

    .category-item:hover .cat-img {
        transform: scale(1.1);
    }

    .cat-icon {
        font-size: 1.8rem;
        color: var(--theme-primary, #6366f1);
        position: relative;
        z-index: 1;
        transition: transform 0.3s ease;
    }

    .category-item:hover .cat-icon {
        transform: scale(1.15) rotate(-5deg);
    }

    .category-name-smalltext {
        font-size: 0.78rem;
        font-weight: 700;
        color: #334155;
        margin-top: 6px;
        text-align: center;
        max-width: 80px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        /* Restore RTL for Arabic texts inside the LTR container */
        direction: rtl; 
    }

    .skeleton-glow {
        background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
        background-size: 200% 100%;
        animation: skel 1.5s infinite;
    }

    @@keyframes skel {
        0%   { background-position: 200% 0; }
        100% { background-position: -200% 0; }
    }

    @@media (max-width: 991px) {
        .category-shape-wrapper { width: 52px !important; height: 52px !important; }
        .category-item { min-width: 60px; }
        .category-name-smalltext { font-size: 0.72rem !important; }
    }
</style>

@code {
    [Parameter] public List<MainCategoryDto>? Categories { get; set; }

    private List<MainCategoryDto>? internalCategories;
    private bool _disposed = false;
    private string containerId = "drag-scroll-" + Guid.NewGuid().ToString("N");

    private List<MainCategoryDto>? DisplayCategories
    {
        get
        {
            if (Categories != null && Categories.Any()) return Categories;
            if (internalCategories != null && internalCategories.Any()) return internalCategories;
            return null;
        }
    }

    protected override void OnInitialized()
    {
        if (Categories == null)
            _ = LoadCategoriesAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender || DisplayCategories != null)
        {
            await InitDragScrollAsync();
        }
    }

    private async Task InitDragScrollAsync()
    {
        try
        {
            var script = @"
                (function() {
                    var el = document.getElementById('" + containerId + @"');
                    if (!el || el.dataset.dragInit) return;
                    el.dataset.dragInit = 'true';

                    var track = el.querySelector('.drag-scroll-track');
                    if (!track) return;
                    
                    // Force hidden native overflow, we handle drag manually via transform
                    el.style.overflowX = 'hidden'; 
                    track.style.willChange = 'transform';
                    
                    let currentX = 0;
                    let isDown = false;
                    let startMouseX = 0;
                    let startCurrentX = 0;
                    let isDragging = false;
                    
                    function getEventX(e) {
                        return (e.touches && e.touches.length > 0) ? e.touches[0].pageX : e.pageX;
                    }

                    function onStart(e) {
                        isDown = true;
                        isDragging = false;
                        el.classList.add('active');
                        startMouseX = getEventX(e);
                        startCurrentX = currentX;
                    }

                    function onMove(e) {
                        if (!isDown) return;
                        
                        let x = getEventX(e);
                        let deltaX = x - startMouseX;
                        if (Math.abs(deltaX) > 5) {
                            isDragging = true;
                        }
                        
                        currentX = startCurrentX + deltaX;
                        
                        let w = track.offsetWidth / 2;
                        if (w > 0) {
                            if (currentX > 0) {
                                currentX -= w;
                                startCurrentX -= w;
                            } else if (Math.abs(currentX) >= w) {
                                currentX += w;
                                startCurrentX += w;
                            }
                        }
                        track.style.transform = `translateX(${currentX}px)`;
                    }

                    function onEnd() { 
                        isDown = false; 
                        el.classList.remove('active'); 
                    }
                    
                    el.addEventListener('mousedown', onStart);
                    el.addEventListener('touchstart', onStart, {passive: true});
                    
                    el.addEventListener('mousemove', onMove, {passive: true});
                    el.addEventListener('touchmove', onMove, {passive: true});
                    
                    el.addEventListener('mouseleave', onEnd);
                    el.addEventListener('mouseup', onEnd);
                    el.addEventListener('touchend', onEnd);
                    el.addEventListener('touchcancel', onEnd);

                    // Auto Rotate Logic
                    let lastTime = 0;
                    function animate(time) {
                        if (lastTime === 0) lastTime = time;
                        let dt = time - lastTime;
                        lastTime = time;

                        if (!isDown && !el.matches(':hover')) {
                            currentX -= dt * 0.04; // Adjust speed (e.g., 0.04 px per ms)
                            let w = track.offsetWidth / 2;
                            if (w > 0 && Math.abs(currentX) >= w) {
                                currentX += w;
                            }
                            track.style.transform = `translateX(${currentX}px)`;
                        }
                        requestAnimationFrame(animate);
                    }
                    requestAnimationFrame(animate);

                    // Prevent clicking on links when dragging happened
                    var items = track.querySelectorAll('.category-item');
                    items.forEach(item => {
                        item.addEventListener('click', function(e) {
                            if (isDragging) {
                                e.preventDefault();
                                e.stopPropagation();
                            }
                        });
                    });
                })();
            ";
            await JS.InvokeVoidAsync("eval", script);
        }
        catch { }
    }

    private async Task LoadCategoriesAsync()
    {
        try
        {
            // First load from offline cache
            var cached = await OfflineData.GetMainCategoriesAsync();
            if (cached != null && cached.Any())
            {
                internalCategories = cached;
                StateHasChanged();
            }

            // Then fetch from API
            var results = await Api.GetMainCategoriesAsync();
            if (results != null && results.Any())
            {
                internalCategories = results;
                await OfflineData.SaveMainCategoriesAsync(results);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"CategoryMarquee: error loading - {ex.Message}");
        }
        finally
        {
            if (!_disposed)
            {
                try { await InvokeAsync(StateHasChanged); } catch { }
            }
        }
    }

    private void OnCategorySelected(MainCategoryDto category)
        => Navigation.NavigateTo($"/explore/main/{category.Id}/{Uri.EscapeDataString(category.Name)}");

    public void Dispose() => _disposed = true;
}
