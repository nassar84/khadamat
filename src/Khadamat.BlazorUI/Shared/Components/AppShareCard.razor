@using Khadamat.BlazorUI.State
@inject AppState State
@inject IJSRuntime JS
@inject NavigationManager Navigation

@* ── كارت مشاركة التطبيق الموحد ── *@
<div class="app-share-card @CssClass" @onclick="HandleShare" role="button" title="شارك التطبيق مع أصدقائك">
    <div class="asc-glow"></div>

    <div class="asc-inner">
        @* لوجو التطبيق *@
        <div class="asc-logo-wrap">
            @if (!string.IsNullOrEmpty(State.AppLogo))
            {
                <img src="@State.GetAbsoluteUrl(State.AppLogo)" class="asc-logo-img" alt="@State.AppName" />
            }
            else
            {
                <div class="asc-logo-fallback">
                    <i class="fa-solid fa-mobile-screen-button"></i>
                </div>
            }
            <div class="asc-logo-ring"></div>
        </div>

        @* نص الدعوة *@
        <div class="asc-text">
            <div class="asc-app-name">@(string.IsNullOrEmpty(State.AppNameAr) ? State.AppName : State.AppNameAr)</div>
            @if (ShowTagline)
            {
                <div class="asc-tagline">شارك التطبيق مع أصدقائك وعائلتك 🎁</div>
            }
            @if (!string.IsNullOrEmpty(ShareUrl))
            {
                <div class="asc-url">🔗 @ShareUrl</div>
            }
        </div>

        @* أيقونة المشاركة *@
        <div class="asc-share-icon">
            <i class="fa-solid fa-share-nodes"></i>
        </div>
    </div>

    @* شريط منصات التنزيل *@
    @if (ShowStoreButtons)
    {
        <div class="asc-stores" @onclick:stopPropagation="true">
            @if (!string.IsNullOrEmpty(ShareUrl))
            {
                <a href="@ShareUrl" class="asc-store-btn asc-apk" target="_blank" @onclick:stopPropagation="true">
                    <i class="fa-brands fa-android"></i>
                    <span>تحميل APK</span>
                </a>
            }
            @if (!string.IsNullOrEmpty(State.GooglePlayUrl))
            {
                <a href="@State.GooglePlayUrl" class="asc-store-btn asc-play" target="_blank" @onclick:stopPropagation="true">
                    <i class="fa-brands fa-google-play"></i>
                    <span>Google Play</span>
                </a>
            }
            @if (!string.IsNullOrEmpty(State.AppStoreUrl))
            {
                <a href="@State.AppStoreUrl" class="asc-store-btn asc-ios" target="_blank" @onclick:stopPropagation="true">
                    <i class="fa-brands fa-apple"></i>
                    <span>App Store</span>
                </a>
            }
        </div>
    }
</div>

<style>
    .app-share-card {
        position: relative;
        background: linear-gradient(135deg, var(--theme-primary, #6366f1) 0%, var(--theme-secondary, #a855f7) 100%);
        border-radius: 20px;
        padding: 18px 20px;
        cursor: pointer;
        overflow: hidden;
        transition: transform 0.25s ease, box-shadow 0.25s ease;
        box-shadow: 0 8px 30px rgba(99,102,241,0.3);
        user-select: none;
    }

    .app-share-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 14px 40px rgba(99,102,241,0.4);
    }

    .app-share-card:active { transform: scale(0.97); }

    .asc-glow {
        position: absolute;
        width: 180px;
        height: 180px;
        background: rgba(255,255,255,0.1);
        border-radius: 50%;
        top: -60px;
        left: -40px;
        animation: asc-blob-float 4s ease-in-out infinite;
        pointer-events: none;
    }

    @@keyframes asc-blob-float {
        0%, 100% { transform: scale(1) translateY(0); }
        50% { transform: scale(1.15) translateY(10px); }
    }

    .asc-inner {
        display: flex;
        align-items: center;
        gap: 14px;
        position: relative;
        z-index: 1;
    }

    .asc-logo-wrap { position: relative; flex-shrink: 0; }

    .asc-logo-img {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        object-fit: contain;
        background: rgba(255,255,255,0.15);
        padding: 6px;
        border: 2px solid rgba(255,255,255,0.3);
    }

    .asc-logo-fallback {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        background: rgba(255,255,255,0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
        color: white;
        border: 2px solid rgba(255,255,255,0.3);
    }

    .asc-logo-ring {
        position: absolute;
        inset: -4px;
        border-radius: 18px;
        border: 2px solid rgba(255,255,255,0.2);
        animation: asc-ring-pulse 2s ease-in-out infinite;
    }

    @@keyframes asc-ring-pulse {
        0%, 100% { opacity: 0.3; transform: scale(1); }
        50% { opacity: 0.7; transform: scale(1.05); }
    }

    .asc-text { flex: 1; min-width: 0; }

    .asc-app-name {
        font-size: 1.05rem;
        font-weight: 800;
        color: white;
        margin-bottom: 2px;
        letter-spacing: -0.3px;
    }

    .asc-tagline {
        font-size: 0.78rem;
        color: rgba(255,255,255,0.85);
        margin-bottom: 3px;
        line-height: 1.3;
    }

    .asc-url {
        font-size: 0.7rem;
        color: rgba(255,255,255,0.65);
        text-overflow: ellipsis;
        overflow: hidden;
        white-space: nowrap;
        direction: ltr;
        text-align: start;
    }

    .asc-share-icon {
        flex-shrink: 0;
        width: 42px;
        height: 42px;
        border-radius: 12px;
        background: rgba(255,255,255,0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        color: white;
        transition: background 0.2s;
        border: 1px solid rgba(255,255,255,0.25);
    }

    .app-share-card:hover .asc-share-icon { background: rgba(255,255,255,0.3); }

    .asc-stores {
        display: flex;
        gap: 8px;
        margin-top: 14px;
        padding-top: 12px;
        border-top: 1px solid rgba(255,255,255,0.2);
        position: relative;
        z-index: 1;
        flex-wrap: wrap;
    }

    .asc-store-btn {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 7px 14px;
        border-radius: 10px;
        background: rgba(255,255,255,0.15);
        color: white;
        text-decoration: none;
        font-size: 0.78rem;
        font-weight: 700;
        border: 1px solid rgba(255,255,255,0.25);
        transition: background 0.2s;
        flex: 1;
        justify-content: center;
        min-width: 90px;
    }

    .asc-store-btn:hover {
        background: rgba(255,255,255,0.25);
        color: white;
        text-decoration: none;
    }

    .asc-store-btn i { font-size: 1rem; }

    .app-share-card.compact { padding: 12px 16px; }

    .app-share-card.compact .asc-logo-img,
    .app-share-card.compact .asc-logo-fallback { width: 40px; height: 40px; }

    .app-share-card.compact .asc-app-name { font-size: 0.95rem; }
    .app-share-card.compact .asc-tagline { font-size: 0.73rem; }
</style>

@code {
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter] public bool ShowTagline { get; set; } = true;
    [Parameter] public bool ShowStoreButtons { get; set; } = false;
    [Parameter] public EventCallback OnShareClicked { get; set; }

    private string ShareUrl => string.IsNullOrEmpty(State.AppShareUrl)
        ? Navigation.BaseUri
        : State.AppShareUrl;

    private string FullShareText => (string.IsNullOrEmpty(State.AppShareText)
        ? $"📲 {State.AppName} — كل خدماتك في مكان واحد!\nتواصل مع أفضل الحرفيين والمهنيين بكل سهولة وأمان.\n\n🔗 "
        : State.AppShareText + "\n") + ShareUrl;

    private async Task HandleShare()
    {
        if (OnShareClicked.HasDelegate)
        {
            await OnShareClicked.InvokeAsync();
            return;
        }

        var appName = State.AppName.Replace("'", "\\'");
        var shareUrl = ShareUrl.Replace("'", "\\'");
        var shareText = FullShareText.Replace("'", "\\'").Replace("\n", "\\n").Replace("`", "'");

        try
        {
            await JS.InvokeVoidAsync("eval", $@"
                (function() {{
                    var url = '{shareUrl}';
                    var text = '{shareText}';
                    var title = '{appName}';
                    if (navigator.share) {{
                        navigator.share({{ title: title, text: text, url: url }}).catch(function(){{}});
                    }} else {{
                        if (navigator.clipboard) {{
                            navigator.clipboard.writeText(text).then(function() {{
                                alert('\u062a\u0645 \u0646\u0633\u062e \u0631\u0627\u0628\u0637 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0639\u0644\u0649 \u0627\u0644\u062d\u0627\u0641\u0638\u0629 \u2705');
                            }}).catch(function() {{ window.open(url, '_blank'); }});
                        }} else {{
                            window.open(url, '_blank');
                        }}
                    }}
                }})();
            ");
        }
        catch { }
    }
}
