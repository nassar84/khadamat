@using Microsoft.AspNetCore.Components.Forms
@using Khadamat.BlazorUI.Services

<div class="image-uploader-container @Class">
    <div class="image-preview-wrapper rounded-4 border-dashed position-relative overflow-hidden d-flex align-items-center justify-content-center bg-light"
         style="height: @(Height); width: @(Width); @(string.IsNullOrEmpty(ImageUrl) ? "" : $"background: url('{ImageUrl}') center/cover;")">

        @if (_isUploading)
        {
            <div class="text-center text-primary animate-fade-in">
                <div class="spinner-border spinner-border-sm mb-2" role="status"></div>
                <div class="small">جاري الرفع...</div>
            </div>
        }
        else if (string.IsNullOrEmpty(ImageUrl))
        {
            <label for="@_inputId" class="w-100 h-100 d-flex flex-column align-items-center justify-content-center text-center text-muted animate-fade-in cursor-pointer mb-0">
                <i class="fa-solid fa-cloud-arrow-up fs-2 mb-2"></i>
                <div class="small fw-bold">@PickerLabel</div>
                <div class="x-small">@AcceptedFormatsText</div>
            </label>
        }
        else if (!ReadOnly)
        {
            <div class="image-overlay position-absolute inset-0 bg-dark bg-opacity-50 d-flex align-items-center justify-content-center opacity-0 hover-opacity-100 transition-all">
                <div class="d-flex gap-2">
                    <label for="@_inputId" class="btn btn-sm btn-light rounded-pill px-3 shadow-sm mb-0 cursor-pointer d-inline-flex align-items-center justify-content-center">
                        تغيير
                    </label>
                    <button type="button" class="btn btn-sm btn-danger rounded-pill px-3 shadow-sm" @onclick="ClearImage">
                        حذف
                    </button>
                </div>
            </div>
        }

        @if (!ReadOnly)
        {
            <InputFile id="@_inputId" class="position-absolute"
                       style="width: 0.1px; height: 0.1px; opacity: 0; overflow: hidden; z-index: -1; pointer-events: none;"
                       OnChange="OnInputFileChange" accept="image/*" />
        }
    </div>

    @if (!string.IsNullOrEmpty(_uploadError))
    {
        <div class="small text-danger mt-1 animate-fade-in">
            <i class="fa-solid fa-circle-exclamation me-1"></i>@_uploadError
        </div>
    }

    @if (!ReadOnly && ShowUrlInput)
    {
        <div class="mt-2 animate-fade-in">
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-white border-0"><i class="fa-solid fa-link text-muted"></i></span>
                <input type="text" class="form-control border-0 bg-white small"
                       placeholder="أو أدخل رابط الصورة هنا..."
                       value="@ImageUrl"
                       @onchange="OnUrlInputChanged" />
            </div>
        </div>
    }
</div>

<style>
    .border-dashed {
        border: 2px dashed rgba(0,0,0,0.1);
        transition: all 0.3s;
    }
    .image-preview-wrapper:hover {
        border-color: var(--primary, #6366f1);
        background-color: rgba(99, 102, 241, 0.05);
    }
    .hover-opacity-100:hover { opacity: 1 !important; }
    .cursor-pointer { cursor: pointer; }
    .inset-0 { top: 0; left: 0; right: 0; bottom: 0; }
    .animate-fade-in { animation: fadeIn 0.3s ease-out; }
    @@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
</style>

@code {
    [Parameter] public string? ImageUrl { get; set; }
    [Parameter] public EventCallback<string?> ImageUrlChanged { get; set; }

    [Parameter] public string Id { get; set; } = Guid.NewGuid().ToString();
    [Parameter] public string Height { get; set; } = "200px";
    [Parameter] public string Width { get; set; } = "100%";
    [Parameter] public string PickerLabel { get; set; } = "رفع صورة";
    [Parameter] public string AcceptedFormatsText { get; set; } = "PNG, JPG, WEBP (حتى 10MB)";
    [Parameter] public bool ReadOnly { get; set; } = false;
    [Parameter] public bool ShowUrlInput { get; set; } = true;
    [Parameter] public string Class { get; set; } = "";
    /// <summary>Upload folder type: services, marketplace, users, ads</summary>
    [Parameter] public string UploadType { get; set; } = "services";

    [Inject] private ApiClient Api { get; set; } = default!;

    private bool _isUploading = false;
    private string? _uploadError = null;
    // Stable unique ID per component instance so label can locate the file input
    private readonly string _inputId = $"imgup-{Guid.NewGuid():N}";

    private async Task OnInputFileChange(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        _uploadError = null;
        _isUploading = true;
        StateHasChanged();

        try
        {
            var result = await Api.UploadImageAsync(file, UploadType);
            if (result?.Success == true && !string.IsNullOrEmpty(result.Url))
            {
                await UpdateImageUrl(result.Url);
            }
            else
            {
                _uploadError = result?.Message ?? "فشل رفع الصورة. حاول مرة أخرى.";
            }
        }
        catch (Exception ex)
        {
            _uploadError = "خطأ في الرفع: " + ex.Message;
            Console.WriteLine($"[ImageUploader] Upload error: {ex.Message}");
        }
        finally
        {
            _isUploading = false;
            StateHasChanged();
        }
    }

    private async Task OnUrlInputChanged(ChangeEventArgs e)
        => await UpdateImageUrl(e.Value?.ToString());

    private async Task ClearImage()
    {
        _uploadError = null;
        await UpdateImageUrl(null);
    }

    private async Task UpdateImageUrl(string? url)
    {
        ImageUrl = url;
        await ImageUrlChanged.InvokeAsync(url);
    }
}
