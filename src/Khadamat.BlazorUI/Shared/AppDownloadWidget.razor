@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject Khadamat.BlazorUI.State.AppState State
@implements IDisposable

@if (State.IsMobileApp || State.IsNativeApp) { return; }

<div class="app-download-widget-v2 @(isExpanded ? "expanded" : "") @(isVisible ? "visible" : "")">
    <!-- Glow Background Layer -->
    <div class="widget-aurora-glow"></div>
    
    <!-- Collapsed Trigger (Floating Button) -->
    <button class="widget-fab shadow-premium" @onclick="ToggleExpand" aria-label="Download App">
        <div class="fab-inner">
            <div class="icon-stack">
                <i class="fa-solid fa-mobile-screen-button fab-icon-main"></i>
                <div class="status-dot-pulse"></div>
            </div>
            <span class="fab-text d-none d-md-block">حمّل التطبيق</span>
        </div>
        
        <!-- Ripple Effect Elements -->
        <div class="ripple-ring r1"></div>
        <div class="ripple-ring r2"></div>
    </button>

    <!-- Expanded Portal Card -->
    <div class="app-portal-card glass-morphism-premium @(isExpanded ? "expanded" : "")">
        <button class="close-portal-btn" @onclick="ToggleExpand" title="إغلاق">
            <i class="fa-solid fa-xmark"></i>
        </button>

        <div class="portal-body">
            <div class="portal-header text-center mb-4">
                <div class="app-logo-animated mb-2">
                    <div class="logo-orb">
                        @if (!string.IsNullOrEmpty(State.AppLogo))
                        {
                            <img src="@State.AppLogo" style="height: 35px; width: auto;" />
                        }
                        else
                        {
                            <i class="fa-solid fa-bolt-lightning text-white fs-4"></i>
                        }
                    </div>
                </div>
                <h4 class="fw-bold premium-text-glow mb-1">@State.AppName موبايل</h4>
                <p class="text-muted small">كل ما تحتاجه في متناول يدك</p>
            </div>

            <div class="portal-actions d-grid gap-2">
                <a href="/downloads/khadamat.apk" download="@($"{(State.AppName ?? "khadamat").ToLower()}.apk")" class="store-link play-store-glow d-flex align-items-center p-2 rounded-4 text-decoration-none">
                    <div class="store-icon bg-white text-dark rounded-circle d-flex align-items-center justify-content-center me-3" style="width:32px;height:32px;min-width:32px;">
                        <i class="fa-brands fa-android fs-6"></i>
                    </div>
                    <div class="store-info text-white text-start">
                        <span class="d-block xx-small opacity-75">DIRECT DOWNLOAD</span>
                        <span class="fw-bold fs-6">تنزيل مباشر (APK)</span>
                    </div>
                    <div class="download-badge ms-auto">FREE</div>
                </a>

                <button @onclick="ShareAppInvitation" class="store-link share-app-glow d-flex align-items-center p-2 rounded-4 text-decoration-none bg-transparent border-0 w-100 text-start">
                    <div class="store-icon bg-white text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width:32px;height:32px;min-width:32px;">
                        <i class="fa-solid fa-share-nodes fs-6"></i>
                    </div>
                    <div class="store-info text-white text-start">
                        <span class="d-block xx-small opacity-75">INVITE FRIENDS</span>
                        <span class="fw-bold fs-6">مشاركة التطبيق</span>
                    </div>
                    <div class="share-sparkle ms-auto"><i class="fa-solid fa-sparkles small"></i></div>
                </button>
            </div>

            <div class="qr-scan-section mt-4 pt-4 border-top border-white border-opacity-10 text-center">
                <div class="qr-frame mx-auto mb-3" id="app-download-qr">
                    <div class="qr-corner top-left"></div>
                    <div class="qr-corner top-right"></div>
                    <div class="qr-corner bottom-left"></div>
                    <div class="qr-corner bottom-right"></div>
                    <div class="qr-scanner-line"></div>
                </div>
            </div>
            <div class="share-options mt-4">
                <p class="text-white opacity-75 small mb-3">شارك التطبيق مع أصدقائك:</p>
                <div class="d-flex justify-content-center gap-3">
                    <button class="share-btn whatsapp" @onclick='() => ShareTo("whatsapp")' title="واتساب">
                        <i class="fa-brands fa-whatsapp"></i>
                    </button>
                    <button class="share-btn facebook" @onclick='() => ShareTo("facebook")' title="فيسبوك">
                        <i class="fa-brands fa-facebook-f"></i>
                    </button>
                    <button class="share-btn twitter" @onclick='() => ShareTo("twitter")' title="تويتر">
                        <i class="fa-brands fa-x-twitter"></i>
                    </button>
                    <button class="share-btn generic" @onclick="ShareAppInvitation" title="المزيد">
                        <i class="fa-solid fa-share-nodes"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Premium App Widget Styles */
    .app-download-widget-v2 {
        position: fixed;
        bottom: 25px; /* Lowered from 30px */
        right: 25px;
        z-index: 10000;
        pointer-events: none;
        opacity: 0;
        transform: translateY(20px);
        transition: all 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    @@media (max-width: 991px) {
        .app-download-widget-v2 {
            /* Ensure visibility when minimized or on tablets */
            display: block !important;
        }
    }

    .app-download-widget-v2.visible {
        opacity: 1;
        transform: translateY(0);
        pointer-events: auto;
    }

    /* FAB Styles */
    .widget-fab {
        background: linear-gradient(135deg, var(--theme-primary, #6366f1), var(--theme-secondary, #a855f7));
        border: none;
        padding: 12px 25px;
        border-radius: 50px;
        color: white;
        display: flex;
        align-items: center;
        gap: 12px;
        cursor: pointer;
        position: relative;
        overflow: hidden;
        transition: all 0.4s ease;
        box-shadow: 0 10px 30px rgba(99, 102, 241, 0.4);
    }

    .widget-fab:hover {
        transform: scale(1.05) translateY(-5px);
        box-shadow: 0 15px 40px rgba(99, 102, 241, 0.5);
    }

    .fab-inner {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .icon-stack {
        position: relative;
        width: 30px;
        height: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .fab-icon-main {
        font-size: 1.4rem;
        animation: phoneFloat 3s ease-in-out infinite;
    }

    .status-dot-pulse {
        position: absolute;
        top: -2px;
        right: -2px;
        width: 8px;
        height: 8px;
        background: #10b981;
        border-radius: 50%;
        border: 2px solid #6366f1;
    }

    .status-dot-pulse::after {
        content: '';
        position: absolute;
        inset: -2px;
        border-radius: 50%;
        border: 1px solid #10b981;
        animation: pulseEffect 2s infinite;
    }

    .fab-text {
        font-weight: 700;
        font-size: 0.95rem;
    }

    /* Ripple Rings */
    .ripple-ring {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        border: 1px solid rgba(255,255,255,0.4);
        border-radius: 50%;
        pointer-events: none;
        z-index: 1;
    }

    .ripple-ring.r1 { width: 100px; height: 100px; animation: rippleAnim 3s linear infinite; }
    .ripple-ring.r2 { width: 150px; height: 150px; animation: rippleAnim 3s linear infinite 1.5s; }

    /* Portal Card Styles */
    .app-portal-card {
        position: absolute;
        bottom: 60px; /* Lowered from 80px to provide more top clearance */
        right: 0;
        width: 280px; /* Reduced from 320px */
        max-height: 85vh;
        overflow-y: auto;
        background: rgba(15, 23, 42, 0.95);
        backdrop-filter: blur(25px);
        -webkit-backdrop-filter: blur(25px);
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 24px;
        padding: 15px 20px; /* More compact padding */
        opacity: 0;
        visibility: hidden;
        transform: scale(0.8) translateY(20px);
        transform-origin: bottom right;
        transition: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
        z-index: 10001;
        box-shadow: 0 30px 60px rgba(0, 0, 0, 0.4);
        color: white;
    }

    .app-portal-card.expanded {
        opacity: 1;
        visibility: visible;
        transform: scale(1) translateY(0);
    }

    .close-portal-btn {
        position: absolute;
        top: 15px;
        right: 15px;
        background: rgba(255,255,255,0.1);
        border: none;
        color: white;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s;
    }

    .close-portal-btn:hover { background: rgba(255,255,255,0.2); transform: rotate(90deg); }

    .app-logo-animated {
        display: inline-block;
        position: relative;
    }

    .logo-orb {
        width: 40px; /* Reduced further from 50px */
        height: 40px;
        background: linear-gradient(135deg, var(--theme-primary, #6366f1), var(--theme-secondary, #a855f7));
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto;
        box-shadow: 0 10px 20px rgba(99, 102, 241, 0.4);
        animation: orbPulse 4s infinite ease-in-out;
    }

    /* Store Link Styles */
    .store-link {
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        border: 1px solid rgba(255,255,255,0.08);
    }

    .store-link:hover {
        transform: scale(1.03) translateX(-5px);
        border-color: rgba(255,255,255,0.3);
    }

    .play-store-glow { background: rgba(16, 185, 129, 0.15); box-shadow: 0 0 20px rgba(16, 185, 129, 0.1); }
    .play-store-glow:hover { background: rgba(16, 185, 129, 0.25); box-shadow: 0 0 30px rgba(16, 185, 129, 0.2); }
    
    .share-app-glow { background: rgba(99, 102, 241, 0.15); border: 1px solid rgba(99, 102, 241, 0.3) !important; cursor: pointer; }
    .share-app-glow:hover { background: rgba(99, 102, 241, 0.25); transform: translateY(-3px) scale(1.02); }

    .download-badge {
        background: #10b981;
        color: white;
        font-size: 0.6rem;
        font-weight: 800;
        padding: 2px 8px;
        border-radius: 6px;
        letter-spacing: 1px;
    }

    .share-sparkle { color: #facc15; animation: sparkle 2s infinite; }
    
    @@keyframes sparkle {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.6; transform: scale(1.2); }
    }

    .app-store-glow { background: rgba(255, 255, 255, 0.1); }
    .app-store-glow:hover { background: rgba(255, 255, 255, 0.15); }

    /* QR Frame */
    .qr-frame {
        width: 90px; /* Reduced further from 110px */
        height: 90px;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255,255,255,0.03);
        border-radius: 12px;
    }

    .qr-corner {
        position: absolute;
        width: 15px;
        height: 15px;
        border: 2px solid var(--theme-primary, #6366f1);
    }

    .top-left { top: 0; left: 0; border-right: none; border-bottom: none; border-radius: 8px 0 0 0; }
    .top-right { top: 0; right: 0; border-left: none; border-bottom: none; border-radius: 0 8px 0 0; }
    .bottom-left { bottom: 0; left: 0; border-right: none; border-top: none; border-radius: 0 0 0 8px; }
    .bottom-right { bottom: 0; right: 0; border-left: none; border-top: none; border-radius: 0 0 8px 0; }

    .qr-scanner-line {
        position: absolute;
        top: 0;
        left: 5%;
        width: 90%;
        height: 2px;
        background: linear-gradient(90deg, transparent, var(--theme-primary, #6366f1), transparent);
        box-shadow: 0 0 10px var(--theme-primary, #6366f1);
        animation: scannerMove 3s infinite ease-in-out;
        z-index: 5;
    }

    /* Animations */
    @@keyframes phoneFloat {
        0%, 100% { transform: translateY(0) rotate(0); }
        50% { transform: translateY(-3px) rotate(5deg); }
    }

    @@keyframes pulseEffect {
        0% { transform: scale(1); opacity: 1; }
        100% { transform: scale(3); opacity: 0; }
    }

    @@keyframes rippleAnim {
        from { transform: translate(-50%, -50%) scale(0.8); opacity: 0.5; }
        to { transform: translate(-50%, -50%) scale(1.5); opacity: 0; }
    }

    @@keyframes scannerMove {
        0%, 100% { top: 5%; }
        50% { top: 90%; }
    }

    @@keyframes orbPulse {
        0%, 100% { transform: scale(1); filter: brightness(1); }
        50% { transform: scale(1.1); filter: brightness(1.2); }
    }

    .premium-text-glow {
        text-shadow: 0 0 10px rgba(99, 102, 241, 0.5);
    }

    .xx-small { font-size: 0.65rem; }

    @@media (max-width: 768px) {
        .app-download-widget-v2 {
            bottom: 85px; /* Above BottomNav */
            right: 20px;
        }
        .app-portal-card {
            width: 280px;
            bottom: 70px;
            padding: 20px;
        }
    }
    .share-options .share-btn {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        border: none;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        color: white;
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(5px);
    }

    .share-options .share-btn:hover {
        transform: translateY(-5px) scale(1.1);
    }

    .share-options .share-btn.whatsapp:hover { background: #25D366; box-shadow: 0 5px 15px rgba(37, 211, 102, 0.4); }
    .share-options .share-btn.facebook:hover { background: #1877F2; box-shadow: 0 5px 15px rgba(24, 119, 242, 0.4); }
    .share-options .share-btn.twitter:hover { background: #000000; box-shadow: 0 5px 15px rgba(0, 0, 0, 0.4); }
    .share-options .share-btn.generic:hover { background: var(--primary-color); box-shadow: 0 5px 15px rgba(99, 102, 241, 0.4); }

    .x-small { font-size: 0.75rem; }
    
    @@media (max-width: 576px) {
        .app-download-card {
            width: 320px;
        }
    }
</style>

@code {
    private bool isExpanded = false;
    private bool isVisible = false;
    private bool _disposed = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Delayed appearance for "Surprise" effect
            await Task.Delay(3000); 
            if (_disposed) return;
            isVisible = true;
            try { await InvokeAsync(StateHasChanged); }
            catch { }
        }
    }

    private async Task ToggleExpand() 
    {
        try
        {
            isExpanded = !isExpanded;
            if (isExpanded)
            {
                await Task.Delay(200); // Increased delay
                var downloadUrl = Navigation.BaseUri.TrimEnd('/') + "/downloads/khadamat.apk";
                
                if (JS != null)
                {
                    await JS.InvokeVoidAsync("generateQRCode", "app-download-qr", downloadUrl);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in ToggleExpand: {ex.Message}");
        }
    }

    private async Task ShareAppInvitation()
    {
        try
        {
            var shareUrl = Navigation.BaseUri;
            var shareTitle = $"حمّل تطبيق {State.AppName ?? "خدماوى"} - عالم من الخدمات";
            var shareText = $"🌟 اكتشف تطبيق {State.AppName ?? "خدماوى"} الجديد!\n\n" +
                            "كل ما تحتاجه من خدمات في تطبيق واحد:\n" +
                            "✅ خدمات طبية وتمريضية منزلية\n" +
                            "✅ صيانة منزلية (سباكة، كهرباء، نجارة)\n" +
                            "✅ خدمات تعليمية وتدريبية\n" +
                            "✅ توصيل وخدمات لوجستية\n" +
                            "✅ استشارات قانونية ومهنية\n\n" +
                            "🚀 تجربة عصرية، سهولة في الطلب، وأمان تام.\n\n" +
                            "جربه الآن عبر الرابط:";
            
            if (JS != null)
            {
                await JS.InvokeVoidAsync("shareApp", shareTitle, shareText, shareUrl);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in ShareAppInvitation: {ex.Message}");
        }
    }

    private async Task ShareTo(string platform)
    {
        try
        {
            var shareUrl = Navigation.BaseUri;
            var shareText = $"اكتشف تطبيق {State.AppName ?? "خدماوى"} المتكامل لكل الخدمات!\n" +
                            "تمريض، تعليم، حرف، توصيل.. كل شيء في مكان واحد.\n" +
                            "جربه الآن: " + shareUrl;
            
            string url = "";
            switch (platform)
            {
                case "whatsapp":
                    url = $"https://wa.me/?text={Uri.EscapeDataString(shareText)}";
                    break;
                case "facebook":
                    url = $"https://www.facebook.com/sharer/sharer.php?u={Uri.EscapeDataString(shareUrl)}";
                    break;
                case "twitter":
                    url = $"https://twitter.com/intent/tweet?text={Uri.EscapeDataString(shareText)}";
                    break;
            }

            if (!string.IsNullOrEmpty(url) && JS != null)
            {
                await JS.InvokeVoidAsync("open", url, "_blank");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in ShareTo: {ex.Message}");
        }
    }

    public void Dispose()
    {
        _disposed = true;
    }
}
