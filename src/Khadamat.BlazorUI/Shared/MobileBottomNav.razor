@inject NavigationManager Navigation
@inject Khadamat.BlazorUI.State.AppState State
@inject Khadamat.BlazorUI.Services.Auth.IAuthService AuthService
@implements IDisposable

<nav class="bottom-nav">
@if (State.IsProviderMode)
{
    <button class="nav-item @GetActiveClass("/provider/dashboard")" @onclick='() => Navigate("/provider/dashboard")'>
        <i class="fa-solid fa-chart-line"></i>
        <span>الرئيسية</span>
    </button>
    
    <button class="nav-item @GetActiveClass("/provider/myservices")" @onclick='() => Navigate("/provider/myservices")'>
        <i class="fa-solid fa-briefcase"></i>
        <span>خدماتي</span>
    </button>

    <button class="nav-item" @onclick="ToggleMode">
        <i class="fa-solid fa-repeat"></i>
        <span>تبديل</span>
    </button>

    <button class="nav-item @GetActiveClass("/provider/messages")" @onclick='() => Navigate("/provider/messages")'>
        <i class="fa-solid fa-message"></i>
        <span>الرسائل</span>
    </button>
    
    <button class="nav-item @GetActiveClass("/profile")" @onclick='() => Navigate("/profile")'>
        <i class="fa-solid fa-user-gear"></i>
        <span>الإعدادات</span>
    </button>
}
else
{
    <button class="nav-item @GetActiveClass("/")" @onclick='() => Navigate("/")'>
        <i class="fa-solid fa-house"></i>
        <span>الرئيسية</span>
    </button>
    
    <button class="nav-item @GetActiveClass("/categories")" @onclick='() => Navigate("/categories")'>
        <i class="fa-solid fa-th-large"></i>
        <span>الأقسام</span>
    </button>
    
    <button class="nav-item marketplace-nav-btn @GetActiveClass("/marketplace")" @onclick='() => Navigate("/marketplace")'>
        <span class="store-icon-wrap">
            <i class="fa-solid fa-store store-anim"></i>
            <span class="store-pulse-ring"></span>
        </span>
        <span>المتجر</span>
    </button>
    
    @if (State.IsProvider)
    {
        <button class="nav-item" @onclick="ToggleMode">
            <i class="fa-solid fa-repeat"></i>
            <span>مزود</span>
        </button>
    }
    else
    {
        <button class="nav-item @GetActiveClass("/client/favorites")" @onclick='() => Navigate("/client/favorites")'>
            <i class="fa-solid fa-heart"></i>
            <span>المفضلة</span>
        </button>
    }
    
    <AuthorizeView>
        <Authorized>
            <div class="nav-item-account-group">
                <button class="nav-item @GetActiveClass("/profile")" @onclick='() => Navigate("/profile")'>
                    <div class="nav-avatar-wrapper">
                        <img src="@State.UserImageUrl" class="nav-user-avatar" alt="User" />
                        <div class="online-dot-mini"></div>
                    </div>
                    <span>@GetFirstName(State.UserName)</span>
                </button>
                <button class="nav-item logout-btn-mini" @onclick="HandleLogout">
                    <i class="fa-solid fa-power-off"></i>
                    <span>خروج</span>
                </button>
            </div>
        </Authorized>
        <NotAuthorized>
            <button class="nav-item @GetActiveClass("/login")" @onclick='() => Navigate("/login")'>
                <i class="fa-solid fa-sign-in-alt"></i>
                <span>دخول</span>
            </button>
        </NotAuthorized>
    </AuthorizeView>
}
</nav>

<style>
    .bottom-nav {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        display: flex;
        justify-content: space-around;
        align-items: center;
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(20px);
        border-top: 1px solid rgba(0, 0, 0, 0.08);
        padding: 8px 0 max(8px, env(safe-area-inset-bottom));
        box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.08);
        z-index: 1000;
    }

    .nav-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        background: none;
        border: none;
        color: #64748b;
        font-size: 0.7rem;
        font-weight: 600;
        padding: 8px 12px;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        border-radius: 12px;
        min-width: 70px;
    }

    .nav-item i {
        font-size: 1.4rem;
        transition: all 0.3s;
    }

    .nav-item.active {
        color: var(--theme-primary, #3b82f6);
    }

    .nav-item.active i {
        transform: scale(1.1);
    }

    .nav-item:active {
        transform: scale(0.95);
        background: rgba(59, 130, 246, 0.1);
    }

    /* Ripple effect */
    .nav-item::before {
        content: '';
        position: absolute;
        width: 100%;
        height: 100%;
        background: radial-gradient(circle, var(--theme-primary, #3b82f6) 0%, transparent 70%);
        opacity: 0;
        transition: opacity 0.3s;
        border-radius: 12px;
    }

    .nav-item:active::before {
        opacity: 0.2;
    }

    /* Marketplace Special Styling - Premium & Distinct */
    .marketplace-nav-btn {
        position: relative;
        overflow: visible !important;
    }

    .marketplace-nav-btn i {
        color: #f59e0b; /* Amber/Gold color */
        filter: drop-shadow(0 0 5px rgba(245, 158, 11, 0.5));
    }

    .marketplace-nav-btn span {
        color: #d97706;
        font-weight: 800 !important;
    }

    .store-icon-wrap {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        background: rgba(245, 158, 11, 0.1);
        border-radius: 12px;
        margin-bottom: 2px;
        border: 1px solid rgba(245, 158, 11, 0.2);
        transition: all 0.3s ease;
    }

    .marketplace-nav-btn:active .store-icon-wrap {
        transform: scale(1.2) rotate(10deg);
        background: rgba(245, 158, 11, 0.2);
    }

    .store-anim {
        animation: store-bounce 2s infinite ease-in-out;
    }

    .store-pulse-ring {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 45px;
        height: 45px;
        background: radial-gradient(circle, rgba(245, 158, 11, 0.3) 0%, transparent 70%);
        border-radius: 50%;
        z-index: -1;
        animation: store-pulse 2s infinite;
        pointer-events: none;
    }

    @@keyframes store-bounce {
        0%, 100% { transform: translateY(0) scale(1); }
        50% { transform: translateY(-3px) scale(1.1); }
    }

    @@keyframes store-pulse {
        0% { transform: translate(-50%, -50%) scale(0.6); opacity: 0.8; }
        100% { transform: translate(-50%, -50%) scale(1.3); opacity: 0; }
    }

    /* Safe area for notched devices */
    @@supports (padding: max(0px)) {
        .bottom-nav {
            padding-bottom: max(8px, env(safe-area-inset-bottom));
        }
    }

    .nav-item-account-group {
        display: flex;
        align-items: center;
        gap: 0;
    }

    .nav-avatar-wrapper {
        position: relative;
        width: 24px;
        height: 24px;
    }

    .nav-user-avatar {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        object-fit: cover;
        border: 1.5px solid var(--theme-primary, #3b82f6);
    }

    .online-dot-mini {
        position: absolute;
        bottom: -1px;
        right: -1px;
        width: 8px;
        height: 8px;
        background: #22c55e;
        border-radius: 50%;
        border: 1.5px solid white;
    }

    .logout-btn-mini {
        color: #ef4444 !important;
        min-width: 50px !important;
    }

    .logout-btn-mini i {
        font-size: 1.1rem !important;
    }
</style>
@inject AuthenticationStateProvider AuthStateProvider
@code {
    protected override void OnInitialized()
    {
        State.OnChange += OnStateChange;
        Navigation.LocationChanged += HandleLocationChanged;
    }

    private async void OnStateChange()
    {
        await InvokeAsync(StateHasChanged);
    }

    private async void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        State.OnChange -= OnStateChange;
        Navigation.LocationChanged -= HandleLocationChanged;
    }

    private string GetActiveClass(string path)
    {
        var uri = new Uri(Navigation.Uri);
        var currentPath = uri.AbsolutePath;
        
        if (path == "/")
            return currentPath == "/" ? "active" : "";
            
        return currentPath.StartsWith(path) ? "active" : "";
    }

    private void Navigate(string path)
    {
        // Preserve nativeapp/mobileapp params when navigating in mobile app
        if (State.IsNativeApp || State.IsMobileApp)
        {
            var separator = path.Contains('?') ? "&" : "?";
            var param = State.IsNativeApp ? "nativeapp=1" : "mobileapp=1";
            var dest = path.Contains('?') ? path : path;
            Navigation.NavigateTo(dest + separator + param, forceLoad: false);
        }
        else
        {
            Navigation.NavigateTo(path, forceLoad: false);
        }
    }

    private void ToggleMode()
    {
        State.IsProviderMode = !State.IsProviderMode;
        if (State.IsProviderMode)
            Navigate("/provider/dashboard");
        else
            Navigate("/");
    }

    private string GetFirstName(string fullName)
    {
        if (string.IsNullOrEmpty(fullName)) return "حسابي";
        return fullName.Split(' ')[0];
    }

    private async Task HandleLogout()
    {
        await AuthService.Logout();
        Navigate("/login");
    }
}
