@inject NavigationManager Navigation
@inject Khadamat.BlazorUI.State.AppState State
@inject Khadamat.BlazorUI.Services.Auth.IAuthService AuthService
@implements IDisposable

<nav class="bottom-nav">
@if (State.IsProviderMode)
{
    <button class="nav-item @GetActiveClass("/provider/dashboard")" @onclick='() => Navigate("/provider/dashboard")'>
        <i class="fa-solid fa-gauge-high"></i>
        <span>اللوحة</span>
    </button>
    
    <button class="nav-item @GetActiveClass("/provider/my-services")" @onclick='() => Navigate("/provider/my-services")'>
        <i class="fa-solid fa-briefcase"></i>
        <span>خدماتي</span>
    </button>

    <button class="nav-item home-nav-btn @GetActiveClass("/")" @onclick='() => Navigate("/")'>
        <div class="home-icon-container">
            <i class="fa-solid fa-house"></i>
        </div>
        <span>الرئيسية</span>
    </button>

    <button class="nav-item @GetActiveClass("/provider/incoming-requests")" @onclick='() => Navigate("/provider/incoming-requests")'>
        <i class="fa-solid fa-clipboard-check"></i>
        <span>الطلبات</span>
    </button>
    
    <button class="nav-item @GetActiveClass("/profile")" @onclick='ToggleUserMenu'>
        @if (!string.IsNullOrEmpty(State.UserImageUrl))
        {
            <img src="@State.GetAbsoluteUrl(State.UserImageUrl)" class="rounded-circle" style="width: 22px; height: 22px; object-fit: cover; border: 1.5px solid var(--theme-primary, #2563eb);" />
        }
        else
        {
            <i class="fa-solid fa-user"></i>
        }
        <span>حسابي</span>
    </button>
}
else
{
    @if (State.IsAuthenticated)
    {
        <button class="nav-item @GetActiveClass("/user/my-services")" @onclick='() => Navigate("/user/my-services")'>
            <i class="fa-solid fa-briefcase"></i>
            <span>خدماتي</span>
        </button>
    }
    else
    {
        <button class="nav-item @GetActiveClass("/services")" @onclick='() => Navigate("/services")'>
            <i class="fa-solid fa-compass"></i>
            <span>استكشاف</span>
        </button>
    }

    <button class="nav-item @GetActiveClass("/user/my-requests")" @onclick='() => NavigateToAuthOr("/user/my-requests")'>
        <i class="fa-solid fa-list-check"></i>
        <span>طلباتي</span>
    </button>

    <button class="nav-item home-nav-btn @GetActiveClass("/")" @onclick='() => Navigate("/")'>
        <div class="home-icon-container">
            <i class="fa-solid fa-house"></i>
        </div>
        <span>الرئيسية</span>
    </button>
    
    <button class="nav-item @GetActiveClass("/user/messages")" @onclick='() => NavigateToAuthOr("/user/messages")'>
        <i class="fa-solid fa-comments"></i>
        <span>رسائلي</span>
    </button>
    
    <AuthorizeView>
        <Authorized>
            <button class="nav-item @GetActiveClass("/profile")" @onclick='ToggleUserMenu'>
                <div class="nav-avatar-wrapper">
                    <img src="@State.UserImageUrl" class="nav-user-avatar" alt="User" />
                    <div class="online-dot-mini"></div>
                </div>
                <span>حسابي</span>
            </button>
        </Authorized>
        <NotAuthorized>
            <button class="nav-item @GetActiveClass("/login")" @onclick='() => Navigate("/login")'>
                <i class="fa-solid fa-sign-in-alt"></i>
                <span>دخول</span>
            </button>
        </NotAuthorized>
    </AuthorizeView>
}
</nav>

@if (isUserMenuOpen)
{
    <div class="user-menu-backdrop" @onclick="CloseUserMenu"></div>
    <div class="user-dropdown-popover animate-popover-in" dir="rtl">
        <!-- Header -->
        <div class="popover-header">
            @if (!string.IsNullOrEmpty(State.UserImageUrl))
            {
                <img src="@State.GetAbsoluteUrl(State.UserImageUrl)" class="popover-avatar" alt="Avatar" />
            }
            else
            {
                <div class="popover-avatar-placeholder">
                    <i class="fa-solid fa-user"></i>
                </div>
            }
            <div class="popover-user-info">
                <span class="popover-name">@(string.IsNullOrWhiteSpace(State.UserName) ? "مستخدم" : State.UserName)</span>
                <span class="popover-badge">@(State.IsProviderMode ? "مقدم خدمة" : "حساب نشط")</span>
            </div>
        </div>

        <div class="popover-divider"></div>

        <!-- Links -->
        <div class="popover-body">
            <button class="popover-item" @onclick="HandleProfileClick">
                <div class="popover-icon-box profile-icon">
                    <i class="fa-solid fa-user"></i>
                </div>
                <div class="popover-text">
                    <span class="title">الملف الشخصي</span>
                    <span class="sub">عرض وتعديل بياناتك</span>
                </div>
                <i class="fa-solid fa-chevron-left arrow"></i>
            </button>

            <button class="popover-item logout" @onclick="HandleLogoutClick">
                <div class="popover-icon-box logout-icon">
                    <i class="fa-solid fa-power-off"></i>
                </div>
                <div class="popover-text">
                    <span class="title">تسجيل الخروج</span>
                    <span class="sub">الخروج من الحساب بأمان</span>
                </div>
                <i class="fa-solid fa-chevron-left arrow"></i>
            </button>
        </div>
    </div>
}

<style>
    .bottom-nav {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        display: flex;
        justify-content: space-around;
        align-items: center;
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(20px);
        border-top: 1px solid rgba(0, 0, 0, 0.08);
        padding: 8px 0 max(8px, env(safe-area-inset-bottom));
        box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.08);
        z-index: 1000;
    }

    .nav-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        background: none;
        border: none;
        color: var(--text-muted);
        font-size: 0.7rem;
        font-weight: 600;
        padding: 8px 12px;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        border-radius: 12px;
        min-width: 70px;
    }

    .nav-item i {
        font-size: 1.4rem;
        transition: all 0.3s;
    }

    .nav-item.active {
        color: var(--theme-primary, #3b82f6);
    }

    .nav-item.active i {
        transform: scale(1.1);
    }

    .nav-item:active {
        transform: scale(0.95);
        background: rgba(59, 130, 246, 0.1);
    }

    /* Ripple effect */
    .nav-item::before {
        content: '';
        position: absolute;
        width: 100%;
        height: 100%;
        background: radial-gradient(circle, var(--theme-primary, #3b82f6) 0%, transparent 70%);
        opacity: 0;
        transition: opacity 0.3s;
        border-radius: 12px;
    }

    .nav-item:active::before {
        opacity: 0.2;
    }

    /* Marketplace Special Styling - Premium & Distinct */
    .marketplace-nav-btn {
        position: relative;
        overflow: visible !important;
    }

    .marketplace-nav-btn i {
        color: #f59e0b; /* Amber/Gold color */
        filter: drop-shadow(0 0 5px rgba(245, 158, 11, 0.5));
    }

    .marketplace-nav-btn span {
        color: #d97706;
        font-weight: 800 !important;
    }

    .store-icon-wrap {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        background: rgba(245, 158, 11, 0.1);
        border-radius: 12px;
        margin-bottom: 2px;
        border: 1px solid rgba(245, 158, 11, 0.2);
        transition: all 0.3s ease;
    }

    .marketplace-nav-btn:active .store-icon-wrap {
        transform: scale(1.2) rotate(10deg);
        background: rgba(245, 158, 11, 0.2);
    }

    /* Home Button Prominent Style */
    .home-nav-btn {
        margin-top: -30px;
        z-index: 10;
        background: none !important;
    }

    .home-icon-container {
        width: 54px;
        height: 54px;
        background: linear-gradient(135deg, #1d4ed8 0%, #2563eb 50%, #3b82f6 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 8px 20px rgba(37, 99, 235, 0.4);
        border: 4px solid white;
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .home-nav-btn.active .home-icon-container {
        transform: scale(1.1) translateY(-5px);
        box-shadow: 0 12px 25px rgba(37, 99, 235, 0.55);
    }

    .home-icon-container i {
        color: white !important;
        font-size: 1.5rem !important;
        filter: none !important;
    }

    .home-nav-btn span {
        margin-top: 2px;
        font-weight: 800 !important;
        color: #2563eb !important;
    }

    /* Safe area for notched devices */
    @@supports (padding: max(0px)) {
        .bottom-nav {
            padding-bottom: max(8px, env(safe-area-inset-bottom));
        }
    }

    .nav-item-account-group {
        display: flex;
        align-items: center;
        gap: 0;
    }

    .nav-avatar-wrapper {
        position: relative;
        width: 24px;
        height: 24px;
    }

    .nav-user-avatar {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        object-fit: cover;
        border: 1.5px solid var(--theme-primary, #3b82f6);
    }

    .online-dot-mini {
        position: absolute;
        bottom: -1px;
        right: -1px;
        width: 8px;
        height: 8px;
        background: #22c55e;
        border-radius: 50%;
        border: 1.5px solid white;
    }

    .logout-btn-mini {
        color: #ef4444 !important;
        min-width: 50px !important;
    }

    .logout-btn-mini i {
        font-size: 1.1rem !important;
    }

    /* ═══ User Dropdown Popover ═══ */
    .user-menu-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.25);
        backdrop-filter: blur(2px);
        -webkit-backdrop-filter: blur(2px);
        z-index: 1050;
    }

    .user-dropdown-popover {
        position: fixed;
        left: 14px;
        bottom: calc(var(--bottom-nav-height, 65px) + 12px);
        width: 250px;
        background: rgba(255, 255, 255, 0.98);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1.5px solid rgba(226, 232, 240, 0.9);
        border-radius: 20px;
        box-shadow: 0 16px 36px -4px rgba(15, 23, 42, 0.16), 0 0 0 1px rgba(0, 0, 0, 0.04);
        z-index: 1051;
        overflow: hidden;
        transform-origin: bottom left;
    }

    .animate-popover-in {
        animation: popoverIn 0.22s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @@keyframes popoverIn {
        from {
            opacity: 0;
            transform: translateY(10px) scale(0.95);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    .popover-header {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 14px;
        background: #f8fafc;
    }

    .popover-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid var(--theme-primary, #2563eb);
        flex-shrink: 0;
    }

    .popover-avatar-placeholder {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: #eff6ff;
        color: var(--theme-primary, #2563eb);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        flex-shrink: 0;
    }

    .popover-user-info {
        display: flex;
        flex-direction: column;
        overflow: hidden;
        text-align: right;
    }

    .popover-name {
        font-size: 13px;
        font-weight: 700;
        color: #0f172a;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .popover-badge {
        font-size: 10px;
        font-weight: 700;
        color: var(--theme-primary, #2563eb);
        background: #eff6ff;
        padding: 1px 8px;
        border-radius: 6px;
        width: fit-content;
        margin-top: 2px;
    }

    .popover-divider {
        height: 1px;
        background: #f1f5f9;
    }

    .popover-body {
        padding: 6px;
    }

    .popover-item {
        display: flex;
        align-items: center;
        gap: 10px;
        width: 100%;
        padding: 10px 12px;
        background: transparent;
        border: none;
        border-radius: 14px;
        cursor: pointer;
        transition: background 0.15s ease;
        text-align: right;
    }

    .popover-item:hover, .popover-item:active {
        background: #f8fafc;
    }

    .popover-item.logout:hover, .popover-item.logout:active {
        background: #fff5f5;
    }

    .popover-icon-box {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        flex-shrink: 0;
    }

    .popover-icon-box.profile-icon {
        background: #eff6ff;
        color: var(--theme-primary, #2563eb);
    }

    .popover-icon-box.logout-icon {
        background: #fef2f2;
        color: #ef4444;
    }

    .popover-text {
        display: flex;
        flex-direction: column;
        flex-grow: 1;
        text-align: right;
    }

    .popover-text .title {
        font-size: 13px;
        font-weight: 700;
        color: #0f172a;
    }

    .popover-item.logout .popover-text .title {
        color: #ef4444;
    }

    .popover-text .sub {
        font-size: 10px;
        color: #64748b;
    }

    .popover-item.logout .popover-text .sub {
        color: #f87171;
    }

    .popover-item .arrow {
        font-size: 11px;
        color: #cbd5e1;
    }

    .popover-item.logout .arrow {
        color: #fca5a5;
    }
</style>
@inject AuthenticationStateProvider AuthStateProvider
@code {
    private bool _disposed = false;

    protected override void OnInitialized()
    {
        State.OnChange += OnStateChange;
        Navigation.LocationChanged += HandleLocationChanged;
    }

    private async void OnStateChange()
    {
        if (_disposed) return;
        try { await InvokeAsync(StateHasChanged); }
        catch (ObjectDisposedException) { }
        catch (InvalidOperationException) { }
    }

    private async void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (_disposed) return;
        try { await InvokeAsync(StateHasChanged); }
        catch (ObjectDisposedException) { }
        catch (InvalidOperationException) { }
    }

    public void Dispose()
    {
        _disposed = true;
        State.OnChange -= OnStateChange;
        Navigation.LocationChanged -= HandleLocationChanged;
    }

    private string GetActiveClass(string path)
    {
        var uri = new Uri(Navigation.Uri);
        var currentPath = uri.AbsolutePath;
        
        if (path == "/")
            return currentPath == "/" ? "active" : "";
            
        return currentPath.StartsWith(path) ? "active" : "";
    }

    private void Navigate(string path)
    {
        // Preserve nativeapp/mobileapp params when navigating in mobile app
        if (State.IsNativeApp || State.IsMobileApp)
        {
            var separator = path.Contains('?') ? "&" : "?";
            var param = State.IsNativeApp ? "nativeapp=1" : "mobileapp=1";
            var dest = path.Contains('?') ? path : path;
            Navigation.NavigateTo(dest + separator + param, forceLoad: false);
        }
        else
        {
            Navigation.NavigateTo(path, forceLoad: false);
        }
    }

    private void NavigateToAuthOr(string path)
    {
        if (State.IsAuthenticated)
        {
            Navigate(path);
        }
        else
        {
            Navigate($"/login?returnUrl={Uri.EscapeDataString(path)}");
        }
    }

    private void ToggleMode()
    {
        State.IsProviderMode = !State.IsProviderMode;
        if (State.IsProviderMode)
            Navigate("/provider/dashboard");
        else
            Navigate("/");
    }

    private string GetFirstName(string fullName)
    {
        if (string.IsNullOrEmpty(fullName)) return "حسابي";
        return fullName.Split(' ')[0];
    }

    private bool isUserMenuOpen = false;

    private void ToggleUserMenu()
    {
        isUserMenuOpen = !isUserMenuOpen;
    }

    private void CloseUserMenu()
    {
        isUserMenuOpen = false;
    }

    private void HandleProfileClick()
    {
        isUserMenuOpen = false;
        Navigate("/profile");
    }

    private async Task HandleLogoutClick()
    {
        isUserMenuOpen = false;
        await HandleLogout();
    }

    private async Task HandleLogout()
    {
        await AuthService.Logout();
        Navigate("/login");
    }
}
