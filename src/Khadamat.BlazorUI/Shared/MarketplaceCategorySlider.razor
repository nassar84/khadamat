@using Khadamat.Application.DTOs
@using Khadamat.BlazorUI.Services
@inject ApiClient Api
@inject NavigationManager Navigation

<div class="market-categories-slider mb-4">
    <div class="d-flex align-items-center mb-3 px-1">
        <div class="section-icon me-2"><i class="fa-solid fa-grid-2 text-primary"></i></div>
        <h5 class="fw-bold mb-0">التصنيفات</h5>
    </div>
    
    <div class="d-flex gap-3 overflow-auto pb-2 scroll-hide">
        <div class="category-item @(SelectedId == null ? "active" : "")" @onclick="() => OnCategorySelected(null)">
            <div class="category-icon-box">
                <i class="fa-solid fa-border-all"></i>
            </div>
            <span class="category-label">الكل</span>
        </div>

        @if (Categories != null)
        {
            @foreach (var cat in Categories)
            {
                <div class="category-item @(SelectedId == cat.Id ? "active" : "")" @onclick="() => OnCategorySelected(cat.Id)">
                    <div class="category-icon-box">
                        @if (!string.IsNullOrEmpty(cat.ImageUrl))
                        {
                            <img src="@cat.ImageUrl" alt="@cat.Name" />
                        }
                        else if (!string.IsNullOrEmpty(cat.Icon))
                        {
                            <span class="cat-emoji">@cat.Icon</span>
                        }
                        else
                        {
                            <i class="fa-solid fa-tags"></i>
                        }
                    </div>
                    <span class="category-label">@cat.Name</span>
                </div>
            }
        }
    </div>
</div>

<style>
    .market-categories-slider {
        padding: 5px 0;
    }

    .scroll-hide::-webkit-scrollbar {
        display: none;
    }
    .scroll-hide {
        scrollbar-width: none;
        -ms-overflow-style: none;
    }

    .category-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        cursor: pointer;
        min-width: 80px;
        transition: all 0.2s;
        padding: 4px;
    }

    .category-icon-box {
        width: 60px;
        height: 60px;
        border-radius: 18px;
        background: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        color: #64748b;
        border: 1px solid #f1f5f9;
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
        overflow: hidden;
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .category-icon-box img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .cat-emoji {
        font-size: 1.8rem;
    }

    .category-label {
        font-size: 0.75rem;
        font-weight: 700;
        color: #475569;
        text-align: center;
        white-space: nowrap;
    }

    .category-item:hover .category-icon-box {
        transform: translateY(-5px) scale(1.05);
        border-color: var(--theme-primary, #3b82f6);
        color: var(--theme-primary, #3b82f6);
    }

    .category-item.active .category-icon-box {
        background: var(--theme-primary, #3b82f6);
        color: white;
        border-color: var(--theme-primary, #3b82f6);
        box-shadow: 0 10px 15px -3px rgba(59, 130, 246, 0.3);
    }

    .category-item.active .category-label {
        color: var(--theme-primary, #3b82f6);
    }
</style>

@code {
    [Parameter] public List<MarketplaceCategoryDto>? Categories { get; set; }
    [Parameter] public int? SelectedId { get; set; }
    [Parameter] public EventCallback<int?> OnSelected { get; set; }

    private async Task OnCategorySelected(int? id)
    {
        await OnSelected.InvokeAsync(id);
    }
}
