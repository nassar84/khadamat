<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0-android;net8.0-ios;net8.0-maccatalyst;net8.0-windows10.0.19041.0</TargetFrameworks>
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net8.0-android;net8.0-windows10.0.19041.0</TargetFrameworks>
        
        <OutputType>Exe</OutputType>
        <RootNamespace>Khadamat.MobileApp</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!-- Display name -->
        <ApplicationTitle>خدماوي</ApplicationTitle>

        <!-- App Identifier -->
        <ApplicationId>com.nassar84.khadamat</ApplicationId>

        <!-- Versions -->
        <ApplicationDisplayVersion>2.4</ApplicationDisplayVersion>
        <ApplicationVersion>16</ApplicationVersion>

        <!-- Required for C# Hot Reload -->
        <UseInterpreter Condition="'$(Configuration)' == 'Debug'">True</UseInterpreter>
        <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
        <AndroidUseFastDeployment>false</AndroidUseFastDeployment>
        <AndroidUseAssemblyStore>false</AndroidUseAssemblyStore>
        
        <!-- Fix for JAVA0000 R8/D8 Build errors -->
        <AndroidDexTool>d8</AndroidDexTool>
        <AndroidEnableMultiDex>true</AndroidEnableMultiDex>
        
        <!-- Debug Configurations (No optimizations) -->
        <UseR8 Condition="'$(Configuration)' == 'Debug'">false</UseR8>
        <AndroidLinkTool Condition="'$(Configuration)' == 'Debug'">d8</AndroidLinkTool>
        <AndroidLinkMode Condition="'$(Configuration)' == 'Debug'">None</AndroidLinkMode>

    </PropertyGroup>

    <!-- Release Configurations (AOT enabled for fast startup — fixes ANR) -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(TargetFramework)' == 'net8.0-android'">
        <!-- Single RID: arm64 covers 95%+ of modern Android devices, produces ONE APK -->
        <RuntimeIdentifier>android-arm64</RuntimeIdentifier>
        <JavaMaxHeapSize>4G</JavaMaxHeapSize>
        <!-- AOT: Pre-compiles .NET to native ARM → eliminates Mono JIT startup delay -->
        <RunAOTCompilation>true</RunAOTCompilation>
        <PublishTrimmed>true</PublishTrimmed>
        <TrimMode>partial</TrimMode>
        <!-- Keep R8 OFF to avoid XAGJS7001, but use SdkOnly linking for safe .NET AOT -->
        <UseR8>false</UseR8>
        <AndroidLinkMode>SdkOnly</AndroidLinkMode>
        <!-- Default package format is apk for website download, can be overridden with -p:AndroidPackageFormat=aab for Google Play -->
        <AndroidPackageFormat Condition="'$(AndroidPackageFormat)' == ''">apk</AndroidPackageFormat>
        <AndroidManagedSymbols>true</AndroidManagedSymbols>
        <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
        <AndroidUseAssemblyStore>false</AndroidUseAssemblyStore>
    </PropertyGroup>

    <PropertyGroup>

        <!-- Android -->
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
        
        <!-- iOS -->
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">12.0</SupportedOSPlatformVersion>
        
        <!-- Windows -->
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    </PropertyGroup>

    <ItemGroup>
        <!-- App Icon -->
        <MauiIcon Include="Resources\AppIcon\khadamat_icon.png" Color="#FFFFFF" ForegroundScale="0.65" />

        <!-- Splash Screen -->
        <MauiSplashScreen Include="Resources\Splash\khadamat_splash.png" Color="#0f172a" />

        <!-- Images -->
        <MauiImage Include="Resources\Images\*" />

        <!-- Custom Fonts -->
        <MauiFont Include="Resources\Fonts\*" />

        <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
        
        <!-- Google Services Json for Android - Disabled since FCM is not in use -->
        <!-- <GoogleServicesJson Condition="$(TargetFramework.Contains('-android'))" Include="Platforms\Android\google-services.json" /> -->
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Resources\Raw\appsettings.json" LogicalName="appsettings.json" />
        <EmbeddedResource Include="Resources\Raw\appsettings.Development.json" LogicalName="appsettings.Development.json" />
    </ItemGroup>

    <ItemGroup>
        <!-- MAUI Core -->
        <PackageReference Include="AutoMapper" Version="13.0.1" />
        <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="8.0.0" />
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="$(MauiVersion)" />
        
        <!-- Extensions -->
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.0" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
        
        <!-- Community Toolkit -->
        <PackageReference Include="CommunityToolkit.Maui" Version="8.0.1" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
        
        <!-- Storage -->
        <PackageReference Include="Plugin.Fingerprint" Version="2.1.5" />
        <PackageReference Include="Plugin.Maui.Audio" Version="3.1.1" />
        <PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
    </ItemGroup>

    <ItemGroup>
        <!-- Project References -->
        <ProjectReference Include="..\Khadamat.Application\Khadamat.Application.csproj" />
        <ProjectReference Include="..\Khadamat.Shared\Khadamat.Shared.csproj" />
    </ItemGroup>

    <Target Name="RenameAndCopyApk" AfterTargets="SignAndroidPackage;Publish" Condition="$(TargetFramework.Contains('-android'))">
        <PropertyGroup>
            <!-- Single signed APK path (arm64 build) -->
            <_SourceSignedApk>$(OutputPath)publish\com.nassar84.khadamat-Signed.apk</_SourceSignedApk>
            <_SourceSignedApk Condition="!Exists('$(_SourceSignedApk)')">$(OutputPath)com.nassar84.khadamat-Signed.apk</_SourceSignedApk>
            <_DestinationFolderMaged>D:\maged\Khadamat</_DestinationFolderMaged>
        </PropertyGroup>

        <!-- Copy single APK → output/publish folder -->
        <Copy SourceFiles="$(_SourceSignedApk)" DestinationFiles="$(OutputPath)publish\khadamat.apk" Condition="Exists('$(_SourceSignedApk)')" ContinueOnError="true" />

        <!-- Copy to WebAPI wwwroot/downloads for direct website download -->
        <Copy SourceFiles="$(_SourceSignedApk)" DestinationFiles="$(MSBuildProjectDirectory)\..\Khadamat.WebAPI\wwwroot\downloads\khadamat.apk" Condition="Exists('$(_SourceSignedApk)')" ContinueOnError="true" />

        <!-- Copy to D:\maged\Khadamat production folder -->
        <Copy SourceFiles="$(_SourceSignedApk)" DestinationFiles="$(_DestinationFolderMaged)\wwwroot\downloads\khadamat.apk" Condition="Exists('$(_DestinationFolderMaged)') and Exists('$(_SourceSignedApk)')" ContinueOnError="true" />

        <!-- Copy root convenience copy -->
        <Copy SourceFiles="$(_SourceSignedApk)" DestinationFiles="$(MSBuildProjectDirectory)\..\..\khadamat.apk" Condition="Exists('$(_SourceSignedApk)')" ContinueOnError="true" />

        <!-- Clean up stale signed artifacts from project root -->
        <Delete Files="$(MSBuildProjectDirectory)\..\..\com.nassar84.khadamat-Signed.apk" ContinueOnError="true" />
        <Delete Files="$(MSBuildProjectDirectory)\..\..\Khadamat-Signed.apk" ContinueOnError="true" />
        <Delete Files="$(MSBuildProjectDirectory)\..\..\Khadamawy-Signed.apk" ContinueOnError="true" />
        <Delete Files="$(MSBuildProjectDirectory)\..\..\Khadamawy.apk" ContinueOnError="true" />
        <Delete Files="$(MSBuildProjectDirectory)\..\..\خدماوى.apk" ContinueOnError="true" />
    </Target>

</Project>
