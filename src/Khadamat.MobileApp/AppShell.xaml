<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Khadamat.MobileApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Khadamat.MobileApp.Views"
    xmlns:viewModels="clr-namespace:Khadamat.MobileApp.ViewModels"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:DataType="viewModels:ShellViewModel"
    Title="{Binding AppName}"
    FlyoutBackgroundColor="#ffffff"
    FlyoutBehavior="Flyout"
    FlowDirection="RightToLeft">

    <Shell.Resources>
        <ResourceDictionary>
            <!-- Converters -->
            <toolkit:BoolToObjectConverter x:Key="BooleanToColorConverter" 
                                           TrueObject="#6366f1" 
                                           FalseObject="#94a3b8" />

            <Style TargetType="Label" Class="FlyoutItemLabel">
                <Setter Property="TextColor" Value="#0f172a" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="Margin" Value="10,0" />
            </Style>

            <!-- TabBar Styling for Glassmorphism-ish look -->
            <Style TargetType="TabBar">
                <Setter Property="Shell.TabBarBackgroundColor" Value="#F8FAFC" />
                <Setter Property="Shell.TabBarForegroundColor" Value="{DynamicResource Primary}" />
                <Setter Property="Shell.TabBarTitleColor" Value="{DynamicResource Primary}" />
                <Setter Property="Shell.TabBarUnselectedColor" Value="#94a3b8" />
            </Style>
        </ResourceDictionary>
    </Shell.Resources>

    <Shell.ItemTemplate>
        <DataTemplate x:DataType="BaseShellItem">
            <Grid HeightRequest="50" Padding="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Source="{Binding Icon}" HeightRequest="20" WidthRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="{Binding Title}" StyleClass="FlyoutItemLabel" />
            </Grid>
        </DataTemplate>
    </Shell.ItemTemplate>

    <Shell.MenuItemTemplate>
        <DataTemplate x:DataType="MenuItem">
            <Grid HeightRequest="50" Padding="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Source="{Binding IconImageSource}" HeightRequest="20" WidthRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="{Binding Text}" StyleClass="FlyoutItemLabel" />
            </Grid>
        </DataTemplate>
    </Shell.MenuItemTemplate>

    <Shell.TitleView>
        <Grid Padding="10,0" VerticalOptions="Fill">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            
            <HorizontalStackLayout Grid.Column="0" HorizontalOptions="Start" VerticalOptions="Center" Spacing="8">
                <HorizontalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="//HomePage" />
                </HorizontalStackLayout.GestureRecognizers>
                <Image Source="{Binding AppLogo}" HeightRequest="28" WidthRequest="28" Aspect="AspectFit"/>
                <Label Text="{Binding AppName}" FontSize="18" FontAttributes="Bold" TextColor="White" VerticalOptions="Center"/>
            </HorizontalStackLayout>
            
            <ImageButton Grid.Column="2" Source="{FontImageSource FontFamily=OpenSansRegular, Glyph='&#x1F3A8;', Color=White}"
                         HeightRequest="30" WidthRequest="30" Margin="5,0"
                         Command="{Binding ShowThemePickerCommand}" />

            <ImageButton Grid.Column="3" Source="{FontImageSource FontFamily=OpenSansRegular, Glyph='&#x1F514;', Color=White}"
                         HeightRequest="30" WidthRequest="30" Margin="5,0"
                         IsVisible="{Binding IsAuthenticated}"
                         Command="{Binding NavigateCommand}" CommandParameter="notifications" />
            
            <ImageButton Grid.Column="4" Source="{FontImageSource FontFamily=OpenSansRegular, Glyph='&#x1F50D;', Color=White}"
                         HeightRequest="30" WidthRequest="30" Margin="5,0"
                         Command="{Binding NavigateCommand}" CommandParameter="explore" />
        </Grid>
    </Shell.TitleView>

    <!-- Flyout Header -->
    <Shell.FlyoutHeader>
        <Grid HeightRequest="200">
            <!-- Premium Background (Mocking Gradient with overlapping boxes or just a solid rich color) -->
            <BoxView Color="{DynamicResource Primary}" />
            
            <Grid Padding="20">
                <!-- Guest Header -->
                <VerticalStackLayout VerticalOptions="Center" IsVisible="{Binding IsNotAuthenticated}" Spacing="12">
                    <Frame BackgroundColor="White" Padding="0" HeightRequest="64" WidthRequest="64" CornerRadius="32" HorizontalOptions="Center" HasShadow="True">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="//HomePage" />
                        </Frame.GestureRecognizers>
                        <Image Source="{Binding AppLogo}" Aspect="AspectFit" Margin="10"/>
                    </Frame>
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding AppName, StringFormat='مرحباً بك في {0}'}" TextColor="White" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center">
                             <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="//HomePage" />
                            </Label.GestureRecognizers>
                        </Label>
                        <Label Text="{Binding AppSlogan}" TextColor="#94a3b8" FontSize="12" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                    <Button Text="دخول / تسجيل" Command="{Binding NavigateCommand}" CommandParameter="profile" 
                            BackgroundColor="{DynamicResource Primary}" TextColor="White" CornerRadius="25" FontAttributes="Bold" HeightRequest="45" Padding="25,0" Margin="0,10,0,0">
                        <Button.Shadow>
                            <Shadow Brush="#000000" Offset="0,4" Radius="8" Opacity="0.3" />
                        </Button.Shadow>
                    </Button>
                </VerticalStackLayout>
                
                <!-- Authenticated Header -->
                <VerticalStackLayout VerticalOptions="Center" IsVisible="{Binding IsAuthenticated}" Spacing="10">
                    <Frame Padding="2" HeightRequest="74" WidthRequest="74" CornerRadius="37" HorizontalOptions="Center" BackgroundColor="{DynamicResource Primary}" HasShadow="True">
                        <Image Source="{Binding UserImage}" Aspect="AspectFill">
                            <Image.Clip><EllipseGeometry Center="35,35" RadiusX="35" RadiusY="35" /></Image.Clip>
                        </Image>
                    </Frame>
                    <Label Text="{Binding UserName}" TextColor="White" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center"/>
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="2">
                        <Label Text="⭐" TextColor="#f59e0b" FontSize="12"/>
                        <Label Text="⭐" TextColor="#f59e0b" FontSize="12"/>
                        <Label Text="⭐" TextColor="#f59e0b" FontSize="12"/>
                        <Label Text="⭐" TextColor="#f59e0b" FontSize="12"/>
                        <Label Text="⭐" TextColor="#f59e0b" FontSize="12"/>
                    </HorizontalStackLayout>
                    <Button Text="الملف الشخصي" BackgroundColor="{DynamicResource Primary}" Opacity="0.8" TextColor="White" FontSize="12" CornerRadius="12" Padding="15,0" HeightRequest="30" 
                            Command="{Binding NavigateCommand}" CommandParameter="profile" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Grid>
        </Grid>
    </Shell.FlyoutHeader>

    <!-- Flyout Footer for a Premium Look -->
    <Shell.FlyoutFooter>
        <VerticalStackLayout Padding="20" IsVisible="{Binding IsAuthenticated}" BackgroundColor="#ffffff">
            <BoxView HeightRequest="1" Color="#f1f5f9" Margin="0,0,0,15" />
            <Button Text="تسجيل الخروج" 
                    Command="{Binding NavigateCommand}" 
                    CommandParameter="logout"
                    BackgroundColor="#fff1f2"
                    TextColor="#e11d48"
                    FontAttributes="Bold"
                    CornerRadius="25"
                    HeightRequest="50"
                    ImageSource="{FontImageSource FontFamily=OpenSansRegular, Glyph='&#x1F6AA;', Color='#e11d48'}"
                    ContentLayout="Right,12">
                <Button.Shadow>
                    <Shadow Brush="#000000" Offset="0,2" Radius="5" Opacity="0.1" />
                </Button.Shadow>
            </Button>
            <Label Text="نسخة 1.0.0" FontSize="10" TextColor="#94a3b8" HorizontalOptions="Center" Margin="0,10,0,0" />
        </VerticalStackLayout>
    </Shell.FlyoutFooter>

    <TabBar x:Name="MainTabBar">
        <!-- 1. Categories (th-large) - \uf009 -->
        <Tab Title="الأقسام" Route="CategoriesPage" IsVisible="{Binding IsClientMode}">
            <Tab.Icon><FontImageSource FontFamily="OpenSansRegular" Glyph="&#x1F4C2;" Color="{Binding IsClientMode, Converter={StaticResource BooleanToColorConverter}}" /></Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:CategoriesPage}" />
        </Tab>

        <!-- 2. Marketplace (store) - \uf54e -->
        <Tab Title="المتجر" Route="MarketplacePage" IsVisible="{Binding IsClientMode}">
            <Tab.Icon><FontImageSource FontFamily="OpenSansRegular" Glyph="&#x1F6CD;" Color="#f59e0b" /></Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:MarketplacePage}" />
        </Tab>

        <!-- 3. Home (house) - \uf015 (Prominent style in MAUI via contrast) -->
        <Tab Title="الرئيسية" Route="HomePage">
            <Tab.Icon><FontImageSource FontFamily="OpenSansRegular" Glyph="&#x1F3E0;" Color="#6366f1" /></Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:HomePage}" />
        </Tab>

        <!-- 4. Client: Favorites (heart) - \uf004 | Provider: My Services (briefcase) - \uf0b1 -->
        <Tab Title="المفضلة" Route="FavoritesPage" IsVisible="{Binding IsClientMode}">
            <Tab.Icon><FontImageSource FontFamily="OpenSansRegular" Glyph="&#x2764;" Color="#ef4444" /></Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:FavoritesPage}" />
        </Tab>
        
        <Tab Title="خدماتي" Route="MyServicesPage" IsVisible="{Binding IsProviderMode}">
            <Tab.Icon><FontImageSource FontFamily="OpenSansRegular" Glyph="&#x1F4BC;" Color="#6366f1" /></Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:MyServicesPage}" />
        </Tab>

        <!-- 5. Profile/Account -->
        <Tab Title="{Binding UserTitle}" Route="ProfileTab">
            <Tab.Icon>
                <FontImageSource FontFamily="OpenSansRegular" Glyph="&#x1F464;" Color="#64748b" />
            </Tab.Icon>
            <ShellContent Title="الحساب" ContentTemplate="{DataTemplate views:ProfilePage}" IsVisible="{Binding IsAuthenticated}" />
            <ShellContent Title="دخول" ContentTemplate="{DataTemplate views:LoginPage}" IsVisible="{Binding IsNotAuthenticated}" />
        </Tab>
    </TabBar>

    <!-- Side Menu (Flyout) Navigation Groups -->
    
    <!-- ==== الاستكشاف ==== -->
    <FlyoutItem Title="الرئيسية" FlyoutDisplayOptions="AsSingleItem">
        <FlyoutItem.Icon><FontImageSource FontFamily="OpenSansRegular" Glyph="&#x1F3E0;" Color="#0f172a" /></FlyoutItem.Icon>
        <ShellContent ContentTemplate="{DataTemplate views:HomePage}" />
    </FlyoutItem>

    <FlyoutItem Title="التصنيفات" FlyoutDisplayOptions="AsSingleItem">
        <FlyoutItem.Icon><FontImageSource FontFamily="OpenSansRegular" Glyph="&#x1F4C2;" Color="#0f172a" /></FlyoutItem.Icon>
        <ShellContent ContentTemplate="{DataTemplate views:CategoriesPage}" />
    </FlyoutItem>

    <FlyoutItem Title="المتجر" FlyoutDisplayOptions="AsSingleItem">
        <FlyoutItem.Icon><FontImageSource FontFamily="OpenSansRegular" Glyph="&#x1F6CD;" Color="#0f172a" /></FlyoutItem.Icon>
        <ShellContent ContentTemplate="{DataTemplate views:MarketplacePage}" />
    </FlyoutItem>

    <FlyoutItem Title="أضف إعلان" FlyoutDisplayOptions="AsSingleItem">
        <FlyoutItem.Icon><FontImageSource FontFamily="OpenSansRegular" Glyph="&#x2795;" Color="#0f172a" /></FlyoutItem.Icon>
        <ShellContent ContentTemplate="{DataTemplate views:PostServicePage}" />
    </FlyoutItem>

    <!-- ==== نشاطاتي (Visible Only if Authenticated) ==== -->
    <FlyoutItem Title="إعلاناتي" IsVisible="{Binding IsAuthenticated}" FlyoutDisplayOptions="AsSingleItem">
        <FlyoutItem.Icon><FontImageSource FontFamily="OpenSansRegular" Glyph="&#x1F4BC;" Color="#0f172a" /></FlyoutItem.Icon>
        <ShellContent ContentTemplate="{DataTemplate views:MyServicesPage}" />
    </FlyoutItem>

    <FlyoutItem Title="خدماتي" IsVisible="{Binding IsAuthenticated}" FlyoutDisplayOptions="AsSingleItem">
        <FlyoutItem.Icon><FontImageSource FontFamily="OpenSansRegular" Glyph="&#x2705;" Color="#0f172a" /></FlyoutItem.Icon>
        <ShellContent ContentTemplate="{DataTemplate views:ServicesPage}" />
    </FlyoutItem>

    <FlyoutItem Title="المفضلة" IsVisible="{Binding IsAuthenticated}" FlyoutDisplayOptions="AsSingleItem">
        <FlyoutItem.Icon><FontImageSource FontFamily="OpenSansRegular" Glyph="&#x2764;" Color="#0f172a" /></FlyoutItem.Icon>
        <ShellContent ContentTemplate="{DataTemplate views:FavoritesPage}" />
    </FlyoutItem>

    <FlyoutItem Title="الرسائل" IsVisible="{Binding IsAuthenticated}" FlyoutDisplayOptions="AsSingleItem">
        <FlyoutItem.Icon><FontImageSource FontFamily="OpenSansRegular" Glyph="&#x1F4AC;" Color="#0f172a" /></FlyoutItem.Icon>
        <ShellContent ContentTemplate="{DataTemplate views:MessagesPage}" />
    </FlyoutItem>

    <!-- ==== الإدارة (Visible Only if Admin) ==== -->
    <FlyoutItem Title="لوحة المدير" IsVisible="{Binding IsAdmin}" FlyoutDisplayOptions="AsSingleItem">
        <FlyoutItem.Icon><FontImageSource FontFamily="OpenSansRegular" Glyph="&#x1F6E1;" Color="#0f172a" /></FlyoutItem.Icon>
        <ShellContent ContentTemplate="{DataTemplate views:AdminPage}" />
    </FlyoutItem>

    <FlyoutItem Title="إدارة الإعلانات" IsVisible="{Binding IsAdmin}" FlyoutDisplayOptions="AsSingleItem">
        <FlyoutItem.Icon><FontImageSource FontFamily="OpenSansRegular" Glyph="&#x1F4DC;" Color="#0f172a" /></FlyoutItem.Icon>
        <ShellContent ContentTemplate="{DataTemplate views:AdminAdsPage}" />
    </FlyoutItem>

    <!-- Visual Separator -->
    <MenuItem Text="━━━━━━━━━━━━" IsEnabled="False" />

    <!-- ==== النظام ==== -->
    <FlyoutItem Title="الإعدادات" IsVisible="{Binding IsAuthenticated}" FlyoutDisplayOptions="AsSingleItem">
        <FlyoutItem.Icon><FontImageSource FontFamily="OpenSansRegular" Glyph="&#x2699;" Color="#0f172a" /></FlyoutItem.Icon>
        <ShellContent ContentTemplate="{DataTemplate views:SettingsPage}" />
    </FlyoutItem>

    <FlyoutItem Title="الدعم والمساعدة" FlyoutDisplayOptions="AsSingleItem">
        <FlyoutItem.Icon><FontImageSource FontFamily="OpenSansRegular" Glyph="&#x1F198;" Color="#0f172a" /></FlyoutItem.Icon>
        <ShellContent ContentTemplate="{DataTemplate views:SupportPage}" />
    </FlyoutItem>

    <FlyoutItem Title="الشروط والأحكام" FlyoutDisplayOptions="AsSingleItem">
        <FlyoutItem.Icon><FontImageSource FontFamily="OpenSansRegular" Glyph="&#x1F4DC;" Color="#0f172a" /></FlyoutItem.Icon>
        <ShellContent ContentTemplate="{DataTemplate views:TermsPage}" />
    </FlyoutItem>

    <MenuItem Text="تحديث التطبيق" Command="{Binding RefreshCommand}" IconImageSource="{FontImageSource FontFamily=OpenSansRegular, Glyph='&#x1f504;', Color='#0f172a'}" />
    
    <!-- Logout is in FlyoutFooter -->

</Shell>
