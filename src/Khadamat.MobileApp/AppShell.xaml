<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Khadamat.MobileApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Khadamat.MobileApp.Views"
    xmlns:viewModels="clr-namespace:Khadamat.MobileApp.ViewModels"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:DataType="viewModels:ShellViewModel"
    Title="{Binding AppName}"
    FlyoutBackgroundColor="#ffffff"
    FlyoutBehavior="Flyout"
    FlowDirection="RightToLeft">

    <Shell.Resources>
        <ResourceDictionary>
            <!-- Converters -->
            <toolkit:BoolToObjectConverter x:Key="BooleanToColorConverter" 
                                           TrueObject="#6366f1" 
                                           FalseObject="#94a3b8" />

            <Style TargetType="Label" Class="FlyoutItemLabel">
                <Setter Property="TextColor" Value="#0f172a" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="Margin" Value="10,0" />
            </Style>

            <!-- TabBar Styling for Glassmorphism-ish look -->
            <Style TargetType="TabBar">
                <Setter Property="Shell.TabBarBackgroundColor" Value="#F8FAFC" />
                <Setter Property="Shell.TabBarForegroundColor" Value="{DynamicResource Primary}" />
                <Setter Property="Shell.TabBarTitleColor" Value="{DynamicResource Primary}" />
                <Setter Property="Shell.TabBarUnselectedColor" Value="#94a3b8" />
            </Style>
        </ResourceDictionary>
    </Shell.Resources>

    <Shell.ItemTemplate>
        <DataTemplate x:DataType="BaseShellItem">
            <Grid HeightRequest="50" Padding="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Source="{Binding Icon}" HeightRequest="20" WidthRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="{Binding Title}" StyleClass="FlyoutItemLabel" />
            </Grid>
        </DataTemplate>
    </Shell.ItemTemplate>

    <Shell.MenuItemTemplate>
        <DataTemplate x:DataType="MenuItem">
            <Grid HeightRequest="50" Padding="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Source="{Binding IconImageSource}" HeightRequest="20" WidthRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="{Binding Text}" StyleClass="FlyoutItemLabel" />
            </Grid>
        </DataTemplate>
    </Shell.MenuItemTemplate>

    <Shell.TitleView>
        <Grid Padding="10,0" VerticalOptions="Fill" FlowDirection="RightToLeft">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            
            <HorizontalStackLayout Grid.Column="0" HorizontalOptions="Start" VerticalOptions="Center" Spacing="8">
                <HorizontalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="home" />
                </HorizontalStackLayout.GestureRecognizers>
                <Image Source="{Binding AppLogo}" HeightRequest="28" WidthRequest="28" Aspect="AspectFit"/>
                <Label Text="{Binding AppName}" FontSize="18" FontAttributes="Bold" TextColor="White" VerticalOptions="Center"/>
            </HorizontalStackLayout>
            
            <!-- User Profile Avatar in Top Bar (Clickable) -->
            <Border Grid.Column="1" HorizontalOptions="End" VerticalOptions="Center"
                    HeightRequest="32" WidthRequest="32" StrokeThickness="1.5" Stroke="White"
                    Margin="0,0,5,0"
                    IsVisible="{Binding IsAuthenticated}">
                <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="profile" />
                </Border.GestureRecognizers>
                <Image Source="{Binding UserImage}" Aspect="AspectFill" HeightRequest="32" WidthRequest="32" />
            </Border>

            <ImageButton Grid.Column="2" Source="{FontImageSource FontFamily=OpenSansRegular, Glyph='&#x1F3A8;', Color=White}"
                         HeightRequest="30" WidthRequest="30" Margin="5,0"
                         Command="{Binding ShowThemePickerCommand}" />

            <ImageButton Grid.Column="3" Source="{FontImageSource FontFamily=OpenSansRegular, Glyph='&#x1F514;', Color=White}"
                         HeightRequest="30" WidthRequest="30" Margin="5,0"
                         IsVisible="{Binding IsAuthenticated}"
                         Command="{Binding NavigateCommand}" CommandParameter="notifications" />
            
            <ImageButton Grid.Column="4" Source="{FontImageSource FontFamily=OpenSansRegular, Glyph='&#x1F50D;', Color=White}"
                         HeightRequest="30" WidthRequest="30" Margin="5,0"
                         Command="{Binding NavigateCommand}" CommandParameter="search" />
        </Grid>
    </Shell.TitleView>

    <!-- Full Custom Flyout Content -->
    <Shell.FlyoutContent>
        <ScrollView BackgroundColor="White" FlowDirection="RightToLeft">
            <Grid RowDefinitions="Auto,*,Auto" MinimumHeightRequest="600">

                <!-- ═══ TOP HEADER ═══ -->
                <Grid Grid.Row="0">

                    <!-- GUEST Header: White bg, logo + app name -->
                    <VerticalStackLayout IsVisible="{Binding IsGuest}" Padding="20,50,20,10" Spacing="0">
                        <!-- Logo + App Name -->
                        <HorizontalStackLayout Spacing="10" VerticalOptions="Center" HorizontalOptions="Start">
                            <HorizontalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="home" />
                            </HorizontalStackLayout.GestureRecognizers>
                            <Image Source="{Binding AppLogo}" HeightRequest="32" WidthRequest="32" Aspect="AspectFit" VerticalOptions="Center" />
                            <Label Text="{Binding AppName}" FontSize="24" FontAttributes="Bold"
                                   TextColor="{DynamicResource Primary}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <BoxView HeightRequest="1" Color="#f1f5f9" Margin="0,20,0,0" />
                        <!-- Section label -->
                        <Label Text="{Binding AppName, StringFormat='إكتشف {0}'}"
                               FontSize="12" TextColor="#94a3b8" Margin="0,16,0,10" />
                        <!-- Home Button (filled, active) -->
                        <Border BackgroundColor="{DynamicResource Primary}" StrokeThickness="0" Margin="0,0,0,8">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="home" />
                            </Border.GestureRecognizers>
                            <Grid Padding="16,13" ColumnDefinitions="*,Auto">
                                <Label Text="الرئيسية" TextColor="White" FontSize="15" FontAttributes="Bold" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="🏠" FontSize="18" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- AUTHENTICATED Header: Gradient with user info & role badge -->
                    <Grid IsVisible="{Binding IsAuthenticated}">
                        <!-- Gradient Background -->
                        <Border StrokeThickness="0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="0,0,0,32" /></Border.StrokeShape>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="{DynamicResource Primary}" Offset="0.0" />
                                    <GradientStop Color="#a855f7" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentView HeightRequest="155" />
                        </Border>

                        <!-- Overlay Content -->
                        <Grid Padding="20,45,20,15" ColumnDefinitions="*,Auto">
                            <!-- Name + Welcome + Role Badge -->
                            <VerticalStackLayout VerticalOptions="Center" Spacing="4">
                                <Label Text="مرحباً بك،" TextColor="White" FontSize="13" Opacity="0.85" />
                                <Label Text="{Binding UserName}" TextColor="White" FontSize="18" FontAttributes="Bold" />
                                
                                <!-- Role Badge & Mode Switch -->
                                <HorizontalStackLayout Spacing="6" Margin="0,4,0,0">
                                    <Border BackgroundColor="#3b82f6" StrokeThickness="0" Padding="8,2" IsVisible="{Binding IsClient}">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                        <Label Text="عميل 🌟" TextColor="White" FontSize="11" FontAttributes="Bold" />
                                    </Border>
                                    
                                    <Border BackgroundColor="#f59e0b" StrokeThickness="0" Padding="8,2" IsVisible="{Binding IsProviderActive}">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                        <Label Text="صاحب خدمة ⭐️" TextColor="White" FontSize="11" FontAttributes="Bold" />
                                    </Border>

                                    <Border BackgroundColor="#ef4444" StrokeThickness="0" Padding="8,2" IsVisible="{Binding IsAdminActive}">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                        <Label Text="إدارة النظام 🛡️" TextColor="White" FontSize="11" FontAttributes="Bold" />
                                    </Border>
                                    
                                    <!-- Mode Toggle button for Providers -->
                                    <Border BackgroundColor="White" StrokeThickness="0" Padding="8,2" IsVisible="{Binding IsProvider}">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ToggleModeCommand}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="تبديل الوضع 🔄" TextColor="{DynamicResource Primary}" FontSize="11" FontAttributes="Bold" />
                                    </Border>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                            
                            <!-- Avatar (square rounded) -->
                            <Border Grid.Column="1" WidthRequest="60" HeightRequest="60"
                                    StrokeThickness="3" Stroke="White">
                                <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                <Border.Shadow><Shadow Brush="#000000" Offset="0,6" Radius="16" Opacity="0.2" /></Border.Shadow>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="profile" />
                                </Border.GestureRecognizers>
                                <Image Source="{Binding UserImage}" Aspect="AspectFill" />
                            </Border>
                        </Grid>
                    </Grid>

                </Grid>

                <!-- ═══ MIDDLE CONTENT (ROLE-TAILORED) ═══ -->
                <VerticalStackLayout Grid.Row="1" Padding="20,0" Spacing="0">

                    <!-- ────────────────────────────────────────── -->
                    <!-- 1. GUEST CONTENT                           -->
                    <!-- ────────────────────────────────────────── -->
                    <VerticalStackLayout IsVisible="{Binding IsGuest}" Spacing="0">
                        <!-- Join Card -->
                        <Border BackgroundColor="White" StrokeThickness="1" Stroke="#f1f5f9"
                                Padding="20" Margin="0,8,0,16">
                            <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                            <Border.Shadow><Shadow Brush="#000000" Offset="0,4" Radius="12" Opacity="0.06" /></Border.Shadow>
                            <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                                <Border BackgroundColor="#f3f0ff" StrokeThickness="0" WidthRequest="55" HeightRequest="55" HorizontalOptions="Center">
                                    <Border.StrokeShape><Ellipse /></Border.StrokeShape>
                                    <Label Text="👤" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label Text="انضم إلينا الآن" FontSize="17" FontAttributes="Bold" TextColor="#0f172a" HorizontalOptions="Center" />
                                <Label Text="سجل دخولك لتتمكن من طلب الخدمات والتواصل مع المزودين"
                                       FontSize="12" TextColor="#64748b" HorizontalOptions="Center"
                                       HorizontalTextAlignment="Center" LineHeight="1.4" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,4,0,0">
                                    <Border Grid.Column="0" BackgroundColor="{DynamicResource Primary}" StrokeThickness="0">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="login" />
                                        </Border.GestureRecognizers>
                                        <Label Text="دخول" TextColor="White" FontAttributes="Bold" FontSize="14" HorizontalOptions="Center" Padding="0,11" />
                                    </Border>
                                    <Border Grid.Column="1" BackgroundColor="White" StrokeThickness="1.5" Stroke="{DynamicResource Primary}">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="register" />
                                        </Border.GestureRecognizers>
                                        <Label Text="حساب جديد" TextColor="{DynamicResource Primary}" FontAttributes="Bold" FontSize="13" HorizontalOptions="Center" Padding="0,11" />
                                    </Border>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Guest Links -->
                        <Label Text="استكشاف المنصة" FontSize="12" TextColor="#94a3b8" FontAttributes="Bold" Margin="8,0,8,8" />
                        
                        <Grid Padding="12,13" ColumnDefinitions="*,Auto" BackgroundColor="#fafbff" Margin="0,0,0,2">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="services" />
                            </Grid.GestureRecognizers>
                            <Label Text="استكشاف الخدمات" TextColor="#1e293b" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="🔍" FontSize="18" VerticalOptions="Center" />
                        </Grid>

                        <Grid Padding="12,13" ColumnDefinitions="*,Auto" BackgroundColor="#fafbff" Margin="0,0,0,2">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="categories" />
                            </Grid.GestureRecognizers>
                            <Label Text="الأقسام والتصنيفات" TextColor="#1e293b" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="📂" FontSize="18" VerticalOptions="Center" />
                        </Grid>

                        <!-- Join as Provider Button -->
                        <Border BackgroundColor="#eff6ff" StrokeThickness="1" Stroke="#bfdbfe" Margin="0,4,0,4">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="provider/apply" />
                            </Border.GestureRecognizers>
                            <Grid Padding="14,12" ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="اعرض خدماتك معنا 💼" TextColor="#1d4ed8" FontSize="14" FontAttributes="Bold" />
                                    <Label Text="انضم كصاحب مهنة وزود دخلك" TextColor="#60a5fa" FontSize="11" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="←" TextColor="#1d4ed8" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <Grid Padding="12,13" ColumnDefinitions="*,Auto" Margin="0,0,0,2">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="feed" />
                            </Grid.GestureRecognizers>
                            <Label Text="آخر التحديثات" TextColor="#1e293b" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="📢" FontSize="18" VerticalOptions="Center" />
                        </Grid>

                        <Grid Padding="12,13" ColumnDefinitions="*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="contact" />
                            </Grid.GestureRecognizers>
                            <Label Text="تواصل معنا والدعم" TextColor="#1e293b" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="🎧" FontSize="18" VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>

                    <!-- ────────────────────────────────────────── -->
                    <!-- 2. CLIENT CONTENT                          -->
                    <!-- ────────────────────────────────────────── -->
                    <VerticalStackLayout IsVisible="{Binding IsClient}" Spacing="0" Margin="0,16,0,0">
                        <!-- Provider Banner for Clients -->
                        <Border BackgroundColor="#f5f3ff" StrokeThickness="1" Stroke="#ddd6fe" Margin="0,0,0,12">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="provider/apply" />
                            </Border.GestureRecognizers>
                            <Grid Padding="12,11" ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="صاحب مهنة أو حرفة؟ 💼" TextColor="{DynamicResource Primary}" FontSize="13" FontAttributes="Bold" />
                                    <Label Text="اعرض خدماتك الآن وزود دخلك معنا" TextColor="#7c3aed" FontSize="11" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="ابدأ الآن ←" TextColor="{DynamicResource Primary}" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <!-- Section: نشاطي -->
                        <Label Text="نشاطي" FontSize="12" TextColor="#94a3b8" FontAttributes="Bold" Margin="8,0,8,8" />
                        
                        <Grid Padding="12,13" ColumnDefinitions="*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="my-requests" />
                            </Grid.GestureRecognizers>
                            <Label Text="طلباتي" TextColor="#1e293b" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="📋" FontSize="18" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="#f1f5f9" />

                        <Grid Padding="12,13" ColumnDefinitions="*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="messages" />
                            </Grid.GestureRecognizers>
                            <Label Text="رسائلي" TextColor="#1e293b" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="💬" FontSize="18" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="#f1f5f9" />

                        <Grid Padding="12,13" ColumnDefinitions="*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="favorites" />
                            </Grid.GestureRecognizers>
                            <Label Text="المفضلة" TextColor="#1e293b" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="❤️" FontSize="18" VerticalOptions="Center" TextColor="#ef4444" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="#f1f5f9" />

                        <Grid Padding="12,13" ColumnDefinitions="*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="notifications" />
                            </Grid.GestureRecognizers>
                            <Label Text="الإشعارات" TextColor="#1e293b" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="🔔" FontSize="18" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="8" Color="#f8fafc" Margin="0,8,0,8" />

                        <!-- Section: استكشاف -->
                        <Label Text="استكشاف" FontSize="12" TextColor="#94a3b8" FontAttributes="Bold" Margin="8,0,8,8" />
                        <Grid Padding="12,13" ColumnDefinitions="*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="home" />
                            </Grid.GestureRecognizers>
                            <Label Text="الرئيسية" TextColor="#1e293b" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="🏠" FontSize="18" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="#f1f5f9" />

                        <Grid Padding="12,13" ColumnDefinitions="*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="services" />
                            </Grid.GestureRecognizers>
                            <Label Text="الخدمات" TextColor="#1e293b" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="🔍" FontSize="18" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="#f1f5f9" />

                        <Grid Padding="12,13" ColumnDefinitions="*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="feed" />
                            </Grid.GestureRecognizers>
                            <Label Text="آخر التحديثات" TextColor="#1e293b" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="📢" FontSize="18" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="8" Color="#f8fafc" Margin="0,8,0,8" />

                        <!-- Section: الحساب والدعم -->
                        <Label Text="الحساب والدعم" FontSize="12" TextColor="#94a3b8" FontAttributes="Bold" Margin="8,0,8,8" />
                        <Grid Padding="12,13" ColumnDefinitions="*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="profile" />
                            </Grid.GestureRecognizers>
                            <Label Text="الملف الشخصي" TextColor="#1e293b" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="👤" FontSize="18" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="#f1f5f9" />

                        <Grid Padding="12,13" ColumnDefinitions="*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="contact" />
                            </Grid.GestureRecognizers>
                            <Label Text="تواصل معنا" TextColor="#1e293b" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="🎧" FontSize="18" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="#f1f5f9" />

                        <!-- Logout -->
                        <Grid Padding="12,14" ColumnDefinitions="*,Auto" Margin="0,8,0,0" BackgroundColor="#fff1f2">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="logout" />
                            </Grid.GestureRecognizers>
                            <Label Text="تسجيل الخروج" TextColor="#e11d48" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="🚪" FontSize="18" VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>

                    <!-- ────────────────────────────────────────── -->
                    <!-- 3. SERVICE PROVIDER CONTENT                -->
                    <!-- ────────────────────────────────────────── -->
                    <VerticalStackLayout IsVisible="{Binding IsProviderActive}" Spacing="0" Margin="0,16,0,0">
                        <!-- Mode Switch Banner -->
                        <Border BackgroundColor="#e0e7ff" StrokeThickness="0" Margin="0,0,0,12" Padding="14,10">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleModeCommand}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="أنت في وضع صاحب الخدمة (اضغط للتبديل كعميل) 🔄" TextColor="{DynamicResource Primary}" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="تبديل" TextColor="{DynamicResource Primary}" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <!-- Section: إدارة الأعمال -->
                        <Label Text="إدارة الأعمال والخدمات" FontSize="12" TextColor="#94a3b8" FontAttributes="Bold" Margin="8,0,8,8" />
                        
                        <Grid Padding="12,13" ColumnDefinitions="*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="provider/dashboard" />
                            </Grid.GestureRecognizers>
                            <Label Text="لوحة التحكم" TextColor="#1e293b" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="📊" FontSize="18" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="#f1f5f9" />

                        <Grid Padding="12,13" ColumnDefinitions="*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="my-services" />
                            </Grid.GestureRecognizers>
                            <Label Text="خدماتي الحالية" TextColor="#1e293b" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="💼" FontSize="18" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="#f1f5f9" />

                        <Grid Padding="12,13" ColumnDefinitions="*,Auto" BackgroundColor="#ecfdf5">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="provider/create-request" />
                            </Grid.GestureRecognizers>
                            <Label Text="أضف خدمة جديدة ➕" TextColor="#059669" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="✨" FontSize="18" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="#f1f5f9" />

                        <Grid Padding="12,13" ColumnDefinitions="*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="provider/incoming-requests" />
                            </Grid.GestureRecognizers>
                            <Label Text="طلبات العملاء الواردة" TextColor="#1e293b" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="📥" FontSize="18" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="#f1f5f9" />

                        <Grid Padding="12,13" ColumnDefinitions="*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="provider/subscription" />
                            </Grid.GestureRecognizers>
                            <Label Text="باقتي واشتراكي" TextColor="#1e293b" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="💳" FontSize="18" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="8" Color="#f8fafc" Margin="0,8,0,8" />

                        <!-- Section: نشاطي كعميل (روابط العميل لصاحب الخدمة) -->
                        <Label Text="نشاطي كعميل" FontSize="12" TextColor="#94a3b8" FontAttributes="Bold" Margin="8,0,8,8" />
                        <Grid Padding="12,13" ColumnDefinitions="*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="user/my-requests" />
                            </Grid.GestureRecognizers>
                            <Label Text="طلباتي المرسلة (كمستخدم)" TextColor="#1e293b" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="📋" FontSize="18" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="#f1f5f9" />

                        <Grid Padding="12,13" ColumnDefinitions="*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="favorites" />
                            </Grid.GestureRecognizers>
                            <Label Text="المفضلة" TextColor="#1e293b" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="❤️" FontSize="18" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="#f1f5f9" />

                        <Grid Padding="12,13" ColumnDefinitions="*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="services" />
                            </Grid.GestureRecognizers>
                            <Label Text="تصفح واستكشاف الخدمات" TextColor="#1e293b" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="🔍" FontSize="18" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="8" Color="#f8fafc" Margin="0,8,0,8" />

                        <!-- Section: التواصل -->
                        <Label Text="التواصل" FontSize="12" TextColor="#94a3b8" FontAttributes="Bold" Margin="8,0,8,8" />
                        <Grid Padding="12,13" ColumnDefinitions="*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="messages" />
                            </Grid.GestureRecognizers>
                            <Label Text="المحادثات" TextColor="#1e293b" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="💬" FontSize="18" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="#f1f5f9" />

                        <Grid Padding="12,13" ColumnDefinitions="*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="notifications" />
                            </Grid.GestureRecognizers>
                            <Label Text="الإشعارات" TextColor="#1e293b" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="🔔" FontSize="18" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="8" Color="#f8fafc" Margin="0,8,0,8" />

                        <!-- Section: الحساب والإعدادات -->
                        <Label Text="الحساب والدعم" FontSize="12" TextColor="#94a3b8" FontAttributes="Bold" Margin="8,0,8,8" />
                        <Grid Padding="12,13" ColumnDefinitions="*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="profile" />
                            </Grid.GestureRecognizers>
                            <Label Text="الملف الشخصي" TextColor="#1e293b" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="👤" FontSize="18" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="#f1f5f9" />

                        <Grid Padding="12,13" ColumnDefinitions="*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="contact" />
                            </Grid.GestureRecognizers>
                            <Label Text="تواصل مع الإدارة والدعم" TextColor="#1e293b" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="🎧" FontSize="18" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="#f1f5f9" />

                        <!-- Logout -->
                        <Grid Padding="12,14" ColumnDefinitions="*,Auto" Margin="0,8,0,0" BackgroundColor="#fff1f2">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="logout" />
                            </Grid.GestureRecognizers>
                            <Label Text="تسجيل الخروج" TextColor="#e11d48" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="🚪" FontSize="18" VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>

                    <!-- ────────────────────────────────────────── -->
                    <!-- 4. SYSTEM ADMIN CONTENT                    -->
                    <!-- ────────────────────────────────────────── -->
                    <VerticalStackLayout IsVisible="{Binding IsAdminActive}" Spacing="0" Margin="0,16,0,0">
                        <Label Text="إدارة المنصة والنظام" FontSize="12" TextColor="#dc2626" FontAttributes="Bold" Margin="8,0,8,8" />

                        <!-- لوحة التحكم -->
                        <Grid Padding="12,13" ColumnDefinitions="*,Auto" BackgroundColor="#fef2f2">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="admin" />
                            </Grid.GestureRecognizers>
                            <Label Text="لوحة التحكم العامة" TextColor="#b91c1c" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="📊" FontSize="18" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="#f1f5f9" />

                        <!-- مركز الموافقات -->
                        <Grid Padding="12,13" ColumnDefinitions="*,Auto" BackgroundColor="#fffbeb">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="admin/approvals" />
                            </Grid.GestureRecognizers>
                            <Label Text="مركز الموافقات السريعة 🛡️" TextColor="#b45309" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="⚡" FontSize="18" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="#f1f5f9" />

                        <!-- الشكاوى -->
                        <Grid Padding="12,13" ColumnDefinitions="*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="admin/complaints" />
                            </Grid.GestureRecognizers>
                            <Label Text="الشكاوى والبلاغات" TextColor="#1e293b" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="📞" FontSize="18" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="#f1f5f9" />

                        <!-- إدارة الخدمات -->
                        <Grid Padding="12,13" ColumnDefinitions="*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="admin/services" />
                            </Grid.GestureRecognizers>
                            <Label Text="إدارة الخدمات" TextColor="#1e293b" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="🛠️" FontSize="18" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="#f1f5f9" />

                        <!-- إدارة التصنيفات -->
                        <Grid Padding="12,13" ColumnDefinitions="*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="admin/categories" />
                            </Grid.GestureRecognizers>
                            <Label Text="إدارة التصنيفات" TextColor="#1e293b" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="📂" FontSize="18" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="#f1f5f9" />

                        <!-- المحافظات والمدن -->
                        <Grid Padding="12,13" ColumnDefinitions="*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="admin/governorates" />
                            </Grid.GestureRecognizers>
                            <Label Text="المحافظات والمدن" TextColor="#1e293b" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="📍" FontSize="18" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="#f1f5f9" />

                        <!-- إدارة المستخدمين (SuperAdmin) -->
                        <Grid Padding="12,13" ColumnDefinitions="*,Auto" IsVisible="{Binding IsSuperAdmin}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="admin/users" />
                            </Grid.GestureRecognizers>
                            <Label Text="إدارة المستخدمين" TextColor="#1e293b" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="👥" FontSize="18" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="#f1f5f9" IsVisible="{Binding IsSuperAdmin}" />

                        <!-- الإعلانات -->
                        <Grid Padding="12,13" ColumnDefinitions="*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="admin/ads" />
                            </Grid.GestureRecognizers>
                            <Label Text="إدارة الإعلانات والبنرات" TextColor="#1e293b" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="📢" FontSize="18" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="#f1f5f9" />

                        <!-- إعدادات النظام -->
                        <Grid Padding="12,13" ColumnDefinitions="*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="admin/settings" />
                            </Grid.GestureRecognizers>
                            <Label Text="إعدادات النظام" TextColor="#1e293b" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="⚙️" FontSize="18" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="8" Color="#f8fafc" Margin="0,8,0,8" />

                        <!-- معاينة المنصة -->
                        <Label Text="معاينة المنصة كجمهور" FontSize="12" TextColor="#94a3b8" FontAttributes="Bold" Margin="8,0,8,8" />
                        <Grid Padding="12,13" ColumnDefinitions="*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="home" />
                            </Grid.GestureRecognizers>
                            <Label Text="الرئيسية" TextColor="#1e293b" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="🏠" FontSize="18" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="#f1f5f9" />

                        <Grid Padding="12,13" ColumnDefinitions="*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="services" />
                            </Grid.GestureRecognizers>
                            <Label Text="الخدمات" TextColor="#1e293b" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="🔍" FontSize="18" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="8" Color="#f8fafc" Margin="0,8,0,8" />

                        <!-- الملف الشخصي وتسجيل الخروج -->
                        <Grid Padding="12,13" ColumnDefinitions="*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="profile" />
                            </Grid.GestureRecognizers>
                            <Label Text="الملف الشخصي" TextColor="#1e293b" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="👤" FontSize="18" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="#f1f5f9" />

                        <Grid Padding="12,14" ColumnDefinitions="*,Auto" Margin="0,8,0,0" BackgroundColor="#fff1f2">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="logout" />
                            </Grid.GestureRecognizers>
                            <Label Text="تسجيل الخروج" TextColor="#e11d48" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="🚪" FontSize="18" VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>

                </VerticalStackLayout>

                <!-- ═══ FOOTER ═══ -->
                <VerticalStackLayout Grid.Row="2" Padding="20,16,20,30" Spacing="12">
                    <BoxView HeightRequest="1" Color="#f1f5f9" />
                    <!-- Share App -->
                    <Grid ColumnDefinitions="*,Auto" Padding="4,8">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ShareAppCommand}" />
                        </Grid.GestureRecognizers>
                        <Label Text="شارك التطبيق" TextColor="{DynamicResource Primary}" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="🔗" FontSize="16" VerticalOptions="Center" />
                    </Grid>
                    <!-- Terms / Privacy / Contact -->
                    <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                        <Label TextColor="#64748b" FontSize="12">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="contact" />
                            </Label.GestureRecognizers>
                            <Label.FormattedText>
                                <FormattedString><Span Text="تواصل معنا" TextDecorations="Underline" /></FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Label Text="|" TextColor="#cbd5e1" FontSize="12" VerticalOptions="Center" />
                        <Label TextColor="#64748b" FontSize="12">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="terms" />
                            </Label.GestureRecognizers>
                            <Label.FormattedText>
                                <FormattedString><Span Text="الشروط والأحكام" TextDecorations="Underline" /></FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Label Text="|" TextColor="#cbd5e1" FontSize="12" VerticalOptions="Center" />
                        <Label TextColor="#64748b" FontSize="12">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="privacy" />
                            </Label.GestureRecognizers>
                            <Label.FormattedText>
                                <FormattedString><Span Text="الخصوصية" TextDecorations="Underline" /></FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </HorizontalStackLayout>
                    <Label Text="إصدار 1.0.0" FontSize="11" TextColor="#94a3b8" HorizontalOptions="Center" />
                </VerticalStackLayout>

            </Grid>
        </ScrollView>
    </Shell.FlyoutContent>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- MAIN TAB BAR (5 TABS DYNAMICALLY TAILORED FOR EACH ROLE)   -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <TabBar x:Name="MainTabBar">

        <!-- ═════════ 1. GUEST TABS ═════════ -->
        <Tab Title="الرئيسية" Route="Guest_Home" IsVisible="{Binding IsGuest}">
            <Tab.Icon><FontImageSource FontFamily="OpenSansRegular" Glyph="&#x1F3E0;" Color="#6366f1" /></Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:HomePage}" />
        </Tab>
        <Tab Title="الخدمات" Route="Guest_Services" IsVisible="{Binding IsGuest}">
            <Tab.Icon><FontImageSource FontFamily="OpenSansRegular" Glyph="&#x1F50D;" Color="#6366f1" /></Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:ServicesPage}" />
        </Tab>
        <Tab Title="اعرض خدماتك" Route="Guest_Apply" IsVisible="{Binding IsGuest}">
            <Tab.Icon><FontImageSource FontFamily="OpenSansRegular" Glyph="&#x1F4BC;" Color="#6366f1" /></Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:PostServicePage}" />
        </Tab>
        <Tab Title="تواصل معنا" Route="Guest_Contact" IsVisible="{Binding IsGuest}">
            <Tab.Icon><FontImageSource FontFamily="OpenSansRegular" Glyph="&#x1F3A7;" Color="#6366f1" /></Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:SupportPage}" />
        </Tab>
        <Tab Title="دخول" Route="Guest_Login" IsVisible="{Binding IsGuest}">
            <Tab.Icon><FontImageSource FontFamily="OpenSansRegular" Glyph="&#x1F464;" Color="#6366f1" /></Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:LoginPage}" />
        </Tab>

        <!-- ═════════ 2. CLIENT TABS ═════════ -->
        <Tab Title="الرئيسية" Route="Client_Home" IsVisible="{Binding IsClient}">
            <Tab.Icon><FontImageSource FontFamily="OpenSansRegular" Glyph="&#x1F3E0;" Color="#6366f1" /></Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:HomePage}" />
        </Tab>
        <Tab Title="الخدمات" Route="Client_Services" IsVisible="{Binding IsClient}">
            <Tab.Icon><FontImageSource FontFamily="OpenSansRegular" Glyph="&#x1F50D;" Color="#6366f1" /></Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:ServicesPage}" />
        </Tab>
        <Tab Title="طلباتي" Route="Client_Requests" IsVisible="{Binding IsClient}">
            <Tab.Icon><FontImageSource FontFamily="OpenSansRegular" Glyph="&#x1F4CB;" Color="#6366f1" /></Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:MyRequestsPage}" />
        </Tab>
        <Tab Title="رسائلي" Route="Client_Messages" IsVisible="{Binding IsClient}">
            <Tab.Icon><FontImageSource FontFamily="OpenSansRegular" Glyph="&#x1F4AC;" Color="#6366f1" /></Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:MessagesPage}" />
        </Tab>
        <Tab Title="حسابي" Route="Client_Profile" IsVisible="{Binding IsClient}">
            <Tab.Icon><FontImageSource FontFamily="OpenSansRegular" Glyph="&#x1F464;" Color="#6366f1" /></Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:ProfilePage}" />
        </Tab>

        <!-- ═════════ 3. PROVIDER TABS ═════════ -->
        <Tab Title="لوحة التحكم" Route="Provider_Dashboard" IsVisible="{Binding IsProviderActive}">
            <Tab.Icon><FontImageSource FontFamily="OpenSansRegular" Glyph="&#x1F4CA;" Color="#6366f1" /></Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:ProviderDashboardPage}" />
        </Tab>
        <Tab Title="خدماتي" Route="Provider_Services" IsVisible="{Binding IsProviderActive}">
            <Tab.Icon><FontImageSource FontFamily="OpenSansRegular" Glyph="&#x1F4BC;" Color="#6366f1" /></Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:MyServicesPage}" />
        </Tab>
        <Tab Title="أضف خدمة" Route="Provider_Add" IsVisible="{Binding IsProviderActive}">
            <Tab.Icon><FontImageSource FontFamily="OpenSansRegular" Glyph="&#x2795;" Color="#6366f1" /></Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:CreateServicePage}" />
        </Tab>
        <Tab Title="المحادثات" Route="Provider_Messages" IsVisible="{Binding IsProviderActive}">
            <Tab.Icon><FontImageSource FontFamily="OpenSansRegular" Glyph="&#x1F4AC;" Color="#6366f1" /></Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:MessagesPage}" />
        </Tab>
        <Tab Title="حسابي" Route="Provider_Profile" IsVisible="{Binding IsProviderActive}">
            <Tab.Icon><FontImageSource FontFamily="OpenSansRegular" Glyph="&#x1F464;" Color="#6366f1" /></Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:ProfilePage}" />
        </Tab>

        <!-- ═════════ 4. ADMIN TABS ═════════ -->
        <Tab Title="التطبيق" Route="Admin_Home" IsVisible="{Binding IsAdminActive}">
            <Tab.Icon><FontImageSource FontFamily="OpenSansRegular" Glyph="&#x1F3E0;" Color="#6366f1" /></Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:HomePage}" />
        </Tab>
        <Tab Title="لوحة المدير" Route="Admin_Dashboard" IsVisible="{Binding IsAdminActive}">
            <Tab.Icon><FontImageSource FontFamily="OpenSansRegular" Glyph="&#x1F4CA;" Color="#6366f1" /></Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:AdminPage}" />
        </Tab>
        <Tab Title="الموافقات" Route="Admin_Approvals" IsVisible="{Binding IsAdminActive}">
            <Tab.Icon><FontImageSource FontFamily="OpenSansRegular" Glyph="&#x1F6E1;" Color="#6366f1" /></Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:ApprovalsPage}" />
        </Tab>
        <Tab Title="الشكاوى" Route="Admin_Complaints" IsVisible="{Binding IsAdminActive}">
            <Tab.Icon><FontImageSource FontFamily="OpenSansRegular" Glyph="&#x1F4DE;" Color="#6366f1" /></Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:ComplaintsPage}" />
        </Tab>
        <Tab Title="الإدارة" Route="Admin_Profile" IsVisible="{Binding IsAdminActive}">
            <Tab.Icon><FontImageSource FontFamily="OpenSansRegular" Glyph="&#x2699;" Color="#6366f1" /></Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:ProfilePage}" />
        </Tab>

    </TabBar>

    <!-- Visual Separator -->
    <MenuItem Text="تحديث التطبيق" Command="{Binding RefreshCommand}" IconImageSource="{FontImageSource FontFamily=OpenSansRegular, Glyph='&#x1f504;', Color='#0f172a'}" />
    
    <!-- Logout is in FlyoutFooter -->

</Shell>
