<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Khadamat.MobileApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Khadamat.MobileApp.Views"
    xmlns:viewModels="clr-namespace:Khadamat.MobileApp.ViewModels"
    x:DataType="viewModels:ShellViewModel"
    Title="{Binding AppName}"
    FlyoutBackgroundColor="#ffffff"
    FlyoutBehavior="Flyout"
    FlowDirection="RightToLeft">

    <Shell.TitleView>
        <Grid Padding="10,0" VerticalOptions="Fill">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            
            <HorizontalStackLayout Grid.Column="0" HorizontalOptions="Start" VerticalOptions="Center" Spacing="8">
                <HorizontalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="//HomePage" />
                </HorizontalStackLayout.GestureRecognizers>
                <Image Source="{Binding AppLogo}" HeightRequest="28" WidthRequest="28" Aspect="AspectFit"/>
                <Label Text="{Binding AppName}" FontSize="18" FontAttributes="Bold" TextColor="White" VerticalOptions="Center"/>
            </HorizontalStackLayout>
            
            <ImageButton Grid.Column="2" Source="{FontImageSource FontFamily=OpenSansRegular, Glyph='&#x1F3A8;', Color=White}"
                         HeightRequest="30" WidthRequest="30" Margin="5,0"
                         Command="{Binding ShowThemePickerCommand}" />

            <ImageButton Grid.Column="3" Source="{FontImageSource FontFamily=OpenSansRegular, Glyph='&#x1F514;', Color=White}"
                         HeightRequest="30" WidthRequest="30" Margin="5,0"
                         IsVisible="{Binding IsAuthenticated}"
                         Command="{Binding NavigateCommand}" CommandParameter="notifications" />
            
            <ImageButton Grid.Column="4" Source="{FontImageSource FontFamily=OpenSansRegular, Glyph='&#x1F50D;', Color=White}"
                         HeightRequest="30" WidthRequest="30" Margin="5,0"
                         Command="{Binding NavigateCommand}" CommandParameter="explore" />
        </Grid>
    </Shell.TitleView>

    <!-- Flyout Header -->
    <Shell.FlyoutHeader>
        <Grid HeightRequest="200">
            <!-- Premium Background (Mocking Gradient with overlapping boxes or just a solid rich color) -->
            <BoxView Color="{DynamicResource Primary}" />
            
            <Grid Padding="20">
                <!-- Guest Header -->
                <VerticalStackLayout VerticalOptions="Center" IsVisible="{Binding IsNotAuthenticated}" Spacing="12">
                    <Frame BackgroundColor="White" Padding="0" HeightRequest="64" WidthRequest="64" CornerRadius="32" HorizontalOptions="Center" HasShadow="True">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="//HomePage" />
                        </Frame.GestureRecognizers>
                        <Image Source="{Binding AppLogo}" Aspect="AspectFit" Margin="10"/>
                    </Frame>
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding AppName, StringFormat='مرحباً بك في {0}'}" TextColor="White" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center">
                             <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="//HomePage" />
                            </Label.GestureRecognizers>
                        </Label>
                        <Label Text="{Binding AppSlogan}" TextColor="#94a3b8" FontSize="12" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                    <Button Text="دخول / تسجيل" Command="{Binding NavigateCommand}" CommandParameter="profile" 
                            BackgroundColor="{DynamicResource Primary}" TextColor="White" CornerRadius="25" FontAttributes="Bold" HeightRequest="45" Padding="25,0" Margin="0,10,0,0">
                        <Button.Shadow>
                            <Shadow Brush="#000000" Offset="0,4" Radius="8" Opacity="0.3" />
                        </Button.Shadow>
                    </Button>
                </VerticalStackLayout>
                
                <!-- Authenticated Header -->
                <VerticalStackLayout VerticalOptions="Center" IsVisible="{Binding IsAuthenticated}" Spacing="10">
                    <Frame Padding="2" HeightRequest="74" WidthRequest="74" CornerRadius="37" HorizontalOptions="Center" BackgroundColor="{DynamicResource Primary}" HasShadow="True">
                        <Image Source="{Binding UserImage}" Aspect="AspectFill">
                            <Image.Clip><EllipseGeometry Center="35,35" RadiusX="35" RadiusY="35" /></Image.Clip>
                        </Image>
                    </Frame>
                    <Label Text="{Binding UserName}" TextColor="White" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center"/>
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="2">
                        <Label Text="⭐" TextColor="#f59e0b" FontSize="12"/>
                        <Label Text="⭐" TextColor="#f59e0b" FontSize="12"/>
                        <Label Text="⭐" TextColor="#f59e0b" FontSize="12"/>
                        <Label Text="⭐" TextColor="#f59e0b" FontSize="12"/>
                        <Label Text="⭐" TextColor="#f59e0b" FontSize="12"/>
                    </HorizontalStackLayout>
                    <Button Text="الملف الشخصي" BackgroundColor="{DynamicResource Primary}" Opacity="0.8" TextColor="White" FontSize="12" CornerRadius="12" Padding="15,0" HeightRequest="30" 
                            Command="{Binding NavigateCommand}" CommandParameter="profile" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Grid>
        </Grid>
    </Shell.FlyoutHeader>

    <!-- Flyout Footer for a Premium Look -->
    <Shell.FlyoutFooter>
        <VerticalStackLayout Padding="20" IsVisible="{Binding IsAuthenticated}" BackgroundColor="#ffffff">
            <BoxView HeightRequest="1" Color="#f1f5f9" Margin="0,0,0,15" />
            <Button Text="تسجيل الخروج" 
                    Command="{Binding NavigateCommand}" 
                    CommandParameter="logout"
                    BackgroundColor="#fff1f2"
                    TextColor="#e11d48"
                    FontAttributes="Bold"
                    CornerRadius="25"
                    HeightRequest="50"
                    ImageSource="{FontImageSource FontFamily=OpenSansRegular, Glyph='&#x1F6AA;', Color='#e11d48'}"
                    ContentLayout="Right,12">
                <Button.Shadow>
                    <Shadow Brush="#000000" Offset="0,2" Radius="5" Opacity="0.1" />
                </Button.Shadow>
            </Button>
            <Label Text="نسخة 1.0.0" FontSize="10" TextColor="#94a3b8" HorizontalOptions="Center" Margin="0,10,0,0" />
        </VerticalStackLayout>
    </Shell.FlyoutFooter>

    <TabBar x:Name="MainTabBar">
        
        <Tab Title="الرئيسية" Route="HomePage">
            <Tab.Icon><FontImageSource FontFamily="OpenSansRegular" Glyph="&#x1F3E0;" /></Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:HomePage}" />
        </Tab>

        <Tab Title="المتجر" Route="MarketplacePage">
            <Tab.Icon><FontImageSource FontFamily="OpenSansRegular" Glyph="&#x1F6CD;" /></Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:MarketplacePage}" />
        </Tab>
        
        <Tab Title="أضف إعلان" Route="PostServicePage">
            <Tab.Icon><FontImageSource FontFamily="OpenSansRegular" Glyph="&#x2795;" Color="{DynamicResource Primary}" /></Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:PostServicePage}" />
        </Tab>

        <!-- Unauthenticated Specific Tabs -->
        <Tab Title="المفضلة" Route="FavoritesTab">
            <Tab.Icon><FontImageSource FontFamily="OpenSansRegular" Glyph="&#x2764;" /></Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:FavoritesPage}" />
        </Tab>
        <Tab Title="دخول" Route="GuestProfilePage" IsVisible="{Binding IsNotAuthenticated}">
            <Tab.Icon><FontImageSource FontFamily="OpenSansRegular" Glyph="&#x1F464;" /></Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:LoginPage}" />
        </Tab>

        <!-- Authenticated Specific Tabs -->
        <Tab Title="{Binding UserTitle}" Route="AuthProfilePage" IsVisible="{Binding IsAuthenticated}">
            <Tab.Icon><FontImageSource FontFamily="OpenSansRegular" Glyph="&#x1F468;" /></Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:ProfilePage}" />
        </Tab>

        <!-- Extra Hidden Pages -->
        <!-- We use standalone routes for these via AppPages -->

        <Tab Title="خدماتي" Route="MyServicesPage" IsVisible="False">
            <ShellContent ContentTemplate="{DataTemplate views:MyServicesPage}" />
        </Tab>
        <Tab Title="الإعدادات" Route="SettingsPage" IsVisible="False">
            <ShellContent ContentTemplate="{DataTemplate views:SettingsPage}" />
        </Tab>
    </TabBar>

    <!-- Side Menu (Flyout) Navigation -->
    <!-- ==== الاستكشاف ==== -->
    <MenuItem Text="الرئيسية" Command="{Binding NavigateCommand}" CommandParameter="//HomePage" IconImageSource="{FontImageSource FontFamily=OpenSansRegular, Glyph='&#x1F3E0;', Color='#0f172a'}" />
    <MenuItem Text="التصنيفات" Command="{Binding NavigateCommand}" CommandParameter="categories" IconImageSource="{FontImageSource FontFamily=OpenSansRegular, Glyph='&#x1F4C2;', Color='#0f172a'}" />
    <MenuItem Text="المتجر" Command="{Binding NavigateCommand}" CommandParameter="//MarketplacePage" IconImageSource="{FontImageSource FontFamily=OpenSansRegular, Glyph='&#x1F6CD;', Color='#0f172a'}" />

    <!-- ==== نشاطاتي ==== -->
    <MenuItem Text="إعلاناتي / خدماتي" 
              Command="{Binding NavigateCommand}" 
              CommandParameter="provider/dashboard" 
              IconImageSource="{FontImageSource FontFamily=OpenSansRegular, Glyph='&#x1F4BC;', Color='#0f172a'}" />
    <MenuItem Text="المفضلة" 
              Command="{Binding NavigateCommand}" 
              CommandParameter="favorites" 
              IconImageSource="{FontImageSource FontFamily=OpenSansRegular, Glyph='&#x2764;', Color='#0f172a'}" />
    <MenuItem Text="الرسائل" 
              Command="{Binding NavigateCommand}" 
              CommandParameter="messages" 
              IconImageSource="{FontImageSource FontFamily=OpenSansRegular, Glyph='&#x1F4AC;', Color='#0f172a'}" />

    <!-- ==== الإدارة ==== -->
    <MenuItem Text="لوحة المدير" 
              Command="{Binding NavigateCommand}" 
              CommandParameter="admin" 
              IconImageSource="{FontImageSource FontFamily=OpenSansRegular, Glyph='&#x1F6E1;', Color='#0f172a'}" />
    <MenuItem Text="إدارة الإعلانات" 
              Command="{Binding NavigateCommand}" 
              CommandParameter="admin/ads" 
              IconImageSource="{FontImageSource FontFamily=OpenSansRegular, Glyph='&#x1F4DC;', Color='#0f172a'}" />

    <!-- Visual Separator -->
    <MenuItem Text="━━━━━━━━━━━━" IsEnabled="False" />

    <!-- ==== النظام ==== -->
    <MenuItem Text="الإعدادات" Command="{Binding NavigateCommand}" CommandParameter="settings" IconImageSource="{FontImageSource FontFamily=OpenSansRegular, Glyph='&#x2699;', Color='#0f172a'}" />
    <MenuItem Text="الدعم والمساعدة" Command="{Binding NavigateCommand}" CommandParameter="support" IconImageSource="{FontImageSource FontFamily=OpenSansRegular, Glyph='&#x1F198;', Color='#0f172a'}" />
    <MenuItem Text="الشروط والأحكام" Command="{Binding NavigateCommand}" CommandParameter="terms" IconImageSource="{FontImageSource FontFamily=OpenSansRegular, Glyph='&#x1F4DC;', Color='#0f172a'}" />
    <MenuItem Text="تحديث التطبيق" Command="{Binding RefreshCommand}" IconImageSource="{FontImageSource FontFamily=OpenSansRegular, Glyph='&#x1f504;', Color='#0f172a'}" />
    
    <!-- Logout is now in FlyoutFooter for better UI -->

</Shell>
