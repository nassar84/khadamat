<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Khadamat.MobileApp.Views.Controls.BottomNavBar"
             FlowDirection="RightToLeft">

    <!--
        Layout: 2-row outer Grid
          Row 0 (30px): protrusion space for the elevated home circle
          Row 1 (68px): the actual nav bar
        Total height: 98px
        
        RTL column order (visual left → right when FlowDirection=RTL):
          Col 0 (visual RIGHT) = المتجر
          Col 1               = المفضلة
          Col 2 (CENTER)      = [HOME spacer]
          Col 3               = الرسائل
          Col 4 (visual LEFT) = حسابي / دخول
    -->
    <Grid VerticalOptions="End">
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="68" />
        </Grid.RowDefinitions>

        <!-- ═══════ Bar Background (Row 1) ═══════ -->
        <Border Grid.Row="1"
                BackgroundColor="White"
                StrokeThickness="0"
                Padding="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="22,22,0,0" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,-5" Radius="20" Opacity="0.07" />
            </Border.Shadow>
            <ContentView />
        </Border>

        <!-- Top separator line -->
        <BoxView Grid.Row="1" VerticalOptions="Start"
                 HeightRequest="1" Color="#f1f5f9" />

        <!-- ═══════ 4 Side Nav Items (Row 1) ═══════ -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,*,64,*,*"
              HorizontalOptions="Fill" VerticalOptions="Fill">

            <!-- Col 0 (RTL right) ═ المتجر -->
            <VerticalStackLayout Grid.Column="0"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Spacing="2">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnMarketplaceTapped" />
                </VerticalStackLayout.GestureRecognizers>
                <Label x:Name="MarketplaceRightIcon"
                       Text="&#x1F3EA;"
                       FontSize="20"
                       TextColor="#f59e0b"
                       HorizontalOptions="Center" />
                <Label x:Name="MarketplaceRightLabel"
                       Text="المتجر"
                       FontSize="10"
                       FontAttributes="Bold"
                       TextColor="#d97706"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Col 1 ═ المفضلة -->
            <VerticalStackLayout Grid.Column="1"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Spacing="2">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnFavoritesTapped" />
                </VerticalStackLayout.GestureRecognizers>
                <Label x:Name="FavoritesRightIcon"
                       Text="&#x2764;"
                       FontSize="20"
                       TextColor="#ef4444"
                       HorizontalOptions="Center" />
                <Label x:Name="FavoritesRightLabel"
                       Text="المفضلة"
                       FontSize="10"
                       FontAttributes="Bold"
                       TextColor="#94a3b8"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Col 2 ═ Center spacer for home circle -->
            <ContentView Grid.Column="2" />

            <!-- Col 3 ═ الرسائل -->
            <VerticalStackLayout Grid.Column="3"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Spacing="2">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnMessagesTapped" />
                </VerticalStackLayout.GestureRecognizers>
                <Label x:Name="MessagesIcon"
                       Text="&#x2709;"
                       FontSize="20"
                       TextColor="#94a3b8"
                       HorizontalOptions="Center" />
                <Label x:Name="MessagesLabel"
                       Text="الرسائل"
                       FontSize="10"
                       FontAttributes="Bold"
                       TextColor="#94a3b8"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Col 4 (RTL left) ═ حسابي / دخول -->
            <VerticalStackLayout Grid.Column="4"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Spacing="2">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnProfileTapped" />
                </VerticalStackLayout.GestureRecognizers>
                <Label x:Name="ProfileIcon"
                       Text="&#x1F464;"
                       FontSize="20"
                       TextColor="#94a3b8"
                       HorizontalOptions="Center" />
                <Label x:Name="ProfileLabel"
                       Text="دخول"
                       FontSize="10"
                       FontAttributes="Bold"
                       TextColor="#94a3b8"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>

        <!-- ═══════ HOME Elevated Circle (spans rows 0 & 1, horizontally centered) ═══════ -->
        <Border x:Name="HomeCircle"
                Grid.RowSpan="2"
                HorizontalOptions="Center"
                VerticalOptions="Start"
                Margin="0,5,0,0"
                WidthRequest="58"
                HeightRequest="58"
                Stroke="White"
                StrokeThickness="4">
            <Border.StrokeShape>
                <Ellipse />
            </Border.StrokeShape>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{DynamicResource Primary}" Offset="0.0" />
                    <GradientStop Color="{DynamicResource Secondary}" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Shadow>
                <Shadow Brush="{DynamicResource Primary}"
                        Offset="0,6" Radius="16" Opacity="0.45" />
            </Border.Shadow>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnHomeTapped" />
            </Border.GestureRecognizers>
            <Label Text="&#x1F3E0;"
                   FontSize="26"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
        </Border>

        <!-- HOME label — bottom of bar, centered -->
        <Label Grid.Row="1"
               x:Name="HomeLabel"
               Text="الرئيسية"
               FontSize="10"
               FontAttributes="Bold"
               TextColor="{DynamicResource Primary}"
               HorizontalOptions="Center"
               VerticalOptions="End"
               Margin="0,0,0,7" />

    </Grid>
</ContentView>
