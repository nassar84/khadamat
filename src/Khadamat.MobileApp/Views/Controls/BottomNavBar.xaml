<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:Khadamat.MobileApp.ViewModels"
             x:Class="Khadamat.MobileApp.Views.Controls.BottomNavBar"
             FlowDirection="RightToLeft">

    <!--
        Matches the web BottomNav.razor exactly:
          Row 0 (30px): protrusion space for the elevated home circle
          Row 1 (68px): the actual nav bar (height ~= web's 75px)
          
        RTL column order (visual left → right when FlowDirection=RTL):
          Col 0 (visual RIGHT) = المتجر
          Col 1               = المفضلة
          Col 2 (CENTER)      = [HOME spacer]
          Col 3               = الرسائل
          Col 4 (visual LEFT) = حسابي / دخول
          
        Icons use FontAwesome 6 Free Solid (FA6Solid) to match the web's font-awesome icons.
        Inactive color: #475569 (slate-600) — same as web .nav-item color
        Active color:   Primary (purple) — same as web .nav-item.active color
    -->
    <Grid VerticalOptions="End" x:Name="RootGrid" x:DataType="viewModels:ShellViewModel">
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="68" />
        </Grid.RowDefinitions>

        <Grid.Resources>
            <Color x:Key="InactiveColor">#475569</Color>
            <Color x:Key="ActiveColor">#6366f1</Color>
        </Grid.Resources>

        <!-- ═══════ Bar Background (Row 1) ═══════ -->
        <Border Grid.Row="1"
                BackgroundColor="White"
                StrokeThickness="0"
                Padding="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20,20,0,0" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,-8" Radius="25" Opacity="0.06" />
            </Border.Shadow>
            <ContentView />
        </Border>

        <BoxView Grid.Row="1" VerticalOptions="Start"
                 HeightRequest="1" Color="#f1f5f9" />

        <!-- ═══════ 4 Side Nav Items (Row 1) ═══════ -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,*,64,*,*"
              HorizontalOptions="Fill" VerticalOptions="Fill">

            <!-- Col 0 (RTL right) ═ المتجر -->
            <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" VerticalOptions="Center" Spacing="3">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="marketplace" />
                </VerticalStackLayout.GestureRecognizers>
                <Label x:Name="MarketplaceRightIcon" Text="&#xF54F;" FontFamily="FA6Solid" FontSize="20" HorizontalOptions="Center" TextColor="{StaticResource InactiveColor}">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding CurrentTab}" Value="marketplace">
                            <Setter Property="TextColor" Value="{DynamicResource Primary}" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
                <Label x:Name="MarketplaceRightLabel" Text="المتجر" FontSize="10" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{StaticResource InactiveColor}">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding CurrentTab}" Value="marketplace">
                            <Setter Property="TextColor" Value="{DynamicResource Primary}" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </VerticalStackLayout>
            
            <!-- Col 1 ═ المفضلة -->
            <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center" Spacing="3">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="favorites" />
                </VerticalStackLayout.GestureRecognizers>
                <Label x:Name="FavoritesRightIcon" Text="&#xF004;" FontFamily="FA6Solid" FontSize="20" HorizontalOptions="Center" TextColor="{StaticResource InactiveColor}">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding CurrentTab}" Value="favorites">
                            <Setter Property="TextColor" Value="#ef4444" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
                <Label x:Name="FavoritesRightLabel" Text="المفضلة" FontSize="10" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{StaticResource InactiveColor}">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding CurrentTab}" Value="favorites">
                            <Setter Property="TextColor" Value="#ef4444" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </VerticalStackLayout>

            <ContentView Grid.Column="2" />

            <!-- Col 3 ═ الرسائل -->
            <VerticalStackLayout Grid.Column="3" HorizontalOptions="Center" VerticalOptions="Center" Spacing="3">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="messages" />
                </VerticalStackLayout.GestureRecognizers>
                <Label x:Name="MessagesIcon" Text="&#xF0E0;" FontFamily="FA6Solid" FontSize="20" HorizontalOptions="Center" TextColor="{StaticResource InactiveColor}">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding CurrentTab}" Value="messages">
                            <Setter Property="TextColor" Value="{DynamicResource Primary}" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
                <Label x:Name="MessagesLabel" Text="الرسائل" FontSize="10" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{StaticResource InactiveColor}">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding CurrentTab}" Value="messages">
                            <Setter Property="TextColor" Value="{DynamicResource Primary}" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </VerticalStackLayout>

            <!-- Col 4 ═ حسابي / دخول -->
            <VerticalStackLayout Grid.Column="4" HorizontalOptions="Center" VerticalOptions="Center" Spacing="3">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="profile" />
                </VerticalStackLayout.GestureRecognizers>
                <Grid WidthRequest="24" HeightRequest="24" HorizontalOptions="Center">
                    <Label x:Name="ProfileIcon" Text="&#xF007;" FontFamily="FA6Solid" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" TextColor="{StaticResource InactiveColor}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding CurrentTab}" Value="profile">
                                <Setter Property="TextColor" Value="{DynamicResource Primary}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>

                    <Border x:Name="ProfileImageBorder" IsVisible="False" WidthRequest="24" HeightRequest="24" 
                            StrokeThickness="2" HorizontalOptions="Center" VerticalOptions="Center"
                            Stroke="Transparent">
                         <Border.StrokeShape><Ellipse /></Border.StrokeShape>
                         <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding CurrentTab}" Value="profile">
                                <Setter Property="Stroke" Value="{DynamicResource Primary}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Image x:Name="ProfileImage" Aspect="AspectFill" WidthRequest="24" HeightRequest="24" />
                    </Border>
                </Grid>
                <Label x:Name="ProfileLabel" Text="{Binding UserTitle}" FontSize="10" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{StaticResource InactiveColor}">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding CurrentTab}" Value="profile">
                            <Setter Property="TextColor" Value="{DynamicResource Primary}" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </VerticalStackLayout>
        </Grid>

        <!-- ═══════ HOME Elevated Circle (spans rows 0 & 1, horizontally centered) ═══════
             Matches web: .home-circle — 52px, purple gradient, white 4px border, purple shadow
        -->
        <Border x:Name="HomeCircle"
                Grid.RowSpan="2"
                HorizontalOptions="Center"
                VerticalOptions="Start"
                Margin="0,5,0,0"
                WidthRequest="52"
                HeightRequest="52"
                Stroke="White"
                StrokeThickness="4">
            <Border.StrokeShape>
                <Ellipse />
            </Border.StrokeShape>
            <Border.Background>
                <!-- Matches web: linear-gradient(135deg, #8b5cf6, #6366f1) -->
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{DynamicResource Primary}" Offset="0.0" />
                    <GradientStop Color="{DynamicResource Secondary}" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Shadow>
                <!-- Matches web: box-shadow: 0 8px 15px rgba(139, 92, 246, 0.3) -->
                <Shadow Brush="{DynamicResource Primary}"
                        Offset="0,8" Radius="15" Opacity="0.3" />
            </Border.Shadow>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnHomeTapped" />
            </Border.GestureRecognizers>
            <!-- fa-house (&#xF015;) — white icon inside the circle -->
            <Label Text="&#xF015;"
                   FontFamily="FA6Solid"
                   FontSize="22"
                   TextColor="White"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
        </Border>

        <!-- HOME label — bottom of bar, centered, always in primary purple -->
        <Label Grid.Row="1"
               x:Name="HomeLabel"
               Text="الرئيسية"
               FontSize="10"
               FontAttributes="Bold"
               TextColor="{DynamicResource Primary}"
               HorizontalOptions="Center"
               VerticalOptions="End"
               Margin="0,0,0,7" />

    </Grid>
</ContentView>
