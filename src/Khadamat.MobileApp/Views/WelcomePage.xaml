<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Khadamat.MobileApp.Views.WelcomePage"
             BackgroundColor="#0f172a"
             Shell.NavBarIsVisible="False"
             FlowDirection="RightToLeft">

    <Grid>
        <!-- Background Gradient Simulation -->
        <BoxView>
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0f172a" Offset="0.1" />
                    <GradientStop Color="#1e293b" Offset="1.0" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <ScrollView>
            <VerticalStackLayout Spacing="15" Padding="20,40,20,30">
                <!-- Hero Image -->
                <Frame Padding="0" HasShadow="True" CornerRadius="20" IsClippedToBounds="True" HeightRequest="220" 
                       Background="Transparent" BorderColor="Transparent">
                    <Image Source="welcome_hero.png" Aspect="AspectFill" />
                </Frame>

                <!-- Titles -->
                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                    <Label Text="{Binding AppName, StringFormat='منصة {0}'}" 
                           FontSize="28" 
                           FontAttributes="Bold" 
                           TextColor="White" 
                           HorizontalOptions="Center" 
                           FontFamily="OpenSansRegular">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer NumberOfTapsRequired="5" Tapped="OnDevSettingsTriggered" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Label Text="خدماتك في مكان واحد.. لكل المصريين" 
                           FontSize="14" 
                           TextColor="#94a3b8" 
                           HorizontalOptions="Center" 
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- Benefits Section -->
                <Grid ColumnDefinitions="*, *" ColumnSpacing="15" Margin="0,5,0,0">
                    <!-- Seeker -->
                    <Frame Grid.Column="0" BackgroundColor="#1e293b" CornerRadius="15" Padding="12" BorderColor="#334155">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="🔍" FontSize="20" HorizontalOptions="Center" />
                            <Label Text="للباحث عن خدمة" TextColor="#3b82f6" FontAttributes="Bold" FontSize="13" HorizontalOptions="Center" />
                            <Label Text="تواصل مع محامين، ممرضين، سواقين، وحرفيين محترفين في ثوانٍ." 
                                   TextColor="#cbd5e1" FontSize="11" HorizontalTextAlignment="Center" LineHeight="1.2" />
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Provider -->
                    <Frame Grid.Column="1" BackgroundColor="#1e293b" CornerRadius="15" Padding="12" BorderColor="#334155">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="💼" FontSize="20" HorizontalOptions="Center" />
                            <Label Text="لصاحب الخدمة" TextColor="#10b981" FontAttributes="Bold" FontSize="13" HorizontalOptions="Center" />
                            <Label Text="سجل مهنتك، اعرض خدماتك، وضاعف دخلك بالوصول لآلاف العملاء." 
                                   TextColor="#cbd5e1" FontSize="11" HorizontalTextAlignment="Center" LineHeight="1.2" />
                        </VerticalStackLayout>
                    </Frame>
                </Grid>

                <!-- Diversity Note -->
                <Label Text="محاماة • تمريض • قيادة • تعليم • حرف • تنظيف • دليفري" 
                       TextColor="#64748b" 
                       FontSize="11" 
                       HorizontalOptions="Center" 
                       Margin="0,5,0,10" />

                <!-- Bottom Actions -->
                <VerticalStackLayout Padding="10,0,10,10" Spacing="15" BackgroundColor="Transparent">
                    <!-- Social Login Section -->
                    <VerticalStackLayout Spacing="10" Margin="0,0,0,10">
                        <Label Text="أو الدخول بواسطة" 
                               TextColor="#94a3b8" 
                               FontSize="13" 
                               HorizontalOptions="Center" 
                               Margin="0,0,0,5" />
                        
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                            <Button Grid.Column="0"
                                    Text="جوجل" 
                                    Clicked="OnGoogleLoginClicked"
                                    BackgroundColor="#ffffff" 
                                    TextColor="#475569" 
                                    HeightRequest="48" 
                                    CornerRadius="24" 
                                    FontAttributes="Bold" 
                                    FontSize="14"
                                    ImageSource="google_icon.jpg" />
                            
                            <Button Grid.Column="1"
                                    Text="فيسبوك" 
                                    Clicked="OnFacebookLoginClicked"
                                    BackgroundColor="#1877f2" 
                                    TextColor="White" 
                                    HeightRequest="48" 
                                    CornerRadius="24" 
                                    FontAttributes="Bold" 
                                    FontSize="14"
                                    ImageSource="facebook_icon.jpg" />
                        </Grid>
                    </VerticalStackLayout>

                    <Button Text="ابدأ الآن كزائر" 
                            Clicked="OnStartClicked"
                            BackgroundColor="#3b82f6" 
                            TextColor="White" 
                            HeightRequest="52" 
                            CornerRadius="26" 
                            FontAttributes="Bold" 
                            FontSize="16">
                        <Button.Shadow>
                            <Shadow Brush="#000000" Offset="0,4" Radius="8" Opacity="0.4" />
                        </Button.Shadow>
                    </Button>
                    
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                        <Label Text="بالاستمرار، أنت توافق على" 
                               TextColor="#475569" 
                               FontSize="11" />
                        <Label Text="الشروط والأحكام" 
                               TextColor="#3b82f6" 
                               FontSize="11" 
                               TextDecorations="Underline">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTermsClicked" />
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
