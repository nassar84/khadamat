<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Khadamat.MobileApp.Views.Controls"
             x:Class="Khadamat.MobileApp.Views.WebContainerPage"
             Shell.NavBarIsVisible="True"
             Shell.TabBarIsVisible="False"
             BackgroundColor="White"
             FlowDirection="RightToLeft">

    <!-- Row 0 = WebView  |  Row 1 = Custom Bottom Nav -->
    <Grid RowDefinitions="*,Auto" BackgroundColor="White">

        <!-- ═══ WebView ═══ -->
        <WebView Grid.Row="0"
                 x:Name="MainWebView"
                 Navigating="MainWebView_Navigating"
                 Navigated="MainWebView_Navigated"
                 HorizontalOptions="FillAndExpand"
                 VerticalOptions="FillAndExpand" />

        <!-- ═══ Native Loading Overlay ═══ -->
        <Grid Grid.Row="0" x:Name="LoadingOverlay" BackgroundColor="White">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="15">
                <ActivityIndicator IsRunning="True" Color="#6366f1" HeightRequest="50" WidthRequest="50" />
                <Label Text="جاري التحميل..." HorizontalOptions="Center" FontSize="14" TextColor="#6366f1" />
            </VerticalStackLayout>
        </Grid>

        <!-- ═══ Offline Overlay (مهندمة وعملية) ═══ -->
        <Grid Grid.RowSpan="2"
              x:Name="OfflineOverlay"
              BackgroundColor="#F8FAFC"
              IsVisible="False"
              Padding="24">
            <Border BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 24"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    MaximumWidthRequest="380"
                    Padding="24">
                <Border.Shadow>
                    <Shadow Brush="#64748B" Offset="0,6" Radius="16" Opacity="0.08" />
                </Border.Shadow>

                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="16">
                    <!-- Icon Container -->
                    <Border BackgroundColor="#EEF2FF"
                            Stroke="#E0E7FF"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 35"
                            HeightRequest="70"
                            WidthRequest="70"
                            HorizontalOptions="Center">
                        <Label Text="📡"
                               FontSize="32"
                               HorizontalOptions="Center"
                               VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="ChangeUrl_Tapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Border>

                    <!-- Title -->
                    <Label Text="لا يوجد اتصال بالإنترنت"
                           FontSize="20"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           TextColor="#1E293B" />

                    <!-- Subtitle -->
                    <Label Text="تعذر الاتصال بخدمات التطبيق. يرجى تفقد اتصال هاتفك بشبكة الإنترنت وتفعيل الواي فاي أو بيانات الهاتف."
                           FontSize="13"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           TextColor="#64748B"
                           LineHeight="1.4" />

                    <!-- Practical Tips Box -->
                    <Border BackgroundColor="#F8FAFC"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Padding="12,10"
                            HorizontalOptions="Fill">
                        <VerticalStackLayout Spacing="6">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="✔" TextColor="#10B981" FontSize="11" VerticalOptions="Center" />
                                <Label Text="تأكد من تفعيل الواي فاي (Wi-Fi) أو بيانات الجوال" FontSize="12" TextColor="#475569" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="✔" TextColor="#10B981" FontSize="11" VerticalOptions="Center" />
                                <Label Text="تأكد من إيقاف تشغيل وضع الطيران" FontSize="12" TextColor="#475569" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Retry Button -->
                    <Button x:Name="RetryBtn"
                            Text="إعادة المحاولة ↻"
                            Clicked="RetryButton_Clicked"
                            BackgroundColor="#4F46E5"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="14"
                            CornerRadius="24"
                            HeightRequest="46"
                            HorizontalOptions="Fill" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- ═══ Custom Bottom Nav Bar ═══ -->
        <controls:BottomNavBar Grid.Row="1" x:Name="BottomNav" />

    </Grid>
</ContentPage>
