<?xml version="1.0" encoding="utf-8" ?>
<mct:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:mct="clr-namespace:CommunityToolkit.Maui.Views;assembly=CommunityToolkit.Maui"
            x:Class="Khadamat.MobileApp.Views.Popups.KhadamatAlertPopup"
            Color="Transparent"
            CanBeDismissedByTappingOutsideOfPopup="False">

    <Grid VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="330" FlowDirection="RightToLeft">
        <Border BackgroundColor="White"
                StrokeThickness="1"
                Stroke="#e2e8f0"
                Padding="24,28,24,22">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="26" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#0f172a" Offset="0,12" Radius="30" Opacity="0.22" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="16" HorizontalOptions="Fill">
                <!-- Status Icon Circle -->
                <Border x:Name="IconBadgeBorder"
                        WidthRequest="64"
                        HeightRequest="64"
                        StrokeThickness="0"
                        HorizontalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="32" />
                    </Border.StrokeShape>
                    <Label x:Name="IconLabel"
                           FontSize="28"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <!-- Title & Message -->
                <VerticalStackLayout Spacing="6" HorizontalOptions="Fill">
                    <Label x:Name="TitleLabel"
                           Text="تنبيه"
                           TextColor="#0f172a"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                    
                    <Label x:Name="MessageLabel"
                           Text=""
                           TextColor="#475569"
                           FontSize="13.5"
                           LineHeight="1.4"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- Actions Grid -->
                <Grid x:Name="ActionsGrid" ColumnSpacing="10" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="CancelColumn" Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Confirm / OK Button -->
                    <Border x:Name="ConfirmBorder"
                            Grid.Column="0"
                            HeightRequest="46"
                            StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnConfirmClicked" />
                        </Border.GestureRecognizers>
                        <Label x:Name="ConfirmBtnLabel"
                               Text="حسناً"
                               TextColor="White"
                               FontSize="14.5"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <!-- Cancel Button (Only visible in Confirm mode) -->
                    <Border x:Name="CancelBorder"
                            Grid.Column="1"
                            HeightRequest="46"
                            BackgroundColor="#f1f5f9"
                            StrokeThickness="1"
                            Stroke="#e2e8f0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCancelClicked" />
                        </Border.GestureRecognizers>
                        <Label x:Name="CancelBtnLabel"
                               Text="إلغاء"
                               TextColor="#475569"
                               FontSize="14.5"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>

</mct:Popup>
