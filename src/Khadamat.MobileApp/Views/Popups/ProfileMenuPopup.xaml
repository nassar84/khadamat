<?xml version="1.0" encoding="utf-8" ?>
<mct:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
           xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
           xmlns:mct="clr-namespace:CommunityToolkit.Maui.Views;assembly=CommunityToolkit.Maui"
           x:Class="Khadamat.MobileApp.Views.Popups.ProfileMenuPopup"
           Color="Transparent"
           CanBeDismissedByTappingOutsideOfPopup="True">

    <Grid WidthRequest="260" Margin="12, 0, 12, 80" VerticalOptions="End" HorizontalOptions="Start" FlowDirection="RightToLeft">
        <Border BackgroundColor="White"
                StrokeThickness="1.5"
                Stroke="#e2e8f0"
                Padding="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="22" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#0f172a" Offset="0,-6" Radius="24" Opacity="0.14" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="0">
                <!-- ══ ترويسة المستخدم (تأخذ لون الثيم الحالى) ══ -->
                <Grid>
                    <!-- لمسة خفيفة من اللون الأساسى للثيم كخلفية -->
                    <Border BackgroundColor="{DynamicResource Primary}" Opacity="0.08" StrokeThickness="0" />

                    <Grid Padding="14,14" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <!-- صورة المستخدم -->
                        <Grid WidthRequest="42" HeightRequest="42">
                            <Border BackgroundColor="{DynamicResource Primary}" Opacity="0.12" StrokeThickness="0">
                                <Border.StrokeShape><Ellipse /></Border.StrokeShape>
                            </Border>
                            <Border StrokeThickness="2" Stroke="{DynamicResource Primary}" BackgroundColor="Transparent">
                                <Border.StrokeShape><Ellipse /></Border.StrokeShape>
                                <Image x:Name="UserAvatarImage" Aspect="AspectFill" WidthRequest="42" HeightRequest="42" />
                            </Border>
                        </Grid>

                        <!-- الاسم والدور -->
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                            <Label x:Name="UserNameLabel" Text="مستخدم" TextColor="#0f172a" FontSize="13" FontAttributes="Bold" MaxLines="1" LineBreakMode="TailTruncation" />
                            <Grid HorizontalOptions="Start">
                                <Border BackgroundColor="{DynamicResource Primary}" Opacity="0.12" StrokeThickness="0" HorizontalOptions="Fill" VerticalOptions="Fill">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                </Border>
                                <Label x:Name="UserRoleLabel" Text="حساب نشط" TextColor="{DynamicResource Primary}" FontSize="10" FontAttributes="Bold" Padding="9,3" />
                            </Grid>
                        </VerticalStackLayout>
                    </Grid>
                </Grid>

                <BoxView HeightRequest="1" Color="#e2e8f0" />

                <!-- ══ الملف الشخصى ══ -->
                <Grid x:Name="ProfileBtn" Padding="14,12" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnProfileClicked" />
                    </Grid.GestureRecognizers>
                    <Grid WidthRequest="36" HeightRequest="36">
                        <Border BackgroundColor="{DynamicResource Primary}" Opacity="0.12" StrokeThickness="0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                        </Border>
                        <Label Text="&#xF007;" FontFamily="FA6Solid" FontSize="16" TextColor="{DynamicResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Grid>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                        <Label Text="الملف الشخصي" TextColor="#0f172a" FontSize="13" FontAttributes="Bold" />
                        <Label Text="عرض وتعديل بيانات حسابك" TextColor="#64748b" FontSize="10" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="‹" FontSize="20" TextColor="{DynamicResource Primary}" VerticalOptions="Center" />
                </Grid>

                <BoxView HeightRequest="1" Color="#f1f5f9" Margin="14,0" />

                <!-- ══ تسجيل الخروج (لون التحذير المعتمد فى المشروع) ══ -->
                <Grid x:Name="LogoutBtn" Padding="14,12" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" BackgroundColor="#fffbfb">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLogoutClicked" />
                    </Grid.GestureRecognizers>
                    <Border WidthRequest="36" HeightRequest="36" BackgroundColor="#fef2f2" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                        <Label Text="&#xF011;" FontFamily="FA6Solid" FontSize="15" TextColor="#ef4444" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                        <Label Text="تسجيل الخروج" TextColor="#ef4444" FontSize="13" FontAttributes="Bold" />
                        <Label Text="الخروج من الحساب بأمان" TextColor="#f87171" FontSize="10" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="‹" FontSize="20" TextColor="#fca5a5" VerticalOptions="Center" />
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>

</mct:Popup>
