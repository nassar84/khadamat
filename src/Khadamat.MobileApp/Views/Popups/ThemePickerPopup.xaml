<?xml version="1.0" encoding="utf-8" ?>
<mct:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
           xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
           xmlns:mct="clr-namespace:CommunityToolkit.Maui.Views;assembly=CommunityToolkit.Maui"
           x:Class="Khadamat.MobileApp.Views.Popups.ThemePickerPopup"
           Color="Transparent">

    <Grid WidthRequest="340" HeightRequest="280" VerticalOptions="End" HorizontalOptions="Center" Margin="0,0,0,20">
        <!-- Semi-Circular Background using Border -->
        <Border BackgroundColor="#f8fafc" 
                StrokeThickness="0"
                HeightRequest="300"
                WidthRequest="340"
                Margin="0,0,0,-150">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="170,170,0,0" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,-10" Radius="30" Opacity="0.15" />
            </Border.Shadow>

            <AbsoluteLayout x:Name="ContainerLayout" VerticalOptions="Fill" HorizontalOptions="Fill">
                <!-- Center Title - Positioned near the bottom of the visible arc -->
                <VerticalStackLayout x:Name="CenterTitle" 
                                     AbsoluteLayout.LayoutBounds="170, 130, 200, 60" 
                                     AbsoluteLayout.LayoutFlags="None"
                                     TranslationX="-100" TranslationY="0">
                    <Label Text="اختر لونك" FontSize="20" FontAttributes="Bold" TextColor="#1e293b" HorizontalOptions="Center" />
                    <Label Text="خصص مظهر تطبيقك" FontSize="13" TextColor="#64748b" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </AbsoluteLayout>
        </Border>
    </Grid>

</mct:Popup>
