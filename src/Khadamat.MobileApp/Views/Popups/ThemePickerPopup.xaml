<?xml version="1.0" encoding="utf-8" ?>
<mct:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
           xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
           xmlns:mct="clr-namespace:CommunityToolkit.Maui.Views;assembly=CommunityToolkit.Maui"
           x:Class="Khadamat.MobileApp.Views.Popups.ThemePickerPopup"
           Color="Transparent">

    <Grid WidthRequest="340" HeightRequest="320" VerticalOptions="End" HorizontalOptions="Center" Margin="0,0,0,0">
        <!-- Semi-Circular Background -->
        <Border BackgroundColor="#f8fafc" 
                StrokeThickness="0"
                HeightRequest="400"
                WidthRequest="400"
                HorizontalOptions="Center"
                VerticalOptions="End"
                Margin="0,0,0,-200">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="200" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,-10" Radius="30" Opacity="0.15" />
            </Border.Shadow>

            <AbsoluteLayout x:Name="ContainerLayout" VerticalOptions="Fill" HorizontalOptions="Fill">
                <!-- Center Title - Positioned above the fanned icons -->
                <VerticalStackLayout x:Name="CenterTitle" 
                                     AbsoluteLayout.LayoutBounds="80, 135, 240, 60" 
                                     AbsoluteLayout.LayoutFlags="None">
                    <Label Text="سمات التطبيق" FontSize="20" FontAttributes="Bold" TextColor="#1e293b" HorizontalOptions="Center" />
                    <Label Text="اختر لونك المفضل للتطبيق" FontSize="13" TextColor="#64748b" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </AbsoluteLayout>
        </Border>
    </Grid>

</mct:Popup>
